/-! ### The original reading as the measured field -/

namespace DotProduct.Extension
open MeasureTheory Filter Set
open scoped SchwartzMap ComplexConjugate InnerProductSpace

section PlaneFieldJoin

set_option maxHeartbeats 4000000

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
local notation "v" => planePositionMomentumLabel hħ.le hm
local notation "B" => massiveEuclideanBasis (d+1)
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d hħ.le hm)
local notation "μ" => massiveSpatialLaw d hħ.le hm
local notation "W" => wickCoordinate μ L
local notation "T" => 𝓢(MassShell.Space d, ℝ)
local notation "vol" => (volume : Measure (MassShell.Space d))

private theorem spatialLabel_complex_gram (a b : T) :
    inner ℂ (v a) (v b) = (inner ℝ (L a) (L b) : ℂ) := by
  let I := planeMomentumIsometry d m hm
  have hs (g : T) : ∀ᵐ k ∂vol, v g (-k) = conj (v g k) := by
    have hv := planePositionMomentumLabel_ae hħ.le hm g
    have hn := (Measure.measurePreserving_neg vol).quasiMeasurePreserving.ae hv
    filter_upwards [hv,hn] with k hk hnk
    rw [show v g (-k) = _ from hnk,hk,planeSpatialWeight_even,map_mul,Complex.conj_ofReal]
    congr 1
    rw [physicsFourier_integral,physicsFourier_integral,map_mul,Complex.conj_ofReal,← integral_conj]
    congr 1
    apply integral_congr_ae
    exact ae_of_all _ fun x ↦ by simp [← Complex.exp_conj]
  change inner ℂ (v a) (v b) = (inner ℝ (I (v a)) (I (v b)) : ℂ)
  rw [physicalL2_real_inner,I.inner_map_map]
  exact Complex.ext rfl (by simpa only [Complex.ofReal_im] using
    hermitian_profile_inner_im _ _ (hs a) (hs b))

/-- Multiplication by the original plane coordinate is the Hermitian field on the
dense linear span of the original spatial Wick characters, under the unitary
fixed by conditional expectation of every positive-side Wick preparation. -/
theorem plane_coordinate_fock_field (U : Lp ℂ 2 μ ≃ₗᵢ[ℂ] momentumFock vol)
    (hU : ∀ f, U (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
      coherentVec vol (Complex.I • physicalFeatureL d hħ.le hm f))
    (h b : T) :
    U (planeCoordinateTimesWick d hħ.le hm h b) =
      fockFieldOp vol (v h) (coherentVec vol (Complex.I • v b))
        (coherentVec_mem_fockFieldDom vol (v h) (Complex.I • v b)) := by
  let Z := fockFieldOp vol (v h) (coherentVec vol (Complex.I • v b))
    (coherentVec_mem_fockFieldDom vol (v h) (Complex.I • v b))
  let Y := planeCoordinateTimesWick d hħ.le hm h b
  have hmat (a : T) : inner ℂ (W a) Y = inner ℂ (U (W a)) Z := by
    change inner ℂ (W a) (planeCoordinateTimesWick d hħ.le hm h b) = _
    rw [plane_coordinate_wick_matrix d hħ.le hm h a b,massive_spatial_fock_wick d hħ hm U hU a]
    dsimp only [Z]
    rw [coherentVec_fockFieldOp_inner,inner_smul_left,inner_smul_right,inner_smul_left,inner_smul_right,
      Complex.conj_I, spatialLabel_complex_gram d hħ hm a h, spatialLabel_complex_gram d hħ hm h b,
      spatialLabel_complex_gram d hħ hm a b, inner_sub_left,real_inner_comm (L h) (L b),
      Complex.ofReal_sub,Complex.ofReal_exp]
    simp only [neg_mul,← mul_assoc,Complex.I_mul_I,neg_neg,one_mul]
    ring
  have hfun : innerSL ℂ Y = (innerSL ℂ Z).comp U.toLinearIsometry.toContinuousLinearMap := by
    apply ContinuousLinearMap.ext_on (wickCoordinate_dense (standardGaussianProduct _)
      (pointwiseGaussian B) (pointwiseGaussian_measurable B) L)
    rintro _ ⟨a,rfl⟩
    change inner ℂ Y (W a) = inner ℂ Z (U (W a))
    rw [← inner_conj_symm Y (W a),← inner_conj_symm Z (U (W a)),hmat]
  apply ext_inner_right ℂ
  intro x
  obtain ⟨x,rfl⟩ := U.surjective x
  exact (U.inner_map_map Y x).trans (congrArg (fun f : Lp ℂ 2 μ →L[ℂ] ℂ ↦ f x) hfun)

end PlaneFieldJoin
