/-- The finite-dimensional characteristic data of the original full spacetime reading law. -/
def MassiveReadingLaw {D : ℕ} (ħ m : ℝ) (P : Measure (𝓢(MassShell.Space D, ℝ) → ℝ)) : Prop :=
  IsProbabilityMeasure P ∧ ∀ (s : Finset (𝓢(MassShell.Space D, ℝ))) (c : s → ℝ),
    (∫ x, Complex.exp (Complex.I * (↑(∑ i : s, c i * x i) : ℂ)) ∂P) =
      Complex.exp (-(continuumCov ħ m (fun p ↦ ∑ i : s, (c i : ℂ) * physicsFourier i.val p)
        (fun p ↦ ∑ i : s, (c i : ℂ) * physicsFourier i.val p)) / 2)

theorem massiveReadingLaw_iff {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (P : Measure (𝓢(MassShell.Space D, ℝ) → ℝ)) :
    MassiveReadingLaw ħ m P ↔ P = massiveEuclideanLaw D ħ m hħ hm := by
  constructor
  · rintro ⟨hP,h⟩
    exact massiveEuclideanLaw_unique hħ hm P h
  · rintro rfl
    exact ⟨inferInstance, fun s c ↦ massiveEuclideanLaw_jointChar hħ hm (fun i : s ↦ i.val) c⟩

/-- The twelve Table 1 statements on the common Fock space. -/
def PaperOneTable.{u} (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) : Prop :=
  let μ := (volume : Measure (MassShell.Space (n+1)))
  let H := momentumFock μ
  Table1HilbertSpace n ħ m ∧ Table1UnitaryEvolution n ħ m ∧ Table1TensorProduct μ ∧
    Table1BornRule H ∧ Table1SelfAdjointObservables H ∧ Table1ProjectionUpdate.{u} H ∧
    Table1PoincareCovariance n hħ.le hm ∧ Table1ForwardConeSpectrum n ħ m hm ∧
    Table1UniqueVacuum n ħ m hm ∧ Table1FieldDistributions n hħ.le hm ∧
    Table1SpacelikeCommutativity n hħ.le hm ∧ Table1CyclicVacuum n ħ m

/-- Independent preparations have the completed Hilbert tensor product, identified
    on pure tensors with the product of their actual plane conditionals. -/
def PaperOneComposition (d e : ℕ) {ħ m ħ' m' : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (hħ' : 0 < ħ') (hm' : 0 < m') : Prop :=
    ∃! U : UniformSpace.Completion
        (massivePreparationClass d hħ.le hm ⊗[ℂ] massivePreparationClass e hħ'.le hm') ≃ₗᵢ[ℂ]
        Lp ℂ 2 ((massiveSpatialLaw d hħ.le hm).prod (massiveSpatialLaw e hħ'.le hm')),
      ∀ X Y, U (ProductL2.tensorPure (Submodule.Quotient.mk X) (Submodule.Quotient.mk Y)) =
        ProductL2.pure (conditionedMassivePreparation d hħ.le hm X)
          (conditionedMassivePreparation e hħ'.le hm' Y)

/-- A weakly holomorphic, boundary-continuous continuation of the measured positive-time shift. -/
def IsMeasuredShiftContinuation (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (T : ℂ → Lp ℂ 2 (massiveSpatialLaw d hħ.le hm) →L[ℂ] Lp ℂ 2 (massiveSpatialLaw d hħ.le hm)) : Prop :=
  (∀ φ ψ, DifferentiableOn ℂ (fun z ↦ inner ℂ φ (T z ψ)) {z | 0 < z.re} ∧
    ContinuousOn (fun z ↦ inner ℂ φ (T z ψ)) {z | 0 ≤ z.re}) ∧
  ∀ (s : ℝ) (hs : 0 ≤ s), T (s : ℂ) = massiveSpatialShift d hħ hm s hs

/-- The implemented continuation has the measured real and unitary imaginary restrictions.
The identity theorem determines it on the entire closed right half-plane. -/
theorem measured_shift_continuation (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    let T := massiveSpatialComplexTime d hħ hm
    IsMeasuredShiftContinuation d hħ hm T ∧
    (∀ t : ℝ, T (Complex.I*t) = (massiveSpatialUnitary d hħ hm t).toLinearIsometry.toContinuousLinearMap) ∧
    ∀ S, IsMeasuredShiftContinuation d hħ hm S → EqOn S T {z | 0 ≤ z.re} := by
  refine ⟨⟨massiveSpatialComplexTime_weak_regular d hħ hm, massiveSpatialComplexTime_real d hħ hm⟩,
    massiveSpatialComplexTime_imag d hħ hm, ?_⟩
  intro S hS
  apply massiveSpatialComplexTime_unique d hħ hm S (fun φ ψ ↦ (hS.1 φ ψ).1) (fun φ ψ ↦ (hS.1 φ ψ).2)
  intro s hs f
  rw [hS.2 s hs.le, massiveSpatialShift_wick]

namespace Extension

