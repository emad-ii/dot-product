/-- The two constructions give exactly the same law on the paper's original
Schwartz evaluation coordinates. The tempered construction is a realization of
the same continuum law, not a separate Gaussian model. -/
theorem gffMeasure_originalReadingLaw (n : ℕ) {ħ m : ℝ}
    (hħ : 0 < ħ) (hm : 0 < m) :
    letI := cylMeasurableSpace (EuclidD n)
    (gffMeasure n ħ m hħ hm).map
      (fun φ : RealTemperedDistribution (EuclidD n) ↦ fun f : 𝓢(EuclidD n, ℝ) ↦ φ f) =
        massiveEuclideanLaw (n + 2) ħ m hħ.le hm := by
  classical
  let := cylMeasurableSpace (EuclidD n)
  let E := EuclidD n
  let eval : RealTemperedDistribution E → (𝓢(E, ℝ) → ℝ) := fun φ f ↦ φ f
  let P := gffMeasure n ħ m hħ hm
  change P.map eval = _
  have heval : Measurable eval := Measurable.of_eval (fun f => measurable_eval_cyl f)
  apply massiveEuclideanLaw_unique hħ.le hm
  intro s c
  let T : (𝓢(E, ℝ) → ℝ) → ℂ :=
    fun x ↦ Complex.exp (Complex.I * (↑(∑ i : s, c i * x i) : ℂ))
  have hT : Measurable T := by dsimp [T]; fun_prop
  change (∫ x, T x ∂P.map eval) = _
  rw [integral_map heval.aemeasurable hT.aestronglyMeasurable]
  let f : 𝓢(E, ℝ) := ∑ i : s, c i • i.val
  have hef (φ : RealTemperedDistribution E) : φ f = ∑ i : s, c i * φ i.val := by
    simp only [f, map_sum, map_smul, smul_eq_mul]
  have hFourier : physicsFourier (f : E → ℝ) =
      fun p ↦ ∑ i : s, (c i : ℂ) * physicsFourier i.val p := by
    funext p
    simp_rw [← physicsFourierExact_eq_physicsFourier]
    have h := (physicsFourierCLM_apply f p).symm
    rw [h]
    dsimp only [f]
    rw [map_sum]
    simp only [_root_.sum_apply]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_smul]
    change c i • physicsFourierCLM (n + 2) i.val p = _
    rw [physicsFourierCLM_apply, Complex.real_smul]
  have hchar := bochnerMinlos_gff_charFun n ħ m hħ hm f
  simp_rw [hef] at hchar
  rw [hFourier] at hchar
  simpa only [eval, T, P, one_div, div_eq_mul_inv, neg_mul, mul_neg, one_mul, mul_comm] using hchar

end Extension

