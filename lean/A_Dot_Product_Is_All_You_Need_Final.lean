/-- The ordered physical vacuum two-point distribution is the right boundary
of the massive kernel with positive damping, tested against compact real smears. -/
theorem ordered_two_point_shell_boundary {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(Spacetime d, ℝ)) (hf : HasCompactSupport f) (hg : HasCompactSupport g) :
    let W := fun h ↦ unitaryWightmanField d ħ m hħ hm (FeatureDensity.ofRealSchwartz h)
    Tendsto (fun s : ℝ ↦ ∫ r : Spacetime d × Spacetime d,
      (f r.1 : ℂ) * (g r.2 : ℂ) * physicalShellKernel d ħ m
        ((s : ℂ) + ((r.1.1-r.2.1 : ℝ) : ℂ) * Complex.I) (r.1.2-r.2.2))
      (𝓝[>] 0) (𝓝 (inner ℂ (fockVacuum volume) (W f (W g (fockVacuumFin volume))).1)) := by
  intro W
  let V (h : 𝓢(Spacetime d, ℝ)) := unitaryShellFeature d ħ m hħ hm (FeatureDensity.ofRealSchwartz h)
  let A (h : 𝓢(Spacetime d, ℝ)) (k : MassShell.Space d) :=
    ∫ p, shellPlanePhase m k p * (h p : ℂ)
  let ω := modeDispersion (d := d) m
  let b (k : MassShell.Space d) := Real.sqrt (ħ / (2 * ω k))
  let c := transverseScale d
  have hV (h : 𝓢(Spacetime d, ℝ)) : ⇑(V h) =ᵐ[volume] fun k ↦ (b k : ℂ) * ((c : ℂ) * A h k) :=
    unitaryShellFeature_ae d ħ m hħ hm (FeatureDensity.ofRealSchwartz h)
  have hvac : inner ℂ (fockVacuum volume) (W f (W g (fockVacuumFin volume))).1 =
      inner ℂ (V f) (V g) := by
    let Ω := fockVacuumFin (volume : Measure (MassShell.Space d))
    have ha (h : 𝓢(Spacetime d, ℝ)) (ψ : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
        W h ψ = contField volume (V h) (V h) ψ :=
      unitaryWightmanField_real_formula d ħ m hħ hm h ψ
    have he := (ha f (W g Ω)).trans (congrArg (contField volume (V f) (V f)) (ha g Ω))
    exact (congrArg (fun y : FiniteParticleFock (volume : Measure (MassShell.Space d)) ↦
      inner ℂ (fockVacuum volume) y.1) he).trans (vacuum_field_pair volume (V f) (V g))
  rw [hvac]
  apply (damped_inner_tendsto volume ω (modeDispersion_measurable m)
    (fun k ↦ (modeDispersion_pos hm k).le) (V f) (V g)).congr'
  filter_upwards [self_mem_nhdsWithin] with s hs
  symm
  unfold physicalShellKernel
  rw [damped_shell_fubini s hm _ f g hf hg (physicalShellWeight_integrable hm hs),
    ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [hV f,hV g] with k hfk hgk
  have hb : (b k : ℂ)^2 = (ħ / (2 * ω k) : ℝ) := by
    rw [← Complex.ofReal_pow]
    exact congrArg Complex.ofReal (Real.sq_sqrt (div_nonneg hħ (mul_pos two_pos (modeDispersion_pos hm k)).le))
  change (↑(ħ * c ^ 2) : ℂ) * (↑(Real.exp (-s * ω k) / (2 * ω k)) *
    (conj (A f k) * A g k)) = (Real.exp (-s * ω k) : ℂ) * inner ℂ (V f k) (V g k)
  rw [RCLike.inner_apply,hfk,hgk]
  simp only [map_mul,Complex.conj_ofReal,Complex.ofReal_mul,Complex.ofReal_pow,
    Complex.ofReal_div,Complex.ofReal_ofNat] at hb ⊢
  linear_combination (norm := ring) -((Real.exp (-s * ω k) : ℂ) * (c : ℂ)^2 * conj (A f k) * A g k) * hb

end DotProduct.Extension


