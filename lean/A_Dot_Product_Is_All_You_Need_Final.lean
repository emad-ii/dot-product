/-! ### Part 1: Frame Index, Complex Cylindrical σ-Algebra & Centeredness Helpers -/

/-- Countable phase-space + real/imaginary index for the tight Parseval Fourier frame on `ℝ^d`. -/
abbrev FrameIdx (d : ℕ) := ((Fin d → ℤ) × (Fin d → ℤ)) × Bool

/-- The cylindrical σ-algebra on Mathlib's complex tempered distributions `𝓢'(E, ℂ)`. -/
@[instance_reducible]
noncomputable def cylComplexMeasurableSpace (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    MeasurableSpace 𝓢'(E, ℂ) :=
  ⨆ f : 𝓢(E, ℂ), MeasurableSpace.comap (fun T : 𝓢'(E, ℂ) => T f) inferInstance

theorem measurable_toComplexTempered (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    Measurable[cylMeasurableSpace E, cylComplexMeasurableSpace E]
      (toComplexTempered (E := E)) := by
  rw [cylComplexMeasurableSpace, measurable_iff_comap_le, MeasurableSpace.comap_iSup, iSup_le_iff]
  intro f
  rw [← measurable_iff_comap_le, measurable_comap_iff]
  change Measurable[cylMeasurableSpace E, inferInstance] (fun φ : RealTemperedDistribution E =>
    (φ (f.postcompCLM Complex.reCLM) : ℂ) +
      Complex.I * (φ (f.postcompCLM Complex.imCLM) : ℂ))
  let _ := cylMeasurableSpace E
  exact (Complex.continuous_ofReal.measurable.comp (measurable_eval_cyl _)).add
    (measurable_const.mul (Complex.continuous_ofReal.measurable.comp (measurable_eval_cyl _)))

private lemma summable_frameWeight_prod_nonneg (d : ℕ) {C : ℝ} (hC : 0 ≤ C) :
    Summable (fun idx : FrameIdx d =>
      C * ((∏ i : Fin d, (1 + (idx.1.1 i : ℝ) ^ 2)⁻¹) *
        (∏ i : Fin d, (1 + (idx.1.2 i : ℝ) ^ 2)⁻¹))) := by
  have h1 := (summable_prod_inv_one_add_sq d).mul_left C
  have h2 : Summable (fun _ : Bool => (1 : ℝ)) := (hasSum_fintype _).summable
  have hprod := h1.mul_of_nonneg h2
    (fun p => mul_nonneg hC (mul_nonneg
      (Finset.prod_nonneg fun _ _ => by positivity)
      (Finset.prod_nonneg fun _ _ => by positivity)))
    (fun _ => zero_le_one)
  simpa using hprod

private lemma integrable_frameCoeff_integrand (d : ℕ) (z j : Fin d → ℤ)
    {g : EuclideanSpace ℝ (Fin d) → ℂ} (hg : Continuous g) :
    Integrable (fun x : EuclideanSpace ℝ (Fin d) =>
      (unitBump d (x - intVec z) : ℂ) *
        Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (x i - z i)) * g x) volume := by
  have hcont : Continuous (fun x : EuclideanSpace ℝ (Fin d) =>
      (unitBump d (x - intVec z) : ℂ) *
        Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (x i - z i)) * g x) :=
    ((Complex.continuous_ofReal.comp ((contDiff_unitBump d).continuous.comp
      (continuous_id.sub continuous_const))).mul
      (Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
        (continuous_finsetSum _ fun i _ =>
          continuous_const.mul ((EuclideanSpace.proj i).continuous.sub continuous_const)))))).mul hg
  have hsupp : HasCompactSupport (fun x : EuclideanSpace ℝ (Fin d) =>
      (unitBump d (x - intVec z) : ℂ) *
        Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (x i - z i)) * g x) := by
    refine HasCompactSupport.of_support_subset_isCompact
      (K := (fun u : EuclideanSpace ℝ (Fin d) => intVec z + u) '' unitCube d) ?_ ?_
    · have hcomp_cube : IsCompact (unitCube d) := by
        have hEq : unitCube d = (WithLp.equiv 2 (Fin d → ℝ)).symm ''
            Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1) := by
          ext u
          constructor
          · intro hu; exact ⟨u.ofLp, fun i _ => hu i, rfl⟩
          · rintro ⟨v, hv, rfl⟩ i; exact hv i (Set.mem_univ i)
        rw [hEq]
        exact (isCompact_univ_pi fun _ => isCompact_Icc).image
          (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))
      exact hcomp_cube.image (continuous_const.add continuous_id)
    · intro x hx
      refine ⟨x - intVec z, ?_, add_sub_cancel _ _⟩
      intro i
      have hne : unitBump d (x - intVec z) ≠ 0 := by
        intro h0; exact hx (by simp [h0])
      exact Set.Ioo_subset_Icc_self (support_unitBump_subset d hne i)
  exact hcont.integrable_of_hasCompactSupport hsupp

private lemma frameCoeff_add (d : ℕ) (z j : Fin d → ℤ)
    {g₁ g₂ : EuclideanSpace ℝ (Fin d) → ℂ} (hg₁ : Continuous g₁) (hg₂ : Continuous g₂) :
    frameCoeff d z j (fun x => g₁ x + g₂ x) = frameCoeff d z j g₁ + frameCoeff d z j g₂ := by
  unfold frameCoeff
  simp_rw [mul_add]
  rw [integral_add (integrable_frameCoeff_integrand d z j hg₁)
    (integrable_frameCoeff_integrand d z j hg₂), mul_add]

private lemma frameCoeff_smul_real (d : ℕ) (z j : Fin d → ℤ) (a : ℝ)
    (g : EuclideanSpace ℝ (Fin d) → ℂ) :
    frameCoeff d z j (fun x => (a : ℂ) * g x) = (a : ℂ) * frameCoeff d z j g := by
  unfold frameCoeff
  have hEq : (fun x : EuclideanSpace ℝ (Fin d) =>
      (unitBump d (x - intVec z) : ℂ) *
        Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (x i - z i)) *
          ((a : ℂ) * g x)) =
      fun x => (a : ℂ) * ((unitBump d (x - intVec z) : ℂ) *
        Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (x i - z i)) * g x) := by
    funext x; ring
  rw [hEq, integral_const_mul]
  ring

private lemma frameCoeff_zero (d : ℕ) (z j : Fin d → ℤ) :
    frameCoeff d z j (0 : EuclideanSpace ℝ (Fin d) → ℂ) = 0 := by
  unfold frameCoeff
  simp

private lemma tsum_frameIdx_sq (d : ℕ) {g : EuclideanSpace ℝ (Fin d) → ℂ}
    (hg : Continuous g) (hg_int : Integrable (fun x => ‖g x‖ ^ 2) volume) :
    ∑' idx : FrameIdx d,
        (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g).im
          else (frameCoeff d idx.1.1 idx.1.2 g).re) ^ 2 =
      ∫ x, ‖g x‖ ^ 2 := by
  have hsum_norm := summable_norm_sq_frameCoeff d hg hg_int
  have hpair : ∀ p : (Fin d → ℤ) × (Fin d → ℤ),
      (frameCoeff d p.1 p.2 g).re ^ 2 + (frameCoeff d p.1 p.2 g).im ^ 2 =
        ‖frameCoeff d p.1 p.2 g‖ ^ 2 := by
    intro p
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
    ring
  have hsum_idx : Summable (fun idx : FrameIdx d =>
      (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g).im
        else (frameCoeff d idx.1.1 idx.1.2 g).re) ^ 2) := by
    rw [summable_prod_of_nonneg (fun _ => sq_nonneg _)]
    refine ⟨fun _ => (hasSum_fintype _).summable, ?_⟩
    simp only [tsum_bool, ↓reduceIte, Bool.false_eq_true, hpair]
    exact hsum_norm
  rw [hsum_idx.tsum_prod' (fun _ => (hasSum_fintype _).summable)]
  simp only [tsum_bool, ↓reduceIte, Bool.false_eq_true, hpair]
  exact tsum_norm_sq_frameCoeff d hg hg_int

private lemma tsum_frameIdx_mul (d : ℕ) {g₁ g₂ : EuclideanSpace ℝ (Fin d) → ℂ}
    (hg₁ : Continuous g₁) (hg₂ : Continuous g₂)
    (hg₁_int : Integrable (fun x => ‖g₁ x‖ ^ 2) volume)
    (hg₂_int : Integrable (fun x => ‖g₂ x‖ ^ 2) volume) :
    ∑' idx : FrameIdx d,
        (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₁).im
          else (frameCoeff d idx.1.1 idx.1.2 g₁).re) *
        (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₂).im
          else (frameCoeff d idx.1.1 idx.1.2 g₂).re) =
      ∫ x, (star (g₁ x) * g₂ x).re := by
  have hsum_sq₁ : Summable (fun idx : FrameIdx d =>
      (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₁).im
        else (frameCoeff d idx.1.1 idx.1.2 g₁).re) ^ 2) := by
    rw [summable_prod_of_nonneg (fun _ => sq_nonneg _)]
    refine ⟨fun _ => (hasSum_fintype _).summable, ?_⟩
    simp only [tsum_bool, ↓reduceIte, Bool.false_eq_true]
    refine (summable_norm_sq_frameCoeff d hg₁ hg₁_int).congr fun p => ?_
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]; ring
  have hsum_sq₂ : Summable (fun idx : FrameIdx d =>
      (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₂).im
        else (frameCoeff d idx.1.1 idx.1.2 g₂).re) ^ 2) := by
    rw [summable_prod_of_nonneg (fun _ => sq_nonneg _)]
    refine ⟨fun _ => (hasSum_fintype _).summable, ?_⟩
    simp only [tsum_bool, ↓reduceIte, Bool.false_eq_true]
    refine (summable_norm_sq_frameCoeff d hg₂ hg₂_int).congr fun p => ?_
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]; ring
  have hadd_int : Integrable (fun x => ‖g₁ x + g₂ x‖ ^ 2) volume := by
    refine ((hg₁_int.add hg₂_int).const_mul 2).mono' ((hg₁.add hg₂).norm.pow 2).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    change ‖g₁ x + g₂ x‖ ^ 2 ≤ 2 * (‖g₁ x‖ ^ 2 + ‖g₂ x‖ ^ 2)
    have htr := norm_add_le (g₁ x) (g₂ x)
    nlinarith [sq_nonneg (‖g₁ x‖ - ‖g₂ x‖), norm_nonneg (g₁ x + g₂ x)]
  have hsum_add : Summable (fun idx : FrameIdx d =>
      (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 (fun x => g₁ x + g₂ x)).im
        else (frameCoeff d idx.1.1 idx.1.2 (fun x => g₁ x + g₂ x)).re) ^ 2) := by
    rw [summable_prod_of_nonneg (fun _ => sq_nonneg _)]
    refine ⟨fun _ => (hasSum_fintype _).summable, ?_⟩
    simp only [tsum_bool, ↓reduceIte, Bool.false_eq_true]
    refine (summable_norm_sq_frameCoeff d (g := fun x => g₁ x + g₂ x) (hg₁.add hg₂) hadd_int).congr fun p => ?_
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]; ring
  have hpol_idx : ∀ idx : FrameIdx d,
      (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₁).im
        else (frameCoeff d idx.1.1 idx.1.2 g₁).re) *
      (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₂).im
        else (frameCoeff d idx.1.1 idx.1.2 g₂).re) =
      (1 / 2 : ℝ) *
        ((if idx.2 then (frameCoeff d idx.1.1 idx.1.2 (fun x => g₁ x + g₂ x)).im
          else (frameCoeff d idx.1.1 idx.1.2 (fun x => g₁ x + g₂ x)).re) ^ 2 -
          (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₁).im
            else (frameCoeff d idx.1.1 idx.1.2 g₁).re) ^ 2 -
          (if idx.2 then (frameCoeff d idx.1.1 idx.1.2 g₂).im
            else (frameCoeff d idx.1.1 idx.1.2 g₂).re) ^ 2) := by
    intro ⟨⟨z, j⟩, b⟩
    cases b <;> simp [frameCoeff_add d z j hg₁ hg₂] <;> ring
  simp_rw [hpol_idx, tsum_mul_left]
  rw [(hsum_add.sub hsum_sq₁).tsum_sub hsum_sq₂, hsum_add.tsum_sub hsum_sq₁,
    tsum_frameIdx_sq d (g := fun x => g₁ x + g₂ x) (hg₁.add hg₂) hadd_int,
    tsum_frameIdx_sq d hg₁ hg₁_int, tsum_frameIdx_sq d hg₂ hg₂_int]
  have hsub1_int : Integrable (fun x => ‖g₁ x + g₂ x‖ ^ 2 - ‖g₁ x‖ ^ 2) volume :=
    hadd_int.sub hg₁_int
  rw [← integral_sub hadd_int hg₁_int, ← integral_sub hsub1_int hg₂_int,
    ← integral_const_mul]
  refine integral_congr_ae (ae_of_all _ fun x => ?_)
  have hsq : ∀ z : ℂ, ‖z‖ ^ 2 = z.re ^ 2 + z.im ^ 2 := fun z => by
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]; ring
  simp only [hsq, Complex.add_re, Complex.add_im, Complex.mul_re, RCLike.star_def,
    Complex.conj_re, Complex.conj_im]
  ring

private lemma measurePreserving_neg_iidGaussian (ι : Type*) :
    MeasurePreserving (fun ω : GaussianSeq ι => fun i => -(ω i))
      (iidGaussianMeasure ι) (iidGaussianMeasure ι) := by
  refine ⟨measurable_pi_iff.mpr fun i => (measurable_pi_apply i).neg, ?_⟩
  unfold iidGaussianMeasure
  rw [Measure.infinitePi_map_pi (fun _ : ι => ProbabilityTheory.gaussianReal 0 1)
    (fun _ => measurable_neg)]
  congr 1
  funext _
  simpa using ProbabilityTheory.gaussianReal_map_neg (μ := (0 : ℝ)) (v := (1 : NNReal))

/-- Every centered Gaussian series field has zero mean. -/
theorem integral_gaussianSeriesField_eq_zero {ι E : Type*} [Countable ι]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f : 𝓢(E, ℝ)) :
    ∫ ω : GaussianSeq ι, gaussianSeriesField L w hw0 hw s hL ω f ∂iidGaussianMeasure ι = 0 := by
  have hmp := measurePreserving_neg_iidGaussian ι
  have hodd : ∀ ω : GaussianSeq ι,
      gaussianSeriesField L w hw0 hw s hL (fun i => -(ω i)) f =
        - gaussianSeriesField L w hw0 hw s hL ω f := by
    intro ω
    have hgood : (fun i => -(ω i)) ∈ goodSet w ↔ ω ∈ goodSet w := by
      simp [goodSet]
    by_cases hω : ω ∈ goodSet w
    · have hω' : (fun i => -(ω i)) ∈ goodSet w := hgood.mpr hω
      rw [gaussianSeriesField_apply_of_mem L w hw0 hw s hL hω',
        gaussianSeriesField_apply_of_mem L w hw0 hw s hL hω]
      simp_rw [neg_mul]
      exact tsum_neg
    · have hω' : (fun i => -(ω i)) ∉ goodSet w := fun h => hω (hgood.mp h)
      rw [gaussianSeriesField_apply_of_not_mem L w hw0 hw s hL hω',
        gaussianSeriesField_apply_of_not_mem L w hw0 hw s hL hω, neg_zero]
  have heq : ∫ ω : GaussianSeq ι, gaussianSeriesField L w hw0 hw s hL ω f ∂iidGaussianMeasure ι =
      ∫ ω : GaussianSeq ι, gaussianSeriesField L w hw0 hw s hL (fun i => -(ω i)) f
        ∂iidGaussianMeasure ι := by
    have hmeas : Measurable (fun ω : GaussianSeq ι => gaussianSeriesField L w hw0 hw s hL ω f) :=
      (measurable_eval_cyl f).comp (measurable_gaussianSeriesField L w hw0 hw s hL)
    have h1 := integral_map (μ := iidGaussianMeasure ι) hmp.measurable.aemeasurable
      hmeas.aestronglyMeasurable
    rw [hmp.map_eq] at h1
    exact h1
  simp_rw [hodd] at heq
  rw [integral_neg] at heq
  linarith

/-! ### Part 2: Time-Zero Plane Gaussian Field & Measure `planeGaussianMeasure` -/

private noncomputable def planeFrameData (n : ℕ) (ħ m : ℝ) (hm : 0 < m) :=
  let h1 := norm_frameCoeff_le (n + 1)
  let h2 := planeKernel_iteratedFDeriv_bound n ħ hm
  (h1.choose, h2.choose, h2.choose_spec.choose)

/-- Countable seminorm set bounding all time-zero plane frame functionals. -/
noncomputable def planeFrameSeminorms (n : ℕ) (ħ m : ℝ) (hm : 0 < m) : Finset (ℕ × ℕ) :=
  (planeKernel_iteratedFDeriv_bound n ħ hm).choose

/-- Summable positive weights dominating the time-zero plane frame functionals. -/
noncomputable def planeFrameWeight (n : ℕ) (ħ m : ℝ) (hm : 0 < m) (idx : FrameIdx (n + 1)) : ℝ :=
  ((norm_frameCoeff_le (n + 1)).choose *
    (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose) *
    ((∏ i : Fin (n + 1), (1 + (idx.1.1 i : ℝ) ^ 2)⁻¹) *
      (∏ i : Fin (n + 1), (1 + (idx.1.2 i : ℝ) ^ 2)⁻¹))

lemma planeFrameWeight_nonneg (n : ℕ) (ħ m : ℝ) (hm : 0 < m) (idx : FrameIdx (n + 1)) :
    0 ≤ planeFrameWeight n ħ m hm idx := by
  have hC1 : 0 < (norm_frameCoeff_le (n + 1)).choose := (norm_frameCoeff_le (n + 1)).choose_spec.1
  have hC2 : 0 < (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose :=
    (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.1
  unfold planeFrameWeight
  exact mul_nonneg (mul_nonneg hC1.le hC2.le)
    (mul_nonneg (Finset.prod_nonneg fun _ _ => by positivity)
      (Finset.prod_nonneg fun _ _ => by positivity))

lemma summable_planeFrameWeight (n : ℕ) (ħ m : ℝ) (hm : 0 < m) :
    Summable (planeFrameWeight n ħ m hm) := by
  have hC1 : 0 < (norm_frameCoeff_le (n + 1)).choose := (norm_frameCoeff_le (n + 1)).choose_spec.1
  have hC2 : 0 < (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose :=
    (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.1
  exact summable_frameWeight_prod_nonneg (n + 1) (mul_nonneg hC1.le hC2.le)

private lemma planeFrame_norm_bound (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (z j : Fin (n + 1) → ℤ) (h : 𝓢(SpatialE n, ℝ)) :
    ‖frameCoeff (n + 1) z j (planeKernel n ħ m h)‖ ≤
      planeFrameWeight n ħ m hm ((z, j), false) *
        ((planeFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h := by
  have h1 := (norm_frameCoeff_le (n + 1)).choose_spec.2
  have h2 := (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.2
  have hC2 : 0 < (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose :=
    (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.1
  let M : ℝ := (planeKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose *
    (∏ i : Fin (n + 1), (1 + (z i : ℝ) ^ 2)⁻¹) *
    ((planeFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h
  have hM : 0 ≤ M := mul_nonneg
    (mul_nonneg hC2.le (Finset.prod_nonneg fun _ _ => by positivity))
    (apply_nonneg _ h)
  have hcd : ContDiff ℝ (2 * (n + 1) : ℕ) (planeKernel n ħ m h) :=
    (planeKernel_contDiff n ħ hm h).of_le (WithTop.coe_le_coe.mpr le_top)
  have hbd : ∀ k ≤ 2 * (n + 1), ∀ u ∈ unitCube (n + 1),
      ‖iteratedFDeriv ℝ k (planeKernel n ħ m h) (intVec z + u)‖ ≤ M := fun k hk u hu =>
    h2 z k hk u hu h
  have hle := h1 z j (planeKernel n ħ m h) M hcd hM hbd
  calc ‖frameCoeff (n + 1) z j (planeKernel n ħ m h)‖
      ≤ (norm_frameCoeff_le (n + 1)).choose * (∏ i : Fin (n + 1), (1 + (j i : ℝ) ^ 2)⁻¹) * M := hle
    _ = planeFrameWeight n ħ m hm ((z, j), false) *
          ((planeFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h := by
      simp only [planeFrameWeight, M]
      ring

/-- Real/imaginary tight Parseval frame functional on the time-zero spatial Schwartz space
`𝓢(SpatialE n, ℝ)` associated with `planeKernel n ħ m`. -/
noncomputable def planeFrameCLM (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (idx : FrameIdx (n + 1)) : 𝓢(SpatialE n, ℝ) →L[ℝ] ℝ :=
  SchwartzMap.mkCLMtoNormedSpace
    (fun h => if idx.2 then (frameCoeff (n + 1) idx.1.1 idx.1.2 (planeKernel n ħ m h)).im
      else (frameCoeff (n + 1) idx.1.1 idx.1.2 (planeKernel n ħ m h)).re)
    (fun h₁ h₂ => by
      have hadd : planeKernel n ħ m (h₁ + h₂) = fun k => planeKernel n ħ m h₁ k + planeKernel n ħ m h₂ k :=
        funext (planeKernel_add n ħ hm h₁ h₂)
      rw [hadd, frameCoeff_add (n + 1) idx.1.1 idx.1.2
        (planeKernel_contDiff n ħ hm h₁).continuous (planeKernel_contDiff n ħ hm h₂).continuous]
      cases idx.2 <;> simp)
    (fun a h => by
      have hsm : planeKernel n ħ m (a • h) = fun k => (a : ℂ) * planeKernel n ħ m h k :=
        funext (planeKernel_smul n ħ hm a h)
      rw [hsm, frameCoeff_smul_real]
      cases idx.2 <;> simp)
    ⟨planeFrameSeminorms n ħ m hm, planeFrameWeight n ħ m hm idx,
      planeFrameWeight_nonneg n ħ m hm idx, fun h => by
        rw [Real.norm_eq_abs]
        have hbn := planeFrame_norm_bound n ħ m hm idx.1.1 idx.1.2 h
        have hw_eq : planeFrameWeight n ħ m hm ((idx.1.1, idx.1.2), false) =
            planeFrameWeight n ħ m hm idx := rfl
        rw [hw_eq] at hbn
        cases idx.2
        · exact (Complex.abs_re_le_norm _).trans hbn
        · exact (Complex.abs_im_le_norm _).trans hbn⟩

lemma planeFrameCLM_apply (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (idx : FrameIdx (n + 1)) (h : 𝓢(SpatialE n, ℝ)) :
    planeFrameCLM n ħ m hm idx h =
      if idx.2 then (frameCoeff (n + 1) idx.1.1 idx.1.2 (planeKernel n ħ m h)).im
      else (frameCoeff (n + 1) idx.1.1 idx.1.2 (planeKernel n ħ m h)).re := rfl

lemma planeFrameCLM_bound (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (idx : FrameIdx (n + 1)) (h : 𝓢(SpatialE n, ℝ)) :
    |planeFrameCLM n ħ m hm idx h| ≤
      planeFrameWeight n ħ m hm idx *
        ((planeFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h := by
  have hbn := planeFrame_norm_bound n ħ m hm idx.1.1 idx.1.2 h
  have hw_eq : planeFrameWeight n ħ m hm ((idx.1.1, idx.1.2), false) =
      planeFrameWeight n ħ m hm idx := rfl
  rw [hw_eq] at hbn
  rw [planeFrameCLM_apply]
  cases idx.2
  · exact (Complex.abs_re_le_norm _).trans hbn
  · exact (Complex.abs_im_le_norm _).trans hbn

/-- Time-zero plane Gaussian random field `Φ₀ : GaussianSeq (FrameIdx (n+1)) → 𝓢'(ℝ^{n+1}, ℝ)`. -/
noncomputable def planeGaussianField (n : ℕ) (ħ m : ℝ) (_hħ : 0 < ħ) (hm : 0 < m) :
    GaussianSeq (FrameIdx (n + 1)) → RealTemperedDistribution (SpatialE n) :=
  gaussianSeriesField (planeFrameCLM n ħ m hm) (planeFrameWeight n ħ m hm)
    (planeFrameWeight_nonneg n ħ m hm) (summable_planeFrameWeight n ħ m hm)
    (planeFrameSeminorms n ħ m hm) (planeFrameCLM_bound n ħ m hm)

theorem measurable_planeGaussianField (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    Measurable[inferInstance, cylMeasurableSpace (SpatialE n)]
      (planeGaussianField n ħ m hħ hm) :=
  measurable_gaussianSeriesField _ _ _ _ _ _

/-- The time-zero plane Gaussian probability measure `ν_{ħ, m}` on
`(RealTemperedDistribution (SpatialE n), cylMeasurableSpace (SpatialE n))`. -/
noncomputable def planeGaussianMeasure (n : ℕ) (ħ m : ℝ) (_hħ : 0 < ħ) (hm : 0 < m) :
    @Measure (RealTemperedDistribution (SpatialE n)) (cylMeasurableSpace (SpatialE n)) :=
  gaussianSeriesMeasure (planeFrameCLM n ħ m hm) (planeFrameWeight n ħ m hm)
    (planeFrameWeight_nonneg n ħ m hm) (summable_planeFrameWeight n ħ m hm)
    (planeFrameSeminorms n ħ m hm) (planeFrameCLM_bound n ħ m hm)

instance instIsProbabilityMeasurePlaneGaussianMeasure (n : ℕ) (ħ m : ℝ)
    (hħ : 0 < ħ) (hm : 0 < m) :
    @IsProbabilityMeasure (RealTemperedDistribution (SpatialE n)) (cylMeasurableSpace (SpatialE n))
      (planeGaussianMeasure n ħ m hħ hm) :=
  instIsProbabilityMeasureGaussianSeriesMeasure _ _ _ _ _ _

/-- Exact characteristic functional of the time-zero plane Gaussian measure `ν_{ħ, m}`. -/
theorem charFun_planeGaussianMeasure (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (h : 𝓢(SpatialE n, ℝ)) :
    ∫ φ, Complex.exp (Complex.I * (φ h : ℂ)) ∂(planeGaussianMeasure n ħ m hħ hm) =
      Complex.exp (-(1 / 2 : ℂ) * ((∫ k : SpatialE n, ‖planeKernel n ħ m h k‖ ^ 2 : ℝ) : ℂ)) := by
  rw [planeGaussianMeasure, charFun_gaussianSeriesMeasure]
  congr 3
  exact tsum_frameIdx_sq (n + 1) (planeKernel_contDiff n ħ hm h).continuous
    (planeKernel_integrable_norm_sq n ħ hm h)

/-- Exact two-point covariance of the time-zero plane Gaussian measure `ν_{ħ, m}`. -/
theorem integral_mul_planeGaussianMeasure (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (h₁ h₂ : 𝓢(SpatialE n, ℝ)) :
    ∫ φ, φ h₁ * φ h₂ ∂(planeGaussianMeasure n ħ m hħ hm) =
      ∫ k : SpatialE n, (star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k).re := by
  rw [planeGaussianMeasure, integral_mul_gaussianSeriesMeasure]
  exact tsum_frameIdx_mul (n + 1)
    (planeKernel_contDiff n ħ hm h₁).continuous (planeKernel_contDiff n ħ hm h₂).continuous
    (planeKernel_integrable_norm_sq n ħ hm h₁) (planeKernel_integrable_norm_sq n ħ hm h₂)

/-! ### Part 3: Upper Half-Space Dirichlet Gaussian Field `dirichletPosField` -/

/-- Countable seminorm set bounding all upper Dirichlet frame functionals. -/
noncomputable def dirichletFrameSeminorms (n : ℕ) (ħ m : ℝ) (hm : 0 < m) : Finset (ℕ × ℕ) :=
  (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose

/-- Summable positive weights dominating the upper Dirichlet frame functionals. -/
noncomputable def dirichletFrameWeight (n : ℕ) (ħ m : ℝ) (hm : 0 < m) (idx : FrameIdx (n + 2)) : ℝ :=
  ((norm_frameCoeff_le (n + 2)).choose *
    (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose) *
    ((∏ i : Fin (n + 2), (1 + (idx.1.1 i : ℝ) ^ 2)⁻¹) *
      (∏ i : Fin (n + 2), (1 + (idx.1.2 i : ℝ) ^ 2)⁻¹))

lemma dirichletFrameWeight_nonneg (n : ℕ) (ħ m : ℝ) (hm : 0 < m) (idx : FrameIdx (n + 2)) :
    0 ≤ dirichletFrameWeight n ħ m hm idx := by
  have hC1 : 0 < (norm_frameCoeff_le (n + 2)).choose := (norm_frameCoeff_le (n + 2)).choose_spec.1
  have hC2 : 0 < (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose :=
    (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.1
  unfold dirichletFrameWeight
  exact mul_nonneg (mul_nonneg hC1.le hC2.le)
    (mul_nonneg (Finset.prod_nonneg fun _ _ => by positivity)
      (Finset.prod_nonneg fun _ _ => by positivity))

lemma summable_dirichletFrameWeight (n : ℕ) (ħ m : ℝ) (hm : 0 < m) :
    Summable (dirichletFrameWeight n ħ m hm) := by
  have hC1 : 0 < (norm_frameCoeff_le (n + 2)).choose := (norm_frameCoeff_le (n + 2)).choose_spec.1
  have hC2 : 0 < (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose :=
    (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.1
  exact summable_frameWeight_prod_nonneg (n + 2) (mul_nonneg hC1.le hC2.le)

private lemma dirichletFrame_norm_bound (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (z j : Fin (n + 2) → ℤ) (f : 𝓢(EuclidD n, ℝ)) :
    ‖frameCoeff (n + 2) z j (dirichletPosKernel n ħ m f)‖ ≤
      dirichletFrameWeight n ħ m hm ((z, j), false) *
        ((dirichletFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f := by
  have h1 := (norm_frameCoeff_le (n + 2)).choose_spec.2
  have h2 := (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.2
  have hC2 : 0 < (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose :=
    (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose_spec.1
  let M : ℝ := (dirichletPosKernel_iteratedFDeriv_bound n ħ hm).choose_spec.choose *
    (∏ i : Fin (n + 2), (1 + (z i : ℝ) ^ 2)⁻¹) *
    ((dirichletFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f
  have hM : 0 ≤ M := mul_nonneg
    (mul_nonneg hC2.le (Finset.prod_nonneg fun _ _ => by positivity))
    (apply_nonneg _ f)
  have hcd : ContDiff ℝ (2 * (n + 2) : ℕ) (dirichletPosKernel n ħ m f) :=
    (dirichletPosKernel_contDiff n ħ hm f).of_le (WithTop.coe_le_coe.mpr le_top)
  have hbd : ∀ k ≤ 2 * (n + 2), ∀ u ∈ unitCube (n + 2),
      ‖iteratedFDeriv ℝ k (dirichletPosKernel n ħ m f) (intVec z + u)‖ ≤ M := fun k hk u hu =>
    h2 z k hk u hu f
  have hle := h1 z j (dirichletPosKernel n ħ m f) M hcd hM hbd
  calc ‖frameCoeff (n + 2) z j (dirichletPosKernel n ħ m f)‖
      ≤ (norm_frameCoeff_le (n + 2)).choose * (∏ i : Fin (n + 2), (1 + (j i : ℝ) ^ 2)⁻¹) * M := hle
    _ = dirichletFrameWeight n ħ m hm ((z, j), false) *
          ((dirichletFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f := by
      simp only [dirichletFrameWeight, M]
      ring

/-- Real/imaginary tight Parseval frame functional on `𝓢(EuclidD n, ℝ)` associated with
`dirichletPosKernel n ħ m`. -/
noncomputable def dirichletFrameCLM (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (idx : FrameIdx (n + 2)) : 𝓢(EuclidD n, ℝ) →L[ℝ] ℝ :=
  SchwartzMap.mkCLMtoNormedSpace
    (fun f => if idx.2 then (frameCoeff (n + 2) idx.1.1 idx.1.2 (dirichletPosKernel n ħ m f)).im
      else (frameCoeff (n + 2) idx.1.1 idx.1.2 (dirichletPosKernel n ħ m f)).re)
    (fun f₁ f₂ => by
      have hadd : dirichletPosKernel n ħ m (f₁ + f₂) =
          fun p => dirichletPosKernel n ħ m f₁ p + dirichletPosKernel n ħ m f₂ p :=
        funext (dirichletPosKernel_add n ħ m f₁ f₂)
      rw [hadd, frameCoeff_add (n + 2) idx.1.1 idx.1.2
        (dirichletPosKernel_contDiff n ħ hm f₁).continuous
        (dirichletPosKernel_contDiff n ħ hm f₂).continuous]
      cases idx.2 <;> simp)
    (fun a f => by
      have hsm : dirichletPosKernel n ħ m (a • f) =
          fun p => (a : ℂ) * dirichletPosKernel n ħ m f p :=
        funext (dirichletPosKernel_smul n ħ m a f)
      rw [hsm, frameCoeff_smul_real]
      cases idx.2 <;> simp)
    ⟨dirichletFrameSeminorms n ħ m hm, dirichletFrameWeight n ħ m hm idx,
      dirichletFrameWeight_nonneg n ħ m hm idx, fun f => by
        rw [Real.norm_eq_abs]
        have hbn := dirichletFrame_norm_bound n ħ m hm idx.1.1 idx.1.2 f
        have hw_eq : dirichletFrameWeight n ħ m hm ((idx.1.1, idx.1.2), false) =
            dirichletFrameWeight n ħ m hm idx := rfl
        rw [hw_eq] at hbn
        cases idx.2
        · exact (Complex.abs_re_le_norm _).trans hbn
        · exact (Complex.abs_im_le_norm _).trans hbn⟩

lemma dirichletFrameCLM_apply (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (idx : FrameIdx (n + 2)) (f : 𝓢(EuclidD n, ℝ)) :
    dirichletFrameCLM n ħ m hm idx f =
      if idx.2 then (frameCoeff (n + 2) idx.1.1 idx.1.2 (dirichletPosKernel n ħ m f)).im
      else (frameCoeff (n + 2) idx.1.1 idx.1.2 (dirichletPosKernel n ħ m f)).re := rfl

lemma dirichletFrameCLM_bound (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (idx : FrameIdx (n + 2)) (f : 𝓢(EuclidD n, ℝ)) :
    |dirichletFrameCLM n ħ m hm idx f| ≤
      dirichletFrameWeight n ħ m hm idx *
        ((dirichletFrameSeminorms n ħ m hm).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f := by
  have hbn := dirichletFrame_norm_bound n ħ m hm idx.1.1 idx.1.2 f
  have hw_eq : dirichletFrameWeight n ħ m hm ((idx.1.1, idx.1.2), false) =
      dirichletFrameWeight n ħ m hm idx := rfl
  rw [hw_eq] at hbn
  rw [dirichletFrameCLM_apply]
  cases idx.2
  · exact (Complex.abs_re_le_norm _).trans hbn
  · exact (Complex.abs_im_le_norm _).trans hbn

/-- Upper half-space Dirichlet Gaussian random field `Φ₊` on `𝓢'(ℝ^{n+2}, ℝ)`. -/
noncomputable def dirichletPosField (n : ℕ) (ħ m : ℝ) (_hħ : 0 < ħ) (hm : 0 < m) :
    GaussianSeq (FrameIdx (n + 2)) → RealTemperedDistribution (EuclidD n) :=
  gaussianSeriesField (dirichletFrameCLM n ħ m hm) (dirichletFrameWeight n ħ m hm)
    (dirichletFrameWeight_nonneg n ħ m hm) (summable_dirichletFrameWeight n ħ m hm)
    (dirichletFrameSeminorms n ħ m hm) (dirichletFrameCLM_bound n ħ m hm)

theorem measurable_dirichletPosField (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    Measurable[inferInstance, cylMeasurableSpace (EuclidD n)]
      (dirichletPosField n ħ m hħ hm) :=
  measurable_gaussianSeriesField _ _ _ _ _ _

/-- Locality of the upper Dirichlet field: `dirichletPosField` vanishes identically on every
test function supported in `{x₀ ≤ 0}`. -/
theorem dirichletPosField_eq_zero_of_support_nonpos (n : ℕ) (ħ m : ℝ)
    (hħ : 0 < ħ) (hm : 0 < m) (ω : GaussianSeq (FrameIdx (n + 2)))
    (f : 𝓢(EuclidD n, ℝ)) (hf : ∀ x : EuclidD n, 0 < x 0 → f x = 0) :
    dirichletPosField n ħ m hħ hm ω f = 0 := by
  have hzero : dirichletPosKernel n ħ m f = 0 :=
    dirichletPosKernel_eq_zero_of_support_nonpos n ħ m f hf
  have hclm : ∀ idx : FrameIdx (n + 2), dirichletFrameCLM n ħ m hm idx f = 0 := by
    intro idx
    rw [dirichletFrameCLM_apply, hzero, frameCoeff_zero]
    cases idx.2 <;> simp
  unfold dirichletPosField
  by_cases hω : ω ∈ goodSet (dirichletFrameWeight n ħ m hm)
  · rw [gaussianSeriesField_apply_of_mem _ _ _ _ _ _ hω]
    simp [hclm]
  · exact gaussianSeriesField_apply_of_not_mem _ _ _ _ _ _ hω f

private lemma charFun_dirichletPosField (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) :
    ∫ ω : GaussianSeq (FrameIdx (n + 2)),
        Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm ω f : ℂ))
        ∂iidGaussianMeasure (FrameIdx (n + 2)) =
      Complex.exp (-(1 / 2 : ℂ) * ((∫ p : EuclidD n, ‖dirichletPosKernel n ħ m f p‖ ^ 2 : ℝ) : ℂ)) := by
  let _ := cylMeasurableSpace (EuclidD n)
  have hcf := charFun_gaussianSeriesMeasure (dirichletFrameCLM n ħ m hm)
    (dirichletFrameWeight n ħ m hm) (dirichletFrameWeight_nonneg n ħ m hm)
    (summable_dirichletFrameWeight n ħ m hm) (dirichletFrameSeminorms n ħ m hm)
    (dirichletFrameCLM_bound n ħ m hm) f
  have hmap : ∫ φ, Complex.exp (Complex.I * (φ f : ℂ))
        ∂gaussianSeriesMeasure (dirichletFrameCLM n ħ m hm) (dirichletFrameWeight n ħ m hm)
          (dirichletFrameWeight_nonneg n ħ m hm) (summable_dirichletFrameWeight n ħ m hm)
          (dirichletFrameSeminorms n ħ m hm) (dirichletFrameCLM_bound n ħ m hm) =
      ∫ ω, Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm ω f : ℂ))
        ∂iidGaussianMeasure (FrameIdx (n + 2)) := by
    unfold gaussianSeriesMeasure dirichletPosField
    have hmeas_g : Measurable (fun φ : RealTemperedDistribution (EuclidD n) =>
        Complex.exp (Complex.I * (φ f : ℂ))) :=
      (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
        (measurable_eval_cyl f)
    exact integral_map (measurable_gaussianSeriesField _ _ _ _ _ _).aemeasurable
      hmeas_g.aestronglyMeasurable
  rw [← hmap, hcf]
  congr 3
  exact tsum_frameIdx_sq (n + 2) (dirichletPosKernel_contDiff n ħ hm f).continuous
    (dirichletPosKernel_integrable_norm_sq n ħ hm f)

private lemma integral_mul_dirichletPosField (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (f g : 𝓢(EuclidD n, ℝ)) :
    ∫ ω : GaussianSeq (FrameIdx (n + 2)),
        dirichletPosField n ħ m hħ hm ω f * dirichletPosField n ħ m hħ hm ω g
        ∂iidGaussianMeasure (FrameIdx (n + 2)) =
      ∫ p : EuclidD n, (star (dirichletPosKernel n ħ m f p) * dirichletPosKernel n ħ m g p).re := by
  let _ := cylMeasurableSpace (EuclidD n)
  have hcov := integral_mul_gaussianSeriesMeasure (dirichletFrameCLM n ħ m hm)
    (dirichletFrameWeight n ħ m hm) (dirichletFrameWeight_nonneg n ħ m hm)
    (summable_dirichletFrameWeight n ħ m hm) (dirichletFrameSeminorms n ħ m hm)
    (dirichletFrameCLM_bound n ħ m hm) f g
  have hmap : ∫ φ, φ f * φ g
        ∂gaussianSeriesMeasure (dirichletFrameCLM n ħ m hm) (dirichletFrameWeight n ħ m hm)
          (dirichletFrameWeight_nonneg n ħ m hm) (summable_dirichletFrameWeight n ħ m hm)
          (dirichletFrameSeminorms n ħ m hm) (dirichletFrameCLM_bound n ħ m hm) =
      ∫ ω, dirichletPosField n ħ m hħ hm ω f * dirichletPosField n ħ m hħ hm ω g
        ∂iidGaussianMeasure (FrameIdx (n + 2)) := by
    unfold gaussianSeriesMeasure dirichletPosField
    exact integral_map (measurable_gaussianSeriesField _ _ _ _ _ _).aemeasurable
      ((measurable_eval_cyl f).mul (measurable_eval_cyl g)).aestronglyMeasurable
  rw [← hmap, hcov]
  exact tsum_frameIdx_mul (n + 2)
    (dirichletPosKernel_contDiff n ħ hm f).continuous
    (dirichletPosKernel_contDiff n ħ hm g).continuous
    (dirichletPosKernel_integrable_norm_sq n ħ hm f)
    (dirichletPosKernel_integrable_norm_sq n ħ hm g)

/-! ### Part 4: Nelson–Markov Euclidean GFF Measure `gffMeasure` & Bochner–Minlos Theorems -/

/-- Time reflection on real tempered distributions on `ℝ^{n+2}`: `(Θ φ)(f) = φ(θ f)`. -/
noncomputable def reflectDist {n : ℕ} (φ : RealTemperedDistribution (EuclidD n)) :
    RealTemperedDistribution (EuclidD n) :=
  φ.comp reflectSchwartz

@[simp] lemma reflectDist_apply {n : ℕ} (φ : RealTemperedDistribution (EuclidD n))
    (f : 𝓢(EuclidD n, ℝ)) :
    reflectDist φ f = φ (reflectSchwartz f) := rfl

lemma reflectDist_involutive {n : ℕ} (φ : RealTemperedDistribution (EuclidD n)) :
    reflectDist (reflectDist φ) = φ := by
  ext f; simp

lemma reflectDist_add {n : ℕ} (φ ψ : RealTemperedDistribution (EuclidD n)) :
    reflectDist (φ + ψ) = reflectDist φ + reflectDist ψ := by
  ext f; rfl

theorem measurable_reflectDist (n : ℕ) :
    Measurable[cylMeasurableSpace (EuclidD n), cylMeasurableSpace (EuclidD n)]
      (reflectDist (n := n)) := by
  let _ := cylMeasurableSpace (EuclidD n)
  rw [measurable_to_cyl_iff]
  intro f
  exact measurable_eval_cyl (reflectSchwartz f)

/-- Harmonic (Poisson) lift of a time-zero distribution `φ₀ ∈ 𝓢'(ℝ^{n+1}, ℝ)` to `𝓢'(ℝ^{n+2}, ℝ)`:
`(harmonicLift φ₀)(f) = φ₀(P₀ f)`. -/
noncomputable def harmonicLift (n : ℕ) (m : ℝ) (hm : 0 < m)
    (φ₀ : RealTemperedDistribution (SpatialE n)) : RealTemperedDistribution (EuclidD n) :=
  φ₀.comp (poissonProj n m hm)

@[simp] lemma harmonicLift_apply (n : ℕ) (m : ℝ) (hm : 0 < m)
    (φ₀ : RealTemperedDistribution (SpatialE n)) (f : 𝓢(EuclidD n, ℝ)) :
    harmonicLift n m hm φ₀ f = φ₀ (poissonProj n m hm f) := rfl

lemma reflectDist_harmonicLift (n : ℕ) (m : ℝ) (hm : 0 < m)
    (φ₀ : RealTemperedDistribution (SpatialE n)) :
    reflectDist (harmonicLift n m hm φ₀) = harmonicLift n m hm φ₀ := by
  ext f
  simp [poissonProj_reflectSchwartz]

theorem measurable_harmonicLift (n : ℕ) (m : ℝ) (hm : 0 < m) :
    Measurable[cylMeasurableSpace (SpatialE n), cylMeasurableSpace (EuclidD n)]
      (harmonicLift n m hm) := by
  let _ := cylMeasurableSpace (SpatialE n)
  rw [measurable_to_cyl_iff]
  intro f
  exact measurable_eval_cyl (poissonProj n m hm f)

/-- Upper-half-space lift `(φ₀, ω₊) ↦ harmonicLift φ₀ + dirichletPosField ω₊`. -/
noncomputable def gffLiftPos (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (p : RealTemperedDistribution (SpatialE n) × GaussianSeq (FrameIdx (n + 2))) :
    RealTemperedDistribution (EuclidD n) :=
  harmonicLift n m hm p.1 + dirichletPosField n ħ m hħ hm p.2

theorem measurable_gffLiftPos (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    Measurable[@Prod.instMeasurableSpace _ _ (cylMeasurableSpace (SpatialE n)) inferInstance,
      cylMeasurableSpace (EuclidD n)] (gffLiftPos n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (SpatialE n)
  let _ := cylMeasurableSpace (EuclidD n)
  rw [measurable_to_cyl_iff]
  intro f
  change Measurable (fun p : RealTemperedDistribution (SpatialE n) × GaussianSeq (FrameIdx (n + 2)) =>
    p.1 (poissonProj n m hm f) + dirichletPosField n ħ m hħ hm p.2 f)
  have h1 : Measurable (fun p : RealTemperedDistribution (SpatialE n) × GaussianSeq (FrameIdx (n + 2)) =>
      p.1 (poissonProj n m hm f)) :=
    (measurable_eval_cyl (poissonProj n m hm f)).comp measurable_fst
  have h2 : Measurable (fun p : RealTemperedDistribution (SpatialE n) × GaussianSeq (FrameIdx (n + 2)) =>
      dirichletPosField n ħ m hħ hm p.2 f) :=
    ((measurable_eval_cyl f).comp (measurable_dirichletPosField n ħ m hħ hm)).comp measurable_snd
  exact h1.add h2

/-- Triple independent Gaussian noise space `Ω₀ × Ω₊ × Ω₋` for the Nelson–Markov GFF decomposition. -/
abbrev GFFNoise (n : ℕ) :=
  GaussianSeq (FrameIdx (n + 1)) × GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2))

/-- Product Gaussian law `P₀ × P₊ × P₋` on `GFFNoise n`. -/
noncomputable def gffNoiseMeasure (n : ℕ) : Measure (GFFNoise n) :=
  (iidGaussianMeasure (FrameIdx (n + 1))).prod
    ((iidGaussianMeasure (FrameIdx (n + 2))).prod (iidGaussianMeasure (FrameIdx (n + 2))))

instance instIsProbabilityMeasureGffNoiseMeasure (n : ℕ) :
    IsProbabilityMeasure (gffNoiseMeasure n) := by
  unfold gffNoiseMeasure
  infer_instance

/-- Nelson–Markov decomposition of the continuum Euclidean Gaussian Free Field on `𝓢'(ℝ^{n+2}, ℝ)`:
`Φ(ω₀, ω₊, ω₋) = harmonicLift (Φ₀ ω₀) + Φ₊ ω₊ + Θ(Φ₊ ω₋)`. -/
noncomputable def gffField (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (ω : GFFNoise n) : RealTemperedDistribution (EuclidD n) :=
  harmonicLift n m hm (planeGaussianField n ħ m hħ hm ω.1) +
    dirichletPosField n ħ m hħ hm ω.2.1 +
    reflectDist (dirichletPosField n ħ m hħ hm ω.2.2)

lemma gffField_apply (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (ω : GFFNoise n) (f : 𝓢(EuclidD n, ℝ)) :
    gffField n ħ m hħ hm ω f =
      planeGaussianField n ħ m hħ hm ω.1 (poissonProj n m hm f) +
        dirichletPosField n ħ m hħ hm ω.2.1 f +
        dirichletPosField n ħ m hħ hm ω.2.2 (reflectSchwartz f) := rfl

lemma reflectDist_gffField (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (ω₀ : GaussianSeq (FrameIdx (n + 1))) (ωp ωm : GaussianSeq (FrameIdx (n + 2))) :
    reflectDist (gffField n ħ m hħ hm (ω₀, ωp, ωm)) =
      gffField n ħ m hħ hm (ω₀, ωm, ωp) := by
  unfold gffField
  rw [reflectDist_add, reflectDist_add, reflectDist_harmonicLift, reflectDist_involutive]
  abel

theorem measurable_gffField (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    Measurable[inferInstance, cylMeasurableSpace (EuclidD n)] (gffField n ħ m hħ hm) := by
  rw [measurable_to_cyl_iff]
  intro f
  have h1 : Measurable (fun ω : GFFNoise n =>
      planeGaussianField n ħ m hħ hm ω.1 (poissonProj n m hm f)) := by
    let _ := cylMeasurableSpace (SpatialE n)
    exact ((measurable_eval_cyl (poissonProj n m hm f)).comp
      (measurable_planeGaussianField n ħ m hħ hm)).comp measurable_fst
  have h2 : Measurable (fun ω : GFFNoise n => dirichletPosField n ħ m hħ hm ω.2.1 f) := by
    let _ := cylMeasurableSpace (EuclidD n)
    exact ((measurable_eval_cyl f).comp (measurable_dirichletPosField n ħ m hħ hm)).comp
      (measurable_fst.comp measurable_snd)
  have h3 : Measurable (fun ω : GFFNoise n =>
      dirichletPosField n ħ m hħ hm ω.2.2 (reflectSchwartz f)) := by
    let _ := cylMeasurableSpace (EuclidD n)
    exact ((measurable_eval_cyl (reflectSchwartz f)).comp
      (measurable_dirichletPosField n ħ m hħ hm)).comp (measurable_snd.comp measurable_snd)
  exact (h1.add h2).add h3

/-- The continuum massive Euclidean Gaussian Free Field probability measure `μ_{ħ, m}` on
`(RealTemperedDistribution (EuclidD n), cylMeasurableSpace (EuclidD n))`. -/
noncomputable def gffMeasure (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    @Measure (RealTemperedDistribution (EuclidD n)) (cylMeasurableSpace (EuclidD n)) :=
  letI := cylMeasurableSpace (EuclidD n)
  (gffNoiseMeasure n).map (gffField n ħ m hħ hm)

instance instIsProbabilityMeasureGffMeasure (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    @IsProbabilityMeasure (RealTemperedDistribution (EuclidD n)) (cylMeasurableSpace (EuclidD n))
      (gffMeasure n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (EuclidD n)
  unfold gffMeasure
  exact (Measure.isProbabilityMeasure_map_iff
    (measurable_gffField n ħ m hħ hm).aemeasurable).mpr inferInstance

/-- Pushforward of `gffMeasure` to Mathlib's complex tempered distributions `𝓢'(EuclidD n, ℂ)`. -/
noncomputable def gffComplexMeasure (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    @Measure 𝓢'(EuclidD n, ℂ) (cylComplexMeasurableSpace (EuclidD n)) :=
  letI := cylMeasurableSpace (EuclidD n)
  letI := cylComplexMeasurableSpace (EuclidD n)
  (gffMeasure n ħ m hħ hm).map toComplexTempered

instance instIsProbabilityMeasureGffComplexMeasure (n : ℕ) (ħ m : ℝ)
    (hħ : 0 < ħ) (hm : 0 < m) :
    @IsProbabilityMeasure 𝓢'(EuclidD n, ℂ) (cylComplexMeasurableSpace (EuclidD n))
      (gffComplexMeasure n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylComplexMeasurableSpace (EuclidD n)
  unfold gffComplexMeasure
  exact (Measure.isProbabilityMeasure_map_iff
    (measurable_toComplexTempered (EuclidD n)).aemeasurable).mpr inferInstance

/-- **Continuum Gaussian Bochner–Minlos Theorem (Characteristic Functional)**:
for every real Schwartz test `f : 𝓢(EuclidD n, ℝ)`, the characteristic functional of `gffMeasure`
equals `exp (-(1/2) * continuumCovExact n ħ m f f)`. -/
theorem bochnerMinlos_gff_charFun_exact (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) :
    ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) ∂(gffMeasure n ħ m hħ hm) =
      Complex.exp (-(1 / 2 : ℂ) * continuumCovExact n ħ m f f) := by
  let _ := cylMeasurableSpace (EuclidD n)
  have hmap : ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) ∂(gffMeasure n ħ m hħ hm) =
      ∫ ω : GFFNoise n, Complex.exp (Complex.I * (gffField n ħ m hħ hm ω f : ℂ))
        ∂(gffNoiseMeasure n) := by
    unfold gffMeasure
    have hmeas_g : Measurable (fun φ : RealTemperedDistribution (EuclidD n) =>
        Complex.exp (Complex.I * (φ f : ℂ))) :=
      (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
        (measurable_eval_cyl f)
    exact integral_map (measurable_gffField n ħ m hħ hm).aemeasurable hmeas_g.aestronglyMeasurable
  rw [hmap]
  have hsplit : (fun ω : GFFNoise n => Complex.exp (Complex.I * (gffField n ħ m hħ hm ω f : ℂ))) =
      fun ω =>
        Complex.exp (Complex.I * (planeGaussianField n ħ m hħ hm ω.1 (poissonProj n m hm f) : ℂ)) *
          (Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm ω.2.1 f : ℂ)) *
            Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm ω.2.2 (reflectSchwartz f) : ℂ))) := by
    funext ω
    simp only [gffField_apply, Complex.ofReal_add, mul_add, Complex.exp_add, mul_assoc]
  rw [hsplit]
  unfold gffNoiseMeasure
  rw [integral_prod_mul (f := fun ω₀ =>
      Complex.exp (Complex.I * (planeGaussianField n ħ m hħ hm ω₀ (poissonProj n m hm f) : ℂ)))
    (g := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) =>
      Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm q.1 f : ℂ)) *
        Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm q.2 (reflectSchwartz f) : ℂ)))]
  rw [integral_prod_mul (f := fun ωp =>
      Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm ωp f : ℂ)))
    (g := fun ωm =>
      Complex.exp (Complex.I * (dirichletPosField n ħ m hħ hm ωm (reflectSchwartz f) : ℂ)))]
  have hplane : ∫ ω₀ : GaussianSeq (FrameIdx (n + 1)),
        Complex.exp (Complex.I * (planeGaussianField n ħ m hħ hm ω₀ (poissonProj n m hm f) : ℂ))
        ∂iidGaussianMeasure (FrameIdx (n + 1)) =
      Complex.exp (-(1 / 2 : ℂ) *
        ((∫ k : SpatialE n, ‖planeKernel n ħ m (poissonProj n m hm f) k‖ ^ 2 : ℝ) : ℂ)) := by
    let _ := cylMeasurableSpace (SpatialE n)
    have h1 := charFun_planeGaussianMeasure n ħ m hħ hm (poissonProj n m hm f)
    have h2 : ∫ φ, Complex.exp (Complex.I * (φ (poissonProj n m hm f) : ℂ))
          ∂(planeGaussianMeasure n ħ m hħ hm) =
        ∫ ω₀, Complex.exp (Complex.I * (planeGaussianField n ħ m hħ hm ω₀ (poissonProj n m hm f) : ℂ))
          ∂iidGaussianMeasure (FrameIdx (n + 1)) := by
      unfold planeGaussianMeasure planeGaussianField gaussianSeriesMeasure
      have hmeas_g : Measurable (fun φ : RealTemperedDistribution (SpatialE n) =>
          Complex.exp (Complex.I * (φ (poissonProj n m hm f) : ℂ))) :=
        (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
          (measurable_eval_cyl _)
      exact integral_map (measurable_gaussianSeriesField _ _ _ _ _ _).aemeasurable
        hmeas_g.aestronglyMeasurable
    exact h2.symm.trans h1
  rw [hplane, charFun_dirichletPosField n ħ m hħ hm f,
    charFun_dirichletPosField n ħ m hħ hm (reflectSchwartz f),
    ← Complex.exp_add, ← Complex.exp_add]
  congr 1
  have hcov := nelson_markov_covariance_split_complex n hħ.le hm f
  rw [← hcov]
  push_cast
  ring

private lemma continuumCovExact_im_zero (n : ℕ) (ħ m : ℝ) (f g : 𝓢(EuclidD n, ℝ)) :
    (continuumCovExact n ħ m f g).im = 0 := by
  have hconj : starRingEnd ℂ (continuumCovExact n ħ m f g) = continuumCovExact n ħ m f g := by
    unfold continuumCovExact
    rw [map_mul, Complex.conj_ofReal, ← integral_conj]
    congr 1
    have hmp : MeasurePreserving (fun p : EuclidD n => -p) volume volume :=
      Measure.measurePreserving_neg volume
    have h1 : (∫ p : EuclidD n,
          starRingEnd ℂ (star (physicsFourierExact f p) * physicsFourierExact g p *
            ((‖p‖ ^ 2 + m ^ 2 : ℝ)⁻¹ : ℂ))) =
        ∫ p : EuclidD n,
          star (physicsFourierExact f (-p)) * physicsFourierExact g (-p) *
            ((‖-p‖ ^ 2 + m ^ 2 : ℝ)⁻¹ : ℂ) := by
      refine integral_congr_ae (ae_of_all _ fun p => ?_)
      simp only [map_mul, map_inv₀, Complex.conj_ofReal, RCLike.star_def, physicsFourierExact_neg,
        norm_neg, RingHomCompTriple.comp_apply, RingHom.id_apply]
    rw [h1]
    have hsub := hmp.integral_comp' (f := MeasurableEquiv.neg (EuclidD n))
      (g := fun p : EuclidD n => star (physicsFourierExact f p) * physicsFourierExact g p *
        ((‖p‖ ^ 2 + m ^ 2 : ℝ)⁻¹ : ℂ))
    simpa using hsub
  exact Complex.conj_eq_iff_im.mp hconj

/-- **Continuum Gaussian Bochner–Minlos Theorem (Exact Two-Point Covariance)**:
for every pair of real Schwartz tests `f, g : 𝓢(EuclidD n, ℝ)`,
`∫ φ, (φ f : ℂ) * (φ g : ℂ) ∂(gffMeasure n ħ m hħ hm) = continuumCovExact n ħ m f g`. -/
theorem bochnerMinlos_gff_covariance_exact (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (f g : 𝓢(EuclidD n, ℝ)) :
    ∫ φ, (φ f : ℂ) * (φ g : ℂ) ∂(gffMeasure n ħ m hħ hm) =
      continuumCovExact n ħ m f g := by
  let _ := cylMeasurableSpace (EuclidD n)
  have hreal : ∫ φ, φ f * φ g ∂(gffMeasure n ħ m hħ hm) = (continuumCovExact n ħ m f g).re := by
    have hmap : ∫ φ, φ f * φ g ∂(gffMeasure n ħ m hħ hm) =
        ∫ ω : GFFNoise n, gffField n ħ m hħ hm ω f * gffField n ħ m hħ hm ω g
          ∂(gffNoiseMeasure n) := by
      unfold gffMeasure
      exact integral_map (measurable_gffField n ħ m hħ hm).aemeasurable
        ((measurable_eval_cyl f).mul (measurable_eval_cyl g)).aestronglyMeasurable
    rw [hmap]
    let X₀ : GaussianSeq (FrameIdx (n + 1)) → ℝ := fun ω₀ =>
      planeGaussianField n ħ m hħ hm ω₀ (poissonProj n m hm f)
    let Y₀ : GaussianSeq (FrameIdx (n + 1)) → ℝ := fun ω₀ =>
      planeGaussianField n ħ m hħ hm ω₀ (poissonProj n m hm g)
    let Xp : GaussianSeq (FrameIdx (n + 2)) → ℝ := fun ωp => dirichletPosField n ħ m hħ hm ωp f
    let Yp : GaussianSeq (FrameIdx (n + 2)) → ℝ := fun ωp => dirichletPosField n ħ m hħ hm ωp g
    let Xm : GaussianSeq (FrameIdx (n + 2)) → ℝ := fun ωm =>
      dirichletPosField n ħ m hħ hm ωm (reflectSchwartz f)
    let Ym : GaussianSeq (FrameIdx (n + 2)) → ℝ := fun ωm =>
      dirichletPosField n ħ m hħ hm ωm (reflectSchwartz g)
    have hmem_plane : ∀ h : 𝓢(SpatialE n, ℝ),
        MemLp (fun ω₀ => planeGaussianField n ħ m hħ hm ω₀ h) 2
          (iidGaussianMeasure (FrameIdx (n + 1))) := fun h => by
      let _ := cylMeasurableSpace (SpatialE n)
      have hmp : MeasurePreserving (planeGaussianField n ħ m hħ hm)
          (iidGaussianMeasure (FrameIdx (n + 1))) (planeGaussianMeasure n ħ m hħ hm) :=
        ⟨measurable_planeGaussianField n ħ m hħ hm, rfl⟩
      exact (memLp_eval_real_gaussianSeriesMeasure _ _ _ _ _ _ h).comp_measurePreserving hmp
    have hmem_dir : ∀ h : 𝓢(EuclidD n, ℝ),
        MemLp (fun ωp => dirichletPosField n ħ m hħ hm ωp h) 2
          (iidGaussianMeasure (FrameIdx (n + 2))) := fun h => by
      let _ := cylMeasurableSpace (EuclidD n)
      have hmp : MeasurePreserving (dirichletPosField n ħ m hħ hm)
          (iidGaussianMeasure (FrameIdx (n + 2)))
          (gaussianSeriesMeasure (dirichletFrameCLM n ħ m hm) (dirichletFrameWeight n ħ m hm)
            (dirichletFrameWeight_nonneg n ħ m hm) (summable_dirichletFrameWeight n ħ m hm)
            (dirichletFrameSeminorms n ħ m hm) (dirichletFrameCLM_bound n ħ m hm)) :=
        ⟨measurable_dirichletPosField n ħ m hħ hm, rfl⟩
      exact (memLp_eval_real_gaussianSeriesMeasure _ _ _ _ _ _ h).comp_measurePreserving hmp
    have hX₀ : MemLp X₀ 2 (iidGaussianMeasure (FrameIdx (n + 1))) := hmem_plane _
    have hY₀ : MemLp Y₀ 2 (iidGaussianMeasure (FrameIdx (n + 1))) := hmem_plane _
    have hXp : MemLp Xp 2 (iidGaussianMeasure (FrameIdx (n + 2))) := hmem_dir _
    have hYp : MemLp Yp 2 (iidGaussianMeasure (FrameIdx (n + 2))) := hmem_dir _
    have hXm : MemLp Xm 2 (iidGaussianMeasure (FrameIdx (n + 2))) := hmem_dir _
    have hYm : MemLp Ym 2 (iidGaussianMeasure (FrameIdx (n + 2))) := hmem_dir _
    have hint_pm : ∀ (A B : GaussianSeq (FrameIdx (n + 2)) → ℝ),
        Integrable A (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable B (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable (fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) =>
          A q.1 * B q.2)
          ((iidGaussianMeasure (FrameIdx (n + 2))).prod (iidGaussianMeasure (FrameIdx (n + 2)))) :=
      fun A B hA hB => hA.mul_prod hB
    have hlift0 : ∀ (A : GaussianSeq (FrameIdx (n + 1)) → ℝ),
        Integrable A (iidGaussianMeasure (FrameIdx (n + 1))) →
        Integrable (fun ω : GFFNoise n => A ω.1) (gffNoiseMeasure n) := fun A hA =>
      hA.comp_fst _
    have hliftp : ∀ (A : GaussianSeq (FrameIdx (n + 2)) → ℝ),
        Integrable A (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable (fun ω : GFFNoise n => A ω.2.1) (gffNoiseMeasure n) := fun A hA =>
      (hA.comp_fst _).comp_snd _
    have hliftm : ∀ (A : GaussianSeq (FrameIdx (n + 2)) → ℝ),
        Integrable A (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable (fun ω : GFFNoise n => A ω.2.2) (gffNoiseMeasure n) := fun A hA =>
      (hA.comp_snd _).comp_snd _
    have hcross0p : ∀ (A : GaussianSeq (FrameIdx (n + 1)) → ℝ)
        (B : GaussianSeq (FrameIdx (n + 2)) → ℝ),
        Integrable A (iidGaussianMeasure (FrameIdx (n + 1))) →
        Integrable B (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable (fun ω : GFFNoise n => A ω.1 * B ω.2.1) (gffNoiseMeasure n) := fun A B hA hB =>
      hA.mul_prod (hB.comp_fst _)
    have hcross0m : ∀ (A : GaussianSeq (FrameIdx (n + 1)) → ℝ)
        (B : GaussianSeq (FrameIdx (n + 2)) → ℝ),
        Integrable A (iidGaussianMeasure (FrameIdx (n + 1))) →
        Integrable B (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable (fun ω : GFFNoise n => A ω.1 * B ω.2.2) (gffNoiseMeasure n) := fun A B hA hB =>
      hA.mul_prod (hB.comp_snd _)
    have hcrosspm : ∀ (A B : GaussianSeq (FrameIdx (n + 2)) → ℝ),
        Integrable A (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable B (iidGaussianMeasure (FrameIdx (n + 2))) →
        Integrable (fun ω : GFFNoise n => A ω.2.1 * B ω.2.2) (gffNoiseMeasure n) := fun A B hA hB =>
      (hint_pm A B hA hB).comp_snd _
    have hexp : (fun ω : GFFNoise n => gffField n ħ m hħ hm ω f * gffField n ħ m hħ hm ω g) =
        fun ω =>
          (((((((X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1) + X₀ ω.1 * Ym ω.2.2) +
            Xp ω.2.1 * Y₀ ω.1) + Xp ω.2.1 * Yp ω.2.1) + Xp ω.2.1 * Ym ω.2.2) +
            Xm ω.2.2 * Y₀ ω.1) + Xm ω.2.2 * Yp ω.2.1) + Xm ω.2.2 * Ym ω.2.2 := by
      funext ω; simp only [gffField_apply, X₀, Y₀, Xp, Yp, Xm, Ym]; ring
    rw [hexp]
    have h1 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1) (gffNoiseMeasure n) :=
      hlift0 (fun ω₀ => X₀ ω₀ * Y₀ ω₀) (hX₀.integrable_mul hY₀)
    have h2 := hcross0p X₀ Yp (hX₀.integrable one_le_two) (hYp.integrable one_le_two)
    have h3 := hcross0m X₀ Ym (hX₀.integrable one_le_two) (hYm.integrable one_le_two)
    have h4 : Integrable (fun ω : GFFNoise n => Xp ω.2.1 * Y₀ ω.1) (gffNoiseMeasure n) :=
      (hcross0p Y₀ Xp (hY₀.integrable one_le_two) (hXp.integrable one_le_two)).congr
        (ae_of_all _ fun ω => mul_comm _ _)
    have h5 : Integrable (fun ω : GFFNoise n => Xp ω.2.1 * Yp ω.2.1) (gffNoiseMeasure n) :=
      hliftp (fun ωp => Xp ωp * Yp ωp) (hXp.integrable_mul hYp)
    have h6 := hcrosspm Xp Ym (hXp.integrable one_le_two) (hYm.integrable one_le_two)
    have h7 : Integrable (fun ω : GFFNoise n => Xm ω.2.2 * Y₀ ω.1) (gffNoiseMeasure n) :=
      (hcross0m Y₀ Xm (hY₀.integrable one_le_two) (hXm.integrable one_le_two)).congr
        (ae_of_all _ fun ω => mul_comm _ _)
    have h8 : Integrable (fun ω : GFFNoise n => Xm ω.2.2 * Yp ω.2.1) (gffNoiseMeasure n) :=
      (hcrosspm Yp Xm (hYp.integrable one_le_two) (hXm.integrable one_le_two)).congr
        (ae_of_all _ fun ω => mul_comm _ _)
    have h9 : Integrable (fun ω : GFFNoise n => Xm ω.2.2 * Ym ω.2.2) (gffNoiseMeasure n) :=
      hliftm (fun ωm => Xm ωm * Ym ωm) (hXm.integrable_mul hYm)
    have h12 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1) (gffNoiseMeasure n) :=
      h1.add h2
    have h13 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1 + X₀ ω.1 * Ym ω.2.2) (gffNoiseMeasure n) :=
      h12.add h3
    have h14 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1 + X₀ ω.1 * Ym ω.2.2 + Xp ω.2.1 * Y₀ ω.1) (gffNoiseMeasure n) :=
      h13.add h4
    have h15 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1 + X₀ ω.1 * Ym ω.2.2 + Xp ω.2.1 * Y₀ ω.1 + Xp ω.2.1 * Yp ω.2.1) (gffNoiseMeasure n) :=
      h14.add h5
    have h16 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1 + X₀ ω.1 * Ym ω.2.2 + Xp ω.2.1 * Y₀ ω.1 + Xp ω.2.1 * Yp ω.2.1 + Xp ω.2.1 * Ym ω.2.2) (gffNoiseMeasure n) :=
      h15.add h6
    have h17 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1 + X₀ ω.1 * Ym ω.2.2 + Xp ω.2.1 * Y₀ ω.1 + Xp ω.2.1 * Yp ω.2.1 + Xp ω.2.1 * Ym ω.2.2 + Xm ω.2.2 * Y₀ ω.1) (gffNoiseMeasure n) :=
      h16.add h7
    have h18 : Integrable (fun ω : GFFNoise n => X₀ ω.1 * Y₀ ω.1 + X₀ ω.1 * Yp ω.2.1 + X₀ ω.1 * Ym ω.2.2 + Xp ω.2.1 * Y₀ ω.1 + Xp ω.2.1 * Yp ω.2.1 + Xp ω.2.1 * Ym ω.2.2 + Xm ω.2.2 * Y₀ ω.1 + Xm ω.2.2 * Yp ω.2.1) (gffNoiseMeasure n) :=
      h17.add h8
    rw [integral_add h18 h9, integral_add h17 h8, integral_add h16 h7, integral_add h15 h6,
      integral_add h14 h5, integral_add h13 h4, integral_add h12 h3, integral_add h1 h2]
    have hzeroX₀ : ∫ ω₀, X₀ ω₀ ∂iidGaussianMeasure (FrameIdx (n + 1)) = 0 :=
      integral_gaussianSeriesField_eq_zero _ _ _ _ _ _ _
    have hzeroY₀ : ∫ ω₀, Y₀ ω₀ ∂iidGaussianMeasure (FrameIdx (n + 1)) = 0 :=
      integral_gaussianSeriesField_eq_zero _ _ _ _ _ _ _
    have hzeroXp : ∫ ωp, Xp ωp ∂iidGaussianMeasure (FrameIdx (n + 2)) = 0 :=
      integral_gaussianSeriesField_eq_zero _ _ _ _ _ _ _
    have hzeroYp : ∫ ωp, Yp ωp ∂iidGaussianMeasure (FrameIdx (n + 2)) = 0 :=
      integral_gaussianSeriesField_eq_zero _ _ _ _ _ _ _
    have hzeroXm : ∫ ωm, Xm ωm ∂iidGaussianMeasure (FrameIdx (n + 2)) = 0 :=
      integral_gaussianSeriesField_eq_zero _ _ _ _ _ _ _
    have hzeroYm : ∫ ωm, Ym ωm ∂iidGaussianMeasure (FrameIdx (n + 2)) = 0 :=
      integral_gaussianSeriesField_eq_zero _ _ _ _ _ _ _
    have hi2 : ∫ ω : GFFNoise n, X₀ ω.1 * Yp ω.2.1 ∂(gffNoiseMeasure n) = 0 := by
      unfold gffNoiseMeasure
      rw [integral_prod_mul (f := X₀)
        (g := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Yp q.1),
        hzeroX₀, zero_mul]
    have hi3 : ∫ ω : GFFNoise n, X₀ ω.1 * Ym ω.2.2 ∂(gffNoiseMeasure n) = 0 := by
      unfold gffNoiseMeasure
      rw [integral_prod_mul (f := X₀)
        (g := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Ym q.2),
        hzeroX₀, zero_mul]
    have hi4 : ∫ ω : GFFNoise n, Xp ω.2.1 * Y₀ ω.1 ∂(gffNoiseMeasure n) = 0 := by
      simp_rw [mul_comm (Xp _)]
      unfold gffNoiseMeasure
      rw [integral_prod_mul (f := Y₀)
        (g := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Xp q.1),
        hzeroY₀, zero_mul]
    have hi6 : ∫ ω : GFFNoise n, Xp ω.2.1 * Ym ω.2.2 ∂(gffNoiseMeasure n) = 0 := by
      unfold gffNoiseMeasure
      rw [integral_fun_snd
        (f := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Xp q.1 * Ym q.2),
        integral_prod_mul Xp Ym, hzeroXp, zero_mul, smul_zero]
    have hi7 : ∫ ω : GFFNoise n, Xm ω.2.2 * Y₀ ω.1 ∂(gffNoiseMeasure n) = 0 := by
      simp_rw [mul_comm (Xm _)]
      unfold gffNoiseMeasure
      rw [integral_prod_mul (f := Y₀)
        (g := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Xm q.2),
        hzeroY₀, zero_mul]
    have hi8 : ∫ ω : GFFNoise n, Xm ω.2.2 * Yp ω.2.1 ∂(gffNoiseMeasure n) = 0 := by
      simp_rw [mul_comm (Xm _)]
      unfold gffNoiseMeasure
      rw [integral_fun_snd
        (f := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Yp q.1 * Xm q.2),
        integral_prod_mul Yp Xm, hzeroYp, zero_mul, smul_zero]
    have hi1 : ∫ ω : GFFNoise n, X₀ ω.1 * Y₀ ω.1 ∂(gffNoiseMeasure n) =
        ∫ k : SpatialE n, (star (planeKernel n ħ m (poissonProj n m hm f) k) *
          planeKernel n ħ m (poissonProj n m hm g) k).re := by
      unfold gffNoiseMeasure
      rw [integral_fun_fst (f := fun ω₀ => X₀ ω₀ * Y₀ ω₀)]
      simp only [Measure.real_def, measure_univ, ENNReal.toReal_one, one_smul]
      let _ := cylMeasurableSpace (SpatialE n)
      have hmap0 : ∫ φ, φ (poissonProj n m hm f) * φ (poissonProj n m hm g)
            ∂(planeGaussianMeasure n ħ m hħ hm) =
          ∫ ω₀, X₀ ω₀ * Y₀ ω₀ ∂iidGaussianMeasure (FrameIdx (n + 1)) := by
        dsimp only [planeGaussianMeasure, gaussianSeriesMeasure, X₀, Y₀, planeGaussianField]
        exact integral_map (measurable_gaussianSeriesField _ _ _ _ _ _).aemeasurable
          ((measurable_eval_cyl _).mul (measurable_eval_cyl _)).aestronglyMeasurable
      rw [← hmap0, integral_mul_planeGaussianMeasure]
    have hi5 : ∫ ω : GFFNoise n, Xp ω.2.1 * Yp ω.2.1 ∂(gffNoiseMeasure n) =
        ∫ p : EuclidD n, (star (dirichletPosKernel n ħ m f p) * dirichletPosKernel n ħ m g p).re := by
      unfold gffNoiseMeasure
      rw [integral_fun_snd
        (f := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Xp q.1 * Yp q.1),
        integral_fun_fst (f := fun ωp => Xp ωp * Yp ωp)]
      simp only [Measure.real_def, measure_univ, ENNReal.toReal_one, one_smul]
      exact integral_mul_dirichletPosField n ħ m hħ hm f g
    have hi9 : ∫ ω : GFFNoise n, Xm ω.2.2 * Ym ω.2.2 ∂(gffNoiseMeasure n) =
        ∫ p : EuclidD n, (star (dirichletPosKernel n ħ m (reflectSchwartz f) p) *
          dirichletPosKernel n ħ m (reflectSchwartz g) p).re := by
      unfold gffNoiseMeasure
      rw [integral_fun_snd
        (f := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => Xm q.2 * Ym q.2),
        integral_fun_snd (f := fun ωm => Xm ωm * Ym ωm)]
      simp only [Measure.real_def, measure_univ, ENNReal.toReal_one, one_smul]
      exact integral_mul_dirichletPosField n ħ m hħ hm (reflectSchwartz f) (reflectSchwartz g)
    rw [hi1, hi2, hi3, hi4, hi5, hi6, hi7, hi8, hi9]
    have hsplit := nelson_markov_covariance_split_bilinear n hħ.le hm f g
    linarith
  have hcast : ∫ φ, (φ f : ℂ) * (φ g : ℂ) ∂(gffMeasure n ħ m hħ hm) =
      ((∫ φ, φ f * φ g ∂(gffMeasure n ħ m hħ hm) : ℝ) : ℂ) := by
    simp_rw [← Complex.ofReal_mul]
    exact integral_complex_ofReal
  rw [hcast, hreal]
  apply Complex.ext
  · simp
  · simp [continuumCovExact_im_zero]

/-! ### Part 5: Countable `s`-Dense Test Family, Frame Preimages & Sharp-Time Trace `gffTrace0` -/

/-- Inverse physics Fourier transform on complex Schwartz functions:
`(physicsFourierInvCLM d g) x = (2π)^(d/2) * (𝓕⁻ g) (2π • x)` so that
`physicsFourierExactC (physicsFourierInvCLM d g) = g`. -/
noncomputable def physicsFourierInvCLM (d : ℕ) :
    𝓢(EuclideanSpace ℝ (Fin d), ℂ) →L[ℂ] 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
  let scEquiv : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d) :=
    LinearEquiv.toContinuousLinearEquiv
      { toFun := fun x => (2 * Real.pi) • x
        invFun := fun x => (2 * Real.pi)⁻¹ • x
        left_inv := fun x => by
          dsimp only
          rw [smul_smul, inv_mul_cancel₀ (mul_pos two_pos Real.pi_pos).ne', one_smul]
        right_inv := fun x => by
          dsimp only
          rw [smul_smul, mul_inv_cancel₀ (mul_pos two_pos Real.pi_pos).ne', one_smul]
        map_add' := fun x y => smul_add _ _ _
        map_smul' := fun c x => by
          change (2 * Real.pi) • (c • x) = c • ((2 * Real.pi) • x)
          rw [smul_comm] }
  let compSc : 𝓢(EuclideanSpace ℝ (Fin d), ℂ) →L[ℂ] 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ scEquiv
  let ftInv : 𝓢(EuclideanSpace ℝ (Fin d), ℂ) →L[ℂ] 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
      (LinearIsometryEquiv.neg ℝ (E := EuclideanSpace ℝ (Fin d))).toContinuousLinearEquiv).comp
      (SchwartzMap.fourierTransformCLM ℂ)
  (((2 * Real.pi) ^ ((d : ℝ) / 2) : ℝ) : ℂ) • (ftInv.comp compSc)

private lemma physicsFourier_physicsFourierInvCLM {d : ℕ}
    (g : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (k : EuclideanSpace ℝ (Fin d)) :
    ((2 * Real.pi) ^ (-(d : ℝ) / 2) : ℝ) *
      𝓕 (fun x => physicsFourierInvCLM d g x) ((2 * Real.pi)⁻¹ • k) = g k := by
  let scEquiv : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d) :=
    LinearEquiv.toContinuousLinearEquiv
      { toFun := fun x => (2 * Real.pi) • x
        invFun := fun x => (2 * Real.pi)⁻¹ • x
        left_inv := fun x => by
          dsimp only
          rw [smul_smul, inv_mul_cancel₀ (mul_pos two_pos Real.pi_pos).ne', one_smul]
        right_inv := fun x => by
          dsimp only
          rw [smul_smul, mul_inv_cancel₀ (mul_pos two_pos Real.pi_pos).ne', one_smul]
        map_add' := fun x y => smul_add _ _ _
        map_smul' := fun c x => by
          change (2 * Real.pi) • (c • x) = c • ((2 * Real.pi) • x)
          rw [smul_comm] }
  let gSc : 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ scEquiv g
  have hcoe : (fun x => physicsFourierInvCLM d g x) =
      ⇑((((2 * Real.pi) ^ ((d : ℝ) / 2) : ℝ) : ℂ) • (𝓕⁻ gSc)) := rfl
  rw [hcoe, ← SchwartzMap.fourier_coe]
  have hFT : 𝓕 ((((2 * Real.pi) ^ ((d : ℝ) / 2) : ℝ) : ℂ) • (𝓕⁻ gSc)) =
      (((2 * Real.pi) ^ ((d : ℝ) / 2) : ℝ) : ℂ) • gSc := by
    change SchwartzMap.fourierTransformCLM ℂ _ = _
    rw [map_smul]
    congr 1
    exact FourierInvPair.fourier_fourierInv_eq (E := 𝓢(EuclideanSpace ℝ (Fin d), ℂ))
      (F := 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) gSc
  rw [hFT]
  simp only [smul_apply, smul_eq_mul, gSc,
    SchwartzMap.compCLMOfContinuousLinearEquiv_apply, Function.comp_apply]
  have hsc : scEquiv ((2 * Real.pi)⁻¹ • k) = k := by
    change (2 * Real.pi) • ((2 * Real.pi)⁻¹ • k) = k
    rw [smul_smul, mul_inv_cancel₀ (mul_pos two_pos Real.pi_pos).ne', one_smul]
  rw [hsc, ← mul_assoc, ← Complex.ofReal_mul]
  have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
  rw [← Real.rpow_add h2pi, show -(d : ℝ) / 2 + (d : ℝ) / 2 = 0 by ring, Real.rpow_zero,
    Complex.ofReal_one, one_mul]

/-- Inverse plane multiplier `√(2 ω_m(k)) / √ħ` (in `ℂ`). -/
noncomputable def invPlaneMult {n : ℕ} (ħ m : ℝ) (k : SpatialE n) : ℂ :=
  ((Real.sqrt (2 * euclidDispersion m k) / Real.sqrt ħ : ℝ) : ℂ)

lemma hasTemperateGrowth_invPlaneMult {n : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m) :
    Function.HasTemperateGrowth (invPlaneMult (n := n) ħ m) := by
  have hrpow : Function.HasTemperateGrowth
      (fun k : SpatialE n => (m ^ 2 + ‖k‖ ^ 2) ^ (1 / 4 : ℝ)) :=
    hasTemperateGrowth_sq_add_norm_sq_rpow hm (1 / 4)
  have hreal : Function.HasTemperateGrowth
      (fun k : SpatialE n => Real.sqrt (2 * euclidDispersion m k) / Real.sqrt ħ) := by
    have heq : (fun k : SpatialE n => Real.sqrt (2 * euclidDispersion m k) / Real.sqrt ħ) =
        fun k => (Real.sqrt 2 / Real.sqrt ħ) * (m ^ 2 + ‖k‖ ^ 2) ^ (1 / 4 : ℝ) := by
      funext k
      have hpos : 0 < m ^ 2 + ‖k‖ ^ 2 := by positivity
      unfold euclidDispersion
      rw [Real.sqrt_mul two_pos.le,
        show Real.sqrt (Real.sqrt (m ^ 2 + ‖k‖ ^ 2)) = (m ^ 2 + ‖k‖ ^ 2) ^ (1 / 4 : ℝ) by
          rw [Real.sqrt_eq_rpow, Real.sqrt_eq_rpow, ← Real.rpow_mul hpos.le]; norm_num]
      ring
    rw [heq]
    exact (Function.HasTemperateGrowth.const _).mul hrpow
  exact Complex.hasTemperateGrowth_ofReal.comp hreal

lemma planeMult_mul_invPlaneMult {n : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) (k : SpatialE n) :
    planeMult ħ m k * invPlaneMult ħ m k = 1 := by
  unfold planeMult invPlaneMult
  rw [← Complex.ofReal_mul]
  have h1 : Real.sqrt ħ ≠ 0 := (Real.sqrt_pos.mpr hħ).ne'
  have h2 : Real.sqrt (2 * euclidDispersion m k) ≠ 0 :=
    (Real.sqrt_pos.mpr (by positivity [euclidDispersion_pos hm k])).ne'
  have hmul : (Real.sqrt ħ / Real.sqrt (2 * euclidDispersion m k)) *
      (Real.sqrt (2 * euclidDispersion m k) / Real.sqrt ħ) = 1 := by
    field_simp [h1, h2]
  rw [hmul, Complex.ofReal_one]

/-- Complex preimage `g ↦ ℱ⁻¹(invPlaneMult · g)` inverting `planeKernel` on `𝓢(SpatialE n, ℂ)`. -/
noncomputable def planeKernelInvCLM (n : ℕ) (ħ m : ℝ) (_hħ : 0 < ħ) (_hm : 0 < m) :
    𝓢(SpatialE n, ℂ) →L[ℂ] 𝓢(SpatialE n, ℂ) :=
  (physicsFourierInvCLM (n + 1)).comp (SchwartzMap.smulLeftCLM ℂ (invPlaneMult (n := n) ħ m))

lemma planeKernel_re_im_of_inv (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (g : 𝓢(SpatialE n, ℂ)) (k : SpatialE n) :
    let hC := planeKernelInvCLM n ħ m hħ hm g
    let hRe := hC.postcompCLM Complex.reCLM
    let hIm := hC.postcompCLM Complex.imCLM
    planeKernel n ħ m hRe k + Complex.I * planeKernel n ħ m hIm k = g k := by
  intro hC hRe hIm
  have hdecomp : ∀ x : SpatialE n, (hRe x : ℂ) + Complex.I * (hIm x : ℂ) = hC x := fun x => by
    apply Complex.ext <;> simp [hRe, hIm]
  have hFT_add : physicsFourierExact hRe k + Complex.I * physicsFourierExact hIm k =
      ((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) *
        𝓕 (fun x => hC x) ((2 * Real.pi)⁻¹ • k) := by
    unfold physicsFourierExact
    rw [← mul_assoc, mul_comm Complex.I, mul_assoc, ← mul_add]
    congr 1
    have hReC : (fun x => (hRe x : ℂ)) = ⇑(hRe.postcompCLM Complex.ofRealCLM) := rfl
    have hImC : (fun x => (hIm x : ℂ)) = ⇑(hIm.postcompCLM Complex.ofRealCLM) := rfl
    have hEqC : hC = hRe.postcompCLM Complex.ofRealCLM +
        Complex.I • hIm.postcompCLM Complex.ofRealCLM := by
      ext x; exact (hdecomp x).symm
    rw [hReC, hImC, ← SchwartzMap.fourier_coe, ← SchwartzMap.fourier_coe,
      show (fun x => hC x) = ⇑hC from rfl, ← SchwartzMap.fourier_coe hC, hEqC]
    change (SchwartzMap.fourierTransformCLM ℂ (hRe.postcompCLM Complex.ofRealCLM)) ((2 * Real.pi)⁻¹ • k) +
        Complex.I * (SchwartzMap.fourierTransformCLM ℂ (hIm.postcompCLM Complex.ofRealCLM)) ((2 * Real.pi)⁻¹ • k) =
      (SchwartzMap.fourierTransformCLM ℂ
        (hRe.postcompCLM Complex.ofRealCLM + Complex.I • hIm.postcompCLM Complex.ofRealCLM)) ((2 * Real.pi)⁻¹ • k)
    rw [map_add (SchwartzMap.fourierTransformCLM ℂ),
      map_smul (SchwartzMap.fourierTransformCLM ℂ)]
    rfl
  unfold planeKernel
  rw [← mul_assoc, mul_comm Complex.I, mul_assoc, ← mul_add, hFT_add]
  have hinv := physicsFourier_physicsFourierInvCLM
    (SchwartzMap.smulLeftCLM ℂ (invPlaneMult (n := n) ħ m) g) k
  change planeMult ħ m k * (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) *
    𝓕 (fun x => physicsFourierInvCLM (n + 1)
      (SchwartzMap.smulLeftCLM ℂ (invPlaneMult (n := n) ħ m) g) x) ((2 * Real.pi)⁻¹ • k)) = g k
  rw [hinv, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_invPlaneMult ħ hm),
    smul_eq_mul, ← mul_assoc, planeMult_mul_invPlaneMult hħ hm k, one_mul]

/-- The synthesis atom `e_{z,j}(k) = 2^{-(n+1)/2} unitBump(k - z) exp(i π ∑ j_r (k_r - z_r))`
as a compactly supported smooth (hence Schwartz) function on `SpatialE n`. -/
noncomputable def frameAtomFun (d : ℕ) (z j : Fin d → ℤ) (k : EuclideanSpace ℝ (Fin d)) : ℂ :=
  (2 : ℂ) ^ (-(d : ℂ) / 2) * (unitBump d (k - intVec z) : ℂ) *
    Complex.exp (Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (k i - z i))

private lemma frameAtomFun_contDiff (d : ℕ) (z j : Fin d → ℤ) :
    ContDiff ℝ (⊤ : ℕ∞) (frameAtomFun d z j) := by
  unfold frameAtomFun
  refine (contDiff_const.mul (Complex.ofRealCLM.contDiff.comp
    ((contDiff_unitBump d).comp (contDiff_id.sub contDiff_const)))).mul ?_
  refine Complex.contDiff_exp.comp (contDiff_const.mul (Complex.ofRealCLM.contDiff.comp ?_))
  change ContDiff ℝ (⊤ : ℕ∞) (fun k : EuclideanSpace ℝ (Fin d) => ∑ i : Fin d, (j i : ℝ) * (k i - z i))
  exact ContDiff.sum fun i _ => contDiff_const.mul ((EuclideanSpace.proj (𝕜 := ℝ) i).contDiff.sub contDiff_const)

private lemma hasCompactSupport_norm_sq {E : Type*} [TopologicalSpace E] {f : E → ℂ}
    (hf : HasCompactSupport f) : HasCompactSupport (fun x => ‖f x‖ ^ 2) :=
  hf.mono fun x hx => by
    intro h0
    exact hx (by simp [h0])

private lemma frameAtomFun_hasCompactSupport (d : ℕ) (z j : Fin d → ℤ) :
    HasCompactSupport (frameAtomFun d z j) := by
  refine HasCompactSupport.of_support_subset_isCompact
    (K := (fun u : EuclideanSpace ℝ (Fin d) => intVec z + u) '' unitCube d) ?_ ?_
  · have hcomp_cube : IsCompact (unitCube d) := by
      have hEq : unitCube d = (WithLp.equiv 2 (Fin d → ℝ)).symm ''
          Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1) := by
        ext u
        constructor
        · intro hu; exact ⟨u.ofLp, fun i _ => hu i, rfl⟩
        · rintro ⟨v, hv, rfl⟩ i; exact hv i (Set.mem_univ i)
      rw [hEq]
      exact (isCompact_univ_pi fun _ => isCompact_Icc).image
        (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))
    exact hcomp_cube.image (continuous_const.add continuous_id)
  · intro x hx
    refine ⟨x - intVec z, ?_, add_sub_cancel _ _⟩
    intro i
    have hne : unitBump d (x - intVec z) ≠ 0 := by
      intro h0; exact hx (by simp [frameAtomFun, h0])
    exact Set.Ioo_subset_Icc_self (support_unitBump_subset d hne i)

noncomputable def frameAtomSchwartz (d : ℕ) (z j : Fin d → ℤ) :
    𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
  (frameAtomFun_hasCompactSupport d z j).toSchwartzMap (frameAtomFun_contDiff d z j)

lemma frameAtomSchwartz_apply (d : ℕ) (z j : Fin d → ℤ) (k : EuclideanSpace ℝ (Fin d)) :
    frameAtomSchwartz d z j k = frameAtomFun d z j k := rfl

private lemma star_frameAtomFun (d : ℕ) (z j : Fin d → ℤ) (k : EuclideanSpace ℝ (Fin d)) :
    star (frameAtomFun d z j k) =
      (2 : ℂ) ^ (-(d : ℂ) / 2) * (unitBump d (k - intVec z) : ℂ) *
        Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (k i - z i)) := by
  unfold frameAtomFun
  have h2 : (2 : ℂ) ^ (-(d : ℂ) / 2) = (((2 : ℝ) ^ (-(d : ℝ) / 2) : ℝ) : ℂ) := by
    rw [Complex.ofReal_cpow (by norm_num)]; simp
  rw [h2, RCLike.star_def, map_mul, map_mul, Complex.conj_ofReal, Complex.conj_ofReal,
    ← Complex.exp_conj]
  congr 2
  simp only [map_mul, Complex.conj_I, Complex.conj_ofReal]

private lemma frameCoeff_eq_inner_frameAtom (d : ℕ) (z j : Fin d → ℤ)
    (g : EuclideanSpace ℝ (Fin d) → ℂ) :
    frameCoeff d z j g = ∫ k : EuclideanSpace ℝ (Fin d), star (frameAtomFun d z j k) * g k := by
  unfold frameCoeff
  rw [← integral_const_mul]
  refine integral_congr_ae (ae_of_all _ fun k => ?_)
  dsimp only
  rw [star_frameAtomFun]
  ring

private lemma integral_norm_sq_frameAtom_le_one (d : ℕ) (z j : Fin d → ℤ) :
    ∫ k : EuclideanSpace ℝ (Fin d), ‖frameAtomFun d z j k‖ ^ 2 ≤ 1 := by
  have hpt : ∀ k : EuclideanSpace ℝ (Fin d),
      ‖frameAtomFun d z j k‖ ^ 2 = (2 : ℝ) ^ (- (d : ℝ)) * (unitBump d (k - intVec z)) ^ 2 := by
    intro k
    unfold frameAtomFun
    have h2 : (2 : ℂ) ^ (-(d : ℂ) / 2) = (((2 : ℝ) ^ (-(d : ℝ) / 2) : ℝ) : ℂ) := by
      rw [Complex.ofReal_cpow (by norm_num)]; simp
    have hexp : ‖Complex.exp (Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (k i - z i))‖ = 1 := by
      rw [show Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (k i - z i) =
        ((Real.pi * ∑ i : Fin d, (j i : ℝ) * (k i - z i) : ℝ) : ℂ) * Complex.I by push_cast; ring,
        Complex.norm_exp_ofReal_mul_I]
    rw [norm_mul, norm_mul, hexp, mul_one, h2, Complex.norm_real, Complex.norm_real,
      Real.norm_eq_abs, Real.norm_eq_abs, mul_pow, sq_abs, sq_abs,
      ← Real.rpow_natCast _ 2, ← Real.rpow_mul (by norm_num),
      show (-(d : ℝ) / 2) * (2 : ℕ) = -(d : ℝ) by push_cast; ring]
  simp_rw [hpt, integral_const_mul]
  rw [integral_sub_right_eq_self (fun u : EuclideanSpace ℝ (Fin d) => (unitBump d u) ^ 2) (intVec z)]
  have hle1 : ∀ u : EuclideanSpace ℝ (Fin d), (unitBump d u) ^ 2 ≤ 1 := fun u => by
    have hsum := tsum_unitBump_sq d u
    have h0 := (unitBump_nonneg d u)
    have hsupp : Summable (fun w : Fin d → ℤ => (unitBump d (u - intVec w)) ^ 2) := by
      let S : Fin d → Finset ℤ := fun i => Finset.Icc (⌊u i⌋ - 1) (⌈u i⌉ + 1)
      refine summable_of_ne_finset_zero (s := Fintype.piFinset S) fun w hw => ?_
      rw [Fintype.mem_piFinset, not_forall] at hw
      rcases hw with ⟨i, hi⟩
      have hge : 3 / 4 ≤ |u i - (w i : ℝ)| := by
        by_contra hlt
        push Not at hlt
        have hmem : w i ∈ Finset.Icc (⌊u i⌋ - 1) (⌈u i⌉ + 1) := by
          rw [Finset.mem_Icc]
          have h1 : (⌊u i⌋ : ℝ) ≤ u i := Int.floor_le (u i)
          have h2 : u i ≤ (⌈u i⌉ : ℝ) := Int.le_ceil (u i)
          have h3 := abs_lt.mp hlt
          constructor
          · exact Int.le_of_lt_add_one (by exact_mod_cast (by push_cast; linarith : ((⌊u i⌋ - 1 : ℤ) : ℝ) < (w i : ℝ) + 1))
          · exact Int.le_of_lt_add_one (by exact_mod_cast (by push_cast; linarith : (w i : ℝ) < ((⌈u i⌉ + 1 : ℤ) : ℝ) + 1))
        exact hi hmem
      rw [unitBump_eq_zero_of_exists_le_abs ⟨i, by simpa using hge⟩, zero_pow two_ne_zero]
    have hle := hsupp.le_tsum (0 : Fin d → ℤ) (fun _ _ => sq_nonneg _)
    have h0vec : intVec (0 : Fin d → ℤ) = 0 := by ext i; simp [intVec]
    simpa [h0vec, hsum] using hle
  have hset : ∫ u : EuclideanSpace ℝ (Fin d), (unitBump d u) ^ 2 =
      ∫ u in unitCube d, (unitBump d u) ^ 2 := by
    symm
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
    have h0 : unitBump d u = 0 := by
      by_contra hne
      exact hu fun i => Set.Ioo_subset_Icc_self (support_unitBump_subset d hne i)
    simp [h0]
  have hvol : volume (unitCube d) = ENNReal.ofReal ((2 : ℝ) ^ d) := by
    let e := MeasurableEquiv.toLp 2 (Fin d → ℝ)
    have hmpE : MeasurePreserving e volume volume := PiLp.volume_preserving_toLp (Fin d)
    have hpre : e ⁻¹' unitCube d = Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1) := by
      ext u
      change (∀ i : Fin d, (e u) i ∈ Set.Icc (-1 : ℝ) 1) ↔
        u ∈ Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1)
      simp only [e, MeasurableEquiv.toLp_apply, Set.mem_univ_pi]
    rw [← hmpE.measure_preimage_emb (MeasurableEquiv.measurableEmbedding _), hpre]
    change Measure.pi (fun _ : Fin d => (volume : Measure ℝ))
      (Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1)) = ENNReal.ofReal ((2 : ℝ) ^ d)
    rw [Measure.pi_pi]
    simp only [Real.volume_Icc, sub_neg_eq_add, one_add_one_eq_two, Finset.prod_const,
      Finset.card_univ, Fintype.card_fin]
    rw [ENNReal.ofReal_pow (by norm_num)]
  rw [hset]
  have hle_int : ∫ u in unitCube d, (unitBump d u) ^ 2 ≤ (2 : ℝ) ^ d := by
    have h1 := norm_setIntegral_le_of_norm_le_const (μ := volume) (s := unitCube d) (C := 1)
      (by rw [hvol]; exact ENNReal.ofReal_lt_top)
      (fun u _ => by rw [Real.norm_of_nonneg (sq_nonneg _)]; exact hle1 u)
    rw [Real.norm_of_nonneg (setIntegral_nonneg (by
      have hcomp_cube : IsCompact (unitCube d) := by
        have hEq : unitCube d = (WithLp.equiv 2 (Fin d → ℝ)).symm ''
            Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1) := by
          ext u
          constructor
          · intro hu; exact ⟨u.ofLp, fun i _ => hu i, rfl⟩
          · rintro ⟨v, hv, rfl⟩ i; exact hv i (Set.mem_univ i)
        rw [hEq]
        exact (isCompact_univ_pi fun _ => isCompact_Icc).image
          (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))
      exact hcomp_cube.measurableSet) fun _ _ => sq_nonneg _),
      Measure.real_def, hvol, ENNReal.toReal_ofReal (by positivity), one_mul] at h1
    exact h1
  calc (2 : ℝ) ^ (-(d : ℝ)) * ∫ u in unitCube d, (unitBump d u) ^ 2
      ≤ (2 : ℝ) ^ (-(d : ℝ)) * (2 : ℝ) ^ d :=
        mul_le_mul_of_nonneg_left hle_int (Real.rpow_nonneg (by norm_num) _)
    _ = 1 := by
        rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, inv_mul_cancel₀ (by positivity)]

/-- Real Schwartz test function associated to frame index `idx = ((z, j), b)`:
the real part (`b = false`) or imaginary part (`b = true`) of `planeKernelInvCLM (frameAtomSchwartz z j)`. -/
noncomputable def planeFrameTest (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (idx : FrameIdx (n + 1)) : 𝓢(SpatialE n, ℝ) :=
  let hC := planeKernelInvCLM n ħ m hħ hm (frameAtomSchwartz (n + 1) idx.1.1 idx.1.2)
  if idx.2 then hC.postcompCLM Complex.imCLM else hC.postcompCLM Complex.reCLM

/-- Sign `(+1)` for real part and `(-1)` for imaginary part in the frame reconstruction formula. -/
def frameSign (idx : FrameIdx (n + 1)) : ℝ :=
  if idx.2 then -1 else 1

private lemma planeKernel_planeFrameTest_re (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (z j : Fin (n + 1) → ℤ) (k : SpatialE n) :
    planeKernel n ħ m (planeFrameTest n ħ m hħ hm ((z, j), false)) k =
      (1 / 2 : ℂ) * (frameAtomFun (n + 1) z j k + star (frameAtomFun (n + 1) z j (-k))) := by
  have h1 := planeKernel_re_im_of_inv n hħ hm (frameAtomSchwartz (n + 1) z j) k
  have h2 := planeKernel_re_im_of_inv n hħ hm (frameAtomSchwartz (n + 1) z j) (-k)
  dsimp only at h1 h2
  have hconj : ∀ h : 𝓢(SpatialE n, ℝ), planeKernel n ħ m h (-k) = star (planeKernel n ħ m h k) := by
    intro h
    unfold planeKernel planeMult
    rw [euclidDispersion_neg, physicsFourierExact_neg, RCLike.star_def, map_mul,
      Complex.conj_ofReal]
  simp only [planeFrameTest, Bool.false_eq_true, ↓reduceIte]
  rw [hconj, hconj] at h2
  have h2' := congrArg (starRingEnd ℂ) h2
  simp only [map_add, map_mul, Complex.conj_I, RCLike.star_def, starRingEnd_self_apply] at h2'
  simp only [frameAtomSchwartz_apply] at h1 h2'
  rw [RCLike.star_def]
  linear_combination (1 / 2 : ℂ) * h1 + (1 / 2 : ℂ) * h2'

private lemma planeKernel_planeFrameTest_im (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (z j : Fin (n + 1) → ℤ) (k : SpatialE n) :
    planeKernel n ħ m (planeFrameTest n ħ m hħ hm ((z, j), true)) k =
      (1 / (2 * Complex.I)) * (frameAtomFun (n + 1) z j k - star (frameAtomFun (n + 1) z j (-k))) := by
  have h1 := planeKernel_re_im_of_inv n hħ hm (frameAtomSchwartz (n + 1) z j) k
  have h2 := planeKernel_re_im_of_inv n hħ hm (frameAtomSchwartz (n + 1) z j) (-k)
  dsimp only at h1 h2
  have hconj : ∀ h : 𝓢(SpatialE n, ℝ), planeKernel n ħ m h (-k) = star (planeKernel n ħ m h k) := by
    intro h
    unfold planeKernel planeMult
    rw [euclidDispersion_neg, physicsFourierExact_neg, RCLike.star_def, map_mul,
      Complex.conj_ofReal]
  simp only [planeFrameTest, ↓reduceIte]
  rw [hconj, hconj] at h2
  have h2' := congrArg (starRingEnd ℂ) h2
  simp only [map_add, map_mul, Complex.conj_I, RCLike.star_def, starRingEnd_self_apply] at h2'
  simp only [frameAtomSchwartz_apply] at h1 h2'
  rw [RCLike.star_def]
  have hI : Complex.I ≠ 0 := Complex.I_ne_zero
  field_simp [hI]
  linear_combination h1 - h2'

private lemma integral_norm_sq_planeKernel_planeFrameTest_le_one (n : ℕ) {ħ m : ℝ}
    (hħ : 0 < ħ) (hm : 0 < m) (idx : FrameIdx (n + 1)) :
    ∫ k : SpatialE n, ‖planeKernel n ħ m (planeFrameTest n ħ m hħ hm idx) k‖ ^ 2 ≤ 1 := by
  rcases idx with ⟨⟨z, j⟩, b⟩
  have hint_e : Integrable (fun k : SpatialE n => ‖frameAtomFun (n + 1) z j k‖ ^ 2) volume :=
    ((frameAtomFun_contDiff (n + 1) z j).continuous.norm.pow 2).integrable_of_hasCompactSupport
      (hasCompactSupport_norm_sq (frameAtomFun_hasCompactSupport (n + 1) z j))
  have hmp : MeasurePreserving (fun k : SpatialE n => -k) volume volume :=
    Measure.measurePreserving_neg volume
  have hint_eneg : Integrable (fun k : SpatialE n => ‖frameAtomFun (n + 1) z j (-k)‖ ^ 2) volume :=
    hmp.integrable_comp_of_integrable hint_e
  have hbound : ∀ k : SpatialE n,
      ‖planeKernel n ħ m (planeFrameTest n ħ m hħ hm ((z, j), b)) k‖ ^ 2 ≤
        (1 / 2 : ℝ) * (‖frameAtomFun (n + 1) z j k‖ ^ 2 + ‖frameAtomFun (n + 1) z j (-k)‖ ^ 2) := by
    intro k
    cases b
    · rw [planeKernel_planeFrameTest_re n hħ hm z j k, norm_mul]
      have h12 : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
      rw [h12, mul_pow]
      have htr := norm_add_le (frameAtomFun (n + 1) z j k) (star (frameAtomFun (n + 1) z j (-k)))
      rw [norm_star] at htr
      nlinarith [sq_nonneg (‖frameAtomFun (n + 1) z j k‖ - ‖frameAtomFun (n + 1) z j (-k)‖),
        norm_nonneg (frameAtomFun (n + 1) z j k + star (frameAtomFun (n + 1) z j (-k)))]
    · rw [planeKernel_planeFrameTest_im n hħ hm z j k, norm_mul]
      have h12 : ‖(1 / (2 * Complex.I) : ℂ)‖ = 1 / 2 := by
        rw [norm_div, norm_one, norm_mul, Complex.norm_I, mul_one]; norm_num
      rw [h12, mul_pow]
      have htr := norm_sub_le (frameAtomFun (n + 1) z j k) (star (frameAtomFun (n + 1) z j (-k)))
      rw [norm_star] at htr
      nlinarith [sq_nonneg (‖frameAtomFun (n + 1) z j k‖ - ‖frameAtomFun (n + 1) z j (-k)‖),
        norm_nonneg (frameAtomFun (n + 1) z j k - star (frameAtomFun (n + 1) z j (-k)))]
  have hle : ∫ k : SpatialE n, ‖planeKernel n ħ m (planeFrameTest n ħ m hħ hm ((z, j), b)) k‖ ^ 2 ≤
      ∫ k : SpatialE n,
        (1 / 2 : ℝ) * (‖frameAtomFun (n + 1) z j k‖ ^ 2 + ‖frameAtomFun (n + 1) z j (-k)‖ ^ 2) :=
    integral_mono (planeKernel_integrable_norm_sq n ħ hm _)
      ((hint_e.add hint_eneg).const_mul (1 / 2)) hbound
  rw [integral_const_mul, integral_add hint_e hint_eneg] at hle
  have hneg_eq : ∫ k : SpatialE n, ‖frameAtomFun (n + 1) z j (-k)‖ ^ 2 =
      ∫ k : SpatialE n, ‖frameAtomFun (n + 1) z j k‖ ^ 2 := by
    simpa using hmp.integral_comp' (f := MeasurableEquiv.neg (SpatialE n))
      (g := fun k : SpatialE n => ‖frameAtomFun (n + 1) z j k‖ ^ 2)
  rw [hneg_eq] at hle
  linarith [integral_norm_sq_frameAtom_le_one (n + 1) z j]

/-- Frame synthesis Bessel inequality: for any finite set `F` of phase-space pairs and complex
coefficients `c`, `∫ ‖∑ p ∈ F, c p • e_p‖² ≤ ∑ p ∈ F, ‖c p‖²`. -/
private lemma integral_norm_sq_frameSynth_le (d : ℕ)
    (F : Finset ((Fin d → ℤ) × (Fin d → ℤ))) (c : (Fin d → ℤ) × (Fin d → ℤ) → ℂ) :
    ∫ k : EuclideanSpace ℝ (Fin d), ‖∑ p ∈ F, c p * frameAtomFun d p.1 p.2 k‖ ^ 2 ≤
      ∑ p ∈ F, ‖c p‖ ^ 2 := by
  let v : EuclideanSpace ℝ (Fin d) → ℂ := fun k => ∑ p ∈ F, c p * frameAtomFun d p.1 p.2 k
  have hv_cont : Continuous v :=
    continuous_finsetSum F fun p _ => continuous_const.mul (frameAtomFun_contDiff d p.1 p.2).continuous
  have hv_supp : HasCompactSupport v := by
    have : v = ∑ p ∈ F, fun k => c p * frameAtomFun d p.1 p.2 k := by
      funext k; simp [v, Finset.sum_apply]
    rw [this]
    exact HasCompactSupport.finset_sum fun p _ => (frameAtomFun_hasCompactSupport d p.1 p.2).mul_left
  have hv_int : Integrable (fun k => ‖v k‖ ^ 2) volume :=
    (hv_cont.norm.pow 2).integrable_of_hasCompactSupport (hasCompactSupport_norm_sq hv_supp)
  have hnorm_eq : ((∫ k, ‖v k‖ ^ 2 : ℝ) : ℂ) = ∑ p ∈ F, c p * star (frameCoeff d p.1 p.2 v) := by
    rw [← integral_complex_ofReal]
    have hpt : (fun k => ((‖v k‖ ^ 2 : ℝ) : ℂ)) =
        fun k => ∑ p ∈ F, c p * (frameAtomFun d p.1 p.2 k * star (v k)) := by
      funext k
      rw [← Complex.normSq_eq_norm_sq, ← Complex.mul_conj, RCLike.star_def]
      dsimp only [v]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun p _ => by ring
    rw [hpt, integral_finsetSum]
    · refine Finset.sum_congr rfl fun p _ => ?_
      rw [integral_const_mul, frameCoeff_eq_inner_frameAtom, RCLike.star_def, ← integral_conj]
      congr 1
      refine integral_congr_ae (ae_of_all _ fun k => ?_)
      simp
    · intro p _
      have hcont_p : Continuous (fun k => c p * (frameAtomFun d p.1 p.2 k * star (v k))) :=
        continuous_const.mul ((frameAtomFun_contDiff d p.1 p.2).continuous.mul hv_cont.star)
      have hsupp_p : HasCompactSupport (fun k => c p * (frameAtomFun d p.1 p.2 k * star (v k))) :=
        ((frameAtomFun_hasCompactSupport d p.1 p.2).mul_right).mul_left
      exact hcont_p.integrable_of_hasCompactSupport hsupp_p
  have hI_nn : 0 ≤ ∫ k, ‖v k‖ ^ 2 := integral_nonneg fun _ => sq_nonneg _
  have hcs : (∫ k, ‖v k‖ ^ 2) ^ 2 ≤ (∑ p ∈ F, ‖c p‖ ^ 2) * (∑ p ∈ F, ‖frameCoeff d p.1 p.2 v‖ ^ 2) := by
    have h1 : ∫ k, ‖v k‖ ^ 2 = ‖∑ p ∈ F, c p * star (frameCoeff d p.1 p.2 v)‖ := by
      rw [← hnorm_eq, Complex.norm_real, Real.norm_of_nonneg hI_nn]
    have h2 : ‖∑ p ∈ F, c p * star (frameCoeff d p.1 p.2 v)‖ ≤
        ∑ p ∈ F, ‖c p‖ * ‖frameCoeff d p.1 p.2 v‖ := by
      calc ‖∑ p ∈ F, c p * star (frameCoeff d p.1 p.2 v)‖
          ≤ ∑ p ∈ F, ‖c p * star (frameCoeff d p.1 p.2 v)‖ := norm_sum_le _ _
        _ = ∑ p ∈ F, ‖c p‖ * ‖frameCoeff d p.1 p.2 v‖ := by
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [norm_mul, norm_star]
    have h3 := Finset.sum_mul_sq_le_sq_mul_sq F (fun p => ‖c p‖) (fun p => ‖frameCoeff d p.1 p.2 v‖)
    have h4 : (∫ k, ‖v k‖ ^ 2) ^ 2 ≤ (∑ p ∈ F, ‖c p‖ * ‖frameCoeff d p.1 p.2 v‖) ^ 2 := by
      rw [h1]
      exact pow_le_pow_left₀ (norm_nonneg _) h2 2
    exact h4.trans h3
  have hpars : ∑ p ∈ F, ‖frameCoeff d p.1 p.2 v‖ ^ 2 ≤ ∫ k, ‖v k‖ ^ 2 := by
    rw [← tsum_norm_sq_frameCoeff d hv_cont hv_int]
    exact (summable_norm_sq_frameCoeff d hv_cont hv_int).sum_le_tsum F (fun _ _ => sq_nonneg _)
  have hsq : (∫ k, ‖v k‖ ^ 2) ^ 2 ≤ (∑ p ∈ F, ‖c p‖ ^ 2) * (∫ k, ‖v k‖ ^ 2) :=
    hcs.trans (mul_le_mul_of_nonneg_left hpars (Finset.sum_nonneg fun _ _ => sq_nonneg _))
  rcases hI_nn.eq_or_lt with h0 | hpos
  · rw [← h0]; exact Finset.sum_nonneg fun _ _ => sq_nonneg _
  · nlinarith

/-- Exact `L²` frame approximation bound for `planeKernel`: partial frame syntheses
converge to `planeKernel n ħ m h` in `L²(SpatialE n)`. -/
private lemma integral_norm_sq_planeKernel_sub_finset_le (n : ℕ) {ħ m : ℝ}
    (hħ : 0 < ħ) (hm : 0 < m) (h : 𝓢(SpatialE n, ℝ))
    (F : Finset ((Fin (n + 1) → ℤ) × (Fin (n + 1) → ℤ))) :
    let hF : 𝓢(SpatialE n, ℝ) :=
      ∑ p ∈ F,
        (planeFrameCLM n ħ m hm (p, false) h • planeFrameTest n ħ m hħ hm (p, false) -
          planeFrameCLM n ħ m hm (p, true) h • planeFrameTest n ħ m hħ hm (p, true))
    ∫ k : SpatialE n, ‖planeKernel n ħ m (h - hF) k‖ ^ 2 ≤
      (∫ k : SpatialE n, ‖planeKernel n ħ m h k‖ ^ 2) -
        ∑ p ∈ F, ‖frameCoeff (n + 1) p.1 p.2 (planeKernel n ħ m h)‖ ^ 2 := by
  intro hF
  let g : SpatialE n → ℂ := planeKernel n ħ m h
  let gF : SpatialE n → ℂ := fun k =>
    ∑ p ∈ F, frameCoeff (n + 1) p.1 p.2 g * frameAtomFun (n + 1) p.1 p.2 k
  have hg_cont : Continuous g := (planeKernel_contDiff n ħ hm h).continuous
  have hg_int : Integrable (fun k => ‖g k‖ ^ 2) volume := planeKernel_integrable_norm_sq n ħ hm h
  have hgF_cont : Continuous gF :=
    continuous_finsetSum F fun p _ => continuous_const.mul (frameAtomFun_contDiff (n + 1) p.1 p.2).continuous
  have hgF_supp : HasCompactSupport gF := by
    have : gF = ∑ p ∈ F, fun k => frameCoeff (n + 1) p.1 p.2 g * frameAtomFun (n + 1) p.1 p.2 k := by
      funext k; simp [gF, Finset.sum_apply]
    rw [this]
    exact HasCompactSupport.finset_sum fun p _ =>
      (frameAtomFun_hasCompactSupport (n + 1) p.1 p.2).mul_left
  have hgF_int : Integrable (fun k => ‖gF k‖ ^ 2) volume :=
    (hgF_cont.norm.pow 2).integrable_of_hasCompactSupport (hasCompactSupport_norm_sq hgF_supp)
  have hhF_eq : ∀ k : SpatialE n,
      planeKernel n ħ m hF k = (1 / 2 : ℂ) * (gF k + star (gF (-k))) := by
    intro k
    rw [planeKernel_eq_clm n ħ hm]
    dsimp only [hF]
    rw [map_sum]
    have hsum : (∑ p ∈ F, planeKernelCLM n ħ m hm
        (planeFrameCLM n ħ m hm (p, false) h • planeFrameTest n ħ m hħ hm (p, false) -
          planeFrameCLM n ħ m hm (p, true) h • planeFrameTest n ħ m hħ hm (p, true))) k =
        ∑ p ∈ F, (1 / 2 : ℂ) *
          (frameCoeff (n + 1) p.1 p.2 g * frameAtomFun (n + 1) p.1 p.2 k +
            star (frameCoeff (n + 1) p.1 p.2 g * frameAtomFun (n + 1) p.1 p.2 (-k))) := by
      simp only [sum_apply]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [map_sub, map_smul, map_smul]
      change ((planeFrameCLM n ħ m hm (p, false) h : ℝ) : ℂ) *
            planeKernelCLM n ħ m hm (planeFrameTest n ħ m hħ hm (p, false)) k -
          ((planeFrameCLM n ħ m hm (p, true) h : ℝ) : ℂ) *
            planeKernelCLM n ħ m hm (planeFrameTest n ħ m hħ hm (p, true)) k = _
      rw [← planeKernel_eq_clm n ħ hm, ← planeKernel_eq_clm n ħ hm,
        planeKernel_planeFrameTest_re n hħ hm p.1 p.2 k,
        planeKernel_planeFrameTest_im n hħ hm p.1 p.2 k]
      simp only [planeFrameCLM_apply, Bool.false_eq_true, ↓reduceIte, g]
      set c := frameCoeff (n + 1) p.1 p.2 (planeKernel n ħ m h)
      set a := frameAtomFun (n + 1) p.1 p.2 k
      set b := star (frameAtomFun (n + 1) p.1 p.2 (-k))
      set cr : ℝ := c.re
      set ci : ℝ := c.im
      have hc : (cr : ℂ) + (ci : ℂ) * Complex.I = c := Complex.re_add_im c
      have hsc : star c = (cr : ℂ) - (ci : ℂ) * Complex.I := by
        rw [RCLike.star_def]; apply Complex.ext <;> simp [cr, ci]
      rw [star_mul', hsc]
      have hI : Complex.I ≠ 0 := Complex.I_ne_zero
      field_simp [hI]
      rw [← hc]
      ring_nf
      rw [Complex.I_sq]
      ring
    rw [hsum, ← Finset.mul_sum, Finset.sum_add_distrib]
    congr 2
    dsimp only [gF]
    exact (star_sum _ _).symm
  have hdiff_le : ∫ k : SpatialE n, ‖planeKernel n ħ m (h - hF) k‖ ^ 2 ≤
      ∫ k : SpatialE n, ‖g k - gF k‖ ^ 2 := by
    have hconj : ∀ k : SpatialE n, g (-k) = star (g k) := fun k => by
      unfold g planeKernel planeMult
      rw [euclidDispersion_neg, physicsFourierExact_neg, RCLike.star_def, map_mul,
        Complex.conj_ofReal]
    have hmp : MeasurePreserving (fun k : SpatialE n => -k) volume volume :=
      Measure.measurePreserving_neg volume
    have hsub_int : Integrable (fun k : SpatialE n => ‖g k - gF k‖ ^ 2) volume := by
      refine ((hg_int.add hgF_int).const_mul 2).mono'
        ((hg_cont.sub hgF_cont).norm.pow 2).aestronglyMeasurable (ae_of_all _ fun k => ?_)
      rw [Real.norm_of_nonneg (sq_nonneg _)]
      change ‖g k - gF k‖ ^ 2 ≤ 2 * (‖g k‖ ^ 2 + ‖gF k‖ ^ 2)
      have htr := norm_sub_le (g k) (gF k)
      nlinarith [sq_nonneg (‖g k‖ - ‖gF k‖), norm_nonneg (g k - gF k)]
    have hsub_int_neg : Integrable (fun k : SpatialE n => ‖g (-k) - gF (-k)‖ ^ 2) volume :=
      hmp.integrable_comp_of_integrable hsub_int
    have hpt : ∀ k : SpatialE n,
        ‖planeKernel n ħ m (h - hF) k‖ ^ 2 ≤
          (1 / 2 : ℝ) * (‖g k - gF k‖ ^ 2 + ‖g (-k) - gF (-k)‖ ^ 2) := by
      intro k
      have heq : planeKernel n ħ m (h - hF) k =
          (1 / 2 : ℂ) * ((g k - gF k) + star (g (-k) - gF (-k))) := by
        rw [planeKernel_eq_clm n ħ hm, map_sub]
        change planeKernelCLM n ħ m hm h k - planeKernelCLM n ħ m hm hF k = _
        rw [← planeKernel_eq_clm n ħ hm, ← planeKernel_eq_clm n ħ hm, hhF_eq k]
        have hgs : star (g (-k)) = g k := by rw [hconj, star_star]
        rw [star_sub, hgs]
        change g k - (1 / 2 : ℂ) * (gF k + star (gF (-k))) =
          (1 / 2 : ℂ) * (g k - gF k + (g k - star (gF (-k))))
        ring
      rw [heq, norm_mul]
      have h12 : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
      rw [h12, mul_pow]
      have htr := norm_add_le (g k - gF k) (star (g (-k) - gF (-k)))
      rw [norm_star] at htr
      nlinarith [sq_nonneg (‖g k - gF k‖ - ‖g (-k) - gF (-k)‖),
        norm_nonneg ((g k - gF k) + star (g (-k) - gF (-k)))]
    have hle : ∫ k : SpatialE n, ‖planeKernel n ħ m (h - hF) k‖ ^ 2 ≤
        ∫ k : SpatialE n, (1 / 2 : ℝ) * (‖g k - gF k‖ ^ 2 + ‖g (-k) - gF (-k)‖ ^ 2) :=
      integral_mono (planeKernel_integrable_norm_sq n ħ hm (h - hF))
        ((hsub_int.add hsub_int_neg).const_mul (1 / 2)) hpt
    rw [integral_const_mul, integral_add hsub_int hsub_int_neg] at hle
    have hneg_eq : ∫ k : SpatialE n, ‖g (-k) - gF (-k)‖ ^ 2 =
        ∫ k : SpatialE n, ‖g k - gF k‖ ^ 2 := by
      simpa using hmp.integral_comp' (f := MeasurableEquiv.neg (SpatialE n))
        (g := fun k : SpatialE n => ‖g k - gF k‖ ^ 2)
    rw [hneg_eq] at hle
    linarith
  refine hdiff_le.trans ?_
  have hcross_int : Integrable (fun k : SpatialE n => (star (g k) * gF k).re) volume := by
    refine ((hg_int.add hgF_int).div_const 2).mono'
      (Complex.continuous_re.comp (hg_cont.star.mul hgF_cont)).aestronglyMeasurable
      (ae_of_all _ fun k => ?_)
    rw [Real.norm_eq_abs]
    change |(star (g k) * gF k).re| ≤ (‖g k‖ ^ 2 + ‖gF k‖ ^ 2) / 2
    have h1 : |(star (g k) * gF k).re| ≤ ‖star (g k) * gF k‖ := Complex.abs_re_le_norm _
    rw [norm_mul, norm_star] at h1
    nlinarith [sq_nonneg (‖g k‖ - ‖gF k‖)]
  have hexpand : (fun k : SpatialE n => ‖g k - gF k‖ ^ 2) =
      fun k => ‖g k‖ ^ 2 - 2 * (star (g k) * gF k).re + ‖gF k‖ ^ 2 := by
    funext k
    have hsq : ∀ z : ℂ, ‖z‖ ^ 2 = z.re ^ 2 + z.im ^ 2 := fun z => by
      rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]; ring
    simp only [hsq, Complex.sub_re, Complex.sub_im, Complex.mul_re, RCLike.star_def,
      Complex.conj_re, Complex.conj_im]
    ring
  have hsub2_int : Integrable (fun k : SpatialE n => ‖g k‖ ^ 2 - 2 * (star (g k) * gF k).re) volume :=
    hg_int.sub (hcross_int.const_mul 2)
  rw [hexpand, integral_add hsub2_int hgF_int,
    integral_sub hg_int (hcross_int.const_mul 2), integral_const_mul]
  have hinner : ∫ k : SpatialE n, (star (g k) * gF k).re =
      ∑ p ∈ F, ‖frameCoeff (n + 1) p.1 p.2 g‖ ^ 2 := by
    have hC_int : Integrable (fun k : SpatialE n => star (g k) * gF k) volume := by
      refine ((hg_int.add hgF_int).div_const 2).mono'
        (hg_cont.star.mul hgF_cont).aestronglyMeasurable (ae_of_all _ fun k => ?_)
      change ‖star (g k) * gF k‖ ≤ (‖g k‖ ^ 2 + ‖gF k‖ ^ 2) / 2
      rw [norm_mul, norm_star]
      nlinarith [sq_nonneg (‖g k‖ - ‖gF k‖)]
    have hre_int : (∫ k : SpatialE n, star (g k) * gF k).re =
        ∫ k : SpatialE n, (star (g k) * gF k).re :=
      (integral_re hC_int).symm
    rw [← hre_int]
    have hC_eq : ∫ k : SpatialE n, star (g k) * gF k =
        ∑ p ∈ F, ((‖frameCoeff (n + 1) p.1 p.2 g‖ ^ 2 : ℝ) : ℂ) := by
      have hpt : (fun k => star (g k) * gF k) =
          fun k => ∑ p ∈ F, frameCoeff (n + 1) p.1 p.2 g *
            (star (g k) * frameAtomFun (n + 1) p.1 p.2 k) := by
        funext k; dsimp only [gF]; rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun p _ => by ring
      rw [hpt, integral_finsetSum]
      · refine Finset.sum_congr rfl fun p _ => ?_
        rw [integral_const_mul]
        have hfc : ∫ k : SpatialE n, star (g k) * frameAtomFun (n + 1) p.1 p.2 k =
            star (frameCoeff (n + 1) p.1 p.2 g) := by
          rw [frameCoeff_eq_inner_frameAtom, RCLike.star_def, ← integral_conj]
          refine integral_congr_ae (ae_of_all _ fun k => ?_)
          simp [mul_comm]
        rw [hfc, RCLike.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq]
      · intro p _
        have hcont_p : Continuous (fun k => frameCoeff (n + 1) p.1 p.2 g *
            (star (g k) * frameAtomFun (n + 1) p.1 p.2 k)) :=
          continuous_const.mul (hg_cont.star.mul (frameAtomFun_contDiff (n + 1) p.1 p.2).continuous)
        have hsupp_p : HasCompactSupport (fun k => frameCoeff (n + 1) p.1 p.2 g *
            (star (g k) * frameAtomFun (n + 1) p.1 p.2 k)) :=
          ((frameAtomFun_hasCompactSupport (n + 1) p.1 p.2).mul_left).mul_left
        exact hcont_p.integrable_of_hasCompactSupport hsupp_p
    rw [hC_eq, ← Complex.ofReal_sum, Complex.ofReal_re]
  rw [hinner]
  linarith [integral_norm_sq_frameSynth_le (n + 1) F (fun p => frameCoeff (n + 1) p.1 p.2 g)]

/-- Iterated coordinate directional derivative CLM on `𝓢(EuclideanSpace ℝ (Fin d), ℝ)`. -/
noncomputable def iterCoordDerivCLM (d : ℕ) :
    ∀ (l : ℕ), (Fin l → Fin d) →
      𝓢(EuclideanSpace ℝ (Fin d), ℝ) →L[ℝ] 𝓢(EuclideanSpace ℝ (Fin d), ℝ)
  | 0, _ => ContinuousLinearMap.id ℝ _
  | l + 1, α =>
      (SchwartzMap.evalCLM ℝ (EuclideanSpace ℝ (Fin d)) ℝ
        (EuclideanSpace.single (α 0) (1 : ℝ))).comp
        ((SchwartzMap.fderivCLM ℝ (EuclideanSpace ℝ (Fin d)) ℝ).comp
          (iterCoordDerivCLM d l (Fin.tail α)))

private lemma iterCoordDerivCLM_apply (d : ℕ) :
    ∀ (l : ℕ) (α : Fin l → Fin d) (h : 𝓢(EuclideanSpace ℝ (Fin d), ℝ))
      (x : EuclideanSpace ℝ (Fin d)),
      iterCoordDerivCLM d l α h x =
        iteratedFDeriv ℝ l h x (fun i => EuclideanSpace.single (α i) (1 : ℝ))
  | 0, α, h, x => by
    simp [iterCoordDerivCLM, iteratedFDeriv_zero_apply]
  | l + 1, α, h, x => by
    change fderiv ℝ (fun y => iterCoordDerivCLM d l (Fin.tail α) h y) x
        (EuclideanSpace.single (α 0) (1 : ℝ)) = _
    have hfun : (fun y => iterCoordDerivCLM d l (Fin.tail α) h y) =
        fun y => iteratedFDeriv ℝ l h y (Fin.tail (fun i => EuclideanSpace.single (α i) (1 : ℝ))) := by
      funext y
      rw [iterCoordDerivCLM_apply d l (Fin.tail α) h y]
      rfl
    rw [hfun, iteratedFDeriv_succ_apply_left]
    have hdiff : DifferentiableAt ℝ (iteratedFDeriv ℝ l h) x :=
      ((h.smooth (l + 1)).differentiable_iteratedFDeriv (by exact_mod_cast Nat.lt_succ_self l) x)
    have hclm : HasFDerivAt
        (fun y => iteratedFDeriv ℝ l h y (Fin.tail (fun i => EuclideanSpace.single (α i) (1 : ℝ))))
        ((ContinuousMultilinearMap.apply ℝ (fun _ : Fin l => EuclideanSpace ℝ (Fin d)) ℝ
          (Fin.tail (fun i => EuclideanSpace.single (α i) (1 : ℝ)))).comp (fderiv ℝ (iteratedFDeriv ℝ l h) x))
        x :=
      (ContinuousMultilinearMap.apply ℝ (fun _ : Fin l => EuclideanSpace ℝ (Fin d)) ℝ
        (Fin.tail (fun i => EuclideanSpace.single (α i) (1 : ℝ)))).hasFDerivAt.comp x hdiff.hasFDerivAt
    rw [hclm.fderiv]
    rfl

private lemma norm_iteratedFDeriv_le_sum_coord (d l : ℕ)
    (h : 𝓢(EuclideanSpace ℝ (Fin d), ℝ)) (x : EuclideanSpace ℝ (Fin d)) :
    ‖iteratedFDeriv ℝ l h x‖ ≤
      ∑ α : Fin l → Fin d, |iterCoordDerivCLM d l α h x| := by
  refine ContinuousMultilinearMap.opNorm_le_bound (Finset.sum_nonneg fun _ _ => abs_nonneg _)
    fun m => ?_
  have hm_eq : m = fun i : Fin l => ∑ r : Fin d, (m i r) • EuclideanSpace.single r (1 : ℝ) := by
    funext i
    ext r
    simp [Pi.single_apply]
  have hexp : iteratedFDeriv ℝ l h x m =
      ∑ α : Fin l → Fin d, (∏ i : Fin l, m i (α i)) *
        iteratedFDeriv ℝ l h x (fun i => EuclideanSpace.single (α i) (1 : ℝ)) := by
    conv_lhs => rw [hm_eq]
    rw [ContinuousMultilinearMap.map_sum_finset]
    simp only [Fintype.piFinset_univ, ContinuousMultilinearMap.map_smul_univ, smul_eq_mul]
  rw [hexp]
  calc ‖∑ α : Fin l → Fin d, (∏ i : Fin l, m i (α i)) *
          iteratedFDeriv ℝ l h x (fun i => EuclideanSpace.single (α i) (1 : ℝ))‖
      ≤ ∑ α : Fin l → Fin d, ‖(∏ i : Fin l, m i (α i)) *
          iteratedFDeriv ℝ l h x (fun i => EuclideanSpace.single (α i) (1 : ℝ))‖ :=
        norm_sum_le _ _
    _ ≤ ∑ α : Fin l → Fin d, (∏ i : Fin l, ‖m i‖) * |iterCoordDerivCLM d l α h x| := by
        refine Finset.sum_le_sum fun α _ => ?_
        rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, ← iterCoordDerivCLM_apply d l α h x]
        refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
        rw [Finset.abs_prod]
        gcongr with i _
        exact PiLp.norm_apply_le (m i) (α i)
    _ = (∑ α : Fin l → Fin d, |iterCoordDerivCLM d l α h x|) * ∏ i : Fin l, ‖m i‖ := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun α _ => mul_comm _ _

/-- For any finite seminorm set `s` on `𝓢(EuclideanSpace ℝ (Fin d), ℝ)`, there exists a
countable subset `D ⊆ 𝓢(EuclideanSpace ℝ (Fin d), ℝ)` such that every continuous linear
functional bounded by `s.sup` that vanishes on `D` vanishes identically. -/
private lemma exists_countable_separating_schwartz (d : ℕ) (s : Finset (ℕ × ℕ)) :
    ∃ D : Set 𝓢(EuclideanSpace ℝ (Fin d), ℝ), D.Countable ∧
      ∀ (T : 𝓢(EuclideanSpace ℝ (Fin d), ℝ) →ₗ[ℝ] ℝ) (B : ℝ),
        (∀ h, |T h| ≤ B * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h) →
        (∀ h ∈ D, T h = 0) →
        ∀ h, T h = 0 := by
  let E := EuclideanSpace ℝ (Fin d)
  have hwt : ∀ k : ℕ, Function.HasTemperateGrowth (fun x : E => ((1 + ‖x‖ ^ 2) ^ k : ℂ)) := fun k => by
    have h1 := hasTemperateGrowth_sq_add_norm_sq_rpow (d := d) (m := 1) zero_lt_one (k : ℝ)
    have heq : (fun x : E => ((1 + ‖x‖ ^ 2) ^ k : ℂ)) =
        fun x => (((1 ^ 2 + ‖x‖ ^ 2) ^ (k : ℝ) : ℝ) : ℂ) := by
      funext x; rw [one_pow, Real.rpow_natCast]; push_cast; rfl
    rw [heq]
    exact Complex.hasTemperateGrowth_ofReal.comp h1
  let mapComp (q : s) (α : Fin q.1.2 → Fin d) :
      𝓢(E, ℝ) →L[ℝ] 𝓢(E, ℂ) :=
    ((SchwartzMap.smulLeftCLM ℂ (fun ξ : E => ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℂ))).restrictScalars ℝ).comp
      (((SchwartzMap.fourierTransformCLM ℂ).restrictScalars ℝ).comp
        (((SchwartzMap.smulLeftCLM ℂ (fun x : E => ((1 + ‖x‖ ^ 2) ^ q.1.1 : ℂ))).restrictScalars ℝ).comp
          ((SchwartzMap.postcompCLM Complex.ofRealCLM).comp (iterCoordDerivCLM d q.1.2 α))))
  let Ψ : 𝓢(E, ℝ) →ₗ[ℝ] ((q : s) → (Fin q.1.2 → Fin d) → Lp ℂ 2 (volume : Measure E)) :=
    { toFun := fun h q α => SchwartzMap.toLpCLM ℝ ℂ 2 (volume : Measure E) (mapComp q α h)
      map_add' := fun h₁ h₂ => by ext q α; simp [map_add]
      map_smul' := fun r h => by ext q α; simp [map_smul] }
  have : Fact ((2 : ENNReal) ≠ ⊤) := ⟨by norm_num⟩
  have : SecondCountableTopology (Lp ℂ 2 (volume : Measure E)) :=
    UniformSpace.secondCountable_of_separable _
  have hsep_range : TopologicalSpace.SeparableSpace (Set.range Ψ) := inferInstance
  obtain ⟨S, hSc, hSd⟩ := hsep_range.exists_countable_dense
  have : Countable S := hSc.to_subtype
  choose pre hpre using fun x : S => x.1.2
  let D : Set 𝓢(E, ℝ) := Set.range pre
  have hDc : D.Countable := Set.countable_range pre
  have h_inv_int : Integrable (fun ξ : E => ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹ ^ 2) volume := by
    have hint : Integrable (fun ξ : E => (1 + ‖ξ‖) ^ (-((d + 1 : ℕ) : ℝ))) volume :=
      integrable_one_add_norm (by rw [finrank_euclideanSpace_fin]; push_cast; linarith)
    refine (hint.const_mul ((2 : ℝ) ^ (d + 1))).mono' (by fun_prop) (ae_of_all _ fun ξ => ?_)
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    have hpos1 : (0 : ℝ) < 1 + ‖ξ‖ := by positivity
    have hpos2 : (0 : ℝ) < 1 + ‖ξ‖ ^ 2 := by positivity
    rw [inv_pow, Real.rpow_neg hpos1.le, Real.rpow_natCast]
    have hle1 : 1 + ‖ξ‖ ≤ 2 * (1 + ‖ξ‖ ^ 2) := by nlinarith [sq_nonneg (‖ξ‖ - 1), norm_nonneg ξ]
    have hle2 : (1 + ‖ξ‖) ^ (d + 1) ≤ (2 : ℝ) ^ (d + 1) * (1 + ‖ξ‖ ^ 2) ^ (d + 1) := by
      rw [← mul_pow]
      exact pow_le_pow_left₀ hpos1.le hle1 (d + 1)
    have hge1 : (1 : ℝ) ≤ (1 + ‖ξ‖ ^ 2) ^ (d + 1) :=
      one_le_pow₀ (by nlinarith [sq_nonneg ‖ξ‖])
    have hle3 : (1 + ‖ξ‖) ^ (d + 1) ≤ (2 : ℝ) ^ (d + 1) * ((1 + ‖ξ‖ ^ 2) ^ (d + 1)) ^ 2 := by
      have hsq : (1 + ‖ξ‖ ^ 2) ^ (d + 1) ≤ ((1 + ‖ξ‖ ^ 2) ^ (d + 1)) ^ 2 := by nlinarith
      exact hle2.trans (mul_le_mul_of_nonneg_left hsq (by positivity))
    have hinv : (((1 + ‖ξ‖ ^ 2) ^ (d + 1)) ^ 2)⁻¹ ≤
        (2 : ℝ) ^ (d + 1) * ((1 + ‖ξ‖) ^ (d + 1))⁻¹ := by
      rw [inv_le_iff_one_le_mul₀ (by positivity)]
      have hpos3 : (0 : ℝ) < (1 + ‖ξ‖) ^ (d + 1) := by positivity
      calc (1 : ℝ) = (1 + ‖ξ‖) ^ (d + 1) * ((1 + ‖ξ‖) ^ (d + 1))⁻¹ := (mul_inv_cancel₀ hpos3.ne').symm
        _ ≤ ((2 : ℝ) ^ (d + 1) * ((1 + ‖ξ‖ ^ 2) ^ (d + 1)) ^ 2) * ((1 + ‖ξ‖) ^ (d + 1))⁻¹ :=
            mul_le_mul_of_nonneg_right hle3 (by positivity)
        _ = (2 : ℝ) ^ (d + 1) * ((1 + ‖ξ‖) ^ (d + 1))⁻¹ * ((1 + ‖ξ‖ ^ 2) ^ (d + 1)) ^ 2 := by ring
    exact hinv
  let K : ℝ := Real.sqrt (∫ ξ : E, ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹ ^ 2)
  have hK : 0 ≤ K := Real.sqrt_nonneg _
  have hsup_bound : ∀ (h : 𝓢(E, ℝ)) (q : s) (α : Fin q.1.2 → Fin d) (x : E),
      (1 + ‖x‖ ^ 2) ^ q.1.1 * |iterCoordDerivCLM d q.1.2 α h x| ≤ K * ‖Ψ h q α‖ := by
    intro h q α x
    let u : 𝓢(E, ℂ) := SchwartzMap.smulLeftCLM ℂ (fun y : E => ((1 + ‖y‖ ^ 2) ^ q.1.1 : ℂ))
      (SchwartzMap.postcompCLM Complex.ofRealCLM (iterCoordDerivCLM d q.1.2 α h))
    have hu_eq : ‖u x‖ = (1 + ‖x‖ ^ 2) ^ q.1.1 * |iterCoordDerivCLM d q.1.2 α h x| := by
      dsimp only [u]
      rw [SchwartzMap.smulLeftCLM_apply_apply (hwt q.1.1), smul_eq_mul, norm_mul,
        SchwartzMap.postcompCLM_apply, Complex.ofRealCLM_apply, Complex.norm_real,
        Real.norm_eq_abs, norm_pow]
      have h1 : ‖((1 + ‖x‖ ^ 2 : ℝ) : ℂ)‖ = 1 + ‖x‖ ^ 2 := by
        rw [Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      rw [show (1 + (‖x‖ : ℂ) ^ 2) = ((1 + ‖x‖ ^ 2 : ℝ) : ℂ) by push_cast; rfl, h1]
    rw [← hu_eq]
    have hinv := congrArg (fun f : 𝓢(E, ℂ) => f x)
      (FourierPair.fourierInv_fourier_eq (E := 𝓢(E, ℂ)) (F := 𝓢(E, ℂ)) u)
    rw [← hinv]
    change ‖(𝓕⁻ (𝓕 u : 𝓢(E, ℂ))) x‖ ≤ K * ‖Ψ h q α‖
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
    have h1 : ‖∫ ξ : E, (Real.fourierChar (inner ℝ ξ x)) • (𝓕 u) ξ‖ ≤ ∫ ξ : E, ‖(𝓕 u) ξ‖ := by
      calc ‖∫ ξ : E, (Real.fourierChar (inner ℝ ξ x)) • (𝓕 u) ξ‖
          ≤ ∫ ξ : E, ‖(Real.fourierChar (inner ℝ ξ x)) • (𝓕 u) ξ‖ :=
            norm_integral_le_integral_norm _
        _ = ∫ ξ : E, ‖(𝓕 u) ξ‖ := by
            refine integral_congr_ae (ae_of_all _ fun ξ => ?_)
            dsimp only
            rw [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul]
    have hfu_mem : MemLp (fun ξ : E => ‖mapComp q α h ξ‖) 2 volume :=
      (mapComp q α h).memLp 2 volume |>.norm
    have hwt_mem : MemLp (fun ξ : E => ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹) 2 volume := by
      refine (memLp_two_iff_integrable_sq_norm (by fun_prop)).mpr ?_
      have heq : (fun ξ : E => ‖((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹‖ ^ 2) =
          fun ξ : E => ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹ ^ 2 := by
        funext ξ; rw [Real.norm_of_nonneg (by positivity)]
      rw [heq]
      exact h_inv_int
    have h2eq : ENNReal.ofReal (2 : ℝ) = 2 := by norm_num
    have hcs := MeasureTheory.integral_mul_le_Lp_mul_Lq_of_nonneg
      (Real.HolderConjugate.conjExponent (p := 2) (by norm_num))
      (ae_of_all _ fun ξ => by positivity : 0 ≤ᶠ[ae volume] fun ξ : E => ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹)
      (ae_of_all _ fun ξ => norm_nonneg _)
      (by rwa [h2eq])
      (by
        have hc2 : ENNReal.ofReal (Real.conjExponent 2) = 2 := by norm_num [Real.conjExponent]
        rwa [hc2])
    have hrew : ∀ ξ : E, ‖(𝓕 u) ξ‖ =
        ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹ * ‖mapComp q α h ξ‖ := by
      intro ξ
      have hm : mapComp q α h ξ = ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℂ) * (𝓕 u) ξ := by
        change SchwartzMap.smulLeftCLM ℂ (fun y : E => ((1 + ‖y‖ ^ 2) ^ (d + 1) : ℂ)) (𝓕 u) ξ = _
        rw [SchwartzMap.smulLeftCLM_apply_apply (hwt (d + 1)), smul_eq_mul]
      rw [hm, norm_mul, norm_pow,
        show (1 + (‖ξ‖ : ℂ) ^ 2) = ((1 + ‖ξ‖ ^ 2 : ℝ) : ℂ) by push_cast; rfl,
        Complex.norm_real, Real.norm_of_nonneg (by positivity), ← mul_assoc,
        inv_mul_cancel₀ (by positivity), one_mul]
    simp_rw [hrew] at h1
    have hnorm_Ψ : (∫ ξ : E, ‖mapComp q α h ξ‖ ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) = ‖Ψ h q α‖ := by
      have heq : ‖Ψ h q α‖ = (∫ ξ : E, ‖mapComp q α h ξ‖ ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) := by
        rw [Lp.norm_def, eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)
          (Lp.aestronglyMeasurable _)]
        have hae := ((mapComp q α h).memLp 2 volume).coeFn_toLp
        have hcongr : ∫⁻ ξ : E, ‖(Ψ h q α : E → ℂ) ξ‖ₑ ^ (2 : ℝ) =
            ∫⁻ ξ : E, ENNReal.ofReal (‖mapComp q α h ξ‖ ^ (2 : ℝ)) := by
          refine lintegral_congr_ae ?_
          filter_upwards [hae] with ξ hξ
          change ‖(((mapComp q α h).memLp 2 volume).toLp (mapComp q α h) : E → ℂ) ξ‖ₑ ^ (2 : ℝ) = _
          rw [hξ, ← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
        simp only [ENNReal.toReal_ofNat]
        rw [hcongr, ← ofReal_integral_eq_lintegral_ofReal
          (by simpa [Real.rpow_two] using hfu_mem.integrable_sq) (ae_of_all _ fun _ => by positivity),
          ← ENNReal.toReal_rpow, ENNReal.toReal_ofReal (integral_nonneg fun _ => by positivity)]
      exact heq.symm
    have hK_eq : (∫ ξ : E, ((1 + ‖ξ‖ ^ 2) ^ (d + 1) : ℝ)⁻¹ ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) = K := by
      simp only [K, Real.rpow_two, Real.sqrt_eq_rpow]
    have hconj2 : Real.conjExponent 2 = 2 := by norm_num [Real.conjExponent]
    rw [hconj2, hK_eq, hnorm_Ψ] at hcs
    exact h1.trans hcs
  have hsem_bound : ∀ h : 𝓢(E, ℝ),
      (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h ≤
        ((s.sup fun p : ℕ × ℕ => d ^ p.2 : ℕ) : ℝ) * K * ‖Ψ h‖ := by
    intro h
    rw [Seminorm.finset_sup_apply]
    have hle_nn : s.sup (fun p : ℕ × ℕ => NNReal.mk (SchwartzMap.seminorm ℝ p.1 p.2 h) (apply_nonneg _ _)) ≤
        NNReal.mk (((s.sup fun p : ℕ × ℕ => d ^ p.2 : ℕ) : ℝ) * K * ‖Ψ h‖) (by positivity) := by
      refine Finset.sup_le fun p hp => ?_
      change SchwartzMap.seminorm ℝ p.1 p.2 h ≤ ((s.sup fun q : ℕ × ℕ => d ^ q.2 : ℕ) : ℝ) * K * ‖Ψ h‖
      refine SchwartzMap.seminorm_le_bound ℝ p.1 p.2 h (by positivity) fun x => ?_
      have hxk : ‖x‖ ^ p.1 ≤ (1 + ‖x‖ ^ 2) ^ p.1 := by
        refine pow_le_pow_left₀ (norm_nonneg x) ?_ p.1
        nlinarith [sq_nonneg (‖x‖ - 1)]
      calc ‖x‖ ^ p.1 * ‖iteratedFDeriv ℝ p.2 h x‖
          ≤ (1 + ‖x‖ ^ 2) ^ p.1 * ∑ α : Fin p.2 → Fin d, |iterCoordDerivCLM d p.2 α h x| :=
            mul_le_mul hxk (norm_iteratedFDeriv_le_sum_coord d p.2 h x)
              (norm_nonneg _) (by positivity)
        _ = ∑ α : Fin p.2 → Fin d, (1 + ‖x‖ ^ 2) ^ p.1 * |iterCoordDerivCLM d p.2 α h x| :=
            Finset.mul_sum _ _ _
        _ ≤ ∑ α : Fin p.2 → Fin d, K * ‖Ψ h ⟨p, hp⟩ α‖ :=
            Finset.sum_le_sum fun α _ => hsup_bound h ⟨p, hp⟩ α x
        _ ≤ ∑ _α : Fin p.2 → Fin d, K * ‖Ψ h‖ := by
            refine Finset.sum_le_sum fun α _ => mul_le_mul_of_nonneg_left ?_ hK
            exact (norm_le_pi_norm (Ψ h ⟨p, hp⟩) α).trans (norm_le_pi_norm (Ψ h) ⟨p, hp⟩)
        _ = ((d ^ p.2 : ℕ) : ℝ) * (K * ‖Ψ h‖) := by
            simp [Finset.sum_const, Fintype.card_fin]
        _ ≤ ((s.sup fun q : ℕ × ℕ => d ^ q.2 : ℕ) : ℝ) * K * ‖Ψ h‖ := by
            rw [mul_assoc]
            refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg hK (norm_nonneg _))
            exact_mod_cast Finset.le_sup (f := fun q : ℕ × ℕ => d ^ q.2) hp
    exact NNReal.coe_le_coe.mpr hle_nn
  refine ⟨D, hDc, fun T B hTB hTD h => ?_⟩
  let C : ℝ := |B| * ((s.sup fun p : ℕ × ℕ => d ^ p.2 : ℕ) : ℝ) * K
  have hC : 0 ≤ C := by positivity
  by_contra hne
  have hpos : 0 < |T h| := abs_pos.mpr hne
  let δ : ℝ := |T h| / (C + 1)
  have hδ : 0 < δ := by positivity
  have hmem_cl : (⟨Ψ h, ⟨h, rfl⟩⟩ : Set.range Ψ) ∈ closure S := hSd _
  rw [Metric.mem_closure_iff] at hmem_cl
  obtain ⟨y, hyS, hydist⟩ := hmem_cl δ hδ
  let g : 𝓢(E, ℝ) := pre ⟨y, hyS⟩
  have hgD : g ∈ D := Set.mem_range_self _
  have hΨg : Ψ g = y.1 := hpre ⟨y, hyS⟩
  have hdist : ‖Ψ (h - g)‖ < δ := by
    rw [map_sub, hΨg]
    simpa [Subtype.dist_eq, dist_eq_norm] using hydist
  have hTh : |T h| ≤ C * ‖Ψ (h - g)‖ := by
    have hsub : T h = T (h - g) := by rw [map_sub, hTD g hgD, sub_zero]
    rw [hsub]
    calc |T (h - g)| ≤ B * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) (h - g) := hTB (h - g)
      _ ≤ |B| * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) (h - g) :=
          mul_le_mul_of_nonneg_right (le_abs_self B) (apply_nonneg _ _)
      _ ≤ |B| * (((s.sup fun p : ℕ × ℕ => d ^ p.2 : ℕ) : ℝ) * K * ‖Ψ (h - g)‖) :=
          mul_le_mul_of_nonneg_left (hsem_bound (h - g)) (abs_nonneg B)
      _ = C * ‖Ψ (h - g)‖ := by ring
  have hlt : C * ‖Ψ (h - g)‖ < |T h| := by
    calc C * ‖Ψ (h - g)‖ ≤ C * δ := mul_le_mul_of_nonneg_left hdist.le hC
      _ < (C + 1) * δ := by nlinarith
      _ = |T h| := mul_div_cancel₀ _ (by positivity)
  linarith

/-- Positive-half-space σ-algebra `ℱ₊` on `RealTemperedDistribution (EuclidD n)`, generated by
all evaluations `φ ↦ φ f` for `f : 𝓢(EuclidD n, ℝ)` supported in `{x₀ ≥ 0}` (i.e. vanishing on `{x₀ < 0}`). -/
@[instance_reducible]
def gffPosSigma (n : ℕ) : MeasurableSpace (RealTemperedDistribution (EuclidD n)) :=
  ⨆ f : {f : 𝓢(EuclidD n, ℝ) // ∀ x : EuclidD n, x 0 < 0 → f x = 0},
    MeasurableSpace.comap (fun φ : RealTemperedDistribution (EuclidD n) => φ f.1) inferInstance

theorem gffPosSigma_le_cyl (n : ℕ) : gffPosSigma n ≤ cylMeasurableSpace (EuclidD n) := by
  refine iSup_le fun f => ?_
  exact le_iSup (fun g : 𝓢(EuclidD n, ℝ) =>
    MeasurableSpace.comap (fun φ : RealTemperedDistribution (EuclidD n) => φ g) inferInstance) f.1

theorem measurable_eval_gffPosSigma {n : ℕ} (f : 𝓢(EuclidD n, ℝ))
    (hf : ∀ x : EuclidD n, x 0 < 0 → f x = 0) :
    Measurable[gffPosSigma n, inferInstance]
      (fun φ : RealTemperedDistribution (EuclidD n) => φ f) :=
  measurable_iff_comap_le.mpr
    (le_iSup (fun g : {g : 𝓢(EuclidD n, ℝ) // ∀ x : EuclidD n, x 0 < 0 → g x = 0} =>
      MeasurableSpace.comap (fun φ : RealTemperedDistribution (EuclidD n) => φ g.1) inferInstance)
      ⟨f, hf⟩)

/-- **Upper-Half-Space Markov Locality**: every `gffPosSigma`-measurable complex functional
`F` depends on `gffField (ω₀, ω₊, ω₋)` ONLY through `gffLiftPos (planeGaussianField ω₀, ω₊)`. -/
theorem gffPosSigma_local (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (F : RealTemperedDistribution (EuclidD n) → ℂ)
    (hFm : Measurable[gffPosSigma n, inferInstance] F)
    (ω₀ : GaussianSeq (FrameIdx (n + 1))) (ωp ωm : GaussianSeq (FrameIdx (n + 2))) :
    F (gffField n ħ m hħ hm (ω₀, ωp, ωm)) =
      F (gffLiftPos n ħ m hħ hm (planeGaussianField n ħ m hħ hm ω₀, ωp)) := by
  refine eq_of_measurable_of_eval_eq
    (fun f : {f : 𝓢(EuclidD n, ℝ) // ∀ x : EuclidD n, x 0 < 0 → f x = 0} => fun φ => φ f.1)
    hFm fun ⟨f, hf⟩ => ?_
  have hθf : ∀ x : EuclidD n, 0 < x 0 → reflectSchwartz f x = 0 := by
    intro x hx
    exact hf (euclidTimeReflect x) (by simpa [euclidTimeReflect_zero] using neg_lt_zero.mpr hx)
  have h0 := dirichletPosField_eq_zero_of_support_nonpos n ħ m hħ hm ωm (reflectSchwartz f) hθf
  change planeGaussianField n ħ m hħ hm ω₀ (poissonProj n m hm f) +
      dirichletPosField n ħ m hħ hm ωp f +
      dirichletPosField n ħ m hħ hm ωm (reflectSchwartz f) =
    planeGaussianField n ħ m hħ hm ω₀ (poissonProj n m hm f) +
      dirichletPosField n ħ m hħ hm ωp f
  rw [h0, add_zero]

/-- Existence of an explicit `gffPosSigma`-measurable sharp-time trace map
`trace₀ : RealTemperedDistribution (EuclidD n) → RealTemperedDistribution (SpatialE n)`
recovering `planeGaussianField ω.1` almost surely along `gffField`. -/
theorem exists_gffTrace0 (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    ∃ trace₀ : RealTemperedDistribution (EuclidD n) → RealTemperedDistribution (SpatialE n),
      Measurable[gffPosSigma n, cylMeasurableSpace (SpatialE n)] trace₀ ∧
      ∀ᵐ ω ∂(gffNoiseMeasure n),
        trace₀ (gffField n ħ m hħ hm ω) = planeGaussianField n ħ m hħ hm ω.1 := by
  let _ := cylMeasurableSpace (EuclidD n)
  let P₀ := iidGaussianMeasure (FrameIdx (n + 1))
  let Pp := iidGaussianMeasure (FrameIdx (n + 2))
  let test : FrameIdx (n + 1) → 𝓢(SpatialE n, ℝ) := planeFrameTest n ħ m hħ hm
  let approx : FrameIdx (n + 1) → ℕ → RealTemperedDistribution (EuclidD n) → ℝ :=
    fun idx k φ => frameSign idx * φ (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx))
  let target : FrameIdx (n + 1) → GaussianSeq (FrameIdx (n + 1)) → ℝ :=
    fun idx ω₀ => frameSign idx * planeGaussianField n ħ m hħ hm ω₀ (test idx)
  have happrox_meas : ∀ idx k, Measurable[gffPosSigma n, inferInstance] (approx idx k) := by
    intro idx k
    let _ := gffPosSigma n
    exact measurable_const.mul (measurable_eval_gffPosSigma _ fun x hx =>
      thinSlabTest_support_pos (by positivity) (test idx) hx.le)
  have htarget_meas : ∀ idx, Measurable (target idx) := fun idx =>
    measurable_const.mul
      ((measurable_eval_cyl (test idx)).comp (measurable_planeGaussianField n ħ m hħ hm))
  have hdiff_eq : ∀ idx k (ω : GFFNoise n),
      approx idx k (gffField n ħ m hħ hm ω) - target idx ω.1 =
        frameSign idx *
          (planeGaussianField n ħ m hħ hm ω.1
              (poissonProj n m hm (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx)) -
                test idx) +
            dirichletPosField n ħ m hħ hm ω.2.1
              (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx))) := by
    intro idx k ω
    have hθ0 : dirichletPosField n ħ m hħ hm ω.2.2
        (reflectSchwartz (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx))) = 0 := by
      refine dirichletPosField_eq_zero_of_support_nonpos n ħ m hħ hm ω.2.2 _ fun x hx => ?_
      exact thinSlabTest_support_pos (by positivity) (test idx)
        (by change (euclidTimeReflect x) 0 ≤ 0; rw [euclidTimeReflect_zero]; linarith)
    simp only [approx, target, gffField_apply, hθ0, add_zero, map_sub]
    ring
  have hmem_plane : ∀ h : 𝓢(SpatialE n, ℝ),
      MemLp (fun ω₀ => planeGaussianField n ħ m hħ hm ω₀ h) 2 P₀ := fun h => by
    let _ := cylMeasurableSpace (SpatialE n)
    have hmp : MeasurePreserving (planeGaussianField n ħ m hħ hm) P₀
        (planeGaussianMeasure n ħ m hħ hm) :=
      ⟨measurable_planeGaussianField n ħ m hħ hm, rfl⟩
    exact (memLp_eval_real_gaussianSeriesMeasure _ _ _ _ _ _ h).comp_measurePreserving hmp
  have hmem_dir : ∀ f : 𝓢(EuclidD n, ℝ),
      MemLp (fun ωp => dirichletPosField n ħ m hħ hm ωp f) 2 Pp := fun f => by
    have hmp : MeasurePreserving (dirichletPosField n ħ m hħ hm) Pp
        (gaussianSeriesMeasure (dirichletFrameCLM n ħ m hm) (dirichletFrameWeight n ħ m hm)
          (dirichletFrameWeight_nonneg n ħ m hm) (summable_dirichletFrameWeight n ħ m hm)
          (dirichletFrameSeminorms n ħ m hm) (dirichletFrameCLM_bound n ħ m hm)) :=
      ⟨measurable_dirichletPosField n ħ m hħ hm, rfl⟩
    exact (memLp_eval_real_gaussianSeriesMeasure _ _ _ _ _ _ f).comp_measurePreserving hmp
  have hL2_exact : ∀ idx k,
      Integrable (fun ω : GFFNoise n => (approx idx k (gffField n ħ m hħ hm ω) - target idx ω.1) ^ 2)
        (gffNoiseMeasure n) ∧
      ∫ ω : GFFNoise n, (approx idx k (gffField n ħ m hħ hm ω) - target idx ω.1) ^ 2
        ∂(gffNoiseMeasure n) =
        (∫ ξ : SpatialE n,
          ‖planeKernel n ħ m (poissonProj n m hm
              (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx))) ξ -
            planeKernel n ħ m (test idx) ξ‖ ^ 2) +
        (∫ p : EuclidD n,
          ‖dirichletPosKernel n ħ m
            (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx)) p‖ ^ 2) := by
    intro idx k
    let A : GaussianSeq (FrameIdx (n + 1)) → ℝ := fun ω₀ =>
      planeGaussianField n ħ m hħ hm ω₀
        (poissonProj n m hm (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx)) - test idx)
    let B : GaussianSeq (FrameIdx (n + 2)) → ℝ := fun ωp =>
      dirichletPosField n ħ m hħ hm ωp
        (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx))
    have hA : MemLp A 2 P₀ := hmem_plane _
    have hB : MemLp B 2 Pp := hmem_dir _
    have hfsq : (frameSign idx) ^ 2 = 1 := by cases idx.2 <;> simp [frameSign]
    have hfun : (fun ω : GFFNoise n => (approx idx k (gffField n ħ m hħ hm ω) - target idx ω.1) ^ 2) =
        fun ω => (A ω.1 ^ 2 + 2 * (A ω.1 * B ω.2.1)) + B ω.2.1 ^ 2 := by
      funext ω
      rw [hdiff_eq idx k ω, mul_pow, hfsq, one_mul]
      ring
    have hiA2 : Integrable (fun ω : GFFNoise n => A ω.1 ^ 2) (gffNoiseMeasure n) :=
      (hA.integrable_sq).comp_fst _
    have hiB2 : Integrable (fun ω : GFFNoise n => B ω.2.1 ^ 2) (gffNoiseMeasure n) :=
      ((hB.integrable_sq).comp_fst _).comp_snd _
    have hiAB : Integrable (fun ω : GFFNoise n => A ω.1 * B ω.2.1) (gffNoiseMeasure n) :=
      (hA.integrable one_le_two).mul_prod ((hB.integrable one_le_two).comp_fst _)
    have hi2AB : Integrable (fun ω : GFFNoise n => 2 * (A ω.1 * B ω.2.1)) (gffNoiseMeasure n) :=
      hiAB.const_mul 2
    have hiA2_2AB : Integrable (fun ω : GFFNoise n => A ω.1 ^ 2 + 2 * (A ω.1 * B ω.2.1))
        (gffNoiseMeasure n) := hiA2.add hi2AB
    refine ⟨by rw [hfun]; exact hiA2_2AB.add hiB2, ?_⟩
    rw [hfun, integral_add hiA2_2AB hiB2, integral_add hiA2 hi2AB, integral_const_mul]
    have hcross0 : ∫ ω : GFFNoise n, A ω.1 * B ω.2.1 ∂(gffNoiseMeasure n) = 0 := by
      unfold gffNoiseMeasure
      have hzeroA : ∫ ω₀, A ω₀ ∂iidGaussianMeasure (FrameIdx (n + 1)) = 0 :=
        integral_gaussianSeriesField_eq_zero _ _ _ _ _ _ _
      rw [integral_prod_mul (f := A)
        (g := fun q : GaussianSeq (FrameIdx (n + 2)) × GaussianSeq (FrameIdx (n + 2)) => B q.1),
        hzeroA, zero_mul]
    have hA2_val : ∫ ω : GFFNoise n, A ω.1 ^ 2 ∂(gffNoiseMeasure n) =
        ∫ ξ : SpatialE n,
          ‖planeKernel n ħ m (poissonProj n m hm
              (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx))) ξ -
            planeKernel n ħ m (test idx) ξ‖ ^ 2 := by
      unfold gffNoiseMeasure
      rw [integral_fun_fst (f := fun ω₀ => A ω₀ ^ 2)]
      simp only [Measure.real_def, measure_univ, ENNReal.toReal_one, one_smul]
      let _ := cylMeasurableSpace (SpatialE n)
      let hsub := poissonProj n m hm (thinSlabTest (1 / ((k : ℝ) + 1)) (by positivity) (test idx)) - test idx
      have hmap0 : ∫ φ, φ hsub * φ hsub ∂(planeGaussianMeasure n ħ m hħ hm) =
          ∫ ω₀, A ω₀ ^ 2 ∂P₀ := by
        dsimp only [planeGaussianMeasure, gaussianSeriesMeasure, A, hsub, planeGaussianField, P₀]
        simp_rw [sq]
        exact integral_map (measurable_gaussianSeriesField _ _ _ _ _ _).aemeasurable
          ((measurable_eval_cyl _).mul (measurable_eval_cyl _)).aestronglyMeasurable
      rw [← hmap0, integral_mul_planeGaussianMeasure]
      refine integral_congr_ae (ae_of_all _ fun ξ => ?_)
      dsimp only
