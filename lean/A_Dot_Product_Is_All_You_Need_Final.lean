/-- Each ordered vacuum two-point distribution on spacelike-separated real tests
equals the double smear of the physically normalized radial heat boundary. -/
theorem spacelike_vacuum_two_point_heat {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(Spacetime d, ℝ)) (hf : HasCompactSupport f) (hg : HasCompactSupport g)
    (hsep : ∀ p ∈ tsupport f, ∀ q ∈ tsupport g, |p.1-q.1| < ‖p.2-q.2‖) :
    let W := fun h ↦ unitaryWightmanField d ħ m hħ hm (FeatureDensity.ofRealSchwartz h)
    inner ℂ (fockVacuum volume) (W f (W g (fockVacuumFin volume))).1 =
      ∫ r : Spacetime d × Spacetime d, (f r.1 : ℂ) * (g r.2 : ℂ) *
        physicalHeatKernel (d+1) ħ m (‖r.1.2-r.2.2‖^2 - (r.1.1-r.2.1)^2 : ℝ) :=
  tendsto_nhds_unique (ordered_two_point_shell_boundary hħ hm f g hf hg)
    (spacelike_shell_smearing_boundary ħ hm f g hf hg hsep)

private theorem field_commutes_of_equal_grams {X : Type*} [MeasurableSpace X]
    (μ : Measure X) [SigmaFinite μ] (u v : Lp ℂ 2 μ) (ψ : FiniteParticleFock μ)
    (h : inner ℂ u v = inner ℂ v u) :
    contField μ u u (contField μ v v ψ) = contField μ v v (contField μ u u ψ) :=
  sub_eq_zero.mp ((contField_commutator μ u u v v ψ).trans
    ((congrArg (fun a : ℂ ↦ a • ψ) (sub_eq_zero.mpr h)).trans (zero_smul ℂ ψ)))

/-- The common spacelike heat boundary makes the scalar in the field commutator
zero on the entire finite-particle core. -/
theorem spacelike_commutativity_from_heat {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(Spacetime d, ℝ)) (hf : HasCompactSupport f) (hg : HasCompactSupport g)
    (hsep : ∀ p ∈ tsupport f, ∀ q ∈ tsupport g, |p.1-q.1| < ‖p.2-q.2‖)
    (ψ : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
    let W := fun h ↦ unitaryWightmanField d ħ m hħ hm (FeatureDensity.ofRealSchwartz h)
    W f (W g ψ) = W g (W f ψ) := by
  intro W
  let V := fun h ↦ unitaryShellFeature d ħ m hħ hm (FeatureDensity.ofRealSchwartz h)
  let B (p q : Spacetime d) := physicalHeatKernel (d+1) ħ m (‖p.2-q.2‖^2 - (p.1-q.1)^2 : ℝ)
  have hs (p q : Spacetime d) : B q p = B p q := by simp only [B, norm_sub_rev q.2 p.2, sub_sq_comm q.1 p.1]
  have hsep' : ∀ q ∈ tsupport g, ∀ p ∈ tsupport f, |q.1-p.1| < ‖q.2-p.2‖ := by
    intro q hq p hp
    simpa only [abs_sub_comm q.1 p.1, norm_sub_rev q.2 p.2] using hsep p hp q hq
  have hW (h : 𝓢(Spacetime d, ℝ)) (y : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
      W h y = contField volume (V h) (V h) y := unitaryWightmanField_real_formula d ħ m hħ hm h y
  have hWW (u v : 𝓢(Spacetime d, ℝ)) (y : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
      W u (W v y) = contField volume (V u) (V u) (contField volume (V v) (V v) y) :=
    (hW u (W v y)).trans (congrArg (contField volume (V u) (V u)) (hW v y))
  have he (u v : 𝓢(Spacetime d, ℝ)) (hu : HasCompactSupport u) (hv : HasCompactSupport v)
      (h : ∀ p ∈ tsupport u, ∀ q ∈ tsupport v, |p.1-q.1| < ‖p.2-q.2‖) :
      inner ℂ (V u) (V v) = ∫ r : Spacetime d × Spacetime d, (u r.1:ℂ)*(v r.2:ℂ)*B r.1 r.2 := by
    let Ω := fockVacuumFin (volume : Measure (MassShell.Space d))
    have hw := congrArg (fun y : FiniteParticleFock (volume : Measure (MassShell.Space d)) ↦
      inner ℂ (fockVacuum volume) y.1) (hWW u v Ω)
    exact (vacuum_field_pair volume (V u) (V v)).symm.trans (hw.symm.trans
      (spacelike_vacuum_two_point_heat hħ hm u v hu hv h))
  have hinner : inner ℂ (V f) (V g) = inner ℂ (V g) (V f) := by
    rw [he f g hf hg hsep, he g f hg hf hsep']
    let K (r : Spacetime d × Spacetime d) := (g r.1:ℂ)*(f r.2:ℂ)*B r.1 r.2
    change _ = ∫ r, K r
    calc _ = ∫ r, K (Prod.swap r) := by
              apply integral_congr_ae
              exact ae_of_all _ fun r ↦ by dsimp [K]; rw [hs r.1 r.2, mul_comm (g r.2:ℂ)]
         _ = _ := integral_prod_swap K
  exact (hWW f g ψ).trans
    ((field_commutes_of_equal_grams volume (V f) (V g) ψ hinner).trans (hWW g f ψ).symm)

end DotProduct.Extension


