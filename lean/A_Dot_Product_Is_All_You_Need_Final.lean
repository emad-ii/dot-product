/-! ### Part 1: Real Tempered Distributions & Cylindrical σ-Algebra -/

/-- Real-valued tempered distributions on a real normed space `E`. -/
abbrev RealTemperedDistribution (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :=
  𝓢(E, ℝ) →L[ℝ] ℝ

section Cylindrical

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

private lemma postcompCLM_re_smul (c : ℂ) (f : 𝓢(E, ℂ)) :
    (c • f).postcompCLM Complex.reCLM =
      c.re • f.postcompCLM Complex.reCLM - c.im • f.postcompCLM Complex.imCLM := by
  ext x
  simp [SchwartzMap.postcompCLM_apply, Complex.mul_re]

private lemma postcompCLM_im_smul (c : ℂ) (f : 𝓢(E, ℂ)) :
    (c • f).postcompCLM Complex.imCLM =
      c.im • f.postcompCLM Complex.reCLM + c.re • f.postcompCLM Complex.imCLM := by
  ext x
  simp [SchwartzMap.postcompCLM_apply, Complex.mul_im]
  ring

/-- Canonical complexification mapping a real tempered distribution to Mathlib's
complex tempered distribution `𝓢'(E, ℂ)`. -/
noncomputable def toComplexTempered (φ : RealTemperedDistribution E) : 𝓢'(E, ℂ) :=
  let L : 𝓢(E, ℂ) →L[ℂ] ℂ :=
    { toFun := fun f =>
        (φ (f.postcompCLM Complex.reCLM) : ℂ) +
          Complex.I * (φ (f.postcompCLM Complex.imCLM) : ℂ)
      map_add' := fun f g => by
        simp only [map_add, Complex.ofReal_add]
        ring
      map_smul' := fun c f => by
        simp only [postcompCLM_re_smul, postcompCLM_im_smul, map_sub, map_add, map_smul,
          smul_eq_mul, RingHom.id_apply, Complex.ofReal_sub, Complex.ofReal_add,
          Complex.ofReal_mul]
        apply Complex.ext
        · simp
        · simp; ring
      cont := by
        have hre : Continuous (fun f : 𝓢(E, ℂ) =>
            (φ (f.postcompCLM Complex.reCLM) : ℂ)) :=
          Complex.continuous_ofReal.comp (φ.continuous.comp
            (SchwartzMap.postcompCLM (𝕜 := ℝ) (E := E) Complex.reCLM).continuous)
        have him : Continuous (fun f : 𝓢(E, ℂ) =>
            (φ (f.postcompCLM Complex.imCLM) : ℂ)) :=
          Complex.continuous_ofReal.comp (φ.continuous.comp
            (SchwartzMap.postcompCLM (𝕜 := ℝ) (E := E) Complex.imCLM).continuous)
        exact hre.add (continuous_const.mul him) }
  ContinuousLinearMap.toPointwiseConvergenceCLM _ _ _ _ L

@[simp]
theorem toComplexTempered_apply (φ : RealTemperedDistribution E) (f : 𝓢(E, ℂ)) :
    toComplexTempered φ f =
      (φ (f.postcompCLM Complex.reCLM) : ℂ) +
        Complex.I * (φ (f.postcompCLM Complex.imCLM) : ℂ) := rfl

/-- The cylindrical σ-algebra on `RealTemperedDistribution E`, generated by all
evaluation functionals `φ ↦ φ f` for `f : 𝓢(E, ℝ)`. -/
@[instance_reducible]
def cylMeasurableSpace (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    MeasurableSpace (RealTemperedDistribution E) :=
  ⨆ f : 𝓢(E, ℝ), MeasurableSpace.comap (fun φ : RealTemperedDistribution E => φ f) inferInstance

theorem measurable_eval_cyl (f : 𝓢(E, ℝ)) :
    Measurable[cylMeasurableSpace E, inferInstance]
      (fun φ : RealTemperedDistribution E => φ f) :=
  measurable_iff_comap_le.mpr
    (le_iSup (fun g : 𝓢(E, ℝ) =>
      MeasurableSpace.comap (fun φ : RealTemperedDistribution E => φ g) inferInstance) f)

theorem measurable_to_cyl_iff {Ω : Type*} [mΩ : MeasurableSpace Ω]
    {Φ : Ω → RealTemperedDistribution E} :
    Measurable[mΩ, cylMeasurableSpace E] Φ ↔ ∀ f : 𝓢(E, ℝ), Measurable (fun ω => Φ ω f) := by
  simp only [cylMeasurableSpace, measurable_iff_comap_le, MeasurableSpace.comap_iSup,
    iSup_le_iff, MeasurableSpace.comap_comp]
  rfl

/-- If two points agree on every generator `g i` of a supremum comap σ-algebra,
they lie in the exact same measurable sets. -/
theorem measurableSet_iff_of_eval_eq {α ι : Type*} {β : ι → Type*}
    [∀ i, MeasurableSpace (β i)] (g : ∀ i, α → β i) {x y : α}
    (hxy : ∀ i, g i x = g i y) {s : Set α}
    (hs : MeasurableSet[⨆ i, MeasurableSpace.comap (g i) inferInstance] s) :
    x ∈ s ↔ y ∈ s := by
  let mEq : MeasurableSpace α :=
    { MeasurableSet' := fun t => x ∈ t ↔ y ∈ t
      measurableSet_empty := Iff.rfl
      measurableSet_compl := fun _ ht => not_congr ht
      measurableSet_iUnion := fun _ hf => by
        simp only [Set.mem_iUnion]
        exact exists_congr hf }
  have hle : (⨆ i, MeasurableSpace.comap (g i) inferInstance) ≤ mEq := by
    refine iSup_le fun i t ht => ?_
    rcases ht with ⟨u, -, rfl⟩
    change x ∈ g i ⁻¹' u ↔ y ∈ g i ⁻¹' u
    simp only [Set.mem_preimage, hxy i]
  exact hle s hs

/-- General σ-algebra generator lemma: if two points `x y : α` agree on every
generator `g i` of `m := ⨆ i, MeasurableSpace.comap (g i) inferInstance`, then
every `m`-measurable function into a `MeasurableSingletonClass` (in particular `ℂ`)
takes the same value at `x` and `y`. -/
theorem eq_of_measurable_of_eval_eq {α ι γ : Type*} {β : ι → Type*}
    [∀ i, MeasurableSpace (β i)] [MeasurableSpace γ] [MeasurableSingletonClass γ]
    (g : ∀ i, α → β i) {F : α → γ}
    (hF : Measurable[⨆ i, MeasurableSpace.comap (g i) inferInstance, inferInstance] F)
    {x y : α} (hxy : ∀ i, g i x = g i y) :
    F x = F y := by
  have hs : MeasurableSet[⨆ i, MeasurableSpace.comap (g i) inferInstance] (F ⁻¹' {F x}) :=
    hF (measurableSet_singleton (F x))
  have hiff := measurableSet_iff_of_eval_eq g hxy hs
  have hy : y ∈ F ⁻¹' {F x} := hiff.mp (Set.mem_singleton (F x))
  exact (Set.mem_singleton_iff.mp hy).symm

end Cylindrical

/-! ### Part 2: Countable Hilbert–Schmidt Gaussian Series & Weyl Exponential Density -/

/-- Sequence space of real coordinates indexed by `ι`. -/
abbrev GaussianSeq (ι : Type*) := ι → ℝ

/-- Infinite product of i.i.d. standard normal measures `𝒩(0, 1)` on `ι → ℝ`. -/
noncomputable def iidGaussianMeasure (ι : Type*) : Measure (GaussianSeq ι) :=
  Measure.infinitePi (fun _ : ι => ProbabilityTheory.gaussianReal 0 1)

instance instIsProbabilityMeasureIidGaussianMeasure (ι : Type*) :
    IsProbabilityMeasure (iidGaussianMeasure ι) := by
  unfold iidGaussianMeasure
  infer_instance

section GaussianSeries

variable {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

private lemma tsum_ofReal_ne_top_iff_summable {α : Type*} {f : α → ℝ} (hf : ∀ a, 0 ≤ f a) :
    (∑' a, ENNReal.ofReal (f a)) ≠ ⊤ ↔ Summable f := by
  constructor
  · intro h
    have hsum := ENNReal.summable_toReal h
    simpa [ENNReal.toReal_ofReal (hf _)] using hsum
  · intro h
    rw [← ENNReal.ofReal_tsum_of_nonneg hf h]
    exact ENNReal.ofReal_ne_top

private lemma integral_sq_gaussianReal_zero_one :
    ∫ x : ℝ, x ^ 2 ∂(ProbabilityTheory.gaussianReal 0 1) = 1 := by
  have h := ProbabilityTheory.variance_fun_id_gaussianReal (μ := (0 : ℝ)) (v := (1 : NNReal))
  rw [ProbabilityTheory.variance_eq_integral measurable_id'.aemeasurable,
    ProbabilityTheory.integral_id_gaussianReal] at h
  simpa using h

private lemma integrable_sq_gaussianReal_zero_one :
    Integrable (fun x : ℝ => x ^ 2) (ProbabilityTheory.gaussianReal 0 1) := by
  have h := ProbabilityTheory.memLp_id_gaussianReal (μ := (0 : ℝ)) (v := (1 : NNReal)) 2
  simpa [Real.norm_eq_abs, sq_abs] using h.integrable_sq

private lemma lintegral_ofReal_sq_gaussianReal_zero_one :
    ∫⁻ x : ℝ, ENNReal.ofReal (x ^ 2) ∂(ProbabilityTheory.gaussianReal 0 1) = 1 := by
  rw [← ofReal_integral_eq_lintegral_ofReal integrable_sq_gaussianReal_zero_one
    (ae_of_all _ fun x => sq_nonneg x), integral_sq_gaussianReal_zero_one, ENNReal.ofReal_one]

/-- The full-measure convergence set `{ω | ∑' i, (ω i)^2 * w i < ∞}`. -/
def goodSet (w : ι → ℝ) : Set (GaussianSeq ι) :=
  {ω : GaussianSeq ι | Summable (fun i => (ω i) ^ 2 * w i)}

private lemma measurable_ofReal_sq_mul (w : ι → ℝ) (i : ι) :
    Measurable (fun ω : GaussianSeq ι => ENNReal.ofReal ((ω i) ^ 2 * w i)) := by
  have h1 : Measurable (fun ω : GaussianSeq ι => ω i) := measurable_pi_apply i
  exact ENNReal.measurable_ofReal.comp ((h1.pow_const 2).mul_const (w i))

theorem measurableSet_goodSet [Countable ι] (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) :
    MeasurableSet (goodSet w) := by
  have hEq : goodSet w =
      {ω : GaussianSeq ι | (∑' i, ENNReal.ofReal ((ω i) ^ 2 * w i)) ≠ ⊤} := by
    ext ω
    change Summable (fun i => (ω i) ^ 2 * w i) ↔ (∑' i, ENNReal.ofReal ((ω i) ^ 2 * w i)) ≠ ⊤
    exact (tsum_ofReal_ne_top_iff_summable (fun i => mul_nonneg (sq_nonneg (ω i)) (hw0 i))).symm
  rw [hEq]
  have hmeas : Measurable (fun ω : GaussianSeq ι => ∑' i, ENNReal.ofReal ((ω i) ^ 2 * w i)) :=
    Measurable.tsum (fun i => measurable_ofReal_sq_mul w i)
  exact hmeas (measurableSet_singleton ⊤).compl

theorem ae_summable_sq_mul_weight [Countable ι] (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i)
    (hw : Summable w) :
    ∀ᵐ ω ∂iidGaussianMeasure ι, Summable (fun i => (ω i) ^ 2 * w i) := by
  have hlint :
      ∫⁻ ω, (∑' i, ENNReal.ofReal ((ω i) ^ 2 * w i)) ∂iidGaussianMeasure ι < ⊤ := by
    rw [lintegral_tsum (fun i => (measurable_ofReal_sq_mul w i).aemeasurable)]
    have hterm : ∀ i : ι,
        ∫⁻ ω, ENNReal.ofReal ((ω i) ^ 2 * w i) ∂iidGaussianMeasure ι = ENNReal.ofReal (w i) := by
      intro i
      have hmp := measurePreserving_eval_infinitePi
        (fun _ : ι => ProbabilityTheory.gaussianReal 0 1) i
      have hmeas_f : Measurable (fun x : ℝ => ENNReal.ofReal (x ^ 2 * w i)) :=
        ENNReal.measurable_ofReal.comp ((measurable_id.pow_const 2).mul_const (w i))
      calc ∫⁻ ω, ENNReal.ofReal ((ω i) ^ 2 * w i) ∂iidGaussianMeasure ι
          = ∫⁻ ω, (fun x : ℝ => ENNReal.ofReal (x ^ 2 * w i)) (Function.eval i ω)
              ∂(Measure.infinitePi fun _ : ι => ProbabilityTheory.gaussianReal 0 1) := rfl
        _ = ∫⁻ x : ℝ, ENNReal.ofReal (x ^ 2 * w i) ∂(ProbabilityTheory.gaussianReal 0 1) :=
            hmp.lintegral_comp hmeas_f
        _ = ENNReal.ofReal (w i) := by
            simp_rw [ENNReal.ofReal_mul (sq_nonneg _)]
            have hm2 : Measurable (fun x : ℝ => ENNReal.ofReal (x ^ 2)) :=
              ENNReal.measurable_ofReal.comp (measurable_id.pow_const 2)
            rw [lintegral_mul_const _ hm2, lintegral_ofReal_sq_gaussianReal_zero_one, one_mul]
    simp_rw [hterm]
    rw [← ENNReal.ofReal_tsum_of_nonneg hw0 hw]
    exact ENNReal.ofReal_lt_top
  have hmeas : Measurable (fun ω : GaussianSeq ι => ∑' i, ENNReal.ofReal ((ω i) ^ 2 * w i)) :=
    Measurable.tsum (fun i => measurable_ofReal_sq_mul w i)
  filter_upwards [ae_lt_top hmeas hlint.ne] with ω hω
  exact (tsum_ofReal_ne_top_iff_summable
    (fun i => mul_nonneg (sq_nonneg (ω i)) (hw0 i))).mp hω.ne

theorem ae_mem_goodSet [Countable ι] (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) :
    ∀ᵐ ω ∂iidGaussianMeasure ι, ω ∈ goodSet w :=
  ae_summable_sq_mul_weight w hw0 hw

lemma summable_sq_eval (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i)
    (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f : 𝓢(E, ℝ)) :
    Summable (fun i => (L i f) ^ 2) := by
  let p := (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f
  have hp : 0 ≤ p := apply_nonneg _ f
  have hW : ∀ i, w i ≤ ∑' j, w j := fun i => hw.le_tsum i (fun j _ => hw0 j)
  refine Summable.of_nonneg_of_le (fun i => sq_nonneg _) (fun i => ?_)
    (hw.mul_left ((∑' j, w j) * p ^ 2))
  have h1 : (L i f) ^ 2 ≤ (w i * p) ^ 2 := by
    have := hL i f
    nlinarith [sq_abs (L i f), abs_nonneg (L i f), mul_nonneg (hw0 i) hp]
  have h2 : (w i) ^ 2 ≤ (∑' j, w j) * w i := by
    nlinarith [hW i, hw0 i]
  calc (L i f) ^ 2 ≤ (w i) ^ 2 * p ^ 2 := by nlinarith
    _ ≤ ((∑' j, w j) * w i) * p ^ 2 :=
      mul_le_mul_of_nonneg_right h2 (sq_nonneg p)
    _ = ((∑' j, w j) * p ^ 2) * w i := by ring

lemma summable_mul_eval (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i)
    (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f g : 𝓢(E, ℝ)) :
    Summable (fun i => L i f * L i g) := by
  refine Summable.of_norm_bounded
    (((summable_sq_eval L w hw0 hw s hL f).add (summable_sq_eval L w hw0 hw s hL g)).div_const 2)
    fun i => ?_
  rw [Real.norm_eq_abs, abs_mul]
  nlinarith [sq_nonneg (|L i f| - |L i g|), sq_abs (L i f), sq_abs (L i g)]

lemma summable_gaussianSeries_of_mem (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    {ω : GaussianSeq ι} (hω : ω ∈ goodSet w) (f : 𝓢(E, ℝ)) :
    Summable (fun i => ω i * L i f) := by
  let p := (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f
  have hp : 0 ≤ p := apply_nonneg _ f
  have hbound : Summable (fun i => (((ω i) ^ 2 * w i + w i) / 2) * p) :=
    ((hω.add hw).div_const 2).mul_right p
  refine Summable.of_norm_bounded hbound fun i => ?_
  rw [Real.norm_eq_abs, abs_mul]
  have habs : |ω i| ≤ ((ω i) ^ 2 + 1) / 2 := by
    nlinarith [sq_nonneg (|ω i| - 1), sq_abs (ω i)]
  have h1 : |ω i| * |L i f| ≤ |ω i| * (w i * p) :=
    mul_le_mul_of_nonneg_left (hL i f) (abs_nonneg _)
  have h2 : |ω i| * w i ≤ ((ω i) ^ 2 * w i + w i) / 2 := by
    have := mul_le_mul_of_nonneg_right habs (hw0 i)
    linarith
  calc |ω i| * |L i f| ≤ |ω i| * (w i * p) := h1
    _ = (|ω i| * w i) * p := by ring
    _ ≤ (((ω i) ^ 2 * w i + w i) / 2) * p := mul_le_mul_of_nonneg_right h2 hp

/-- Pointwise Gaussian random field `ω ↦ (f ↦ ∑' i, ω i * L i f)` valued in
`RealTemperedDistribution E`, set to `0` off the full-measure convergence set `goodSet w`. -/
noncomputable def gaussianSeriesField (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (ω : GaussianSeq ι) : RealTemperedDistribution E := by
  classical
  by_cases hω : ω ∈ goodSet w
  · refine SchwartzMap.mkCLMtoNormedSpace (fun f => ∑' i, ω i * L i f)
      (fun f g => ?_) (fun a f => ?_) ?_
    · simp_rw [map_add, mul_add]
      exact (summable_gaussianSeries_of_mem L w hw0 hw s hL hω f).tsum_add
        (summable_gaussianSeries_of_mem L w hw0 hw s hL hω g)
    · simp_rw [map_smul, smul_eq_mul, RingHom.id_apply]
      have : (fun i => ω i * (a * L i f)) = (fun i => a * (ω i * L i f)) := by
        ext i; ring
      rw [this, tsum_mul_left]
    · refine ⟨s, ∑' i, ((ω i) ^ 2 * w i + w i) / 2, ?_, fun f => ?_⟩
      · exact tsum_nonneg fun i =>
          div_nonneg (add_nonneg (mul_nonneg (sq_nonneg _) (hw0 i)) (hw0 i)) (by norm_num)
      · let p := s.sup (schwartzSeminormFamily ℝ E ℝ) f
        have hp : 0 ≤ p := apply_nonneg _ f
        have hdom : Summable (fun i => (((ω i) ^ 2 * w i + w i) / 2) * p) :=
          ((hω.add hw).div_const 2).mul_right p
        have hpt : ∀ i, ‖ω i * L i f‖ ≤ (((ω i) ^ 2 * w i + w i) / 2) * p := by
          intro i
          rw [Real.norm_eq_abs, abs_mul]
          have habs : |ω i| ≤ ((ω i) ^ 2 + 1) / 2 := by
            nlinarith [sq_nonneg (|ω i| - 1), sq_abs (ω i)]
          have h2 : |ω i| * w i ≤ ((ω i) ^ 2 * w i + w i) / 2 := by
            have := mul_le_mul_of_nonneg_right habs (hw0 i)
            linarith
          have hLi : |L i f| ≤ w i * p := hL i f
          calc |ω i| * |L i f| ≤ |ω i| * (w i * p) :=
                mul_le_mul_of_nonneg_left hLi (abs_nonneg _)
            _ = (|ω i| * w i) * p := by ring
            _ ≤ (((ω i) ^ 2 * w i + w i) / 2) * p := mul_le_mul_of_nonneg_right h2 hp
        calc ‖∑' i, ω i * L i f‖
            ≤ ∑' i, ‖ω i * L i f‖ :=
              norm_tsum_le_tsum_norm (summable_gaussianSeries_of_mem L w hw0 hw s hL hω f).norm
          _ ≤ ∑' i, (((ω i) ^ 2 * w i + w i) / 2) * p :=
              (summable_gaussianSeries_of_mem L w hw0 hw s hL hω f).norm.tsum_le_tsum hpt hdom
          _ = (∑' i, ((ω i) ^ 2 * w i + w i) / 2) * p := tsum_mul_right
  · exact 0

theorem gaussianSeriesField_apply_of_mem (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    {ω : GaussianSeq ι} (hω : ω ∈ goodSet w) (f : 𝓢(E, ℝ)) :
    gaussianSeriesField L w hw0 hw s hL ω f = ∑' i, ω i * L i f := by
  classical
  simp [gaussianSeriesField, hω, SchwartzMap.mkCLMtoNormedSpace]

theorem gaussianSeriesField_apply_of_not_mem (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    {ω : GaussianSeq ι} (hω : ω ∉ goodSet w) (f : 𝓢(E, ℝ)) :
    gaussianSeriesField L w hw0 hw s hL ω f = 0 := by
  classical
  simp [gaussianSeriesField, hω]

private lemma exists_finset_exhaustion [Countable ι] :
    ∃ F : ℕ → Finset ι, F 0 = ∅ ∧ Monotone F ∧ ∀ i : ι, ∃ n, i ∈ F n := by
  classical
  let _ : Encodable ι := Encodable.ofCountable ι
  refine ⟨fun n => (Finset.range n).biUnion fun k =>
      (Encodable.decode (α := ι) k).toFinset, by simp, ?_, ?_⟩
  · intro m n hmn i hi
    simp only [Finset.mem_biUnion, Finset.mem_range, Option.mem_toFinset] at hi ⊢
    rcases hi with ⟨k, hk, hdec⟩
    exact ⟨k, lt_of_lt_of_le hk hmn, hdec⟩
  · intro i
    refine ⟨Encodable.encode i + 1, ?_⟩
    simp only [Finset.mem_biUnion, Finset.mem_range, Option.mem_toFinset]
    exact ⟨Encodable.encode i, Nat.lt_succ_self _, Encodable.encodek i⟩

private lemma tendsto_finset_exhaustion {F : ℕ → Finset ι} (hmono : Monotone F)
    (hexh : ∀ i : ι, ∃ n, i ∈ F n) :
    Tendsto F atTop atTop := by
  rw [Filter.tendsto_atTop_atTop]
  intro s
  classical
  have h : ∀ i ∈ s, ∃ n, i ∈ F n := fun i _ => hexh i
  choose f hf using h
  refine ⟨s.attach.sup (fun x => f x.1 x.2), fun n hn i hi => ?_⟩
  have hle : f i hi ≤ n :=
    le_trans (Finset.le_sup (f := fun x : {x // x ∈ s} => f x.1 x.2) (Finset.mem_attach s ⟨i, hi⟩)) hn
  exact hmono hle (hf i hi)

theorem measurable_gaussianSeriesField [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f) :
    Measurable[inferInstance, cylMeasurableSpace E] (gaussianSeriesField L w hw0 hw s hL) := by
  rw [measurable_to_cyl_iff]
  intro f
  obtain ⟨F, -, hmono, hexh⟩ := exists_finset_exhaustion (ι := ι)
  have htendF : Tendsto F atTop atTop := tendsto_finset_exhaustion hmono hexh
  have hmeas_n : ∀ n : ℕ, Measurable
      (Set.indicator (goodSet w) (fun ω : GaussianSeq ι => ∑ i ∈ F n, ω i * L i f)) := by
    intro n
    refine Measurable.indicator ?_ (measurableSet_goodSet w hw0)
    exact Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).mul_const _
  refine measurable_of_tendsto_metrizable hmeas_n (tendsto_pi_nhds.mpr fun ω => ?_)
  by_cases hω : ω ∈ goodSet w
  · simp only [Set.indicator_of_mem hω, gaussianSeriesField_apply_of_mem L w hw0 hw s hL hω]
    exact (summable_gaussianSeries_of_mem L w hw0 hw s hL hω f).hasSum.comp htendF
  · simp only [Set.indicator_of_notMem hω,
      gaussianSeriesField_apply_of_not_mem L w hw0 hw s hL hω]
    exact tendsto_const_nhds

/-- The Gaussian probability measure on `(RealTemperedDistribution E, cylMeasurableSpace E)`
constructed as the pushforward of `iidGaussianMeasure ι` along `gaussianSeriesField`. -/
noncomputable def gaussianSeriesMeasure [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f) :
    @Measure (RealTemperedDistribution E) (cylMeasurableSpace E) :=
  letI := cylMeasurableSpace E
  (iidGaussianMeasure ι).map (gaussianSeriesField L w hw0 hw s hL)

instance instIsProbabilityMeasureGaussianSeriesMeasure [Countable ι]
    (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w)
    (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f) :
    @IsProbabilityMeasure (RealTemperedDistribution E) (cylMeasurableSpace E)
      (gaussianSeriesMeasure L w hw0 hw s hL) := by
  let _ := cylMeasurableSpace E
  unfold gaussianSeriesMeasure
  exact (Measure.isProbabilityMeasure_map_iff
    (measurable_gaussianSeriesField L w hw0 hw s hL).aemeasurable).mpr inferInstance

private lemma integral_finset_exp_iidGaussian (F : Finset ι) (c : ι → ℝ) :
    ∫ ω : GaussianSeq ι, Complex.exp (Complex.I * ((∑ i ∈ F, ω i * c i : ℝ) : ℂ))
        ∂iidGaussianMeasure ι =
      Complex.exp (-(1 / 2 : ℂ) * ((∑ i ∈ F, (c i) ^ 2 : ℝ) : ℂ)) := by
  have hmap : (iidGaussianMeasure ι).map F.restrict =
      Measure.pi (fun _ : F => ProbabilityTheory.gaussianReal 0 1) :=
    Measure.infinitePi_map_restrict (fun _ : ι => ProbabilityTheory.gaussianReal 0 1)
  have h1 :
      ∫ ω : GaussianSeq ι, Complex.exp (Complex.I * ((∑ i ∈ F, ω i * c i : ℝ) : ℂ))
          ∂iidGaussianMeasure ι =
        ∫ x : F → ℝ, Complex.exp (Complex.I * ((∑ i : F, x i * c i.1 : ℝ) : ℂ))
          ∂(Measure.pi fun _ : F => ProbabilityTheory.gaussianReal 0 1) := by
    rw [← hmap, integral_map (Finset.measurable_restrict F).aemeasurable]
    · congr 1
      ext ω
      congr 2
      exact_mod_cast (Finset.sum_attach F (fun i => ω i * c i)).symm
    · exact (Complex.continuous_exp.comp (continuous_const.mul
        (Complex.continuous_ofReal.comp
          (continuous_finsetSum _ fun i _ => (continuous_apply i).mul continuous_const)))).aestronglyMeasurable
  rw [h1]
  have hprod :
      (fun x : F → ℝ => Complex.exp (Complex.I * ((∑ i : F, x i * c i.1 : ℝ) : ℂ))) =
        (fun x : F → ℝ => ∏ i : F, Complex.exp (Complex.I * ((x i * c i.1 : ℝ) : ℂ))) := by
    ext x
    rw [← Complex.exp_sum, Complex.ofReal_sum, Finset.mul_sum]
  rw [hprod]
  rw [integral_fintype_prod_eq_prod
    (f := fun (i : F) (x : ℝ) => Complex.exp (Complex.I * ((x * c i.1 : ℝ) : ℂ)))]
  have hfac : ∀ i : F,
      ∫ x : ℝ, Complex.exp (Complex.I * ((x * c i.1 : ℝ) : ℂ))
          ∂(ProbabilityTheory.gaussianReal 0 1) =
        Complex.exp (-(1 / 2 : ℂ) * (((c i.1) ^ 2 : ℝ) : ℂ)) := by
    intro i
    have hc := ProbabilityTheory.charFun_gaussianReal (μ := (0 : ℝ)) (v := (1 : NNReal)) (c i.1)
    rw [MeasureTheory.charFun_apply_real] at hc
    have hEq :
        (fun x : ℝ => Complex.exp (Complex.I * ((x * c i.1 : ℝ) : ℂ))) =
          (fun x : ℝ => Complex.exp ((c i.1 : ℂ) * (x : ℂ) * Complex.I)) := by
      ext x
      congr 1
      simp only [Complex.ofReal_mul]
      ring
    rw [hEq, hc]
    congr 1
    simp only [Complex.ofReal_zero, mul_zero, NNReal.coe_one, Complex.ofReal_one,
      Complex.ofReal_pow]
    ring
  simp_rw [hfac, ← Complex.exp_sum, ← Finset.mul_sum]
  congr 2
  rw [← Complex.ofReal_sum]
  congr 1
  exact Finset.sum_attach F (fun i => (c i) ^ 2)

/-- Exact Gaussian characteristic functional of `gaussianSeriesMeasure`. -/
theorem charFun_gaussianSeriesMeasure [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f : 𝓢(E, ℝ)) :
    ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) ∂(gaussianSeriesMeasure L w hw0 hw s hL) =
      Complex.exp (-(1 / 2 : ℂ) * ((∑' i, (L i f) ^ 2 : ℝ) : ℂ)) := by
  let _ := cylMeasurableSpace E
  have hmap_eq :
      ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) ∂(gaussianSeriesMeasure L w hw0 hw s hL) =
        ∫ ω, Complex.exp (Complex.I * (gaussianSeriesField L w hw0 hw s hL ω f : ℂ))
          ∂iidGaussianMeasure ι := by
    unfold gaussianSeriesMeasure
    have hmeas_g : Measurable (fun φ : RealTemperedDistribution E =>
        Complex.exp (Complex.I * (φ f : ℂ))) :=
      (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
        (measurable_eval_cyl f)
    exact integral_map (measurable_gaussianSeriesField L w hw0 hw s hL).aemeasurable
      hmeas_g.aestronglyMeasurable
  rw [hmap_eq]
  obtain ⟨F, -, hmono, hexh⟩ := exists_finset_exhaustion (ι := ι)
  have htendF : Tendsto F atTop atTop := tendsto_finset_exhaustion hmono hexh
  have hLHS :
      Tendsto (fun n => ∫ ω : GaussianSeq ι,
          Complex.exp (Complex.I * ((∑ i ∈ F n, ω i * L i f : ℝ) : ℂ)) ∂iidGaussianMeasure ι)
        atTop
        (𝓝 (∫ ω : GaussianSeq ι,
          Complex.exp (Complex.I * (gaussianSeriesField L w hw0 hw s hL ω f : ℂ))
            ∂iidGaussianMeasure ι)) := by
    refine tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ)) ?_ (integrable_const 1) ?_ ?_
    · intro n
      exact ((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
        (Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).mul_const _)).aestronglyMeasurable
    · intro n
      refine ae_of_all _ fun ω => ?_
      rw [mul_comm, Complex.norm_exp_ofReal_mul_I]
    · filter_upwards [ae_mem_goodSet w hw0 hw] with ω hω
      rw [gaussianSeriesField_apply_of_mem L w hw0 hw s hL hω]
      exact (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).continuousAt.tendsto.comp
        ((summable_gaussianSeries_of_mem L w hw0 hw s hL hω f).hasSum.comp htendF)
  have hRHS :
      Tendsto (fun n => Complex.exp (-(1 / 2 : ℂ) * ((∑ i ∈ F n, (L i f) ^ 2 : ℝ) : ℂ)))
        atTop
        (𝓝 (Complex.exp (-(1 / 2 : ℂ) * ((∑' i, (L i f) ^ 2 : ℝ) : ℂ)))) :=
    (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).continuousAt.tendsto.comp
      ((summable_sq_eval L w hw0 hw s hL f).hasSum.comp htendF)
  have hEq : (fun n => ∫ ω : GaussianSeq ι,
        Complex.exp (Complex.I * ((∑ i ∈ F n, ω i * L i f : ℝ) : ℂ)) ∂iidGaussianMeasure ι) =
      (fun n => Complex.exp (-(1 / 2 : ℂ) * ((∑ i ∈ F n, (L i f) ^ 2 : ℝ) : ℂ))) := by
    ext n
    exact integral_finset_exp_iidGaussian (F n) (fun i => L i f)
  rw [hEq] at hLHS
  exact tendsto_nhds_unique hLHS hRHS

private lemma integral_eval_mul_eval_iidGaussian [DecidableEq ι] (i j : ι) :
    ∫ ω : GaussianSeq ι, ω i * ω j ∂iidGaussianMeasure ι = if i = j then 1 else 0 := by
  by_cases hij : i = j
  · subst hij
    simp only [↓reduceIte, ← sq]
    have hmp := measurePreserving_eval_infinitePi
      (fun _ : ι => ProbabilityTheory.gaussianReal 0 1) i
    have h : ∫ x : ℝ, x ^ 2 ∂((Measure.infinitePi fun _ : ι =>
        ProbabilityTheory.gaussianReal 0 1).map (Function.eval i)) =
        ∫ ω : ι → ℝ, (Function.eval i ω) ^ 2 ∂(Measure.infinitePi fun _ : ι =>
          ProbabilityTheory.gaussianReal 0 1) :=
      integral_map hmp.measurable.aemeasurable
        (continuous_pow 2 : Continuous fun x : ℝ => x ^ 2).aestronglyMeasurable
    rw [hmp.map_eq] at h
    exact h.symm.trans integral_sq_gaussianReal_zero_one
  · simp only [hij, ↓reduceIte]
    let F : Finset ι := {i, j}
    have hmap : (iidGaussianMeasure ι).map F.restrict =
        Measure.pi (fun _ : F => ProbabilityTheory.gaussianReal 0 1) :=
      Measure.infinitePi_map_restrict (fun _ : ι => ProbabilityTheory.gaussianReal 0 1)
    let i' : F := ⟨i, Finset.mem_insert_self i {j}⟩
    let j' : F := ⟨j, Finset.mem_insert_of_mem (Finset.mem_singleton_self j)⟩
    have hne : i' ≠ j' := fun h => hij (congrArg Subtype.val h)
    have hEq :
        ∫ ω : GaussianSeq ι, ω i * ω j ∂iidGaussianMeasure ι =
          ∫ x : F → ℝ, (∏ k : F, x k) ∂(Measure.pi fun _ : F => ProbabilityTheory.gaussianReal 0 1) := by
      rw [← hmap, integral_map (Finset.measurable_restrict F).aemeasurable]
      · congr 1
        ext ω
        have hF : (Finset.univ : Finset F) = {i', j'} := by
          ext ⟨k, hk⟩
          simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, true_iff]
          rcases (by simpa [F] using hk : k = i ∨ k = j) with rfl | rfl
          · left; rfl
          · right; rfl
        rw [hF, Finset.prod_pair hne]
        rfl
      · exact (continuous_finsetProd _ fun k _ => continuous_apply k).aestronglyMeasurable
    rw [hEq, integral_fintype_prod_eq_prod (f := fun (_ : F) (x : ℝ) => x)]
    simp [ProbabilityTheory.integral_id_gaussianReal, F]

private lemma integrable_eval_mul_eval_iidGaussian (i j : ι) :
    Integrable (fun ω : GaussianSeq ι => ω i * ω j) (iidGaussianMeasure ι) := by
  have hi : MemLp (fun ω : GaussianSeq ι => ω i) 2 (iidGaussianMeasure ι) := by
    have hmp := measurePreserving_eval_infinitePi
      (fun _ : ι => ProbabilityTheory.gaussianReal 0 1) i
    exact (ProbabilityTheory.memLp_id_gaussianReal (μ := (0 : ℝ)) (v := (1 : NNReal)) 2).comp_measurePreserving hmp
  have hj : MemLp (fun ω : GaussianSeq ι => ω j) 2 (iidGaussianMeasure ι) := by
    have hmp := measurePreserving_eval_infinitePi
      (fun _ : ι => ProbabilityTheory.gaussianReal 0 1) j
    exact (ProbabilityTheory.memLp_id_gaussianReal (μ := (0 : ℝ)) (v := (1 : NNReal)) 2).comp_measurePreserving hmp
  exact hi.integrable_mul hj

private lemma integral_finset_mul_finset_iidGaussian (F : Finset ι) (a b : ι → ℝ) :
    ∫ ω : GaussianSeq ι, (∑ i ∈ F, ω i * a i) * (∑ j ∈ F, ω j * b j) ∂iidGaussianMeasure ι =
      ∑ i ∈ F, a i * b i := by
  classical
  have hexpand :
      (fun ω : GaussianSeq ι => (∑ i ∈ F, ω i * a i) * (∑ j ∈ F, ω j * b j)) =
        fun ω => ∑ i ∈ F, ∑ j ∈ F, (a i * b j) * (ω i * ω j) := by
    ext ω
    rw [Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    ring
  rw [hexpand, integral_finsetSum]
  · refine Finset.sum_congr rfl fun i hi => ?_
    rw [integral_finsetSum _ fun j _ => (integrable_eval_mul_eval_iidGaussian i j).const_mul _]
    simp_rw [integral_const_mul, integral_eval_mul_eval_iidGaussian]
    simp [hi]
  · intro i _
    exact integrable_finsetSum _ fun j _ => (integrable_eval_mul_eval_iidGaussian i j).const_mul _

private lemma lintegral_sq_sub_finset_le [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f : 𝓢(E, ℝ)) {F : ℕ → Finset ι} (hmono : Monotone F) (hexh : ∀ i, ∃ n, i ∈ F n) (n : ℕ) :
    ∫⁻ ω : GaussianSeq ι,
        ENNReal.ofReal ((gaussianSeriesField L w hw0 hw s hL ω f - ∑ i ∈ F n, ω i * L i f) ^ 2)
        ∂iidGaussianMeasure ι ≤
      ENNReal.ofReal ((∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) := by
  classical
  have htendF : Tendsto F atTop atTop := tendsto_finset_exhaustion hmono hexh
  let g : ℕ → GaussianSeq ι → ENNReal := fun m ω =>
    ENNReal.ofReal (((∑ i ∈ F (m + n), ω i * L i f) - ∑ i ∈ F n, ω i * L i f) ^ 2)
  have hg_meas : ∀ m, AEMeasurable (g m) (iidGaussianMeasure ι) := fun m =>
    (ENNReal.measurable_ofReal.comp
      (((Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).mul_const _).sub
        (Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).mul_const _)).pow_const 2)).aemeasurable
  have hae : ∀ᵐ ω ∂iidGaussianMeasure ι,
      ENNReal.ofReal ((gaussianSeriesField L w hw0 hw s hL ω f - ∑ i ∈ F n, ω i * L i f) ^ 2) =
        liminf (fun m => g m ω) atTop := by
    filter_upwards [ae_mem_goodSet w hw0 hw] with ω hω
    rw [gaussianSeriesField_apply_of_mem L w hw0 hw s hL hω]
    have ht1 : Tendsto (fun m => ∑ i ∈ F (m + n), ω i * L i f) atTop (𝓝 (∑' i, ω i * L i f)) :=
      ((summable_gaussianSeries_of_mem L w hw0 hw s hL hω f).hasSum.comp htendF).comp
        (tendsto_add_atTop_nat n)
    have ht2 : Tendsto (fun m => g m ω) atTop
        (𝓝 (ENNReal.ofReal (((∑' i, ω i * L i f) - ∑ i ∈ F n, ω i * L i f) ^ 2))) :=
      (ENNReal.continuous_ofReal.comp ((continuous_id.sub continuous_const).pow 2)).continuousAt.tendsto.comp ht1
    exact ht2.liminf_eq.symm
  rw [lintegral_congr_ae hae]
  refine (lintegral_liminf_le' hg_meas).trans ?_
  have hterm : ∀ m, ∫⁻ ω, g m ω ∂iidGaussianMeasure ι ≤
      ENNReal.ofReal ((∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) := by
    intro m
    have hsub : F n ⊆ F (m + n) := hmono (Nat.le_add_left n m)
    have hdiff : ∀ ω : GaussianSeq ι,
        (∑ i ∈ F (m + n), ω i * L i f) - ∑ i ∈ F n, ω i * L i f =
          ∑ i ∈ F (m + n) \ F n, ω i * L i f := fun ω =>
      (Finset.sum_sdiff_eq_sub hsub).symm
    have hint : Integrable (fun ω : GaussianSeq ι =>
        ((∑ i ∈ F (m + n), ω i * L i f) - ∑ i ∈ F n, ω i * L i f) ^ 2) (iidGaussianMeasure ι) := by
      simp_rw [hdiff, sq]
      have hexp :
          (fun ω : GaussianSeq ι =>
              (∑ i ∈ F (m + n) \ F n, ω i * L i f) * (∑ j ∈ F (m + n) \ F n, ω j * L j f)) =
            fun ω => ∑ i ∈ F (m + n) \ F n, ∑ j ∈ F (m + n) \ F n,
              (L i f * L j f) * (ω i * ω j) := by
        ext ω
        rw [Finset.sum_mul_sum]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        ring
      rw [hexp]
      exact integrable_finsetSum _ fun i _ =>
        integrable_finsetSum _ fun j _ => (integrable_eval_mul_eval_iidGaussian i j).const_mul _
    rw [← ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ fun _ => sq_nonneg _)]
    simp_rw [hdiff, sq]
    rw [integral_finset_mul_finset_iidGaussian (F (m + n) \ F n) (fun i => L i f) (fun i => L i f)]
    simp_rw [← sq]
    rw [Finset.sum_sdiff_eq_sub hsub]
    refine ENNReal.ofReal_le_ofReal ?_
    exact sub_le_sub_right
      ((summable_sq_eval L w hw0 hw s hL f).sum_le_tsum (F (m + n)) (fun _ _ => sq_nonneg _)) _
  exact liminf_le_of_frequently_le' (Eventually.of_forall hterm).frequently

/-- The real evaluation functional `φ ↦ φ f` belongs to `L²` under `gaussianSeriesMeasure`. -/
theorem memLp_eval_real_gaussianSeriesMeasure [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ))
    (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f : 𝓢(E, ℝ)) :
    MemLp (fun φ : RealTemperedDistribution E => φ f) 2 (gaussianSeriesMeasure L w hw0 hw s hL) := by
  let _ := cylMeasurableSpace E
  have hmeas_eval : Measurable (fun φ : RealTemperedDistribution E => φ f) := measurable_eval_cyl f
  rw [memLp_iff]
  unfold gaussianSeriesMeasure
  rw [eLpNorm_map_measure hmeas_eval.aestronglyMeasurable
    (measurable_gaussianSeriesField L w hw0 hw s hL).aemeasurable]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)
    (hmeas_eval.comp (measurable_gaussianSeriesField L w hw0 hw s hL)).aestronglyMeasurable]
  simp only [ENNReal.toReal_ofNat]
  obtain ⟨F, hF0, hmono, hexh⟩ := exists_finset_exhaustion (ι := ι)
  have hle := lintegral_sq_sub_finset_le L w hw0 hw s hL f hmono hexh 0
  simp only [hF0, Finset.sum_empty, sub_zero] at hle
  have hEq :
      (fun ω : GaussianSeq ι => ‖gaussianSeriesField L w hw0 hw s hL ω f‖ₑ ^ (2 : ℝ)) =
        fun ω => ENNReal.ofReal ((gaussianSeriesField L w hw0 hw s hL ω f) ^ 2) := by
    ext ω
    rw [Real.enorm_eq_ofReal_abs, ENNReal.rpow_ofNat, ← ENNReal.ofReal_pow (abs_nonneg _), sq_abs]
  change (∫⁻ ω, ‖gaussianSeriesField L w hw0 hw s hL ω f‖ₑ ^ (2 : ℝ) ∂iidGaussianMeasure ι) ^
      (1 / (2 : ℝ)) < ⊤
  rw [hEq]
  exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) (lt_of_le_of_lt hle ENNReal.ofReal_lt_top).ne

/-- The complexified evaluation functional `φ ↦ (φ f : ℂ)` belongs to `L²` under
`gaussianSeriesMeasure`. -/
theorem memLp_eval_gaussianSeriesMeasure [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ))
    (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f : 𝓢(E, ℝ)) :
    MemLp (fun φ : RealTemperedDistribution E => (φ f : ℂ)) 2
      (gaussianSeriesMeasure L w hw0 hw s hL) := by
  let _ := cylMeasurableSpace E
  have hR := memLp_eval_real_gaussianSeriesMeasure L w hw0 hw s hL f
  rw [memLp_iff]
  have hEq : eLpNorm (fun φ : RealTemperedDistribution E => (φ f : ℂ)) 2
      (gaussianSeriesMeasure L w hw0 hw s hL) =
      eLpNorm (fun φ : RealTemperedDistribution E => φ f) 2
      (gaussianSeriesMeasure L w hw0 hw s hL) := by
    refine eLpNorm_congr_norm_ae
      (Complex.continuous_ofReal.measurable.comp (measurable_eval_cyl f)).aestronglyMeasurable
      (measurable_eval_cyl f).aestronglyMeasurable (ae_of_all _ fun φ => ?_)
    simp
  rw [hEq]
  exact hR

private lemma integral_sq_sub_finset_le [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ)) (w : ι → ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f : 𝓢(E, ℝ)) {F : ℕ → Finset ι} (hmono : Monotone F) (hexh : ∀ i, ∃ n, i ∈ F n) (n : ℕ)
    (hint : Integrable (fun ω : GaussianSeq ι =>
      (gaussianSeriesField L w hw0 hw s hL ω f - ∑ i ∈ F n, ω i * L i f) ^ 2)
      (iidGaussianMeasure ι)) :
    ∫ ω : GaussianSeq ι,
        (gaussianSeriesField L w hw0 hw s hL ω f - ∑ i ∈ F n, ω i * L i f) ^ 2
        ∂iidGaussianMeasure ι ≤
      (∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2 := by
  have hle := lintegral_sq_sub_finset_le L w hw0 hw s hL f hmono hexh n
  rw [← ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ fun _ => sq_nonneg _)] at hle
  have hnonneg : 0 ≤ (∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2 :=
    sub_nonneg.mpr ((summable_sq_eval L w hw0 hw s hL f).sum_le_tsum (F n) fun _ _ => sq_nonneg _)
  exact (ENNReal.ofReal_le_ofReal_iff hnonneg).mp hle

private lemma abs_mul_le_amgm {a b δ : ℝ} (hδ : 0 < δ) :
    |a * b| ≤ (δ⁻¹ * a ^ 2 + δ * b ^ 2) / 2 := by
  have h1 : 0 ≤ (|a| - δ * |b|) ^ 2 := sq_nonneg _
  have h2 : 2 * δ * |a * b| ≤ a ^ 2 + δ ^ 2 * b ^ 2 := by
    rw [abs_mul]
    nlinarith [sq_abs a, sq_abs b]
  have h3 : |a * b| ≤ (a ^ 2 + δ ^ 2 * b ^ 2) / (2 * δ) :=
    (le_div_iff₀ (by positivity)).mpr (by linarith)
  have h4 : (a ^ 2 + δ ^ 2 * b ^ 2) / (2 * δ) = (δ⁻¹ * a ^ 2 + δ * b ^ 2) / 2 := by
    field_simp [hδ.ne']
  linarith

/-- Exact two-point covariance identity for `gaussianSeriesMeasure`. -/
theorem integral_mul_gaussianSeriesMeasure [Countable ι] (L : ι → (𝓢(E, ℝ) →L[ℝ] ℝ))
    (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) (hw : Summable w) (s : Finset (ℕ × ℕ))
    (hL : ∀ i f, |L i f| ≤ w i * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f)
    (f g : 𝓢(E, ℝ)) :
    ∫ φ, φ f * φ g ∂(gaussianSeriesMeasure L w hw0 hw s hL) = ∑' i, L i f * L i g := by
  let _ := cylMeasurableSpace E
  have hmap_eq :
      ∫ φ, φ f * φ g ∂(gaussianSeriesMeasure L w hw0 hw s hL) =
        ∫ ω, gaussianSeriesField L w hw0 hw s hL ω f * gaussianSeriesField L w hw0 hw s hL ω g
          ∂iidGaussianMeasure ι := by
    unfold gaussianSeriesMeasure
    exact integral_map (measurable_gaussianSeriesField L w hw0 hw s hL).aemeasurable
      ((measurable_eval_cyl f).mul (measurable_eval_cyl g)).aestronglyMeasurable
  rw [hmap_eq]
  obtain ⟨F, hF0, hmono, hexh⟩ := exists_finset_exhaustion (ι := ι)
  have htendF : Tendsto F atTop atTop := tendsto_finset_exhaustion hmono hexh
  have hmp : MeasurePreserving (gaussianSeriesField L w hw0 hw s hL) (iidGaussianMeasure ι)
      (gaussianSeriesMeasure L w hw0 hw s hL) :=
    ⟨measurable_gaussianSeriesField L w hw0 hw s hL, rfl⟩
  let X : GaussianSeq ι → ℝ := fun ω => gaussianSeriesField L w hw0 hw s hL ω f
  let Y : GaussianSeq ι → ℝ := fun ω => gaussianSeriesField L w hw0 hw s hL ω g
  let Xn : ℕ → GaussianSeq ι → ℝ := fun n ω => ∑ i ∈ F n, ω i * L i f
  let Yn : ℕ → GaussianSeq ι → ℝ := fun n ω => ∑ i ∈ F n, ω i * L i g
  have hMemX : MemLp X 2 (iidGaussianMeasure ι) :=
    (memLp_eval_real_gaussianSeriesMeasure L w hw0 hw s hL f).comp_measurePreserving hmp
  have hMemY : MemLp Y 2 (iidGaussianMeasure ι) :=
    (memLp_eval_real_gaussianSeriesMeasure L w hw0 hw s hL g).comp_measurePreserving hmp
  have hMemFin : ∀ (h : 𝓢(E, ℝ)) (n : ℕ),
      MemLp (fun ω : GaussianSeq ι => ∑ i ∈ F n, ω i * L i h) 2 (iidGaussianMeasure ι) := by
    intro h n
    refine memLp_finsetSum _ fun i _ => ?_
    have hi : MemLp (fun ω : GaussianSeq ι => ω i) 2 (iidGaussianMeasure ι) := by
      have hmp_i := measurePreserving_eval_infinitePi
        (fun _ : ι => ProbabilityTheory.gaussianReal 0 1) i
      exact (ProbabilityTheory.memLp_id_gaussianReal (μ := (0 : ℝ)) (v := (1 : NNReal)) 2).comp_measurePreserving hmp_i
    simpa [mul_comm] using hi.const_mul (L i h)
  have hY2_le : ∫ ω, (Y ω) ^ 2 ∂iidGaussianMeasure ι ≤ ∑' i, (L i g) ^ 2 := by
    have h0 := integral_sq_sub_finset_le L w hw0 hw s hL g hmono hexh 0
      (by simpa [hF0] using hMemY.integrable_sq)
    simpa [hF0] using h0
  have htend_mul : Tendsto (fun n => ∑ i ∈ F n, L i f * L i g) atTop
      (𝓝 (∫ ω, X ω * Y ω ∂iidGaussianMeasure ι)) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    let M : ℝ := (∑' i, (L i f) ^ 2) + (∑' i, (L i g) ^ 2) + 1
    have hM_pos : 0 < M := by
      have h1 : 0 ≤ ∑' i, (L i f) ^ 2 := tsum_nonneg fun _ => sq_nonneg _
      have h2 : 0 ≤ ∑' i, (L i g) ^ 2 := tsum_nonneg fun _ => sq_nonneg _
      linarith
    let δ : ℝ := ε / (2 * M)
    have hδ_pos : 0 < δ := by positivity
    have hremF : Tendsto (fun n => (∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) atTop (𝓝 0) := by
      have ht := (tendsto_const_nhds (x := ∑' i, (L i f) ^ 2)).sub
        ((summable_sq_eval L w hw0 hw s hL f).hasSum.comp htendF)
      simpa [sub_self] using ht
    have hremG : Tendsto (fun n => (∑' i, (L i g) ^ 2) - ∑ i ∈ F n, (L i g) ^ 2) atTop (𝓝 0) := by
      have ht := (tendsto_const_nhds (x := ∑' i, (L i g) ^ 2)).sub
        ((summable_sq_eval L w hw0 hw s hL g).hasSum.comp htendF)
      simpa [sub_self] using ht
    have hrem : Tendsto (fun n =>
        ((∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) +
          ((∑' i, (L i g) ^ 2) - ∑ i ∈ F n, (L i g) ^ 2)) atTop (𝓝 0) := by
      simpa using hremF.add hremG
    rw [Metric.tendsto_atTop] at hrem
    obtain ⟨N, hN⟩ := hrem (δ * ε / 2) (by positivity)
    refine ⟨N, fun n hn => ?_⟩
    rw [Real.dist_eq, abs_sub_comm]
    have hXnYn : ∑ i ∈ F n, L i f * L i g = ∫ ω, Xn n ω * Yn n ω ∂iidGaussianMeasure ι :=
      (integral_finset_mul_finset_iidGaussian (F n) (fun i => L i f) (fun i => L i g)).symm
    have hXn2 : ∫ ω, (Xn n ω) ^ 2 ∂iidGaussianMeasure ι ≤ ∑' i, (L i f) ^ 2 := by
      have heq : ∫ ω, (Xn n ω) ^ 2 ∂iidGaussianMeasure ι = ∑ i ∈ F n, (L i f) ^ 2 := by
        simpa [sq] using
          integral_finset_mul_finset_iidGaussian (F n) (fun i => L i f) (fun i => L i f)
      rw [heq]
      exact (summable_sq_eval L w hw0 hw s hL f).sum_le_tsum (F n) fun _ _ => sq_nonneg _
    have hIntXY : Integrable (fun ω => X ω * Y ω) (iidGaussianMeasure ι) := hMemX.integrable_mul hMemY
    have hIntXnYn : Integrable (fun ω => Xn n ω * Yn n ω) (iidGaussianMeasure ι) :=
      (hMemFin f n).integrable_mul (hMemFin g n)
    have hIntDiffX : Integrable (fun ω => (X ω - Xn n ω) ^ 2) (iidGaussianMeasure ι) :=
      (hMemX.sub (hMemFin f n)).integrable_sq
    have hIntDiffY : Integrable (fun ω => (Y ω - Yn n ω) ^ 2) (iidGaussianMeasure ι) :=
      (hMemY.sub (hMemFin g n)).integrable_sq
    have hIntY2 : Integrable (fun ω => (Y ω) ^ 2) (iidGaussianMeasure ι) := hMemY.integrable_sq
    have hIntXn2 : Integrable (fun ω => (Xn n ω) ^ 2) (iidGaussianMeasure ι) :=
      (hMemFin f n).integrable_sq
    have hpt_bd : ∀ ω : GaussianSeq ι,
        ‖X ω * Y ω - Xn n ω * Yn n ω‖ ≤
          (δ⁻¹ / 2) * (X ω - Xn n ω) ^ 2 + (δ / 2) * (Y ω) ^ 2 +
            ((δ / 2) * (Xn n ω) ^ 2 + (δ⁻¹ / 2) * (Y ω - Yn n ω) ^ 2) := by
      intro ω
      rw [Real.norm_eq_abs,
        show X ω * Y ω - Xn n ω * Yn n ω = (X ω - Xn n ω) * Y ω + Xn n ω * (Y ω - Yn n ω) by ring]
      have h1 := abs_mul_le_amgm (a := X ω - Xn n ω) (b := Y ω) hδ_pos
      have h2 := abs_mul_le_amgm (a := Y ω - Yn n ω) (b := Xn n ω) hδ_pos
      rw [mul_comm (Y ω - Yn n ω) (Xn n ω)] at h2
      have htri := abs_add_le ((X ω - Xn n ω) * Y ω) (Xn n ω * (Y ω - Yn n ω))
      linarith
    have hIntRhs : Integrable (fun ω =>
        (δ⁻¹ / 2) * (X ω - Xn n ω) ^ 2 + (δ / 2) * (Y ω) ^ 2 +
          ((δ / 2) * (Xn n ω) ^ 2 + (δ⁻¹ / 2) * (Y ω - Yn n ω) ^ 2)) (iidGaussianMeasure ι) :=
      ((hIntDiffX.const_mul _).add (hIntY2.const_mul _)).add
        ((hIntXn2.const_mul _).add (hIntDiffY.const_mul _))
    have hle1 : |∫ ω, X ω * Y ω ∂iidGaussianMeasure ι - ∑ i ∈ F n, L i f * L i g| ≤
        ∫ ω, ((δ⁻¹ / 2) * (X ω - Xn n ω) ^ 2 + (δ / 2) * (Y ω) ^ 2 +
          ((δ / 2) * (Xn n ω) ^ 2 + (δ⁻¹ / 2) * (Y ω - Yn n ω) ^ 2)) ∂iidGaussianMeasure ι := by
      rw [hXnYn, ← integral_sub hIntXY hIntXnYn, ← Real.norm_eq_abs]
      exact (norm_integral_le_integral_norm _).trans
        (integral_mono (hIntXY.sub hIntXnYn).norm hIntRhs hpt_bd)
    have hIntA : Integrable (fun ω => (δ⁻¹ / 2) * (X ω - Xn n ω) ^ 2 + (δ / 2) * (Y ω) ^ 2)
        (iidGaussianMeasure ι) :=
      (hIntDiffX.const_mul _).add (hIntY2.const_mul _)
    have hIntB : Integrable (fun ω => (δ / 2) * (Xn n ω) ^ 2 + (δ⁻¹ / 2) * (Y ω - Yn n ω) ^ 2)
        (iidGaussianMeasure ι) :=
      (hIntXn2.const_mul _).add (hIntDiffY.const_mul _)
    have hIntEval :
        ∫ ω, ((δ⁻¹ / 2) * (X ω - Xn n ω) ^ 2 + (δ / 2) * (Y ω) ^ 2 +
          ((δ / 2) * (Xn n ω) ^ 2 + (δ⁻¹ / 2) * (Y ω - Yn n ω) ^ 2)) ∂iidGaussianMeasure ι =
        (δ⁻¹ / 2) * ∫ ω, (X ω - Xn n ω) ^ 2 ∂iidGaussianMeasure ι +
          (δ / 2) * ∫ ω, (Y ω) ^ 2 ∂iidGaussianMeasure ι +
          ((δ / 2) * ∫ ω, (Xn n ω) ^ 2 ∂iidGaussianMeasure ι +
            (δ⁻¹ / 2) * ∫ ω, (Y ω - Yn n ω) ^ 2 ∂iidGaussianMeasure ι) := by
      rw [integral_add hIntA hIntB,
          integral_add (hIntDiffX.const_mul _) (hIntY2.const_mul _),
          integral_add (hIntXn2.const_mul _) (hIntDiffY.const_mul _),
          integral_const_mul, integral_const_mul, integral_const_mul, integral_const_mul]
    rw [hIntEval] at hle1
    have hDiffX_le := integral_sq_sub_finset_le L w hw0 hw s hL f hmono hexh n hIntDiffX
    have hDiffY_le := integral_sq_sub_finset_le L w hw0 hw s hL g hmono hexh n hIntDiffY
    have hrem_nn : 0 ≤ ((∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) +
        ((∑' i, (L i g) ^ 2) - ∑ i ∈ F n, (L i g) ^ 2) :=
      add_nonneg
        (sub_nonneg.mpr ((summable_sq_eval L w hw0 hw s hL f).sum_le_tsum (F n) fun _ _ => sq_nonneg _))
        (sub_nonneg.mpr ((summable_sq_eval L w hw0 hw s hL g).sum_le_tsum (F n) fun _ _ => sq_nonneg _))
    have hrem_lt : ((∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) +
        ((∑' i, (L i g) ^ 2) - ∑ i ∈ F n, (L i g) ^ 2) < δ * ε / 2 := by
      have := hN n hn
      rw [Real.dist_eq, sub_zero, abs_of_nonneg hrem_nn] at this
      exact this
    have hterm1 : (δ⁻¹ / 2) * (((∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) +
        ((∑' i, (L i g) ^ 2) - ∑ i ∈ F n, (L i g) ^ 2)) < ε / 4 := by
      have hmul := mul_lt_mul_of_pos_left hrem_lt (by positivity : 0 < δ⁻¹ / 2)
      have heq : δ⁻¹ / 2 * (δ * ε / 2) = ε / 4 := by field_simp [hδ_pos.ne']; ring
      linarith
    have hterm2 : (δ / 2) * ((∑' i, (L i f) ^ 2) + (∑' i, (L i g) ^ 2)) < ε / 4 := by
      have hltM : (∑' i, (L i f) ^ 2) + (∑' i, (L i g) ^ 2) < M := by simp only [M]; linarith
      have hmul := mul_lt_mul_of_pos_left hltM (by positivity : 0 < δ / 2)
      have heq : δ / 2 * M = ε / 4 := by simp only [δ]; field_simp [hM_pos.ne']; ring
      linarith
    have hcomb :
        (δ⁻¹ / 2) * ∫ ω, (X ω - Xn n ω) ^ 2 ∂iidGaussianMeasure ι +
          (δ / 2) * ∫ ω, (Y ω) ^ 2 ∂iidGaussianMeasure ι +
          ((δ / 2) * ∫ ω, (Xn n ω) ^ 2 ∂iidGaussianMeasure ι +
            (δ⁻¹ / 2) * ∫ ω, (Y ω - Yn n ω) ^ 2 ∂iidGaussianMeasure ι) ≤
        (δ⁻¹ / 2) * (((∑' i, (L i f) ^ 2) - ∑ i ∈ F n, (L i f) ^ 2) +
          ((∑' i, (L i g) ^ 2) - ∑ i ∈ F n, (L i g) ^ 2)) +
          (δ / 2) * ((∑' i, (L i f) ^ 2) + (∑' i, (L i g) ^ 2)) := by
      have ha := mul_le_mul_of_nonneg_left hDiffX_le (by positivity : 0 ≤ δ⁻¹ / 2)
      have hb := mul_le_mul_of_nonneg_left hDiffY_le (by positivity : 0 ≤ δ⁻¹ / 2)
      have hc := mul_le_mul_of_nonneg_left hY2_le (by positivity : 0 ≤ δ / 2)
      have hd := mul_le_mul_of_nonneg_left hXn2 (by positivity : 0 ≤ δ / 2)
      linarith
    linarith
  exact tendsto_nhds_unique htend_mul
    ((summable_mul_eval L w hw0 hw s hL f g).hasSum.comp htendF)

end GaussianSeries

section WeylDensity

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The Weyl exponential `φ ↦ exp(i · φ(f))` on `RealTemperedDistribution E`. -/
noncomputable def weylExp (f : 𝓢(E, ℝ)) (φ : RealTemperedDistribution E) : ℂ :=
  Complex.exp (Complex.I * (φ f : ℂ))

theorem memLp_weylExp (μ : @Measure (RealTemperedDistribution E) (cylMeasurableSpace E))
    [IsProbabilityMeasure μ] (f : 𝓢(E, ℝ)) :
    MemLp (weylExp f) 2 μ := by
  let _ := cylMeasurableSpace E
  refine MemLp.of_bound
    ((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
      (measurable_eval_cyl f)).aestronglyMeasurable 1 (ae_of_all _ fun φ => ?_)
  simp [weylExp, mul_comm Complex.I]

/-- The Weyl exponential `φ ↦ exp(i · φ(f))` as an element of `Lp ℂ 2 μ`. -/
noncomputable def weylExpLp (μ : @Measure (RealTemperedDistribution E) (cylMeasurableSpace E))
    [IsProbabilityMeasure μ] (f : 𝓢(E, ℝ)) :
    Lp ℂ 2 μ :=
  (memLp_weylExp μ f).toLp (weylExp f)

private lemma setIntegral_real_eq_zero_of_char_zero
    (μ : @Measure (RealTemperedDistribution E) (cylMeasurableSpace E))
    [IsProbabilityMeasure μ] {r : ℕ} (fs : Fin r → 𝓢(E, ℝ))
    {g : RealTemperedDistribution E → ℝ}
    (hg_meas : Measurable[cylMeasurableSpace E, inferInstance] g)
    (hg_int : Integrable g μ)
    (hchar : ∀ t : EuclideanSpace ℝ (Fin r),
      ∫ φ, Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ)) * (g φ : ℂ) ∂μ = 0)
    {B : Set (EuclideanSpace ℝ (Fin r))} (hB : MeasurableSet B) :
    ∫ φ in (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B, g φ ∂μ = 0 := by
  let _ := cylMeasurableSpace E
  let π : RealTemperedDistribution E → EuclideanSpace ℝ (Fin r) :=
    fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))
  have hπ_meas : Measurable π := by
    have h1 : Measurable (fun φ : RealTemperedDistribution E => fun k : Fin r => φ (fs k)) :=
      measurable_pi_iff.mpr fun k => measurable_eval_cyl (fs k)
    exact (PiLp.continuous_toLp 2 (fun _ : Fin r => ℝ)).measurable.comp h1
  let gp : RealTemperedDistribution E → ℝ := fun φ => max (g φ) 0
  let gm : RealTemperedDistribution E → ℝ := fun φ => max (-g φ) 0
  have hgp_meas : Measurable gp := hg_meas.max measurable_const
  have hgm_meas : Measurable gm := hg_meas.neg.max measurable_const
  have hgp_int : Integrable gp μ := hg_int.pos_part
  have hgm_int : Integrable gm μ := hg_int.neg.pos_part
  let μp : Measure (RealTemperedDistribution E) :=
    μ.withDensity (fun φ => ENNReal.ofReal (gp φ))
  let μm : Measure (RealTemperedDistribution E) :=
    μ.withDensity (fun φ => ENNReal.ofReal (gm φ))
  have hμp_fin : IsFiniteMeasure μp := by
    constructor
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    refine lt_of_le_of_lt (lintegral_mono fun φ => ?_) hgp_int.2
    rw [Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  have hμm_fin : IsFiniteMeasure μm := by
    constructor
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    refine lt_of_le_of_lt (lintegral_mono fun φ => ?_) hgm_int.2
    rw [Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  have hν_eq : μp.map π = μm.map π := by
    have : IsFiniteMeasure (μp.map π) := Measure.isFiniteMeasure_map μp π
    have : IsFiniteMeasure (μm.map π) := Measure.isFiniteMeasure_map μm π
    refine Measure.ext_of_charFun (funext fun t => ?_)
    have hinner_eq : ∀ φ, inner ℝ (π φ) t = ∑ k : Fin r, t k * φ (fs k) := by
      intro φ
      rw [PiLp.inner_apply]
      refine Finset.sum_congr rfl fun k _ => ?_
      simp [π, RCLike.inner_apply]
    have hcf : ∀ (h : RealTemperedDistribution E → ℝ) (hh_meas : Measurable h)
        (hh0 : ∀ φ, 0 ≤ h φ),
        charFun ((μ.withDensity (fun φ => ENNReal.ofReal (h φ))).map π) t =
          ∫ φ, Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ)) * (h φ : ℂ) ∂μ := by
      intro h hh_meas hh0
      rw [charFun_apply]
      have hcont_exp : Continuous (fun x : EuclideanSpace ℝ (Fin r) =>
          Complex.exp ((inner ℝ x t : ℝ) * Complex.I)) :=
        Complex.continuous_exp.comp
          ((Complex.continuous_ofReal.comp (continuous_id.inner continuous_const)).mul continuous_const)
      rw [integral_map hπ_meas.aemeasurable hcont_exp.aestronglyMeasurable]
      have hm_h : Measurable (fun φ : RealTemperedDistribution E => ENNReal.ofReal (h φ)) :=
        ENNReal.measurable_ofReal.comp hh_meas
      rw [integral_withDensity_eq_integral_toReal_smul hm_h
        (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
      refine integral_congr_ae (ae_of_all _ fun φ => ?_)
      dsimp only
      rw [ENNReal.toReal_ofReal (hh0 φ), Complex.real_smul, hinner_eq, mul_comm (h φ : ℂ),
        mul_comm Complex.I]
    have hcfp := hcf gp hgp_meas (fun φ => le_max_right _ _)
    have hcfm := hcf gm hgm_meas (fun φ => le_max_right _ _)
    have hmeas_exp : Measurable (fun φ : RealTemperedDistribution E =>
        Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ))) :=
      (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
        (Finset.measurable_sum _ fun k _ => (measurable_eval_cyl (fs k)).const_mul (t k))
    have hint_gp : Integrable (fun φ =>
        Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ)) * (gp φ : ℂ)) μ := by
      refine Integrable.mono' hgp_int ?_ (ae_of_all _ fun φ => ?_)
      · exact (hmeas_exp.mul (Complex.continuous_ofReal.measurable.comp hgp_meas)).aestronglyMeasurable
      · rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, one_mul,
          Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (le_max_right _ _)]
    have hint_gm : Integrable (fun φ =>
        Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ)) * (gm φ : ℂ)) μ := by
      refine Integrable.mono' hgm_int ?_ (ae_of_all _ fun φ => ?_)
      · exact (hmeas_exp.mul (Complex.continuous_ofReal.measurable.comp hgm_meas)).aestronglyMeasurable
      · rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, one_mul,
          Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (le_max_right _ _)]
    have hsub : charFun (μp.map π) t - charFun (μm.map π) t = 0 := by
      rw [hcfp, hcfm, ← integral_sub hint_gp hint_gm]
      have hfg : ∀ φ, Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ)) * (gp φ : ℂ) -
          Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ)) * (gm φ : ℂ) =
          Complex.exp (Complex.I * (∑ k : Fin r, t k * φ (fs k) : ℝ)) * (g φ : ℂ) := by
        intro φ
        rw [← mul_sub, ← Complex.ofReal_sub]
        congr 2
        change max (g φ) 0 - max (-g φ) 0 = g φ
        rcases le_total (g φ) 0 with h | h
        · rw [max_eq_right h, max_eq_left (neg_nonneg.mpr h)]; ring
        · rw [max_eq_left h, max_eq_right (neg_nonpos.mpr h)]; ring
      simp_rw [hfg]
      exact hchar t
    exact sub_eq_zero.mp hsub
  have hmeas_eq : μp (π ⁻¹' B) = μm (π ⁻¹' B) := by
    have := congrArg (fun ν : Measure (EuclideanSpace ℝ (Fin r)) => ν B) hν_eq
    simpa only [Measure.map_apply hπ_meas hB] using this
  rw [withDensity_apply _ (hπ_meas hB), withDensity_apply _ (hπ_meas hB)] at hmeas_eq
  rw [← ofReal_integral_eq_lintegral_ofReal hgp_int.integrableOn (ae_of_all _ fun _ => le_max_right _ _),
    ← ofReal_integral_eq_lintegral_ofReal hgm_int.integrableOn (ae_of_all _ fun _ => le_max_right _ _)]
    at hmeas_eq
  have hint_eq : ∫ φ in π ⁻¹' B, gp φ ∂μ = ∫ φ in π ⁻¹' B, gm φ ∂μ := by
    have hp0 : 0 ≤ ∫ φ in π ⁻¹' B, gp φ ∂μ := setIntegral_nonneg (hπ_meas hB) fun _ _ => le_max_right _ _
    have hm0 : 0 ≤ ∫ φ in π ⁻¹' B, gm φ ∂μ := setIntegral_nonneg (hπ_meas hB) fun _ _ => le_max_right _ _
    exact (ENNReal.ofReal_eq_ofReal_iff hp0 hm0).mp hmeas_eq
  have hdecomp : ∀ φ, g φ = gp φ - gm φ := by
    intro φ
    change g φ = max (g φ) 0 - max (-g φ) 0
    rcases le_total (g φ) 0 with h | h
    · rw [max_eq_right h, max_eq_left (neg_nonneg.mpr h)]; ring
    · rw [max_eq_left h, max_eq_right (neg_nonpos.mpr h)]; ring
  simp_rw [hdecomp]
  rw [integral_sub hgp_int.integrableOn hgm_int.integrableOn, hint_eq, sub_self]

/-- For ANY probability measure `μ` on `(RealTemperedDistribution E, cylMeasurableSpace E)`,
the closed `ℂ`-linear span of the Weyl exponentials `{φ ↦ exp(i · φ(f))}` is all of `Lp ℂ 2 μ`. -/
theorem weylExp_dense_L2 (μ : @Measure (RealTemperedDistribution E) (cylMeasurableSpace E))
    [IsProbabilityMeasure μ] :
    (Submodule.span ℂ (Set.range (weylExpLp μ))).topologicalClosure = ⊤ := by
  let _ := cylMeasurableSpace E
  rw [← Submodule.orthogonal_eq_bot_iff, eq_bot_iff]
  intro F hF
  rw [Submodule.mem_bot]
  have horth : ∀ f : 𝓢(E, ℝ), inner ℂ (weylExpLp μ f) F = 0 := by
    intro f
    have hmem : weylExpLp μ f ∈ (Submodule.span ℂ (Set.range (weylExpLp μ))).topologicalClosure :=
      Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨f, rfl⟩)
    exact (Submodule.mem_orthogonal _ F).mp hF _ hmem
  let F₀ : RealTemperedDistribution E → ℂ := (Lp.aestronglyMeasurable F).mk F
  have hF₀_meas : Measurable F₀ := (Lp.aestronglyMeasurable F).stronglyMeasurable_mk.measurable
  have hF_ae : (F : RealTemperedDistribution E → ℂ) =ᵐ[μ] F₀ := (Lp.aestronglyMeasurable F).ae_eq_mk
  have hF_int : Integrable (F : RealTemperedDistribution E → ℂ) μ :=
    (Lp.memLp F).integrable one_le_two
  have hF₀_int : Integrable F₀ μ := hF_int.congr hF_ae
  have hchar_F₀ : ∀ f : 𝓢(E, ℝ),
      ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ ∂μ = 0 := by
    intro f
    have h0 := horth (-f)
    rw [L2.inner_def] at h0
    have hae : (fun φ => inner ℂ (weylExpLp μ (-f) φ) (F φ)) =ᵐ[μ]
        (fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ) := by
      filter_upwards [(memLp_weylExp μ (-f)).coeFn_toLp, hF_ae] with φ h1 h2
      dsimp only [weylExpLp]
      rw [h1, h2, RCLike.inner_apply', weylExp, map_neg, Complex.ofReal_neg,
        ← Complex.exp_conj]
      congr 2
      simp [mul_comm Complex.I]
    rwa [integral_congr_ae hae] at h0
  have hchar_re : ∀ f : 𝓢(E, ℝ),
      ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) * ((F₀ φ).re : ℂ) ∂μ = 0 := by
    intro f
    have h1 := hchar_F₀ f
    have h2 : ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ) ∂μ = 0 := by
      have hc := congrArg (starRingEnd ℂ) (hchar_F₀ (-f))
      simp only [map_zero] at hc
      rw [← integral_conj] at hc
      have hEq : (fun φ => starRingEnd ℂ (Complex.exp (Complex.I * (φ (-f) : ℂ)) * F₀ φ)) =
          fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ) := by
        ext φ
        rw [map_mul, ← Complex.exp_conj, map_neg, Complex.ofReal_neg]
        congr 2
        simp
      rwa [hEq] at hc
    have hint1 : Integrable (fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ) μ := by
      refine Integrable.mono' hF₀_int.norm ?_ (ae_of_all _ fun φ => ?_)
      · exact (((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
          (measurable_eval_cyl f)).mul hF₀_meas).aestronglyMeasurable
      · rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, one_mul]
    have hint2 : Integrable (fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ)) μ := by
      refine Integrable.mono' hF₀_int.norm ?_ (ae_of_all _ fun φ => ?_)
      · exact (((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
          (measurable_eval_cyl f)).mul (Complex.continuous_conj.measurable.comp hF₀_meas)).aestronglyMeasurable
      · rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_conj]
    have hsum : ∫ φ, (Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ +
        Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ)) ∂μ = 0 := by
      rw [integral_add hint1 hint2, h1, h2, add_zero]
    have hEq : (fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ +
        Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ)) =
        fun φ => (2 : ℂ) * (Complex.exp (Complex.I * (φ f : ℂ)) * ((F₀ φ).re : ℂ)) := by
      ext φ
      rw [← mul_add, Complex.add_conj]
      push_cast
      ring
    rw [hEq, integral_const_mul] at hsum
    exact (mul_eq_zero.mp hsum).resolve_left (by norm_num)
  have hchar_im : ∀ f : 𝓢(E, ℝ),
      ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) * ((F₀ φ).im : ℂ) ∂μ = 0 := by
    intro f
    have h1 := hchar_F₀ f
    have h2 : ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ) ∂μ = 0 := by
      have hc := congrArg (starRingEnd ℂ) (hchar_F₀ (-f))
      simp only [map_zero] at hc
      rw [← integral_conj] at hc
      have hEq : (fun φ => starRingEnd ℂ (Complex.exp (Complex.I * (φ (-f) : ℂ)) * F₀ φ)) =
          fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ) := by
        ext φ
        rw [map_mul, ← Complex.exp_conj, map_neg, Complex.ofReal_neg]
        congr 2
        simp
      rwa [hEq] at hc
    have hint1 : Integrable (fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ) μ := by
      refine Integrable.mono' hF₀_int.norm ?_ (ae_of_all _ fun φ => ?_)
      · exact (((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
          (measurable_eval_cyl f)).mul hF₀_meas).aestronglyMeasurable
      · rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, one_mul]
    have hint2 : Integrable (fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ)) μ := by
      refine Integrable.mono' hF₀_int.norm ?_ (ae_of_all _ fun φ => ?_)
      · exact (((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).measurable.comp
          (measurable_eval_cyl f)).mul (Complex.continuous_conj.measurable.comp hF₀_meas)).aestronglyMeasurable
      · rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_conj]
    have hsub : ∫ φ, (Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ -
        Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ)) ∂μ = 0 := by
      rw [integral_sub hint1 hint2, h1, h2, sub_zero]
    have hEq : (fun φ => Complex.exp (Complex.I * (φ f : ℂ)) * F₀ φ -
        Complex.exp (Complex.I * (φ f : ℂ)) * starRingEnd ℂ (F₀ φ)) =
        fun φ => (2 * Complex.I) * (Complex.exp (Complex.I * (φ f : ℂ)) * ((F₀ φ).im : ℂ)) := by
      ext φ
      rw [← mul_sub, Complex.sub_conj]
      push_cast
      ring
    rw [hEq, integral_const_mul] at hsub
    exact (mul_eq_zero.mp hsub).resolve_left (mul_ne_zero (by norm_num) Complex.I_ne_zero)
  -- Finite-dimensional cylinder π-system
  let C : Set (Set (RealTemperedDistribution E)) :=
    {s | ∃ (r : ℕ) (fs : Fin r → 𝓢(E, ℝ)) (B : Set (EuclideanSpace ℝ (Fin r))),
      MeasurableSet B ∧
      s = (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B}
  have hgen : cylMeasurableSpace E = MeasurableSpace.generateFrom C := by
    refine le_antisymm ?_ ?_
    · refine iSup_le fun f s hs => ?_
      rcases hs with ⟨A, hA, rfl⟩
      refine MeasurableSpace.measurableSet_generateFrom ?_
      refine ⟨1, fun _ => f, (fun v : EuclideanSpace ℝ (Fin 1) => v 0) ⁻¹' A, ?_, ?_⟩
      · exact (EuclideanSpace.proj (0 : Fin 1)).continuous.measurable hA
      · ext φ; rfl
    · refine MeasurableSpace.generateFrom_le fun s hs => ?_
      rcases hs with ⟨r, fs, B, hB, rfl⟩
      have hπ_meas : Measurable[cylMeasurableSpace E, inferInstance]
          (fun φ : RealTemperedDistribution E =>
            (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) :=
        (PiLp.continuous_toLp 2 (fun _ : Fin r => ℝ)).measurable.comp
          (measurable_pi_iff.mpr fun k => measurable_eval_cyl (fs k))
      exact hπ_meas hB
  have hpi : IsPiSystem C := by
    rintro s₁ ⟨r₁, fs₁, B₁, hB₁, rfl⟩ s₂ ⟨r₂, fs₂, B₂, hB₂, rfl⟩ _
    let fs : Fin (r₁ + r₂) → 𝓢(E, ℝ) := Fin.append fs₁ fs₂
    let p₁ : EuclideanSpace ℝ (Fin (r₁ + r₂)) → EuclideanSpace ℝ (Fin r₁) :=
      fun v => (WithLp.equiv 2 (Fin r₁ → ℝ)).symm (fun k => v (Fin.castAdd r₂ k))
    let p₂ : EuclideanSpace ℝ (Fin (r₁ + r₂)) → EuclideanSpace ℝ (Fin r₂) :=
      fun v => (WithLp.equiv 2 (Fin r₂ → ℝ)).symm (fun k => v (Fin.natAdd r₁ k))
    have hp₁ : Measurable p₁ :=
      (PiLp.continuous_toLp 2 (fun _ : Fin r₁ => ℝ)).measurable.comp
        (measurable_pi_iff.mpr fun k => (EuclideanSpace.proj (Fin.castAdd r₂ k)).continuous.measurable)
    have hp₂ : Measurable p₂ :=
      (PiLp.continuous_toLp 2 (fun _ : Fin r₂ => ℝ)).measurable.comp
        (measurable_pi_iff.mpr fun k => (EuclideanSpace.proj (Fin.natAdd r₁ k)).continuous.measurable)
    refine ⟨r₁ + r₂, fs, p₁ ⁻¹' B₁ ∩ p₂ ⁻¹' B₂, (hp₁ hB₁).inter (hp₂ hB₂), ?_⟩
    ext φ
    simp only [Set.mem_inter_iff, Set.mem_preimage]
    have h1 : p₁ ((WithLp.equiv 2 (Fin (r₁ + r₂) → ℝ)).symm (fun k => φ (fs k))) =
        (WithLp.equiv 2 (Fin r₁ → ℝ)).symm (fun k => φ (fs₁ k)) := by
      ext k
      simp [p₁, fs, Fin.append_left]
    have h2 : p₂ ((WithLp.equiv 2 (Fin (r₁ + r₂) → ℝ)).symm (fun k => φ (fs k))) =
        (WithLp.equiv 2 (Fin r₂ → ℝ)).symm (fun k => φ (fs₂ k)) := by
      ext k
      simp [p₂, fs, Fin.append_right]
    rw [h1, h2]
  have hcyl_zero : ∀ s ∈ C, ∫ φ in s, F₀ φ ∂μ = 0 := by
    rintro s ⟨r, fs, B, hB, rfl⟩
    have hre0 : ∫ φ in (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B,
        (F₀ φ).re ∂μ = 0 := by
      refine setIntegral_real_eq_zero_of_char_zero μ fs
        (Complex.continuous_re.measurable.comp hF₀_meas) hF₀_int.re (fun t => ?_) hB
      have hlin : ∀ φ : RealTemperedDistribution E,
          ∑ k : Fin r, t k * φ (fs k) = φ (∑ k : Fin r, t k • fs k) := by
        intro φ
        simp [map_sum, map_smul, smul_eq_mul]
      simp_rw [hlin]
      exact hchar_re (∑ k : Fin r, t k • fs k)
    have him0 : ∫ φ in (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B,
        (F₀ φ).im ∂μ = 0 := by
      refine setIntegral_real_eq_zero_of_char_zero μ fs
        (Complex.continuous_im.measurable.comp hF₀_meas) hF₀_int.im (fun t => ?_) hB
      have hlin : ∀ φ : RealTemperedDistribution E,
          ∑ k : Fin r, t k * φ (fs k) = φ (∑ k : Fin r, t k • fs k) := by
        intro φ
        simp [map_sum, map_smul, smul_eq_mul]
      simp_rw [hlin]
      exact hchar_im (∑ k : Fin r, t k • fs k)
    apply Complex.ext
    · have hre_int : (∫ φ in (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B,
          F₀ φ ∂μ).re =
          ∫ φ in (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B,
            (F₀ φ).re ∂μ := by
        simpa using (integral_re (𝕜 := ℂ) hF₀_int.integrableOn).symm
      rw [hre_int, hre0, Complex.zero_re]
    · have him_int : (∫ φ in (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B,
          F₀ φ ∂μ).im =
          ∫ φ in (fun φ => (WithLp.equiv 2 (Fin r → ℝ)).symm (fun k => φ (fs k))) ⁻¹' B,
            (F₀ φ).im ∂μ := by
        simpa using (integral_im (𝕜 := ℂ) hF₀_int.integrableOn).symm
      rw [him_int, him0, Complex.zero_im]
  have huniv_zero : ∫ φ, F₀ φ ∂μ = 0 := by
    have h0 := hchar_F₀ 0
    simpa using h0
  have hall_zero : ∀ s : Set (RealTemperedDistribution E),
      MeasurableSet s → ∫ φ in s, F₀ φ ∂μ = 0 := by
    intro s hs
    refine MeasurableSpace.induction_on_inter hgen hpi ?_ ?_ ?_ ?_ s hs
    · simp
    · exact hcyl_zero
    · intro t ht hti
      have hadd := integral_add_compl ht hF₀_int
      rw [hti, zero_add, huniv_zero] at hadd
      exact hadd
    · intro f hdisj hf hfi
      rw [integral_iUnion hf hdisj hF₀_int.integrableOn]
      simp [hfi]
  have hF₀_ae_zero : F₀ =ᵐ[μ] 0 :=
    ae_eq_zero_of_forall_setIntegral_eq_of_sigmaFinite
      (fun _ _ _ => hF₀_int.integrableOn) (fun s hs _ => hall_zero s hs)
  exact Lp.ext (hF_ae.trans (hF₀_ae_zero.trans (Lp.coeFn_zero ℂ 2 μ).symm))

end WeylDensity

/-! ### Part 3: Smooth Partition-of-Unity Periodic Fourier Frame on `EuclideanSpace ℝ (Fin d)` -/

section FourierFrame

private noncomputable def rawBump1D : ContDiffBump (0 : ℝ) :=
  ⟨1 / 2, 3 / 4, by norm_num, by norm_num⟩

private lemma rawBump1D_eq_zero_of_le_abs {t : ℝ} (ht : 3 / 4 ≤ |t|) : rawBump1D t = 0 := by
  refine rawBump1D.zero_of_le_dist ?_
  simpa [rawBump1D, Real.dist_eq] using ht

private lemma rawBump1D_eq_one_of_abs_le {t : ℝ} (ht : |t| ≤ 1 / 2) : rawBump1D t = 1 := by
  refine rawBump1D.one_of_mem_closedBall ?_
  simpa [rawBump1D, Metric.mem_closedBall, Real.dist_eq] using ht

private noncomputable def bumpSum1D (t : ℝ) : ℝ :=
  ∑' z : ℤ, (rawBump1D (t - z)) ^ 2

private lemma int_mem_Icc_of_abs_sub_lt {a t : ℝ} (ht : t ∈ Set.Ioo (a - 1 / 4) (a + 1 / 4))
    {z : ℤ} (hlt : |t - z| < 3 / 4) :
    z ∈ Finset.Icc (⌊a⌋ - 1) (⌈a⌉ + 1) := by
  rw [Finset.mem_Icc]
  have hfl : (⌊a⌋ : ℝ) ≤ a := Int.floor_le a
  have hcl : a ≤ (⌈a⌉ : ℝ) := Int.le_ceil a
  have htz1 : t - z < 3 / 4 := (abs_lt.mp hlt).2
  have htz2 : -(3 / 4) < t - z := (abs_lt.mp hlt).1
  constructor
  · have hlt1 : ((⌊a⌋ - 2 : ℤ) : ℝ) < (z : ℝ) := by
      push_cast
      linarith [ht.1, ht.2, hfl, htz1]
    have : (⌊a⌋ - 2 : ℤ) < z := by exact_mod_cast hlt1
    omega
  · have hlt2 : (z : ℝ) < ((⌈a⌉ + 2 : ℤ) : ℝ) := by
      push_cast
      linarith [ht.1, ht.2, hcl, htz2]
    have : z < (⌈a⌉ + 2 : ℤ) := by exact_mod_cast hlt2
    omega

private lemma bumpSum1D_eq_finset_sum_near (a : ℝ) :
    ∀ t ∈ Set.Ioo (a - 1 / 4) (a + 1 / 4),
      bumpSum1D t = ∑ z ∈ Finset.Icc (⌊a⌋ - 1) (⌈a⌉ + 1), (rawBump1D (t - z)) ^ 2 := by
  intro t ht
  refine tsum_eq_sum fun z hz => ?_
  have hge : 3 / 4 ≤ |t - z| := by
    by_contra hlt
    push Not at hlt
    exact hz (int_mem_Icc_of_abs_sub_lt ht hlt)
  rw [rawBump1D_eq_zero_of_le_abs hge, zero_pow two_ne_zero]

private lemma one_le_bumpSum1D (t : ℝ) : 1 ≤ bumpSum1D t := by
  have hsum : Summable (fun z : ℤ => (rawBump1D (t - z)) ^ 2) := by
    refine summable_of_ne_finset_zero (s := Finset.Icc (⌊t⌋ - 1) (⌈t⌉ + 1)) fun z hz => ?_
    have hge : 3 / 4 ≤ |t - z| := by
      by_contra hlt
      push Not at hlt
      exact hz (int_mem_Icc_of_abs_sub_lt ⟨by linarith, by linarith⟩ hlt)
    rw [rawBump1D_eq_zero_of_le_abs hge, zero_pow two_ne_zero]
  have hk : |t - (round t : ℤ)| ≤ 1 / 2 := abs_sub_round t
  have h1 : (rawBump1D (t - (round t : ℤ))) ^ 2 = 1 := by
    rw [rawBump1D_eq_one_of_abs_le hk, one_pow]
  calc (1 : ℝ) = (rawBump1D (t - (round t : ℤ))) ^ 2 := h1.symm
    _ ≤ ∑' z : ℤ, (rawBump1D (t - z)) ^ 2 :=
      hsum.le_tsum (round t) (fun _ _ => sq_nonneg _)

private lemma contDiff_bumpSum1D : ContDiff ℝ (⊤ : ℕ∞) bumpSum1D := by
  rw [contDiff_iff_contDiffAt]
  intro a
  have hev : bumpSum1D =ᶠ[𝓝 a]
      fun t => ∑ z ∈ Finset.Icc (⌊a⌋ - 1) (⌈a⌉ + 1), (rawBump1D (t - z)) ^ 2 := by
    filter_upwards [Ioo_mem_nhds (by linarith : a - 1 / 4 < a) (by linarith : a < a + 1 / 4)]
      with t ht
    exact bumpSum1D_eq_finset_sum_near a t ht
  refine ContDiffAt.congr_of_eventuallyEq ?_ hev
  exact ContDiffAt.sum fun z _ =>
    ((rawBump1D.contDiff (n := (⊤ : ℕ∞))).comp (contDiff_id.sub contDiff_const)).contDiffAt.pow 2

private lemma bumpSum1D_sub_int (t : ℝ) (m : ℤ) : bumpSum1D (t - m) = bumpSum1D t := by
  unfold bumpSum1D
  have hEq : (fun z : ℤ => (rawBump1D (t - m - z)) ^ 2) =
      fun z : ℤ => (rawBump1D (t - ((m + z : ℤ) : ℝ))) ^ 2 := by
    ext z
    push_cast
    ring_nf
  rw [hEq]
  exact (Equiv.addLeft m).tsum_eq (fun z : ℤ => (rawBump1D (t - z)) ^ 2)

/-- 1D smooth bump function supported in `(-1, 1)` (in fact `[-3/4, 3/4]`) forming a
quadratic partition of unity under integer translations: `∑' z : ℤ, (unitBump1D (t - z))^2 = 1`. -/
noncomputable def unitBump1D (t : ℝ) : ℝ :=
  rawBump1D t / Real.sqrt (bumpSum1D t)

theorem unitBump1D_nonneg (t : ℝ) : 0 ≤ unitBump1D t :=
  div_nonneg rawBump1D.nonneg (Real.sqrt_nonneg _)

theorem contDiff_unitBump1D : ContDiff ℝ (⊤ : ℕ∞) unitBump1D := by
  refine (rawBump1D.contDiff (n := (⊤ : ℕ∞))).div ?_ fun t => ?_
  · exact contDiff_bumpSum1D.sqrt fun t => by linarith [one_le_bumpSum1D t]
  · exact (Real.sqrt_pos.mpr (by linarith [one_le_bumpSum1D t])).ne'

theorem unitBump1D_eq_zero_of_le_abs {t : ℝ} (ht : 3 / 4 ≤ |t|) : unitBump1D t = 0 := by
  simp [unitBump1D, rawBump1D_eq_zero_of_le_abs ht]

theorem support_unitBump1D_subset : Function.support unitBump1D ⊆ Set.Ioo (-1 : ℝ) 1 := by
  intro t ht
  by_contra hnot
  apply ht
  refine unitBump1D_eq_zero_of_le_abs ?_
  rw [Set.mem_Ioo, not_and_or, not_lt, not_lt] at hnot
  rcases hnot with h1 | h2
  · have : -t ≥ 1 := by linarith
    have := neg_le_abs t
    linarith
  · have := le_abs_self t
    linarith

theorem tsum_unitBump1D_sq (t : ℝ) : ∑' z : ℤ, (unitBump1D (t - z)) ^ 2 = 1 := by
  have hpos : 0 < bumpSum1D t := by linarith [one_le_bumpSum1D t]
  have hEq : (fun z : ℤ => (unitBump1D (t - z)) ^ 2) =
      fun z : ℤ => (rawBump1D (t - z)) ^ 2 / bumpSum1D t := by
    ext z
    rw [unitBump1D, div_pow, bumpSum1D_sub_int, Real.sq_sqrt hpos.le]
  rw [hEq, tsum_div_const]
  exact div_self hpos.ne'

/-- Coerce an integer lattice vector `z : Fin d → ℤ` to `EuclideanSpace ℝ (Fin d)`. -/
def intVec {d : ℕ} (z : Fin d → ℤ) : EuclideanSpace ℝ (Fin d) :=
  (WithLp.equiv 2 (Fin d → ℝ)).symm (fun i => (z i : ℝ))

@[simp]
lemma intVec_apply {d : ℕ} (z : Fin d → ℤ) (i : Fin d) : intVec z i = (z i : ℝ) := rfl

/-- Product smooth bump function on `EuclideanSpace ℝ (Fin d)` supported in `(-1, 1)^d`. -/
noncomputable def unitBump (d : ℕ) (x : EuclideanSpace ℝ (Fin d)) : ℝ :=
  ∏ i : Fin d, unitBump1D (x i)

theorem unitBump_nonneg (d : ℕ) (x : EuclideanSpace ℝ (Fin d)) : 0 ≤ unitBump d x :=
  Finset.prod_nonneg fun i _ => unitBump1D_nonneg (x i)

theorem contDiff_unitBump (d : ℕ) : ContDiff ℝ (⊤ : ℕ∞) (unitBump d) := by
  refine contDiff_prod fun i _ => ?_
  exact contDiff_unitBump1D.comp (EuclideanSpace.proj (𝕜 := ℝ) i).contDiff

theorem unitBump_eq_zero_of_exists_le_abs {d : ℕ} {x : EuclideanSpace ℝ (Fin d)}
    (h : ∃ i : Fin d, 3 / 4 ≤ |x i|) : unitBump d x = 0 := by
  rcases h with ⟨i, hi⟩
  exact Finset.prod_eq_zero (Finset.mem_univ i) (unitBump1D_eq_zero_of_le_abs hi)

theorem support_unitBump_subset (d : ℕ) :
    Function.support (unitBump d) ⊆ {x : EuclideanSpace ℝ (Fin d) | ∀ i, x i ∈ Set.Ioo (-1 : ℝ) 1} := by
  intro x hx i
  apply support_unitBump1D_subset
  intro h0
  exact hx (Finset.prod_eq_zero (Finset.mem_univ i) h0)

theorem tsum_unitBump_sq (d : ℕ) (x : EuclideanSpace ℝ (Fin d)) :
    ∑' z : Fin d → ℤ, (unitBump d (x - intVec z)) ^ 2 = 1 := by
  let S : Fin d → Finset ℤ := fun i => Finset.Icc (⌊x i⌋ - 1) (⌈x i⌉ + 1)
  have hfin : ∀ z : Fin d → ℤ, z ∉ Fintype.piFinset S →
      (unitBump d (x - intVec z)) ^ 2 = 0 := by
    intro z hz
    rw [Fintype.mem_piFinset, not_forall] at hz
    rcases hz with ⟨i, hi⟩
    have hge : 3 / 4 ≤ |x i - (z i : ℝ)| := by
      by_contra hlt
      push Not at hlt
      exact hi (int_mem_Icc_of_abs_sub_lt ⟨by linarith, by linarith⟩ hlt)
    have h0 : unitBump d (x - intVec z) = 0 :=
      unitBump_eq_zero_of_exists_le_abs ⟨i, by simpa using hge⟩
    rw [h0, zero_pow two_ne_zero]
  rw [tsum_eq_sum hfin]
  have hprod : ∀ z : Fin d → ℤ,
      (unitBump d (x - intVec z)) ^ 2 = ∏ i : Fin d, (unitBump1D (x i - z i)) ^ 2 := by
    intro z
    simp [unitBump, Finset.prod_pow]
  simp_rw [hprod]
  have hsum_prod :
      ∑ z ∈ Fintype.piFinset S, ∏ i : Fin d, (unitBump1D (x i - z i)) ^ 2 =
        ∏ i : Fin d, ∑ k ∈ S i, (unitBump1D (x i - k)) ^ 2 :=
    (Finset.prod_univ_sum S (fun i k => (unitBump1D (x i - k)) ^ 2)).symm
  rw [hsum_prod]
  refine Finset.prod_eq_one fun i _ => ?_
  have h1d : ∑ k ∈ S i, (unitBump1D (x i - k)) ^ 2 = ∑' k : ℤ, (unitBump1D (x i - k)) ^ 2 := by
    symm
    refine tsum_eq_sum fun k hk => ?_
    have hge : 3 / 4 ≤ |x i - k| := by
      by_contra hlt
      push Not at hlt
      exact hk (int_mem_Icc_of_abs_sub_lt ⟨by linarith, by linarith⟩ hlt)
    rw [unitBump1D_eq_zero_of_le_abs hge, zero_pow two_ne_zero]
  rw [h1d, tsum_unitBump1D_sq]

/-- Smooth partition-of-unity periodic Fourier frame coefficient on `EuclideanSpace ℝ (Fin d)`. -/
noncomputable def frameCoeff (d : ℕ) (z j : Fin d → ℤ)
    (g : EuclideanSpace ℝ (Fin d) → ℂ) : ℂ :=
  (2 : ℂ) ^ (-(d : ℂ) / 2) *
    ∫ x : EuclideanSpace ℝ (Fin d),
      (unitBump d (x - intVec z) : ℂ) *
        Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * (x i - z i)) * g x

private lemma norm_sq_two_cpow_neg_half (d : ℕ) :
    ‖(2 : ℂ) ^ (-(d : ℂ) / 2)‖ ^ 2 = ((2 : ℝ) ^ d)⁻¹ := by
  have h1 : (2 : ℂ) ^ (-(d : ℂ) / 2) = (((2 : ℝ) ^ (-(d : ℝ) / 2) : ℝ) : ℂ) := by
    rw [Complex.ofReal_cpow (by norm_num)]
    simp
  rw [h1, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (by norm_num) _),
    ← Real.rpow_natCast _ 2, ← Real.rpow_mul (by norm_num),
    show (-(d : ℝ) / 2) * (2 : ℕ) = -(d : ℝ) by push_cast; ring,
    Real.rpow_neg (by norm_num), Real.rpow_natCast]

private lemma norm_two_cpow_neg_half (d : ℕ) :
    ‖(2 : ℂ) ^ (-(d : ℂ) / 2)‖ = (2 : ℝ) ^ (-(d : ℝ) / 2) := by
  have h1 : (2 : ℂ) ^ (-(d : ℂ) / 2) = (((2 : ℝ) ^ (-(d : ℝ) / 2) : ℝ) : ℂ) := by
    rw [Complex.ofReal_cpow (by norm_num)]
    simp
  rw [h1, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (by norm_num) _)]

lemma frameCoeff_eq_shift (d : ℕ) (z j : Fin d → ℤ) (g : EuclideanSpace ℝ (Fin d) → ℂ) :
    frameCoeff d z j g =
      (2 : ℂ) ^ (-(d : ℂ) / 2) *
        ∫ u : EuclideanSpace ℝ (Fin d),
          (unitBump d u : ℂ) *
            Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) *
            g (intVec z + u) := by
  unfold frameCoeff
  congr 1
  rw [← integral_add_left_eq_self _ (intVec z)]
  congr 1
  ext u
  have h1 : intVec z + u - intVec z = u := by abel
  have h2 : ∀ i : Fin d, (intVec z + u) i - (z i : ℝ) = u i := by
    intro i
    simp [intVec]
  simp_rw [h1, h2]

private lemma parseval_1d_Ioc {f : ℝ → ℂ} (hf : Continuous f) :
    ∑' n : ℤ,
        ENNReal.ofReal (‖(2 : ℂ) ^ (-(1 : ℂ) / 2) *
          ∫ t in (-1 : ℝ)..1, Complex.exp (-Complex.I * Real.pi * (n : ℝ) * t) * f t‖ ^ 2) =
      ∫⁻ t in Set.Ioc (-1 : ℝ) 1, ENNReal.ofReal (‖f t‖ ^ 2) := by
  have hab : (-1 : ℝ) < 1 := by norm_num
  have hmem : MemLp f 2 (volume.restrict (Set.Ioc (-1 : ℝ) 1)) := by
    rcases isCompact_Icc.exists_bound_of_continuousOn hf.continuousOn with ⟨C, hC⟩
    have : IsFiniteMeasure (volume.restrict (Set.Ioc (-1 : ℝ) 1)) := by
      constructor
      simp
    refine MemLp.of_bound hf.aestronglyMeasurable C ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    exact hC t (Set.Ioc_subset_Icc_self ht)
  have htsum := tsum_sq_fourierCoeffOn hab hmem
  have hcoeff : ∀ n : ℤ,
      ‖(2 : ℂ) ^ (-(1 : ℂ) / 2) *
          ∫ t in (-1 : ℝ)..1, Complex.exp (-Complex.I * Real.pi * (n : ℝ) * t) * f t‖ ^ 2 =
        2 * ‖fourierCoeffOn hab f n‖ ^ 2 := by
    intro n
    rw [fourierCoeffOn_eq_integral]
    have hT : (1 : ℝ) - (-1 : ℝ) = 2 := by norm_num
    have hint_eq :
        ∫ t in (-1 : ℝ)..1, fourier (-n) (t : AddCircle ((1 : ℝ) - (-1))) • f t =
          ∫ t in (-1 : ℝ)..1, Complex.exp (-Complex.I * Real.pi * (n : ℝ) * t) * f t := by
      refine intervalIntegral.integral_congr fun t _ => ?_
      rw [smul_eq_mul, fourier_coe_apply, hT]
      congr 2
      push_cast
      ring
    rw [hint_eq, hT, norm_smul, norm_mul, mul_pow, mul_pow]
    have hn1 : ‖(2 : ℂ) ^ (-(1 : ℂ) / 2)‖ ^ 2 = 2⁻¹ := by
      simpa using norm_sq_two_cpow_neg_half 1
    rw [hn1]
    simp only [one_div, norm_inv, Real.norm_ofNat, inv_pow]
    ring
  simp_rw [hcoeff]
  have hsum_f : Summable (fun n : ℤ => 2 * ‖fourierCoeffOn hab f n‖ ^ 2) :=
    (hasSum_sq_fourierCoeffOn hab hmem).summable.mul_left 2
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity) hsum_f, tsum_mul_left, htsum]
  rw [show (1 : ℝ) - (-1 : ℝ) = 2 by norm_num, smul_eq_mul,
    ← mul_assoc, mul_inv_cancel₀ (by norm_num), one_mul]
  rw [intervalIntegral.integral_of_le hab.le]
  have hint_sq : IntegrableOn (fun t => ‖f t‖ ^ 2) (Set.Ioc (-1 : ℝ) 1) volume :=
    hmem.norm.integrable_sq
  exact ofReal_integral_eq_lintegral_ofReal hint_sq (ae_of_all _ fun _ => sq_nonneg _)

/-- `d`-dimensional Parseval identity on the cube `(-1, 1]^d` in `ℝ≥0∞`. -/
private lemma parseval_cube_ennreal (d : ℕ) {h : (Fin d → ℝ) → ℂ} (hh : Continuous h) :
    ∑' j : Fin d → ℤ,
        ENNReal.ofReal (‖(2 : ℂ) ^ (-(d : ℂ) / 2) *
          ∫ u in Set.univ.pi (fun _ : Fin d => Set.Ioc (-1 : ℝ) 1),
            Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) * h u‖ ^ 2) =
      ∫⁻ u in Set.univ.pi (fun _ : Fin d => Set.Ioc (-1 : ℝ) 1), ENNReal.ofReal (‖h u‖ ^ 2) := by
  induction d with
  | zero =>
    have hpi : (Set.univ.pi (fun _ : Fin 0 => Set.Ioc (-1 : ℝ) 1)) = Set.univ := by
      ext u; simp
    have hconst : h = fun _ => h 0 := funext fun u => congrArg h (Subsingleton.elim u 0)
    rw [hpi, Measure.restrict_univ, tsum_fintype, Finset.univ_unique, Finset.sum_singleton, hconst]
    have hvol : (volume : Measure (Fin 0 → ℝ)) Set.univ = 1 := by
      change Measure.pi (fun _ : Fin 0 => (volume : Measure ℝ)) Set.univ = 1
      simp
    simp only [Nat.cast_zero, neg_zero, zero_div, Complex.cpow_zero, one_mul,
      Finset.univ_eq_empty, Finset.sum_empty, Complex.ofReal_zero, mul_zero, Complex.exp_zero]
    rw [integral_const, lintegral_const, Measure.real_def, hvol]
    simp
  | succ d ih =>
    let cube : Set (Fin d → ℝ) := Set.univ.pi (fun _ : Fin d => Set.Ioc (-1 : ℝ) 1)
    let cube' : Set (Fin (d + 1) → ℝ) := Set.univ.pi (fun _ : Fin (d + 1) => Set.Ioc (-1 : ℝ) 1)
    let H : ℤ → (Fin d → ℝ) → ℂ := fun j₀ v =>
      (2 : ℂ) ^ (-(1 : ℂ) / 2) *
        ∫ t in (-1 : ℝ)..1, Complex.exp (-Complex.I * Real.pi * (j₀ : ℝ) * t) * h (Fin.cons t v)
    have hH_cont : ∀ j₀ : ℤ, Continuous (H j₀) := by
      intro j₀
      refine continuous_const.mul ?_
      have hjoint : Continuous (fun p : (Fin d → ℝ) × ℝ =>
          Complex.exp (-Complex.I * Real.pi * (j₀ : ℝ) * p.2) * h (Fin.cons p.2 p.1)) := by
        refine (Complex.continuous_exp.comp ?_).mul ?_
        · exact continuous_const.mul (Complex.continuous_ofReal.comp continuous_snd)
        · refine hh.comp (continuous_pi fun i => ?_)
          exact Fin.cases continuous_snd (fun k => (continuous_apply k).comp continuous_fst) i
      exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hjoint (-1) 1
    let eZ : (Fin (d + 1) → ℤ) ≃ ℤ × (Fin d → ℤ) :=
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (d + 1) => ℤ) 0).toEquiv
    have hmp := (MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin (d + 1) => ℝ) 0).symm
    have hpre : (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (d + 1) => ℝ) 0).symm ⁻¹' cube' =
        Set.Ioc (-1 : ℝ) 1 ×ˢ cube := by
      ext ⟨t, v⟩
      simp only [Set.mem_preimage, Set.mem_prod, cube', cube, Set.mem_univ_pi,
        MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_apply, Fin.insertNth_zero]
      constructor
      · intro htv
        exact ⟨by simpa using htv 0, fun i => by simpa using htv i.succ⟩
      · rintro ⟨ht, hv⟩ i
        exact Fin.cases ht hv i
    have hsplit_coeff : ∀ (j₀ : ℤ) (j' : Fin d → ℤ),
        (2 : ℂ) ^ (-((d + 1 : ℕ) : ℂ) / 2) *
            ∫ u in cube',
              Complex.exp (-Complex.I * Real.pi * ∑ i : Fin (d + 1),
                ((Fin.cons j₀ j' : Fin (d + 1) → ℤ) i : ℝ) * u i) * h u =
          (2 : ℂ) ^ (-(d : ℂ) / 2) *
            ∫ v in cube,
              Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j' i : ℝ) * v i) * H j₀ v := by
      intro j₀ j'
      have hpow : (2 : ℂ) ^ (-((d + 1 : ℕ) : ℂ) / 2) =
          (2 : ℂ) ^ (-(d : ℂ) / 2) * (2 : ℂ) ^ (-(1 : ℂ) / 2) := by
        rw [← Complex.cpow_add _ _ (by norm_num)]
        congr 1
        push_cast
        ring
      have hint_split :
          ∫ u in cube',
              Complex.exp (-Complex.I * Real.pi * ∑ i : Fin (d + 1),
                ((Fin.cons j₀ j' : Fin (d + 1) → ℤ) i : ℝ) * u i) * h u =
            ∫ p : ℝ × (Fin d → ℝ) in Set.Ioc (-1 : ℝ) 1 ×ˢ cube,
              (Complex.exp (-Complex.I * Real.pi * (j₀ : ℝ) * p.1) *
                Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j' i : ℝ) * p.2 i)) *
                h (Fin.cons p.1 p.2) := by
        rw [← hmp.setIntegral_preimage_emb (MeasurableEquiv.measurableEmbedding _), hpre]
        refine setIntegral_congr_fun (measurableSet_Ioc.prod (MeasurableSet.univ_pi fun _ => measurableSet_Ioc))
          fun ⟨t, v⟩ _ => ?_
        simp only [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_apply,
          Fin.insertNth_zero, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ, cast_eq]
        have hcons_tv : (Fin.insertNthEquiv (fun _ : Fin (d + 1) => ℝ) 0) (t, v) = Fin.cons t v := by
          ext i
          refine Fin.cases ?_ (fun k => ?_) i <;> simp
        rw [hcons_tv, ← Complex.exp_add]
        congr 2
        push_cast
        ring
      have hint_prod : IntegrableOn (fun p : ℝ × (Fin d → ℝ) =>
          (Complex.exp (-Complex.I * Real.pi * (j₀ : ℝ) * p.1) *
            Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j' i : ℝ) * p.2 i)) *
            h (Fin.cons p.1 p.2)) (Set.Ioc (-1 : ℝ) 1 ×ˢ cube) volume := by
        have hcomp : IsCompact (Set.Icc (-1 : ℝ) 1 ×ˢ Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1)) :=
          isCompact_Icc.prod (isCompact_univ_pi fun _ => isCompact_Icc)
        have hcont : Continuous (fun p : ℝ × (Fin d → ℝ) =>
            (Complex.exp (-Complex.I * Real.pi * (j₀ : ℝ) * p.1) *
              Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j' i : ℝ) * p.2 i)) *
              h (Fin.cons p.1 p.2)) := by
          refine ((Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp continuous_fst))).mul
            (Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
              (continuous_finsetSum _ fun i _ => continuous_const.mul ((continuous_apply i).comp continuous_snd)))))).mul ?_
          exact hh.comp (continuous_pi fun i =>
            Fin.cases continuous_fst (fun k => (continuous_apply k).comp continuous_snd) i)
        refine (hcont.continuousOn.integrableOn_compact hcomp).mono_set ?_
        exact Set.prod_mono Set.Ioc_subset_Icc_self (Set.pi_mono fun _ _ => Set.Ioc_subset_Icc_self)
      rw [IntegrableOn, Measure.volume_eq_prod, ← Measure.prod_restrict] at hint_prod
      rw [hpow, hint_split, Measure.volume_eq_prod, ← Measure.prod_restrict,
        integral_prod_symm _ hint_prod]
      rw [mul_assoc, ← integral_const_mul]
      congr 1
      refine setIntegral_congr_fun (MeasurableSet.univ_pi fun _ => measurableSet_Ioc) fun v _ => ?_
      simp only [H]
      rw [intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
      rw [← integral_const_mul, ← integral_const_mul, ← integral_const_mul]
      refine setIntegral_congr_fun (measurableSet_Ioc (a := (-1 : ℝ)) (b := 1)) fun t _ => ?_
      ring
    calc ∑' j : Fin (d + 1) → ℤ,
          ENNReal.ofReal (‖(2 : ℂ) ^ (-((d + 1 : ℕ) : ℂ) / 2) *
            ∫ u in cube',
              Complex.exp (-Complex.I * Real.pi * ∑ i : Fin (d + 1), (j i : ℝ) * u i) * h u‖ ^ 2)
        = ∑' p : ℤ × (Fin d → ℤ),
            ENNReal.ofReal (‖(2 : ℂ) ^ (-((d + 1 : ℕ) : ℂ) / 2) *
              ∫ u in cube',
                Complex.exp (-Complex.I * Real.pi * ∑ i : Fin (d + 1),
                  ((Fin.cons p.1 p.2 : Fin (d + 1) → ℤ) i : ℝ) * u i) * h u‖ ^ 2) := by
          rw [← eZ.symm.tsum_eq]
          refine tsum_congr fun ⟨j₀, j'⟩ => ?_
          simp [eZ]
      _ = ∑' j₀ : ℤ, ∑' j' : Fin d → ℤ,
            ENNReal.ofReal (‖(2 : ℂ) ^ (-(d : ℂ) / 2) *
              ∫ v in cube,
                Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j' i : ℝ) * v i) * H j₀ v‖ ^ 2) := by
          rw [ENNReal.tsum_prod']
          refine tsum_congr fun j₀ => tsum_congr fun j' => ?_
          rw [hsplit_coeff j₀ j']
      _ = ∑' j₀ : ℤ, ∫⁻ v in cube, ENNReal.ofReal (‖H j₀ v‖ ^ 2) := by
          refine tsum_congr fun j₀ => ih (hH_cont j₀)
      _ = ∫⁻ v in cube, ∑' j₀ : ℤ, ENNReal.ofReal (‖H j₀ v‖ ^ 2) := by
          have hmeas_H : ∀ j₀ : ℤ, AEMeasurable (fun v : Fin d → ℝ => ENNReal.ofReal (‖H j₀ v‖ ^ 2))
              (volume.restrict cube) := fun j₀ =>
            (ENNReal.measurable_ofReal.comp ((hH_cont j₀).norm.measurable.pow_const 2)).aemeasurable
          rw [lintegral_tsum hmeas_H]
      _ = ∫⁻ v in cube, ∫⁻ t in Set.Ioc (-1 : ℝ) 1, ENNReal.ofReal (‖h (Fin.cons t v)‖ ^ 2) := by
          refine lintegral_congr fun v => ?_
          have hv : Continuous (fun t : ℝ => h (Fin.cons t v)) :=
            hh.comp (continuous_pi fun i => Fin.cases continuous_id (fun k => continuous_const) i)
          exact parseval_1d_Ioc hv
      _ = ∫⁻ p : ℝ × (Fin d → ℝ) in Set.Ioc (-1 : ℝ) 1 ×ˢ cube,
            ENNReal.ofReal (‖h (Fin.cons p.1 p.2)‖ ^ 2) := by
          have hmeas_h : AEMeasurable (fun p : ℝ × (Fin d → ℝ) => ENNReal.ofReal (‖h (Fin.cons p.1 p.2)‖ ^ 2))
              ((volume.restrict (Set.Ioc (-1 : ℝ) 1)).prod (volume.restrict cube)) :=
            (ENNReal.measurable_ofReal.comp
              (((hh.comp (continuous_pi fun i =>
                Fin.cases continuous_fst (fun k => (continuous_apply k).comp continuous_snd) i)).norm.measurable).pow_const 2)).aemeasurable
          rw [show (volume : Measure (ℝ × (Fin d → ℝ))).restrict (Set.Ioc (-1 : ℝ) 1 ×ˢ cube) =
              (volume.restrict (Set.Ioc (-1 : ℝ) 1)).prod (volume.restrict cube) by
            rw [Measure.volume_eq_prod, Measure.prod_restrict]]
          exact (lintegral_prod_symm _ hmeas_h).symm
      _ = ∫⁻ u in cube', ENNReal.ofReal (‖h u‖ ^ 2) := by
          have hcons_eq : ∀ p : ℝ × (Fin d → ℝ),
              Fin.cons p.1 p.2 = (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (d + 1) => ℝ) 0).symm p := by
            rintro ⟨t, v⟩
            ext i
            refine Fin.cases ?_ (fun k => ?_) i <;> simp
          simp_rw [← hpre, hcons_eq]
          exact hmp.setLIntegral_comp_preimage_emb (MeasurableEquiv.measurableEmbedding _)
            (fun u => ENNReal.ofReal (‖h u‖ ^ 2)) cube'

/-- Parseval frame identity: for every continuous `g ∈ L²(EuclideanSpace ℝ (Fin d), ℂ)`,
the squared frame coefficients sum to `∫ x, ‖g x‖^2`. -/
theorem tsum_norm_sq_frameCoeff (d : ℕ) {g : EuclideanSpace ℝ (Fin d) → ℂ}
    (hg : Continuous g) (hg_int : Integrable (fun x => ‖g x‖ ^ 2) volume) :
    ∑' p : (Fin d → ℤ) × (Fin d → ℤ), ‖frameCoeff d p.1 p.2 g‖ ^ 2 = ∫ x, ‖g x‖ ^ 2 := by
  have henn :
      ∑' p : (Fin d → ℤ) × (Fin d → ℤ), ENNReal.ofReal (‖frameCoeff d p.1 p.2 g‖ ^ 2) =
        ENNReal.ofReal (∫ x, ‖g x‖ ^ 2) := by
    rw [ENNReal.tsum_prod']
    have hfixed_z : ∀ z : Fin d → ℤ,
        ∑' j : Fin d → ℤ, ENNReal.ofReal (‖frameCoeff d z j g‖ ^ 2) =
          ∫⁻ x : EuclideanSpace ℝ (Fin d),
            ENNReal.ofReal ((unitBump d (x - intVec z)) ^ 2 * ‖g x‖ ^ 2) := by
      intro z
      let e := MeasurableEquiv.toLp 2 (Fin d → ℝ)
      have hmpE : MeasurePreserving e volume volume :=
        PiLp.volume_preserving_toLp (Fin d)
      let h_z : (Fin d → ℝ) → ℂ := fun u => (unitBump d (e u) : ℂ) * g (intVec z + e u)
      have hh_cont : Continuous h_z :=
        (Complex.continuous_ofReal.comp ((contDiff_unitBump d).continuous.comp
          (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ)))).mul
          (hg.comp (continuous_const.add (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))))
      let cube : Set (Fin d → ℝ) := Set.univ.pi (fun _ : Fin d => Set.Ioc (-1 : ℝ) 1)
      have hfc_eq : ∀ j : Fin d → ℤ,
          frameCoeff d z j g =
            (2 : ℂ) ^ (-(d : ℂ) / 2) *
              ∫ u in cube,
                Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) * h_z u := by
        intro j
        rw [frameCoeff_eq_shift]
        congr 1
        have hcont_int : Continuous (fun u : EuclideanSpace ℝ (Fin d) =>
            (unitBump d u : ℂ) * Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) *
              g (intVec z + u)) :=
          ((Complex.continuous_ofReal.comp (contDiff_unitBump d).continuous).mul
            (Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
              (continuous_finsetSum _ fun i _ => continuous_const.mul (EuclideanSpace.proj i).continuous))))).mul
            (hg.comp (continuous_const.add continuous_id))
        have hcomp_int :
            ∫ u : EuclideanSpace ℝ (Fin d),
                (unitBump d u : ℂ) * Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) *
                  g (intVec z + u) =
              ∫ u : Fin d → ℝ,
                Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) * h_z u := by
          rw [← hmpE.map_eq, integral_map hmpE.measurable.aemeasurable hcont_int.aestronglyMeasurable]
          refine integral_congr_ae (ae_of_all _ fun u => ?_)
          simp only [h_z, e, MeasurableEquiv.toLp_apply]
          ring
        rw [hcomp_int]
        symm
        refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
        have h0 : unitBump d (e u) = 0 := by
          by_contra hne
          apply hu
          intro i _
          have hi := support_unitBump_subset d hne i
          exact Set.Ioo_subset_Ioc_self hi
        simp [h_z, h0]
      simp_rw [hfc_eq]
      rw [parseval_cube_ennreal d hh_cont]
      have hset_eq : ∫⁻ u in cube, ENNReal.ofReal (‖h_z u‖ ^ 2) =
          ∫⁻ u : Fin d → ℝ, ENNReal.ofReal (‖h_z u‖ ^ 2) := by
        refine setLIntegral_eq_of_support_subset fun u hu => ?_
        by_contra hnot
        apply hu
        have h0 : unitBump d (e u) = 0 := by
          by_contra hne
          apply hnot
          intro i _
          exact Set.Ioo_subset_Ioc_self (support_unitBump_subset d hne i)
        simp [h_z, h0]
      rw [hset_eq]
      have hmp_comp : MeasurePreserving (fun u : Fin d → ℝ => intVec z + e u) volume volume :=
        (measurePreserving_add_left volume (intVec z)).comp hmpE
      have hEq_pt : ∀ u : Fin d → ℝ,
          ENNReal.ofReal (‖h_z u‖ ^ 2) =
            ENNReal.ofReal ((unitBump d ((intVec z + e u) - intVec z)) ^ 2 * ‖g (intVec z + e u)‖ ^ 2) := by
        intro u
        simp only [h_z, norm_mul, mul_pow, Complex.norm_real,
          Real.norm_eq_abs, sq_abs, add_sub_cancel_left]
      simp_rw [hEq_pt]
      exact hmp_comp.lintegral_comp (f := fun x : EuclideanSpace ℝ (Fin d) =>
          ENNReal.ofReal ((unitBump d (x - intVec z)) ^ 2 * ‖g x‖ ^ 2))
        (ENNReal.measurable_ofReal.comp
          ((((contDiff_unitBump d).continuous.comp (continuous_id.sub continuous_const)).measurable.pow_const 2).mul
            (hg.norm.measurable.pow_const 2)))
    simp_rw [hfixed_z]
    have hmeas_z : ∀ z : Fin d → ℤ, AEMeasurable
        (fun x : EuclideanSpace ℝ (Fin d) =>
          ENNReal.ofReal ((unitBump d (x - intVec z)) ^ 2 * ‖g x‖ ^ 2)) volume := fun z =>
      (ENNReal.measurable_ofReal.comp
        (((((contDiff_unitBump d).continuous.comp (continuous_id.sub continuous_const)).measurable).pow_const 2).mul
          (hg.norm.measurable.pow_const 2))).aemeasurable
    rw [← lintegral_tsum hmeas_z]
    have hpt : ∀ x : EuclideanSpace ℝ (Fin d),
        ∑' z : Fin d → ℤ, ENNReal.ofReal ((unitBump d (x - intVec z)) ^ 2 * ‖g x‖ ^ 2) =
          ENNReal.ofReal (‖g x‖ ^ 2) := by
      intro x
      simp_rw [ENNReal.ofReal_mul (sq_nonneg _), ENNReal.tsum_mul_right]
      have hsum : Summable (fun z : Fin d → ℤ => (unitBump d (x - intVec z)) ^ 2) := by
        let S : Fin d → Finset ℤ := fun i => Finset.Icc (⌊x i⌋ - 1) (⌈x i⌉ + 1)
        refine summable_of_ne_finset_zero (s := Fintype.piFinset S) fun z hz => ?_
        rw [Fintype.mem_piFinset, not_forall] at hz
        rcases hz with ⟨i, hi⟩
        have hge : 3 / 4 ≤ |x i - (z i : ℝ)| := by
          by_contra hlt
          push Not at hlt
          exact hi (int_mem_Icc_of_abs_sub_lt ⟨by linarith, by linarith⟩ hlt)
        rw [unitBump_eq_zero_of_exists_le_abs ⟨i, by simpa using hge⟩, zero_pow two_ne_zero]
      rw [← ENNReal.ofReal_tsum_of_nonneg (fun _ => sq_nonneg _) hsum, tsum_unitBump_sq,
        ENNReal.ofReal_one, one_mul]
    simp_rw [hpt]
    exact (ofReal_integral_eq_lintegral_ofReal hg_int (ae_of_all _ fun _ => sq_nonneg _)).symm
  have hsum : Summable (fun p : (Fin d → ℤ) × (Fin d → ℤ) => ‖frameCoeff d p.1 p.2 g‖ ^ 2) := by
    refine (tsum_ofReal_ne_top_iff_summable (fun _ => sq_nonneg _)).mp ?_
    rw [henn]
    exact ENNReal.ofReal_ne_top
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun _ => sq_nonneg _) hsum] at henn
  exact (ENNReal.ofReal_eq_ofReal_iff (tsum_nonneg fun _ => sq_nonneg _)
    (integral_nonneg fun _ => sq_nonneg _)).mp henn

theorem summable_norm_sq_frameCoeff (d : ℕ) {g : EuclideanSpace ℝ (Fin d) → ℂ}
    (hg : Continuous g) (hg_int : Integrable (fun x => ‖g x‖ ^ 2) volume) :
    Summable (fun p : (Fin d → ℤ) × (Fin d → ℤ) => ‖frameCoeff d p.1 p.2 g‖ ^ 2) := by
  by_contra hnot
  have h0 := tsum_eq_zero_of_not_summable hnot
  rw [tsum_norm_sq_frameCoeff d hg hg_int] at h0
  have hge0 : ∀ x, 0 ≤ ‖g x‖ ^ 2 := fun x => sq_nonneg _
  have hg0 : g = 0 := by
    ext x
    have hae := (integral_eq_zero_iff_of_nonneg hge0 hg_int).mp h0
    have hnorm0 : (fun y => ‖g y‖ ^ 2) = 0 :=
      ((hg.norm.pow 2).ae_eq_iff_eq volume continuous_const).mp hae
    have hx := congrFun hnorm0 x
    simpa using hx
  apply hnot
  have : (fun p : (Fin d → ℤ) × (Fin d → ℤ) => ‖frameCoeff d p.1 p.2 g‖ ^ 2) = 0 := by
    ext p
    simp [frameCoeff, hg0]
  rw [this]
  exact summable_zero

/-! #### Coordinate Integration-by-Parts Decay Bound -/

private lemma intervalIntegral_fourier_ibp_1d {F : ℝ → ℂ} (hF : ContDiff ℝ 2 F)
    (hF_neg : F (-1) = 0) (hF_pos : F 1 = 0)
    (hd_neg : deriv F (-1) = 0) (hd_pos : deriv F 1 = 0) (k : ℤ) :
    ∫ t in (-1 : ℝ)..1, Complex.exp (-Complex.I * Real.pi * (k : ℝ) * t) * F t =
      (((1 + (k : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) *
        ∫ t in (-1 : ℝ)..1,
          Complex.exp (-Complex.I * Real.pi * (k : ℝ) * t) *
            (F t - (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) * deriv (deriv F) t) := by
  let c : ℂ := -Complex.I * Real.pi * (k : ℝ)
  let u : ℝ → ℂ := fun t => Complex.exp (c * t)
  have hu : ∀ t, HasDerivAt u (c * u t) t := by
    intro t
    have h1 : HasDerivAt (fun s : ℝ => c * (s : ℂ)) c t := by
      simpa using (Complex.ofRealCLM.hasDerivAt (x := t)).const_mul c
    simpa [u, mul_comm] using h1.cexp
  have hF_diff : Differentiable ℝ F := hF.differentiable (by norm_num)
  have hdF_contDiff : ContDiff ℝ ((0 : ℕ∞) + 1) (deriv F) := hF.deriv'
  have hdF_diff : Differentiable ℝ (deriv F) := hdF_contDiff.differentiable (by norm_num)
  have hddF_cont : Continuous (deriv (deriv F)) := hdF_contDiff.deriv'.continuous
  have hibp1 : ∫ t in (-1 : ℝ)..1, u t * deriv (deriv F) t =
      -∫ t in (-1 : ℝ)..1, (c * u t) * deriv F t := by
    have h := intervalIntegral.integral_mul_deriv_eq_deriv_mul
      (a := -1) (b := 1) (u := u) (u' := fun t => c * u t)
      (v := deriv F) (v' := deriv (deriv F))
      (fun t _ => hu t) (fun t _ => (hdF_diff t).hasDerivAt)
      ((continuous_const.mul (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal))).intervalIntegrable _ _)
      (hddF_cont.intervalIntegrable _ _)
    rw [hd_pos, hd_neg, mul_zero, mul_zero, sub_self, zero_sub] at h
    exact h
  have hibp2 : ∫ t in (-1 : ℝ)..1, u t * deriv F t =
      -∫ t in (-1 : ℝ)..1, (c * u t) * F t := by
    have h := intervalIntegral.integral_mul_deriv_eq_deriv_mul
      (a := -1) (b := 1) (u := u) (u' := fun t => c * u t)
      (v := F) (v' := deriv F)
      (fun t _ => hu t) (fun t _ => (hF_diff t).hasDerivAt)
      ((continuous_const.mul (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal))).intervalIntegrable _ _)
      (hdF_contDiff.continuous.intervalIntegrable _ _)
    rw [hF_pos, hF_neg, mul_zero, mul_zero, sub_self, zero_sub] at h
    exact h
  have h2 : ∫ t in (-1 : ℝ)..1, u t * deriv (deriv F) t =
      c ^ 2 * ∫ t in (-1 : ℝ)..1, u t * F t := by
    rw [hibp1]
    have hlin1 : (fun t => c * u t * deriv F t) = fun t => c * (u t * deriv F t) := by
      ext t; ring
    have hlin2 : (fun t => c * u t * F t) = fun t => c * (u t * F t) := by
      ext t; ring
    rw [hlin1, intervalIntegral.integral_const_mul, hibp2, hlin2,
      intervalIntegral.integral_const_mul]
    ring
  have hc2 : c ^ 2 = -((Real.pi : ℂ) ^ 2 * (k : ℂ) ^ 2) := by
    simp only [c]
    push_cast
    ring_nf
    rw [Complex.I_sq]
    ring
  have hpi0 : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hint1 : IntervalIntegrable (fun t => u t * F t) volume (-1) 1 :=
    ((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).mul hF.continuous).intervalIntegrable _ _
  have hint2 : IntervalIntegrable (fun t => (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) * (u t * deriv (deriv F) t)) volume (-1) 1 :=
    (continuous_const.mul ((Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).mul hddF_cont)).intervalIntegrable _ _
  have hRHS :
      ∫ t in (-1 : ℝ)..1, u t * (F t - (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) * deriv (deriv F) t) =
        (((1 + (k : ℝ) ^ 2 : ℝ) : ℂ)) * ∫ t in (-1 : ℝ)..1, u t * F t := by
    have hsub : (fun t => u t * (F t - (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) * deriv (deriv F) t)) =
        fun t => u t * F t - (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) * (u t * deriv (deriv F) t) := by
      ext t; ring
    rw [hsub, intervalIntegral.integral_sub hint1 hint2,
      intervalIntegral.integral_const_mul, h2, hc2]
    push_cast
    field_simp [hpi0]
    ring
  have hpos : (0 : ℝ) < 1 + (k : ℝ) ^ 2 := by positivity
  change ∫ t in (-1 : ℝ)..1, u t * F t =
    (((1 + (k : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) *
      ∫ t in (-1 : ℝ)..1, u t * (F t - (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) * deriv (deriv F) t)
  rw [hRHS, ← mul_assoc]
  have hinv : (((1 + (k : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) * ((1 + (k : ℝ) ^ 2 : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, inv_mul_cancel₀ hpos.ne', Complex.ofReal_one]
  rw [hinv, one_mul]

/-- Closed unit cube `[-1, 1]^d` inside `EuclideanSpace ℝ (Fin d)`. -/
def unitCube (d : ℕ) : Set (EuclideanSpace ℝ (Fin d)) :=
  {u : EuclideanSpace ℝ (Fin d) | ∀ i : Fin d, u i ∈ Set.Icc (-1 : ℝ) 1}

private lemma isOpen_outside_three_quarters (d : ℕ) :
    IsOpen {x : EuclideanSpace ℝ (Fin d) | ∃ r : Fin d, 3 / 4 < |x r|} := by
  have hEq : {x : EuclideanSpace ℝ (Fin d) | ∃ r : Fin d, 3 / 4 < |x r|} =
      ⋃ r : Fin d, {x : EuclideanSpace ℝ (Fin d) | 3 / 4 < |x r|} := by
    ext x; simp
  rw [hEq]
  exact isOpen_iUnion fun r => isOpen_lt continuous_const (EuclideanSpace.proj r).continuous.abs

private noncomputable def coordDeriv {d : ℕ} (i : Fin d)
    (F : EuclideanSpace ℝ (Fin d) → ℂ) (x : EuclideanSpace ℝ (Fin d)) : ℂ :=
  fderiv ℝ F x (EuclideanSpace.single i (1 : ℝ))

private noncomputable def coordOp {d : ℕ} (i : Fin d)
    (F : EuclideanSpace ℝ (Fin d) → ℂ) (x : EuclideanSpace ℝ (Fin d)) : ℂ :=
  F x - (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) * coordDeriv i (coordDeriv i F) x

private lemma contDiff_coordDeriv {d n : ℕ} (i : Fin d) {F : EuclideanSpace ℝ (Fin d) → ℂ}
    (hF : ContDiff ℝ (n + 1 : ℕ) F) : ContDiff ℝ n (coordDeriv i F) := by
  have hfderiv : ContDiff ℝ n (fderiv ℝ F) := hF.fderiv_right (by norm_cast)
  exact hfderiv.clm_apply contDiff_const

private lemma norm_iteratedFDeriv_coordDeriv_le {d n : ℕ} (i : Fin d)
    {F : EuclideanSpace ℝ (Fin d) → ℂ} (hF : ContDiff ℝ (n + 1 : ℕ) F)
    {k : ℕ} (hk : k ≤ n) (x : EuclideanSpace ℝ (Fin d)) :
    ‖iteratedFDeriv ℝ k (coordDeriv i F) x‖ ≤ ‖iteratedFDeriv ℝ (k + 1) F x‖ := by
  have hfderiv : ContDiffAt ℝ k (fderiv ℝ F) x :=
    (hF.fderiv_right (m := k) (by exact_mod_cast Nat.add_le_add_right hk 1)).contDiffAt
  have h1 := norm_iteratedFDeriv_clm_apply_const hfderiv (c := EuclideanSpace.single i (1 : ℝ))
    (le_refl (k : WithTop ℕ∞))
  have hnorm_e : ‖EuclideanSpace.single i (1 : ℝ)‖ = 1 := by simp
  rw [hnorm_e, one_mul, norm_iteratedFDeriv_fderiv] at h1
  exact h1

private lemma coordDeriv_eq_zero_on_open {d : ℕ} (i : Fin d)
    {F : EuclideanSpace ℝ (Fin d) → ℂ} {U : Set (EuclideanSpace ℝ (Fin d))} (hU : IsOpen U)
    (hF : ∀ x ∈ U, F x = 0) {x : EuclideanSpace ℝ (Fin d)} (hx : x ∈ U) :
    coordDeriv i F x = 0 := by
  have hev : F =ᶠ[𝓝 x] 0 := Filter.eventuallyEq_iff_exists_mem.mpr ⟨U, hU.mem_nhds hx, hF⟩
  simp [coordDeriv, hev.fderiv_eq]

private lemma coordOp_preserves {d n : ℕ} (i : Fin d) {F : EuclideanSpace ℝ (Fin d) → ℂ}
    {U : Set (EuclideanSpace ℝ (Fin d))} (hU : IsOpen U) {B : ℝ}
    (hF_cd : ContDiff ℝ (n + 2 : ℕ) F)
    (hF_zero : ∀ x ∈ U, F x = 0)
    (hF_bd : ∀ k ≤ n + 2, ∀ x, ‖iteratedFDeriv ℝ k F x‖ ≤ B) :
    ContDiff ℝ n (coordOp i F) ∧
      (∀ x ∈ U, coordOp i F x = 0) ∧
      (∀ k ≤ n, ∀ x, ‖iteratedFDeriv ℝ k (coordOp i F) x‖ ≤ (1 + (Real.pi ^ 2)⁻¹) * B) := by
  have hcd1 : ContDiff ℝ (n + 1 : ℕ) (coordDeriv i F) := contDiff_coordDeriv i hF_cd
  have hcd2 : ContDiff ℝ n (coordDeriv i (coordDeriv i F)) := contDiff_coordDeriv i hcd1
  refine ⟨(hF_cd.of_le (by exact_mod_cast Nat.le_add_right n 2)).sub
    (contDiff_const.mul hcd2), ?_, ?_⟩
  · intro x hx
    have h0 := hF_zero x hx
    have h1 : ∀ y ∈ U, coordDeriv i F y = 0 := fun y hy => coordDeriv_eq_zero_on_open i hU hF_zero hy
    have h2 : coordDeriv i (coordDeriv i F) x = 0 := coordDeriv_eq_zero_on_open i hU h1 hx
    simp [coordOp, h0, h2]
  · intro k hk x
    have hF_k : ContDiff ℝ k F :=
      hF_cd.of_le (by exact_mod_cast le_trans hk (Nat.le_add_right n 2))
    have hcd2_k : ContDiff ℝ k (coordDeriv i (coordDeriv i F)) :=
      hcd2.of_le (by exact_mod_cast hk)
    have h2_k : ContDiff ℝ k ((((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) • coordDeriv i (coordDeriv i F)) := by
      change ContDiff ℝ k (fun y => (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) • coordDeriv i (coordDeriv i F) y)
      exact hcd2_k.const_smul (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ)
    have hsub : iteratedFDeriv ℝ k (coordOp i F) x =
        iteratedFDeriv ℝ k F x -
          (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) • iteratedFDeriv ℝ k (coordDeriv i (coordDeriv i F)) x := by
      change iteratedFDeriv ℝ k (F - (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) • coordDeriv i (coordDeriv i F)) x = _
      rw [iteratedFDeriv_sub hF_k h2_k, Pi.sub_apply, iteratedFDeriv_const_smul_apply hcd2_k.contDiffAt]
    rw [hsub]
    calc ‖iteratedFDeriv ℝ k F x -
            (((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) • iteratedFDeriv ℝ k (coordDeriv i (coordDeriv i F)) x‖
        ≤ ‖iteratedFDeriv ℝ k F x‖ +
            ‖(((Real.pi ^ 2)⁻¹ : ℝ) : ℂ) • iteratedFDeriv ℝ k (coordDeriv i (coordDeriv i F)) x‖ :=
          norm_sub_le _ _
      _ = ‖iteratedFDeriv ℝ k F x‖ +
            (Real.pi ^ 2)⁻¹ * ‖iteratedFDeriv ℝ k (coordDeriv i (coordDeriv i F)) x‖ := by
          rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      _ ≤ B + (Real.pi ^ 2)⁻¹ * ‖iteratedFDeriv ℝ (k + 2) F x‖ := by
          gcongr
          · exact hF_bd k (le_trans hk (Nat.le_add_right n 2)) x
          · exact (norm_iteratedFDeriv_coordDeriv_le i hcd1 hk x).trans
              (norm_iteratedFDeriv_coordDeriv_le i hF_cd (Nat.add_le_add_right hk 1) x)
      _ ≤ B + (Real.pi ^ 2)⁻¹ * B := by
          gcongr
          exact hF_bd (k + 2) (Nat.add_le_add_right hk 2) x
      _ = (1 + (Real.pi ^ 2)⁻¹) * B := by ring

private lemma hasDerivAt_insertNth_toLp {n : ℕ} (i : Fin (n + 1))
    (v : Fin n → ℝ) (t : ℝ) :
    HasDerivAt (fun s : ℝ =>
        (WithLp.equiv 2 (Fin (n + 1) → ℝ)).symm (i.insertNth s v))
      (EuclideanSpace.single i (1 : ℝ)) t := by
  have hlin : (fun s : ℝ => (WithLp.equiv 2 (Fin (n + 1) → ℝ)).symm (i.insertNth s v)) =
      fun s => (WithLp.equiv 2 (Fin (n + 1) → ℝ)).symm (i.insertNth 0 v) +
        s • EuclideanSpace.single i (1 : ℝ) := by
    ext s k
    by_cases hki : k = i
    · subst hki
      simp
    · obtain ⟨m, rfl⟩ := Fin.exists_succAbove_eq hki
      simp [Fin.succAbove_ne]
  rw [hlin]
  simpa using ((hasDerivAt_id t).smul_const (EuclideanSpace.single i (1 : ℝ))).const_add
    ((WithLp.equiv 2 (Fin (n + 1) → ℝ)).symm (i.insertNth 0 v))

private lemma integral_fourier_eq_coordOp {d : ℕ} (i : Fin d) (j : Fin d → ℤ)
    {F : EuclideanSpace ℝ (Fin d) → ℂ} (hF : ContDiff ℝ 2 F)
    (hF_supp : ∀ x : EuclideanSpace ℝ (Fin d), (∃ r, 3 / 4 < |x r|) → F x = 0) :
    ∫ u : EuclideanSpace ℝ (Fin d),
        Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) * F u =
      (((1 + (j i : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) *
        ∫ u : EuclideanSpace ℝ (Fin d),
          Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) * coordOp i F u := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
    let e := MeasurableEquiv.toLp 2 (Fin (n + 1) → ℝ)
    have hmpE : MeasurePreserving e volume volume :=
      PiLp.volume_preserving_toLp (Fin (n + 1))
    let cube : Set (Fin (n + 1) → ℝ) := Set.univ.pi (fun _ => Set.Ioc (-1 : ℝ) 1)
    let cubeN : Set (Fin n → ℝ) := Set.univ.pi (fun _ => Set.Ioc (-1 : ℝ) 1)
    let U : Set (EuclideanSpace ℝ (Fin (n + 1))) := {x | ∃ r, 3 / 4 < |x r|}
    have hU_open : IsOpen U := isOpen_outside_three_quarters (n + 1)
    have hOp_zero : ∀ x ∈ U, coordOp i F x = 0 := by
      intro x hx
      have h0 := hF_supp x hx
      have h1 : ∀ y ∈ U, coordDeriv i F y = 0 := fun y hy =>
        coordDeriv_eq_zero_on_open i hU_open hF_supp hy
      have h2 := coordDeriv_eq_zero_on_open i hU_open h1 hx
      simp [coordOp, h0, h2]
    have hOp_cont : Continuous (coordOp i F) := by
      have h1 : ContDiff ℝ 1 (coordDeriv i F) := contDiff_coordDeriv i hF
      have h2 : ContDiff ℝ 0 (coordDeriv i (coordDeriv i F)) := contDiff_coordDeriv i h1
      exact hF.continuous.sub (continuous_const.mul h2.continuous)
    have htrans : ∀ (G : EuclideanSpace ℝ (Fin (n + 1)) → ℂ),
        Continuous G → (∀ x ∈ U, G x = 0) →
        ∫ u : EuclideanSpace ℝ (Fin (n + 1)),
            Complex.exp (-Complex.I * Real.pi * ∑ r : Fin (n + 1), (j r : ℝ) * u r) * G u =
          ∫ v in cubeN,
            Complex.exp (-Complex.I * Real.pi * ∑ m : Fin n, (j (i.succAbove m) : ℝ) * v m) *
              ∫ t in (-1 : ℝ)..1,
                Complex.exp (-Complex.I * Real.pi * (j i : ℝ) * t) * G (e (i.insertNth t v)) := by
      intro G hG_cont hG_zero
      rw [← hmpE.integral_comp' (g := fun u =>
        Complex.exp (-Complex.I * Real.pi * ∑ r : Fin (n + 1), (j r : ℝ) * u r) * G u)]
      have hset : ∫ u : Fin (n + 1) → ℝ,
            Complex.exp (-Complex.I * Real.pi * ∑ r : Fin (n + 1), (j r : ℝ) * (e u) r) * G (e u) =
          ∫ u in cube,
            Complex.exp (-Complex.I * Real.pi * ∑ r : Fin (n + 1), (j r : ℝ) * u r) * G (e u) := by
        symm
        refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
        have hmemU : e u ∈ U := by
          simp only [cube, Set.mem_univ_pi, Set.mem_Ioc, not_forall] at hu
          rcases hu with ⟨r, hr⟩
          refine ⟨r, ?_⟩
          rw [not_and_or, not_lt, not_le] at hr
          rcases hr with h1 | h2
          · have : -(e u r) ≥ 1 := by simpa [e] using neg_le_neg h1
            linarith [neg_le_abs (e u r)]
          · have : e u r > 1 := by simpa [e] using h2
            linarith [le_abs_self (e u r)]
        simp [hG_zero (e u) hmemU]
      rw [hset]
      have hmpPi := (MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm
      have hpre : (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm ⁻¹' cube =
          Set.Ioc (-1 : ℝ) 1 ×ˢ cubeN := by
        ext ⟨t, v⟩
        simp only [Set.mem_preimage, Set.mem_prod, cube, cubeN, Set.mem_univ_pi,
          MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_apply]
        constructor
        · intro htv
          exact ⟨by simpa using htv i, fun m => by simpa using htv (i.succAbove m)⟩
        · rintro ⟨ht, hv⟩ r
          by_cases hri : r = i
          · subst hri; simpa using ht
          · obtain ⟨m, rfl⟩ := Fin.exists_succAbove_eq hri
            simpa using hv m
      rw [← hmpPi.setIntegral_preimage_emb (MeasurableEquiv.measurableEmbedding _), hpre]
      have hprod_int : IntegrableOn (fun p : ℝ × (Fin n → ℝ) =>
          Complex.exp (-Complex.I * Real.pi * ∑ r : Fin (n + 1),
            (j r : ℝ) * (i.insertNth p.1 p.2 : Fin (n + 1) → ℝ) r) * G (e (i.insertNth p.1 p.2)))
          (Set.Ioc (-1 : ℝ) 1 ×ˢ cubeN) volume := by
        have hcomp : IsCompact (Set.Icc (-1 : ℝ) 1 ×ˢ Set.univ.pi (fun _ : Fin n => Set.Icc (-1 : ℝ) 1)) :=
          isCompact_Icc.prod (isCompact_univ_pi fun _ => isCompact_Icc)
        have hins_cont : Continuous (fun p : ℝ × (Fin n → ℝ) => (i.insertNth p.1 p.2 : Fin (n + 1) → ℝ)) := by
          refine continuous_pi fun r => ?_
          by_cases hri : r = i
          · subst hri; simpa using continuous_fst
          · obtain ⟨m, rfl⟩ := Fin.exists_succAbove_eq hri
            have hEq_m : (fun p : ℝ × (Fin n → ℝ) => (i.insertNth p.1 p.2 : Fin (n + 1) → ℝ) (i.succAbove m)) =
                fun p => p.2 m := by ext p; simp
            rw [hEq_m]
            exact (continuous_apply m).comp continuous_snd
        have hcont : Continuous (fun p : ℝ × (Fin n → ℝ) =>
            Complex.exp (-Complex.I * Real.pi * ∑ r : Fin (n + 1),
              (j r : ℝ) * (i.insertNth p.1 p.2 : Fin (n + 1) → ℝ) r) * G (e (i.insertNth p.1 p.2))) :=
          (Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
            (continuous_finsetSum _ fun r _ => continuous_const.mul ((continuous_apply r).comp hins_cont))))).mul
            (hG_cont.comp ((PiLp.continuous_toLp 2 (fun _ : Fin (n + 1) => ℝ)).comp hins_cont))
        exact (hcont.continuousOn.integrableOn_compact hcomp).mono_set
          (Set.prod_mono Set.Ioc_subset_Icc_self (Set.pi_mono fun _ _ => Set.Ioc_subset_Icc_self))
      rw [IntegrableOn, Measure.volume_eq_prod, ← Measure.prod_restrict] at hprod_int
      rw [Measure.volume_eq_prod, ← Measure.prod_restrict]
      have hins_eq : ∀ p : ℝ × (Fin n → ℝ),
          (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).symm p = i.insertNth p.1 p.2 :=
        fun ⟨_, _⟩ => rfl
      simp_rw [hins_eq]
      rw [integral_prod_symm _ hprod_int]
      refine setIntegral_congr_fun (MeasurableSet.univ_pi fun _ => measurableSet_Ioc) fun v _ => ?_
      rw [intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1), ← integral_const_mul]
      refine setIntegral_congr_fun measurableSet_Ioc fun t _ => ?_
      rw [← mul_assoc, ← Complex.exp_add]
      congr 2
      rw [Fin.sum_univ_succAbove _ i, Fin.insertNth_apply_same]
      simp only [Fin.insertNth_apply_succAbove]
      push_cast
      ring
    rw [htrans F hF.continuous hF_supp, htrans (coordOp i F) hOp_cont hOp_zero,
      ← integral_const_mul]
    refine setIntegral_congr_fun (MeasurableSet.univ_pi fun _ => measurableSet_Ioc) fun v _ => ?_
    let Fv : ℝ → ℂ := fun t => F (e (i.insertNth t v))
    have hline_cd : ContDiff ℝ (⊤ : ℕ∞) (fun s : ℝ => e (i.insertNth s v)) := by
      have hlin : (fun s : ℝ => e (i.insertNth s v)) =
          fun s => e (i.insertNth 0 v) + s • EuclideanSpace.single i (1 : ℝ) := by
        ext s k
        by_cases hki : k = i
        · subst hki; simp [e]
        · obtain ⟨m, rfl⟩ := Fin.exists_succAbove_eq hki
          simp [e, Fin.succAbove_ne]
      rw [hlin]
      exact contDiff_const.add (contDiff_id.smul contDiff_const)
    have hFv_cd : ContDiff ℝ 2 Fv := hF.comp (hline_cd.of_le (WithTop.coe_le_coe.mpr le_top))
    have hFv_deriv : deriv Fv = fun t => coordDeriv i F (e (i.insertNth t v)) := by
      ext t
      have hd := ((hF.differentiable (by norm_num) _).hasFDerivAt).comp_hasDerivAt t
        (hasDerivAt_insertNth_toLp i v t)
      exact hd.deriv
    have hFv_deriv2 : deriv (deriv Fv) = fun t => coordDeriv i (coordDeriv i F) (e (i.insertNth t v)) := by
      rw [hFv_deriv]
      ext t
      have hcd1 : ContDiff ℝ 1 (coordDeriv i F) := contDiff_coordDeriv i hF
      have hd := ((hcd1.differentiable one_ne_zero _).hasFDerivAt).comp_hasDerivAt t
        (hasDerivAt_insertNth_toLp i v t)
      exact hd.deriv
    have hFv_neg : Fv (-1) = 0 := hF_supp _ ⟨i, by simp [e]; norm_num⟩
    have hFv_pos : Fv 1 = 0 := hF_supp _ ⟨i, by simp [e]; norm_num⟩
    have hd_neg : deriv Fv (-1) = 0 := by
      rw [hFv_deriv]
      exact coordDeriv_eq_zero_on_open i hU_open hF_supp ⟨i, by simp [e]; norm_num⟩
    have hd_pos : deriv Fv 1 = 0 := by
      rw [hFv_deriv]
      exact coordDeriv_eq_zero_on_open i hU_open hF_supp ⟨i, by simp [e]; norm_num⟩
    have hibp := intervalIntegral_fourier_ibp_1d hFv_cd hFv_neg hFv_pos hd_neg hd_pos (j i)
    rw [hFv_deriv2] at hibp
    calc Complex.exp (-Complex.I * Real.pi * ∑ m : Fin n, (j (i.succAbove m) : ℝ) * v m) *
            ∫ t in (-1 : ℝ)..1, Complex.exp (-Complex.I * Real.pi * (j i : ℝ) * t) * Fv t
        = Complex.exp (-Complex.I * Real.pi * ∑ m : Fin n, (j (i.succAbove m) : ℝ) * v m) *
            ((((1 + (j i : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) *
              ∫ t in (-1 : ℝ)..1,
                Complex.exp (-Complex.I * Real.pi * (j i : ℝ) * t) * coordOp i F (e (i.insertNth t v))) := by
          rw [hibp]
          rfl
      _ = (((1 + (j i : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) *
            (Complex.exp (-Complex.I * Real.pi * ∑ m : Fin n, (j (i.succAbove m) : ℝ) * v m) *
              ∫ t in (-1 : ℝ)..1,
                Complex.exp (-Complex.I * Real.pi * (j i : ℝ) * t) * coordOp i F (e (i.insertNth t v))) := by
          ring

private noncomputable def iterCoordOp {d : ℕ} :
    ∀ (m : ℕ), m ≤ d → (EuclideanSpace ℝ (Fin d) → ℂ) → (EuclideanSpace ℝ (Fin d) → ℂ)
  | 0, _, F => F
  | m + 1, hm, F => coordOp ⟨m, hm⟩ (iterCoordOp m (Nat.le_of_succ_le hm) F)

private lemma iterCoordOp_spec {d : ℕ} (j : Fin d → ℤ) {F : EuclideanSpace ℝ (Fin d) → ℂ}
    {B : ℝ}
    (hF_cd : ContDiff ℝ (2 * d : ℕ) F)
    (hF_zero : ∀ x : EuclideanSpace ℝ (Fin d), (∃ r, 3 / 4 < |x r|) → F x = 0)
    (hF_bd : ∀ k ≤ 2 * d, ∀ x, ‖iteratedFDeriv ℝ k F x‖ ≤ B) :
    ∀ (m : ℕ) (hm : m ≤ d),
      ContDiff ℝ (2 * (d - m) : ℕ) (iterCoordOp m hm F) ∧
        (∀ x : EuclideanSpace ℝ (Fin d), (∃ r, 3 / 4 < |x r|) → iterCoordOp m hm F x = 0) ∧
        (∀ k ≤ 2 * (d - m), ∀ x,
          ‖iteratedFDeriv ℝ k (iterCoordOp m hm F) x‖ ≤ (1 + (Real.pi ^ 2)⁻¹) ^ m * B) ∧
        (∫ u : EuclideanSpace ℝ (Fin d),
            Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) * F u =
          (∏ r : Fin d, if r.1 < m then (((1 + (j r : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) else 1) *
            ∫ u : EuclideanSpace ℝ (Fin d),
              Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) *
                iterCoordOp m hm F u) := by
  have hU_open := isOpen_outside_three_quarters d
  intro m
  induction m with
  | zero =>
    intro _
    refine ⟨by simpa [iterCoordOp] using hF_cd, hF_zero, by simpa [iterCoordOp] using hF_bd, ?_⟩
    simp [iterCoordOp]
  | succ m ih =>
    intro hm
    have hm' : m ≤ d := Nat.le_of_succ_le hm
    obtain ⟨hcd_m, hzero_m, hbd_m, hint_m⟩ := ih hm'
    have hsub : 2 * (d - m) = 2 * (d - (m + 1)) + 2 := by omega
    rw [hsub] at hcd_m hbd_m
    have hpres := coordOp_preserves ⟨m, hm⟩ hU_open hcd_m hzero_m hbd_m
    refine ⟨hpres.1, hpres.2.1, ?_, ?_⟩
    · intro k hk x
      calc ‖iteratedFDeriv ℝ k (iterCoordOp (m + 1) hm F) x‖
          ≤ (1 + (Real.pi ^ 2)⁻¹) * ((1 + (Real.pi ^ 2)⁻¹) ^ m * B) := hpres.2.2 k hk x
        _ = (1 + (Real.pi ^ 2)⁻¹) ^ (m + 1) * B := by ring
    · have hibp := integral_fourier_eq_coordOp ⟨m, hm⟩ j
        (hcd_m.of_le (by exact_mod_cast Nat.le_add_left 2 (2 * (d - (m + 1))))) hzero_m
      rw [hint_m, hibp, ← mul_assoc]
      congr 1
      have hprod :
          (∏ r : Fin d, if r.1 < m then (((1 + (j r : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) else 1) *
              (((1 + (j ⟨m, hm⟩ : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) =
            ∏ r : Fin d, if r.1 < m + 1 then (((1 + (j r : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) else 1 := by
        rw [← Finset.prod_erase_mul Finset.univ _ (Finset.mem_univ (⟨m, hm⟩ : Fin d))]
        have hlt_self : ¬((⟨m, hm⟩ : Fin d).1 < m) := Nat.lt_irrefl m
        have hlt_succ : (⟨m, hm⟩ : Fin d).1 < m + 1 := Nat.lt_succ_self m
        simp only [hlt_self, ↓reduceIte, mul_one]
        rw [← Finset.prod_erase_mul Finset.univ
          (fun r : Fin d => if r.1 < m + 1 then (((1 + (j r : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) else 1)
          (Finset.mem_univ (⟨m, hm⟩ : Fin d))]
        simp only [hlt_succ, ↓reduceIte]
        congr 1
        refine Finset.prod_congr rfl fun r hr => ?_
        have hne : r.1 ≠ m := fun h => (Finset.mem_erase.mp hr).1 (Fin.ext h)
        have hiff : r.1 < m ↔ r.1 < m + 1 := by omega
        simp [hiff]
      exact hprod

/-- Coordinate integration-by-parts decay bound for `frameCoeff`: there exists a constant
`C > 0` depending only on `d` such that for any `C^{2d}` function `g` whose derivatives up to
order `2d` are bounded by `M` on `z + [-1, 1]^d`, the frame coefficient decays like
`∏ i, (1 + (j i)^2)⁻¹`. -/
theorem norm_frameCoeff_le (d : ℕ) :
    ∃ C : ℝ, 0 < C ∧
      ∀ (z j : Fin d → ℤ) (g : EuclideanSpace ℝ (Fin d) → ℂ) (M : ℝ),
        ContDiff ℝ (2 * d : ℕ) g →
        0 ≤ M →
        (∀ k ≤ 2 * d, ∀ u ∈ unitCube d, ‖iteratedFDeriv ℝ k g (intVec z + u)‖ ≤ M) →
        ‖frameCoeff d z j g‖ ≤ C * (∏ i : Fin d, (1 + (j i : ℝ) ^ 2)⁻¹) * M := by
  have hcomp_cube : IsCompact (unitCube d) := by
    have hEq : unitCube d = (WithLp.equiv 2 (Fin d → ℝ)).symm ''
        Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1) := by
      ext u
      constructor
      · intro hu
        refine ⟨u.ofLp, fun i _ => hu i, rfl⟩
      · rintro ⟨v, hv, rfl⟩ i
        exact hv i (Set.mem_univ i)
    rw [hEq]
    exact (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))
  have hbump_bd : ∃ K : ℝ, 0 < K ∧ ∀ r ≤ 2 * d, ∀ u ∈ unitCube d,
      ‖iteratedFDeriv ℝ r (fun y : EuclideanSpace ℝ (Fin d) => (unitBump d y : ℂ)) u‖ ≤ K := by
    have h1 : ∀ r : Fin (2 * d + 1), ∃ K_r : ℝ, 0 ≤ K_r ∧ ∀ u ∈ unitCube d,
        ‖iteratedFDeriv ℝ r.1 (fun y : EuclideanSpace ℝ (Fin d) => (unitBump d y : ℂ)) u‖ ≤ K_r := by
      intro r
      have hcd : ContDiff ℝ (⊤ : ℕ∞) (fun y : EuclideanSpace ℝ (Fin d) => (unitBump d y : ℂ)) :=
        Complex.ofRealCLM.contDiff.comp (contDiff_unitBump d)
      have hcont : Continuous (fun u : EuclideanSpace ℝ (Fin d) =>
          ‖iteratedFDeriv ℝ r.1 (fun y => (unitBump d y : ℂ)) u‖) :=
        ((hcd.of_le (WithTop.coe_le_coe.mpr le_top)).continuous_iteratedFDeriv le_rfl).norm
      rcases hcomp_cube.exists_bound_of_continuousOn hcont.continuousOn with ⟨K_r, hK_r⟩
      refine ⟨max K_r 0, le_max_right _ _, fun u hu => ?_⟩
      have := hK_r u hu
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] at this
      exact le_trans this (le_max_left _ _)
    choose K_r hK_r0 hK_r using h1
    have hsum0 : 0 ≤ ∑ r : Fin (2 * d + 1), K_r r :=
      Finset.sum_nonneg fun r _ => hK_r0 r
    refine ⟨1 + ∑ r : Fin (2 * d + 1), K_r r, by linarith, fun r hr u hu => ?_⟩
    have hle : K_r ⟨r, Nat.lt_succ_of_le hr⟩ ≤ ∑ s : Fin (2 * d + 1), K_r s :=
      Finset.single_le_sum (fun s _ => hK_r0 s) (Finset.mem_univ _)
    linarith [hK_r ⟨r, Nat.lt_succ_of_le hr⟩ u hu]
  rcases hbump_bd with ⟨K, hK_pos, hK⟩
  let C : ℝ := (2 : ℝ) ^ (-(d : ℝ) / 2) * (2 : ℝ) ^ d * (1 + (Real.pi ^ 2)⁻¹) ^ d *
    (K * (2 : ℝ) ^ (2 * d))
  have hC_pos : 0 < C := by positivity
  refine ⟨C, hC_pos, fun z j g M hg hM hg_bd => ?_⟩
  let F : EuclideanSpace ℝ (Fin d) → ℂ := fun u => (unitBump d u : ℂ) * g (intVec z + u)
  have hF_cd : ContDiff ℝ (2 * d : ℕ) F := by
    have h1 : ContDiff ℝ (2 * d : ℕ) (fun u : EuclideanSpace ℝ (Fin d) => (unitBump d u : ℂ)) :=
      (Complex.ofRealCLM.contDiff.comp (contDiff_unitBump d)).of_le (WithTop.coe_le_coe.mpr le_top)
    have h2 : ContDiff ℝ (2 * d : ℕ) (fun u : EuclideanSpace ℝ (Fin d) => g (intVec z + u)) :=
      hg.comp (contDiff_const.add contDiff_id)
    exact h1.mul h2
  have hF_zero : ∀ u : EuclideanSpace ℝ (Fin d), (∃ r, 3 / 4 < |u r|) → F u = 0 := by
    intro u ⟨r, hr⟩
    simp [F, unitBump_eq_zero_of_exists_le_abs ⟨r, hr.le⟩]
  let B : ℝ := K * (2 : ℝ) ^ (2 * d) * M
  have hB : 0 ≤ B := by positivity
  have hF_bd : ∀ k ≤ 2 * d, ∀ u : EuclideanSpace ℝ (Fin d), ‖iteratedFDeriv ℝ k F u‖ ≤ B := by
    intro k hk u
    by_cases hu : u ∈ unitCube d
    · have h1 : ContDiff ℝ (2 * d : ℕ) (fun y : EuclideanSpace ℝ (Fin d) => (unitBump d y : ℂ)) :=
        (Complex.ofRealCLM.contDiff.comp (contDiff_unitBump d)).of_le (WithTop.coe_le_coe.mpr le_top)
      have h2 : ContDiff ℝ (2 * d : ℕ) (fun y : EuclideanSpace ℝ (Fin d) => g (intVec z + y)) :=
        hg.comp (contDiff_const.add contDiff_id)
      have hmul := norm_iteratedFDeriv_mul_le h1 h2 u (n := k) (by exact_mod_cast hk)
      have hshift_deriv : ∀ m : ℕ,
          ‖iteratedFDeriv ℝ m (fun y : EuclideanSpace ℝ (Fin d) => g (intVec z + y)) u‖ =
            ‖iteratedFDeriv ℝ m g (intVec z + u)‖ := by
        intro m
        rw [iteratedFDeriv_comp_add_left]
      calc ‖iteratedFDeriv ℝ k F u‖
          ≤ ∑ r ∈ Finset.range (k + 1),
              (k.choose r : ℝ) *
                ‖iteratedFDeriv ℝ r (fun y : EuclideanSpace ℝ (Fin d) => (unitBump d y : ℂ)) u‖ *
                ‖iteratedFDeriv ℝ (k - r) (fun y => g (intVec z + y)) u‖ := hmul
        _ ≤ ∑ r ∈ Finset.range (k + 1), (k.choose r : ℝ) * K * M := by
            refine Finset.sum_le_sum fun r hr => ?_
            have hrk : r ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
            rw [hshift_deriv (k - r)]
            have hKr := hK r (le_trans hrk hk) u hu
            have hMr := hg_bd (k - r) (le_trans (Nat.sub_le k r) hk) u hu
            have hch : (0 : ℝ) ≤ (k.choose r : ℝ) := Nat.cast_nonneg _
            have hstep1 : (k.choose r : ℝ) *
                ‖iteratedFDeriv ℝ r (fun y : EuclideanSpace ℝ (Fin d) => (unitBump d y : ℂ)) u‖ ≤
                (k.choose r : ℝ) * K := mul_le_mul_of_nonneg_left hKr hch
            exact mul_le_mul hstep1 hMr (norm_nonneg _) (mul_nonneg hch hK_pos.le)
        _ = (∑ r ∈ Finset.range (k + 1), (k.choose r : ℝ)) * (K * M) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun r _ => by ring
        _ = (2 : ℝ) ^ k * (K * M) := by
            norm_cast
            rw [Nat.sum_range_choose]
        _ ≤ (2 : ℝ) ^ (2 * d) * (K * M) := by
            refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg hK_pos.le hM)
            exact pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk
        _ = B := by ring
    · have hU_open := isOpen_outside_three_quarters d
      have huU : u ∈ {y : EuclideanSpace ℝ (Fin d) | ∃ r, 3 / 4 < |y r|} := by
        change ¬∀ r : Fin d, u r ∈ Set.Icc (-1 : ℝ) 1 at hu
        rw [not_forall] at hu
        rcases hu with ⟨r, hr⟩
        refine ⟨r, ?_⟩
        rw [Set.mem_Icc, not_and_or, not_le, not_le] at hr
        rcases hr with h1 | h2
        · linarith [neg_le_abs (u r)]
        · linarith [le_abs_self (u r)]
      have hev : Filter.EventuallyEq (𝓝 u) F 0 :=
        Filter.eventuallyEq_iff_exists_mem.mpr ⟨_, hU_open.mem_nhds huU, hF_zero⟩
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      simp [hB]
  obtain ⟨hcd_d, hzero_d, hbd_d, hint_d⟩ := iterCoordOp_spec j hF_cd hF_zero hF_bd d le_rfl
  rw [frameCoeff_eq_shift]
  have hF_integrand :
      (fun u : EuclideanSpace ℝ (Fin d) =>
          (unitBump d u : ℂ) *
            Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) *
            g (intVec z + u)) =
        fun u => Complex.exp (-Complex.I * Real.pi * ∑ i : Fin d, (j i : ℝ) * u i) * F u := by
    ext u; simp only [F]; ring
  rw [hF_integrand, hint_d]
  have hprod_all :
      (∏ r : Fin d, if r.1 < d then (((1 + (j r : ℝ) ^ 2)⁻¹ : ℝ) : ℂ) else 1) =
        (((∏ r : Fin d, (1 + (j r : ℝ) ^ 2)⁻¹ : ℝ) : ℂ)) := by
    rw [Complex.ofReal_prod]
    refine Finset.prod_congr rfl fun r _ => ?_
    simp [r.isLt]
  rw [hprod_all, norm_mul, norm_mul, norm_two_cpow_neg_half, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Finset.prod_nonneg fun r _ => by positivity)]
  have hG_bd : ∀ u : EuclideanSpace ℝ (Fin d),
      ‖iterCoordOp d le_rfl F u‖ ≤ (1 + (Real.pi ^ 2)⁻¹) ^ d * B := by
    intro u
    simpa [norm_iteratedFDeriv_zero] using hbd_d 0 (by omega) u
  have hvol_cube : volume (unitCube d) = ENNReal.ofReal ((2 : ℝ) ^ d) := by
    let e := MeasurableEquiv.toLp 2 (Fin d → ℝ)
    have hmpE : MeasurePreserving e volume volume :=
      PiLp.volume_preserving_toLp (Fin d)
    have hpre : e ⁻¹' unitCube d = Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1) := by
      ext u
      change (∀ i : Fin d, (e u) i ∈ Set.Icc (-1 : ℝ) 1) ↔
        u ∈ Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1)
      simp only [e, MeasurableEquiv.toLp_apply, Set.mem_univ_pi]
    rw [← hmpE.measure_preimage_emb (MeasurableEquiv.measurableEmbedding _), hpre]
    change Measure.pi (fun _ : Fin d => (volume : Measure ℝ))
      (Set.univ.pi (fun _ : Fin d => Set.Icc (-1 : ℝ) 1)) = ENNReal.ofReal ((2 : ℝ) ^ d)
    rw [Measure.pi_pi]
    simp only [Real.volume_Icc, sub_neg_eq_add, one_add_one_eq_two, Finset.prod_const,
      Finset.card_univ, Fintype.card_fin]
    rw [ENNReal.ofReal_pow (by norm_num)]
  have hint_set :
      ∫ u : EuclideanSpace ℝ (Fin d),
          Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) *
            iterCoordOp d le_rfl F u =
        ∫ u in unitCube d,
          Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) *
            iterCoordOp d le_rfl F u := by
    symm
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
    have hU : ∃ r, 3 / 4 < |u r| := by
      change ¬∀ r : Fin d, u r ∈ Set.Icc (-1 : ℝ) 1 at hu
      rw [not_forall] at hu
      rcases hu with ⟨r, hr⟩
      refine ⟨r, ?_⟩
      rw [Set.mem_Icc, not_and_or, not_le, not_le] at hr
      rcases hr with h1 | h2
      · linarith [neg_le_abs (u r)]
      · linarith [le_abs_self (u r)]
    simp [hzero_d u hU]
  have hnorm_int :
      ‖∫ u : EuclideanSpace ℝ (Fin d),
          Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) *
            iterCoordOp d le_rfl F u‖ ≤
        (2 : ℝ) ^ d * ((1 + (Real.pi ^ 2)⁻¹) ^ d * B) := by
    rw [hint_set]
    have hpt_bd : ∀ u : EuclideanSpace ℝ (Fin d),
        ‖Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) *
          iterCoordOp d le_rfl F u‖ ≤ (1 + (Real.pi ^ 2)⁻¹) ^ d * B := by
      intro u
      rw [norm_mul]
      have hexp : ‖Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r)‖ = 1 := by
        have : -Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r =
            ((-(Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) : ℝ) : ℂ) * Complex.I := by
          push_cast; ring
        rw [this, Complex.norm_exp_ofReal_mul_I]
      rw [hexp, one_mul]
      exact hG_bd u
    have hle := norm_setIntegral_le_of_norm_le_const (μ := volume) (s := unitCube d)
      (C := (1 + (Real.pi ^ 2)⁻¹) ^ d * B) (by rw [hvol_cube]; exact ENNReal.ofReal_lt_top)
      (fun u _ => hpt_bd u)
    rw [Measure.real_def, hvol_cube, ENNReal.toReal_ofReal (by positivity)] at hle
    linarith
  calc (2 : ℝ) ^ (-(d : ℝ) / 2) *
          ((∏ r : Fin d, (1 + (j r : ℝ) ^ 2)⁻¹) *
            ‖∫ u : EuclideanSpace ℝ (Fin d),
                Complex.exp (-Complex.I * Real.pi * ∑ r : Fin d, (j r : ℝ) * u r) *
                  iterCoordOp d le_rfl F u‖)
      ≤ (2 : ℝ) ^ (-(d : ℝ) / 2) *
          ((∏ r : Fin d, (1 + (j r : ℝ) ^ 2)⁻¹) *
            ((2 : ℝ) ^ d * ((1 + (Real.pi ^ 2)⁻¹) ^ d * B))) := by
        gcongr
    _ = C * (∏ r : Fin d, (1 + (j r : ℝ) ^ 2)⁻¹) * M := by
        simp only [C, B]
        ring

/-! #### Summability of Product Frame Weights -/

theorem summable_inv_one_add_sq_int : Summable (fun k : ℤ => (1 + (k : ℝ) ^ 2)⁻¹) := by
  rw [summable_int_iff_summable_nat_and_neg]
  have hnat : Summable (fun n : ℕ => (1 + (n : ℝ) ^ 2)⁻¹) := by
    have h2 : Summable (fun n : ℕ => 1 / (n : ℝ) ^ 2) :=
      Real.summable_one_div_nat_pow.mpr one_lt_two
    refine (summable_nat_add_iff 1).mp ?_
    refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_)
      ((summable_nat_add_iff 1).mpr h2)
    rw [one_div]
    refine inv_anti₀ (by positivity) ?_
    linarith
  refine ⟨hnat, ?_⟩
  simpa using hnat

private lemma summable_prod_mul_of_nonneg {α β : Type*} {f : α → ℝ} {g : β → ℝ}
    (hf : Summable f) (hg : Summable g) (hf0 : ∀ a, 0 ≤ f a) (hg0 : ∀ b, 0 ≤ g b) :
    Summable (fun p : α × β => f p.1 * g p.2) := by
  refine (tsum_ofReal_ne_top_iff_summable (fun p : α × β => mul_nonneg (hf0 p.1) (hg0 p.2))).mp ?_
  rw [ENNReal.tsum_prod']
  simp_rw [ENNReal.ofReal_mul (hf0 _), ENNReal.tsum_mul_left, ENNReal.tsum_mul_right]
  rw [← ENNReal.ofReal_tsum_of_nonneg hf0 hf, ← ENNReal.ofReal_tsum_of_nonneg hg0 hg]
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top

theorem summable_prod_inv_one_add_sq_single (d : ℕ) :
    Summable (fun z : Fin d → ℤ => ∏ i : Fin d, (1 + (z i : ℝ) ^ 2)⁻¹) := by
  induction d with
  | zero => exact (hasSum_fintype _).summable
  | succ d ih =>
    let e : (Fin (d + 1) → ℤ) ≃ ℤ × (Fin d → ℤ) :=
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (d + 1) => ℤ) 0).toEquiv
    rw [← e.symm.summable_iff]
    have hEq : (fun z : Fin (d + 1) → ℤ => ∏ i : Fin (d + 1), (1 + (z i : ℝ) ^ 2)⁻¹) ∘ e.symm =
        fun p : ℤ × (Fin d → ℤ) =>
          (1 + (p.1 : ℝ) ^ 2)⁻¹ * (∏ i : Fin d, (1 + (p.2 i : ℝ) ^ 2)⁻¹) := by
      ext ⟨k, z⟩
      simp only [Function.comp_apply, e, MeasurableEquiv.coe_toEquiv_symm,
        MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_apply,
        Fin.prod_univ_succ, Fin.insertNth_apply_same, ← Fin.succAbove_zero,
        Fin.insertNth_apply_succAbove]
    rw [hEq]
    refine summable_prod_mul_of_nonneg (f := fun k : ℤ => (1 + (k : ℝ) ^ 2)⁻¹)
      (g := fun z : Fin d → ℤ => ∏ i : Fin d, (1 + (z i : ℝ) ^ 2)⁻¹)
      summable_inv_one_add_sq_int ih ?_ ?_
    · intro k; positivity
    · intro z; exact Finset.prod_nonneg fun _ _ => by positivity

/-- Summability of the phase-space product weight over `(Fin d → ℤ) × (Fin d → ℤ)`. -/
theorem summable_prod_inv_one_add_sq (d : ℕ) :
    Summable (fun p : (Fin d → ℤ) × (Fin d → ℤ) =>
      (∏ i : Fin d, (1 + (p.1 i : ℝ) ^ 2)⁻¹) * (∏ i : Fin d, (1 + (p.2 i : ℝ) ^ 2)⁻¹)) := by
  refine summable_prod_mul_of_nonneg
    (f := fun z : Fin d → ℤ => ∏ i : Fin d, (1 + (z i : ℝ) ^ 2)⁻¹)
    (g := fun z : Fin d → ℤ => ∏ i : Fin d, (1 + (z i : ℝ) ^ 2)⁻¹)
    (summable_prod_inv_one_add_sq_single d)
    (summable_prod_inv_one_add_sq_single d) ?_ ?_
  · intro z; exact Finset.prod_nonneg fun _ _ => by positivity
  · intro z; exact Finset.prod_nonneg fun _ _ => by positivity

end FourierFrame

end GaussianSeriesFrame

section NelsonKernels

open MeasureTheory Filter Set Real
open scoped Topology BigOperators FourierTransform SchwartzMap NNReal

/-! ### Part 0: Geometry, Coordinate Splitting, Reflection, and Paper 1 Fourier Conventions -/

/-- Spatial Euclidean space `ℝ^{n+1}`. -/
abbrev SpatialE (n : ℕ) := EuclideanSpace ℝ (Fin (n + 1))

/-- Full Euclidean spacetime `ℝ^{n+2}` with time coordinate `0` and spatial coordinates `1, ..., n+1`. -/
abbrev EuclidD (n : ℕ) := EuclideanSpace ℝ (Fin (n + 2))

/-- Spatial projection `x ↦ (x 1, ..., x (n+1))` from `ℝ^{n+2}` to `ℝ^{n+1}`. -/
noncomputable def spatialProj {n : ℕ} (x : EuclidD n) : SpatialE n :=
  WithLp.toLp 2 (fun i : Fin (n + 1) => x i.succ)

@[simp] lemma spatialProj_apply {n : ℕ} (x : EuclidD n) (i : Fin (n + 1)) :
    spatialProj x i = x i.succ := rfl

/-- Construct a spacetime point `(t, y) ∈ ℝ^{n+2}` from `t : ℝ` and `y : ℝ^{n+1}`. -/
noncomputable def euclidCons {n : ℕ} (t : ℝ) (y : SpatialE n) : EuclidD n :=
  WithLp.toLp 2 (Fin.cons t (fun i : Fin (n + 1) => y i))

@[simp] lemma euclidCons_zero {n : ℕ} (t : ℝ) (y : SpatialE n) :
    euclidCons t y 0 = t := rfl

@[simp] lemma euclidCons_succ {n : ℕ} (t : ℝ) (y : SpatialE n) (i : Fin (n + 1)) :
    euclidCons t y i.succ = y i := rfl

@[simp] lemma spatialProj_euclidCons {n : ℕ} (t : ℝ) (y : SpatialE n) :
    spatialProj (euclidCons t y) = y := by
  ext i; rfl

@[simp] lemma euclidCons_zero_spatialProj {n : ℕ} (x : EuclidD n) :
    euclidCons (x 0) (spatialProj x) = x := by
  ext j
  refine Fin.cases ?_ ?_ j
  · rfl
  · intro i; rfl

/-- Continuous linear equivalence splitting `EuclidD n ≃L[ℝ] ℝ × SpatialE n`. -/
noncomputable def timeSpatialCLE (n : ℕ) : EuclidD n ≃L[ℝ] ℝ × SpatialE n :=
  LinearEquiv.toContinuousLinearEquiv
    { toFun := fun x => (x 0, spatialProj x)
      invFun := fun p => euclidCons p.1 p.2
      left_inv := fun x => euclidCons_zero_spatialProj x
      right_inv := fun p => Prod.ext rfl (spatialProj_euclidCons p.1 p.2)
      map_add' := fun x y => by
        refine Prod.ext rfl ?_
        ext i; rfl
      map_smul' := fun c x => by
        refine Prod.ext rfl ?_
        ext i; rfl }

@[simp] lemma timeSpatialCLE_apply {n : ℕ} (x : EuclidD n) :
    timeSpatialCLE n x = (x 0, spatialProj x) := rfl

@[simp] lemma timeSpatialCLE_symm_apply {n : ℕ} (p : ℝ × SpatialE n) :
    (timeSpatialCLE n).symm p = euclidCons p.1 p.2 := rfl

lemma euclid_norm_sq_eq {n : ℕ} (x : EuclidD n) :
    ‖x‖ ^ 2 = (x 0) ^ 2 + ‖spatialProj x‖ ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq, Fin.sum_univ_succ]
  simp [Real.norm_eq_abs, sq_abs, spatialProj]

lemma euclidCons_norm_sq {n : ℕ} (t : ℝ) (y : SpatialE n) :
    ‖euclidCons t y‖ ^ 2 = t ^ 2 + ‖y‖ ^ 2 := by
  simpa using euclid_norm_sq_eq (euclidCons t y)

lemma euclid_inner_eq {n : ℕ} (x y : EuclidD n) :
    inner ℝ x y = x 0 * y 0 + inner ℝ (spatialProj x) (spatialProj y) := by
  rw [EuclideanSpace.inner_eq_star_dotProduct, EuclideanSpace.inner_eq_star_dotProduct,
    dotProduct, dotProduct, Fin.sum_univ_succ]
  simp [spatialProj, mul_comm]

lemma euclidCons_inner {n : ℕ} (t s : ℝ) (y z : SpatialE n) :
    inner ℝ (euclidCons t y) (euclidCons s z) = t * s + inner ℝ y z := by
  simpa using euclid_inner_eq (euclidCons t y) (euclidCons s z)

/-- The time-spatial splitting `timeSpatialCLE n` preserves Lebesgue measure. -/
lemma measurePreserving_timeSpatialCLE (n : ℕ) :
    MeasurePreserving (timeSpatialCLE n) volume volume := by
  have h1 : MeasurePreserving (WithLp.ofLp (p := 2) (V := Fin (n + 2) → ℝ)) volume volume :=
    PiLp.volume_preserving_ofLp (Fin (n + 2))
  have h2 : MeasurePreserving (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 2) => ℝ) 0)
      volume volume :=
    MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin (n + 2) => ℝ) 0
  have h3 : MeasurePreserving
      (Prod.map (id : ℝ → ℝ) (WithLp.toLp (p := 2) (V := Fin (n + 1) → ℝ)))
      volume volume :=
    (MeasurePreserving.id volume).prod (PiLp.volume_preserving_toLp (Fin (n + 1)))
  have hcomp : MeasurePreserving
      ((Prod.map (id : ℝ → ℝ) (WithLp.toLp (p := 2) (V := Fin (n + 1) → ℝ))) ∘
        (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 2) => ℝ) 0) ∘
        (WithLp.ofLp (p := 2) (V := Fin (n + 2) → ℝ)))
      volume volume :=
    h3.comp (h2.comp h1)
  have heq : (timeSpatialCLE n : EuclidD n → ℝ × SpatialE n) =
      (Prod.map (id : ℝ → ℝ) (WithLp.toLp (p := 2) (V := Fin (n + 1) → ℝ))) ∘
        (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 2) => ℝ) 0) ∘
        (WithLp.ofLp (p := 2) (V := Fin (n + 2) → ℝ)) := by
    funext x
    refine Prod.ext rfl ?_
    ext i
    simp [MeasurableEquiv.piFinSuccAbove, Fin.tail]
  rw [heq]
  exact hcomp

/-- The inverse splitting `euclidCons` preserves Lebesgue measure. -/
lemma measurePreserving_timeSpatialCLE_symm (n : ℕ) :
    MeasurePreserving (timeSpatialCLE n).symm volume volume := by
  have h := (measurePreserving_timeSpatialCLE n).symm
    (timeSpatialCLE n).toHomeomorph.toMeasurableEquiv
  exact h

/-- Change of variables for integrals on `EuclidD n` into `ℝ × SpatialE n`. -/
lemma integral_euclid_eq_prod {n : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (g : EuclidD n → E) :
    ∫ x : EuclidD n, g x = ∫ p : ℝ × SpatialE n, g (euclidCons p.1 p.2) := by
  have h := (measurePreserving_timeSpatialCLE_symm n).integral_comp'
    (g := g) (f := (timeSpatialCLE n).symm.toHomeomorph.toMeasurableEquiv)
  simpa using h.symm

/-- Time reflection `x ↦ (-x 0, x 1, ..., x (n+1))`, matching Paper 1's `euclideanReflect`. -/
noncomputable def euclidTimeReflect {n : ℕ} (x : EuclidD n) : EuclidD n :=
  euclidCons (-x 0) (spatialProj x)

@[simp] lemma euclidTimeReflect_zero {n : ℕ} (x : EuclidD n) :
    euclidTimeReflect x 0 = -x 0 := rfl

@[simp] lemma euclidTimeReflect_succ {n : ℕ} (x : EuclidD n) (i : Fin (n + 1)) :
    euclidTimeReflect x i.succ = x i.succ := rfl

@[simp] lemma spatialProj_euclidTimeReflect {n : ℕ} (x : EuclidD n) :
    spatialProj (euclidTimeReflect x) = spatialProj x := rfl

@[simp] lemma euclidTimeReflect_euclidCons {n : ℕ} (t : ℝ) (y : SpatialE n) :
    euclidTimeReflect (euclidCons t y) = euclidCons (-t) y := by
  ext j
  refine Fin.cases ?_ ?_ j
  · rfl
  · intro i; rfl

@[simp] lemma euclidTimeReflect_involutive {n : ℕ} (x : EuclidD n) :
    euclidTimeReflect (euclidTimeReflect x) = x := by
  ext j
  refine Fin.cases ?_ ?_ j
  · simp [euclidTimeReflect]
  · intro i; rfl

/-- Exact match with Paper 1's `euclideanReflect` definition. -/
lemma euclidTimeReflect_eq_update {n : ℕ} (x : EuclidD n) :
    euclidTimeReflect x =
      WithLp.toLp 2 (Function.update (fun j : Fin (n + 2) => x j) 0 (-x 0)) := by
  ext j
  refine Fin.cases ?_ ?_ j
  · simp [euclidTimeReflect]
  · intro i
    have hne : i.succ ≠ 0 := Fin.succ_ne_zero i
    simp [euclidTimeReflect, hne]

/-- Time reflection as a linear isometric equivalence on `EuclidD n`. -/
noncomputable def euclidTimeReflectLI (n : ℕ) : EuclidD n ≃ₗᵢ[ℝ] EuclidD n where
  toFun := euclidTimeReflect
  invFun := euclidTimeReflect
  left_inv := euclidTimeReflect_involutive
  right_inv := euclidTimeReflect_involutive
  map_add' := fun x y => by
    ext j
    refine Fin.cases ?_ ?_ j
    · simp [euclidTimeReflect]; ring
    · intro i; rfl
  map_smul' := fun c x => by
    ext j
    refine Fin.cases ?_ ?_ j
    · simp [euclidTimeReflect]
    · intro i; rfl
  norm_map' := fun x => by
    change ‖euclidTimeReflect x‖ = ‖x‖
    have hsq : ‖euclidTimeReflect x‖ ^ 2 = ‖x‖ ^ 2 := by
      rw [euclid_norm_sq_eq, euclid_norm_sq_eq]
      simp [euclidTimeReflect]
    nlinarith [norm_nonneg (euclidTimeReflect x), norm_nonneg x]

lemma euclidTimeReflect_inner {n : ℕ} (x y : EuclidD n) :
    inner ℝ (euclidTimeReflect x) y = inner ℝ x (euclidTimeReflect y) := by
  rw [euclid_inner_eq, euclid_inner_eq]
  simp [euclidTimeReflect]

lemma measurePreserving_euclidTimeReflect (n : ℕ) :
    MeasurePreserving (euclidTimeReflect (n := n)) volume volume :=
  (euclidTimeReflectLI n).measurePreserving

/-- Time reflection on real Schwartz functions: `(reflectSchwartz f) x = f (euclidTimeReflect x)`. -/
noncomputable def reflectSchwartz {n : ℕ} : 𝓢(EuclidD n, ℝ) →L[ℝ] 𝓢(EuclidD n, ℝ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ (euclidTimeReflectLI n).toContinuousLinearEquiv

@[simp] lemma reflectSchwartz_apply {n : ℕ} (f : 𝓢(EuclidD n, ℝ)) (x : EuclidD n) :
    reflectSchwartz f x = f (euclidTimeReflect x) := rfl

@[simp] lemma reflectSchwartz_involutive {n : ℕ} (f : 𝓢(EuclidD n, ℝ)) :
    reflectSchwartz (reflectSchwartz f) = f := by
  ext x; simp

/-- Relativistic spatial dispersion `ω_m(k) = √(m² + ‖k‖²)`, matching Paper 1's `modeDispersion`. -/
noncomputable def euclidDispersion {n : ℕ} (m : ℝ) (k : SpatialE n) : ℝ :=
  Real.sqrt (m ^ 2 + ‖k‖ ^ 2)

lemma euclidDispersion_eq_modeDispersion {n : ℕ} (m : ℝ) (k : SpatialE n) :
    euclidDispersion m k = Real.sqrt (‖k‖ ^ 2 + m ^ 2) := by
  unfold euclidDispersion; rw [add_comm]

lemma euclidDispersion_pos {n : ℕ} {m : ℝ} (hm : 0 < m) (k : SpatialE n) :
    0 < euclidDispersion m k :=
  Real.sqrt_pos.mpr (by positivity)

lemma euclidDispersion_sq {n : ℕ} (m : ℝ) (k : SpatialE n) :
    euclidDispersion m k ^ 2 = m ^ 2 + ‖k‖ ^ 2 :=
  Real.sq_sqrt (by positivity)

lemma euclidDispersion_ge_mass {n : ℕ} {m : ℝ} (hm : 0 < m) (k : SpatialE n) :
    m ≤ euclidDispersion m k := by
  unfold euclidDispersion
  have h1 : m ^ 2 ≤ m ^ 2 + ‖k‖ ^ 2 := le_add_of_nonneg_right (sq_nonneg _)
  simpa [Real.sqrt_sq hm.le] using Real.sqrt_le_sqrt h1

lemma euclidDispersion_neg {n : ℕ} (m : ℝ) (k : SpatialE n) :
    euclidDispersion m (-k) = euclidDispersion m k := by
  simp [euclidDispersion]

/-- Unitary physics Fourier transform matching Paper 1's `physicsFourier` verbatim:
`physicsFourierExact f p = (2π)^(-D/2) * 𝓕 (fun x => (f x : ℂ)) ((2π)⁻¹ • p)`. -/
noncomputable def physicsFourierExact {D : ℕ} (f : EuclideanSpace ℝ (Fin D) → ℝ)
    (p : EuclideanSpace ℝ (Fin D)) : ℂ :=
  ((2 * Real.pi) ^ (-(D : ℝ) / 2) : ℝ) *
    𝓕 (fun x : EuclideanSpace ℝ (Fin D) => (f x : ℂ)) ((2 * Real.pi)⁻¹ • p)

/-- Explicit integral formula for `physicsFourierExact`. -/
lemma physicsFourierExact_eq_integral {D : ℕ} (f : EuclideanSpace ℝ (Fin D) → ℝ)
    (p : EuclideanSpace ℝ (Fin D)) :
    physicsFourierExact f p =
      ((2 * Real.pi) ^ (-(D : ℝ) / 2) : ℝ) *
        ∫ x : EuclideanSpace ℝ (Fin D),
          Complex.exp (-Complex.I * (inner ℝ x p : ℂ)) * (f x : ℂ) := by
  unfold physicsFourierExact
  congr 1
  rw [Real.fourier_eq]
  refine integral_congr_ae (ae_of_all _ fun x => ?_)
  dsimp only
  rw [Circle.smul_def, Real.fourierChar_apply, smul_eq_mul]
  congr 1
  congr 1
  rw [inner_smul_right]
  have hpi : (2 * Real.pi : ℂ) ≠ 0 := by
    exact_mod_cast (mul_pos two_pos Real.pi_pos).ne'
  push_cast
  field_simp [hpi]

/-- Continuum Euclidean covariance bilinear form matching Paper 1's `continuumCov` verbatim. -/
noncomputable def continuumCovExact (n : ℕ) (ħ m : ℝ)
    (f g : 𝓢(EuclidD n, ℝ)) : ℂ :=
  (ħ : ℂ) * ∫ p : EuclidD n,
    star (physicsFourierExact f p) * physicsFourierExact g p *
      ((‖p‖ ^ 2 + m ^ 2 : ℝ)⁻¹ : ℂ)

/-- Real-valued diagonal continuum covariance `ħ ∫ ‖f̂(p)‖² / (‖p‖² + m²) dp`. -/
noncomputable def continuumCovReal (n : ℕ) (ħ m : ℝ) (f : 𝓢(EuclidD n, ℝ)) : ℝ :=
  ħ * ∫ p : EuclidD n, ‖physicsFourierExact f p‖ ^ 2 * (‖p‖ ^ 2 + m ^ 2)⁻¹

lemma continuumCovExact_diag_eq_ofReal (n : ℕ) (ħ m : ℝ) (f : 𝓢(EuclidD n, ℝ)) :
    continuumCovExact n ħ m f f = (continuumCovReal n ħ m f : ℂ) := by
  unfold continuumCovExact continuumCovReal
  rw [Complex.ofReal_mul]
  congr 1
  rw [← integral_complex_ofReal]
  refine integral_congr_ae (ae_of_all _ fun p => ?_)
  dsimp only
  have hnorm : star (physicsFourierExact f p) * physicsFourierExact f p =
      ((‖physicsFourierExact f p‖ ^ 2 : ℝ) : ℂ) := by
    rw [RCLike.star_def, mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  rw [hnorm]
  push_cast
  rfl

/-- Spatial physics Fourier transform at fixed time slice `t`:
`spatialPhysicsFourier f t k = (2π)^(-(n+1)/2) ∫_y e^{-i k·y} f(t, y) dy`. -/
noncomputable def spatialPhysicsFourier {n : ℕ} (f : 𝓢(EuclidD n, ℝ)) (t : ℝ)
    (k : SpatialE n) : ℂ :=
  physicsFourierExact (fun y : SpatialE n => f (euclidCons t y)) k

/-- Embedding `y ↦ (t, y)` into `EuclidD n` is an isometry, hence antilipschitz with constant 1. -/
lemma euclidCons_isometry {n : ℕ} (t : ℝ) : Isometry (euclidCons (n := n) t) := by
  refine Isometry.of_dist_eq fun y z => ?_
  rw [dist_eq_norm, dist_eq_norm]
  have hsub : euclidCons t y - euclidCons t z = euclidCons 0 (y - z) := by
    ext j
    refine Fin.cases ?_ ?_ j
    · simp [euclidCons]
    · intro i; rfl
  have hsq : ‖euclidCons t y - euclidCons t z‖ ^ 2 = ‖y - z‖ ^ 2 := by
    rw [hsub, euclidCons_norm_sq]; ring
  nlinarith [norm_nonneg (euclidCons t y - euclidCons t z), norm_nonneg (y - z)]

/-- Restriction of a Schwartz function on `EuclidD n` to time slice `t` as a CLM into `𝓢(SpatialE n, F)`. -/
noncomputable def restrictTimeCLM {n : ℕ} (𝕜 : Type*) [RCLike 𝕜]
    (F : Type*) [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedSpace 𝕜 F]
    (t : ℝ) : 𝓢(EuclidD n, F) →L[𝕜] 𝓢(SpatialE n, F) :=
  SchwartzMap.compCLMOfAntilipschitz 𝕜 (K := 1)
    (g := euclidCons t)
    (by
      have haff : euclidCons (n := n) t = fun y =>
          (timeSpatialCLE n).symm (0, y) + euclidCons t 0 := by
        funext y
        ext j
        refine Fin.cases ?_ ?_ j
        · simp [euclidCons]
        · intro i; simp [euclidCons]
      rw [haff]
      have hlin : Function.HasTemperateGrowth
          ((timeSpatialCLE n).symm.toContinuousLinearMap.comp
            (ContinuousLinearMap.inr ℝ ℝ (SpatialE n))) :=
        ContinuousLinearMap.hasTemperateGrowth _
      exact hlin.add (Function.HasTemperateGrowth.const _))
    (euclidCons_isometry t).antilipschitzWith

@[simp] lemma restrictTimeCLM_apply {n : ℕ} (𝕜 : Type*) [RCLike 𝕜]
    (F : Type*) [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedSpace 𝕜 F]
    (t : ℝ) (f : 𝓢(EuclidD n, F)) (y : SpatialE n) :
    restrictTimeCLM 𝕜 F t f y = f (euclidCons t y) := rfl

lemma spatialPhysicsFourier_reflect {n : ℕ} (f : 𝓢(EuclidD n, ℝ)) (t : ℝ) (k : SpatialE n) :
    spatialPhysicsFourier (reflectSchwartz f) t k = spatialPhysicsFourier f (-t) k := by
  unfold spatialPhysicsFourier
  simp [reflectSchwartz_apply, euclidTimeReflect_euclidCons]

/-- Reality symmetry of `physicsFourierExact`: `f̂(-p) = conj(f̂(p))`. -/
lemma physicsFourierExact_neg {D : ℕ} (f : EuclideanSpace ℝ (Fin D) → ℝ)
    (p : EuclideanSpace ℝ (Fin D)) :
    physicsFourierExact f (-p) = star (physicsFourierExact f p) := by
  rw [physicsFourierExact_eq_integral, physicsFourierExact_eq_integral]
  rw [RCLike.star_def, map_mul, Complex.conj_ofReal, ← integral_conj]
  congr 1
  refine integral_congr_ae (ae_of_all _ fun x => ?_)
  dsimp only
  rw [map_mul, Complex.conj_ofReal, ← Complex.exp_conj]
  congr 2
  simp [inner_neg_right]

/-- Splitting the full `(n+2)`-dimensional `physicsFourierExact` into time integral of `spatialPhysicsFourier`. -/
lemma physicsFourierExact_eq_timeIntegral {n : ℕ} (f : 𝓢(EuclidD n, ℝ)) (p : EuclidD n) :
    physicsFourierExact f p =
      ((2 * Real.pi) ^ (-(1 : ℝ) / 2) : ℝ) *
        ∫ t : ℝ, Complex.exp (-Complex.I * (t * p 0 : ℝ)) *
          spatialPhysicsFourier f t (spatialProj p) := by
  rw [physicsFourierExact_eq_integral, integral_euclid_eq_prod]
  have hint : Integrable (fun q : ℝ × SpatialE n =>
      Complex.exp (-Complex.I * (inner ℝ (euclidCons q.1 q.2) p : ℂ)) *
        (f (euclidCons q.1 q.2) : ℂ)) volume := by
    have hcomp : Integrable (fun x : EuclidD n =>
        Complex.exp (-Complex.I * (inner ℝ x p : ℂ)) * (f x : ℂ)) volume := by
      refine (f.integrable (μ := volume)).norm.mono' ?_ ?_
      · exact (Complex.continuous_exp.comp (continuous_const.mul
          (Complex.continuous_ofReal.comp (continuous_id.inner continuous_const)))).mul
          (Complex.continuous_ofReal.comp f.continuous) |>.aestronglyMeasurable
      · filter_upwards with x
        rw [norm_mul, Complex.norm_real]
        have hexp : ‖Complex.exp (-Complex.I * (inner ℝ x p : ℂ))‖ = 1 := by
          rw [show -Complex.I * (inner ℝ x p : ℂ) = (-(inner ℝ x p) : ℝ) * Complex.I by
            push_cast; ring]
          exact Complex.norm_exp_ofReal_mul_I _
        rw [hexp, one_mul]
    exact (measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable hcomp
  have hprod_eq : (∫ q : ℝ × SpatialE n,
      Complex.exp (-Complex.I * (inner ℝ (euclidCons q.1 q.2) p : ℂ)) *
        (f (euclidCons q.1 q.2) : ℂ)) =
      ∫ t : ℝ, ∫ y : SpatialE n,
        Complex.exp (-Complex.I * (inner ℝ (euclidCons t y) p : ℂ)) *
          (f (euclidCons t y) : ℂ) := by
    simpa [Measure.volume_eq_prod] using MeasureTheory.integral_prod _ hint
  rw [hprod_eq]
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
  have hpow : (2 * Real.pi) ^ (-((n + 2 : ℕ) : ℝ) / 2) =
      (2 * Real.pi) ^ (-(1 : ℝ) / 2) * (2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) := by
    rw [← Real.rpow_add h2pi_pos]
    congr 1; push_cast; ring
  rw [hpow, Complex.ofReal_mul, mul_assoc]
  congr 1
  rw [← integral_const_mul]
  refine integral_congr_ae (ae_of_all _ fun t => ?_)
  dsimp only
  unfold spatialPhysicsFourier
  rw [physicsFourierExact_eq_integral]
  rw [show (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) : ℂ) *
      ∫ y : SpatialE n, Complex.exp (-Complex.I * (inner ℝ (euclidCons t y) p : ℂ)) *
        (f (euclidCons t y) : ℂ) =
      Complex.exp (-Complex.I * (t * p 0 : ℝ)) *
        ((((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) : ℂ) *
          ∫ y : SpatialE n, Complex.exp (-Complex.I * (inner ℝ y (spatialProj p) : ℂ)) *
            (f (euclidCons t y) : ℂ)) by
    rw [← integral_const_mul, ← integral_const_mul, ← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    dsimp only
    have hin : inner ℝ (euclidCons t y) p = t * p 0 + inner ℝ y (spatialProj p) := by
      have h := euclid_inner_eq (euclidCons t y) p
      simpa using h
    rw [hin, Complex.ofReal_add, mul_add, Complex.exp_add]
    push_cast; ring]

/-! ### Part 0.5: 1D Exponential & Lorentzian Fourier Identities -/

/-- The 1D massive exponential kernel `exp(-ω|t|) / (2ω)`. -/
noncomputable def expKernel1D (ω t : ℝ) : ℝ :=
  Real.exp (-ω * |t|) / (2 * ω)

lemma expKernel1D_continuous (ω : ℝ) : Continuous (expKernel1D ω) := by
  unfold expKernel1D; fun_prop

lemma expKernel1D_integrable {ω : ℝ} (hω : 0 < ω) : Integrable (expKernel1D ω) volume := by
  unfold expKernel1D
  have h1 : Integrable (fun t : ℝ => Real.exp (-ω * |t|)) volume := by
    have hIoi : IntegrableOn (fun t : ℝ => Real.exp (-ω * t)) (Ioi 0) volume :=
      integrableOn_exp_mul_Ioi (by linarith) 0
    have hIic : IntegrableOn (fun t : ℝ => Real.exp (ω * t)) (Iic 0) volume :=
      integrableOn_exp_mul_Iic hω 0
    have ha : IntegrableOn (fun t : ℝ => Real.exp (-ω * |t|)) (Ioi 0) volume :=
      hIoi.congr_fun (fun t ht => by rw [abs_of_pos ht]) measurableSet_Ioi
    have hb : IntegrableOn (fun t : ℝ => Real.exp (-ω * |t|)) (Iic 0) volume :=
      hIic.congr_fun (fun t ht => by rw [abs_of_nonpos ht]; ring_nf) measurableSet_Iic
    rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact hb.union ha
  exact h1.div_const (2 * ω)

/-- Exact 1D Fourier integral `∫ exp(-ω|t|) / (2ω) * exp(i q t) dt = 1 / (ω² + q²)`. -/
theorem expKernel1D_fourier {ω : ℝ} (hω : 0 < ω) (q : ℝ) :
    (∫ t : ℝ, (expKernel1D ω t : ℂ) * Complex.exp (Complex.I * (q : ℂ) * (t : ℂ))) =
      1 / ((ω : ℂ) ^ 2 + (q : ℂ) ^ 2) := by
  let A : ℂ := -(ω : ℂ) + Complex.I * (q : ℂ)
  let B : ℂ := (ω : ℂ) + Complex.I * (q : ℂ)
  have hAr : A.re < 0 := by simp [A, hω]
  have hBr : 0 < B.re := by simp [B, hω]
  have hA : A ≠ 0 := fun h => by simp [h] at hAr
  have hB : B ≠ 0 := fun h => by simp [h] at hBr
  have hAB : A * B = -((ω : ℂ) ^ 2 + (q : ℂ) ^ 2) := by
    dsimp [A, B]; linear_combination (q : ℂ) ^ 2 * Complex.I_sq
  have hden : (ω : ℂ) ^ 2 + (q : ℂ) ^ 2 ≠ 0 := by
    rw [← neg_ne_zero, ← hAB]; exact mul_ne_zero hA hB
  let g : ℝ → ℂ := fun t => Complex.exp (-(ω : ℂ) * |(t : ℝ)| + Complex.I * (q : ℂ) * (t : ℂ))
  have haeq : EqOn g (fun t : ℝ => Complex.exp (A * (t : ℂ))) (Ioi 0) := by
    intro t ht
    have ht0 : 0 < t := ht
    simp only [g, A, abs_of_pos ht0]
    congr 1; ring
  have hbeq : EqOn g (fun t : ℝ => Complex.exp (B * (t : ℂ))) (Iic 0) := by
    intro t ht
    have ht0 : t ≤ 0 := ht
    simp only [g, B, abs_of_nonpos ht0]
    congr 1; push_cast; ring
  have hig : Integrable g volume := by
    have h1 := (integrableOn_exp_mul_complex_Ioi hAr 0).congr_fun haeq.symm measurableSet_Ioi
    have h2 := (integrableOn_exp_mul_complex_Iic hBr 0).congr_fun hbeq.symm measurableSet_Iic
    rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact h2.union h1
  have hg_int : ∫ t : ℝ, g t = 2 * (ω : ℂ) / ((ω : ℂ) ^ 2 + (q : ℂ) ^ 2) := by
    rw [← integral_add_compl measurableSet_Ioi hig, Set.compl_Ioi,
      setIntegral_congr_fun measurableSet_Ioi haeq,
      setIntegral_congr_fun measurableSet_Iic hbeq,
      integral_exp_mul_complex_Ioi hAr 0, integral_exp_mul_complex_Iic hBr 0]
    simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero]
    field_simp [hA, hB, hden]
    rw [hAB]; dsimp [A, B]; ring
  have hpt (t : ℝ) : (expKernel1D ω t : ℂ) * Complex.exp (Complex.I * (q : ℂ) * (t : ℂ)) =
      (2 * (ω : ℂ))⁻¹ * g t := by
    unfold expKernel1D g
    rw [Complex.ofReal_div, Complex.ofReal_exp, div_eq_inv_mul, mul_assoc, ← Complex.exp_add]
    congr 1
    · push_cast; rfl
    · congr 1; push_cast; ring
  simp_rw [hpt]
  rw [integral_const_mul, hg_int]
  field_simp [Complex.ofReal_ne_zero.mpr hω.ne']

/-- Inverse 1D Lorentzian Fourier identity:
`(2π)⁻¹ ∫ exp(i p₀ t) / (p₀² + ω²) dp₀ = exp(-ω|t|) / (2ω)`. -/
theorem lorentzian_fourier_eq_expKernel1D {ω : ℝ} (hω : 0 < ω) (t : ℝ) :
    ((2 * Real.pi : ℝ)⁻¹ : ℂ) *
        (∫ p₀ : ℝ, Complex.exp (Complex.I * (p₀ : ℂ) * (t : ℂ)) /
          ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) =
      (expKernel1D ω t : ℂ) := by
  let g : ℝ → ℂ := fun s => (expKernel1D ω s : ℂ)
  have hg_cont : Continuous g := Complex.continuous_ofReal.comp (expKernel1D_continuous ω)
  have hg_int : Integrable g volume := (expKernel1D_integrable hω).ofReal
  have hFg : ∀ ξ : ℝ, 𝓕 g ξ = (1 : ℂ) / ((ω : ℂ) ^ 2 + (2 * Real.pi * (ξ : ℂ)) ^ 2) := by
    intro ξ
    rw [Real.fourier_eq]
    have hpt : ∀ s : ℝ, (Real.fourierChar (-inner ℝ s ξ)) • g s =
        (expKernel1D ω s : ℂ) * Complex.exp (Complex.I * (-(2 * Real.pi * ξ) : ℝ) * (s : ℂ)) := by
      intro s
      rw [Circle.smul_def, Real.fourierChar_apply, smul_eq_mul, mul_comm]
      congr 1
      congr 1
      simp only [RCLike.inner_apply, conj_trivial]
      push_cast; ring
    simp_rw [hpt]
    rw [expKernel1D_fourier hω (-(2 * Real.pi * ξ))]
    push_cast; ring_nf
  have hFg_int : Integrable (𝓕 g) volume := by
    have hreal : Integrable (fun ξ : ℝ => ((ω ^ 2 + (2 * Real.pi * ξ) ^ 2)⁻¹ : ℝ)) volume := by
      have h1 : Integrable (fun u : ℝ => (1 + u ^ 2)⁻¹) volume := integrable_inv_one_add_sq
      have hsc : Integrable (fun ξ : ℝ => (1 + (2 * Real.pi / ω * ξ) ^ 2)⁻¹) volume := by
        have hpos : (2 * Real.pi / ω) ≠ 0 := by positivity
        simpa [mul_pow] using h1.comp_mul_left' hpos
      have heq : (fun ξ : ℝ => (ω ^ 2 + (2 * Real.pi * ξ) ^ 2)⁻¹) =
          fun ξ : ℝ => (ω ^ 2)⁻¹ * (1 + (2 * Real.pi / ω * ξ) ^ 2)⁻¹ := by
        funext ξ
        field_simp [hω.ne']
      rw [heq]
      exact hsc.const_mul _
    refine hreal.mono' ?_ ?_
    · have hcont : Continuous (𝓕 g) := by
        have hEq : 𝓕 g = fun ξ : ℝ => (1 : ℂ) / ((ω : ℂ) ^ 2 + (2 * Real.pi * (ξ : ℂ)) ^ 2) :=
          funext hFg
        rw [hEq]
        refine continuous_const.div (by fun_prop) fun ξ => ?_
        have hpos : (0 : ℝ) < ω ^ 2 + (2 * Real.pi * ξ) ^ 2 := by positivity
        exact_mod_cast hpos.ne'
      exact hcont.aestronglyMeasurable
    · filter_upwards with ξ
      rw [hFg ξ]
      have hpos : (0 : ℝ) < ω ^ 2 + (2 * Real.pi * ξ) ^ 2 := by positivity
      have hcast : ((ω : ℂ) ^ 2 + (2 * Real.pi * (ξ : ℂ)) ^ 2) =
          ((ω ^ 2 + (2 * Real.pi * ξ) ^ 2 : ℝ) : ℂ) := by push_cast; ring
      rw [hcast, one_div, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos]
  have hinv := congrFun (hg_cont.fourierInv_fourier_eq hg_int hFg_int) t
  rw [Real.fourierInv_eq] at hinv
  have hlhs : (∫ ξ : ℝ, (Real.fourierChar (inner ℝ ξ t)) • 𝓕 g ξ) =
      ∫ ξ : ℝ, Complex.exp (Complex.I * ((2 * Real.pi * ξ : ℝ) : ℂ) * (t : ℂ)) /
        (((2 * Real.pi * ξ : ℝ) : ℂ) ^ 2 + (ω : ℂ) ^ 2) := by
    refine integral_congr_ae (ae_of_all _ fun ξ => ?_)
    dsimp only
    rw [hFg ξ, Circle.smul_def, Real.fourierChar_apply, smul_eq_mul, mul_one_div]
    congr 1
    · congr 1
      simp only [RCLike.inner_apply, conj_trivial]
      push_cast; ring
    · push_cast; ring
  rw [hlhs] at hinv
  have hsub := Measure.integral_comp_mul_left
    (g := fun p₀ : ℝ => Complex.exp (Complex.I * (p₀ : ℂ) * (t : ℂ)) /
      ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) (2 * Real.pi)
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
  rw [abs_of_pos (inv_pos.mpr h2pi_pos)] at hsub
  rw [hsub] at hinv
  simpa [g, Complex.real_smul] using hinv

/-- Exact Dirichlet sine-sine Lorentzian integral for all `t, s : ℝ` and `ω > 0`:
`π⁻¹ ∫ sin(p₀ t) sin(p₀ s) / (p₀² + ω²) dp₀ = (exp(-ω|t-s|) - exp(-ω|t+s|)) / (2ω)`. -/
theorem lorentzian_sin_sin_integral {ω : ℝ} (hω : 0 < ω) (t s : ℝ) :
    (Real.pi⁻¹) * ∫ p₀ : ℝ, Real.sin (p₀ * t) * Real.sin (p₀ * s) / (p₀ ^ 2 + ω ^ 2) =
      expKernel1D ω (t - s) - expKernel1D ω (t + s) := by
  have hint_lorentz : Integrable (fun p₀ : ℝ => (p₀ ^ 2 + ω ^ 2)⁻¹) volume := by
    have h1 : Integrable (fun u : ℝ => (1 + u ^ 2)⁻¹) volume := integrable_inv_one_add_sq
    have hsc : Integrable (fun p₀ : ℝ => (1 + (ω⁻¹ * p₀) ^ 2)⁻¹) volume :=
      h1.comp_mul_left' (inv_ne_zero hω.ne')
    have heq : (fun p₀ : ℝ => (p₀ ^ 2 + ω ^ 2)⁻¹) =
        fun p₀ : ℝ => (ω ^ 2)⁻¹ * (1 + (ω⁻¹ * p₀) ^ 2)⁻¹ := by
      funext p₀; field_simp [hω.ne']; ring
    rw [heq]; exact hsc.const_mul _
  have hint_exp (r : ℝ) : Integrable (fun p₀ : ℝ =>
      Complex.exp (Complex.I * (p₀ : ℂ) * (r : ℂ)) / ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) volume := by
    refine hint_lorentz.mono' ?_ ?_
    · refine ((Complex.continuous_exp.comp
        ((continuous_const.mul Complex.continuous_ofReal).mul continuous_const)).div
        ((Complex.continuous_ofReal.pow 2).add continuous_const) fun p₀ => ?_).aestronglyMeasurable
      have hpos : (0 : ℝ) < p₀ ^ 2 + ω ^ 2 := by positivity
      have hcast : ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((p₀ ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
        push_cast; ring
      change (p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2 ≠ 0
      rw [hcast]
      exact Complex.ofReal_ne_zero.mpr hpos.ne'
    · filter_upwards with p₀
      have hpos : (0 : ℝ) < p₀ ^ 2 + ω ^ 2 := by positivity
      have hcast : ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((p₀ ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
        push_cast; ring
      rw [norm_div, hcast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos,
        show Complex.I * (p₀ : ℂ) * (r : ℂ) = ((p₀ * r : ℝ) : ℂ) * Complex.I by
          push_cast; ring,
        Complex.norm_exp_ofReal_mul_I, one_div]
  have hcos (r : ℝ) : (2 * Real.pi)⁻¹ * ∫ p₀ : ℝ, Real.cos (p₀ * r) / (p₀ ^ 2 + ω ^ 2) =
      expKernel1D ω r := by
    have hC := congrArg Complex.re (lorentzian_fourier_eq_expKernel1D hω r)
    rw [Complex.ofReal_re, ← Complex.ofReal_inv, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero] at hC
    have hre : (∫ p₀ : ℝ, Complex.exp (Complex.I * (p₀ : ℂ) * (r : ℂ)) /
        ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)).re =
        ∫ p₀ : ℝ, (Complex.exp (Complex.I * (p₀ : ℂ) * (r : ℂ)) /
          ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)).re :=
      (integral_re (hint_exp r)).symm
    rw [hre] at hC
    rw [← hC]
    congr 1
    refine integral_congr_ae (ae_of_all _ fun p₀ => ?_)
    dsimp only
    have hcast : ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((p₀ ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
      push_cast; ring
    rw [hcast, show Complex.I * (p₀ : ℂ) * (r : ℂ) = ((p₀ * r : ℝ) : ℂ) * Complex.I by
        push_cast; ring,
      Complex.exp_mul_I, Complex.div_ofReal_re,
      Complex.add_re, Complex.cos_ofReal_re, Complex.mul_re,
      Complex.sin_ofReal_re, Complex.I_re, mul_zero, Complex.sin_ofReal_im,
      Complex.I_im, zero_mul, sub_zero, add_zero]
  have hint_cos (r : ℝ) : Integrable (fun p₀ : ℝ => Real.cos (p₀ * r) / (p₀ ^ 2 + ω ^ 2)) volume := by
    refine hint_lorentz.mono' ?_ ?_
    · exact ((Real.continuous_cos.comp (continuous_id.mul continuous_const)).div
        ((continuous_id.pow 2).add continuous_const) fun p₀ => (by positivity : (0 : ℝ) < p₀ ^ 2 + ω ^ 2).ne').aestronglyMeasurable
    · filter_upwards with p₀
      have hpos : (0 : ℝ) < p₀ ^ 2 + ω ^ 2 := by positivity
      rw [Real.norm_eq_abs, abs_div, abs_of_pos hpos, div_eq_mul_inv]
      exact mul_le_of_le_one_left (inv_nonneg.mpr hpos.le) (Real.abs_cos_le_one _)
  have htrig : ∀ p₀ : ℝ, Real.sin (p₀ * t) * Real.sin (p₀ * s) / (p₀ ^ 2 + ω ^ 2) =
      (1 / 2 : ℝ) * (Real.cos (p₀ * (t - s)) / (p₀ ^ 2 + ω ^ 2) -
        Real.cos (p₀ * (t + s)) / (p₀ ^ 2 + ω ^ 2)) := by
    intro p₀
    have h1 : Real.cos (p₀ * (t - s)) - Real.cos (p₀ * (t + s)) =
        2 * (Real.sin (p₀ * t) * Real.sin (p₀ * s)) := by
      rw [mul_sub, mul_add, Real.cos_sub, Real.cos_add]; ring
    field_simp
    linarith
  simp_rw [htrig]
  rw [integral_const_mul, integral_sub (hint_cos (t - s)) (hint_cos (t + s))]
  have hpi : Real.pi⁻¹ * (1 / 2) = (2 * Real.pi)⁻¹ := by ring
  rw [← mul_assoc, hpi, mul_sub, hcos (t - s), hcos (t + s)]

/-! ### Part 1: Time-Zero Plane Kernel `planeKernel` (`K₀`) -/

/-- Temperate growth of `(m² + ‖x‖²)^α` on any Euclidean space for `m > 0` and `α : ℝ`. -/
lemma hasTemperateGrowth_sq_add_norm_sq_rpow {d : ℕ} {m : ℝ} (hm : 0 < m) (α : ℝ) :
    Function.HasTemperateGrowth (fun x : EuclideanSpace ℝ (Fin d) => (m ^ 2 + ‖x‖ ^ 2) ^ α) := by
  have h1 : Function.HasTemperateGrowth
      (fun x : EuclideanSpace ℝ (Fin d) => (1 + ‖x‖ ^ 2) ^ α) :=
    Function.hasTemperateGrowth_one_add_norm_sq_rpow (EuclideanSpace ℝ (Fin d)) α
  have hcomp : Function.HasTemperateGrowth
      (fun x : EuclideanSpace ℝ (Fin d) => (1 + ‖m⁻¹ • x‖ ^ 2) ^ α) :=
    h1.comp (show Function.HasTemperateGrowth
      (fun x : EuclideanSpace ℝ (Fin d) => m⁻¹ • x) from by fun_prop)
  have hmul : Function.HasTemperateGrowth
      (fun x : EuclideanSpace ℝ (Fin d) => (m ^ 2) ^ α * (1 + ‖m⁻¹ • x‖ ^ 2) ^ α) :=
    (Function.HasTemperateGrowth.const _).mul hcomp
  have heq : (fun x : EuclideanSpace ℝ (Fin d) => (m ^ 2 + ‖x‖ ^ 2) ^ α) =
      fun x => (m ^ 2) ^ α * (1 + ‖m⁻¹ • x‖ ^ 2) ^ α := by
    funext x
    rw [← Real.mul_rpow (by positivity) (by positivity)]
    congr 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hm), mul_pow]
    field_simp [hm.ne']
  rw [heq]; exact hmul

/-- Physics Fourier transform as a continuous `ℝ`-linear map `𝓢(ℝ^d, ℝ) →L[ℝ] 𝓢(ℝ^d, ℂ)`. -/
noncomputable def physicsFourierCLM (d : ℕ) :
    𝓢(EuclideanSpace ℝ (Fin d), ℝ) →L[ℝ] 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
  let toC : 𝓢(EuclideanSpace ℝ (Fin d), ℝ) →L[ℝ] 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
    SchwartzMap.postcompCLM Complex.ofRealCLM
  let ft : 𝓢(EuclideanSpace ℝ (Fin d), ℂ) →L[ℝ] 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
    (SchwartzMap.fourierTransformCLM ℂ).restrictScalars ℝ
  let scEquiv : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d) :=
    LinearEquiv.toContinuousLinearEquiv
      { toFun := fun x => (2 * Real.pi)⁻¹ • x
        invFun := fun x => (2 * Real.pi) • x
        left_inv := fun x => by
          dsimp only
          rw [smul_smul, mul_inv_cancel₀ (mul_pos two_pos Real.pi_pos).ne', one_smul]
        right_inv := fun x => by
          dsimp only
          rw [smul_smul, inv_mul_cancel₀ (mul_pos two_pos Real.pi_pos).ne', one_smul]
        map_add' := fun x y => smul_add _ _ _
        map_smul' := fun c x => by
          change (2 * Real.pi)⁻¹ • (c • x) = c • ((2 * Real.pi)⁻¹ • x)
          rw [smul_comm] }
  let compSc : 𝓢(EuclideanSpace ℝ (Fin d), ℂ) →L[ℝ] 𝓢(EuclideanSpace ℝ (Fin d), ℂ) :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℝ scEquiv
  ((2 * Real.pi) ^ (-(d : ℝ) / 2) : ℝ) • (compSc.comp (ft.comp toC))

@[simp] lemma physicsFourierCLM_apply {d : ℕ} (h : 𝓢(EuclideanSpace ℝ (Fin d), ℝ))
    (k : EuclideanSpace ℝ (Fin d)) :
    physicsFourierCLM d h k = physicsFourierExact h k := by
  unfold physicsFourierCLM physicsFourierExact
  simp only [FunLike.coe_smul, Pi.smul_apply, ContinuousLinearMap.comp_apply,
    SchwartzMap.compCLMOfContinuousLinearEquiv_apply, Function.comp_apply, Complex.real_smul]
  change ((2 * Real.pi) ^ (-(d : ℝ) / 2) : ℝ) *
      𝓕 (SchwartzMap.postcompCLM Complex.ofRealCLM h) ((2 * Real.pi)⁻¹ • k) = _
  rw [SchwartzMap.fourier_coe]
  rfl

/-- Plane-kernel spectral multiplier `√ħ / √(2 ω_m(k))` (in `ℂ`). -/
noncomputable def planeMult {n : ℕ} (ħ m : ℝ) (k : SpatialE n) : ℂ :=
  ((Real.sqrt ħ / Real.sqrt (2 * euclidDispersion m k) : ℝ) : ℂ)

lemma hasTemperateGrowth_planeMult {n : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m) :
    Function.HasTemperateGrowth (planeMult (n := n) ħ m) := by
  have hrpow : Function.HasTemperateGrowth
      (fun k : SpatialE n => (m ^ 2 + ‖k‖ ^ 2) ^ (-1 / 4 : ℝ)) :=
    hasTemperateGrowth_sq_add_norm_sq_rpow hm (-1 / 4)
  have hreal : Function.HasTemperateGrowth
      (fun k : SpatialE n => Real.sqrt ħ / Real.sqrt (2 * euclidDispersion m k)) := by
    have heq : (fun k : SpatialE n => Real.sqrt ħ / Real.sqrt (2 * euclidDispersion m k)) =
        fun k => (Real.sqrt ħ / Real.sqrt 2) * (m ^ 2 + ‖k‖ ^ 2) ^ (-1 / 4 : ℝ) := by
      funext k
      have hpos : 0 < m ^ 2 + ‖k‖ ^ 2 := by positivity
      unfold euclidDispersion
      rw [Real.sqrt_mul two_pos.le,
        show Real.sqrt (Real.sqrt (m ^ 2 + ‖k‖ ^ 2)) = (m ^ 2 + ‖k‖ ^ 2) ^ (1 / 4 : ℝ) by
          rw [Real.sqrt_eq_rpow, Real.sqrt_eq_rpow, ← Real.rpow_mul hpos.le]
          norm_num,
        show (-1 / 4 : ℝ) = -(1 / 4 : ℝ) by ring,
        Real.rpow_neg hpos.le]
      ring
    rw [heq]
    exact (Function.HasTemperateGrowth.const _).mul hrpow
  exact Complex.hasTemperateGrowth_ofReal.comp hreal

/-- Time-zero plane kernel `K₀` as a continuous `ℝ`-linear map `𝓢(SpatialE n, ℝ) →L[ℝ] 𝓢(SpatialE n, ℂ)`. -/
noncomputable def planeKernelCLM (n : ℕ) (ħ m : ℝ) (_hm : 0 < m) :
    𝓢(SpatialE n, ℝ) →L[ℝ] 𝓢(SpatialE n, ℂ) :=
  ((SchwartzMap.smulLeftCLM ℂ (planeMult (n := n) ħ m)).restrictScalars ℝ).comp
    (physicsFourierCLM (n + 1))

/-- Time-zero plane kernel `K₀ h k = (√ħ / √(2 ω_m(k))) * physicsFourierExact h k`. -/
noncomputable def planeKernel (n : ℕ) (ħ m : ℝ) (h : 𝓢(SpatialE n, ℝ)) (k : SpatialE n) : ℂ :=
  planeMult ħ m k * physicsFourierExact h k

lemma planeKernel_eq_clm (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (h : 𝓢(SpatialE n, ℝ)) (k : SpatialE n) :
    planeKernel n ħ m h k = planeKernelCLM n ħ m hm h k := by
  unfold planeKernel planeKernelCLM
  simp [SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_planeMult ħ hm)]

lemma planeKernel_add (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (h₁ h₂ : 𝓢(SpatialE n, ℝ)) (k : SpatialE n) :
    planeKernel n ħ m (h₁ + h₂) k = planeKernel n ħ m h₁ k + planeKernel n ħ m h₂ k := by
  simp only [planeKernel_eq_clm n ħ hm, map_add]; rfl

lemma planeKernel_smul (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (c : ℝ) (h : 𝓢(SpatialE n, ℝ)) (k : SpatialE n) :
    planeKernel n ħ m (c • h) k = (c : ℂ) * planeKernel n ħ m h k := by
  simp only [planeKernel_eq_clm n ħ hm, map_smul]
  change c • planeKernelCLM n ħ m hm h k = (c : ℂ) * planeKernelCLM n ħ m hm h k
  exact Complex.real_smul

lemma planeKernel_contDiff (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m) (h : 𝓢(SpatialE n, ℝ)) :
    ContDiff ℝ (⊤ : ℕ∞) (planeKernel n ħ m h) := by
  have heq : planeKernel n ħ m h = ⇑(planeKernelCLM n ħ m hm h) :=
    funext (planeKernel_eq_clm n ħ hm h)
  rw [heq]
  exact (planeKernelCLM n ħ m hm h).smooth ⊤

lemma planeKernel_memLp (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m) (h : 𝓢(SpatialE n, ℝ)) :
    MemLp (planeKernel n ħ m h) 2 volume := by
  have heq : planeKernel n ħ m h = ⇑(planeKernelCLM n ħ m hm h) :=
    funext (planeKernel_eq_clm n ħ hm h)
  rw [heq]
  exact (planeKernelCLM n ħ m hm h).memLp 2 volume

lemma planeKernel_integrable_norm_sq (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (h : 𝓢(SpatialE n, ℝ)) :
    Integrable (fun k : SpatialE n => ‖planeKernel n ħ m h k‖ ^ 2) volume :=
  (planeKernel_memLp n ħ hm h).norm.integrable_sq

/-- Exact plane covariance formula:
`∫ k, ‖planeKernel n ħ m h k‖² = ħ ∫ k, ‖physicsFourierExact h k‖² / (2 ω_m(k))`. -/
theorem planeKernel_norm_sq_integral (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (h : 𝓢(SpatialE n, ℝ)) :
    (∫ k : SpatialE n, ‖planeKernel n ħ m h k‖ ^ 2) =
      ħ * ∫ k : SpatialE n, ‖physicsFourierExact h k‖ ^ 2 * (2 * euclidDispersion m k)⁻¹ := by
  rw [← integral_const_mul]
  refine integral_congr_ae (ae_of_all _ fun k => ?_)
  dsimp only
  unfold planeKernel planeMult
  have hω : 0 < euclidDispersion m k := euclidDispersion_pos hm k
  rw [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs, div_pow,
    Real.sq_sqrt hħ, Real.sq_sqrt (by positivity : (0 : ℝ) ≤ 2 * euclidDispersion m k)]
  ring

/-- Reality of the `L²` inner product of `planeKernel` on real Schwartz functions. -/
theorem planeKernel_inner_im_zero (n : ℕ) (ħ m : ℝ)
    (h₁ h₂ : 𝓢(SpatialE n, ℝ)) :
    (∫ k : SpatialE n, star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k).im = 0 := by
  have hneg := MeasureTheory.integral_neg_eq_self
    (fun k : SpatialE n => star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k) volume
  have hconj : (∫ k : SpatialE n,
      star (planeKernel n ħ m h₁ (-k)) * planeKernel n ħ m h₂ (-k)) =
      star (∫ k : SpatialE n, star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k) := by
    rw [RCLike.star_def, ← integral_conj]
    refine integral_congr_ae (ae_of_all _ fun k => ?_)
    dsimp only
    have hK (h : 𝓢(SpatialE n, ℝ)) : planeKernel n ħ m h (-k) = star (planeKernel n ħ m h k) := by
      unfold planeKernel planeMult
      rw [euclidDispersion_neg, physicsFourierExact_neg, RCLike.star_def, map_mul,
        Complex.conj_ofReal]
    rw [hK h₁, hK h₂]
    simp [RCLike.star_def]
  have heq : star (∫ k : SpatialE n, star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k) =
      ∫ k : SpatialE n, star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k := by
    rw [← hconj, hneg]
  have him := congrArg Complex.im heq
  change -(∫ k : SpatialE n, star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k).im =
      (∫ k : SpatialE n, star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k).im at him
  linarith

/-- Elementary lattice-cell weight inequality:
for `z : Fin d → ℤ` and `u` with `∀ i, |u i| ≤ 1`,
`∏ i, (1 + (z i)^2) ≤ 3^d * (1 + ‖z + u‖^2)^d`. -/
lemma prod_one_add_int_sq_le {d : ℕ} (z : Fin d → ℤ) (u : EuclideanSpace ℝ (Fin d))
    (hu : ∀ i, |u i| ≤ 1) :
    (∏ i : Fin d, (1 + (z i : ℝ) ^ 2)) ≤
      3 ^ d * (1 + ‖WithLp.toLp 2 (fun i => (z i : ℝ)) + u‖ ^ 2) ^ d := by
  let x : EuclideanSpace ℝ (Fin d) := WithLp.toLp 2 (fun i => (z i : ℝ)) + u
  have hcoord : ∀ i : Fin d, 1 + (z i : ℝ) ^ 2 ≤ 3 * (1 + ‖x‖ ^ 2) := by
    intro i
    have hxi : (z i : ℝ) = x i - u i := by simp [x]
    have hzu : (z i : ℝ) ^ 2 ≤ 2 * (x i) ^ 2 + 2 * (u i) ^ 2 := by
      rw [hxi]; nlinarith [sq_nonneg (x i + u i)]
    have hu2 : (u i) ^ 2 ≤ 1 := by nlinarith [sq_abs (u i), abs_nonneg (u i), hu i]
    have hle : (x i) ^ 2 ≤ ‖x‖ ^ 2 := by
      have h := PiLp.norm_apply_le x i
      simpa [Real.norm_eq_abs, sq_abs] using pow_le_pow_left₀ (abs_nonneg _) h 2
    nlinarith
  calc ∏ i : Fin d, (1 + (z i : ℝ) ^ 2)
      ≤ ∏ _i : Fin d, (3 * (1 + ‖x‖ ^ 2)) := by
        gcongr with i _
        exact hcoord i
    _ = 3 ^ d * (1 + ‖x‖ ^ 2) ^ d := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, mul_pow]

/-- Uniform Schwartz cell-decay bound: for any `d` and `K`, there exist `s : Finset (ℕ × ℕ)` and `C > 0`
such that every `g : 𝓢(ℝ^d, ℂ)` satisfies the `∏ (1 + z_i^2)⁻¹` derivative bound on `z + [-1,1]^d`. -/
lemma schwartz_iteratedFDeriv_lattice_bound (d K : ℕ) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (g : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (z : Fin d → ℤ)
        (k : ℕ), k ≤ K →
        ∀ (u : EuclideanSpace ℝ (Fin d)), (∀ i, u i ∈ Set.Icc (-1 : ℝ) 1) →
          ‖iteratedFDeriv ℝ k g (WithLp.toLp 2 (fun i => (z i : ℝ)) + u)‖ ≤
            C * (∏ i : Fin d, (1 + (z i : ℝ) ^ 2)⁻¹) *
              (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g := by
  let s : Finset (ℕ × ℕ) := (Finset.range (K + 1)).biUnion fun k => {(0, k), (2 * d, k)}
  let C : ℝ := 3 ^ d * 2 ^ d * 2
  refine ⟨s, C, by positivity, fun g z k hk u hu => ?_⟩
  let x : EuclideanSpace ℝ (Fin d) := WithLp.toLp 2 (fun i => (z i : ℝ)) + u
  have hu_abs : ∀ i, |u i| ≤ 1 := fun i => abs_le.mpr (hu i)
  have hprod_pos : (0 : ℝ) < ∏ i : Fin d, (1 + (z i : ℝ) ^ 2) :=
    Finset.prod_pos fun i _ => by positivity
  rw [Finset.prod_inv_distrib, mul_comm C _, mul_assoc, ← div_eq_inv_mul,
    le_div_iff₀' hprod_pos]
  have h1 : (1 + ‖x‖ ^ 2) ^ d ≤ 2 ^ d * (1 + ‖x‖ ^ (2 * d)) := by
    rcases le_or_gt ‖x‖ 1 with hle | hgt
    · have h2 : 1 + ‖x‖ ^ 2 ≤ 2 := by nlinarith [norm_nonneg x]
      calc (1 + ‖x‖ ^ 2) ^ d ≤ 2 ^ d := pow_le_pow_left₀ (by positivity) h2 d
        _ ≤ 2 ^ d * (1 + ‖x‖ ^ (2 * d)) := by
          nlinarith [pow_nonneg (norm_nonneg x) (2 * d), pow_pos (two_pos : (0 : ℝ) < 2) d]
    · have h2 : 1 + ‖x‖ ^ 2 ≤ 2 * ‖x‖ ^ 2 := by nlinarith
      calc (1 + ‖x‖ ^ 2) ^ d ≤ (2 * ‖x‖ ^ 2) ^ d := pow_le_pow_left₀ (by positivity) h2 d
        _ = 2 ^ d * ‖x‖ ^ (2 * d) := by rw [mul_pow, ← pow_mul]
        _ ≤ 2 ^ d * (1 + ‖x‖ ^ (2 * d)) := by
          nlinarith [pow_pos (two_pos : (0 : ℝ) < 2) d]
  have hmem0 : (0, k) ∈ s := Finset.mem_biUnion.mpr ⟨k, Finset.mem_range.mpr (by omega), by simp⟩
  have hmem2d : (2 * d, k) ∈ s := Finset.mem_biUnion.mpr ⟨k, Finset.mem_range.mpr (by omega), by simp⟩
  have hsem0 : ‖iteratedFDeriv ℝ k g x‖ ≤ (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g := by
    have h := g.le_seminorm ℝ 0 k x
    simp only [pow_zero, one_mul] at h
    exact h.trans (Finset.le_sup (f := fun p : ℕ × ℕ => SchwartzMap.seminorm ℝ p.1 p.2) hmem0 g)
  have hsem2d : ‖x‖ ^ (2 * d) * ‖iteratedFDeriv ℝ k g x‖ ≤
      (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g := by
    exact (g.le_seminorm ℝ (2 * d) k x).trans
      (Finset.le_sup (f := fun p : ℕ × ℕ => SchwartzMap.seminorm ℝ p.1 p.2) hmem2d g)
  have hprod := prod_one_add_int_sq_le z u hu_abs
  have hsum : (1 + ‖x‖ ^ (2 * d)) * ‖iteratedFDeriv ℝ k g x‖ ≤
      2 * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g := by
    rw [add_mul, one_mul]; linarith
  calc (∏ i : Fin d, (1 + (z i : ℝ) ^ 2)) * ‖iteratedFDeriv ℝ k g x‖
      ≤ (3 ^ d * (1 + ‖x‖ ^ 2) ^ d) * ‖iteratedFDeriv ℝ k g x‖ :=
        mul_le_mul_of_nonneg_right hprod (norm_nonneg _)
    _ ≤ (3 ^ d * (2 ^ d * (1 + ‖x‖ ^ (2 * d)))) * ‖iteratedFDeriv ℝ k g x‖ := by
        gcongr
    _ = 3 ^ d * 2 ^ d * ((1 + ‖x‖ ^ (2 * d)) * ‖iteratedFDeriv ℝ k g x‖) := by ring
    _ ≤ 3 ^ d * 2 ^ d * (2 * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g) := by
        gcongr
    _ = C * (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g := by dsimp [C]; ring

/-- Pullback of a finite Schwartz seminorm family through any continuous `ℝ`-linear map between
Schwartz spaces. -/
lemma schwartz_clm_seminorm_bound {E₁ F₁ E₂ F₂ : Type*}
    [NormedAddCommGroup E₁] [NormedSpace ℝ E₁]
    [NormedAddCommGroup F₁] [NormedSpace ℝ F₁]
    [NormedAddCommGroup E₂] [NormedSpace ℝ E₂]
    [NormedAddCommGroup F₂] [NormedSpace ℝ F₂]
    (T : 𝓢(E₁, F₁) →L[ℝ] 𝓢(E₂, F₂)) (s₂ : Finset (ℕ × ℕ)) :
    ∃ (s₁ : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ f : 𝓢(E₁, F₁),
        (s₂.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) (T f) ≤
          C * (s₁.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f := by
  let q : Seminorm ℝ 𝓢(E₁, F₁) :=
    (s₂.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)).comp T.toLinearMap
  have hsup_cont : ∀ s : Finset (ℕ × ℕ),
      Continuous (fun g : 𝓢(E₂, F₂) => (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      simpa using (continuous_const : Continuous (fun _ : 𝓢(E₂, F₂) => (0 : ℝ)))
    | @insert a s ha ih =>
      have ha_cont : Continuous (fun g : 𝓢(E₂, F₂) => SchwartzMap.seminorm ℝ a.1 a.2 g) :=
        (schwartz_withSeminorms ℝ E₂ F₂).continuous_seminorm a
      have hfn : (fun g : 𝓢(E₂, F₂) =>
            ((insert a s).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g) =
          fun g => max (SchwartzMap.seminorm ℝ a.1 a.2 g)
            ((s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) g) := by
        funext g
        simp [Finset.sup_insert, Seminorm.coe_sup, Pi.sup_apply]
      rw [hfn]
      exact ha_cont.max ih
  have hq_cont : Continuous q := (hsup_cont s₂).comp T.continuous
  obtain ⟨s₁, C, hCne, hbound⟩ :=
    Seminorm.bound_of_continuous (schwartz_withSeminorms ℝ E₁ F₁) q hq_cont
  have hCpos : (0 : ℝ) < (C : ℝ) := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hCne)
  exact ⟨s₁, (C : ℝ), hCpos, fun f => hbound f⟩

/-- **Deliverable 1:** Exact uniform derivative bound for `planeKernel` matching Track 1's Fourier frame. -/
theorem planeKernel_iteratedFDeriv_bound (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (z : Fin (n + 1) → ℤ) (k : ℕ), k ≤ 2 * (n + 1) →
        ∀ (u : SpatialE n), (∀ i, u i ∈ Set.Icc (-1 : ℝ) 1) →
          ∀ (h : 𝓢(SpatialE n, ℝ)),
            ‖iteratedFDeriv ℝ k (planeKernel n ħ m h)
                (WithLp.toLp 2 (fun i => (z i : ℝ)) + u)‖ ≤
              C * (∏ i : Fin (n + 1), (1 + (z i : ℝ) ^ 2)⁻¹) *
                (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h := by
  obtain ⟨s₂, C₂, hC₂, hlat⟩ := schwartz_iteratedFDeriv_lattice_bound (n + 1) (2 * (n + 1))
  obtain ⟨s₁, C₁, hC₁, hclm⟩ := schwartz_clm_seminorm_bound (planeKernelCLM n ħ m hm) s₂
  refine ⟨s₁, C₂ * C₁, mul_pos hC₂ hC₁, fun z k hk u hu h => ?_⟩
  have heq : planeKernel n ħ m h = ⇑(planeKernelCLM n ħ m hm h) :=
    funext (planeKernel_eq_clm n ħ hm h)
  rw [heq]
  calc ‖iteratedFDeriv ℝ k (planeKernelCLM n ħ m hm h)
          (WithLp.toLp 2 (fun i => (z i : ℝ)) + u)‖
      ≤ C₂ * (∏ i : Fin (n + 1), (1 + (z i : ℝ) ^ 2)⁻¹) *
          (s₂.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) (planeKernelCLM n ħ m hm h) :=
        hlat (planeKernelCLM n ħ m hm h) z k hk u hu
    _ ≤ C₂ * (∏ i : Fin (n + 1), (1 + (z i : ℝ) ^ 2)⁻¹) *
          (C₁ * (s₁.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h) := by
        gcongr
        exact hclm h
    _ = (C₂ * C₁) * (∏ i : Fin (n + 1), (1 + (z i : ℝ) ^ 2)⁻¹) *
          (s₁.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) h := by ring

/-! ### Part 2: Poisson Time-Zero Projection `poissonProj` (`P₀`) -/

/-- Momentum-space Poisson multiplier in Mathlib's `2π` Fourier convention:
`2 ω_m(2π ξ_sp) / ((2π)² ‖ξ‖² + m²)`. -/
noncomputable def poissonMult {n : ℕ} (m : ℝ) (ξ : EuclidD n) : ℝ :=
  2 * euclidDispersion m ((2 * Real.pi) • spatialProj ξ) *
    ((2 * Real.pi) ^ 2 * ‖ξ‖ ^ 2 + m ^ 2)⁻¹

lemma hasTemperateGrowth_poissonMult {n : ℕ} {m : ℝ} (hm : 0 < m) :
    Function.HasTemperateGrowth (poissonMult (n := n) m) := by
  have h1 : Function.HasTemperateGrowth
      (fun ξ : EuclidD n => euclidDispersion m ((2 * Real.pi) • spatialProj ξ)) := by
    have hdisp : Function.HasTemperateGrowth
        (fun k : SpatialE n => (m ^ 2 + ‖k‖ ^ 2) ^ (1 / 2 : ℝ)) :=
      hasTemperateGrowth_sq_add_norm_sq_rpow hm (1 / 2)
    have hsp : Function.HasTemperateGrowth
        (fun ξ : EuclidD n => (2 * Real.pi) • spatialProj ξ) := by
      let L : EuclidD n →L[ℝ] SpatialE n :=
        (2 * Real.pi) • ((ContinuousLinearMap.snd ℝ ℝ (SpatialE n)).comp
          (timeSpatialCLE n).toContinuousLinearMap)
      exact L.hasTemperateGrowth
    have hcomp := hdisp.comp hsp
    have heq : (fun ξ : EuclidD n => euclidDispersion m ((2 * Real.pi) • spatialProj ξ)) =
        fun ξ => (m ^ 2 + ‖(2 * Real.pi) • spatialProj ξ‖ ^ 2) ^ (1 / 2 : ℝ) := by
      funext ξ; unfold euclidDispersion; rw [Real.sqrt_eq_rpow]
    rw [heq]; exact hcomp
  have h2 : Function.HasTemperateGrowth
      (fun ξ : EuclidD n => ((2 * Real.pi) ^ 2 * ‖ξ‖ ^ 2 + m ^ 2)⁻¹) := by
    have hr := hasTemperateGrowth_sq_add_norm_sq_rpow (d := n + 2) hm (-1)
    have hsc : Function.HasTemperateGrowth (fun ξ : EuclidD n => (2 * Real.pi) • ξ) := by fun_prop
    have hcomp := hr.comp hsc
    have heq : (fun ξ : EuclidD n => ((2 * Real.pi) ^ 2 * ‖ξ‖ ^ 2 + m ^ 2)⁻¹) =
        fun ξ => (m ^ 2 + ‖(2 * Real.pi) • ξ‖ ^ 2) ^ (-1 : ℝ) := by
      funext ξ
      rw [Real.rpow_neg_one, norm_smul, Real.norm_eq_abs,
        abs_of_pos (mul_pos two_pos Real.pi_pos)]
      congr 1; ring
    rw [heq]; exact hcomp
  exact ((Function.HasTemperateGrowth.const (2 : ℝ)).mul h1).mul h2

/-- Complex Poisson projection in `𝓢(EuclidD n, ℂ) →L[ℂ] 𝓢(EuclidD n, ℂ)` before restricting to `t = 0`:
`f ↦ 𝓕⁻ (poissonMult m · • 𝓕 f)`. -/
noncomputable def poissonLiftC (n : ℕ) (m : ℝ) :
    𝓢(EuclidD n, ℂ) →L[ℂ] 𝓢(EuclidD n, ℂ) :=
  ((SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
      (LinearIsometryEquiv.neg ℝ (E := EuclidD n)).toContinuousLinearEquiv).comp
    (SchwartzMap.fourierTransformCLM ℂ)).comp
    ((SchwartzMap.smulLeftCLM ℂ (fun ξ : EuclidD n => (poissonMult m ξ : ℂ))).comp
      (SchwartzMap.fourierTransformCLM ℂ))

lemma poissonLiftC_apply (n : ℕ) (m : ℝ) (g : 𝓢(EuclidD n, ℂ)) :
    poissonLiftC n m g =
      𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (fun ξ : EuclidD n => (poissonMult m ξ : ℂ)) (𝓕 g)) := rfl

/-- **Deliverable 2:** Poisson time-zero projection `P₀ : 𝓢(EuclidD n, ℝ) →L[ℝ] 𝓢(SpatialE n, ℝ)`. -/
noncomputable def poissonProj (n : ℕ) (m : ℝ) (_hm : 0 < m) :
    𝓢(EuclidD n, ℝ) →L[ℝ] 𝓢(SpatialE n, ℝ) :=
  (SchwartzMap.postcompCLM Complex.reCLM).comp
    (((restrictTimeCLM ℂ ℂ 0).comp (poissonLiftC n m)).restrictScalars ℝ |>.comp
      (SchwartzMap.postcompCLM Complex.ofRealCLM))

lemma poissonMult_neg {n : ℕ} (m : ℝ) (ξ : EuclidD n) :
    poissonMult m (-ξ) = poissonMult m ξ := by
  unfold poissonMult
  have hsp : spatialProj (-ξ) = -spatialProj ξ := by ext i; rfl
  rw [hsp, smul_neg, euclidDispersion_neg, norm_neg]

lemma poissonMult_reflect {n : ℕ} (m : ℝ) (ξ : EuclidD n) :
    poissonMult m (euclidTimeReflect ξ) = poissonMult m ξ := by
  unfold poissonMult
  have hnorm : ‖euclidTimeReflect ξ‖ = ‖ξ‖ := (euclidTimeReflectLI n).norm_map ξ
  rw [spatialProj_euclidTimeReflect, hnorm]

/-- For real Schwartz `f`, the lifted Poisson potential `poissonLiftC n m (ofReal f)` is purely real. -/
lemma poissonLiftC_real {n : ℕ} {m : ℝ} (hm : 0 < m) (f : 𝓢(EuclidD n, ℝ)) (x : EuclidD n) :
    (((poissonLiftC n m (SchwartzMap.postcompCLM Complex.ofRealCLM f) x).re : ℝ) : ℂ) =
      poissonLiftC n m (SchwartzMap.postcompCLM Complex.ofRealCLM f) x := by
  let fC := SchwartzMap.postcompCLM Complex.ofRealCLM f
  let w : EuclidD n → ℂ := fun ξ => (poissonMult m ξ : ℂ)
  have hw : w.HasTemperateGrowth :=
    Complex.hasTemperateGrowth_ofReal.comp (hasTemperateGrowth_poissonMult hm)
  let ψ := SchwartzMap.smulLeftCLM ℂ w (𝓕 fC)
  have hconj_char (t : ℝ) : starRingEnd ℂ (Real.fourierChar t : ℂ) = (Real.fourierChar (-t) : ℂ) := by
    simp only [Real.fourierChar_apply, ← Complex.exp_conj]
    congr 1; simp [Complex.conj_ofReal, map_ofNat]
  have hconj_fourier : ∀ ξ, starRingEnd ℂ (𝓕 fC (-ξ)) = 𝓕 fC ξ := by
    intro ξ
    simp_rw [SchwartzMap.fourier_coe, Real.fourier_eq]
    rw [← integral_conj]
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    have hfCy : starRingEnd ℂ (fC y) = fC y := by simp [fC]
    simp only [Circle.smul_def, smul_eq_mul, map_mul, hfCy, hconj_char, inner_neg_right, neg_neg]
  have hconj_ψ : ∀ ξ, starRingEnd ℂ (ψ (-ξ)) = ψ ξ := by
    intro ξ
    simp only [ψ, SchwartzMap.smulLeftCLM_apply_apply hw, smul_eq_mul, map_mul, w,
      Complex.conj_ofReal, hconj_fourier, poissonMult_neg]
  have hreal : starRingEnd ℂ (poissonLiftC n m fC x) = poissonLiftC n m fC x := by
    rw [poissonLiftC_apply]
    change starRingEnd ℂ (𝓕⁻ ψ x) = 𝓕⁻ ψ x
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq, ← integral_conj]
    have hneg := MeasureTheory.integral_neg_eq_self
      (fun ξ : EuclidD n => (Real.fourierChar (inner ℝ ξ x) : ℂ) • ψ ξ) volume
    change ∫ ξ : EuclidD n,
        (starRingEnd ℂ) ((Real.fourierChar (inner ℝ ξ x) : ℂ) • ψ ξ) =
      ∫ ξ : EuclidD n, (Real.fourierChar (inner ℝ ξ x) : ℂ) • ψ ξ
    rw [← hneg]
    refine integral_congr_ae (ae_of_all _ fun ξ => ?_)
    dsimp only
    have hψ_neg : (starRingEnd ℂ) (ψ ξ) = ψ (-ξ) := by
      have h := congrArg (starRingEnd ℂ) (hconj_ψ ξ)
      simpa using h.symm
    simp only [smul_eq_mul, map_mul, hconj_char, hψ_neg, inner_neg_left]
  exact Complex.conj_eq_iff_re.mp hreal

/-- At `t = 0`, `poissonProj n m hm f` agrees with the complex lift without discarding any imaginary part. -/
lemma poissonProj_ofReal {n : ℕ} {m : ℝ} (hm : 0 < m) (f : 𝓢(EuclidD n, ℝ)) (y : SpatialE n) :
    ((poissonProj n m hm f y : ℝ) : ℂ) =
      poissonLiftC n m (SchwartzMap.postcompCLM Complex.ofRealCLM f) (euclidCons 0 y) := by
  simpa [poissonProj] using poissonLiftC_real hm f (euclidCons 0 y)

/-- **Time-reflection invariance of `poissonProj`:** `P₀ (Θ f) = P₀ f`. -/
theorem poissonProj_reflectSchwartz {n : ℕ} {m : ℝ} (hm : 0 < m) (f : 𝓢(EuclidD n, ℝ)) :
    poissonProj n m hm (reflectSchwartz f) = poissonProj n m hm f := by
  ext y
  have hC : ((poissonProj n m hm (reflectSchwartz f) y : ℝ) : ℂ) =
      ((poissonProj n m hm f y : ℝ) : ℂ) := by
    rw [poissonProj_ofReal hm, poissonProj_ofReal hm]
    let fC := SchwartzMap.postcompCLM Complex.ofRealCLM f
    let gC := SchwartzMap.postcompCLM Complex.ofRealCLM (reflectSchwartz f)
    have hw : (fun ξ : EuclidD n => (poissonMult m ξ : ℂ)).HasTemperateGrowth :=
      Complex.hasTemperateGrowth_ofReal.comp (hasTemperateGrowth_poissonMult hm)
    have hFg : ∀ ξ : EuclidD n, 𝓕 gC ξ = 𝓕 fC (euclidTimeReflect ξ) := by
      intro ξ
      rw [SchwartzMap.fourier_coe, SchwartzMap.fourier_coe, Real.fourier_eq, Real.fourier_eq]
      have hmp := (measurePreserving_euclidTimeReflect n).integral_comp'
        (f := (euclidTimeReflectLI n).toHomeomorph.toMeasurableEquiv)
        (g := fun x : EuclidD n => (Real.fourierChar (-inner ℝ x (euclidTimeReflect ξ))) • fC x)
      rw [← hmp]
      refine integral_congr_ae (ae_of_all _ fun x => ?_)
      dsimp only
      have hmeq : (euclidTimeReflectLI n).toHomeomorph.toMeasurableEquiv x = euclidTimeReflect x := rfl
      rw [hmeq, euclidTimeReflect_inner, euclidTimeReflect_involutive]
      rfl
    rw [poissonLiftC_apply, poissonLiftC_apply, SchwartzMap.fourierInv_coe,
      SchwartzMap.fourierInv_coe, Real.fourierInv_eq, Real.fourierInv_eq]
    have hmp := (measurePreserving_euclidTimeReflect n).integral_comp'
      (f := (euclidTimeReflectLI n).toHomeomorph.toMeasurableEquiv)
      (g := fun ξ : EuclidD n => (Real.fourierChar (inner ℝ ξ (euclidCons 0 y))) •
        (SchwartzMap.smulLeftCLM ℂ (fun η => (poissonMult m η : ℂ)) (𝓕 fC)) ξ)
    rw [← hmp]
    refine integral_congr_ae (ae_of_all _ fun ξ => ?_)
    dsimp only
    have hmeq : (euclidTimeReflectLI n).toHomeomorph.toMeasurableEquiv ξ = euclidTimeReflect ξ := rfl
    rw [hmeq, SchwartzMap.smulLeftCLM_apply_apply hw, SchwartzMap.smulLeftCLM_apply_apply hw]
    change (Real.fourierChar (inner ℝ ξ (euclidCons 0 y))) • ((poissonMult m ξ : ℂ) • 𝓕 gC ξ) =
      (Real.fourierChar (inner ℝ (euclidTimeReflect ξ) (euclidCons 0 y))) •
        ((poissonMult m (euclidTimeReflect ξ) : ℂ) • 𝓕 fC (euclidTimeReflect ξ))
    rw [hFg ξ, poissonMult_reflect, euclidTimeReflect_inner, euclidTimeReflect_euclidCons, neg_zero]
  exact Complex.ofReal_injective hC

/-- Spatial Fourier transform of `poissonProj f` equals the marginal integral of the lifted symbol. -/
lemma fourier_poissonProj_eq_marginal {n : ℕ} {m : ℝ} (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) (ξ_sp : SpatialE n) :
    𝓕 (fun y : SpatialE n => (poissonProj n m hm f y : ℂ)) ξ_sp =
      ∫ τ : ℝ, (poissonMult m (euclidCons τ ξ_sp) : ℂ) *
        𝓕 (fun x : EuclidD n => (f x : ℂ)) (euclidCons τ ξ_sp) := by
  let fC := SchwartzMap.postcompCLM Complex.ofRealCLM f
  have hw : (fun ξ : EuclidD n => (poissonMult m ξ : ℂ)).HasTemperateGrowth :=
    Complex.hasTemperateGrowth_ofReal.comp (hasTemperateGrowth_poissonMult hm)
  let ψ : 𝓢(EuclidD n, ℂ) := SchwartzMap.smulLeftCLM ℂ (fun ξ => (poissonMult m ξ : ℂ)) (𝓕 fC)
  let M : SpatialE n → ℂ := fun η => ∫ τ : ℝ, ψ (euclidCons τ η)
  have hψ_prod : Integrable (fun q : ℝ × SpatialE n => ψ (euclidCons q.1 q.2)) volume :=
    (measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable ψ.integrable
  have hM_int : Integrable M volume := hψ_prod.integral_prod_right
  have hM_cont : Continuous M := by
    obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ x : EuclidD n, (1 + ‖x‖) ^ 2 * ‖ψ x‖ ≤ C := by
      refine ⟨2 ^ 2 * ((Finset.Iic (2, 0)).sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2) ψ),
        fun x => ?_⟩
      simpa using SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (2, 0)) (k := 2) (n := 0)
        le_rfl le_rfl ψ x
    have hbound_int : Integrable (fun τ : ℝ => C / (1 + |τ|) ^ 2) volume := by
      have h1 : Integrable (fun τ : ℝ => (1 + τ ^ 2)⁻¹) volume := integrable_inv_one_add_sq
      refine (h1.const_mul (max C 0)).mono' ?_ ?_
      · exact (continuous_const.div ((continuous_const.add continuous_abs).pow 2)
          fun τ => (by positivity : (0 : ℝ) < (1 + |τ|) ^ 2).ne').aestronglyMeasurable
      · filter_upwards with τ
        have hpos : (0 : ℝ) < (1 + |τ|) ^ 2 := by positivity
        have hle : 1 + τ ^ 2 ≤ (1 + |τ|) ^ 2 := by
          nlinarith [sq_abs τ, abs_nonneg τ]
        rw [Real.norm_eq_abs, abs_div, abs_of_pos hpos, div_eq_mul_inv]
        have hCabs : |C| ≤ max C 0 := by
          have hCnn : 0 ≤ C := by
            have h0 := hC 0
            simp only [norm_zero, add_zero, one_pow, one_mul] at h0
            exact (norm_nonneg _).trans h0
          rw [abs_of_nonneg hCnn]; exact le_max_left _ _
        exact mul_le_mul hCabs (inv_anti₀ (by positivity) hle) (by positivity) (le_max_right _ _)
    refine continuous_of_dominated (bound := fun τ => C / (1 + |τ|) ^ 2) ?_ ?_ hbound_int ?_
    · intro η
      exact (ψ.continuous.comp ((timeSpatialCLE n).symm.continuous.comp
        (continuous_id.prodMk continuous_const))).aestronglyMeasurable
    · intro η
      filter_upwards with τ
      have hτ_le : |τ| ≤ ‖euclidCons τ η‖ := by
        have h := PiLp.norm_apply_le (euclidCons τ η) 0
        simpa [Real.norm_eq_abs] using h
      have h1le : (1 + |τ|) ^ 2 ≤ (1 + ‖euclidCons τ η‖) ^ 2 :=
        pow_le_pow_left₀ (by positivity) (by linarith) 2
      rw [le_div_iff₀ (by positivity), mul_comm]
      exact (mul_le_mul_of_nonneg_right h1le (norm_nonneg _)).trans (hC (euclidCons τ η))
    · filter_upwards with τ
      exact ψ.continuous.comp ((timeSpatialCLE n).symm.continuous.comp
        (continuous_const.prodMk continuous_id))
  have hFM_eq : ∀ y : SpatialE n, 𝓕⁻ M y = (poissonProj n m hm f y : ℂ) := by
    intro y
    rw [poissonProj_ofReal hm f y, poissonLiftC_apply]
    change 𝓕⁻ M y = 𝓕⁻ ψ (euclidCons 0 y)
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq, Real.fourierInv_eq,
      integral_euclid_eq_prod]
    have hint_y : Integrable (fun q : ℝ × SpatialE n =>
        (Real.fourierChar (inner ℝ (euclidCons q.1 q.2) (euclidCons 0 y))) •
          ψ (euclidCons q.1 q.2)) volume := by
      refine hψ_prod.norm.mono' ?_ ?_
      · exact ((Real.continuous_fourierChar.comp (continuous_inner.comp
            (((timeSpatialCLE n).symm.continuous).prodMk continuous_const))).smul
            (ψ.continuous.comp (timeSpatialCLE n).symm.continuous)).aestronglyMeasurable
      · filter_upwards with q
        rw [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul]
    have hsymm : (∫ q : ℝ × SpatialE n,
        (Real.fourierChar (inner ℝ (euclidCons q.1 q.2) (euclidCons 0 y))) •
          ψ (euclidCons q.1 q.2)) =
        ∫ η : SpatialE n, ∫ τ : ℝ,
          (Real.fourierChar (inner ℝ (euclidCons τ η) (euclidCons 0 y))) •
            ψ (euclidCons τ η) := by
      simpa [Measure.volume_eq_prod] using MeasureTheory.integral_prod_symm _ hint_y
    rw [hsymm]
    refine integral_congr_ae (ae_of_all _ fun η => ?_)
    dsimp only [M]
    simp only [Circle.smul_def, smul_eq_mul, ← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun τ => ?_)
    dsimp only
    rw [euclidCons_inner, mul_zero, zero_add]
  have hP_int : Integrable (fun y : SpatialE n => (poissonProj n m hm f y : ℂ)) volume :=
    (poissonProj n m hm f).integrable.ofReal
  have hFM_int : Integrable (𝓕⁻ M) volume :=
    hP_int.congr (ae_of_all _ fun y => (hFM_eq y).symm)
  have hF_int : Integrable (𝓕 M) volume := by
    have heq : 𝓕 M = fun y : SpatialE n => 𝓕⁻ M (-y) := by
      funext y
      have h := Real.fourierInv_eq_fourier_neg M (-y)
      simpa using h.symm
    rw [heq]
    exact hFM_int.comp_neg
  have hinv := congrFun (hM_cont.fourier_fourierInv_eq hM_int hF_int) ξ_sp
  have hEqFun : (fun y : SpatialE n => (poissonProj n m hm f y : ℂ)) = 𝓕⁻ M :=
    funext fun y => (hFM_eq y).symm
  rw [hEqFun, hinv]
  refine integral_congr_ae (ae_of_all _ fun τ => ?_)
  dsimp only
  simp only [ψ, SchwartzMap.smulLeftCLM_apply_apply hw, smul_eq_mul, SchwartzMap.fourier_coe]
  rfl

/-- Continuity of `t ↦ spatialPhysicsFourier f t k` for fixed `k : SpatialE n`. -/
lemma continuous_spatialPhysicsFourier {n : ℕ} (f : 𝓢(EuclidD n, ℝ)) (k : SpatialE n) :
    Continuous (fun t : ℝ => spatialPhysicsFourier f t k) := by
  unfold spatialPhysicsFourier
  simp_rw [physicsFourierExact_eq_integral]
  refine continuous_const.mul ?_
  obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ x : EuclidD n, (1 + ‖x‖) ^ (n + 2) * ‖f x‖ ≤ C := by
    refine ⟨2 ^ (n + 2) * ((Finset.Iic (n + 2, 0)).sup
        (fun p => SchwartzMap.seminorm ℝ p.1 p.2) f), fun x => ?_⟩
    simpa using SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
      (m := (n + 2, 0)) (k := n + 2) (n := 0) le_rfl le_rfl f x
  have hdom_int : Integrable (fun y : SpatialE n => C * (1 + ‖y‖) ^ (-((n + 2 : ℕ) : ℝ))) volume := by
    have hI := integrable_one_add_norm (E := SpatialE n) (μ := volume) (r := ((n + 2 : ℕ) : ℝ))
      (by simp)
    exact hI.const_mul C
  refine continuous_of_dominated (bound := fun y => C * (1 + ‖y‖) ^ (-((n + 2 : ℕ) : ℝ)))
    ?_ ?_ hdom_int ?_
  · intro t
    exact ((Complex.continuous_exp.comp (by fun_prop)).mul
      (Complex.continuous_ofReal.comp
        (f.continuous.comp ((timeSpatialCLE n).symm.continuous.comp
          (continuous_const.prodMk continuous_id))))).aestronglyMeasurable
  · intro t
    filter_upwards with y
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      show -Complex.I * (inner ℝ y k : ℂ) = (-(inner ℝ y k) : ℝ) * Complex.I by
        push_cast; ring,
      Complex.norm_exp_ofReal_mul_I, one_mul, Real.rpow_neg (by positivity),
      ← div_eq_mul_inv, Real.rpow_natCast, le_div_iff₀ (by positivity)]
    have hy_le : ‖y‖ ≤ ‖euclidCons t y‖ := by
      have hsq := euclidCons_norm_sq t y
      nlinarith [norm_nonneg y, norm_nonneg (euclidCons t y), sq_nonneg t]
    have hpow_le : (1 + ‖y‖) ^ (n + 2) ≤ (1 + ‖euclidCons t y‖) ^ (n + 2) :=
      pow_le_pow_left₀ (by positivity) (by linarith) (n + 2)
    calc |f (euclidCons t y)| * (1 + ‖y‖) ^ (n + 2)
        = (1 + ‖y‖) ^ (n + 2) * ‖f (euclidCons t y)‖ := by rw [Real.norm_eq_abs, mul_comm]
      _ ≤ (1 + ‖euclidCons t y‖) ^ (n + 2) * ‖f (euclidCons t y)‖ :=
          mul_le_mul_of_nonneg_right hpow_le (norm_nonneg _)
      _ ≤ C := hC (euclidCons t y)
  · filter_upwards with y
    exact continuous_const.mul (Complex.continuous_ofReal.comp
      (f.continuous.comp ((timeSpatialCLE n).symm.continuous.comp
        (continuous_id.prodMk continuous_const))))

/-- Integrability of `t ↦ ‖spatialPhysicsFourier f t k‖` for fixed `k : SpatialE n`. -/
lemma integrable_norm_spatialPhysicsFourier {n : ℕ} (f : 𝓢(EuclidD n, ℝ)) (k : SpatialE n) :
    Integrable (fun t : ℝ => ‖spatialPhysicsFourier f t k‖) volume := by
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
  have hprod : Integrable (fun q : ℝ × SpatialE n => ‖f (euclidCons q.1 q.2)‖) volume :=
    ((measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable f.integrable).norm
  have hbound : Integrable (fun t : ℝ =>
      (2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) * ∫ y : SpatialE n, ‖f (euclidCons t y)‖) volume :=
    (hprod.integral_prod_left).const_mul _
  refine hbound.mono' (continuous_spatialPhysicsFourier f k).norm.aestronglyMeasurable ?_
  filter_upwards with t
  unfold spatialPhysicsFourier
  rw [physicsFourierExact_eq_integral, norm_norm, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.rpow_pos_of_pos h2pi_pos _)]
  gcongr
  refine (norm_integral_le_integral_norm _).trans_eq ?_
  refine integral_congr_ae (ae_of_all _ fun y => ?_)
  dsimp only
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    show -Complex.I * (inner ℝ y k : ℂ) = (-(inner ℝ y k) : ℝ) * Complex.I by
      push_cast; ring,
    Complex.norm_exp_ofReal_mul_I, one_mul]

/-- **Exact spatial Fourier transform of `poissonProj`:**
`physicsFourierExact (poissonProj n m hm f) k = ∫ t, exp(-|t| * ω_m(k)) * spatialPhysicsFourier f t k`. -/
theorem physicsFourier_poissonProj {n : ℕ} {m : ℝ} (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) (k : SpatialE n) :
    physicsFourierExact (poissonProj n m hm f) k =
      ∫ t : ℝ, (Real.exp (-|t| * euclidDispersion m k) : ℂ) * spatialPhysicsFourier f t k := by
  unfold physicsFourierExact
  rw [fourier_poissonProj_eq_marginal hm f ((2 * Real.pi)⁻¹ • k)]
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
  -- Change variable `p₀ = 2π τ`
  have hsub := Measure.integral_comp_mul_left
    (g := fun p₀ : ℝ =>
      (((2 * euclidDispersion m k * (p₀ ^ 2 + euclidDispersion m k ^ 2)⁻¹ : ℝ) : ℂ)) *
        (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) *
          𝓕 (fun x : EuclidD n => (f x : ℂ)) ((2 * Real.pi)⁻¹ • euclidCons p₀ k)))
    (2 * Real.pi)
  rw [abs_of_pos (inv_pos.mpr h2pi_pos)] at hsub
  have hL : ((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) *
      (∫ τ : ℝ, (poissonMult m (euclidCons τ ((2 * Real.pi)⁻¹ • k)) : ℂ) *
        𝓕 (fun x : EuclidD n => (f x : ℂ)) (euclidCons τ ((2 * Real.pi)⁻¹ • k))) =
      ((2 * Real.pi : ℝ)⁻¹ : ℂ) *
        ∫ p₀ : ℝ,
          (2 * (euclidDispersion m k : ℂ) / ((p₀ : ℂ) ^ 2 + (euclidDispersion m k : ℂ) ^ 2)) *
            (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) *
              𝓕 (fun x : EuclidD n => (f x : ℂ)) ((2 * Real.pi)⁻¹ • euclidCons p₀ k)) := by
    rw [← integral_const_mul]
    have hpt : ∀ τ : ℝ,
        ((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) *
          ((poissonMult m (euclidCons τ ((2 * Real.pi)⁻¹ • k)) : ℂ) *
            𝓕 (fun x : EuclidD n => (f x : ℂ)) (euclidCons τ ((2 * Real.pi)⁻¹ • k))) =
        (((2 * euclidDispersion m k * ((2 * Real.pi * τ) ^ 2 + euclidDispersion m k ^ 2)⁻¹ : ℝ) : ℂ)) *
          (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) *
            𝓕 (fun x : EuclidD n => (f x : ℂ)) ((2 * Real.pi)⁻¹ • euclidCons (2 * Real.pi * τ) k)) := by
      intro τ
      have harg : (2 * Real.pi)⁻¹ • euclidCons (2 * Real.pi * τ) k =
          euclidCons τ ((2 * Real.pi)⁻¹ • k) := by
        ext j
        refine Fin.cases ?_ ?_ j
        · change (2 * Real.pi)⁻¹ * (2 * Real.pi * τ) = τ
          rw [← mul_assoc, inv_mul_cancel₀ h2pi_pos.ne', one_mul]
        · intro i; rfl
      rw [harg]
      have hpm : poissonMult m (euclidCons τ ((2 * Real.pi)⁻¹ • k)) =
          2 * euclidDispersion m k * ((2 * Real.pi * τ) ^ 2 + euclidDispersion m k ^ 2)⁻¹ := by
        unfold poissonMult
        rw [spatialProj_euclidCons, smul_smul, mul_inv_cancel₀ h2pi_pos.ne', one_smul,
          euclidCons_norm_sq, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr h2pi_pos),
          mul_pow, euclidDispersion_sq]
        congr 1; congr 1
        field_simp [h2pi_pos.ne']; ring
      rw [hpm]; ring
    simp_rw [hpt]
    rw [hsub, Complex.real_smul, Complex.ofReal_inv]
    congr 1
    refine integral_congr_ae (ae_of_all _ fun p₀ => ?_)
    dsimp only
    rw [div_eq_mul_inv]
    push_cast; rfl
  rw [hL]
  -- Now express the integrand via `∫ t, exp(-i p₀ t) * spatialPhysicsFourier f t k` and apply Fubini!
  have hF_split : ∀ p₀ : ℝ,
      (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) : ℂ) *
          𝓕 (fun x : EuclidD n => (f x : ℂ)) ((2 * Real.pi)⁻¹ • euclidCons p₀ k) =
        ∫ t : ℝ, Complex.exp (-Complex.I * (p₀ : ℂ) * (t : ℂ)) * spatialPhysicsFourier f t k := by
    intro p₀
    have h1 := physicsFourierExact_eq_timeIntegral f (euclidCons p₀ k)
    unfold physicsFourierExact at h1
    have hpow : (2 * Real.pi) ^ (-((n + 2 : ℕ) : ℝ) / 2) =
        (2 * Real.pi) ^ (-(1 : ℝ) / 2) * (2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) := by
      rw [← Real.rpow_add h2pi_pos]; congr 1; push_cast; ring
    rw [hpow, Complex.ofReal_mul, mul_assoc] at h1
    have hne : (((2 * Real.pi) ^ (-(1 : ℝ) / 2) : ℝ) : ℂ) ≠ 0 := by
      exact_mod_cast (Real.rpow_pos_of_pos h2pi_pos _).ne'
    have h2 := mul_left_cancel₀ hne h1
    rw [h2]
    refine integral_congr_ae (ae_of_all _ fun t => ?_)
    dsimp only
    simp only [euclidCons_zero, spatialProj_euclidCons]
    congr 2; push_cast; ring
  simp_rw [hF_split]
  set ω : ℝ := euclidDispersion m k
  have hω : 0 < ω := euclidDispersion_pos hm k
  have hspatial_int : Integrable (fun t : ℝ => ‖spatialPhysicsFourier f t k‖) volume :=
    integrable_norm_spatialPhysicsFourier f k
  have hlor_int : Integrable (fun p₀ : ℝ => (2 * ω) / (p₀ ^ 2 + ω ^ 2)) volume := by
    have h1 : Integrable (fun u : ℝ => (1 + u ^ 2)⁻¹) volume := integrable_inv_one_add_sq
    have hsc : Integrable (fun p₀ : ℝ => (1 + (ω⁻¹ * p₀) ^ 2)⁻¹) volume :=
      h1.comp_mul_left' (inv_ne_zero hω.ne')
    have heq : (fun p₀ : ℝ => (2 * ω) / (p₀ ^ 2 + ω ^ 2)) =
        fun p₀ : ℝ => (2 / ω) * (1 + (ω⁻¹ * p₀) ^ 2)⁻¹ := by
      funext p₀; field_simp [hω.ne']; ring
    rw [heq]; exact hsc.const_mul _
  have hFub_int : Integrable (fun q : ℝ × ℝ =>
      (2 * (ω : ℂ) / ((q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2)) *
        (Complex.exp (-Complex.I * (q.1 : ℂ) * (q.2 : ℂ)) *
          spatialPhysicsFourier f q.2 k)) volume := by
    have hprod_bound : Integrable (fun q : ℝ × ℝ =>
        ((2 * ω) / (q.1 ^ 2 + ω ^ 2)) * ‖spatialPhysicsFourier f q.2 k‖) volume :=
      hlor_int.mul_prod hspatial_int
    refine hprod_bound.mono' ?_ ?_
    · refine ((continuous_const.div (by fun_prop) fun q : ℝ × ℝ => ?_).aestronglyMeasurable).mul ?_
      · have hpos : (0 : ℝ) < q.1 ^ 2 + ω ^ 2 := by positivity
        have hcast : ((q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((q.1 ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
          push_cast; ring
        change (q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2 ≠ 0
        rw [hcast]
        exact Complex.ofReal_ne_zero.mpr hpos.ne'
      · exact (Complex.continuous_exp.comp (by fun_prop)).aestronglyMeasurable.mul
          (continuous_spatialPhysicsFourier f k).aestronglyMeasurable.comp_snd
    · filter_upwards with q
      have hpos : (0 : ℝ) < q.1 ^ 2 + ω ^ 2 := by positivity
      have hcast : ((q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((q.1 ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
        push_cast; ring
      rw [norm_mul, norm_mul, norm_div, hcast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos,
        show (2 : ℂ) * (ω : ℂ) = ((2 * ω : ℝ) : ℂ) by push_cast; rfl,
        Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < 2 * ω),
        show -Complex.I * (q.1 : ℂ) * (q.2 : ℂ) = (-(q.1 * q.2) : ℝ) * Complex.I by
          push_cast; ring,
        Complex.norm_exp_ofReal_mul_I, one_mul]
  have hswap : (∫ p₀ : ℝ,
      (2 * (ω : ℂ) / ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) *
        ∫ t : ℝ, Complex.exp (-Complex.I * (p₀ : ℂ) * (t : ℂ)) * spatialPhysicsFourier f t k) =
      ∫ t : ℝ, (∫ p₀ : ℝ,
        (2 * (ω : ℂ) / ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) *
          Complex.exp (-Complex.I * (p₀ : ℂ) * (t : ℂ))) *
        spatialPhysicsFourier f t k := by
    have h1 : (∫ p₀ : ℝ,
        (2 * (ω : ℂ) / ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) *
          ∫ t : ℝ, Complex.exp (-Complex.I * (p₀ : ℂ) * (t : ℂ)) * spatialPhysicsFourier f t k) =
        ∫ p₀ : ℝ, ∫ t : ℝ,
          (2 * (ω : ℂ) / ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) *
            (Complex.exp (-Complex.I * (p₀ : ℂ) * (t : ℂ)) * spatialPhysicsFourier f t k) := by
      refine integral_congr_ae (ae_of_all _ fun p₀ => (integral_const_mul _ _).symm)
    rw [h1, MeasureTheory.integral_integral_swap hFub_int]
    refine integral_congr_ae (ae_of_all _ fun t => ?_)
    dsimp only
    rw [← integral_mul_const]
    refine integral_congr_ae (ae_of_all _ fun p₀ => by ring)
  rw [hswap, ← integral_const_mul]
  refine integral_congr_ae (ae_of_all _ fun t => ?_)
  dsimp only
  rw [← mul_assoc]
  congr 1
  have hlor := lorentzian_fourier_eq_expKernel1D hω (-t)
  have hre : (∫ p₀ : ℝ, (2 * (ω : ℂ) / ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2)) *
      Complex.exp (-Complex.I * (p₀ : ℂ) * (t : ℂ))) =
      2 * (ω : ℂ) * ∫ p₀ : ℝ, Complex.exp (Complex.I * (p₀ : ℂ) * ((-t : ℝ) : ℂ)) /
        ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2) := by
    rw [← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun p₀ => ?_)
    dsimp only
    rw [div_eq_mul_inv, div_eq_mul_inv]
    have hexp : -Complex.I * (p₀ : ℂ) * (t : ℂ) = Complex.I * (p₀ : ℂ) * ((-t : ℝ) : ℂ) := by
      push_cast; ring
    rw [hexp]; ring
  rw [hre, mul_left_comm, hlor]
  unfold expKernel1D
  rw [abs_neg, Complex.ofReal_div, Complex.ofReal_exp]
  have hωne : (ω : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hω.ne'
  push_cast
  field_simp [hωne]

/-- Exact `planeKernel (poissonProj f)` formula. -/
theorem planeKernel_poissonProj (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) (k : SpatialE n) :
    planeKernel n ħ m (poissonProj n m hm f) k =
      ((Real.sqrt ħ / Real.sqrt (2 * euclidDispersion m k) : ℝ) : ℂ) *
        ∫ t : ℝ, (Real.exp (-|t| * euclidDispersion m k) : ℂ) * spatialPhysicsFourier f t k := by
  unfold planeKernel planeMult
  rw [physicsFourier_poissonProj hm f k]

/-- Exact plane-projection quadratic form formula. -/
theorem planeKernel_poissonProj_norm_sq_integral (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) :
    (∫ k : SpatialE n, ‖planeKernel n ħ m (poissonProj n m hm f) k‖ ^ 2) =
      ħ * ∫ k : SpatialE n,
        ‖∫ t : ℝ, (Real.exp (-|t| * euclidDispersion m k) : ℂ) * spatialPhysicsFourier f t k‖ ^ 2 *
          (2 * euclidDispersion m k)⁻¹ := by
  rw [planeKernel_norm_sq_integral n hħ hm (poissonProj n m hm f)]
  congr 1
  refine integral_congr_ae (ae_of_all _ fun k => ?_)
  dsimp only
  rw [physicsFourier_poissonProj hm f k]

/-! ### Part 3: Upper Half-Space Dirichlet Kernel `dirichletPosKernel` (`K₊`) -/

/-- Smooth radial derivative decay of `(m² + ‖x‖²)^α`:
`‖iteratedFDeriv ℝ j (fun x => (m² + ‖x‖²)^α) p‖ ≤ C * (m² + ‖p‖²)^(α - j/2)`. -/
lemma norm_iteratedFDeriv_sq_add_norm_sq_rpow {d : ℕ} {m : ℝ} (hm : 0 < m) :
    ∀ (j : ℕ) (α : ℝ), ∃ C : ℝ, 0 < C ∧
      ∀ p : EuclideanSpace ℝ (Fin d),
        ‖iteratedFDeriv ℝ j (fun x : EuclideanSpace ℝ (Fin d) => (m ^ 2 + ‖x‖ ^ 2) ^ α) p‖ ≤
          C * (m ^ 2 + ‖p‖ ^ 2) ^ (α - (j : ℝ) / 2) := by
  intro j
  induction j using Nat.strong_induction_on with
  | h j ih =>
    intro α
    cases j with
    | zero =>
      refine ⟨1, one_pos, fun p => ?_⟩
      rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs,
        abs_of_pos (Real.rpow_pos_of_pos (by positivity : 0 < m ^ 2 + ‖p‖ ^ 2) α)]
      simp
    | succ k =>
      let f : EuclideanSpace ℝ (Fin d) → ℝ := fun x => (m ^ 2 + ‖x‖ ^ 2) ^ α
      let a : EuclideanSpace ℝ (Fin d) → ℝ := fun x => (m ^ 2 + ‖x‖ ^ 2) ^ (α - 1)
      let L : EuclideanSpace ℝ (Fin d) →L[ℝ] (EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ) :=
        (2 * α) • (innerSL ℝ (E := EuclideanSpace ℝ (Fin d)))
      have hfderiv : fderiv ℝ f = fun x => a x • L x := by
        funext x
        have hsq : HasFDerivAt (fun y : EuclideanSpace ℝ (Fin d) => m ^ 2 + ‖y‖ ^ 2)
            ((2 : ℝ) • (innerSL ℝ (E := EuclideanSpace ℝ (Fin d))) x) x := by
          have hnorm : HasFDerivAt (fun y : EuclideanSpace ℝ (Fin d) => ‖y‖ ^ 2)
              ((2 : ℝ) • (innerSL ℝ (E := EuclideanSpace ℝ (Fin d))) x) x := by
            have hin := (hasFDerivAt_id x).inner ℝ (hasFDerivAt_id x)
            convert hin using 1
            · funext y; exact (real_inner_self_eq_norm_sq y).symm
            · ext v; simp [two_smul, real_inner_comm]
          convert (hasFDerivAt_const (m ^ 2) x).add hnorm using 1
          rw [zero_add]
        have hrpow : HasDerivAt (fun t : ℝ => t ^ α) (α * (m ^ 2 + ‖x‖ ^ 2) ^ (α - 1))
            (m ^ 2 + ‖x‖ ^ 2) :=
          Real.hasDerivAt_rpow_const (Or.inl (by positivity : (m ^ 2 + ‖x‖ ^ 2) ≠ 0))
        have hcomp := hrpow.comp_hasFDerivAt x hsq
        change fderiv ℝ ((fun t : ℝ => t ^ α) ∘ (fun y : EuclideanSpace ℝ (Fin d) => m ^ 2 + ‖y‖ ^ 2)) x =
          a x • L x
        rw [hcomp.fderiv]
        ext v
        simp [a, L, innerSL_apply_apply ℝ]
        ring
      have ha_smooth : ContDiff ℝ (⊤ : ℕ∞) a :=
        (hasTemperateGrowth_sq_add_norm_sq_rpow hm (α - 1)).1
      have hL_smooth : ContDiff ℝ (⊤ : ℕ∞) (fun x => L x) := L.contDiff
      obtain ⟨Ck, hCk_pos, hCk⟩ := ih k (Nat.lt_succ_self k) (α - 1)
      have hCprev : ∃ C1 : ℝ, 0 < C1 ∧
          (∀ p : EuclideanSpace ℝ (Fin d), k ≠ 0 →
            ‖iteratedFDeriv ℝ (k - 1) a p‖ ≤
              C1 * (m ^ 2 + ‖p‖ ^ 2) ^ ((α - 1) - ((k - 1 : ℕ) : ℝ) / 2)) := by
        cases k with
        | zero => exact ⟨1, one_pos, fun _ h => (h rfl).elim⟩
        | succ k' =>
          obtain ⟨C', hC'_pos, hC'⟩ := ih k' (by omega) (α - 1)
          exact ⟨C', hC'_pos, fun p _ => by simpa using hC' p⟩
      obtain ⟨C1, hC1_pos, hC1⟩ := hCprev
      let C : ℝ := (Ck + (k : ℝ) * C1) * (‖L‖ + 1)
      have hC_pos : 0 < C := by positivity
      refine ⟨C, hC_pos, fun p => ?_⟩
      have hpos : 0 < m ^ 2 + ‖p‖ ^ 2 := by positivity
      have hstep : ‖iteratedFDeriv ℝ (k + 1) f p‖ = ‖iteratedFDeriv ℝ k (fun x => a x • L x) p‖ := by
        rw [← norm_iteratedFDeriv_fderiv, hfderiv]
      rw [hstep]
      have hbilin := ContinuousLinearMap.norm_iteratedFDeriv_le_of_bilinear_of_le_one
        (ContinuousLinearMap.lsmul ℝ ℝ (E := EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ))
        ha_smooth hL_smooth p (n := k) (mod_cast le_top)
        (ContinuousLinearMap.opNorm_lsmul_le (𝕜 := ℝ) (E := EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ))
      refine hbilin.trans ?_
      have hterm : ∀ i ∈ Finset.range (k + 1),
          (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i a p‖ * ‖iteratedFDeriv ℝ (k - i) L p‖ ≤
            (if i = k then Ck * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2)
             else if i + 1 = k then (k : ℝ) * C1 * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2)
             else 0) := by
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        by_cases h0 : i = k
        · subst h0
          simp only [↓reduceIte, Nat.choose_self, Nat.cast_one, one_mul]
          rw [Nat.sub_self, norm_iteratedFDeriv_zero]
          have hLp : ‖L p‖ ≤ (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (1 / 2 : ℝ) := by
            have h1 : ‖L p‖ ≤ ‖L‖ * ‖p‖ := L.le_opNorm p
            have h2 : ‖p‖ ≤ (m ^ 2 + ‖p‖ ^ 2) ^ (1 / 2 : ℝ) := by
              rw [← Real.sqrt_eq_rpow]
              exact (Real.sqrt_sq (norm_nonneg p)).symm.le.trans
                (Real.sqrt_le_sqrt (le_add_of_nonneg_left (sq_nonneg m)))
            calc ‖L p‖ ≤ ‖L‖ * ‖p‖ := h1
              _ ≤ ‖L‖ * (m ^ 2 + ‖p‖ ^ 2) ^ (1 / 2 : ℝ) :=
                  mul_le_mul_of_nonneg_left h2 (norm_nonneg L)
              _ ≤ (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (1 / 2 : ℝ) := by
                  gcongr; linarith
          calc ‖iteratedFDeriv ℝ i a p‖ * ‖L p‖
              ≤ (Ck * (m ^ 2 + ‖p‖ ^ 2) ^ (α - 1 - (i : ℝ) / 2)) *
                  ((‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (1 / 2 : ℝ)) :=
                mul_le_mul (hCk p) hLp (norm_nonneg _) (by positivity)
            _ = Ck * (‖L‖ + 1) *
                  ((m ^ 2 + ‖p‖ ^ 2) ^ (α - 1 - (i : ℝ) / 2) * (m ^ 2 + ‖p‖ ^ 2) ^ (1 / 2 : ℝ)) := by ring
            _ = Ck * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((i + 1 : ℕ) : ℝ) / 2) := by
                rw [← Real.rpow_add hpos]; congr 2; push_cast; ring
        · by_cases h1 : i + 1 = k
          · simp only [h0, ↓reduceIte, h1]
            have hk_ne : k ≠ 0 := by omega
            have hi_eq : i = k - 1 := by omega
            have hsub1 : k - i = 1 := by omega
            have hchoose : (k.choose i : ℝ) = (k : ℝ) := by
              have hnat : k.choose i = k := by
                rw [hi_eq, Nat.choose_symm_of_eq_add (by omega : k = (k - 1) + 1),
                  Nat.choose_one_right]
              exact_mod_cast hnat
            rw [hsub1, hchoose]
            have hD1 : ‖iteratedFDeriv ℝ 1 L p‖ ≤ ‖L‖ + 1 := by
              rw [norm_iteratedFDeriv_one, L.fderiv]
              linarith
            have ha_bd := hC1 p hk_ne
            rw [← hi_eq] at ha_bd
            have hexp : (α - 1) - (i : ℝ) / 2 = α - ((k + 1 : ℕ) : ℝ) / 2 := by
              have : (k : ℝ) = (i : ℝ) + 1 := by exact_mod_cast h1.symm
              push_cast; linarith
            rw [hexp] at ha_bd
            calc (k : ℝ) * ‖iteratedFDeriv ℝ i a p‖ * ‖iteratedFDeriv ℝ 1 L p‖
                ≤ (k : ℝ) * (C1 * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2)) * (‖L‖ + 1) := by
                  gcongr
              _ = (k : ℝ) * C1 * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2) := by ring
          · simp only [h0, h1, ↓reduceIte]
            have hge2 : 2 ≤ k - i := by omega
            obtain ⟨r, hr⟩ : ∃ r, k - i = r + 2 := ⟨k - i - 2, by omega⟩
            have hzero : ‖iteratedFDeriv ℝ (k - i) L p‖ = 0 := by
              rw [hr, ← norm_iteratedFDeriv_fderiv]
              have hfd : fderiv ℝ (fun x => L x) = fun _ => L := by
                funext x; exact L.fderiv
              rw [hfd, iteratedFDeriv_succ_const]
              simp
            rw [hzero, mul_zero]
      have hsum_le := Finset.sum_le_sum hterm
      refine hsum_le.trans ?_
      have hsum_eval : (∑ i ∈ Finset.range (k + 1),
          (if i = k then Ck * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2)
           else if i + 1 = k then (k : ℝ) * C1 * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2)
           else 0)) ≤ C * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2) := by
        rw [Finset.sum_range_succ]
        simp only [↓reduceIte]
        have hrest : (∑ i ∈ Finset.range k,
            (if i = k then Ck * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2)
             else if i + 1 = k then (k : ℝ) * C1 * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2)
             else 0)) ≤ (k : ℝ) * C1 * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k + 1 : ℕ) : ℝ) / 2) := by
          cases k with
          | zero => simp
          | succ k' =>
            rw [Finset.sum_range_succ]
            have h0 : ∑ x ∈ Finset.range k',
                (if x = k' + 1 then Ck * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k' + 1 + 1 : ℕ) : ℝ) / 2)
                 else if x + 1 = k' + 1 then ((k' + 1 : ℕ) : ℝ) * C1 * (‖L‖ + 1) * (m ^ 2 + ‖p‖ ^ 2) ^ (α - ((k' + 1 + 1 : ℕ) : ℝ) / 2)
                 else 0) = 0 := by
              refine Finset.sum_eq_zero fun x hx => ?_
              have hlt : x < k' := Finset.mem_range.mp hx
              simp only [show x ≠ k' + 1 by omega, show x + 1 ≠ k' + 1 by omega, ↓reduceIte]
            rw [h0, zero_add]
            simp
        linarith
      exact hsum_eval

/-- Spectral weight of the upper half-space Dirichlet kernel:
`dirichletWeight ħ m p = √(ħ / π) * (m² + ‖p‖²)^(-1/2)` (in `ℂ`). -/
noncomputable def dirichletWeight {n : ℕ} (ħ m : ℝ) (p : EuclidD n) : ℂ :=
  ((Real.sqrt (ħ / Real.pi) * (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)

lemma dirichletWeight_contDiff {n : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m) :
    ContDiff ℝ (⊤ : ℕ∞) (dirichletWeight (n := n) ħ m) := by
  unfold dirichletWeight
  have h1 : ContDiff ℝ (⊤ : ℕ∞) (fun p : EuclidD n =>
      Real.sqrt (ħ / Real.pi) * (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 : ℝ)) :=
    contDiff_const.mul (hasTemperateGrowth_sq_add_norm_sq_rpow hm (-1 / 2)).1
  exact Complex.ofRealCLM.contDiff.comp h1

/-- Uniform `(1 + |p 0|)⁻¹` decay for EVERY derivative order `j` of `dirichletWeight ħ m`. -/
lemma norm_iteratedFDeriv_dirichletWeight {n : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m) (j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ p : EuclidD n,
      ‖iteratedFDeriv ℝ j (dirichletWeight ħ m) p‖ ≤ C * (1 + |p 0|)⁻¹ := by
  obtain ⟨C₀, hC₀, hbd⟩ := norm_iteratedFDeriv_sq_add_norm_sq_rpow (d := n + 2) hm j (-1 / 2)
  let c : ℝ := Real.sqrt (ħ / Real.pi)
  let K : ℝ := (|c| + 1) * C₀ * (m ^ 2) ^ (-(j : ℝ) / 2) * Real.sqrt (2 * max 1 (m⁻¹ ^ 2))
  have hK : 0 < K := by positivity
  refine ⟨K, hK, fun p => ?_⟩
  have hpos : 0 < m ^ 2 + ‖p‖ ^ 2 := by positivity
  have hcomp : dirichletWeight ħ m =
      (fun r : ℝ => ((c * r : ℝ) : ℂ)) ∘ (fun p : EuclidD n => (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 : ℝ)) := rfl
  let Lc : ℝ →L[ℝ] ℂ := Complex.ofRealCLM.comp (ContinuousLinearMap.smulRight (ContinuousLinearMap.id ℝ ℝ) c)
  have hLc_eq : dirichletWeight ħ m = Lc ∘ (fun p : EuclidD n => (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 : ℝ)) := by
    funext x; simp [dirichletWeight, Lc, c, mul_comm]
  have hLc_norm : ‖Lc‖ ≤ |c| + 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun r => ?_
    simp only [Lc, ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.id_apply, smul_eq_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_mul]
    nlinarith [abs_nonneg r, abs_nonneg c]
  rw [hLc_eq, Lc.iteratedFDeriv_comp_left
    ((hasTemperateGrowth_sq_add_norm_sq_rpow hm (-1 / 2)).1.contDiffAt) (mod_cast le_top)]
  have hnorm1 : ‖Lc.compContinuousMultilinearMap
      (iteratedFDeriv ℝ j (fun x : EuclidD n => (m ^ 2 + ‖x‖ ^ 2) ^ (-1 / 2 : ℝ)) p)‖ ≤
      ‖Lc‖ * ‖iteratedFDeriv ℝ j (fun x : EuclidD n => (m ^ 2 + ‖x‖ ^ 2) ^ (-1 / 2 : ℝ)) p‖ :=
    Lc.norm_compContinuousMultilinearMap_le _
  have hpow_split : (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 - (j : ℝ) / 2) =
      (m ^ 2 + ‖p‖ ^ 2) ^ (-(j : ℝ) / 2) * (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 : ℝ) := by
    rw [← Real.rpow_add hpos]; congr 1; ring
  have hmj : (m ^ 2 + ‖p‖ ^ 2) ^ (-(j : ℝ) / 2) ≤ (m ^ 2) ^ (-(j : ℝ) / 2) := by
    rw [show -(j : ℝ) / 2 = -((j : ℝ) / 2) by ring, Real.rpow_neg hpos.le, Real.rpow_neg (by positivity)]
    exact inv_anti₀ (by positivity)
      (Real.rpow_le_rpow (by positivity) (le_add_of_nonneg_right (sq_nonneg _)) (by positivity))
  have hp0_bound : (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 : ℝ) ≤
      Real.sqrt (2 * max 1 (m⁻¹ ^ 2)) * (1 + |p 0|)⁻¹ := by
    rw [show (-1 / 2 : ℝ) = -(1 / 2 : ℝ) by ring, Real.rpow_neg hpos.le, ← Real.sqrt_eq_rpow]
    rw [← div_eq_mul_inv, inv_le_iff_one_le_mul₀ (Real.sqrt_pos.mpr hpos)]
    rw [div_mul_eq_mul_div, one_le_div (by positivity : 0 < 1 + |p 0|)]
    have hsq1 : (1 + |p 0|) ^ 2 ≤ (Real.sqrt (2 * max 1 (m⁻¹ ^ 2)) * Real.sqrt (m ^ 2 + ‖p‖ ^ 2)) ^ 2 := by
      rw [mul_pow, Real.sq_sqrt (by positivity), Real.sq_sqrt hpos.le]
      have hp0_le : (p 0) ^ 2 ≤ ‖p‖ ^ 2 := by
        rw [euclid_norm_sq_eq]; linarith [sq_nonneg ‖spatialProj p‖]
      have hmax1 : (1 : ℝ) ≤ max 1 (m⁻¹ ^ 2) := le_max_left _ _
      have hmax2 : m⁻¹ ^ 2 ≤ max 1 (m⁻¹ ^ 2) := le_max_right _ _
      have hm2 : 1 ≤ m ^ 2 * max 1 (m⁻¹ ^ 2) := by
        calc (1 : ℝ) = m ^ 2 * m⁻¹ ^ 2 := by field_simp [hm.ne']
          _ ≤ m ^ 2 * max 1 (m⁻¹ ^ 2) := mul_le_mul_of_nonneg_left hmax2 (sq_nonneg m)
      have hp2 : (p 0) ^ 2 ≤ ‖p‖ ^ 2 * max 1 (m⁻¹ ^ 2) := by
        nlinarith [sq_nonneg ‖p‖]
      nlinarith [sq_abs (p 0), sq_nonneg (1 - |p 0|)]
    have hnn : 0 ≤ Real.sqrt (2 * max 1 (m⁻¹ ^ 2)) * Real.sqrt (m ^ 2 + ‖p‖ ^ 2) := by positivity
    nlinarith [hsq1, hnn, abs_nonneg (p 0)]
  calc ‖Lc.compContinuousMultilinearMap
          (iteratedFDeriv ℝ j (fun x : EuclidD n => (m ^ 2 + ‖x‖ ^ 2) ^ (-1 / 2 : ℝ)) p)‖
      ≤ ‖Lc‖ * ‖iteratedFDeriv ℝ j (fun x : EuclidD n => (m ^ 2 + ‖x‖ ^ 2) ^ (-1 / 2 : ℝ)) p‖ := hnorm1
    _ ≤ (|c| + 1) * (C₀ * (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 - (j : ℝ) / 2)) :=
        mul_le_mul hLc_norm (hbd p) (norm_nonneg _) (by positivity)
    _ = (|c| + 1) * C₀ * ((m ^ 2 + ‖p‖ ^ 2) ^ (-(j : ℝ) / 2) * (m ^ 2 + ‖p‖ ^ 2) ^ (-1 / 2 : ℝ)) := by
        rw [hpow_split]; ring
    _ ≤ (|c| + 1) * C₀ * ((m ^ 2) ^ (-(j : ℝ) / 2) * (Real.sqrt (2 * max 1 (m⁻¹ ^ 2)) * (1 + |p 0|)⁻¹)) := by
        gcongr
    _ = K * (1 + |p 0|)⁻¹ := by dsimp [K]; ring

/-- Open upper half-space `{x ∈ ℝ^{n+2} | x 0 > 0}`. -/
def halfSpaceSet (n : ℕ) : Set (EuclidD n) := {x : EuclidD n | 0 < x 0}

lemma isOpen_halfSpaceSet (n : ℕ) : IsOpen (halfSpaceSet n) :=
  isOpen_lt continuous_const (PiLp.continuous_apply 2 _ 0)

lemma measurableSet_halfSpaceSet (n : ℕ) : MeasurableSet (halfSpaceSet n) :=
  (isOpen_halfSpaceSet n).measurableSet

/-- Vector-valued upper half-space Fourier integral for any Banach-space Schwartz map `F : 𝓢(EuclidD n, E)`. -/
noncomputable def halfSpaceFourierVec {n : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (F : 𝓢(EuclidD n, E)) (p : EuclidD n) : E :=
  ∫ x in halfSpaceSet n, Complex.exp (-Complex.I * (inner ℝ p x : ℂ)) • F x

lemma halfSpaceFourierVec_eq_prod {n : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (F : 𝓢(EuclidD n, E)) (p : EuclidD n) :
    halfSpaceFourierVec F p =
      ∫ t in Ioi (0 : ℝ), ∫ y : SpatialE n,
        Complex.exp (-Complex.I * (inner ℝ p (euclidCons t y) : ℂ)) • F (euclidCons t y) := by
  unfold halfSpaceFourierVec
  rw [← MeasureTheory.integral_indicator (measurableSet_halfSpaceSet n), integral_euclid_eq_prod]
  have hint : Integrable (fun q : ℝ × SpatialE n =>
      (halfSpaceSet n).indicator
        (fun x : EuclidD n => Complex.exp (-Complex.I * (inner ℝ p x : ℂ)) • F x)
        (euclidCons q.1 q.2)) volume := by
    have hcomp : Integrable (fun x : EuclidD n =>
        (halfSpaceSet n).indicator
          (fun x : EuclidD n => Complex.exp (-Complex.I * (inner ℝ p x : ℂ)) • F x) x) volume := by
      refine (F.integrable (μ := volume)).norm.mono' ?_ ?_
      · refine (((Complex.continuous_exp.comp (continuous_const.mul
            (Complex.continuous_ofReal.comp (continuous_const.inner continuous_id)))).smul
            F.continuous).aestronglyMeasurable).indicator (measurableSet_halfSpaceSet n)
      · filter_upwards with x
        by_cases hx : x ∈ halfSpaceSet n
        · simp only [Set.indicator_of_mem hx, norm_smul,
            show -Complex.I * (inner ℝ p x : ℂ) = (-(inner ℝ p x) : ℝ) * Complex.I by
              push_cast; ring,
            Complex.norm_exp_ofReal_mul_I, one_mul, le_refl]
        · simp [Set.indicator_of_notMem hx]
    exact (measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable hcomp
  have hprod : (∫ q : ℝ × SpatialE n,
      (halfSpaceSet n).indicator
        (fun x : EuclidD n => Complex.exp (-Complex.I * (inner ℝ p x : ℂ)) • F x)
        (euclidCons q.1 q.2)) =
      ∫ t : ℝ, ∫ y : SpatialE n,
        (halfSpaceSet n).indicator
          (fun x : EuclidD n => Complex.exp (-Complex.I * (inner ℝ p x : ℂ)) • F x)
          (euclidCons t y) := by
    simpa [Measure.volume_eq_prod] using MeasureTheory.integral_prod _ hint
  rw [hprod, ← MeasureTheory.integral_indicator measurableSet_Ioi]
  refine integral_congr_ae (ae_of_all _ fun t => ?_)
  dsimp only
  by_cases ht : 0 < t
  · rw [Set.indicator_of_mem (show t ∈ Ioi (0 : ℝ) from ht)]
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    dsimp only
    rw [Set.indicator_of_mem (show euclidCons t y ∈ halfSpaceSet n from ht)]
  · rw [Set.indicator_of_notMem (show t ∉ Ioi (0 : ℝ) from ht)]
    refine integral_eq_zero_of_ae (ae_of_all _ fun y => ?_)
    exact Set.indicator_of_notMem (show euclidCons t y ∉ halfSpaceSet n from ht) _

lemma continuous_halfSpaceFourierVec {n : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (F : 𝓢(EuclidD n, E)) : Continuous (halfSpaceFourierVec F) := by
  unfold halfSpaceFourierVec
  refine continuous_of_dominated (bound := fun x => ‖F x‖) ?_ ?_
    ((F.integrable (μ := volume)).norm.integrableOn) ?_
  · intro p
    exact ((Complex.continuous_exp.comp (continuous_const.mul
      (Complex.continuous_ofReal.comp (continuous_const.inner continuous_id)))).smul
      F.continuous).aestronglyMeasurable
  · intro p
    filter_upwards with x
    rw [norm_smul,
      show -Complex.I * (inner ℝ p x : ℂ) = (-(inner ℝ p x) : ℝ) * Complex.I by
        push_cast; ring,
      Complex.norm_exp_ofReal_mul_I, one_mul]
  · filter_upwards with x
    exact (Complex.continuous_exp.comp (continuous_const.mul
      (Complex.continuous_ofReal.comp (continuous_id.inner continuous_const)))).smul continuous_const

/-- Exact Fréchet derivative of `halfSpaceFourierVec F` in terms of `SchwartzMap.smulRightCLM`. -/
lemma hasFDerivAt_halfSpaceFourierVec {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (F : 𝓢(EuclidD n, E)) (p : EuclidD n) :
    HasFDerivAt (halfSpaceFourierVec F)
      (halfSpaceFourierVec ((-Complex.I) • SchwartzMap.smulRightCLM ℂ E (innerSL ℝ) F) p) p := by
  let G : 𝓢(EuclidD n, EuclidD n →L[ℝ] E) :=
    (-Complex.I) • SchwartzMap.smulRightCLM ℂ E (innerSL ℝ) F
  let φ : EuclidD n → EuclidD n → E :=
    fun q x => Complex.exp (-Complex.I * (inner ℝ q x : ℂ)) • F x
  let φ' : EuclidD n → EuclidD n → (EuclidD n →L[ℝ] E) :=
    fun q x => Complex.exp (-Complex.I * (inner ℝ q x : ℂ)) • G x
  have hbound_int : Integrable (fun x : EuclidD n => ‖x‖ * ‖F x‖)
      (volume.restrict (halfSpaceSet n)) := by
    have h1 : Integrable (fun x : EuclidD n => ‖x‖ * ‖F x‖) volume := by
      simpa [pow_one] using F.integrable_pow_mul volume 1
    exact h1.integrableOn
  have hderiv : ∀ x : EuclidD n, ∀ q : EuclidD n, HasFDerivAt (fun q' => φ q' x) (φ' q x) q := by
    intro x q
    have hlin : HasFDerivAt (fun q' : EuclidD n => inner ℝ q' x) (innerSL ℝ x) q := by
      have heq : (fun q' : EuclidD n => inner ℝ q' x) = fun q' => innerSL ℝ x q' := by
        funext q'; simp [real_inner_comm]
      rw [heq]; exact (innerSL ℝ x).hasFDerivAt
    have hmulC : HasFDerivAt (fun q' : EuclidD n => -Complex.I * (inner ℝ q' x : ℂ))
        (((-Complex.I) • Complex.ofRealCLM).comp (innerSL ℝ x)) q := by
      have h1 := (Complex.ofRealCLM.hasFDerivAt.comp q hlin).const_smul (-Complex.I)
      convert h1 using 1
      · funext q'; simp [smul_eq_mul]
      · ext v; simp
    have hexp : HasFDerivAt (fun q' : EuclidD n => Complex.exp (-Complex.I * (inner ℝ q' x : ℂ)))
        ((Complex.exp (-Complex.I * (inner ℝ q x : ℂ)) •
          (((-Complex.I) • Complex.ofRealCLM).comp (innerSL ℝ x)))) q := by
      have hce := ((Complex.hasDerivAt_exp (-Complex.I * (inner ℝ q x : ℂ))).hasFDerivAt.restrictScalars ℝ).comp q hmulC
      have hderiv_eq : (ContinuousLinearMap.restrictScalars ℝ
            (ContinuousLinearMap.toSpanSingleton ℂ (Complex.exp (-Complex.I * (inner ℝ q x : ℂ))))).comp
            (((-Complex.I) • Complex.ofRealCLM).comp (innerSL ℝ x)) =
          Complex.exp (-Complex.I * (inner ℝ q x : ℂ)) •
            (((-Complex.I) • Complex.ofRealCLM).comp (innerSL ℝ x)) := by
        ext v
        simp [ContinuousLinearMap.comp_apply, smul_eq_mul, mul_comm]
      rw [hderiv_eq] at hce
      exact hce
    have hsm : HasFDerivAt (fun q' : EuclidD n => φ q' x)
        (((Complex.exp (-Complex.I * (inner ℝ q x : ℂ)) •
          (((-Complex.I) • Complex.ofRealCLM).comp (innerSL ℝ x))).smulRight (F x))) q := by
      exact hexp.smul_const (F x)
    convert hsm using 1
    ext v
    simp only [φ', G, ContinuousLinearMap.smulRight_apply, real_inner_comm]
    change Complex.exp (-Complex.I * (inner ℝ x q : ℂ)) •
        ((-Complex.I) • ((inner ℝ x v : ℝ) • F x)) =
      (Complex.exp (-Complex.I * (inner ℝ x q : ℂ)) * (-Complex.I * (inner ℝ x v : ℂ))) • F x
    rw [smul_comm (-Complex.I) (inner ℝ x v), ← Complex.coe_smul (inner ℝ x v),
      smul_smul, smul_smul]
    congr 1; ring
  exact hasFDerivAt_integral_of_dominated_of_fderiv_le
    (F := φ) (F' := φ') (μ := volume.restrict (halfSpaceSet n))
    (s := Set.univ) Filter.univ_mem
    (Filter.Eventually.of_forall fun q =>
      ((Complex.continuous_exp.comp (continuous_const.mul
        (Complex.continuous_ofReal.comp (continuous_const.inner continuous_id)))).smul
        F.continuous).aestronglyMeasurable)
    (((F.integrable (μ := volume)).norm.integrableOn).mono'
      ((Complex.continuous_exp.comp (continuous_const.mul
        (Complex.continuous_ofReal.comp (continuous_const.inner continuous_id)))).smul
        F.continuous).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by
        rw [norm_smul,
          show -Complex.I * (inner ℝ p x : ℂ) = (-(inner ℝ p x) : ℝ) * Complex.I by
            push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul]))
    (((Complex.continuous_exp.comp (continuous_const.mul
      (Complex.continuous_ofReal.comp (continuous_const.inner continuous_id)))).smul
      G.continuous).aestronglyMeasurable)
    (Filter.Eventually.of_forall fun x q _ => by
      rw [norm_smul,
        show -Complex.I * (inner ℝ q x : ℂ) = (-(inner ℝ q x) : ℝ) * Complex.I by
          push_cast; ring,
        Complex.norm_exp_ofReal_mul_I, one_mul]
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun v => ?_
      simp only [G, FunLike.coe_smul, Pi.smul_apply, SchwartzMap.smulRightCLM_apply_apply,
        ContinuousLinearMap.smulRight_apply]
      change ‖(-Complex.I) • ((inner ℝ x v : ℝ) • F x)‖ ≤ ‖x‖ * ‖F x‖ * ‖v‖
      rw [norm_smul, norm_neg, Complex.norm_I, one_mul, norm_smul, Real.norm_eq_abs]
      calc |inner ℝ x v| * ‖F x‖
          ≤ (‖x‖ * ‖v‖) * ‖F x‖ := mul_le_mul_of_nonneg_right (abs_real_inner_le_norm x v) (norm_nonneg _)
        _ = ‖x‖ * ‖F x‖ * ‖v‖ := by ring)
    hbound_int
    (Filter.Eventually.of_forall fun x q _ => hderiv x q)

/-- Smoothness (`ContDiff ℝ r`) of `halfSpaceFourierVec F` for every `r : ℕ`. -/
lemma contDiff_halfSpaceFourierVec_nat {n : ℕ} :
    ∀ (r : ℕ) {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
      (F : 𝓢(EuclidD n, E)), ContDiff ℝ r (halfSpaceFourierVec F) := by
  intro r
  induction r with
  | zero =>
    intro E _ _ _ F
    exact contDiff_zero.mpr (continuous_halfSpaceFourierVec F)
  | succ r ih =>
    intro E _ _ _ F
    rw [Nat.cast_add, Nat.cast_one, contDiff_succ_iff_fderiv]
    refine ⟨fun p => (hasFDerivAt_halfSpaceFourierVec F p).differentiableAt, by simp, ?_⟩
    have hfd : fderiv ℝ (halfSpaceFourierVec F) =
        halfSpaceFourierVec ((-Complex.I) • SchwartzMap.smulRightCLM ℂ E (innerSL ℝ) F) := by
      funext p; exact (hasFDerivAt_halfSpaceFourierVec F p).fderiv
    rw [hfd]
    exact ih _

/-- Smoothness (`ContDiff ℝ ⊤`) of `halfSpaceFourierVec F` for every Banach-space Schwartz map `F`. -/
lemma contDiff_halfSpaceFourierVec {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (F : 𝓢(EuclidD n, E)) : ContDiff ℝ (⊤ : ℕ∞) (halfSpaceFourierVec F) :=
  contDiff_infty.mpr fun r => contDiff_halfSpaceFourierVec_nat r F

/-- Time integration by parts for `halfSpaceFourierVec F`:
`(i p₀) • H_+(F)(p) = ∫_y e^{-i k·y} F(0, y) dy + H_+(∂_{e₀} F)(p)`. -/
lemma halfSpaceFourierVec_time_ibp {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (F : 𝓢(EuclidD n, E)) (p : EuclidD n) :
    (Complex.I * (p 0 : ℂ)) • halfSpaceFourierVec F p =
      (∫ y : SpatialE n, Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) • F (euclidCons 0 y)) +
        halfSpaceFourierVec (LineDeriv.lineDerivOp (EuclideanSpace.single (0 : Fin (n + 2)) (1 : ℝ)) F) p := by
  let e₀ : EuclidD n := EuclideanSpace.single (0 : Fin (n + 2)) (1 : ℝ)
  let dF : 𝓢(EuclidD n, E) := LineDeriv.lineDerivOp e₀ F
  -- First prove the 1D IBP identity for each fixed `y : SpatialE n`
  have h1D (y : SpatialE n) :
      (Complex.I * (p 0 : ℂ)) •
          (∫ t in Ioi (0 : ℝ), Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ)) • F (euclidCons t y)) =
        F (euclidCons 0 y) +
          ∫ t in Ioi (0 : ℝ), Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ)) • dF (euclidCons t y) := by
    let φ : ℝ → E := fun t => Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ)) • F (euclidCons t y)
    let φ' : ℝ → E := fun t =>
      ((-Complex.I * (p 0 : ℂ)) * Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ))) • F (euclidCons t y) +
        Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ)) • dF (euclidCons t y)
    have hderiv : ∀ t : ℝ, HasDerivAt φ (φ' t) t := by
      intro t
      have h1 : HasDerivAt (fun s : ℝ => Complex.exp (-Complex.I * ((p 0 * s : ℝ) : ℂ)))
