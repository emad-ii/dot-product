      let dFy : 𝓢(ℝ, E) := SchwartzMap.compCLMOfAntilipschitz ℂ (K := 1)
        (g := fun t : ℝ => euclidCons t y)
        (by
          have heq : (fun t : ℝ => euclidCons t y) = fun t => t • e₀ + euclidCons 0 y := by
            funext t; ext j
