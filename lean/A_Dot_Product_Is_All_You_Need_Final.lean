/-! ## General reflected Markov laws and time evolution (§4, TeX 361) -/

/-! ### Eventwise conditional independence and the reflected pairing -/

namespace DotProduct.GeneralReflection

open MeasureTheory ProbabilityTheory Set Filter
open scoped MeasureTheory ENNReal InnerProductSpace

variable {Ω : Type*} {plane neg pos : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- Conditional independence expressed on events. This definition works on an arbitrary
probability space, even when a regular conditional probability on the sample space is unavailable. -/
def ObservedCondIndep (μ : Measure Ω) (plane neg pos : MeasurableSpace Ω) : Prop :=
  ∀ s t, MeasurableSet[neg] s → MeasurableSet[pos] t →
    μ⟦s ∩ t | plane⟧ =ᵐ[μ] μ⟦s | plane⟧ * μ⟦t | plane⟧

theorem observedCondIndep_iff [StandardBorelSpace Ω]
    (h0 : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : pos ≤ mΩ) :
    ObservedCondIndep μ plane neg pos ↔ CondIndep plane neg pos h0 μ :=
  (condIndep_iff plane neg pos h0 hn hp μ).symm

private theorem event_integral_factor (h0 : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : pos ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg pos) {s t : Set Ω}
    (hs : MeasurableSet[neg] s) (ht : MeasurableSet[pos] t) :
    (∫ ω, ((μ⟦s | plane⟧) ω) * ((μ⟦t | plane⟧) ω) ∂μ) = μ.real (s ∩ t) := by
  change (∫ ω, (μ⟦s | plane⟧ * μ⟦t | plane⟧) ω ∂μ) = _
  rw [← integral_congr_ae (hind s t hs ht), integral_condExp h0,
    integral_indicator ((hn _ hs).inter (hp _ ht)), setIntegral_const, smul_eq_mul, mul_one]

variable {𝕜 : Type*} [RCLike 𝕜]

private theorem projected_indicator (h0 : plane ≤ mΩ) {s : Set Ω} (hs : MeasurableSet s)
    (a : 𝕜) : condExpL2 𝕜 𝕜 h0 (indicatorConstLp 2 hs (measure_ne_top μ s) a)
      =ᵐ[μ] fun ω ↦ ((μ⟦s | plane⟧) ω) • a := by
  refine (condExpL2_indicator_ae_eq_smul 𝕜 h0 hs _ a).trans ?_
  have h := (memLp_indicator_const (μ := μ) 2 hs (1 : ℝ) (Or.inr (measure_ne_top μ s)))
  filter_upwards [h.condExpL2_ae_eq_condExp (𝕜 := ℝ) h0] with ω hω
  rw [← hω]
  rfl

private theorem indicator_pairing (h0 : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : pos ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg pos) {s t : Set Ω}
    (hs : MeasurableSet[neg] s) (ht : MeasurableSet[pos] t) (a b : 𝕜) :
    let X := indicatorConstLp 2 (hn _ hs) (measure_ne_top μ s) a
    let Y := indicatorConstLp 2 (hp _ ht) (measure_ne_top μ t) b
    ⟪X, Y⟫_𝕜 = ⟪condExpL2 𝕜 𝕜 h0 X, condExpL2 𝕜 𝕜 h0 Y⟫_𝕜 := by
  dsimp only
  rw [L2.inner_indicatorConstLp_indicatorConstLp]
  change _ = ∫ ω, ⟪_, _⟫_𝕜 ∂μ
  rw [← event_integral_factor h0 hn hp hind hs ht, ← integral_smul_const]
  apply integral_congr_ae
  filter_upwards [projected_indicator h0 (hn _ hs) a, projected_indicator h0 (hp _ ht) b]
    with ω h₁ h₂
  simp only [Submodule.subtype_apply]
  rw [h₁, h₂, inner_smul_left_eq_smul, inner_smul_right_eq_smul, smul_smul]

private theorem meas_induction {m : MeasurableSpace Ω} (hm : m ≤ mΩ)
    (P : Lp 𝕜 2 μ → Prop)
    (hi : ∀ (a : 𝕜) (s : Set Ω) (hs : MeasurableSet[m] s),
      P (indicatorConstLp 2 (hm _ hs) (measure_ne_top μ s) a))
    (ha : ∀ X Y, P X → P Y → P (X + Y))
    (hc : IsClosed {X | P X}) (X : Lp 𝕜 2 μ) (hX : AEStronglyMeasurable[m] X μ) : P X := by
  apply Lp.induction_stronglyMeasurable hm (by norm_num) P _ _ _ X hX
  · intro a s hs hfin
    simpa only [Lp.simpleFunc.coe_indicatorConst] using hi a s hs
  · intro f g hf hg _ _ _ h1 h2
    exact ha _ _ h1 h2
  · exact hc.preimage continuous_subtype_val

/-- Eventwise conditional independence gives the mixed L² pairing of arbitrary observables
from the two halves, by two applications of density of measurable simple functions. -/
theorem independent_pairing (h0 : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : pos ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg pos) (X Y : Lp 𝕜 2 μ)
    (hX : AEStronglyMeasurable[neg] X μ) (hY : AEStronglyMeasurable[pos] Y μ) :
    ⟪X, Y⟫_𝕜 = ⟪condExpL2 𝕜 𝕜 h0 X, condExpL2 𝕜 𝕜 h0 Y⟫_𝕜 := by
  let Q := condExpL2 𝕜 𝕜 (μ := μ) h0
  change ⟪X, Y⟫_𝕜 = ⟪Q X, Q Y⟫_𝕜
  apply meas_induction hn (fun Z ↦ ⟪Z, Y⟫_𝕜 = ⟪Q Z, Q Y⟫_𝕜) _ _ _ X hX
  · intro a s hs
    let A := indicatorConstLp 2 (hn s hs) (measure_ne_top μ s) a
    apply meas_induction hp (fun Z ↦ ⟪A, Z⟫_𝕜 = ⟪Q A, Q Z⟫_𝕜) _ _ _ Y hY
    · intro b t ht
      exact indicator_pairing h0 hn hp hind hs ht a b
    · intro V W hV hW
      simp only [map_add, inner_add_right, hV, hW]
    · exact isClosed_eq (continuous_const.inner continuous_id) (continuous_const.inner Q.continuous)
  · intro V W hV hW
    simp only [map_add, inner_add_left, hV, hW]
  · exact isClosed_eq (continuous_id.inner continuous_const) (Q.continuous.inner continuous_const)

/-- A measure-preserving pullback fixing plane events modulo null sets has the same
conditional mean as the unreflected observable. -/
theorem reflection_condExpL2 (h0 : plane ≤ mΩ) {θ : Ω → Ω} (hθ : MeasurePreserving θ μ μ)
    (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s) (X : Lp 𝕜 2 μ) :
    condExpL2 𝕜 𝕜 h0 (Lp.compMeasurePreserving θ hθ X) = condExpL2 𝕜 𝕜 h0 X := by
  let Z := Lp.compMeasurePreserving θ hθ X
  have hZ := Lp.coeFn_compMeasurePreserving X hθ
  have hint (s : Set Ω) (hs : MeasurableSet[plane] s) :
      ∫ ω in s, X ω ∂μ = ∫ ω in s, Z ω ∂μ := by
    have hs' := h0 _ hs
    rw [← integral_indicator hs', ← integral_indicator hs']
    calc
      _ = ∫ ω, s.indicator (fun v ↦ X v) (θ ω) ∂μ := by
        have e := integral_map (μ := μ) hθ.measurable.aemeasurable
          (f := s.indicator (fun ω ↦ X ω)) (((Lp.stronglyMeasurable X).indicator hs').aestronglyMeasurable)
        rwa [hθ.map_eq] at e
      _ = _ := by
        apply integral_congr_ae
        filter_upwards [hfix s hs, hZ] with ω hmem heq
        have hm : θ ω ∈ s ↔ ω ∈ s := Iff.of_eq hmem
        by_cases hw : ω ∈ s
        · simpa [Set.indicator_of_mem, hw, hm.mpr hw, Z, Function.comp_apply] using heq.symm
        · simp [Set.indicator_of_notMem, hw, mt hm.mp hw]
  have hZX : (condExpL2 𝕜 𝕜 h0 X : Lp 𝕜 2 μ) =ᵐ[μ] μ[(fun ω ↦ Z ω) | plane] := by
    apply ae_eq_condExp_of_forall_setIntegral_eq h0 ((Lp.memLp Z).integrable one_le_two)
      (fun s _ hf ↦ integrableOn_condExpL2_of_measure_ne_top h0 hf.ne _)
    · intro s hs hf
      rw [integral_condExpL2_eq h0 X hs hf.ne, hint s hs]
    · exact aestronglyMeasurable_condExpL2 h0 _
  have hZQ := (Lp.memLp Z).condExpL2_ae_eq_condExp (𝕜 := 𝕜) h0
  rw [Lp.toLp_coeFn] at hZQ
  exact Subtype.ext (Lp.ext (hZQ.trans hZX.symm))

/-- Reflection pulls a positive preparation into the negative half. Its mixed pairing
is the ordinary plane inner product of the two original conditional means. -/
theorem reflected_pairing (h0 : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : pos ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg pos) {θ : Ω → Ω} (hθ : MeasurePreserving θ μ μ)
    (hswap : Measurable[neg, pos] θ) (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (X Y : lpMeas 𝕜 𝕜 pos 2 μ) :
    ⟪Lp.compMeasurePreserving θ hθ (X : Lp 𝕜 2 μ), (Y : Lp 𝕜 2 μ)⟫_𝕜 =
      ⟪condExpL2 𝕜 𝕜 h0 (X : Lp 𝕜 2 μ), condExpL2 𝕜 𝕜 h0 (Y : Lp 𝕜 2 μ)⟫_𝕜 := by
  have hx := lpMeas.aestronglyMeasurable X
  have hz : AEStronglyMeasurable[neg] (Lp.compMeasurePreserving θ hθ (X : Lp 𝕜 2 μ)) μ := by
    refine ⟨hx.mk _ ∘ θ, hx.stronglyMeasurable_mk.comp_measurable hswap, ?_⟩
    exact (Lp.coeFn_compMeasurePreserving _ hθ).trans (hθ.quasiMeasurePreserving.ae_eq_comp hx.ae_eq_mk)
  rw [independent_pairing h0 hn hp hind _ _ hz (lpMeas.aestronglyMeasurable Y),
    reflection_condExpL2 h0 hθ hfix]

/-- The reflected integral formula for real or complex preparations, with the actual
conditional expectations as functions. The scalar inner product conjugates its first slot. -/
theorem reflected_integral (h0 : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : pos ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg pos) {θ : Ω → Ω} (hθ : MeasurePreserving θ μ μ)
    (hswap : Measurable[neg, pos] θ) (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (X Y : Ω → 𝕜) (hx : AEStronglyMeasurable[pos] X μ) (hy : AEStronglyMeasurable[pos] Y μ)
    (hX : MemLp X 2 μ) (hY : MemLp Y 2 μ) :
    (∫ ω, ⟪X (θ ω), Y ω⟫_𝕜 ∂μ) = ∫ ω, ⟪μ[X | plane] ω, μ[Y | plane] ω⟫_𝕜 ∂μ := by
  let A : lpMeas 𝕜 𝕜 pos 2 μ := ⟨hX.toLp X, hx.congr hX.coeFn_toLp.symm⟩
  let B : lpMeas 𝕜 𝕜 pos 2 μ := ⟨hY.toLp Y, hy.congr hY.coeFn_toLp.symm⟩
  have ha : ((A : Lp 𝕜 2 μ) : Ω → 𝕜) =ᵐ[μ] X := hX.coeFn_toLp
  have hb : ((B : Lp 𝕜 2 μ) : Ω → 𝕜) =ᵐ[μ] Y := hY.coeFn_toLp
  have ht := (Lp.coeFn_compMeasurePreserving (A : Lp 𝕜 2 μ) hθ).trans
    (hθ.quasiMeasurePreserving.ae_eq_comp ha)
  calc
    _ = ⟪Lp.compMeasurePreserving θ hθ (A : Lp 𝕜 2 μ), (B : Lp 𝕜 2 μ)⟫_𝕜 := by
      apply integral_congr_ae
      filter_upwards [ht, hb] with ω ht' hb'
      rw [ht', hb', Function.comp_apply]
    _ = _ := reflected_pairing h0 hn hp hind hθ hswap hfix A B
    _ = _ := by
      change (∫ ω, ⟪(condExpL2 𝕜 𝕜 h0 (hX.toLp X) : Lp 𝕜 2 μ) ω,
        (condExpL2 𝕜 𝕜 h0 (hY.toLp Y) : Lp 𝕜 2 μ) ω⟫_𝕜 ∂μ) = _
      apply integral_congr_ae
      filter_upwards [hX.condExpL2_ae_eq_condExp (𝕜 := 𝕜) h0,
        hY.condExpL2_ae_eq_condExp (𝕜 := 𝕜) h0] with ω h₁ h₂
      rw [h₁, h₂]

/-- Eq. (4) for a real positive-side observable in an arbitrary probability space. -/
theorem real_eq_four (h0 : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : pos ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg pos) {θ : Ω → Ω} (hθ : MeasurePreserving θ μ μ)
    (hswap : Measurable[neg, pos] θ) (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (X : Ω → ℝ) (hx : AEStronglyMeasurable[pos] X μ) (h2 : MemLp X 2 μ) :
    (∫ ω, X (θ ω) * X ω ∂μ) = ∫ ω, (μ[X | plane] ω) ^ 2 ∂μ := by
  simpa only [Real.inner_apply, pow_two, mul_comm] using
    reflected_integral h0 hn hp hind hθ hswap hfix X X hx hx h2 h2

end DotProduct.GeneralReflection


/-! ### The reflected norm and the accessible plane -/

namespace DotProduct.GeneralReflection
open MeasureTheory Filter Set UniformSpace
open scoped Topology NNReal
noncomputable section

variable {Ω : Type*} (plus : MeasurableSpace Ω) {plane : MeasurableSpace Ω}
variable [mΩ : MeasurableSpace Ω] (μ : Measure Ω) (h₀ : plane ≤ mΩ)

/-- Conditioning of the actual positive-side observations in the ambient probability space. -/
def planeCondition : lpMeas ℂ ℂ plus 2 μ →L[ℂ] lpMeas ℂ ℂ plane 2 μ :=
  (condExpL2 ℂ ℂ h₀).comp (lpMeas ℂ ℂ plus 2 μ).subtypeL

/-- The accessible part of the plane. -/
abbrev stateSpace := (planeCondition plus μ h₀).range.topologicalClosure

instance stateSpaceComplete : CompleteSpace ↥(stateSpace plus μ h₀) := by
  let : Fact (plane ≤ mΩ) := ⟨h₀⟩
  exact Submodule.topologicalClosure.completeSpace _

/-- Conditioning viewed as a dense family of labels for the state space. -/
def stateLabel : lpMeas ℂ ℂ plus 2 μ →L[ℂ] stateSpace plus μ h₀ :=
  (planeCondition plus μ h₀).codRestrict _ fun X =>
    (planeCondition plus μ h₀).range.le_topologicalClosure ⟨X, rfl⟩

theorem denseRange_stateLabel : DenseRange (stateLabel plus μ h₀) :=
  ((denseRange_inclusion_iff (planeCondition plus μ h₀).range.le_topologicalClosure).2
    Subset.rfl).comp (Set.rangeFactorization_surjective (f := planeCondition plus μ h₀)).denseRange
    (continuous_inclusion _)

/-- The algebraic null quotient. Its norm is transported from conditioning, since the
ordinary Banach quotient norm of the Euclidean preparation space can differ. -/
def ReflectedClass := lpMeas ℂ ℂ plus 2 μ ⧸ (planeCondition plus μ h₀).ker
deriving AddCommGroup, Module ℂ

/-- The first isomorphism theorem identifies a class with its conditional expectation. -/
def classToRange : ReflectedClass plus μ h₀ ≃ₗ[ℂ] (planeCondition plus μ h₀).range :=
  (planeCondition plus μ h₀).toLinearMap.quotKerEquivRange

instance : NormedAddCommGroup (ReflectedClass plus μ h₀) :=
  NormedAddCommGroup.induced _ _ (classToRange plus μ h₀) (classToRange plus μ h₀).injective

instance : InnerProductSpace ℂ (ReflectedClass plus μ h₀) :=
  InnerProductSpace.induced (classToRange plus μ h₀)

/-- Take the class of a positive-side preparation in the reflected norm. -/
def preparationClass : lpMeas ℂ ℂ plus 2 μ →ₗ[ℂ] ReflectedClass plus μ h₀ :=
  (planeCondition plus μ h₀).ker.mkQ

theorem preparationClass_eq_iff (X Y : lpMeas ℂ ℂ plus 2 μ) :
    preparationClass plus μ h₀ X = preparationClass plus μ h₀ Y ↔
      planeCondition plus μ h₀ X = planeCondition plus μ h₀ Y := by
  change Submodule.Quotient.mk X = Submodule.Quotient.mk Y ↔ _
  rw [Submodule.Quotient.eq, LinearMap.mem_ker, map_sub, sub_eq_zero]
  rfl

theorem preparationClass_inner (X Y : lpMeas ℂ ℂ plus 2 μ) :
    inner ℂ (preparationClass plus μ h₀ X) (preparationClass plus μ h₀ Y) =
    inner ℂ (stateLabel plus μ h₀ X) (stateLabel plus μ h₀ Y) := rfl

set_option backward.isDefEq.respectTransparency false in
/-- Completion in the reflected norm gives precisely the closed range of conditioning. -/
def stateUnitary : Completion (ReflectedClass plus μ h₀) ≃ₗᵢ[ℂ] stateSpace plus μ h₀ := by
  letI : Fact (plane ≤ mΩ) := ⟨h₀⟩
  let j : (planeCondition plus μ h₀).range →ₗ[ℂ] stateSpace plus μ h₀ := Submodule.inclusion (planeCondition plus μ h₀).range.le_topologicalClosure
  have hd : DenseRange j := (denseRange_inclusion_iff (planeCondition plus μ h₀).range.le_topologicalClosure).2 Subset.rfl
  refine LinearEquiv.extendOfIsometry (E := ReflectedClass plus μ h₀)
    (F := ↥(planeCondition plus μ h₀).range) (Fₗ := ↥(stateSpace plus μ h₀))
    (Eₗ := Completion (ReflectedClass plus μ h₀)) (classToRange plus μ h₀)
    (Completion.toComplL : ReflectedClass plus μ h₀ →L[ℂ] _).toLinearMap
    (e₂ := j) (by exact Completion.denseRange_coe) (by exact hd) ?_
  intro x
  change ‖x‖ = ‖(x : Completion (ReflectedClass plus μ h₀))‖
  exact (Completion.norm_coe x).symm

set_option backward.isDefEq.respectTransparency false in
theorem stateUnitary_label (X : lpMeas ℂ ℂ plus 2 μ) :
    stateUnitary plus μ h₀ (preparationClass plus μ h₀ X) = stateLabel plus μ h₀ X := by
  let : Fact (plane ≤ mΩ) := ⟨h₀⟩
  unfold stateUnitary
  apply LinearEquiv.extendOfIsometry_eq

/-- Exact observability criterion: each plane vector is a limit of conditional means. -/
theorem stateSpace_eq_top_iff :
    stateSpace plus μ h₀ = ⊤ ↔ DenseRange (planeCondition plus μ h₀) :=
  Submodule.dense_iff_topologicalClosure_eq_top.symm

/-- When all plane observations are available on the positive side (modulo null sets),
they furnish their own preimages under conditioning. -/
theorem stateSpace_eq_top_of_observable
    (hobs : lpMeas ℂ ℂ plane 2 μ ≤ lpMeas ℂ ℂ plus 2 μ) :
    stateSpace plus μ h₀ = ⊤ := by
  apply top_unique
  intro f _
  apply (planeCondition plus μ h₀).range.le_topologicalClosure
  let : Fact (plane ≤ mΩ) := ⟨h₀⟩
  exact ⟨⟨f.1, hobs f.2⟩, Submodule.orthogonalProjectionOnto_mem_subspace_eq_self f⟩

theorem stateSpace_eq_top_of_plane_le (hobs : plane ≤ plus) : stateSpace plus μ h₀ = ⊤ :=
  stateSpace_eq_top_of_observable plus μ h₀ fun _ hx =>
    mem_lpMeas_iff_aestronglyMeasurable.mpr ((mem_lpMeas_iff_aestronglyMeasurable.mp hx).mono hobs)

end
end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection

open MeasureTheory ProbabilityTheory Set Filter
open scoped MeasureTheory ENNReal

private theorem full_plane_access {Ω : Type*} {plus : MeasurableSpace Ω}
    [m : MeasurableSpace Ω] (μ : Measure Ω) (hp : plus ≤ m)
    (Z : lpMeas ℂ ℂ m 2 μ) (hz : Z ∈ stateSpace plus μ (le_refl m)) :
    AEStronglyMeasurable[plus] (Z : Lp ℂ 2 μ) μ := by
  let : Fact (m ≤ m) := ⟨le_rfl⟩
  have hc : IsClosed {f : lpMeas ℂ ℂ m 2 μ | AEStronglyMeasurable[plus] (f : Lp ℂ 2 μ) μ} :=
    (isClosed_aestronglyMeasurable (μ := μ) (p := 2) (F := ℂ) hp).preimage continuous_subtype_val
  apply closure_minimal (t := {f : lpMeas ℂ ℂ m 2 μ | AEStronglyMeasurable[plus] (f : Lp ℂ 2 μ) μ})
    (s := ((planeCondition plus μ (le_refl m)).range : Set _)) _ hc hz
  rintro _ ⟨X, rfl⟩
  let Y : lpMeas ℂ ℂ m 2 μ := ⟨X.1, (Lp.aestronglyMeasurable X.1)⟩
  change AEStronglyMeasurable[plus] ((condExpL2 ℂ ℂ (le_refl m) (Y : Lp ℂ 2 μ) : lpMeas ℂ ℂ m 2 μ) : Lp ℂ 2 μ) μ
  rw [show condExpL2 ℂ ℂ (le_refl m) (Y : Lp ℂ 2 μ) = Y from
    Submodule.orthogonalProjectionOnto_mem_subspace_eq_self Y]
  exact lpMeas.aestronglyMeasurable X

/-- With the fair coin visible on the plane and trivial observations in each open half,
the identity reflection satisfies the event hypotheses but the accessible plane is proper. -/
theorem unobserved_plane_coin :
    let μ := uniformOn (Set.univ : Set (Fin 2))
    let plane : MeasurableSpace (Fin 2) := inferInstance
    ObservedCondIndep μ plane ⊥ ⊥ ∧ stateSpace ⊥ μ (le_refl plane) ≠ ⊤ := by
  let μ := uniformOn (Set.univ : Set (Fin 2))
  let plane : MeasurableSpace (Fin 2) := inferInstance
  change ObservedCondIndep μ plane ⊥ ⊥ ∧ stateSpace ⊥ μ (le_refl plane) ≠ ⊤
  constructor
  · intro s t _ _
    have he (u : Set (Fin 2)) : μ⟦u | plane⟧ = u.indicator (fun _ ↦ (1 : ℝ)) := by
      have hu : MeasurableSet u := Set.Finite.measurableSet u.toFinite
      exact condExp_of_stronglyMeasurable le_rfl (stronglyMeasurable_const.indicator hu)
        ((integrable_const 1).indicator hu)
    rw [he, he, he]
    exact Filter.EventuallyEq.of_eq (Set.inter_indicator_one ..)
  · intro hall
    let s : Set (Fin 2) := {0}
    have hs : MeasurableSet s := measurableSet_singleton 0
    let A := indicatorConstLp 2 hs (measure_ne_top μ s) (1 : ℂ)
    let Z : lpMeas ℂ ℂ plane 2 μ := ⟨A, Lp.aestronglyMeasurable A⟩
    have hZ : Z ∈ stateSpace ⊥ μ (le_refl plane) := by rw [hall]; trivial
    have hbot := full_plane_access μ (show (⊥ : MeasurableSpace (Fin 2)) ≤ plane from bot_le) Z hZ
    obtain ⟨c, hc⟩ := stronglyMeasurable_bot_iff.mp hbot.stronglyMeasurable_mk
    have hA : (A : Fin 2 → ℂ) =ᵐ[μ] s.indicator (fun _ ↦ (1 : ℂ)) := indicatorConstLp_coeFn
    have hind : (fun ω ↦ s.indicator (fun _ ↦ (1 : ℂ)) ω) =ᵐ[μ] fun _ ↦ c :=
      hA.symm.trans (hbot.ae_eq_mk.trans (Filter.EventuallyEq.of_eq hc))
    have hpos (x : Fin 2) : μ {x} ≠ 0 := by simp [μ, uniformOn_univ]
    have h₀ := ae_iff_of_countable.mp hind 0 (hpos 0)
    have h₁ := ae_iff_of_countable.mp hind 1 (hpos 1)
    norm_num [s] at h₀ h₁
    exact one_ne_zero (h₀.trans h₁.symm)

end DotProduct.GeneralReflection


/-! ### Stationary positive shifts on the sample space and on the completion -/

namespace DotProduct.GeneralReflection
open MeasureTheory Filter Set
open scoped NNReal
noncomputable section

variable {Ω : Type*} {plus : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} {θ : Ω → Ω}

/-- Positive Euclidean time acts on the sample space. The reversal law is the
positive-time form of θ τ(s) θ = τ(−s) for a reflection and a group of shifts. -/
structure StationaryShifts (plus : MeasurableSpace Ω) [ambient : MeasurableSpace Ω]
    (μ : Measure Ω) (θ : Ω → Ω) where
  shift : ℝ≥0 → Ω → Ω
  stationary : ∀ s, MeasurePreserving (shift s) μ μ
  forward : ∀ s, Measurable[plus, plus] (shift s)
  zero : shift 0 = id
  add : ∀ s t, shift (s+t) = shift t ∘ shift s
  reverse : ∀ s, (shift s ∘ θ) ∘ shift s = θ

namespace StationaryShifts

variable (D : StationaryShifts plus μ θ)

/-- Pullback of positive observations by the sample-space shift. -/
def preparationShift (s : ℝ≥0) : lpMeas ℂ ℂ plus 2 μ →ₗ[ℂ] lpMeas ℂ ℂ plus 2 μ :=
  ((Lp.compMeasurePreservingₗ ℂ (D.shift s) (D.stationary s)).comp
    (lpMeas ℂ ℂ plus 2 μ).subtype).codRestrict _ fun X => by
    have hx := lpMeas.aestronglyMeasurable X
    refine mem_lpMeas_iff_aestronglyMeasurable.mpr ⟨hx.mk _ ∘ D.shift s,
      hx.stronglyMeasurable_mk.comp_measurable (D.forward s), ?_⟩
    exact (Lp.coeFn_compMeasurePreserving _ (D.stationary s)).trans
      ((D.stationary s).quasiMeasurePreserving.ae_eq_comp hx.ae_eq_mk)

theorem preparationShift_norm (s : ℝ≥0) (X : lpMeas ℂ ℂ plus 2 μ) :
    ‖D.preparationShift s X‖ = ‖X‖ := Lp.norm_compMeasurePreserving _ _

private theorem pullback_congr {f g : Ω → Ω} (hf : MeasurePreserving f μ μ)
    (hg : MeasurePreserving g μ μ) (e : f = g) (X : Lp ℂ 2 μ) :
    Lp.compMeasurePreserving f hf X = Lp.compMeasurePreserving g hg X := by subst f; rfl

theorem preparationShift_zero (X : lpMeas ℂ ℂ plus 2 μ) : D.preparationShift 0 X = X := by
  apply Subtype.ext
  exact (pullback_congr _ (.id μ) D.zero X.1).trans (Lp.compMeasurePreserving_id_apply _)

theorem preparationShift_add (s t : ℝ≥0) (X : lpMeas ℂ ℂ plus 2 μ) :
    D.preparationShift (s+t) X = D.preparationShift s (D.preparationShift t X) := by
  apply Subtype.ext
  exact (pullback_congr _ ((D.stationary t).comp (D.stationary s)) (D.add s t) X.1).trans
    (Lp.compMeasurePreserving_comp_apply _ _ _)

/-- Stationarity and time reversal allow the shift to cross a reflected inner product. -/
theorem reflected_shift_symmetry (hθ : MeasurePreserving θ μ μ) (s : ℝ≥0)
    (X Y : lpMeas ℂ ℂ plus 2 μ) :
    inner ℂ (Lp.compMeasurePreserving θ hθ (D.preparationShift s X).1) Y.1 =
    inner ℂ (Lp.compMeasurePreserving θ hθ X.1) (D.preparationShift s Y).1 := by
  let U := Lp.compMeasurePreservingₗᵢ (E := ℂ) (p := 2) ℂ (D.shift s) (D.stationary s)
  rw [← U.inner_map_map (Lp.compMeasurePreserving θ hθ (D.preparationShift s X).1) Y.1]
  change inner ℂ (Lp.compMeasurePreserving _ (D.stationary s) (Lp.compMeasurePreserving _ hθ
    (Lp.compMeasurePreserving _ (D.stationary s) X.1))) _ = _
  rw [← Lp.compMeasurePreserving_comp_apply, ← Lp.compMeasurePreserving_comp_apply]
  exact congrArg₂ (inner ℂ) (pullback_congr _ hθ (D.reverse s) X.1) rfl

end StationaryShifts
end
end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection

open Set
open scoped NNReal

section Shifts

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- A uniformly contractive family has continuous orbits as soon as its orbits
are continuous on a dense family. -/
theorem continuous_orbit_of_dense {I J V : Type*} [PseudoMetricSpace J] [PseudoMetricSpace V]
    {j : I → V} (hd : DenseRange j) (A : J → V → V)
    (hbound : ∀ s v w, dist (A s v) (A s w) ≤ dist v w)
    (hc : ∀ i, Continuous (fun s => A s (j i))) (v : V) :
    Continuous (fun s => A s v) := by
  apply continuous_iff_continuousAt.2
  intro t
  apply Metric.continuousAt_iff.2
  intro ε hε
  obtain ⟨i, hi⟩ := hd.exists_dist_lt v (ε := ε / 3) (by positivity)
  obtain ⟨δ, hδ, hd'⟩ := Metric.continuousAt_iff.mp ((hc i).continuousAt (x := t))
    (ε / 3) (by positivity)
  refine ⟨δ, hδ, fun {s} hs => ?_⟩
  have hm := hd' hs
  have h₁ := hbound s v (j i)
  have h₂ := hbound t (j i) v
  rw [dist_comm (j i) v] at h₂
  calc
    dist (A s v) (A t v) ≤ dist (A s v) (A s (j i)) +
        dist (A s (j i)) (A t (j i)) + dist (A t (j i)) (A t v) :=
      dist_triangle4 _ _ _ _
    _ < ε := by linarith

/-- For Euclidean isometries it suffices to check shift continuity on a family
of smeared preparations whose complex linear span is dense. -/
theorem stationary_orbit_continuous_of_total {I : Type*} (j : I → E)
    (hd : Dense (Submodule.span ℂ (range j) : Set E)) (S : ℝ≥0 → E →ₗ[ℂ] E)
    (hnorm : ∀ s x, ‖S s x‖ = ‖x‖)
    (hc : ∀ i, Continuous (fun s => S s (j i))) (x : E) :
    Continuous (fun s => S s x) := by
  let V := Submodule.span ℂ (range j)
  have hV : DenseRange ((↑) : V → E) := by simpa using! hd
  apply continuous_orbit_of_dense hV (fun s v => S s v) _ _ x
  · intro s v w
    simp only [dist_eq_norm, ← map_sub, hnorm, le_refl]
  · rintro ⟨v, hv⟩
    change Continuous (fun s => S s v)
    refine Submodule.span_induction (p := fun v _ => Continuous (fun s => S s v))
      ?_ ?_ ?_ ?_ hv
    · rintro _ ⟨i, rfl⟩
      exact hc i
    · simpa using (continuous_const : Continuous (fun _ : ℝ≥0 => (0 : E)))
    · intro a b _ _ ha hb
      simpa only [map_add] using ha.fun_add hb
    · intro r a _ ha
      simpa only [map_smul] using ha.fun_const_smul r

/-- In the reflected norm, contraction follows from symmetry, the semigroup law, and
bounded Euclidean orbits. For a fixed preparation, take the supremum over its entire
positive orbit in the Cauchy–Schwarz estimate at times zero and twice the shift. -/
theorem conditioned_shift_contractive
    (q : E →L[ℂ] H) (S : ℝ≥0 → E →ₗ[ℂ] E)
    (hadd : ∀ s t x, S (s + t) x = S s (S t x))
    (hnorm : ∀ s x, ‖S s x‖ = ‖x‖)
    (hsym : ∀ s x y, inner ℂ (q (S s x)) (q y) = inner ℂ (q x) (q (S s y)))
    (s : ℝ≥0) (x : E) : ‖q (S s x)‖ ≤ ‖q x‖ := by
  let a (t : ℝ≥0) := ‖q (S t x)‖
  let M := sSup (range a)
  have hb : BddAbove (range a) := by
    refine ⟨‖q‖ * ‖x‖, ?_⟩
    rintro _ ⟨t, rfl⟩
    simpa only [a, ← hnorm t x] using q.le_opNorm (S t x)
  have hM (t : ℝ≥0) : a t ≤ M := le_csSup hb (mem_range_self t)
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hsq (t : ℝ≥0) : a t ^ 2 ≤ ‖q x‖ * M := by
    calc
      a t ^ 2 = ‖inner ℂ (q (S t x)) (q (S t x))‖ := by simp [a]
      _ = ‖inner ℂ (q x) (q (S (t + t) x))‖ := by rw [hsym, hadd]
      _ ≤ ‖q x‖ * a (t + t) := norm_inner_le_norm _ _
      _ ≤ ‖q x‖ * M := mul_le_mul_of_nonneg_left (hM _) (norm_nonneg _)
  have hsup : M ≤ Real.sqrt (‖q x‖ * M) := by
    refine csSup_le (range_nonempty a) ?_
    rintro _ ⟨t, rfl⟩
    exact Real.le_sqrt_of_sq_le (hsq t)
  have hM2 := (Real.le_sqrt hM0 (mul_nonneg (norm_nonneg _) hM0)).mp hsup
  exact (hM s).trans (by nlinarith [norm_nonneg (q x)])

variable [CompleteSpace H]

/-- The positive-time evolution on the completed reflected state space. The label
equation determines every bounded operator, even without any plane observability. -/
structure ReconstructedShifts (q : E →L[ℂ] H) (S : ℝ≥0 → E →ₗ[ℂ] E)
    (T : ℝ≥0 → H →L[ℂ] H) : Prop where
  label : ∀ s x, T s (q x) = q (S s x)
  zero : ∀ v, T 0 v = v
  add : ∀ s t v, T (s + t) v = T s (T t v)
  contractive : ∀ s, ‖T s‖ ≤ 1
  selfAdjoint : ∀ s, IsSelfAdjoint (T s)
  positive : ∀ s, (T s).IsPositive
  stronglyContinuous : ∀ v, Continuous (fun s => T s v)
  unique : ∀ s (A : H →L[ℂ] H), (∀ x, A (q x) = q (S s x)) → A = T s

/-- Euclidean stationarity controls the orbit before descent. Reflection symmetry then
forces contraction in the conditioned norm, so null directions are preserved and the
shifts extend uniquely to the completion. -/
theorem stationary_shift_descent
    (q : E →L[ℂ] H) (hd : DenseRange q) (S : ℝ≥0 → E →ₗ[ℂ] E)
    (hzero : ∀ x, S 0 x = x)
    (hadd : ∀ s t x, S (s + t) x = S s (S t x))
    (hnorm : ∀ s x, ‖S s x‖ = ‖x‖)
    (hsym : ∀ s x y, inner ℂ (q (S s x)) (q y) = inner ℂ (q x) (q (S s y)))
    (hcont : ∀ x, Continuous (fun s => S s x)) :
    ∃ T : ℝ≥0 → H →L[ℂ] H, ReconstructedShifts q S T := by
  let f (s : ℝ≥0) := q.toLinearMap.comp (S s)
  let T (s : ℝ≥0) := (f s).extendOfNorm q.toLinearMap
  have hbound (s : ℝ≥0) (x : E) : ‖f s x‖ ≤ 1 * ‖q.toLinearMap x‖ := by
    simpa [f] using conditioned_shift_contractive q S hadd hnorm hsym s x
  have hlabel (s : ℝ≥0) (x : E) : T s (q x) = q (S s x) :=
    LinearMap.extendOfNorm_eq (f := f s) (e := q.toLinearMap) hd ⟨1, hbound s⟩ x
  have hext (A B : H →L[ℂ] H) (h : ∀ x, A (q x) = B (q x)) : A = B :=
    DFunLike.ext' (hd.equalizer A.continuous B.continuous (funext h))
  have hzero' (v : H) : T 0 v = v := by
    have he : T 0 = ContinuousLinearMap.id ℂ H :=
      hext _ _ fun x => by simp [hlabel, hzero]
    simp [he]
  have hadd' (s t : ℝ≥0) (v : H) : T (s + t) v = T s (T t v) := by
    have he : T (s + t) = (T s).comp (T t) :=
      hext _ _ fun x => by simp [hlabel, hadd]
    simp [he]
  have hnorm' (s : ℝ≥0) : ‖T s‖ ≤ 1 :=
    LinearMap.opNorm_extendOfNorm_le (f := f s) (e := q.toLinearMap) hd zero_le_one (hbound s)
  have hsym' (s : ℝ≥0) : (T s).IsSymmetric := by
    intro v w
    refine hd.induction_on₂ (p := fun v w => inner ℂ (T s v) w = inner ℂ v (T s w))
      (isClosed_eq (by fun_prop) (by fun_prop)) ?_ v w
    intro x y
    simpa only [hlabel] using hsym s x y
  have hself (s : ℝ≥0) : IsSelfAdjoint (T s) :=
    ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr (hsym' s)
  have hpos (s : ℝ≥0) : (T s).IsPositive := by
    refine ⟨hsym' s, fun v => ?_⟩
    change 0 ≤ (inner ℂ (T s v) v).re
    have hh : s / 2 + s / 2 = s := add_halves s
    rw [← hh, hadd']
    have he : inner ℂ (T (s / 2) (T (s / 2) v)) v =
        inner ℂ (T (s / 2) v) (T (s / 2) v) := hsym' _ _ _
    rw [he]
    exact inner_self_nonneg (𝕜 := ℂ) (x := T (s / 2) v)
  have hdist (s : ℝ≥0) (v w : H) : dist (T s v) (T s w) ≤ dist v w := by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub]
    exact ((T s).le_opNorm _).trans (by
      simpa using mul_le_mul_of_nonneg_right (hnorm' s) (norm_nonneg (v - w)))
  have hstrong (v : H) : Continuous (fun s => T s v) := by
    apply continuous_orbit_of_dense hd (fun s w => T s w) hdist _ v
    intro x
    simp_rw [hlabel]
    exact q.continuous.comp (hcont x)
  exact ⟨T, ⟨hlabel, hzero', hadd', hnorm', hself, hpos, hstrong,
    fun s A hA => hext _ _ (fun x => (hA x).trans (hlabel s x).symm)⟩⟩

end Shifts

end DotProduct.GeneralReflection


/-! ### The Hamiltonian on the strong right-derivative domain -/

namespace DotProduct

noncomputable section

open MeasureTheory Set Filter
open scoped NNReal Topology ComplexConjugate

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The infinitesimal Hamiltonian graph of positive-time evolution. Its sign convention
is the one in which the right derivative of the orbit is minus the Hamiltonian. -/
def generalShiftGeneratorGraph (T : ℝ≥0 → H →L[ℂ] H) : Submodule ℂ (H × H) where
  carrier := {p | HasDerivWithinAt (fun r : ℝ => T r.toNNReal p.1) (-p.2) (Ici 0) 0}
  zero_mem' := by simpa using
    (hasDerivWithinAt_const (s := Ici 0) (0 : ℝ) (0 : H))
  add_mem' := by
    rintro ⟨x, u⟩ ⟨y, v⟩ hx hy
    change HasDerivWithinAt (fun r : ℝ => T r.toNNReal x) (-u) _ _ at hx
    change HasDerivWithinAt (fun r : ℝ => T r.toNNReal y) (-v) _ _ at hy
    simpa [Pi.add_def, neg_add_rev, add_comm (-u)] using hx.add hy
  smul_mem' := by
    rintro c ⟨x, u⟩ hx
    change HasDerivWithinAt (fun r : ℝ => T r.toNNReal x) (-u) _ _ at hx
    simpa [Pi.smul_def] using hx.const_smul c

/-- The partially defined operator whose full domain consists of right-differentiable
orbits at time zero. -/
def generalShiftGenerator (T : ℝ≥0 → H →L[ℂ] H) : H →ₗ.[ℂ] H :=
  (generalShiftGeneratorGraph T).toLinearPMap

omit [CompleteSpace H] in
theorem generalShiftGenerator_graph (T : ℝ≥0 → H →L[ℂ] H) :
    (generalShiftGenerator T).graph = generalShiftGeneratorGraph T := by
  apply Submodule.toLinearPMap_graph_eq
  rintro ⟨x, y⟩ hx hzero
  change x = 0 at hzero
  subst x
  change HasDerivWithinAt (fun r : ℝ => T r.toNNReal 0) (-y) (Ici 0) 0 at hx
  simp only [map_zero] at hx
  have hz := hx.derivWithin (uniqueDiffWithinAt_Ici 0)
  simpa using hz

omit [CompleteSpace H] in
theorem generalShiftGenerator_mem_graph (T : ℝ≥0 → H →L[ℂ] H) (x y : H) :
    (x, y) ∈ (generalShiftGenerator T).graph ↔
      HasDerivWithinAt (fun r : ℝ => T r.toNNReal x) (-y) (Ici 0) 0 := by
  rw [generalShiftGenerator_graph]
  rfl

private def generalShiftPrimitive (T : ℝ≥0 → H →L[ℂ] H) (x : H) (r : ℝ) : H :=
  ∫ u in 0..r, T u.toNNReal x

private theorem generalShiftPrimitive_deriv (T : ℝ≥0 → H →L[ℂ] H)
    (hc : ∀ x, Continuous (fun s => T s x)) (x : H) (r : ℝ) :
    HasDerivAt (generalShiftPrimitive T x) (T r.toNNReal x) r :=
  (((hc x).comp continuous_real_toNNReal).integral_hasStrictDerivAt 0 r).hasDerivAt

private theorem generalShiftPrimitive_action (T : ℝ≥0 → H →L[ℂ] H)
    (hadd : ∀ s t x, T (s + t) x = T s (T t x))
    (hc : ∀ x, Continuous (fun s => T s x)) (x : H) {a r : ℝ} (ha : 0 ≤ a) (hr : 0 ≤ r) :
    T r.toNNReal (generalShiftPrimitive T x a) =
      generalShiftPrimitive T x (a+r) - generalShiftPrimitive T x r := by
  let f := fun u : ℝ => T u.toNNReal x
  have hf : Continuous f := (hc x).comp continuous_real_toNNReal
  change T _ (∫ u in 0..a, f u) = (∫ u in 0..a+r, f u) - ∫ u in 0..r, f u
  rw [← (T r.toNNReal).intervalIntegral_comp_comm (hf.intervalIntegrable _ _)]
  calc
    _ = ∫ u in 0..a, f (u+r) := by
      apply intervalIntegral.integral_congr
      intro u hu
      rw [uIcc_of_le ha] at hu
      simp only [f, Real.toNNReal_add hu.1 hr, add_comm u.toNNReal, hadd]
    _ = ∫ u in r..a+r, f u := by rw [intervalIntegral.integral_comp_add_right, zero_add]
    _ = _ := by
      have h := intervalIntegral.integral_add_adjacent_intervals
        (hf.intervalIntegrable (μ := volume) 0 r) (hf.intervalIntegrable r (a+r))
      rw [← h]
      abel

private theorem generalShiftPrimitive_mem (T : ℝ≥0 → H →L[ℂ] H)
    (hzero : ∀ x, T 0 x = x) (hadd : ∀ s t x, T (s + t) x = T s (T t x))
    (hc : ∀ x, Continuous (fun s => T s x)) (x : H) {a : ℝ} (ha : 0 ≤ a) :
    (generalShiftPrimitive T x a, x - T a.toNNReal x) ∈ (generalShiftGenerator T).graph := by
  rw [generalShiftGenerator_mem_graph]
  have d₁ : HasDerivAt (fun r => generalShiftPrimitive T x (a+r)) (T a.toNNReal x) 0 := by
    have h := (generalShiftPrimitive_deriv T hc x (a+0)).scomp 0
      ((hasDerivAt_id (0 : ℝ)).const_add a)
    simpa [Function.comp_def] using h
  have d₂ := generalShiftPrimitive_deriv T hc x 0
  have d := (d₁.sub d₂).hasDerivWithinAt (s := Ici 0)
  simp only [Real.toNNReal_zero, hzero] at d
  simpa only [neg_sub] using d.congr_of_mem
    (fun r hr => generalShiftPrimitive_action T hadd hc x ha hr) (self_mem_Ici)


theorem generalShiftGenerator_dense (T : ℝ≥0 → H →L[ℂ] H)
    (hzero : ∀ x, T 0 x = x) (hadd : ∀ s t x, T (s + t) x = T s (T t x))
    (hc : ∀ x, Continuous (fun s => T s x)) :
    Dense ((generalShiftGenerator T).domain : Set H) := by
  intro x
  have d := (generalShiftPrimitive_deriv T hc x 0).hasDerivWithinAt (s := Ioi 0)
  have h := (hasDerivWithinAt_iff_tendsto_slope' (s := Ioi (0 : ℝ)) (lt_irrefl (0 : ℝ))).mp d
  simp only [Real.toNNReal_zero, hzero] at h
  apply mem_closure_of_tendsto h
  filter_upwards [self_mem_nhdsWithin] with r hr
  rw [slope_def_module]
  have hz : generalShiftPrimitive T x 0 = 0 := by simp [generalShiftPrimitive]
  rw [hz, sub_zero, sub_zero, RCLike.real_smul_eq_coe_smul (K := ℂ)]
  exact (generalShiftGenerator T).domain.smul_mem _
    (LinearPMap.mem_domain_of_mem_graph (generalShiftPrimitive_mem T hzero hadd hc x (le_of_lt hr)))

private theorem generalShiftPrimitive_symm (T : ℝ≥0 → H →L[ℂ] H)
    (hs : ∀ s, IsSelfAdjoint (T s)) (hc : ∀ x, Continuous (fun s => T s x))
    (x y : H) (r : ℝ) :
    inner ℂ (generalShiftPrimitive T x r) y = inner ℂ x (generalShiftPrimitive T y r) := by
  have h (v w : H) : inner ℂ v (generalShiftPrimitive T w r) =
      ∫ u in 0..r, inner ℂ v (T u.toNNReal w) :=
    ((innerSL ℂ v).intervalIntegral_comp_comm
      (((hc w).comp continuous_real_toNNReal).intervalIntegrable _ _)).symm
  rw [← inner_conj_symm (generalShiftPrimitive T x r) y, h, ← intervalIntegral.intervalIntegral_conj, h]
  apply intervalIntegral.integral_congr
  intro u _
  dsimp only
  rw [inner_conj_symm]
  exact (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp (hs u.toNNReal)) x y

private theorem generalShiftGenerator_symm (T : ℝ≥0 → H →L[ℂ] H)
    (hs : ∀ s, IsSelfAdjoint (T s)) {x y a b : H}
    (hx : (x, a) ∈ (generalShiftGenerator T).graph)
    (hy : (y, b) ∈ (generalShiftGenerator T).graph) :
    inner ℂ a y = inner ℂ x b := by
  rw [generalShiftGenerator_mem_graph] at hx hy
  have d₁ := hx.inner ℂ (hasDerivWithinAt_const (s := Ici 0) (0 : ℝ) y)
  have d₂ := (hasDerivWithinAt_const (s := Ici 0) (0 : ℝ) x).inner ℂ hy
  have ef : (fun r : ℝ => inner ℂ (T r.toNNReal x) y) =
      (fun r : ℝ => inner ℂ x (T r.toNNReal y)) :=
    funext fun r => (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp (hs r.toNNReal)) x y
  simp only [inner_zero_right, zero_add, inner_neg_left] at d₁
  simp only [inner_zero_left, add_zero, inner_neg_right] at d₂
  rw [ef] at d₁
  exact neg_inj.mp ((d₁.derivWithin (uniqueDiffWithinAt_Ici 0)).symm.trans
    (d₂.derivWithin (uniqueDiffWithinAt_Ici 0)))

/-- The positive-time shifts determine a self-adjoint unbounded operator on the
exact strong right-derivative domain. Testing the adjoint on interval averages proves
the converse inclusion of domains. -/
theorem generalShiftGenerator_selfAdjoint (T : ℝ≥0 → H →L[ℂ] H)
    (hzero : ∀ x, T 0 x = x) (hadd : ∀ s t x, T (s + t) x = T s (T t x))
    (hs : ∀ s, IsSelfAdjoint (T s)) (hc : ∀ x, Continuous (fun s => T s x)) :
    IsSelfAdjoint (generalShiftGenerator T) := by
  rw [LinearPMap.isSelfAdjoint_def]
  apply LinearPMap.eq_of_eq_graph
  rw [LinearPMap.adjoint_graph_eq_graph_adjoint (generalShiftGenerator_dense T hzero hadd hc)]
  ext ⟨x,y⟩
  rw [Submodule.mem_adjoint_iff]
  simp only [sub_eq_zero]
  constructor
  · intro h
    have eqn (r : ℝ) (hr : 0 ≤ r) :
        T r.toNNReal x = x - generalShiftPrimitive T y r := by
      apply ext_inner_left ℂ
      intro z
      have hp := h _ _ (generalShiftPrimitive_mem T hzero hadd hc z hr)
      rw [inner_sub_left, generalShiftPrimitive_symm T hs hc] at hp
      have hsym : inner ℂ (T r.toNNReal z) x = inner ℂ z (T r.toNNReal x) :=
        (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp (hs r.toNNReal)) z x
      rw [← hsym, inner_sub_right, ← hp, sub_sub_cancel]
    rw [generalShiftGenerator_mem_graph]
    have hd := (hasDerivAt_const (0 : ℝ) x).sub (generalShiftPrimitive_deriv T hc y 0)
    simp only [Real.toNNReal_zero, hzero, zero_sub] at hd
    exact hd.hasDerivWithinAt.congr_of_mem eqn self_mem_Ici
  · intro h a b hab
    exact generalShiftGenerator_symm T hs hab h

omit [CompleteSpace H] in
/-- Contractivity makes the infinitesimal Hamiltonian nonnegative on its domain. -/
theorem generalShiftGenerator_nonneg (T : ℝ≥0 → H →L[ℂ] H)
    (hzero : ∀ x, T 0 x = x) (hcontract : ∀ s, ‖T s‖ ≤ 1) {x y : H}
    (hxy : (x,y) ∈ (generalShiftGenerator T).graph) : 0 ≤ (inner ℂ x y).re := by
  rw [generalShiftGenerator_mem_graph] at hxy
  let L : H →L[ℝ] ℝ := Complex.reCLM.comp ((innerSL ℂ x).restrictScalars ℝ)
  have hd := L.hasFDerivAt.comp_hasDerivWithinAt 0 hxy.Ioi_of_Ici
  have h := (hasDerivWithinAt_iff_tendsto_slope' (s := Ioi (0 : ℝ)) (lt_irrefl (0 : ℝ))).mp hd
  have hz : L (-y) ≤ 0 := by
    apply le_of_tendsto h
    filter_upwards [self_mem_nhdsWithin] with r hr
    rw [slope_def_module, sub_zero, smul_eq_mul]
    apply mul_nonpos_of_nonneg_of_nonpos (inv_nonneg.mpr (le_of_lt hr))
    simp only [Function.comp_apply, Real.toNNReal_zero, hzero, sub_nonpos]
    change RCLike.re (inner ℂ x (T r.toNNReal x)) ≤ RCLike.re (inner ℂ x x)
    calc
      _ ≤ ‖x‖ * ‖T r.toNNReal x‖ := re_inner_le_norm (𝕜 := ℂ) _ _
      _ ≤ ‖x‖ * ‖x‖ := by
        gcongr
        exact (T r.toNNReal).le_of_opNorm_le (hcontract _) x |>.trans (by simp)
      _ = RCLike.re (inner ℂ x x) := by rw [inner_self_eq_norm_sq, pow_two]
  change (inner ℂ x (-y)).re ≤ 0 at hz
  simpa using hz

end
end DotProduct


namespace DotProduct.GeneralReflection
open MeasureTheory Set
open scoped NNReal
noncomputable section

variable {Ω : Type*} {plane neg plus : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω]
  {μ : Measure Ω} [IsProbabilityMeasure μ] {θ : Ω → Ω}

/-- The quotient inner product on classes of preparations is exactly the measured
reflected pairing. In particular, this identifies the null space of the measured form. -/
theorem preparationClass_reflected_inner (h₀ : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : plus ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg plus) (hθ : MeasurePreserving θ μ μ)
    (hswap : Measurable[neg, plus] θ) (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (X Y : lpMeas ℂ ℂ plus 2 μ) :
    inner ℂ (preparationClass plus μ h₀ X) (preparationClass plus μ h₀ Y) =
      inner ℂ (Lp.compMeasurePreserving θ hθ X.1) Y.1 :=
  (reflected_pairing h₀ hn hp hind hθ hswap hfix X Y).symm

theorem preparationClass_eq_zero_iff (h₀ : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : plus ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg plus) (hθ : MeasurePreserving θ μ μ)
    (hswap : Measurable[neg, plus] θ) (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (X : lpMeas ℂ ℂ plus 2 μ) :
    preparationClass plus μ h₀ X = 0 ↔ inner ℂ (Lp.compMeasurePreserving θ hθ X.1) X.1 = 0 := by
  rw [← preparationClass_reflected_inner h₀ hn hp hind hθ hswap hfix, inner_self_eq_zero]

/-- General §4 reconstruction on the closed range of plane conditioning. Shift continuity
is checked in the Euclidean preparation norm on any total family. The operator on the
reflected space and the self-adjoint operator on its derivative domain are conclusions. -/
theorem measured_shift_reconstruction (h₀ : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : plus ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg plus) (hθ : MeasurePreserving θ μ μ)
    (hswap : Measurable[neg, plus] θ) (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (D : StationaryShifts plus μ θ) {I : Type*} (j : I → lpMeas ℂ ℂ plus 2 μ)
    (htotal : Dense (Submodule.span ℂ (range j) : Set (lpMeas ℂ ℂ plus 2 μ)))
    (hcont : ∀ i, Continuous (fun s => D.preparationShift s (j i))) :
    ∃ T : ℝ≥0 → stateSpace plus μ h₀ →L[ℂ] stateSpace plus μ h₀,
      ReconstructedShifts (H := ↥(stateSpace plus μ h₀)) (stateLabel plus μ h₀) D.preparationShift T ∧
      Dense ((generalShiftGenerator (H := ↥(stateSpace plus μ h₀)) T).domain : Set (stateSpace plus μ h₀)) ∧
      IsSelfAdjoint (generalShiftGenerator (H := ↥(stateSpace plus μ h₀)) T) ∧
      ∀ x y, (x,y) ∈ (generalShiftGenerator (H := ↥(stateSpace plus μ h₀)) T).graph → 0 ≤ (inner ℂ x y).re := by
  have hsym (s) (X Y : lpMeas ℂ ℂ plus 2 μ) :
      inner ℂ (stateLabel plus μ h₀ (D.preparationShift s X)) (stateLabel plus μ h₀ Y) =
      inner ℂ (stateLabel plus μ h₀ X) (stateLabel plus μ h₀ (D.preparationShift s Y)) := by
    change inner ℂ (condExpL2 ℂ ℂ h₀ _) (condExpL2 ℂ ℂ h₀ _) =
      inner ℂ (condExpL2 ℂ ℂ h₀ _) (condExpL2 ℂ ℂ h₀ _)
    exact (reflected_pairing h₀ hn hp hind hθ hswap hfix (D.preparationShift s X) Y).symm.trans
      ((D.reflected_shift_symmetry hθ s X Y).trans
        (reflected_pairing h₀ hn hp hind hθ hswap hfix X (D.preparationShift s Y)))
  obtain ⟨T, hT⟩ := stationary_shift_descent (H := ↥(stateSpace plus μ h₀)) _ (denseRange_stateLabel plus μ h₀) _
    D.preparationShift_zero D.preparationShift_add D.preparationShift_norm hsym
    (stationary_orbit_continuous_of_total j htotal _ D.preparationShift_norm hcont)
  exact ⟨T, hT, generalShiftGenerator_dense T hT.zero hT.add hT.stronglyContinuous,
    generalShiftGenerator_selfAdjoint T hT.zero hT.add hT.selfAdjoint hT.stronglyContinuous,
    fun _ _ => generalShiftGenerator_nonneg T hT.zero hT.contractive⟩

end
end DotProduct.GeneralReflection


/-! ### Continuation by spectral powers of the time-one operator -/

namespace DotProduct.GeneralReflection

open Set Filter
open scoped NNReal NNRat Topology ComplexOrder

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

private theorem nonnegative_root_unique {A B : H →L[ℂ] H} (ha : A.IsPositive)
    (hb : B.IsPositive) {n : ℕ} (hn : n ≠ 0) (h : A ^ n = B ^ n) : A = B := by
  have root (Z : H →L[ℂ] H) (hz : Z.IsPositive) : (Z ^ n) ^ (n : ℝ)⁻¹ = Z := by
    have hz' := ContinuousLinearMap.nonneg_iff_isPositive.mpr hz
    have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn
    rw [← CFC.rpow_natCast Z n hz', CFC.rpow_rpow_of_exponent_nonneg Z _ _ (by positivity)
      (by positivity) hz', mul_inv_cancel₀ hn', CFC.rpow_one Z hz']
  rw [← root A ha, h, root B hb]

omit [CompleteSpace H] in
private theorem semigroup_nat_mul (T : ℝ≥0 → H →L[ℂ] H) (h0 : ∀ v, T 0 v = v)
    (hadd : ∀ s t v, T (s + t) v = T s (T t v)) (s : ℝ≥0) (n : ℕ) :
    T (n * s) = (T s)^n := by
  induction n with
  | zero => ext v; simpa using h0 v
  | succ n ih =>
    rw [Nat.cast_succ, add_mul, one_mul, pow_succ, ← ih]
    ext v
    exact hadd _ _ v

private theorem dense_nnrat_time : DenseRange (fun q : ℚ≥0 ↦ (q : ℝ≥0)) := by
  apply dense_of_exists_between
  intro a b hab
  obtain ⟨q, h₁, h₂⟩ := exists_rat_btwn (show (a : ℝ) < (b : ℝ) from hab)
  have hq : 0 ≤ q := Rat.cast_nonneg.mp (a.property.trans h₁.le)
  let u : ℚ≥0 := ⟨q, hq⟩
  have hu : ((u : ℝ≥0) : ℝ) = (q : ℝ) := by
    change ((↑(u : ℝ≥0)) : ℝ) = ((u : ℚ) : ℝ)
    norm_cast
  refine ⟨(u : ℝ≥0), ⟨u, rfl⟩, ?_, ?_⟩
  · change (a : ℝ) < ((u : ℝ≥0) : ℝ)
    rwa [hu]
  · change ((u : ℝ≥0) : ℝ) < (b : ℝ)
    rwa [hu]

/-- Two strongly continuous semigroups of positive operators are determined by their
common time-one operator. Unique positive roots first identify all rational times. -/
theorem time_one_unique (T U : ℝ≥0 → H →L[ℂ] H)
    (hT0 : ∀ v, T 0 v = v) (hU0 : ∀ v, U 0 v = v)
    (hTadd : ∀ s t v, T (s+t) v = T s (T t v))
    (hUadd : ∀ s t v, U (s+t) v = U s (U t v))
    (hTp : ∀ s, (T s).IsPositive) (hUp : ∀ s, (U s).IsPositive)
    (hTc : ∀ v, Continuous (fun s ↦ T s v)) (hUc : ∀ v, Continuous (fun s ↦ U s v))
    (h1 : T 1 = U 1) : T = U := by
  have eq_rat (q : ℚ≥0) : T q = U q := by
    have hd : (q.den : ℝ≥0) ≠ 0 := by exact_mod_cast q.den_ne_zero
    have hq : (q.den : ℝ≥0) * (q : ℝ≥0) = (q.num : ℝ≥0) := by
      rw [NNRat.cast_def]
      field_simp
    apply nonnegative_root_unique (hTp _) (hUp _) q.den_ne_zero
    rw [← semigroup_nat_mul T hT0 hTadd, ← semigroup_nat_mul U hU0 hUadd, hq]
    simpa only [mul_one, h1] using
      (semigroup_nat_mul T hT0 hTadd 1 q.num).trans
        ((congrArg (fun A : H →L[ℂ] H ↦ A ^ q.num) h1).trans (semigroup_nat_mul U hU0 hUadd 1 q.num).symm)
  funext s
  ext v
  exact congrFun (dense_nnrat_time.equalizer (hTc v) (hUc v)
    (funext fun q ↦ congrArg (fun A : H →L[ℂ] H ↦ A v) (eq_rat q))) s

end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection

noncomputable section
open Set MeasureTheory Complex

private theorem mapWedgeIntegral {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [CompleteSpace E] [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    {f : ℂ → E} {U : Set ℂ} (hf : ContinuousOn f U) (L : E →L[ℂ] F)
    {z w : ℂ} (hr : Rectangle z w ⊆ U) :
    L (wedgeIntegral z w f) = wedgeIntegral z w (fun t => L (f t)) := by
  have h₁ : IntervalIntegrable (fun x : ℝ => f (x + z.im * I)) volume z.re w.re := by
    apply ContinuousOn.intervalIntegrable
    apply hf.comp (f := fun x : ℝ => (x : ℂ) + z.im * I) (by fun_prop)
    intro x hx
    apply hr
    simpa [Rectangle, mem_reProdIm] using And.intro hx (left_mem_uIcc (a := z.im) (b := w.im))
  have h₂ : IntervalIntegrable (fun y : ℝ => f (w.re + y * I)) volume z.im w.im := by
    apply ContinuousOn.intervalIntegrable
    apply hf.comp (f := fun y : ℝ => (w.re : ℂ) + y * I) (by fun_prop)
    intro y hy
    apply hr
    simpa [Rectangle, mem_reProdIm] using And.intro (right_mem_uIcc (a := z.re) (b := w.re)) hy
  simp only [wedgeIntegral, map_add, map_smul, ← L.intervalIntegral_comp_comm h₁,
    ← L.intervalIntegral_comp_comm h₂]

/-- A norm-continuous family of continuous functions on a compact space is holomorphic
where all of its evaluations are holomorphic. Evaluation commutes with rectangle integrals,
so vector-valued Morera applies. -/
theorem differentiableOn_continuousMap_of_eval {X : Type*} [TopologicalSpace X] [CompactSpace X]
    {U : Set ℂ} (ho : IsOpen U) {f : ℂ → C(X, ℂ)} (hc : ContinuousOn f U)
    (he : ∀ x, DifferentiableOn ℂ (fun z => f z x) U) :
    DifferentiableOn ℂ f U := by
  apply (isConservativeOn_and_continuousOn_iff_isDifferentiableOn ho).mp
  refine ⟨?_, hc⟩
  intro z w hzw
  have hwz : Rectangle w z ⊆ U := by
    simpa [Rectangle, uIcc_comm w.re z.re, uIcc_comm w.im z.im] using hzw
  ext x
  let L : C(X, ℂ) →L[ℂ] ℂ := ContinuousMap.evalCLM ℂ x
  change L (wedgeIntegral z w f) = L (-wedgeIntegral w z f)
  rw [map_neg, mapWedgeIntegral hc L hzw, mapWedgeIntegral hc L hwz]
  exact (he x).isConservativeOn z w hzw

/-- On the open right half-plane, a norm-continuous family of spectral powers is
holomorphic, including at spectral values with zero base. -/
theorem differentiableOn_continuousMap_cpow {X : Type*} [TopologicalSpace X] [CompactSpace X]
    {g : ℂ → C(X, ℂ)} {a : X → ℂ}
    (hc : ContinuousOn g {z : ℂ | 0 < z.re})
    (hg : ∀ z : ℂ, 0 < z.re → ∀ x, g z x = a x ^ z) :
    DifferentiableOn ℂ g {z : ℂ | 0 < z.re} := by
  apply differentiableOn_continuousMap_of_eval (isOpen_lt continuous_const continuous_re) hc
  intro x
  by_cases hx : a x = 0
  · apply (differentiableOn_const (c := (0 : ℂ))).congr
    intro z hz
    have hn : z ≠ 0 := fun h => by simp [h] at hz
    rw [hg z hz x, hx, zero_cpow hn]
  · let : NeZero (a x) := ⟨hx⟩
    apply (differentiable_const_cpow_of_neZero (a x)).differentiableOn.congr
    exact fun z hz => hg z hz x

end
end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection

noncomputable section
open Set Filter
open scoped NNReal Topology ComplexOrder ComplexConjugate
variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {q : E →L[ℂ] H} {S : ℝ≥0 → E →ₗ[ℂ] E} {T : ℝ≥0 → H →L[ℂ] H}

/-- A vector in the kernel at time one lies in the kernel at every dyadic time
by symmetry. Strong continuity at zero then gives injectivity of the time-one shift. -/
theorem ReconstructedShifts.injective_one (h : ReconstructedShifts q S T) : Function.Injective (T 1) := by
  apply (injective_iff_map_eq_zero (T 1)).mpr
  intro v hv
  have step (s : ℝ≥0) (hs : T s v = 0) : T (s / 2) v = 0 := by
    apply (inner_self_eq_zero (𝕜 := ℂ)).mp
    have hh := (h.selfAdjoint (s / 2)).isSymmetric v (T (s / 2) v)
    change inner ℂ (T (s / 2) v) (T (s / 2) v) = inner ℂ v (T (s / 2) (T (s / 2) v)) at hh
    rw [hh, ← h.add, add_halves, hs, inner_zero_right]
  have hseq (n : ℕ) : T ((1 / 2 : ℝ≥0) ^ n) v = 0 := by
    induction n with
    | zero => simpa using hv
    | succ n ih => simpa only [pow_succ, mul_one_div] using step _ ih
  have ht := tendsto_pow_atTop_nhds_zero_of_lt_one (show 0 ≤ (1 / 2 : ℝ≥0) by positivity)
    (by norm_num : (1 / 2 : ℝ≥0) < 1)
  have hlim := ((h.stronglyContinuous v).tendsto 0).comp ht
  have he := tendsto_nhds_unique hlim (tendsto_const_nhds.congr (fun n => (hseq n).symm))
  simpa only [h.zero] using he


/-- The dense range of the time-one shift determines its boundary operators. -/
theorem ReconstructedShifts.denseRange_one (h : ReconstructedShifts q S T) : DenseRange (T 1) := by
  change Dense ((T 1).range : Set H)
  rw [Submodule.dense_iff_topologicalClosure_eq_top, Submodule.topologicalClosure_eq_top_iff,
    ContinuousLinearMap.IsStarNormal.orthogonal_range (h.selfAdjoint 1).isStarNormal, Submodule.eq_bot_iff]
  exact fun v hv => h.injective_one (hv.trans (map_zero _).symm)

private abbrev PositiveTime := {z : ℂ // 0 < z.re}
private abbrev ClosedTime := {z : ℂ // 0 ≤ z.re}

private def powFunction (B : H →L[ℂ] H) (z : PositiveTime) : C(spectrum ℂ B, ℂ) :=
  ⟨fun x => (x.val.re : ℂ) ^ z.val,
    continuous_iff_continuousAt.2 fun x =>
      (Complex.continuousAt_ofReal_cpow_const _ _ (.inl z.property)).comp (by fun_prop)⟩

omit [CompleteSpace H] in
private theorem powFunction_continuous (B : H →L[ℂ] H) : Continuous (powFunction B) := by
  apply ContinuousMap.continuous_of_continuous_uncurry
  apply continuous_iff_continuousAt.2
  intro p
  change ContinuousAt (fun y : PositiveTime × spectrum ℂ B => (y.2.val.re : ℂ) ^ y.1.val) p
  exact (Complex.continuousAt_ofReal_cpow p.2.val.re p.1.val (.inl p.1.property)).comp_of_eq
    (f := fun y : PositiveTime × spectrum ℂ B => (y.2.val.re, y.1.val)) (by fun_prop) rfl

private def spectralPower {B : H →L[ℂ] H} (hB : B.IsPositive) (z : PositiveTime) : H →L[ℂ] H :=
  cfcHom hB.isSelfAdjoint.isStarNormal (powFunction B z)

private theorem spectralPower_continuous {B : H →L[ℂ] H} (hB : B.IsPositive) :
    Continuous (spectralPower hB) :=
  (cfcHom_continuous hB.isSelfAdjoint.isStarNormal).comp (powFunction_continuous B)

private theorem spectrum_real_nonneg {B : H →L[ℂ] H} (hB : B.IsPositive) (x : spectrum ℂ B) :
    0 ≤ x.val.re ∧ (x.val.re : ℂ) = x.val := by
  have hx : 0 ≤ x.val := spectrum_nonneg_of_nonneg (ContinuousLinearMap.nonneg_iff_isPositive.mpr hB) x.property
  obtain ⟨hr, hi⟩ := Complex.nonneg_iff.mp hx
  exact ⟨hr, Complex.ext rfl hi⟩

private theorem spectralPower_one {B : H →L[ℂ] H} (hB : B.IsPositive) :
    spectralPower hB ⟨1, by simp⟩ = B := by
  unfold spectralPower
  apply Eq.trans _ (cfcHom_id (R := ℂ) hB.isSelfAdjoint.isStarNormal)
  congr 1
  ext x
  change (x.val.re : ℂ) ^ (1 : ℂ) = x.val
  simpa only [Complex.cpow_one] using (spectrum_real_nonneg hB x).2

private theorem spectralPower_mul {B : H →L[ℂ] H} (hB : B.IsPositive) (z w : PositiveTime) :
    spectralPower hB z * spectralPower hB w =
      spectralPower hB ⟨z.val + w.val, add_pos z.property w.property⟩ := by
  unfold spectralPower
  rw [← map_mul]
  congr 1
  ext x
  change (x.val.re : ℂ) ^ z.val * (x.val.re : ℂ) ^ w.val = (x.val.re : ℂ) ^ (z.val + w.val)
  by_cases hx : (x.val.re : ℂ) = 0
  · have hz : z.val ≠ 0 := fun h => by simpa [h] using z.property
    have hw : w.val ≠ 0 := fun h => by simpa [h] using w.property
    have hzw : z.val + w.val ≠ 0 := fun h => by
      have hh : 0 < (z.val + w.val).re := add_pos z.property w.property
      simp [h] at hh
    simp [hx, hz, hw, hzw]
  · exact (Complex.cpow_add _ _ hx).symm

private theorem spectralPower_star {B : H →L[ℂ] H} (hB : B.IsPositive) (z : PositiveTime) :
    star (spectralPower hB z) = spectralPower hB ⟨conj z.val, by simpa using z.property⟩ := by
  unfold spectralPower
  rw [← map_star]
  congr 1
  ext x
  change conj ((x.val.re : ℂ) ^ z.val) = (x.val.re : ℂ) ^ conj z.val
  have hx := (spectrum_real_nonneg hB x).1
  simpa only [Complex.conj_ofReal] using (Complex.cpow_conj (x.val.re : ℂ) z.val
    (by rw [Complex.arg_ofReal_of_nonneg hx]; exact Real.pi_ne_zero.symm)).symm


private theorem spectralPower_norm {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (z : PositiveTime) : ‖spectralPower hB z‖ ≤ 1 := by
  rcases subsingleton_or_nontrivial H with hs | hnt
  · simp [Subsingleton.elim (spectralPower hB z) 0]
  unfold spectralPower
  rw [norm_cfcHom B _ hB.isSelfAdjoint.isStarNormal, ContinuousMap.norm_le _ zero_le_one]
  intro x
  have hr := (spectrum_real_nonneg hB x).1
  change ‖(x.val.re : ℂ) ^ z.val‖ ≤ 1
  rw [Complex.norm_cpow_eq_rpow_re_of_nonneg hr z.property.ne']
  exact Real.rpow_le_one hr ((Complex.re_le_norm _).trans ((spectrum.norm_le_norm_of_mem x.property).trans hn))
    z.property.le

private def damp (z : ClosedTime) : PositiveTime :=
  ⟨z.val + 1, by simpa only [Complex.add_re, Complex.one_re] using add_pos_of_nonneg_of_pos z.property zero_lt_one⟩

private theorem spectralPower_damped_norm {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (z : ClosedTime) (v : H) : ‖spectralPower hB (damp z) v‖ ≤ ‖B v‖ := by
  rcases z.property.eq_or_lt with hz | hz
  · have he : star (spectralPower hB (damp z)) * spectralPower hB (damp z) = star B * B := by
      rw [spectralPower_star, spectralPower_mul, hB.isSelfAdjoint.star_eq]
      conv_rhs => rw [← spectralPower_one hB, spectralPower_mul]
      congr 1
      apply Subtype.ext
      apply Complex.ext <;> simp [damp, ← hz]
    have he' := congrArg (fun A : H →L[ℂ] H => (inner ℂ (A v) v).re) he
    rw [(spectralPower hB (damp z)).apply_norm_eq_sqrt_inner_adjoint_left,
      B.apply_norm_eq_sqrt_inner_adjoint_left]
    exact (congrArg Real.sqrt he').le
  · have hfac : spectralPower hB (damp z) = spectralPower hB ⟨z.val, hz⟩ * B := by
      calc
        _ = spectralPower hB ⟨z.val, hz⟩ * spectralPower hB ⟨1, by simp⟩ :=
          (spectralPower_mul hB _ _).symm
        _ = _ := by rw [spectralPower_one]
    rw [hfac]
    exact ((spectralPower hB ⟨z.val, hz⟩).le_opNorm (B v)).trans
      (by simpa using mul_le_mul_of_nonneg_right (spectralPower_norm hB hn _) (norm_nonneg (B v)))

private def closedPower {B : H →L[ℂ] H} (hB : B.IsPositive) (z : ClosedTime) : H →L[ℂ] H :=
  (spectralPower hB (damp z)).toLinearMap.extendOfNorm B.toLinearMap

private theorem closedPower_label {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (hd : DenseRange B) (z : ClosedTime) (v : H) :
    closedPower hB z (B v) = spectralPower hB (damp z) v := by
  apply LinearMap.extendOfNorm_eq (e := B.toLinearMap) (f := (spectralPower hB (damp z)).toLinearMap) hd
  exact ⟨1, fun x => by simpa using spectralPower_damped_norm hB hn z x⟩

private theorem closedPower_norm {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (hd : DenseRange B) (z : ClosedTime) : ‖closedPower hB z‖ ≤ 1 := by
  apply LinearMap.opNorm_extendOfNorm_le (e := B.toLinearMap)
    (f := (spectralPower hB (damp z)).toLinearMap) hd zero_le_one
  exact fun x => by simpa using spectralPower_damped_norm hB hn z x

private theorem closedPower_strong {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (hd : DenseRange B) (v : H) : Continuous (fun z => closedPower hB z v) := by
  apply continuous_orbit_of_dense hd (fun z w => closedPower hB z w) _ _ v
  · intro z v w
    rw [dist_eq_norm, dist_eq_norm, ← map_sub]
    exact ((closedPower hB z).le_opNorm _).trans (by
      simpa using mul_le_mul_of_nonneg_right (closedPower_norm hB hn hd z) (norm_nonneg (v - w)))
  · intro x
    simp_rw [closedPower_label hB hn hd]
    have hc := (spectralPower_continuous hB).comp (show Continuous damp by unfold damp; fun_prop)
    exact hc.clm_apply continuous_const


private theorem spectralPower_commutes {B : H →L[ℂ] H} (hB : B.IsPositive) (z : PositiveTime) :
    spectralPower hB z * B = B * spectralPower hB z := by
  have he : spectralPower hB z * spectralPower hB ⟨1, by simp⟩ =
      spectralPower hB ⟨1, by simp⟩ * spectralPower hB z := by
    rw [spectralPower_mul, spectralPower_mul]
    congr 1
    exact Subtype.ext (add_comm _ _)
  simpa only [spectralPower_one] using he

private theorem closedPower_zero {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (hd : DenseRange B) (v : H) : closedPower hB ⟨0, by simp⟩ v = v := by
  apply congrFun (hd.equalizer (g := ⇑(closedPower hB ⟨0, by simp⟩)) (h := id)
    (closedPower hB _).continuous continuous_id _) v
  funext x
  change closedPower hB ⟨0, by simp⟩ (B x) = B x
  rw [closedPower_label hB hn hd]
  have hh : damp ⟨0, by simp⟩ = ⟨1, by simp⟩ := Subtype.ext (zero_add _)
  rw [hh, spectralPower_one]

private theorem closedPower_interior {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (hd : DenseRange B) (z : PositiveTime) :
    closedPower hB ⟨z.val, z.property.le⟩ = spectralPower hB z := by
  apply DFunLike.ext' (hd.equalizer (closedPower hB _).continuous (spectralPower hB _).continuous _)
  funext v
  change closedPower hB _ (B v) = spectralPower hB z (B v)
  rw [closedPower_label hB hn hd]
  have hh : spectralPower hB (damp ⟨z.val, z.property.le⟩) =
      spectralPower hB z * spectralPower hB ⟨1, by simp⟩ := (spectralPower_mul hB z ⟨1, by simp⟩).symm
  rw [hh, spectralPower_one]
  rfl

private theorem closedPower_add {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (hd : DenseRange B) (z w : ClosedTime) :
    closedPower hB z * closedPower hB w = closedPower hB ⟨z.val + w.val, add_nonneg z.property w.property⟩ := by
  have hdd : DenseRange (B ∘ B) := hd.comp hd B.continuous
  apply DFunLike.ext' (hdd.equalizer (closedPower hB z * closedPower hB w).continuous
    (closedPower hB _).continuous _)
  funext x
  change closedPower hB z (closedPower hB w (B (B x))) = closedPower hB _ (B (B x))
  rw [closedPower_label hB hn hd, closedPower_label hB hn hd]
  have hw : spectralPower hB (damp w) (B x) = B (spectralPower hB (damp w) x) :=
    DFunLike.congr_fun (spectralPower_commutes hB _) x
  rw [hw, closedPower_label hB hn hd]
  change (spectralPower hB (damp z) * spectralPower hB (damp w)) x =
    (spectralPower hB (damp _) * B) x
  have he := spectralPower_mul hB (damp ⟨z.val + w.val, add_nonneg z.property w.property⟩) ⟨1, by simp⟩
  rw [spectralPower_one] at he
  rw [spectralPower_mul, he]
  congr 2
  apply Subtype.ext
  change (z.val + 1) + (w.val + 1) = z.val + w.val + 1 + 1
  ring

private theorem closedPower_real_positive {B : H →L[ℂ] H} (hB : B.IsPositive) (hn : ‖B‖ ≤ 1)
    (hd : DenseRange B) (s : ℝ≥0) : (closedPower hB ⟨(s : ℝ), s.property⟩).IsPositive := by
  rcases eq_or_lt_of_le s.property with hs | hs
  · have h0 : s = 0 := NNReal.coe_injective hs.symm
    subst s
    have he : closedPower hB ⟨(0 : ℝ≥0), by simp⟩ = 1 :=
      ContinuousLinearMap.ext (fun x => closedPower_zero hB hn hd x)
    rw [show closedPower hB ⟨((0 : ℝ≥0) : ℝ), _⟩ = 1 from he]
    exact ContinuousLinearMap.isPositive_one
  · let w : PositiveTime := ⟨((s : ℝ) / 2 : ℝ), by simpa using half_pos hs⟩
    have hreal : star (spectralPower hB w) = spectralPower hB w := by
      rw [spectralPower_star]
      congr 1
      exact Subtype.ext (Complex.conj_ofReal _)
    have he : star (spectralPower hB w) * spectralPower hB w =
        spectralPower hB ⟨(s : ℝ), hs⟩ := by
      rw [hreal, spectralPower_mul]
      congr 1
      apply Subtype.ext
      change (↑((s : ℝ) / 2) : ℂ) + ↑((s : ℝ) / 2) = (s : ℝ)
      rw [← Complex.ofReal_add, add_halves]
    rw [closedPower_interior hB hn hd ⟨(s : ℝ), hs⟩, ← he]
    exact ContinuousLinearMap.isPositive_adjoint_comp_self _


/-- An operator-norm holomorphic continuation of the reconstructed shifts, with a
strongly continuous unitary group on the imaginary axis and strong limits there from
the entire closed half-plane. The scalar parameter in the two boundary equations
uses the same positive-time and imaginary-time conventions as the massive theory. -/
structure HolomorphicShifts (T : ℝ≥0 → H →L[ℂ] H) (W : ℂ → H →L[ℂ] H)
    (U : ℝ → H ≃ₗᵢ[ℂ] H) : Prop where
  realTime : ∀ s : ℝ≥0, W (s : ℝ) = T s
  boundary : ∀ t : ℝ, W (Complex.I * t) = (U t).toContinuousLinearEquiv.toContinuousLinearMap
  holomorphic : DifferentiableOn ℂ W {z | 0 < z.re}
  stronglyContinuous : ∀ v, ContinuousOn (fun z => W z v) {z | 0 ≤ z.re}
  add : ∀ z w : ℂ, 0 ≤ z.re → 0 ≤ w.re → W (z + w) = W z * W w
  contractive : ∀ z : ℂ, 0 ≤ z.re → ‖W z‖ ≤ 1
  unitaryAdd : ∀ t u v, U (t + u) v = U t (U u v)
  unitaryContinuous : ∀ v, Continuous (fun t => U t v)

set_option maxHeartbeats 1000000 in
/-- Continuous functional calculus of the time-one shift gives the full complex-time
family. The value at zero in its spectrum need not be separated from the remaining
spectrum. On the dense range of the time-one shift the symbol is regularized by
multiplication by the spectral parameter, which determines every boundary value. -/
theorem ReconstructedShifts.holomorphicShifts (h : ReconstructedShifts q S T) :
    ∃ (W : ℂ → H →L[ℂ] H) (U : ℝ → H ≃ₗᵢ[ℂ] H), HolomorphicShifts T W U := by
  let B := T 1
  have hp : B.IsPositive := h.positive 1
  have hn : ‖B‖ ≤ 1 := h.contractive 1
  have hd : DenseRange B := h.denseRange_one
  let W (z : ℂ) := if hz : 0 ≤ z.re then closedPower hp ⟨z, hz⟩ else 0
  have hW {z : ℂ} (hz : 0 ≤ z.re) : W z = closedPower hp ⟨z, hz⟩ := by simp [W, hz]
  have hW0 (v : H) : W 0 v = v := by
    rw [hW (z := 0) (by simp)]
    exact closedPower_zero hp hn hd v
  have hWa (z w : ℂ) (hz : 0 ≤ z.re) (hw : 0 ≤ w.re) : W (z + w) = W z * W w := by
    rw [hW hz, hW hw, hW (z := z + w) (add_nonneg hz hw)]
    exact (closedPower_add hp hn hd ⟨z, hz⟩ ⟨w, hw⟩).symm
  have hWn (z : ℂ) (hz : 0 ≤ z.re) : ‖W z‖ ≤ 1 := by
    rw [hW hz]
    exact closedPower_norm hp hn hd _
  have hWc (v : H) : ContinuousOn (fun z => W z v) {z | 0 ≤ z.re} := by
    apply continuousOn_iff_continuous_domRestrict.mpr
    exact (closedPower_strong hp hn hd v).congr (fun z => (DFunLike.congr_fun (hW z.property) v).symm)
  have hWr : (fun s : ℝ≥0 => W (s : ℝ)) = T := by
    refine time_one_unique _ T (fun v => hW0 v) h.zero ?_ h.add ?_ h.positive ?_ h.stronglyContinuous ?_
    · intro s t v
      change W (↑((s : ℝ) + (t : ℝ)) : ℂ) v = W (s : ℝ) (W (t : ℝ) v)
      rw [Complex.ofReal_add, hWa _ _ s.property t.property]
      rfl
    · intro s
      rw [hW (z := ((s : ℝ) : ℂ)) s.property]
      exact closedPower_real_positive hp hn hd s
    · intro v
      exact (hWc v).comp_continuous (show Continuous (fun s : ℝ≥0 => ((s : ℝ) : ℂ)) by fun_prop)
        (fun s : ℝ≥0 => s.property)
    · change W 1 = B
      rw [hW (z := 1) (by simp), closedPower_interior hp hn hd ⟨1, by simp⟩, spectralPower_one]
  have hholo : DifferentiableOn ℂ W {z | 0 < z.re} := by
    let F (z : ℂ) := if hz : 0 < z.re then powFunction B ⟨z, hz⟩ else 0
    have hFc : ContinuousOn F {z | 0 < z.re} := by
      apply continuousOn_iff_continuous_domRestrict.mpr
      exact (powFunction_continuous B).congr fun z => by simp [F, z.property]
    have hFd := differentiableOn_continuousMap_cpow (a := fun x : spectrum ℂ B => (x.val.re : ℂ))
      hFc (fun z hz x => by simp only [F, hz, ↓reduceDIte]; rfl)
    have hL := (cfcL (R := ℂ) hp.isSelfAdjoint.isStarNormal).differentiable.comp_differentiableOn hFd
    apply hL.congr
    intro z hz
    change 0 < z.re at hz
    rw [hW hz.le, closedPower_interior hp hn hd ⟨z, hz⟩]
    change spectralPower hp ⟨z, hz⟩ = cfcHom _ (F z)
    simp [F, hz, spectralPower]
  let A (t : ℝ) := W (Complex.I * t)
  have him (t : ℝ) : 0 ≤ (Complex.I * t).re := by simp
  have hAadd (s t : ℝ) : A (s + t) = A s * A t := by
    simpa only [A, Complex.ofReal_add, mul_add] using hWa _ _ (him s) (him t)
  have hA0 (v : H) : A 0 v = v := by simpa only [A, Complex.ofReal_zero, mul_zero] using hW0 v
  have hAi (t : ℝ) (v : H) : A (-t) (A t v) = v := by
    change (A (-t) * A t) v = v
    rw [← hAadd, neg_add_cancel, hA0]
  have hAb (t : ℝ) (v : H) : ‖A t v‖ ≤ ‖v‖ :=
    ((A t).le_opNorm _).trans (by
      simpa using mul_le_mul_of_nonneg_right (hWn _ (him t)) (norm_nonneg v))
  let J (t : ℝ) : H →ₗᵢ[ℂ] H :=
    { (A t).toLinearMap with
      norm_map' := fun v => by
        change ‖A t v‖ = ‖v‖
        exact le_antisymm (hAb t v) (by simpa only [hAi] using hAb (-t) (A t v)) }
  let U (t : ℝ) := LinearIsometryEquiv.ofSurjective (J t)
    (fun v => ⟨A (-t) v, by
      change A t (A (-t) v) = v
      simpa only [neg_neg] using hAi (-t) v⟩)
  refine ⟨W, U, ⟨congrFun hWr, fun _ => rfl, hholo, hWc, hWa, hWn, ?_, ?_⟩⟩
  · intro t u v
    exact DFunLike.congr_fun (hAadd t u) v
  · intro v
    exact (hWc v).comp_continuous (by fun_prop) him


end

end DotProduct.GeneralReflection


/-! ### The imaginary-axis generator and uniqueness of continuation -/

namespace DotProduct.GeneralReflection

noncomputable section
open Complex Set MeasureTheory
open scoped NNReal

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

omit [CompleteSpace H] in
/-- At an interior point the complex derivative is fixed by the semigroup's
right derivative on the positive real axis. -/
private theorem orbit_interior_deriv {T : ℝ≥0 → H →L[ℂ] H} {F : ℂ → H →L[ℂ] H}
    (hreal : ∀ s : ℝ≥0, F s = T s)
    (hadd : ∀ z w : ℂ, 0 ≤ z.re → 0 ≤ w.re → ∀ v, F (z + w) v = F z (F w v))
    (hhol : ∀ v x, DifferentiableOn ℂ (fun z => inner ℂ v (F z x)) {z | 0 < z.re})
    {x y : H} (hxy : (x,y) ∈ (generalShiftGenerator T).graph) (v : H)
    {z : ℂ} (hz : 0 < z.re) :
    HasDerivAt (fun w => inner ℂ v (F w x)) (-inner ℂ v (F z y)) z := by
  have h := ((hhol v x z hz).differentiableAt
    ((isOpen_lt continuous_const continuous_re).mem_nhds hz)).hasDerivAt
  let L : H →L[ℝ] ℂ := ((innerSL ℂ v).comp (F z)).restrictScalars ℝ
  have hd := L.hasFDerivAt.comp_hasDerivWithinAt 0 ((generalShiftGenerator_mem_graph T x y).1 hxy)
  have hd' : HasDerivWithinAt (fun r : ℝ => inner ℂ v (F (z+r) x)) (-inner ℂ v (F z y))
      (Ici 0) 0 := by
    simp only [map_neg] at hd
    apply hd.congr_of_mem
    · intro r hr
      change inner ℂ v (F (z+r) x) = inner ℂ v (F z (T r.toNNReal x))
      rw [hadd z r hz.le (by simpa using hr), ← hreal, Real.coe_toNNReal r hr]
    · exact self_mem_Ici
  have hh : HasDerivAt (fun r : ℂ => inner ℂ v (F (z+r) x))
      (deriv (fun w => inner ℂ v (F w x)) z) 0 := by
    have hp := h.comp_of_eq 0 ((hasDerivAt_id (0 : ℂ)).const_add z) (by simp)
    simpa [Function.comp_def] using hp
  have heq := ((hh.comp_ofReal.hasDerivWithinAt (s := Ici 0)).derivWithin
    (uniqueDiffWithinAt_Ici 0)).symm.trans (hd'.derivWithin (uniqueDiffWithinAt_Ici 0))
  rwa [← heq]

/-- For every vector in the exact positive-time generator domain the imaginary
boundary orbit is strongly differentiable at each real time, with derivative
`−i U(t) A x`. Injectivity at a single positive time allows cancellation after
integrating the interior Cauchy–Riemann equation. -/
theorem boundaryOrbit_hasDerivAt {T : ℝ≥0 → H →L[ℂ] H} {F : ℂ → H →L[ℂ] H}
    (hreal : ∀ s : ℝ≥0, F s = T s)
    (hadd : ∀ z w : ℂ, 0 ≤ z.re → 0 ≤ w.re → ∀ v, F (z + w) v = F z (F w v))
    (hhol : ∀ v x, DifferentiableOn ℂ (fun z => inner ℂ v (F z x)) {z | 0 < z.re})
    (hcont : ∀ v, Continuous (fun t : ℝ => F ((t : ℂ)*I) v))
    (hinj : Function.Injective (T 1))
    {x y : H} (hxy : (x,y) ∈ (generalShiftGenerator T).graph) (t : ℝ) :
    HasDerivAt (fun s : ℝ => F ((s : ℂ)*I) x) ((-I) • F ((t : ℂ)*I) y) t := by
  let K : ℝ → H := fun u => (-I) • F ((u : ℂ)*I) y
  have hK : Continuous K := (hcont y).const_smul _
  have hone : F 1 = T 1 := by simpa using hreal 1
  have hi : Function.Injective (F 1) := hone ▸ hinj
  have hD (v : H) (s : ℝ) :
      HasDerivAt (fun u : ℝ => inner ℂ v (F (1+(u : ℂ)*I) x)) (inner ℂ v (F 1 (K s))) s := by
    have hz : 0 < (1+(s : ℂ)*I).re := by simp
    have h := orbit_interior_deriv hreal hadd hhol hxy v hz
    have hv := (h.comp (s : ℂ) (((hasDerivAt_id (s : ℂ)).mul_const I).const_add 1)).comp_ofReal
    convert hv using 1
    · rfl
    · change inner ℂ v (F 1 ((-I) • F ((s : ℂ)*I) y)) = _
      rw [hadd 1 ((s : ℂ)*I) (by simp) (by simp)]
      simp only [map_smul, inner_smul_right, one_mul, neg_mul]
      ring
  have orbit (s : ℝ) : F ((s : ℂ)*I) x =
      F 0 x + ∫ u in 0..s, K u := by
    apply hi
    apply ext_inner_left ℂ
    intro v
    let L : H →L[ℂ] ℂ := (innerSL ℂ v).comp (F 1)
    have he := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := s)
      (fun u _ => hD v u) ((L.continuous.comp hK).intervalIntegrable _ _)
    change (∫ u in 0..s, L (K u)) =
      inner ℂ v (F (1+(s : ℂ)*I) x) - inner ℂ v (F (1+(0 : ℂ)*I) x) at he
    rw [L.intervalIntegral_comp_comm (hK.intervalIntegrable _ _)] at he
    simp only [zero_mul, add_zero] at he
    rw [hadd 1 ((s : ℂ)*I) (by simp) (by simp)] at he
    change L (F ((s : ℂ)*I) x) = L (F 0 x + ∫ u in 0..s, K u)
    rw [map_add]
    have he₀ : L (F 0 x) = inner ℂ v (F 1 x) := by
      change inner ℂ v (F 1 (F 0 x)) = _
      rw [← hadd 1 0 (by simp) (by simp), add_zero]
    rw [he₀]
    change inner ℂ v (F 1 (F ((s : ℂ)*I) x)) = _
    rw [he]
    abel
  have h := (hK.integral_hasStrictDerivAt 0 t).hasDerivAt.const_add (F 0 x)
  exact h.congr_of_eventuallyEq (Filter.Eventually.of_forall orbit)

end
end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection

open scoped InnerProductSpace ComplexConjugate

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A unitary boundary evolution whose strong derivative agrees with a self-adjoint
Hamiltonian on its domain has exactly that derivative domain. -/
theorem boundary_derivative_iff {A : H →ₗ.[ℂ] H} (hA : IsSelfAdjoint A)
    (U : ℝ → H →L[ℂ] H) (h0 : ∀ x, U 0 x = x)
    (hi : ∀ t v x, ⟪U t v, U t x⟫_ℂ = ⟪v, x⟫_ℂ)
    (hd : ∀ v w, (v, w) ∈ A.graph →
      HasDerivAt (fun t ↦ U t v) ((-Complex.I) • w) 0) (x y : H) :
    HasDerivAt (fun t ↦ U t x) ((-Complex.I) • y) 0 ↔ (x, y) ∈ A.graph := by
  refine ⟨fun hx ↦ ?_, hd x y⟩
  rw [← LinearPMap.isSelfAdjoint_def.mp hA, LinearPMap.adjoint_graph_eq_graph_adjoint hA.dense_domain,
    Submodule.mem_adjoint_iff]
  intro a b hab
  have d := (hd a b hab).inner ℂ hx
  simp only [hi, h0, inner_smul_right, inner_smul_left, map_neg, Complex.conj_I, neg_neg] at d
  have e := d.unique (hasDerivAt_const (0 : ℝ) ⟪a,x⟫_ℂ)
  change ⟪b, x⟫_ℂ - ⟪a, y⟫_ℂ = 0
  apply (mul_eq_zero.mp ?_).resolve_left Complex.I_ne_zero
  linear_combination e

end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection

noncomputable section
open Set Complex
open scoped NNReal

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {q : E →L[ℂ] H} {S : ℝ≥0 → E →ₗ[ℂ] E} {T : ℝ≥0 → H →L[ℂ] H}
  {W : ℂ → H →L[ℂ] H} {U : ℝ → H ≃ₗᵢ[ℂ] H}

/-- The unitary boundary has exactly the same Hamiltonian as the positive-real
shifts. On its full domain the Schrödinger equation holds at every real time. -/
theorem HolomorphicShifts.unitaryGenerator (hW : HolomorphicShifts T W U)
    (hT : ReconstructedShifts q S T) :
    (∀ x y, (x,y) ∈ (generalShiftGenerator T).graph ↔
      HasDerivAt (fun s : ℝ => U s x) ((-I) • y) 0) ∧
    ∀ t x y, (x,y) ∈ (generalShiftGenerator T).graph →
      HasDerivAt (fun s : ℝ => U s x) ((-I) • U t y) t := by
  have hB (t : ℝ) (v : H) : W ((t : ℂ)*I) v = U t v := by
    rw [mul_comm, hW.boundary]
    rfl
  have h0 (v : H) : U 0 v = v := by
    rw [← hB, Complex.ofReal_zero, zero_mul]
    have he := DFunLike.congr_fun (hW.realTime 0) v
    simpa only [NNReal.coe_zero, Complex.ofReal_zero, hT.zero] using he
  have hd (t : ℝ) (x y : H) (hxy : (x,y) ∈ (generalShiftGenerator T).graph) :
      HasDerivAt (fun s : ℝ => U s x) ((-I) • U t y) t := by
    have hh (v x : H) : DifferentiableOn ℂ (fun z => inner ℂ v (W z x)) {z | 0 < z.re} :=
      (innerSL ℂ v).differentiable.comp_differentiableOn
        (hW.holomorphic.clm_apply (differentiableOn_const (c := x)))
    have h := boundaryOrbit_hasDerivAt hW.realTime
      (fun z w hz hw v => DFunLike.congr_fun (hW.add z w hz hw) v)
      hh (fun v => (hW.unitaryContinuous v).congr (fun t => (hB t v).symm))
      hT.injective_one hxy t
    simpa only [hB] using h
  refine ⟨?_, hd⟩
  intro x y
  apply Iff.symm
  exact boundary_derivative_iff
    (generalShiftGenerator_selfAdjoint T hT.zero hT.add hT.selfAdjoint hT.stronglyContinuous)
    (fun t => (U t).toContinuousLinearEquiv.toContinuousLinearMap) h0
    (fun t v u => (U t).inner_map_map v u)
    (fun v w hvw => by
      change HasDerivAt (fun s : ℝ => U s v) ((-I) • w) 0
      simpa only [h0] using hd 0 v w hvw) x y

end
end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection
open Set Filter
open scoped NNReal Topology
variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {q : E →L[ℂ] H} {S : ℝ≥0 → E →ₗ[ℂ] E} {T : ℝ≥0 → H →L[ℂ] H}
  {W : ℂ → H →L[ℂ] H} {U : ℝ → H ≃ₗᵢ[ℂ] H}

/-- Even among weakly holomorphic candidates, translation of the preparation labels
at strictly positive real times determines the continuation on the closed half-plane. -/
theorem HolomorphicShifts.unique (h : ReconstructedShifts q S T) (k : HolomorphicShifts T W U)
    (V : ℂ → H →L[ℂ] H)
    (hd : ∀ a b, DifferentiableOn ℂ (fun z => inner ℂ a (V z b)) {z | 0 < z.re})
    (hc : ∀ a b, ContinuousOn (fun z => inner ℂ a (V z b)) {z | 0 ≤ z.re})
    (hv : ∀ (s : ℝ≥0), 0 < s → ∀ x, V (s : ℝ) (q x) = q (S s x)) :
    EqOn V W {z | 0 ≤ z.re} := by
  have hr (s : ℝ≥0) (hs : 0 < s) : V (s : ℝ) = W (s : ℝ) :=
    (h.unique s _ (hv s hs)).trans (k.realTime s).symm
  intro z hz
  ext b : 1
  apply ext_inner_left ℂ
  intro a
  let L := (innerSL ℂ a).comp (ContinuousLinearMap.apply ℂ H b)
  exact Extension.halfplane_eqOn_of_real _ _ (hd a b)
    (L.differentiable.comp_differentiableOn k.holomorphic) (hc a b)
    (continuousOn_const.inner (k.stronglyContinuous b))
    (fun r hr' => congrArg L (hr ⟨r,hr'.le⟩ hr')) hz

omit [CompleteSpace H] in
/-- Norm convergence to the unitary at every point of the imaginary axis,
for arbitrary approaches inside the closed half-plane. -/
theorem HolomorphicShifts.strong_boundary (k : HolomorphicShifts T W U) (t : ℝ) (x : H) :
    Tendsto (fun z => W z x) (𝓝[{z : ℂ | 0 ≤ z.re}] (Complex.I * t)) (𝓝 (U t x)) := by
  have hlim := k.stronglyContinuous x (Complex.I * t) (show 0 ≤ (Complex.I * (t : ℂ)).re by simp)
  simpa [ContinuousWithinAt, k.boundary] using hlim

end DotProduct.GeneralReflection


/-! ### Reconstruction from the original smeared readings -/

namespace DotProduct.GeneralReflection

open MeasureTheory Set Filter
open scoped ENNReal NNReal Topology

/-- Coordinatewise convergence in probability gives joint convergence for any finite list. -/
private theorem tendstoInMeasure_finite_readings {Ω I J : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] [Fintype I] (X : J → Ω → I → ℝ)
    (Y : Ω → I → ℝ) {l : Filter J}
    (h : ∀ i, TendstoInMeasure μ (fun t ω ↦ X t ω i) l (fun ω ↦ Y ω i)) :
    TendstoInMeasure μ X l Y := by
  classical
  apply tendstoInMeasure_iff_dist.mpr
  intro ε hε
  have he (t : J) : {ω | ε ≤ dist (X t ω) (Y ω)} =
      ⋃ i, {ω | ε ≤ dist (X t ω i) (Y ω i)} := by
    ext ω
    simp only [mem_ofPred_eq, mem_iUnion, ← not_lt, dist_pi_lt_iff hε, not_forall]
  have ht := tendsto_finsetSum Finset.univ (fun i _ ↦ tendstoInMeasure_iff_dist.mp (h i) ε hε)
  simp only [Finset.sum_const_zero] at ht
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ht (fun _ ↦ zero_le)
  intro t
  change μ {ω | ε ≤ dist (X t ω) (Y ω)} ≤ _
  rw [he]
  exact measure_iUnion_fintype_le μ _

/-- Every bounded continuous function of a finite list of stochastically continuous
readings has a continuous L² orbit. The readings may have infinite second moments. -/
theorem stochastic_cylinder_continuous {Ω I : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] [Fintype I] (X : ℝ≥0 → Ω → I → ℝ)
    (hX : ∀ t i, TendstoInMeasure μ (fun s ω ↦ X s ω i) (𝓝 t) (fun ω ↦ X t ω i))
    (φ : (I → ℝ) → ℂ) (hφ : Continuous φ) (M : ℝ) (hM : ∀ v, ‖φ v‖ ≤ M)
    (Z : ℝ≥0 → Lp ℂ 2 μ) (hZ : ∀ t, ⇑(Z t) =ᵐ[μ] φ ∘ X t) : Continuous Z := by
  apply continuous_iff_seqContinuous.mpr
  intro seq t hseq
  apply tendsto_of_subseq_tendsto
  intro ns hns
  have hsub := (tendstoInMeasure_finite_readings X (X t) (hX t)).comp (hseq.comp hns)
  obtain ⟨ms, _, hms⟩ := hsub.exists_seq_tendsto_ae
  refine ⟨ms, ?_⟩
  let k := fun n ↦ seq (ns (ms n))
  have hae : ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Z (k n) ω) atTop (𝓝 (Z t ω)) := by
    filter_upwards [hms, ae_all_iff.mpr (fun n ↦ hZ (k n)), hZ t] with ω hω hall ht
    simp only [hall, ht, Function.comp_apply]
    exact (hφ.tendsto _).comp hω
  have hmeas (n : ℕ) := (Lp.aestronglyMeasurable (Z (k n)))
  have hbound := unifIntegrable_const (ι := ℕ) (by norm_num : 1 ≤ (2 : ℝ≥0∞))
    (by norm_num : (2 : ℝ≥0∞) ≠ ∞) (memLp_const (μ := μ) (M : ℂ))
  have hUI : UnifIntegrable (fun n ω ↦ Z (k n) ω) 2 μ := hbound.ae_mono hmeas (fun n ↦ by
    filter_upwards [hZ (k n)] with ω he
    change ‖Z (k n) ω‖ₑ ≤ ‖(M : ℂ)‖ₑ
    rw [enorm_le_iff_norm_le, he, Complex.norm_real]
    exact (hM _).trans (le_abs_self _))
  exact (Lp.tendsto_Lp_iff_tendsto_eLpNorm' _ _).mpr
    (tendsto_Lp_finite_of_tendsto_ae (by norm_num) (by norm_num) hmeas (Lp.memLp _) hUI hae)

end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection
open MeasureTheory Set Filter BoundedContinuousFunction
open scoped NNReal Topology
noncomputable section

/-- Stochastic continuity of the individual readings generating the positive-side
σ-algebra suffices, including laws for which the readings have no second moments. -/
theorem preparationShift_continuous_of_stochastic_readings {Ω ι : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {θ : Ω → Ω} (o : Ω → ι → ℝ) (ho : Measurable o)
    (D : StationaryShifts (MeasurableSpace.comap o inferInstance) μ θ)
    (hc : ∀ t i, TendstoInMeasure μ (fun s ω ↦ o (D.shift s ω) i) (𝓝 t)
      (fun ω ↦ o (D.shift t ω) i))
    (X : lpMeas ℂ ℂ (MeasurableSpace.comap o inferInstance) 2 μ) :
    Continuous (fun s => D.preparationShift s X) := by
  classical
  let P := μ.map o
  let e := Extension.observationL2 μ o ho
  let C := DotChar.cylinderPhases ι
  let z := C.phaseLp P
  let j := fun t => e (z t)
  have hd : Dense (Submodule.span ℂ (range z) : Set (Lp ℂ 2 P)) :=
    Submodule.dense_iff_topologicalClosure_eq_top.mpr (DotChar.cylinderPhases_total P)
  have htotal : Dense (Submodule.span ℂ (range j) : Set (lpMeas ℂ ℂ (MeasurableSpace.comap o inferInstance) 2 μ)) := by
    have hm := e.surjective.denseRange.dense_image e.continuous hd
    change Dense (e.toLinearEquiv.toLinearMap '' (Submodule.span ℂ (range z) : Set (Lp ℂ 2 P))) at hm
    rw [← Submodule.map_coe, Submodule.map_span, ← range_comp] at hm
    exact hm
  apply stationary_orbit_continuous_of_total j htotal _ D.preparationShift_norm _ X
  intro t
  let I := t.1
  let L := t.2
  apply continuous_induced_rng.mpr
  apply stochastic_cylinder_continuous (fun s ω ↦ I.restrict (o (D.shift s ω)))
    (fun s i ↦ hc s (i : ι)) (probCharDual L) (probCharDual L).continuous 1
    (fun v ↦ by simp [probCharDual_apply])
  intro s
  have hz : ⇑(j t).1 =ᵐ[μ] C.phase t ∘ o :=
    (Extension.observationL2_ae μ o ho (z t)).trans
      ((show MeasurePreserving o μ P from ⟨ho, rfl⟩).quasiMeasurePreserving.ae_eq_comp
        (C.phaseLp_ae (μ := P) t))
  exact (Lp.coeFn_compMeasurePreserving (j t).1 (D.stationary s)).trans
    ((D.stationary s).quasiMeasurePreserving.ae_eq_comp hz)

/-- L²-continuous smeared readings are a sufficient special case. -/
theorem preparationShift_continuous_of_readings {Ω ι : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {θ : Ω → Ω} (o : Ω → ι → ℝ) (ho : Measurable o)
    (D : StationaryShifts (MeasurableSpace.comap o inferInstance) μ θ)
    (h₂ : ∀ i, MemLp (fun ω => o ω i) 2 μ)
    (hc : ∀ i, Continuous (fun s => Lp.compMeasurePreserving _ (D.stationary s) ((h₂ i).toLp _)))
    (X : lpMeas ℂ ℂ (MeasurableSpace.comap o inferInstance) 2 μ) :
    Continuous (fun s => D.preparationShift s X) := by
  have hae (s : ℝ≥0) (i : ι) :
      ⇑(Lp.compMeasurePreserving _ (D.stationary s) ((h₂ i).toLp _)) =ᵐ[μ]
        (fun ω ↦ o (D.shift s ω) i) :=
    (Lp.coeFn_compMeasurePreserving _ _).trans
      ((D.stationary s).quasiMeasurePreserving.ae_eq_comp (h₂ i).coeFn_toLp)
  exact preparationShift_continuous_of_stochastic_readings o ho D
    (fun t i ↦ (tendstoInMeasure_of_tendsto_Lp ((hc i).tendsto t)).congr
      (fun s ↦ hae s i) (hae t i)) X

end
end DotProduct.GeneralReflection


namespace DotProduct.GeneralReflection
open MeasureTheory Set
open scoped NNReal
noncomputable section

/-- The reconstructed real and complex times, their common Hamiltonian, and the exact
domain of the unitary derivative, all on the Hilbert space generated by the labels. -/
def HasMeasuredEvolution {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (q : E →L[ℂ] H) (S : ℝ≥0 → E →ₗ[ℂ] E) : Prop :=
  ∃ (T : ℝ≥0 → H →L[ℂ] H) (W : ℂ → H →L[ℂ] H) (U : ℝ → H ≃ₗᵢ[ℂ] H),
    ReconstructedShifts q S T ∧ HolomorphicShifts T W U ∧
    Dense ((generalShiftGenerator T).domain : Set H) ∧ IsSelfAdjoint (generalShiftGenerator T) ∧
    (∀ x y, (x,y) ∈ (generalShiftGenerator T).graph → 0 ≤ (inner ℂ x y).re) ∧
    (∀ x y, (x,y) ∈ (generalShiftGenerator T).graph ↔
      HasDerivAt (fun t : ℝ => U t x) ((-Complex.I) • y) 0) ∧
    (∀ t x y, (x,y) ∈ (generalShiftGenerator T).graph →
      HasDerivAt (fun s : ℝ => U s x) ((-Complex.I) • U t y) t)

/-- The general evolution of §4 from conditional independence, plane-fixing reflection,
stationary reversible sample shifts and continuity on a total family of preparations. -/
theorem measured_evolution {Ω : Type*} {plane neg plus : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {θ : Ω → Ω}
    (h₀ : plane ≤ mΩ) (hn : neg ≤ mΩ) (hp : plus ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg plus) (hθ : MeasurePreserving θ μ μ)
    (hswap : Measurable[neg, plus] θ) (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (D : StationaryShifts plus μ θ) {I : Type*} (j : I → lpMeas ℂ ℂ plus 2 μ)
    (htotal : Dense (Submodule.span ℂ (range j) : Set (lpMeas ℂ ℂ plus 2 μ)))
    (hcont : ∀ i, Continuous (fun s => D.preparationShift s (j i))) :
    HasMeasuredEvolution (H := ↥(stateSpace plus μ h₀)) (stateLabel plus μ h₀) D.preparationShift := by
  obtain ⟨T,hT,hd,hA,hp⟩ := measured_shift_reconstruction h₀ hn hp hind hθ hswap hfix D j htotal hcont
  obtain ⟨W,U,hW⟩ := hT.holomorphicShifts
  exact ⟨T,W,U,hT,hW,hd,hA,hp,hW.unitaryGenerator hT⟩

/-- Stochastic continuity of the real readings generating the positive half suffices for
the full evolution, even when the individual readings have no second moments. -/
theorem evolution_of_stochastic_readings {Ω ι : Type*} {plane neg : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {θ : Ω → Ω} (o : Ω → ι → ℝ) (ho : Measurable o)
    (h₀ : plane ≤ mΩ) (hn : neg ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg (MeasurableSpace.comap o inferInstance))
    (hθ : MeasurePreserving θ μ μ) (hswap : Measurable[neg, MeasurableSpace.comap o inferInstance] θ)
    (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (D : StationaryShifts (MeasurableSpace.comap o inferInstance) μ θ)
    (hc : ∀ t i, TendstoInMeasure μ (fun s ω => o (D.shift s ω) i) (nhds t)
      (fun ω => o (D.shift t ω) i)) :
    HasMeasuredEvolution (H := ↥(stateSpace (MeasurableSpace.comap o inferInstance) μ h₀))
      (stateLabel (MeasurableSpace.comap o inferInstance) μ h₀) D.preparationShift := by
  apply measured_evolution h₀ hn ho.comap_le hind hθ hswap hfix D id
  · simp
  · exact preparationShift_continuous_of_stochastic_readings o ho D hc

/-- For a positive half generated by real L² readings it suffices to check continuity
on the individual smeared readings, with the law and shifts in their original sample space. -/
theorem evolution_of_smeared_readings {Ω ι : Type*} {plane neg : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {θ : Ω → Ω} (o : Ω → ι → ℝ) (ho : Measurable o)
    (h₀ : plane ≤ mΩ) (hn : neg ≤ mΩ)
    (hind : ObservedCondIndep μ plane neg (MeasurableSpace.comap o inferInstance))
    (hθ : MeasurePreserving θ μ μ) (hswap : Measurable[neg, MeasurableSpace.comap o inferInstance] θ)
    (hfix : ∀ s, MeasurableSet[plane] s → θ ⁻¹' s =ᵐ[μ] s)
    (D : StationaryShifts (MeasurableSpace.comap o inferInstance) μ θ)
    (h₂ : ∀ i, MemLp (fun ω => o ω i) 2 μ)
    (hc : ∀ i, Continuous (fun s => Lp.compMeasurePreserving _ (D.stationary s) ((h₂ i).toLp _))) :
    HasMeasuredEvolution (H := ↥(stateSpace (MeasurableSpace.comap o inferInstance) μ h₀))
      (stateLabel (MeasurableSpace.comap o inferInstance) μ h₀) D.preparationShift := by
  apply measured_evolution h₀ hn ho.comap_le hind hθ hswap hfix D id
  · simp
  · exact preparationShift_continuous_of_readings o ho D h₂ hc

end
end DotProduct.GeneralReflection
