/-- The real member of the rotation family as an orthogonal transformation on the
original Euclidean reading coordinates. -/
noncomputable def normalRotationIsometry {d : ℕ} (u : MassShell.Space d) (hu : ‖u‖ = 1)
    (θ : ℝ) : MassShell.Space (d+1) ≃ₗᵢ[ℝ] MassShell.Space (d+1) := by
  let S := (MassShell.splitIsometry d).toLinearEquiv.trans
    (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ (MassShell.Space d)).toLinearEquiv
  let E := ContinuousLinearMap.fst ℝ ℝ (MassShell.Space d)
  let K := ContinuousLinearMap.snd ℝ ℝ (MassShell.Space d)
  let X := (innerSL ℝ u).comp K
  let A := (Real.cos θ • E + Real.sin θ • X).prod
    (K + ((Real.cos θ - 1) • X - Real.sin θ • E).smulRight u)
  let T := S.symm.toLinearMap.comp (A.toLinearMap.comp S.toLinearMap)
  let L : MassShell.Space (d+1) →ₗᵢ[ℝ] MassShell.Space (d+1) :=
    { toLinearMap := T
      norm_map' := fun p ↦ by
        apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
        rw [MassShell.split_norm_sq (T p),MassShell.split_norm_sq p]
        change (S (S.symm (A (S p)))).1^2 + ‖(S (S.symm (A (S p)))).2‖^2 = (S p).1^2 + ‖(S p).2‖^2
        rw [S.apply_symm_apply]
        exact normalPlaneRotation_norm_sq u hu θ (S p) }
  exact L.toLinearIsometryEquiv rfl

theorem normalRotationIsometry_split {d : ℕ} (u : MassShell.Space d) (hu : ‖u‖ = 1)
    (θ : ℝ) (p : MassShell.Space (d+1)) :
    MassShell.split d (normalRotationIsometry u hu θ p) = normalPlaneRotation u θ (MassShell.split d p) :=
  (MassShell.split d).apply_symm_apply _

/-- The real normal rotation is a symmetry of the same measured Euclidean law. -/
theorem massiveEuclideanLaw_normal_rotation {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (u : MassShell.Space d) (hu : ‖u‖ = 1) (θ : ℝ) :
    (massiveEuclideanLaw (d+1) ħ m hħ hm).map
      (fun x f ↦ x (euclideanAffineSchwartz (normalRotationIsometry u hu θ) 0 f)) =
      massiveEuclideanLaw (d+1) ħ m hħ hm :=
  massiveEuclideanLaw_affine_invariant hħ hm _ _

end DotProduct.Extension


namespace DotProduct.Extension
open MeasureTheory Set Filter
open scoped Topology InnerProductSpace

private theorem attenuation_norm_le {z : ℂ} {a : ℝ} (hz : 0 ≤ z.re) (ha : 0 ≤ a) :
    ‖Complex.exp (-z * (a : ℂ))‖ ≤ 1 := by
  rw [Complex.norm_exp, Real.exp_le_one_iff]
  simpa using (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hz) ha)

private theorem laplace_integral_regular {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (e : X → ℝ) (he : Measurable e) (hn : ∀ k, 0 ≤ e k)
    (b : X → ℂ) (hb : Integrable b μ) :
    DifferentiableOn ℂ (fun z : ℂ ↦ ∫ k, Complex.exp (-z * (e k : ℂ)) * b k ∂μ)
        {z | 0 < z.re} ∧
    ContinuousOn (fun z : ℂ ↦ ∫ k, Complex.exp (-z * (e k : ℂ)) * b k ∂μ)
        {z | 0 ≤ z.re} := by
  let F (z : ℂ) (k : X) := Complex.exp (-z * (e k : ℂ)) * b k
  have hm (z : ℂ) : AEStronglyMeasurable (F z) μ :=
    ((Complex.continuous_exp.measurable.comp
      (measurable_const.mul (Complex.continuous_ofReal.measurable.comp he))).aestronglyMeasurable).mul
      hb.aestronglyMeasurable
  have hle (z : ℂ) (hz : 0 ≤ z.re) (k : X) : ‖F z k‖ ≤ ‖b k‖ := by
    change ‖Complex.exp _ * _‖ ≤ _
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (attenuation_norm_le hz (hn k))
  constructor
  · intro z hz
    change 0 < z.re at hz
    let c := z.re / 2
    have hc : 0 < c := half_pos hz
    have hs : {w : ℂ | c < w.re} ∈ 𝓝 z :=
      (isOpen_lt continuous_const Complex.continuous_re).mem_nhds (half_lt_self hz)
    let F' (w : ℂ) (k : X) := F w k * (-(e k : ℂ))
    have hd (w : ℂ) (k : X) : HasDerivAt (fun v ↦ F v k) (F' w k) w := by
      have h := (((hasDerivAt_id w).neg.mul_const (e k : ℂ)).cexp.mul_const (b k))
      convert h using 1
      · rfl
      · dsimp [F', F]
        ring
    have hdm : AEStronglyMeasurable (F' z) μ :=
      (hm z).mul (Complex.continuous_ofReal.measurable.comp he).neg.aestronglyMeasurable
    have hdl (w : ℂ) (hw : c < w.re) (k : X) :
        ‖F' w k‖ ≤ c⁻¹ * ‖b k‖ := by
      have hec : c * e k ≤ Real.exp (w.re * e k) :=
        (mul_le_mul_of_nonneg_right hw.le (hn k)).trans
          (by linarith [Real.add_one_le_exp (w.re * e k)])
      have hprod : Real.exp (-w.re * e k) * e k ≤ c⁻¹ := by
        rw [neg_mul, Real.exp_neg, inv_mul_eq_div, ← one_div,
          div_le_div_iff₀ (Real.exp_pos _) hc, one_mul, mul_comm]
        exact hec
      dsimp only [F', F]
      rw [norm_mul, norm_mul, Complex.norm_exp, norm_neg, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg (hn k)]
      simpa [mul_left_comm, mul_assoc, mul_comm] using mul_le_mul_of_nonneg_right hprod (norm_nonneg (b k))
    exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le (F := F) (F' := F')
      hs (Eventually.of_forall hm) (hb.norm.mono' (hm z) (ae_of_all _ (hle z hz.le)))
      hdm (ae_of_all _ (fun k w hw ↦ hdl w hw k)) (hb.norm.const_mul _)
      (ae_of_all _ (fun k w _ ↦ hd w k))).2.differentiableAt.differentiableWithinAt
  · apply continuousOn_of_dominated (F := F) (fun z _ ↦ hm z)
      (fun z hz ↦ ae_of_all _ (hle z hz)) hb.norm
    exact ae_of_all _ fun k ↦ by dsimp [F]; fun_prop

section ComplexFockEvolution
variable {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ]
    (ω : X → ℝ) (hω : Measurable ω) (hn : ∀ k, 0 ≤ ω k)

/-- Complex time on Fock space, defined on the closed right half-plane by composing
the Euclidean contraction at the real part with the unitary at the imaginary part. -/
noncomputable def fockComplexTime (z : ℂ) : momentumFock μ →L[ℂ] momentumFock μ :=
  (fockShift μ ω hω hn (max z.re 0) (le_max_right _ _)).comp (fockUnitary μ ω hω z.im)

theorem fockComplexTime_real (s : ℝ) (hs : 0 ≤ s) :
    fockComplexTime μ ω hω hn (s : ℂ) = fockShift μ ω hω hn s hs := by
  simp [fockComplexTime, max_eq_left hs, fockUnitary_zero]

theorem fockComplexTime_imag (t : ℝ) :
    fockComplexTime μ ω hω hn (Complex.I * t) = fockUnitary μ ω hω t := by
  simp [fockComplexTime, fockShift_zero]

theorem fockComplexTime_sector_ae (z : ℂ) (hz : 0 ≤ z.re) (ψ : momentumFock μ) (n : ℕ) :
    ((fockComplexTime μ ω hω hn z ψ n).1 : (Fin n → X) → ℂ) =ᵐ[MomentumFock.powerMeasure μ n]
      fun k ↦ Complex.exp (-z * ((∑ i : Fin n, ω (k i) : ℝ) : ℂ)) * (ψ n).1 k := by
  simp only [fockComplexTime, ContinuousLinearMap.comp_apply]
  filter_upwards [fockShift_apply_sector_ae μ ω hω hn (max z.re 0) (le_max_right _ _)
    (fockUnitary μ ω hω z.im ψ) n, fockUnitary_apply_sector_ae μ ω hω z.im ψ n] with k h₁ h₂
  rw [h₁, h₂, ← mul_assoc, Complex.ofReal_exp, ← Complex.exp_add, max_eq_left hz]
  congr 2
  push_cast
  nth_rw 3 [← Complex.re_add_im z]
  ring

/-- All mixed coefficients of the Fock evolution are holomorphic inside and continuous
up to the imaginary axis. The sector integrals and their sum are dominated independently
of complex time on the closed half-plane. -/
theorem fockComplexTime_weak_regular (φ ψ : momentumFock μ) :
    DifferentiableOn ℂ (fun z ↦ inner ℂ φ (fockComplexTime μ ω hω hn z ψ)) {z | 0 < z.re} ∧
    ContinuousOn (fun z ↦ inner ℂ φ (fockComplexTime μ ω hω hn z ψ)) {z | 0 ≤ z.re} := by
  let E (n : ℕ) (k : Fin n → X) := ∑ i, ω (k i)
  let b (n : ℕ) (k : Fin n → X) := inner ℂ ((φ n).1 k) ((ψ n).1 k)
  let a (n : ℕ) (z : ℂ) := ∫ k, Complex.exp (-z * (E n k : ℂ)) * b n k
      ∂MomentumFock.powerMeasure μ n
  have hreg (n : ℕ) : DifferentiableOn ℂ (a n) {z | 0 < z.re} ∧
      ContinuousOn (a n) {z | 0 ≤ z.re} :=
    laplace_integral_regular (E n) (Finset.measurable_sum _ fun i _ ↦ hω.comp (measurable_pi_apply i))
      (fun k ↦ Finset.sum_nonneg (fun i _ ↦ hn (k i))) (b n) (L2.integrable_inner (φ n).1 (ψ n).1)
  let T := fockComplexTime μ ω hω hn
  have heq (n : ℕ) (z : ℂ) (hz : 0 ≤ z.re) :
      inner ℂ (φ n) (T z ψ n) = a n z := by
    change inner ℂ (φ n).1 (T z ψ n).1 = _
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [fockComplexTime_sector_ae μ ω hω hn z hz ψ n] with k hk
    change inner ℂ _ ((fockComplexTime μ ω hω hn z ψ n).1 k) = _
    rw [hk]
    simp only [b, E, RCLike.inner_apply]
    ring
  have hb (n : ℕ) (z : ℂ) (hz : 0 ≤ z.re) : ‖a n z‖ ≤ ‖φ n‖ * ‖ψ n‖ := by
    have hnorm : ‖(T z ψ n).1‖ ≤ ‖(ψ n).1‖ := by
      apply Lp.norm_le_norm_of_ae_le
      filter_upwards [fockComplexTime_sector_ae μ ω hω hn z hz ψ n] with k hk
      change ‖(fockComplexTime μ ω hω hn z ψ n).1 k‖ ≤ _
      rw [hk, norm_mul]
      exact mul_le_of_le_one_left (norm_nonneg _)
        (attenuation_norm_le hz (Finset.sum_nonneg (fun i _ ↦ hn (k i))))
    rw [← heq n z hz]
    exact (norm_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_left hnorm (norm_nonneg _))
  have hsum : Summable (fun n ↦ ‖φ n‖ * ‖ψ n‖) :=
    lp.summable_mul (by norm_num; exact Real.HolderConjugate.two_two) φ ψ
  have hf (z : ℂ) (hz : 0 ≤ z.re) :
      inner ℂ φ (T z ψ) = ∑' n, a n z := by
    rw [lp.inner_eq_tsum]
    exact tsum_congr fun n ↦ heq n z hz
  exact ⟨(Complex.differentiableOn_tsum_of_summable_norm hsum (fun n ↦ (hreg n).1)
      (isOpen_lt continuous_const Complex.continuous_re) (fun n z hz ↦ hb n z hz.le)).congr
      (fun z hz ↦ hf z hz.le),
    (continuousOn_tsum (fun n ↦ (hreg n).2) hsum hb).congr (fun z hz ↦ hf z hz)⟩

end ComplexFockEvolution

/-- The scalar boundary uniqueness theorem also determines all translates of that
boundary, hence the entire closed half-plane. -/
private theorem halfplane_eqOn_of_real (F G : ℂ → ℂ)
    (hFd : DifferentiableOn ℂ F {z | 0 < z.re}) (hGd : DifferentiableOn ℂ G {z | 0 < z.re})
    (hFc : ContinuousOn F {z | 0 ≤ z.re}) (hGc : ContinuousOn G {z | 0 ≤ z.re})
    (hpos : ∀ s : ℝ, 0 < s → F (s : ℂ) = G (s : ℂ)) :
    EqOn F G {z | 0 ≤ z.re} := by
  intro z hz
  let τ (w : ℂ) := w + (z.re : ℂ)
  have hd : Differentiable ℂ τ := differentiable_id.add_const _
  have hopen : MapsTo τ {w | 0 < w.re} {w | 0 < w.re} := fun w hw ↦ by
    change 0 < w.re + z.re
    exact add_pos_of_pos_of_nonneg hw hz
  have hclosed : MapsTo τ {w | 0 ≤ w.re} {w | 0 ≤ w.re} := fun w hw ↦ by
    change 0 ≤ w.re + z.re
    exact add_nonneg hw hz
  have h := unique_halfplane_continuation (F ∘ τ) (G ∘ τ)
    (hFd.comp hd.differentiableOn hopen) (hGd.comp hd.differentiableOn hopen)
    (hFc.comp hd.continuous.continuousOn hclosed) (hGc.comp hd.continuous.continuousOn hclosed)
    (fun s hs ↦ by
      simpa only [Function.comp_apply, τ, ← Complex.ofReal_add] using
        hpos (s + z.re) (add_pos_of_pos_of_nonneg hs hz)) z.im
  simpa only [Function.comp_apply, τ, mul_comm Complex.I, add_comm _ (z.re : ℂ), Complex.re_add_im] using h

private theorem strong_limit_of_contraction {H Z : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    {l : Filter Z} (F : Z → H) (v : H)
    (hn : ∀ z, ‖F z‖ ≤ ‖v‖)
    (hweak : Tendsto (fun z ↦ inner ℂ v (F z)) l (𝓝 (inner ℂ v v))) :
    Tendsto F l (𝓝 v) := by
  have hreal : Tendsto (fun z ↦ (inner ℂ v (F z)).re) l (𝓝 (‖v‖ ^ 2)) := by
    have h : Tendsto (fun z ↦ (inner ℂ v (F z)).re) l (𝓝 (inner ℂ v v).re) :=
      Complex.continuous_re.continuousAt.tendsto.comp hweak
    exact (norm_sq_eq_re_inner (𝕜 := ℂ) v).symm ▸ h
  have hsq : Tendsto (fun z ↦ ‖v - F z‖ ^ 2)
      l (𝓝 0) := by
    refine squeeze_zero (fun _ ↦ sq_nonneg _) (fun z ↦ show ‖v - F z‖ ^ 2 ≤
      2 * ‖v‖ ^ 2 - 2 * (inner ℂ v (F z)).re from ?_) ?_
    · rw [norm_sub_sq (𝕜 := ℂ), RCLike.re_to_complex]
      linarith [sq_le_sq' (by linarith [norm_nonneg (F z), norm_nonneg v]) (hn z)]
    · have hl := (tendsto_const_nhds (x := (2 : ℝ) * ‖v‖ ^ 2)).sub (hreal.const_mul 2)
      convert hl using 2
      ring
  rw [tendsto_iff_dist_tendsto_zero]
  simpa [Function.comp_def, dist_eq_norm, norm_sub_rev, Real.sqrt_sq] using
    (Real.continuous_sqrt.tendsto 0).comp hsq


section MeasuredComplexTime

set_option maxHeartbeats 1800000
set_option synthInstance.maxHeartbeats 160000

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
local notation "H" => Lp ℂ 2 (massiveSpatialLaw d hħ.le hm)
local notation "vol" => (volume : Measure (MassShell.Space d))

/-- Complex normal displacement acting on the actual conditional plane-law Hilbert space. -/
noncomputable def massiveSpatialComplexTime (z : ℂ) : H →L[ℂ] H :=
  let U := massiveSpatialFockUnitary d hħ hm
  U.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
    ((fockComplexTime vol (modeDispersion m) (modeDispersion_measurable m)
      (fun _ ↦ Real.sqrt_nonneg _) z).comp U.toContinuousLinearEquiv.toContinuousLinearMap)

/-- Real-time Schrödinger evolution transported by the label-preserving Fock identification. -/
noncomputable def massiveSpatialUnitary (t : ℝ) : H ≃ₗᵢ[ℂ] H :=
  let U := massiveSpatialFockUnitary d hħ hm
  (U.trans (fockUnitaryEquiv vol (modeDispersion m) (modeDispersion_measurable m) t)).trans U.symm

theorem massiveSpatialComplexTime_real (s : ℝ) (hs : 0 ≤ s) :
    massiveSpatialComplexTime d hħ hm (s : ℂ) = massiveSpatialShift d hħ hm s hs := by
  let U := massiveSpatialFockUnitary d hħ hm
  exact congrArg (fun A : momentumFock vol →L[ℂ] momentumFock vol ↦
    U.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
      (A.comp U.toContinuousLinearEquiv.toContinuousLinearMap))
    (fockComplexTime_real vol (modeDispersion m) (modeDispersion_measurable m) (fun _ ↦ Real.sqrt_nonneg _) s hs)

theorem massiveSpatialComplexTime_imag (t : ℝ) :
    massiveSpatialComplexTime d hħ hm (Complex.I * t) =
      (massiveSpatialUnitary d hħ hm t).toLinearIsometry.toContinuousLinearMap := by
  let U := massiveSpatialFockUnitary d hħ hm
  ext ψ : 1
  exact congrArg (fun A : momentumFock vol →L[ℂ] momentumFock vol ↦ U.symm (A (U ψ)))
    (fockComplexTime_imag vol (modeDispersion m) (modeDispersion_measurable m) (fun _ ↦ Real.sqrt_nonneg _) t)

theorem massiveSpatialComplexTime_weak_regular (φ ψ : H) :
    DifferentiableOn ℂ (fun z ↦ inner ℂ φ (massiveSpatialComplexTime d hħ hm z ψ)) {z | 0 < z.re} ∧
    ContinuousOn (fun z ↦ inner ℂ φ (massiveSpatialComplexTime d hħ hm z ψ)) {z | 0 ≤ z.re} := by
  let U := massiveSpatialFockUnitary d hħ hm
  have heq (z : ℂ) : inner ℂ φ (massiveSpatialComplexTime d hħ hm z ψ) =
      inner ℂ (U φ) (fockComplexTime vol (modeDispersion m) (modeDispersion_measurable m)
        (fun _ ↦ Real.sqrt_nonneg _) z (U ψ)) := by
    exact (U.inner_map_eq_flip φ _).symm
  simpa only [heq] using fockComplexTime_weak_regular vol (modeDispersion m) (modeDispersion_measurable m)
    (fun _ ↦ Real.sqrt_nonneg _) (U φ) (U ψ)

/-- At imaginary time the whole vector converges in norm from the closed
half-plane to the real-time unitary orbit. -/
theorem massiveSpatialComplexTime_strong_boundary (t : ℝ) (ψ : H) :
    Tendsto (fun z ↦ massiveSpatialComplexTime d hħ hm z ψ)
      (𝓝[{z : ℂ | 0 ≤ z.re}] (Complex.I * t)) (𝓝 (massiveSpatialUnitary d hħ hm t ψ)) := by
  let U := massiveSpatialFockUnitary d hħ hm
  let T := massiveSpatialComplexTime d hħ hm
  let v := massiveSpatialUnitary d hħ hm t ψ
  have hn (z : ℂ) : ‖T z ψ‖ ≤ ‖v‖ := by
    let S := fockShift vol (modeDispersion m) (modeDispersion_measurable m)
      (fun _ ↦ Real.sqrt_nonneg _) (max z.re 0) (le_max_right _ _)
    let W := fockUnitary vol (modeDispersion m) (modeDispersion_measurable m) z.im
    change ‖U.symm (S (W (U ψ)))‖ ≤ ‖massiveSpatialUnitary d hħ hm t ψ‖
    rw [U.symm.norm_map, LinearIsometryEquiv.norm_map]
    calc
      ‖S (W (U ψ))‖ ≤ ‖S‖ * ‖W (U ψ)‖ := S.le_opNorm _
      _ ≤ 1 * ‖W (U ψ)‖ := mul_le_mul_of_nonneg_right (fockShift_norm_le _ _ _ _ _ _) (norm_nonneg _)
      _ = ‖ψ‖ := by rw [one_mul, fockUnitary_norm, U.norm_map]
  have hweak := (massiveSpatialComplexTime_weak_regular d hħ hm v ψ).2 _
      (show Complex.I * (t : ℂ) ∈ {z : ℂ | 0 ≤ z.re} by simp)
  have hval : T (Complex.I * t) ψ = v :=
    DFunLike.congr_fun (massiveSpatialComplexTime_imag d hħ hm t) ψ
  apply strong_limit_of_contraction (fun z ↦ T z ψ) v hn
  change Tendsto (fun z ↦ inner ℂ v (T z ψ)) _ (𝓝 (inner ℂ v (T (Complex.I * t) ψ))) at hweak
  rwa [hval] at hweak

/-- Weak holomorphy, weak continuity up to the boundary, and the translated original Wick
preparations determine the operator everywhere on the closed right half-plane. -/
theorem massiveSpatialComplexTime_unique (T : ℂ → H →L[ℂ] H)
    (hd : ∀ φ ψ : H, DifferentiableOn ℂ (fun z ↦ inner ℂ φ (T z ψ)) {z | 0 < z.re})
    (hc : ∀ φ ψ : H, ContinuousOn (fun z ↦ inner ℂ φ (T z ψ)) {z | 0 ≤ z.re})
    (hw : ∀ (s : ℝ) (hs : 0 < s) (f : positiveSchwartz d), T (s : ℂ)
      (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
      conditionedMassivePreparation d hħ.le hm
        (massiveWickPreparation d hħ hm (shiftPositiveTest s hs.le f))) :
    EqOn T (massiveSpatialComplexTime d hħ hm) {z | 0 ≤ z.re} := by
  have hr (s : ℝ) (hs : 0 < s) : T (s : ℂ) = massiveSpatialComplexTime d hħ hm (s : ℂ) :=
    (massiveSpatialShift_unique d hħ hm s hs.le _ (hw s hs)).trans
      (massiveSpatialComplexTime_real d hħ hm s hs.le).symm
  intro z hz
  ext ψ : 1
  apply ext_inner_left ℂ
  intro φ
  obtain ⟨hd',hc'⟩ := massiveSpatialComplexTime_weak_regular d hħ hm φ ψ
  exact halfplane_eqOn_of_real _ _ (hd φ ψ) hd' (hc φ ψ) hc'
    (fun s hs ↦ by rw [hr s hs]) hz

end MeasuredComplexTime

end DotProduct.Extension


/-! ### The differentiated plane field and the maximal coordinate multiplication domain -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap Topology ComplexConjugate

set_option maxHeartbeats 1500000
set_option synthInstance.maxHeartbeats 100000

section FiniteField

variable {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ]

/-- For each finite-particle vector, the Hermitian field depends continuously and
real-linearly on its one-particle label. -/
noncomputable def fieldLabelOnFinite (ψ : FiniteParticleFock μ) :
    Lp ℂ 2 μ →L[ℝ] momentumFock μ where
  toFun u := (contField μ u u ψ).1
  map_add' u v := by
    simp only [contField_coe, contCreate_add_test, contAnnihil_add_test, Submodule.coe_add]
    abel
  map_smul' c u := by
    change (contCreate μ ((c : ℂ) • u) ψ).1 + (contAnnihil μ ((c : ℂ) • u) ψ).1 =
      (c : ℂ) • ((contCreate μ u ψ).1 + (contAnnihil μ u ψ).1)
    rw [contCreate_smul_test,contAnnihil_smul_test,smul_add]
    simp only [RCLike.star_def,Complex.conj_ofReal,Submodule.coe_smul_of_tower]
  cont := (contCreate_continuous_in_test μ ψ).add (contAnnihil_continuous_in_test μ ψ)

private theorem differentiated_field_orbit (ψ : FiniteParticleFock μ) (v w : Lp ℂ 2 μ)
    (V : ℝ → Lp ℂ 2 μ ≃ₗᵢ[ℂ] Lp ℂ 2 μ)
    (h : HasDerivAt (fun t ↦ V t v) w 0) :
    HasDerivAt (fun t ↦ ((secondQuantizeFin μ (V t))
      (contField μ v v ((secondQuantizeFin μ (V t)).symm ψ))).1) (contField μ w w ψ).1 0 := by
  have he (t : ℝ) : ((secondQuantizeFin μ (V t))
      (contField μ v v ((secondQuantizeFin μ (V t)).symm ψ))).1 =
      fieldLabelOnFinite μ ψ (V t v) := by
    rw [secondQuantize_intertwines_field,LinearEquiv.apply_symm_apply]
    rfl
  simp_rw [he]
  exact (fieldLabelOnFinite μ ψ).hasFDerivAt.comp_hasDerivAt 0 h

theorem finite_field_sectors (v : Lp ℂ 2 μ) (ψ : FiniteParticleFock μ) :
    sectorFieldApply μ v ψ.1 = ⇑(contField μ v v ψ).1 := by
  funext n
  cases n with
  | zero => exact (zero_add _).symm
  | succ n => rfl

theorem finite_mem_fockFieldDom (v : Lp ℂ 2 μ) (ψ : FiniteParticleFock μ) :
    fockFieldDom μ v ψ.1 := by
  rw [fockFieldDom, finite_field_sectors]
  exact (contField μ v v ψ).1.2

/-- The maximal sector operator is symmetric. Both sides are limits of the
finite-particle symmetry identity in the graph norm. -/
theorem fockFieldOp_symmetric (v : Lp ℂ 2 μ) (ψ χ : momentumFock μ)
    (hψ : fockFieldDom μ v ψ) (hχ : fockFieldDom μ v χ) :
    inner ℂ (fockFieldOp μ v ψ hψ) χ = inner ℂ ψ (fockFieldOp μ v χ hχ) := by
  have ht (x : momentumFock μ) : Tendsto
      (fun n : ℕ ↦ (fockTaperFin μ (Nat.succ_pos n) x).1) atTop (𝓝 x) :=
    (tendsto_fockTaper μ x).comp (tendsto_add_atTop_nat 1)
  apply tendsto_nhds_unique (Filter.Tendsto.inner (𝕜 := ℂ) (tendsto_fockField_taper μ v ψ hψ) (ht χ))
  exact (Filter.Tendsto.inner (𝕜 := ℂ) (ht ψ) (tendsto_fockField_taper μ v χ hχ)).congr
    (fun n ↦ (contField_symm μ v _ _).symm)

/-- Testing against the field on finite-particle vectors characterizes its maximal graph. -/
theorem fockField_graph_of_finite_tests (v : Lp ℂ 2 μ) (ψ χ : momentumFock μ)
    (h : ∀ y : FiniteParticleFock μ, inner ℂ χ y.1 = inner ℂ ψ (contField μ v v y).1) :
    sectorFieldApply μ v ψ = ⇑χ := by
  funext n
  apply ext_inner_right ℂ
  intro z
  let y := embedSectorFin μ n z
  let ψN (N : ℕ) := fockTaperFin μ (Nat.succ_pos N) ψ
  have ht : Tendsto (fun N ↦ (ψN N).1) atTop (𝓝 ψ) :=
    (tendsto_fockTaper μ ψ).comp (tendsto_add_atTop_nat 1)
  have hl := Filter.Tendsto.inner (𝕜 := ℂ) ht (tendsto_const_nhds (x := (contField μ v v y).1))
  have he : ∀ᶠ N in atTop, inner ℂ (ψN N).1 (contField μ v v y).1 =
      inner ℂ (sectorFieldApply μ v ψ n) z := by
    filter_upwards [eventually_ge_atTop (n+2)] with N hN
    rw [← contField_symm]
    change inner ℂ _ (embedSector μ n z) = _
    rw [embedSector_inner_right, ← congrFun (finite_field_sectors μ v (ψN N)) n]
    have hs (j : ℕ) (hj : j ≤ N+1) : (ψN N).1 j = ψ j := by
      change (taperWeight (N+1) j : ℂ) • ψ j = ψ j
      simp [taperWeight,hj]
    cases n with
    | zero => simp only [sectorFieldApply,hs 1 (by omega)]
    | succ n => simp only [sectorFieldApply,hs n (by omega),hs (n+2) (by omega)]
  have hz := tendsto_nhds_unique (hl.congr' he) tendsto_const_nhds
  change inner ℂ (sectorFieldApply μ v ψ n) z = inner ℂ (χ n) z
  rw [← embedSector_inner_right μ n χ z]
  exact hz.symm.trans (h y).symm

end FiniteField

section PhysicalPlaneField

variable {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
local notation "vol" => (volume : Measure (MassShell.Space d))
local notation "U₁" => oneParticleUnitary vol (modeDispersion m) (modeDispersion_measurable m)
local notation "U" => fockUnitary vol (modeDispersion m) (modeDispersion_measurable m)
local notation "T" => 𝓢(MassShell.Space d, ℝ)

private theorem plane_time_translation (t : ℝ) (u : Lp ℂ 2 vol) :
    translationUnitary d m (t,0) u = U₁ (-t) u := by
  apply Lp.ext
  filter_upwards [translationUnitary_apply_ae d m (t,0) u,
    FeatureDensity.complexMultiplier_apply_ae (MomentumFock.unitaryWeight (modeDispersion m) (-t))
      (MomentumFock.unitaryWeight_memLp vol _ (modeDispersion_measurable m) (-t)) u] with k ha hb
  change (U₁ (-t) u) k = _ at hb
  rw [ha,hb]
  simp only [inner_zero_left,sub_zero,MomentumFock.unitaryWeight,neg_mul,neg_neg,
    Complex.ofReal_mul,mul_comm Complex.I]

private theorem plane_fock_translation (t : ℝ) :
    (fockTranslation d m (t,0)).toLinearIsometry.toContinuousLinearMap = U (-t) := by
  apply ContinuousLinearMap.ext_on
    (Submodule.dense_iff_topologicalClosure_eq_top.mpr (coherentVec_dense vol))
  rintro _ ⟨u,rfl⟩
  change secondQuantize vol (translationUnitary d m (t,0)) (coherentVec vol u) = _
  rw [secondQuantize_coherent,fockUnitary_coherent,plane_time_translation]

/-- Time evolution of a finite-particle vector on its invariant domain. -/
noncomputable def planeTimeUnitaryFin (m t : ℝ) (ψ : FiniteParticleFock vol) : FiniteParticleFock vol :=
  (secondQuantizeFin vol (translationUnitary d m (t,0))).symm ψ

theorem planeTimeUnitaryFin_val (t : ℝ) (ψ : FiniteParticleFock vol) :
    (planeTimeUnitaryFin m t ψ).1 = U t ψ.1 := by
  have hc := congrArg Subtype.val ((secondQuantizeFin vol (translationUnitary d m (t,0))).apply_symm_apply ψ)
  change fockTranslation d m (t,0) (planeTimeUnitaryFin m t ψ).1 = ψ.1 at hc
  have he (x : momentumFock vol) : fockTranslation d m (t,0) x = U (-t) x :=
    DFunLike.congr_fun (plane_fock_translation (d := d) (m := m) t) x
  rw [he] at hc
  calc
    _ = U (t + -t) (planeTimeUnitaryFin m t ψ).1 := by
      rw [add_neg_cancel]
      exact (DFunLike.congr_fun (fockUnitary_zero vol (modeDispersion m) (modeDispersion_measurable m)) _).symm
    _ = U t (U (-t) (planeTimeUnitaryFin m t ψ).1) :=
      DFunLike.congr_fun (fockUnitary_add vol (modeDispersion m) (modeDispersion_measurable m) t (-t)) _
    _ = _ := congrArg (U t) hc

/-- Strong time derivative of the full Heisenberg conjugate
`U(-t) Q(h) U(t) ψ` for each finite-particle vector, in the Hilbert norm. -/
theorem plane_heisenberg_field_derivative (h : T) (ψ : FiniteParticleFock vol) :
    let v := planePositionMomentumLabel hħ hm h
    let w := planeDerivativeMomentumLabel hħ hm h
    HasDerivAt (fun t : ℝ ↦ U (-t) (contField vol v v (planeTimeUnitaryFin m t ψ)).1)
      (contField vol w w ψ).1 0 := by
  intro v w
  have he (t : ℝ) (x : momentumFock vol) : fockTranslation d m (t,0) x = U (-t) x :=
    DFunLike.congr_fun (plane_fock_translation (d := d) (m := m) t) x
  have hlabel : HasDerivAt (fun t : ℝ ↦ translationUnitary d m (t,0) v) w 0 := by
    simpa only [plane_time_translation] using (plane_observation_time_derivative hħ hm h)
  have hd := differentiated_field_orbit vol ψ v w (fun t : ℝ ↦ translationUnitary d m (t,0)) hlabel
  change HasDerivAt (fun t : ℝ ↦ fockTranslation d m (t,0)
    (contField vol v v (planeTimeUnitaryFin m t ψ)).1) (contField vol w w ψ).1 0 at hd
  simpa only [he] using hd

end PhysicalPlaneField

end DotProduct.Extension

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap Topology ComplexConjugate

section ReadingGraph

variable {Ω R T : Type*} [MeasurableSpace Ω] [AddCommGroup T] [Module ℝ T]
  [NormedAddCommGroup R] [InnerProductSpace ℝ R]
variable (P : Measure Ω) [IsFiniteMeasure P] (Φ : Ω → R →ₗ[ℝ] ℝ)
  (hΦ : ∀ a, Measurable (fun x ↦ Φ x a)) (L : T →ₗ[ℝ] R)
local notation "Q" => P.map (readingCoordinates Φ L)
local notation "W" => wickCoordinate Q L

include hΦ in
private theorem coordinate_graph_from_wick_tests (h : T) (F G : Lp ℂ 2 Q) (Y : T → Lp ℂ 2 Q)
    (hcoord : MemLp (fun x : T → ℝ ↦ x h) 2 Q)
    (hY : ∀ b, ⇑(Y b) =ᵐ[Q] fun x ↦ (x h : ℂ) * W b x)
    (hw : ∀ b, inner ℂ (W b) G = inner ℂ (Y b) F) :
    ⇑G =ᵐ[Q] fun x ↦ (x h : ℂ) * F x := by
  classical
  let D (x : T → ℝ) := G x - (x h : ℂ) * F x
  have hD : Integrable D Q := ((Lp.memLp G).integrable (by norm_num)).sub
    ((hcoord.ofReal (K := ℂ)).integrable_mul (Lp.memLp F))
  have hann (b : T) : ∫ x, D x * conj (W b x) ∂Q = 0 := by
    have hi := hw b
    rw [L2.inner_def,L2.inner_def] at hi
    calc
      _ = (∫ x, inner ℂ (W b x) (G x) ∂Q) -
          ∫ x, inner ℂ (Y b x) (F x) ∂Q := by
        rw [← integral_sub (L2.integrable_inner _ _) (L2.integrable_inner _ _)]
        apply integral_congr_ae
        filter_upwards [hY b] with x hx
        simp only [D,RCLike.inner_apply,hx,map_mul,Complex.conj_ofReal]
        ring
      _ = 0 := sub_eq_zero.mpr hi
  let C := DotChar.cylinderPhases T
  have hz : D =ᵐ[Q] 0 := by
    apply C.complex_annihilator hD
    intro t
    let r := C.opposite t
    let b : T := ∑ i : r.1, r.2 (Pi.single i 1) • (i : T)
    have hphase : C.phase r =ᵐ[Q] fun x ↦ Complex.exp ((x b : ℂ) * Complex.I) := by
      apply (ae_map_iff (measurable_readingCoordinates Φ (hΦ) L).aemeasurable ?_).mpr
      · exact Eventually.of_forall (cylinderPhase_on_readings Φ L r)
      · exact measurableSet_eq_fun (C.measurable_phase r) (by fun_prop)
    let c := Complex.exp ((‖L b‖^2 / 2 : ℝ) : ℂ)
    have hc : c ≠ 0 := Complex.exp_ne_zero _
    apply (mul_eq_zero.mp (show c * (∫ x, D x * C.phase t x ∂Q) = 0 from ?_)).resolve_left hc
    rw [← integral_const_mul, ← hann b]
    apply integral_congr_ae
    filter_upwards [hphase,wickCoordinate_ae Q L b] with x hx hw
    have hop : conj (C.phase r x) = C.phase t x := C.conj_opposite t x
    rw [hw,Complex.exp_add,map_mul,← hx,hop,← Complex.exp_conj,Complex.conj_ofReal]
    dsimp only [c]
    ring
  filter_upwards [hz] with x hx
  exact sub_eq_zero.mp hx

end ReadingGraph

private theorem field_unitary_inner {H K : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [NormedAddCommGroup K] [InnerProductSpace ℂ K] (U : H ≃ₗᵢ[ℂ] K) (x : H) (y : K) :
    inner ℂ (U x) y = inner ℂ x (U.symm y) :=
  (congrArg (inner ℂ (U x)) (U.apply_symm_apply y).symm).trans (U.inner_map_map x (U.symm y))

section CoordinateGraph

set_option maxHeartbeats 2200000
set_option synthInstance.maxHeartbeats 150000

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
local notation "vol" => (volume : Measure (MassShell.Space d))
local notation "B" => massiveEuclideanBasis (d+1)
local notation "Φ" => pointwiseGaussian B
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d hħ.le hm)
local notation "Q" => massiveSpatialLaw d hħ.le hm
local notation "T" => 𝓢(MassShell.Space d, ℝ)
local notation "J" => massiveSpatialFockUnitary d hħ hm
local notation "W" => wickCoordinate Q L

/-- The graph of multiplication by the original spatial reading in its coordinate law. -/
def planeCoordinateGraph (h : T) (F G : Lp ℂ 2 Q) : Prop :=
  ⇑G =ᵐ[Q] fun x ↦ (x h : ℂ) * F x

/-- On the entire maximal Fock domain the field is multiplication by the
original coordinate, almost everywhere in the measured plane law. -/
theorem planeCoordinateGraph_of_fockFieldDom (h : T) (ψ : momentumFock vol)
    (hψ : fockFieldDom vol (planePositionMomentumLabel hħ.le hm h) ψ) :
    planeCoordinateGraph d hħ hm h ((J).symm ψ)
      ((J).symm (fockFieldOp vol (planePositionMomentumLabel hħ.le hm h) ψ hψ)) := by
  let v := planePositionMomentumLabel (d := d) hħ.le hm
  apply coordinate_graph_from_wick_tests (standardGaussianProduct _) Φ (pointwiseGaussian_measurable B)
    L h _ _ (planeCoordinateTimesWick d hħ.le hm h) ?hcoord (planeCoordinateTimesWick_ae d hħ.le hm h)
  case hcoord =>
    apply (memLp_map_measure_iff (measurable_pi_apply h).aestronglyMeasurable
      (measurable_readingCoordinates Φ (pointwiseGaussian_measurable B) L).aemeasurable).mpr
    exact (memLp_congr_ae (pointwiseGaussian_ae B (L h))).mpr
      (Lp.memLp (gaussianIsonormal B (L h)))
  intro b
  have hJ := massiveSpatialFockUnitary_wick d hħ hm
  have hb := massive_spatial_fock_wick d hħ hm J hJ b
  have hc := plane_coordinate_fock_field d hħ hm J hJ h b
  let A := fockFieldOp vol (v h) ψ hψ
  let Y := planeCoordinateTimesWick d hħ.le hm h b
  calc
    inner ℂ (W b) ((J).symm A) = inner ℂ (J (W b)) A := (field_unitary_inner J _ A).symm
    _ = inner ℂ (coherentVec vol (Complex.I • v b)) A := congrArg (fun y ↦ inner ℂ y A) hb
    _ = inner ℂ (fockFieldOp vol (v h) (coherentVec vol (Complex.I • v b))
      (coherentVec_mem_fockFieldDom vol _ _)) ψ := (fockFieldOp_symmetric vol (v h) _ ψ _ hψ).symm
    _ = inner ℂ (J Y) ψ := congrArg (fun y ↦ inner ℂ y ψ) hc.symm
    _ = inner ℂ Y ((J).symm ψ) := field_unitary_inner J Y ψ

/-- Exact equivalence of operator graphs under the measured Wick-label unitary.
The measured graph permits every vector whose coordinate product belongs to L². -/
theorem plane_coordinate_fock_graph (h : T) (F G : Lp ℂ 2 Q) :
    planeCoordinateGraph d hħ hm h F G ↔
      sectorFieldApply vol (planePositionMomentumLabel hħ.le hm h) (J F) = ⇑(J G) := by
  let v := planePositionMomentumLabel hħ.le hm h
  constructor
  · intro hG
    apply fockField_graph_of_finite_tests
    intro y
    have hy := planeCoordinateGraph_of_fockFieldDom d hħ hm h y.1 (finite_mem_fockFieldDom vol v y)
    have he : fockFieldOp vol v y.1 (finite_mem_fockFieldDom vol v y) = (contField vol v v y).1 :=
      lp.ext (finite_field_sectors vol v y)
    rw [he] at hy
    let Z := (contField vol v v y).1
    calc
      inner ℂ (J G) y.1 = inner ℂ G ((J).symm y.1) := field_unitary_inner J G y.1
      _ = inner ℂ F ((J).symm Z) := by
        rw [L2.inner_def,L2.inner_def]
        apply integral_congr_ae
        filter_upwards [hG,hy] with x hx hyx
        change inner ℂ (G x) ((J).symm y.1 x) = inner ℂ (F x) ((J).symm (contField vol v v y).1 x)
        simp only [RCLike.inner_apply,hx,hyx,map_mul,Complex.conj_ofReal]
        ring
      _ = inner ℂ (J F) Z := (field_unitary_inner J F Z).symm
  · intro he
    have hd : fockFieldDom vol v (J F) := by
      change Memℓp (sectorFieldApply vol (planePositionMomentumLabel hħ.le hm h) (J F)) 2
      rw [he]
      exact (J G).2
    have hi := planeCoordinateGraph_of_fockFieldDom d hħ hm h (J F) hd
    have he' : fockFieldOp vol v (J F) hd = J G := lp.ext he
    rwa [he',(J).symm_apply_apply,(J).symm_apply_apply] at hi

/-- Equality of the maximal multiplication and sector-field domains for each
original spatial Schwartz test. -/
theorem plane_coordinate_domain_iff (h : T) (F : Lp ℂ 2 Q) :
    MemLp (fun x ↦ (x h : ℂ) * F x) 2 Q ↔
      fockFieldDom vol (planePositionMomentumLabel hħ.le hm h) (J F) := by
  constructor
  · intro hM
    have he := (plane_coordinate_fock_graph d hħ hm h F (hM.toLp _)).mp (hM.coeFn_toLp)
    rw [fockFieldDom,he]
    exact (J (hM.toLp _)).2
  · intro hf
    have hg := planeCoordinateGraph_of_fockFieldDom d hħ hm h (J F) hf
    rw [(J).symm_apply_apply] at hg
    exact (memLp_congr_ae hg).mp (Lp.memLp _)

private theorem planeCoordinateOnFinite_mem (h : T) (ψ : FiniteParticleFock vol) :
    MemLp (fun x ↦ (x h : ℂ) * (J).symm ψ.1 x) 2 Q := by
  apply (plane_coordinate_domain_iff d hħ hm h ((J).symm ψ.1)).mpr
  rw [(J).apply_symm_apply]
  exact finite_mem_fockFieldDom vol _ ψ

/-- Multiplication on the actual invariant finite-particle domain in plane-law L². -/
noncomputable def planeCoordinateOnFinite (h : T) (ψ : FiniteParticleFock vol) : Lp ℂ 2 Q :=
  (planeCoordinateOnFinite_mem d hħ hm h ψ).toLp _

theorem planeCoordinateOnFinite_ae (h : T) (ψ : FiniteParticleFock vol) :
    planeCoordinateGraph d hħ hm h ((J).symm ψ.1) (planeCoordinateOnFinite d hħ hm h ψ) :=
  (planeCoordinateOnFinite_mem d hħ hm h ψ).coeFn_toLp

/-- The derivative in measured plane-law L² uses actual coordinate multiplication
between the forward evolution and its inverse. -/
theorem measured_plane_field_derivative (h : T) (ψ : FiniteParticleFock vol) :
    let U := fockUnitary vol (modeDispersion m) (modeDispersion_measurable m)
    let w := planeDerivativeMomentumLabel hħ.le hm h
    HasDerivAt (fun t : ℝ ↦ (J).symm (U (-t)
      (J (planeCoordinateOnFinite d hħ hm h (planeTimeUnitaryFin m t ψ)))))
      ((J).symm (contField vol w w ψ).1) 0 := by
  intro U w
  let v := planePositionMomentumLabel hħ.le hm h
  have he (y : FiniteParticleFock vol) :
      J (planeCoordinateOnFinite d hħ hm h y) = (contField vol v v y).1 := by
    have he := (plane_coordinate_fock_graph d hħ hm h _ _).mp (planeCoordinateOnFinite_ae d hħ hm h y)
    rw [(J).apply_symm_apply] at he
    exact lp.ext (he.symm.trans (finite_field_sectors vol v y))
  simp_rw [he]
  exact ((J).symm.toContinuousLinearEquiv.toContinuousLinearMap.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0
    (plane_heisenberg_field_derivative hħ.le hm h ψ)

private theorem uncertainty_transport {H K : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [NormedAddCommGroup K] [InnerProductSpace ℂ K] (U : H ≃ₗᵢ[ℂ] K) (F A : H) (bval C : K)
    (c : ℝ) (he : bval = U A)
    (hh : c ≤ ‖bval - inner ℂ (U F) bval • U F‖ * ‖C - inner ℂ (U F) C • U F‖) :
    c ≤ ‖A - inner ℂ F A • F‖ * ‖U.symm C - inner ℂ F (U.symm C) • F‖ := by
  have hn (Y : H) : ‖U Y - inner ℂ (U F) (U Y) • U F‖ = ‖Y - inner ℂ F Y • F‖ := by
    rw [U.inner_map_map, ← U.map_smul, ← U.map_sub, U.norm_map]
  have hc : ‖C - inner ℂ (U F) C • U F‖ = ‖U.symm C - inner ℂ F (U.symm C) • F‖ := by
    simpa only [U.apply_symm_apply] using hn (U.symm C)
  simpa only [he,hn,hc] using hh


private theorem uncertainty_transport_fock {K Ω : Type*} [NormedAddCommGroup K] [InnerProductSpace ℂ K]
    [MeasurableSpace Ω] (μ : Measure Ω) [SigmaFinite μ] (U : K ≃ₗᵢ[ℂ] momentumFock μ)
    (c : ℝ) (v w : Lp ℂ 2 μ) (F A : K)
    (hP : fockFieldDom μ w (U F))
    (hG : sectorFieldApply μ v (U F) = ⇑(U A))
    (hh : ∀ hv : fockFieldDom μ v (U F),
      c ≤ ‖fockFieldOp μ v (U F) hv - inner ℂ (U F) (fockFieldOp μ v (U F) hv) • U F‖ *
        ‖fockFieldOp μ w (U F) hP - inner ℂ (U F) (fockFieldOp μ w (U F) hP) • U F‖) :
    let P := U.symm (fockFieldOp μ w (U F) hP)
    c ≤ ‖A - inner ℂ F A • F‖ * ‖P - inner ℂ F P • F‖ := by
  have hv : fockFieldDom μ v (U F) := by
    change Memℓp (sectorFieldApply μ v (U F)) 2
    rw [hG]
    exact (U A).2
  exact uncertainty_transport U F A _ _ c (lp.ext hG) (hh hv)

attribute [local irreducible] massiveSpatialFockUnitary in
/-- The uncertainty bound on the intersection of the actual coordinate
multiplication domain and the momentum-field domain, in measured plane-law L². -/
theorem measured_plane_heisenberg (h : T) (hn : ‖h.toLp 2 volume‖ = 1) (F : Lp ℂ 2 Q)
    (hF : ‖F‖ = 1) (hQ : MemLp (fun x ↦ (x h : ℂ) * F x) 2 Q)
    (hP : fockFieldDom vol (planeDerivativeMomentumLabel hħ.le hm h) (J F)) :
    let A : Lp ℂ 2 Q := hQ.toLp (fun x ↦ (x h : ℂ) * F x)
    let P : Lp ℂ 2 Q := (J).symm (fockFieldOp vol (planeDerivativeMomentumLabel hħ.le hm h) (J F) hP)
    ħ / 2 ≤ ‖A - inner ℂ F A • F‖ * ‖P - inner ℂ F P • F‖ := by
  intro A P
  have hA : planeCoordinateGraph d hħ hm h F A := hQ.coeFn_toLp
  exact uncertainty_transport_fock vol J (ħ / 2) (planePositionMomentumLabel hħ.le hm h)
    (planeDerivativeMomentumLabel hħ.le hm h) F A hP ((plane_coordinate_fock_graph d hħ hm h F A).mp hA)
    (fun hv ↦ spatial_plane_heisenberg hħ.le hm h hn (J F) (((J).norm_map F).trans hF) hv hP)
end CoordinateGraph

end DotProduct.Extension


namespace DotProduct
open MeasureTheory Set
open scoped InnerProductSpace
section DifferentialPrecision

/-- An oscillatory Fourier mode in angular-frequency coordinates. -/
noncomputable def precisionWave {D : ℕ} (p x : (EuclideanSpace ℝ (Fin D))) : ℂ :=
  Complex.exp (Complex.I * (inner ℝ p x : ℝ))

private theorem precisionWave_add {D : ℕ} (p x y : (EuclideanSpace ℝ (Fin D))) :
    precisionWave p (x + y) = precisionWave p x * precisionWave p y := by
  simp [precisionWave, inner_add_right, mul_add, Complex.exp_add]

/-- Ordered coordinate derivatives in the momentum convention −i∂. -/
noncomputable def precisionWord {D : ℕ} : List (Fin D) → ((EuclideanSpace ℝ (Fin D)) → ℂ) → (EuclideanSpace ℝ (Fin D)) → ℂ
  | [], f, x => f x
  | i :: w, f, x => -Complex.I * deriv
      (fun t : ℝ ↦ precisionWord w f (x + t • EuclideanSpace.single i (1 : ℝ))) 0

private theorem precisionWord_wave {D : ℕ} (p : (EuclideanSpace ℝ (Fin D))) (A : ℂ) (w : List (Fin D)) (x : (EuclideanSpace ℝ (Fin D))) :
    precisionWord w (fun y ↦ A * precisionWave p y) x =
      (w.map (fun i ↦ (p i : ℂ))).prod * A * precisionWave p x := by
  induction w generalizing x with
  | nil => simp [precisionWord]
  | cons i w ih =>
    let B := (w.map (fun i ↦ (p i : ℂ))).prod * A * precisionWave p x
    have hfun : (fun t : ℝ ↦ precisionWord w (fun y ↦ A * precisionWave p y)
        (x + t • EuclideanSpace.single i (1 : ℝ))) =
        fun t : ℝ ↦ B * Complex.exp ((t : ℂ) * (Complex.I * (p i : ℂ))) := by
      funext t
      rw [ih, precisionWave_add]
      simp [B, precisionWave, real_inner_smul_right, EuclideanSpace.inner_single_right]
      ring_nf
    have hg : HasDerivAt (fun t : ℝ ↦ (t : ℂ) * (Complex.I * (p i : ℂ)))
        (Complex.I * (p i : ℂ)) 0 := by simpa using
      (Complex.ofRealCLM.hasDerivAt (x := (0 : ℝ))).mul_const (Complex.I * (p i : ℂ))
    have h := (hg.cexp.const_mul B).deriv
    simp only [precisionWord, hfun, h, Complex.ofReal_zero, zero_mul, Complex.exp_zero,
      one_mul, List.map_cons, List.prod_cons]
    dsimp only [B]
    linear_combination -(p i : ℂ) * ((w.map (fun j ↦ (p j : ℂ))).prod * A * precisionWave p x) *
      Complex.I_mul_I

private noncomputable def precisionIndices {D : ℕ} (a : Fin D →₀ ℕ) : List (Fin D) :=
  (Finset.univ.toList : List (Fin D)).flatMap fun i ↦ List.replicate (a i) i

private theorem precisionIndices_prod {D : ℕ} (a : Fin D →₀ ℕ) (p : Fin D → ℂ) :
    ((precisionIndices a).map p).prod = ∏ i, p i ^ a i := by
  have h (l : List (Fin D)) : ((l.flatMap fun i ↦ List.replicate (a i) i).map p).prod =
      (l.map fun i ↦ p i ^ a i).prod := by
    induction l with
    | nil => simp
    | cons i l ih => simp [ih]
  rw [precisionIndices, h, Finset.prod_map_toList]

/-- A local scalar differential operator with its finite multi-index coefficients at each
point. Complex coefficients absorb all powers of i in the momentum convention. -/
noncomputable def differentialPrecision {D : ℕ} (c : (EuclideanSpace ℝ (Fin D)) → MvPolynomial (Fin D) ℂ)
    (f : (EuclideanSpace ℝ (Fin D)) → ℂ) (x : (EuclideanSpace ℝ (Fin D))) : ℂ :=
  ∑ a ∈ (c x).support, (c x).coeff a * precisionWord (precisionIndices a) f x

theorem differentialPrecision_wave {D : ℕ} (c : (EuclideanSpace ℝ (Fin D)) → MvPolynomial (Fin D) ℂ)
    (p x : (EuclideanSpace ℝ (Fin D))) (A : ℂ) :
    differentialPrecision c (fun y ↦ A * precisionWave p y) x =
      MvPolynomial.eval (fun i ↦ (p i : ℂ)) (c x) * A * precisionWave p x := by
  rw [MvPolynomial.eval_eq', Finset.sum_mul, Finset.sum_mul]
  unfold differentialPrecision
  apply Finset.sum_congr rfl
  intro a _
  rw [precisionWord_wave, precisionIndices_prod]
  ring

private theorem precisionWave_smooth {D : ℕ} (p : (EuclideanSpace ℝ (Fin D))) :
    ContDiff ℝ (⊤ : ℕ∞) (precisionWave p) := by
  unfold precisionWave
  change ContDiff ℝ (⊤ : ℕ∞) (fun x ↦ Complex.exp (Complex.I * Complex.ofRealCLM (inner ℝ p x)))
  apply ContDiff.cexp
  exact contDiff_const.mul (Complex.ofRealCLM.contDiff.comp (innerSL ℝ p).contDiff)

private theorem differentialPrecision_single_wave {D : ℕ} (c : (EuclideanSpace ℝ (Fin D)) → MvPolynomial (Fin D) ℂ)
    (p x : (EuclideanSpace ℝ (Fin D))) :
    differentialPrecision c (precisionWave p) x =
      MvPolynomial.eval (fun i ↦ (p i : ℂ)) (c x) * precisionWave p x := by
  simpa using differentialPrecision_wave c p x 1

/-- Translation covariance of the differential operator forces every coefficient in
its multi-index expression to equal its value at the origin. -/
theorem differentialPrecision_constant_of_translations {D : ℕ} (c : (EuclideanSpace ℝ (Fin D)) → MvPolynomial (Fin D) ℂ)
    (htr : ∀ (a : (EuclideanSpace ℝ (Fin D))) (f : (EuclideanSpace ℝ (Fin D)) → ℂ), ContDiff ℝ (⊤ : ℕ∞) f →
      ∀ x, differentialPrecision c (fun y ↦ f (y + a)) x = differentialPrecision c f (x + a)) :
    ∀ a, c a = c 0 := by
  intro a
  apply MvPolynomial.funext_set (fun _ : Fin D ↦ Set.range Complex.ofReal)
    (fun _ ↦ Set.infinite_range_of_injective Complex.ofReal_injective)
  intro ξ hξ
  have hreal (i : Fin D) : ∃ r : ℝ, (r : ℂ) = ξ i := hξ i (mem_univ i)
  choose r hr using hreal
  let p : (EuclideanSpace ℝ (Fin D)) := WithLp.toLp 2 r
  have hp : (fun i ↦ (p i : ℂ)) = ξ := funext hr
  rw [← hp]
  have h := htr a (precisionWave p) (precisionWave_smooth p) 0
  have htrans : (fun y ↦ precisionWave p (y + a)) = fun y ↦ precisionWave p a * precisionWave p y := by
    funext y
    rw [add_comm, precisionWave_add]
  rw [htrans, differentialPrecision_wave, zero_add, differentialPrecision_single_wave] at h
  have h0 : precisionWave p 0 = 1 := by simp [precisionWave]
  rw [h0, mul_one] at h
  exact mul_right_cancel₀ (Complex.exp_ne_zero _) h.symm

private noncomputable def precisionRealPolynomial {D : ℕ} (Q : MvPolynomial (Fin D) ℂ) :
    MvPolynomial (Fin D) ℝ :=
  ∑ a ∈ Q.support, MvPolynomial.monomial a (Q.coeff a).re

private theorem precisionRealPolynomial_eval {D : ℕ} (Q : MvPolynomial (Fin D) ℂ)
    (p : Fin D → ℝ) :
    MvPolynomial.eval p (precisionRealPolynomial Q) =
      (MvPolynomial.eval (fun i ↦ (p i : ℂ)) Q).re := by
  rw [precisionRealPolynomial, map_sum, MvPolynomial.eval_eq', Complex.re_sum]
  apply Finset.sum_congr rfl
  intro a _
  rw [MvPolynomial.eval_monomial, Finsupp.prod_fintype _ _ (fun _ ↦ pow_zero _)]
  simp only [← Complex.ofReal_pow, ← Complex.ofReal_prod, Complex.mul_re,
    Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]

/-- For an orthogonally and translationally invariant positive differential precision,
the angular Fourier multiplier on every plane wave is a single real polynomial in |p|². -/
theorem differentialPrecision_invariant_radial {D : ℕ} (hD : 0 < D)
    (c : (EuclideanSpace ℝ (Fin D)) → MvPolynomial (Fin D) ℂ)
    (htr : ∀ (a : (EuclideanSpace ℝ (Fin D))) (f : (EuclideanSpace ℝ (Fin D)) → ℂ), ContDiff ℝ (⊤ : ℕ∞) f →
      ∀ x, differentialPrecision c (fun y ↦ f (y + a)) x = differentialPrecision c f (x + a))
    (hrot : ∀ (U : (EuclideanSpace ℝ (Fin D)) ≃ₗᵢ[ℝ] (EuclideanSpace ℝ (Fin D))) (f : (EuclideanSpace ℝ (Fin D)) → ℂ),
      ContDiff ℝ (⊤ : ℕ∞) f → ∀ x, differentialPrecision c (f ∘ U) x = differentialPrecision c f (U x))
    (hpos : ∀ p, ∃ r : ℝ, 0 < r ∧ differentialPrecision c (precisionWave p) 0 = r) :
    (∀ x, c x = c 0) ∧ ∃ P : Polynomial ℝ, (∀ r : ℝ, 0 ≤ r → 0 < P.eval r) ∧
      ∀ p x, differentialPrecision c (precisionWave p) x =
        ((P.eval (‖p‖ ^ 2) : ℝ) : ℂ) * precisionWave p x := by
  let Q := c 0
  let R := precisionRealPolynomial Q
  have hconst := differentialPrecision_constant_of_translations c htr
  have he (p : (EuclideanSpace ℝ (Fin D))) : differentialPrecision c (precisionWave p) 0 =
      MvPolynomial.eval (fun i ↦ (p i : ℂ)) Q := by
    rw [differentialPrecision_single_wave]
    simp [precisionWave, Q]
  have hinv (U : (EuclideanSpace ℝ (Fin D)) ≃ₗᵢ[ℝ] (EuclideanSpace ℝ (Fin D))) (p : (EuclideanSpace ℝ (Fin D))) :
      MvPolynomial.eval (fun i ↦ U p i) R = MvPolynomial.eval (fun i ↦ p i) R := by
    rw [precisionRealPolynomial_eval, precisionRealPolynomial_eval, ← he (U p), ← he p]
    have hfun : precisionWave p ∘ U.symm = precisionWave (U p) := by
      funext y
      change Complex.exp _ = Complex.exp _
      rw [← U.inner_map_map p (U.symm y), U.apply_symm_apply]
    have h := hrot U.symm (precisionWave p) (precisionWave_smooth p) 0
    rw [hfun, map_zero] at h
    exact congrArg Complex.re h
  obtain ⟨P,hr⟩ := orthogonal_invariant_polynomial_radial hD R hinv
  have hval (p : (EuclideanSpace ℝ (Fin D))) :
      MvPolynomial.eval (fun i ↦ (p i : ℂ)) Q = ((P.eval (‖p‖ ^ 2) : ℝ) : ℂ) ∧
        0 < P.eval (‖p‖ ^ 2) := by
    obtain ⟨r, hpos', hv⟩ := hpos p
    rw [he] at hv
    have h := hr p
    rw [precisionRealPolynomial_eval, hv, Complex.ofReal_re] at h
    exact ⟨hv.trans (congrArg Complex.ofReal h), h ▸ hpos'⟩
  refine ⟨hconst,P,?_,?_⟩
  · intro r hr'
    let p : (EuclideanSpace ℝ (Fin D)) := EuclideanSpace.single ⟨0,hD⟩ (Real.sqrt r)
    simpa [p,Real.sqrt_sq, Real.sq_sqrt hr', abs_of_nonneg (Real.sqrt_nonneg r)] using (hval p).2
  · intro p x
    rw [differentialPrecision_single_wave, hconst x, (hval p).1]

end DifferentialPrecision
end DotProduct


/-! ### Euclidean clustering on the full coordinate law -/

namespace DotProduct.Extension
open MeasureTheory Set Filter
open scoped Topology InnerProductSpace SchwartzMap FourierTransform NNReal ENNReal

private theorem extend_zero_limit_of_lipschitz {I E : Type*} [PseudoMetricSpace E] (l : Filter I)
    (f : I → E → ℂ) {S : Set E} (hd : Dense S) {C : ℝ} (hC : 0 ≤ C)
    (hbound : ∀ i x y, dist (f i x) (f i y) ≤ C * dist x y)
    (h : ∀ x ∈ S, Tendsto (fun i ↦ f i x) l (𝓝 0)) (x : E) :
    Tendsto (fun i ↦ f i x) l (𝓝 0) := by
  refine Metric.tendsto_nhds.mpr fun ε hε ↦ ?_
  obtain ⟨y,hxy,hy⟩ := Metric.dense_iff.mp hd x (ε / 2 / (C + 1)) (by positivity)
  rw [Metric.mem_ball, dist_comm] at hxy
  have hy' := (lt_div_iff₀ (show 0 < C + 1 by positivity)).mp hxy
  filter_upwards [Metric.tendsto_nhds.mp (h y hy) (ε/2) (by positivity)] with i hi
  have ht := dist_triangle (f i x) (f i y) 0
  have hd₁ := hbound i x y
  nlinarith [(dist_nonneg : 0 ≤ dist x y)]

/-- Uniformly bounded matrix coefficients tend weakly to zero if they do so on both
entries of a total family. -/
private theorem weak_zero_of_total {I E V : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (l : Filter I) (T : I → E →L[ℂ] E) (C : ℝ) (hC : 0 ≤ C) (hT : ∀ i, ‖T i‖ ≤ C)
    (v : V → E) (hd : Dense (Submodule.span ℂ (Set.range v) : Set E))
    (h : ∀ s t, Tendsto (fun i ↦ inner ℂ (v s) (T i (v t))) l (𝓝 0)) (x y : E) :
    Tendsto (fun i ↦ inner ℂ x (T i y)) l (𝓝 0) := by
  have h₁ (t : V) (u : E) (hu : u ∈ Submodule.span ℂ (Set.range v)) :
      Tendsto (fun i ↦ inner ℂ u (T i (v t))) l (𝓝 0) := by
    induction hu using Submodule.span_induction with
    | mem a ha => obtain ⟨s,rfl⟩ := ha; exact h s t
    | zero => simpa using (tendsto_const_nhds (x := (0 : ℂ)) (f := l))
    | add a b _ _ ha hb => simpa only [inner_add_left, add_zero] using ha.add hb
    | smul c a _ ha => simpa only [inner_smul_left, mul_zero] using ha.const_mul (starRingEnd ℂ c)
  have h₂ (t : V) (u : E) : Tendsto (fun i ↦ inner ℂ u (T i (v t))) l (𝓝 0) := by
    apply extend_zero_limit_of_lipschitz l _ hd (C := C * ‖v t‖) (by positivity) _ (h₁ t) u
    intro i a b
    rw [dist_eq_norm, dist_eq_norm, ← inner_sub_left]
    calc ‖inner ℂ (a-b) (T i (v t))‖ ≤ ‖a-b‖ * ‖T i (v t)‖ := norm_inner_le_norm _ _
      _ ≤ ‖a-b‖ * (C * ‖v t‖) := by gcongr; exact (T i).le_of_opNorm_le (hT i) _
      _ = _ := mul_comm _ _
  have h₃ (u : E) (hu : u ∈ Submodule.span ℂ (Set.range v)) :
      Tendsto (fun i ↦ inner ℂ x (T i u)) l (𝓝 0) := by
    induction hu using Submodule.span_induction with
    | mem a ha => obtain ⟨t,rfl⟩ := ha; exact h₂ t x
    | zero => simpa using (tendsto_const_nhds (x := (0 : ℂ)) (f := l))
    | add a b _ _ ha hb => simpa only [map_add, inner_add_right, add_zero] using ha.add hb
    | smul c a _ ha => simpa only [map_smul, inner_smul_right, mul_zero] using ha.const_mul c
  apply extend_zero_limit_of_lipschitz l _ hd (C := ‖x‖ * C) (by positivity) _ h₃ y
  intro i a b
  rw [dist_eq_norm, dist_eq_norm, ← inner_sub_right, ← map_sub]
  calc ‖inner ℂ x (T i (a-b))‖ ≤ ‖x‖ * ‖T i (a-b)‖ := norm_inner_le_norm _ _
    _ ≤ ‖x‖ * (C * ‖a-b‖) := by gcongr; exact (T i).le_of_opNorm_le (hT i) _
    _ = _ := (mul_assoc _ _ _).symm

private theorem angular_riemann_lebesgue {D : ℕ} (f : EuclideanSpace ℝ (Fin D) → ℂ) :
    Tendsto (fun a : EuclideanSpace ℝ (Fin D) ↦
      ∫ p, Complex.exp (-Complex.I * (inner ℝ a p : ℂ)) * f p)
      (cocompact _) (𝓝 0) := by
  let c : ℝ := (2 * Real.pi)⁻¹
  have hc : c ≠ 0 := by dsimp [c]; positivity
  have hs : Tendsto (fun a : EuclideanSpace ℝ (Fin D) ↦ c • a) (cocompact _) (cocompact _) :=
    (Homeomorph.smulOfNeZero c hc).isClosedEmbedding.tendsto_cocompact
  refine ((tendsto_integral_exp_inner_smul_cocompact f).comp hs).congr fun a ↦ ?_
  apply integral_congr_ae
  refine ae_of_all _ fun p ↦ ?_
  dsimp only [Function.comp_apply]
  rw [Circle.smul_def, smul_eq_mul, Real.fourierChar_apply, real_inner_smul_right, real_inner_comm p a]
  congr 2
  dsimp [c]
  push_cast
  field_simp [Real.pi_ne_zero]
section EuclideanClustering
variable {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
local notation "E" => MassShell.Space D
local notation "S" => 𝓢(E, ℝ)
local notation "Q" => massiveEuclideanLaw D ħ m hħ hm
local notation "A" => massiveEuclideanLabel D ħ m hħ hm
local notation "T" => euclideanAffineSchwartz (LinearIsometryEquiv.refl ℝ E)

/-- Translated original smears decorrelate at infinity in every Euclidean direction. -/
theorem massiveEuclideanLabel_translate_cluster (f g : S) :
    Tendsto (fun a : E ↦ inner ℂ (A f) (A (T a g))) (cocompact E) (𝓝 0) := by
  let F (p : E) := star (physicsFourier f p) * physicsFourier g p * (continuumDispersion m p : ℂ)⁻¹
  have h := (angular_riemann_lebesgue F).const_mul (ħ : ℂ)
  rw [mul_zero] at h
  refine h.congr fun a ↦ ?_
  rw [massiveEuclideanLabel_inner, continuumCov]
  congr 1
  apply integral_congr_ae
  refine ae_of_all _ fun p ↦ ?_
  simp only [F, physicsFourier_affine, LinearIsometryEquiv.coe_refl, id_eq, Complex.ofReal_inv]
  ring

private theorem massiveEuclideanLabel_translate_norm (a : E) (g : S) :
    ‖A (T a g)‖ = ‖A g‖ := by
  rw [Lp.norm_def, Lp.norm_def]
  apply congrArg ENNReal.toReal
  apply eLpNorm_congr_norm_ae (Lp.aestronglyMeasurable _) (Lp.aestronglyMeasurable _)
  filter_upwards [massiveEuclideanLabel_apply_ae hħ hm g,
    massiveEuclideanLabel_apply_ae hħ hm (T a g)] with p hg ht
  rw [ht, hg, physicsFourier_affine]
  simp [Complex.norm_exp]

private theorem euclideanTranslation_preserves (a : E) :
    MeasurePreserving (fun (w : S → ℝ) f ↦ w (T a f)) Q Q :=
  ⟨Measurable.of_eval (fun f ↦ measurable_pi_apply (T a f)),
    massiveEuclideanLaw_affine_invariant hħ hm _ a⟩

local notation "U" => fun a : E ↦ (Lp.compMeasurePreservingₗᵢ ℂ _ (euclideanTranslation_preserves hħ hm a) :
  Lp ℂ 2 Q →ₗᵢ[ℂ] Lp ℂ 2 Q)
local notation "W" => wickCoordinate Q (ContinuousLinearMap.toLinearMap A)
local notation "P" => standardGaussianProduct (massiveEuclideanBasisSet D)
local notation "Φ" => pointwiseGaussian (massiveEuclideanBasis D)
local notation "hΦ" => pointwiseGaussian_measurable (massiveEuclideanBasis D)

private theorem euclideanTranslation_wick (a : E) (f : S) :
    U a (W f) = W (T a f) := by
  apply Lp.ext
  have hp := euclideanTranslation_preserves hħ hm a
  refine (Lp.coeFn_compMeasurePreserving _ hp).trans ?_
  filter_upwards [hp.quasiMeasurePreserving.ae (wickCoordinate_ae Q (A).toLinearMap f),
    wickCoordinate_ae Q (A).toLinearMap (T a f)] with w h₁ h₂
  change W f ((fun g ↦ w (T a g))) = _ at h₁
  change W f ((fun g ↦ w (T a g))) = _
  rw [h₁, h₂]
  change Complex.exp ((‖A f‖ ^ 2 / 2 : ℝ) + _) = Complex.exp ((‖A (T a f)‖ ^ 2 / 2 : ℝ) + _)
  rw [massiveEuclideanLabel_translate_norm hħ hm]

private theorem massiveEuclideanWick_gram (f g : S) :
    inner ℂ (W f) (W g) = (Real.exp (inner ℝ (A f) (A g)) : ℂ) := by
  let V : Lp ℂ 2 Q →ₗᵢ[ℂ] Lp ℂ 2 P := Lp.compMeasurePreservingₗᵢ ℂ (readingCoordinates Φ (A).toLinearMap)
    (show MeasurePreserving _ P Q from ⟨measurable_readingCoordinates Φ hΦ (A).toLinearMap, rfl⟩)
  have hw (h : S) : V (W h) = wickReading P Φ hΦ (A h) :=
    observationL2_wick P Φ hΦ (A).toLinearMap h
  rw [← V.inner_map_map, hw, hw, wickReading_inner P Φ hΦ (pointwiseGaussian_char _)]

private theorem massiveEuclideanWick_zero_ae : ⇑(W (0 : S)) =ᵐ[Q] fun _ ↦ (1 : ℂ) := by
  have hz : ∀ᵐ w ∂Q, w (0 : S) = 0 := by
    apply (ae_map_iff (massiveEuclideanReading_measurable hħ hm).aemeasurable
      (measurableSet_eq_fun (measurable_pi_apply _) measurable_const)).mpr
    exact ae_of_all _ fun _ ↦ map_zero _
  filter_upwards [wickCoordinate_ae Q (A).toLinearMap (0 : S), hz] with w hw h
  rw [hw, h]; simp

set_option maxHeartbeats 1000000 in
/-- Mixing of the measured Euclidean field under translations going to infinity. It applies
to arbitrary complex square-integrable functions on the full Schwartz evaluation σ-algebra. -/
theorem massiveEuclideanLaw_translation_mixing (X Y : Lp ℂ 2 Q) :
    Tendsto (fun a : E ↦ ∫ w, star (X w) * Y (fun f ↦ w (T a f)) ∂Q)
      (cocompact E) (𝓝 (star (∫ w, X w ∂Q) * ∫ w, Y w ∂Q)) := by
  let one := W (0 : S)
  let avg := (innerSL ℂ one).smulRight one
  let diff (a : E) := (U a).toContinuousLinearMap - avg
  have hdiff (a : E) : ‖diff a‖ ≤ 1 + ‖avg‖ :=
    (norm_sub_le _ _).trans (add_le_add (U a).norm_toContinuousLinearMap_le le_rfl)
  have hW (f : S) : inner ℂ one (W f) = 1 := by
    rw [show one = W 0 from rfl, massiveEuclideanWick_gram]
    simp
  have hW' (f : S) : inner ℂ (W f) one = 1 := by rw [← inner_conj_symm, hW]; simp
  have hw (f g : S) : Tendsto (fun a : E ↦ inner ℂ (W f) (diff a (W g))) (cocompact E) (𝓝 0) := by
    have hlim := Complex.continuous_re.continuousAt.tendsto.comp
      (massiveEuclideanLabel_translate_cluster hħ hm f g)
    have hExp := Complex.continuous_ofReal.continuousAt.tendsto.comp
      (Real.continuous_exp.continuousAt.tendsto.comp hlim)
    have h' := hExp.sub_const (1 : ℂ)
    simpa only [diff, _root_.sub_apply, inner_sub_right, avg,
      ContinuousLinearMap.smulRight_apply, innerSL_apply_apply, hW, one_smul, hW',
      LinearIsometry.coe_toContinuousLinearMap, euclideanTranslation_wick, massiveEuclideanWick_gram,
      physicalL2_real_inner, Function.comp_apply, Complex.zero_re,
      Real.exp_zero, Complex.ofReal_one, sub_self] using h'
  have hmix := weak_zero_of_total (cocompact E) diff (1 + ‖avg‖) (by positivity) hdiff W
    (wickCoordinate_dense P Φ hΦ (A).toLinearMap) hw X Y
  have h₀ := massiveEuclideanWick_zero_ae (D := D) hħ hm
  have hav (Z : Lp ℂ 2 Q) : inner ℂ one Z = ∫ w, Z w ∂Q := by
    rw [L2.inner_def]
    exact integral_congr_ae (h₀.mono fun w hw ↦ by simp [one, RCLike.inner_apply, hw])
  have ht := hmix.add_const (inner ℂ X (avg Y))
  rw [zero_add] at ht
  have hxy : inner ℂ X (avg Y) = star (∫ w, X w ∂Q) * ∫ w, Y w ∂Q := by
    simp only [avg, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply, inner_smul_right,
      ← inner_conj_symm X one, hav, mul_comm]
    rfl
  rw [← hxy]
  refine ht.congr fun a ↦ ?_
  change inner ℂ X (U a Y - avg Y) + inner ℂ X (avg Y) = _
  rw [inner_sub_right, sub_add_cancel, L2.inner_def]
  exact integral_congr_ae ((Lp.coeFn_compMeasurePreserving Y (euclideanTranslation_preserves hħ hm a)).mono
    fun w hw ↦ by
      change inner ℂ (X w) (Lp.compMeasurePreserving _ _ Y w) = _
      rw [RCLike.inner_apply, hw]
      exact mul_comm _ _)

/-- Every finite polynomial of original Schwartz evaluations has all positive finite
moments. Gaussianity of the individual evaluations and Hölder suffice. -/
theorem massiveEuclideanLaw_polynomial_memLp (q : MvPolynomial S ℂ) (p : ℝ≥0) (hp : 0 < p) :
    MemLp (fun w : S → ℝ ↦ MvPolynomial.eval (fun f ↦ (w f : ℂ)) q) p Q := by
  have hread (f : S) (r : ℝ≥0) : MemLp (fun w : S → ℝ ↦ (w f : ℂ)) r Q := by
    let B := massiveEuclideanBasis D
    have hmarg : (Q).map (fun w : S → ℝ ↦ w f) = ProbabilityTheory.gaussianReal 0 (‖A f‖₊ ^ 2) := by
      rw [massiveEuclideanLaw, Measure.map_map (measurable_pi_apply f) (massiveEuclideanReading_measurable hħ hm)]
      exact pointwiseGaussian_map B (A f)
    have hi := ProbabilityTheory.memLp_id_gaussianReal (μ := 0) (v := ‖A f‖₊ ^ 2) r
    rw [← hmarg] at hi
    exact (hi.comp_measurePreserving (show MeasurePreserving (fun w : S → ℝ ↦ w f) Q _
      from ⟨measurable_pi_apply f, rfl⟩)).ofReal
  induction q using MvPolynomial.induction_on generalizing p with
  | C r => simpa only [MvPolynomial.eval_C] using (memLp_const r (p := (p : ℝ≥0∞)) (μ := Q))
  | add f g hf hg => simpa only [map_add, Pi.add_def] using (hf p hp).add (hg p hp)
  | mul_X g f hg =>
    have hp' : 0 < 2 * p := by positivity
    have : ENNReal.HolderTriple ((2*p : ℝ≥0) : ℝ≥0∞) ((2*p : ℝ≥0) : ℝ≥0∞) p := by
      constructor
      rw [← ENNReal.coe_inv hp'.ne', ← ENNReal.coe_add, ← ENNReal.coe_inv hp.ne']
      congr 1
      field_simp
      ring
    simpa only [map_mul, MvPolynomial.eval_X, Pi.mul_def] using (hg (2*p) hp').mul (r := (p : ℝ≥0∞)) (hread f (2*p))

/-- The mixed Schwinger moment of any two polynomial cylinders factors at infinity.
Taking the two polynomials to be monomials gives the cluster condition for every order. -/
theorem massiveEuclideanLaw_schwinger_cluster (q r : MvPolynomial S ℂ) :
    let ev := fun (p : MvPolynomial S ℂ) (w : S → ℝ) ↦ MvPolynomial.eval (fun f ↦ (w f : ℂ)) p
    Tendsto (fun a : E ↦ ∫ w, ev q w * ev r (fun f ↦ w (T a f)) ∂Q)
      (cocompact E) (𝓝 ((∫ w, ev q w ∂Q) * ∫ w, ev r w ∂Q)) := by
  intro ev
  have hq : MemLp (ev q) 2 Q := massiveEuclideanLaw_polynomial_memLp hħ hm q 2 (by norm_num)
  have hr : MemLp (ev r) 2 Q := massiveEuclideanLaw_polynomial_memLp hħ hm r 2 (by norm_num)
  let X := hq.star.toLp (star (ev q))
  let Y := hr.toLp (ev r)
  have hX : ⇑X =ᵐ[Q] star (ev q) := hq.star.coeFn_toLp
  have hY : ⇑Y =ᵐ[Q] ev r := hr.coeFn_toLp
  have h := massiveEuclideanLaw_translation_mixing hħ hm X Y
  have hmean : star (∫ w, X w ∂Q) = ∫ w, ev q w ∂Q := by
    rw [integral_congr_ae hX]
    change star (∫ w, starRingEnd ℂ (ev q w) ∂Q) = _
    rw [integral_conj]
    exact star_star _
  rw [hmean, integral_congr_ae hY] at h
  refine h.congr fun a ↦ integral_congr_ae ?_
  filter_upwards [hX, (euclideanTranslation_preserves hħ hm a).quasiMeasurePreserving.ae hY] with w hw hv
  change star (X w) * _ = _
  change Y (fun f ↦ w (T a f)) = _ at hv
  rw [hw, hv]
  simp

/-- The real Schwinger moments of two lists of smeared fields cluster when the second
list is jointly translated. Empty lists and repeated smears are allowed. -/
theorem massiveEuclideanLaw_schwinger_products_cluster {n k : ℕ} (f : Fin n → S) (g : Fin k → S) :
    Tendsto (fun a : E ↦ ∫ w, (∏ i, w (f i)) * (∏ j, w (T a (g j))) ∂Q)
      (cocompact E) (𝓝 ((∫ w, ∏ i, w (f i) ∂Q) * ∫ w, ∏ j, w (g j) ∂Q)) := by
  let q := ∏ i, (MvPolynomial.X (f i) : MvPolynomial S ℂ)
  let r := ∏ j, (MvPolynomial.X (g j) : MvPolynomial S ℂ)
  have h := massiveEuclideanLaw_schwinger_cluster hħ hm q r
  simp only [q, r, map_prod, MvPolynomial.eval_X, ← Complex.ofReal_prod, ← Complex.ofReal_mul] at h
  rw [integral_complex_ofReal (f := fun w : S → ℝ ↦ ∏ i, w (f i)),
    integral_complex_ofReal (f := fun w : S → ℝ ↦ ∏ j, w (g j)), ← Complex.ofReal_mul] at h
  have h' := h.congr fun a ↦ integral_complex_ofReal (μ := Q)
    (f := fun w : S → ℝ ↦ (∏ i, w (f i)) * ∏ j, w (T a (g j)))
  exact Complex.continuous_re.continuousAt.tendsto.comp h'

end EuclideanClustering

