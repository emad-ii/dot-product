/-! ### Normal translations of measured preparations -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap InnerProductSpace

/-- Translation of an original positive-time spacetime test by normal distance s ≥ 0. -/
noncomputable def shiftPositiveTest {d : ℕ} (s : ℝ) (hs : 0 ≤ s)
    (f : positiveSchwartz d) : positiveSchwartz d := by
  let a := (MassShell.split d).symm (s, (0 : MassShell.Space d))
  refine ⟨SchwartzMap.compSubConstCLM ℝ a f.1, ?_⟩
  intro x hx
  change f.1 (x - a) = 0
  apply f.2
  change x 0 - a 0 ≤ 0
  have ha : a 0 = s := congrArg Prod.fst ((MassShell.split d).apply_symm_apply (s, 0))
  linarith

theorem physicalTrace_shiftPositiveTest {d : ℕ} (s : ℝ) (hs : 0 ≤ s) (f : positiveSchwartz d) :
    physicalTrace (shiftPositiveTest s hs f).1 = positiveTimeTranslate s (physicalTrace f.1) := by
  funext r k
  let a := (MassShell.split d).symm (s, (0 : MassShell.Space d))
  have hsub (y : MassShell.Space d) :
      (MassShell.split d).symm (r,y) - a = (MassShell.split d).symm (r-s,y) := by
    ext i
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · change Fin.cons (α := fun _ : Fin (d+1) ↦ ℝ) r y 0 -
          Fin.cons (α := fun _ : Fin (d+1) ↦ ℝ) s (0 : Fin d → ℝ) 0 =
          Fin.cons (α := fun _ : Fin (d+1) ↦ ℝ) (r-s) y 0
      simp
    · change Fin.cons (α := fun _ : Fin (d+1) ↦ ℝ) r y j.succ -
          Fin.cons (α := fun _ : Fin (d+1) ↦ ℝ) s (0 : Fin d → ℝ) j.succ =
          Fin.cons (α := fun _ : Fin (d+1) ↦ ℝ) (r-s) y j.succ
      simp
  change physicsFourier (fun y ↦ f.1 ((MassShell.split d).symm (r,y) - a)) k = _
  simp_rw [hsub]
  by_cases h : s < r
  · rw [positiveTimeTranslate, ite_eq_left h]
    rfl
  · have hz (y : MassShell.Space d) : f.1 ((MassShell.split d).symm (r-s,y)) = 0 := by
      apply f.2
      have ht : ((MassShell.split d).symm (r-s,y)) 0 = r-s :=
        congrArg Prod.fst ((MassShell.split d).apply_symm_apply (r-s,y))
      linarith
    rw [positiveTimeTranslate, ite_eq_right h, physicsFourier_integral]
    simp [hz]

/-- Positive normal translation of the original real smear induces the massive
one-particle Euclidean semigroup. -/
theorem physicalFeatureL_shiftPositiveTest {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (s : ℝ) (hs : 0 ≤ s) (f : positiveSchwartz d) :
    oneParticleShift volume (modeDispersion m) (modeDispersion_measurable m)
      (fun _k ↦ Real.sqrt_nonneg _) s hs (physicalFeatureL d hħ hm f) =
        physicalFeatureL d hħ hm (shiftPositiveTest s hs f) := by
  apply oneParticleShift_feature hs (physicalTrace f.1) _ _ (physicalFeatureL_ae hħ hm f)
  rw [← physicalTrace_shiftPositiveTest s hs f]
  exact physicalFeatureL_ae hħ hm _

section PhysicalDynamics

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
local notation "H" => Lp ℂ 2 (massiveSpatialLaw d hħ.le hm)
local notation "vol" => (volume : Measure (MassShell.Space d))

/-- The label-preserving conditioned-plane Fock unitary. -/
noncomputable def massiveSpatialFockUnitary : H ≃ₗᵢ[ℂ] momentumFock vol :=
  (massive_spatial_fock_unique d hħ hm).exists.choose

theorem massiveSpatialFockUnitary_wick (f : positiveSchwartz d) :
    massiveSpatialFockUnitary d hħ hm
      (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
      coherentVec vol (Complex.I • physicalFeatureL d hħ.le hm f) :=
  (massive_spatial_fock_unique d hħ hm).exists.choose_spec f

/-- The vacuum is the conditioned preparation of the zero test. -/
theorem massiveSpatialFockUnitary_vacuum :
    massiveSpatialFockUnitary d hħ hm
      (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm 0)) =
      fockVacuum vol := by
  rw [massiveSpatialFockUnitary_wick, map_zero, smul_zero, fockVacuum]

/-- Actual conditionally prepared Wick vectors span the full spatial-law L². -/
theorem massiveConditionedWick_dense :
    Dense (Submodule.span ℂ (Set.range (fun f ↦ conditionedMassivePreparation d hħ.le hm
      (massiveWickPreparation d hħ hm f))) : Set H) := by
  let U := massiveSpatialFockUnitary d hħ hm
  let M := wickMomentum (physicalFeatureL d hħ.le hm)
  let A (f : positiveSchwartz d) := coherentVec vol (M f)
  have hD := Submodule.dense_iff_topologicalClosure_eq_top.mpr (coherentVec_realLabels_dense vol M
    (wickMomentum_dense _ (physicalFeatureL_dense hħ hm)))
  have h := dense_conditioned_labels A hD U.symm.toContinuousLinearEquiv.toContinuousLinearMap U.symm.surjective
  have hid : U.symm.toContinuousLinearEquiv.toContinuousLinearMap ∘ A =
      fun f ↦ conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f) := by
    funext f
    exact U.symm_apply_eq.mpr (massiveSpatialFockUnitary_wick d hħ hm f).symm
  rwa [hid] at h

/-- Euclidean evolution on the actual plane-law L², conjugate to the Fock contraction. -/
noncomputable def massiveSpatialShift (s : ℝ) (hs : 0 ≤ s) : H →L[ℂ] H :=
  let U := massiveSpatialFockUnitary d hħ hm
  U.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
    ((fockShift vol (modeDispersion m) (modeDispersion_measurable m)
      (fun _k ↦ Real.sqrt_nonneg _) s hs).comp U.toContinuousLinearEquiv.toContinuousLinearMap)

/-- On every original Wick preparation this conjugated shift is precisely forward
translation of the test before conditioning. -/
theorem massiveSpatialShift_wick (s : ℝ) (hs : 0 ≤ s) (f : positiveSchwartz d) :
    massiveSpatialShift d hħ hm s hs
      (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
      conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm (shiftPositiveTest s hs f)) := by
  let U := massiveSpatialFockUnitary d hħ hm
  let T := fockShift vol (modeDispersion m) (modeDispersion_measurable m)
      (fun _k ↦ Real.sqrt_nonneg _) s hs
  apply U.injective
  change U (U.symm (T (U _))) = U _
  rw [U.apply_symm_apply]
  let v := physicalFeatureL d hħ.le hm f
  let v' := physicalFeatureL d hħ.le hm (shiftPositiveTest s hs f)
  calc
    _ = T (coherentVec vol (Complex.I • v)) :=
      congrArg T (massiveSpatialFockUnitary_wick d hħ hm f)
    _ = coherentVec vol (oneParticleShift vol (modeDispersion m) (modeDispersion_measurable m)
        (fun _k ↦ Real.sqrt_nonneg _) s hs (Complex.I • v)) :=
      fockShift_coherent _ _ _ _ _ _ _
    _ = coherentVec vol (Complex.I • v') := by
      rw [map_smul]
      exact congrArg (fun z : Momentum d ↦ coherentVec vol (Complex.I • z))
        (physicalFeatureL_shiftPositiveTest hħ.le hm s hs f)
    _ = _ := (massiveSpatialFockUnitary_wick d hħ hm (shiftPositiveTest s hs f)).symm

/-- The bounded operator implementing translated physical preparations is unique. -/
theorem massiveSpatialShift_unique (s : ℝ) (hs : 0 ≤ s) (T : H →L[ℂ] H)
    (h : ∀ f : positiveSchwartz d, T
      (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
      conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm (shiftPositiveTest s hs f))) :
    T = massiveSpatialShift d hħ hm s hs := by
  apply ContinuousLinearMap.ext_on (massiveConditionedWick_dense d hħ hm)
  rintro _ ⟨f,rfl⟩
  exact (h f).trans (massiveSpatialShift_wick d hħ hm s hs f).symm

end PhysicalDynamics

end DotProduct.Extension


/-! ### Fields in the unitary transverse Fourier convention -/

namespace DotProduct.Extension

open MeasureTheory
open scoped SchwartzMap InnerProductSpace

/-- Angular-frequency unitary normalization for the transverse Fourier transform. -/
noncomputable def transverseScale (d : ℕ) : ℝ := (2 * Real.pi) ^ (-(d : ℝ) / 2)

/-- The positive-energy feature with the transverse unitary Fourier convention of (7). -/
noncomputable def unitaryShellFeature (d : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(Spacetime d, ℂ)) : Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  shellFeature d ħ m hħ hm ((transverseScale d : ℂ) • f)

theorem unitaryShellFeature_ae (d : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(Spacetime d, ℂ)) : ⇑(unitaryShellFeature d ħ m hħ hm f) =ᵐ[volume]
    fun k ↦ (Real.sqrt (ħ / (2 * modeDispersion m k)) : ℂ) * ((transverseScale d : ℂ) *
      ∫ p : Spacetime d, Complex.exp (Complex.I * ((p.1 * modeDispersion m k -
        inner ℝ p.2 k : ℝ) : ℂ)) * f p) := by
  filter_upwards [shellFeature_apply_ae d ħ m hħ hm ((transverseScale d : ℂ) • f)] with k hk
  refine hk.trans ?_
  congr 1
  rw [← integral_const_mul]
  apply integral_congr_ae
  exact ae_of_all _ fun p ↦ mul_left_comm _ _ _

/-- The paper's field in angular momentum coordinates with Lebesgue measure on each sector. -/
noncomputable def unitaryWightmanField (d : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(Spacetime d, ℂ)) :=
  (transverseScale d : ℂ) • wightmanField d ħ m hħ hm f

theorem unitaryWightmanField_apply (d : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(Spacetime d, ℂ)) (ψ : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
    unitaryWightmanField d ħ m hħ hm f ψ = (transverseScale d : ℂ) • wightmanField d ħ m hħ hm f ψ := rfl

theorem unitaryWightmanField_real_formula (d : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(Spacetime d, ℝ)) (ψ : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
    let u := unitaryShellFeature d ħ m hħ hm (FeatureDensity.ofRealSchwartz f)
    unitaryWightmanField d ħ m hħ hm (FeatureDensity.ofRealSchwartz f) ψ = contField volume u u ψ := by
  let v := shellFeatureReal d ħ m hħ hm f
  let c := (transverseScale d : ℂ)
  have hu : unitaryShellFeature d ħ m hħ hm (FeatureDensity.ofRealSchwartz f) = c • v :=
    (shellFeatureCLM d ħ m hħ hm).map_smul c _
  let X := FiniteParticleFock (volume : Measure (MassShell.Space d))
  let u := unitaryShellFeature d ħ m hħ hm (FeatureDensity.ofRealSchwartz f)
  have hW := congrArg (fun W : X →ₗ[ℂ] X ↦ c • W ψ) (wightmanField_ofReal d ħ m hħ hm f)
  have h₁ := contCreate_smul_test (volume : Measure (MassShell.Space d)) c v ψ
  have h₂ := contAnnihil_smul_test (volume : Measure (MassShell.Space d)) c v ψ
  have h₂' : contAnnihil volume (c • v) ψ = c • contAnnihil volume v ψ :=
    h₂.trans (congrArg (fun a : ℂ ↦ a • contAnnihil volume v ψ) (Complex.conj_ofReal _))
  exact hW.trans ((smul_add c (contCreate volume v ψ) (contAnnihil volume v ψ)).trans
    ((congrArg₂ (·+·) h₁ h₂').symm.trans
      (congrArg (fun w ↦ contField volume w w ψ) hu.symm)))

theorem unitaryWightmanField_tempered (d : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (φ ψ : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
    Continuous (fun f : 𝓢(Spacetime d, ℂ) ↦ inner ℂ φ.1 (unitaryWightmanField d ħ m hħ hm f ψ).1) := by
  let T := fun f : 𝓢(Spacetime d, ℂ) ↦ inner ℂ φ.1 (wightmanField d ħ m hħ hm f ψ).1
  convert (continuous_const.mul (wightman_matrixElement_continuous d ħ m hħ hm φ ψ) :
    Continuous (fun f ↦ (transverseScale d : ℂ) * T f)) using 1
  funext f
  exact inner_smul_right _ _ _

theorem unitaryWightmanField_covariant (n : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : PoincareGroup (n+1)) (f : 𝓢(Spacetime (n+1), ℂ))
    (ψ : FiniteParticleFock (volume : Measure (MassShell.Space (n+1)))) :
    secondQuantizeFin volume (poincareUnitary n m hm g)
      (unitaryWightmanField (n+1) ħ m hħ hm f ψ) =
    unitaryWightmanField (n+1) ħ m hħ hm (poincareSchwartz g f)
      (secondQuantizeFin volume (poincareUnitary n m hm g) ψ) := by
  let c := (transverseScale (n+1) : ℂ)
  let W := wightmanField (n+1) ħ m hħ hm
  let U := secondQuantizeFin volume (poincareUnitary n m hm g)
  exact (U.map_smul c (W f ψ)).trans (congrArg (c • ·)
    (fockPoincare_intertwines_wightmanField n ħ m hħ hm g f ψ))

theorem unitaryWightmanField_symmetric (d : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(Spacetime d, ℝ)) (φ ψ : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
    inner ℂ (unitaryWightmanField d ħ m hħ hm (FeatureDensity.ofRealSchwartz f) φ).1 ψ.1 =
    inner ℂ φ.1 (unitaryWightmanField d ħ m hħ hm (FeatureDensity.ofRealSchwartz f) ψ).1 := by
  let c := (transverseScale d : ℂ)
  let W := wightmanField d ħ m hħ hm (FeatureDensity.ofRealSchwartz f)
  change inner ℂ (c • (W φ).1) ψ.1 = inner ℂ φ.1 (c • (W ψ).1)
  exact (inner_smul_left _ _ c).trans ((congrArg₂ (·*·) (Complex.conj_ofReal _)
    (wightmanField_symm_real d ħ m hħ hm f φ ψ)).trans (inner_smul_right _ _ c).symm)

theorem unitaryWightmanField_local {n : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(Spacetime (n+1), ℝ)) (hf : HasCompactSupport f) (hg : HasCompactSupport g)
    (hsep : ∀ p ∈ tsupport f, ∀ q ∈ tsupport g, |p.1 - q.1| < ‖p.2 - q.2‖)
    (ψ : FiniteParticleFock (volume : Measure (MassShell.Space (n+1)))) :
    unitaryWightmanField (n+1) ħ m hħ hm (FeatureDensity.ofRealSchwartz f)
        (unitaryWightmanField (n+1) ħ m hħ hm (FeatureDensity.ofRealSchwartz g) ψ) =
    unitaryWightmanField (n+1) ħ m hħ hm (FeatureDensity.ofRealSchwartz g)
        (unitaryWightmanField (n+1) ħ m hħ hm (FeatureDensity.ofRealSchwartz f) ψ) := by
  let c := (transverseScale (n+1) : ℂ)
  let W := wightmanField (n+1) ħ m hħ hm (FeatureDensity.ofRealSchwartz f)
  let V := wightmanField (n+1) ħ m hħ hm (FeatureDensity.ofRealSchwartz g)
  change c • W (c • V ψ) = c • V (c • W ψ)
  apply congrArg (c • ·)
  exact (W.map_smul c (V ψ)).trans ((congrArg (c • ·) (sub_eq_zero.mp
    (wightman_spacelike_locality hħ hm f g hf hg hsep ψ))).trans (V.map_smul c (W ψ)).symm)

end DotProduct.Extension


/-! ### Vacuum cyclicity of the spacetime-smeared field -/

namespace DotProduct.Extension

open MeasureTheory FourierTransform Set
open scoped SchwartzMap InnerProductSpace ContDiff

set_option maxHeartbeats 800000 in
/-- Every compactly supported smooth transverse frequency profile extends to a spacetime
Schwartz transform whose restriction to the mass shell is that profile. -/
private theorem exists_shell_frequency_extension {d : ℕ} (m : ℝ) (g : MassShell.Space d → ℂ)
    (hg : HasCompactSupport g) (hs : ContDiff ℝ ∞ g) :
    ∃ f : 𝓢(Spacetime d, ℂ), ∀ k,
      (𝓕 (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (WightmanField.spacetimeToL2 d) f))
        (WightmanField.shellEvalPoint d m k) = g k := by
  let E := WithLp 2 (Spacetime d)
  let shell := WightmanField.shellEvalPoint d m
  obtain ⟨R,hR,hK⟩ := (hg.image (WightmanField.shellEvalPoint_continuous d m)).isBounded.subset_closedBall_lt
    0 (0 : E)
  let χ : ContDiffBump (0 : E) := ⟨R,R+1,hR,by linarith⟩
  let kproj : E →L[ℝ] MassShell.Space d := (2*Real.pi) • (WithLp.sndL 2 ℝ ℝ (MassShell.Space d))
  let G : E → ℂ := (χ : E → ℝ) • (g ∘ kproj)
  have hGC : HasCompactSupport G := χ.hasCompactSupport.smul_right
  have hGS : ContDiff ℝ ∞ G := χ.contDiff.smul (hs.comp kproj.contDiff)
  let A := hGC.toSchwartzMap hGS
  obtain ⟨v,hv⟩ := (fourierEquiv ℂ (SchwartzMap E ℂ)).surjective A
  let B := WightmanField.spacetimeToL2 d
  let f := SchwartzMap.compCLMOfContinuousLinearEquiv ℂ B.symm v
  have hf : SchwartzMap.compCLMOfContinuousLinearEquiv ℂ B f = v := by
    ext x
    change v (B.symm (B x)) = v x
    rw [B.symm_apply_apply]
  refine ⟨f, fun k ↦ ?_⟩
  change 𝓕 (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ B f) (shell k) = g k
  change 𝓕 v = A at hv
  rw [hf,hv]
  change χ (shell k) • g (kproj (shell k)) = g k
  have hk : kproj (shell k) = k := by
    change (2 * Real.pi) • ((2 * Real.pi)⁻¹ • k) = k
    rw [smul_smul,mul_inv_cancel₀ (by positivity),one_smul]
  rw [hk]
  by_cases hz : g k = 0
  · simp [hz]
  · rw [χ.one_of_mem_closedBall (hK ⟨k,subset_tsupport g hz,rfl⟩),one_smul]

/-- The positive-energy shell restrictions of the original real spacetime Schwartz smears
have dense complex span in the full transverse one-particle space. -/
theorem shellFeatureReal_spacetime_dense (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    Dense (Submodule.span ℂ (Set.range (shellFeatureReal d ħ m hħ.le hm)) :
      Set (Lp ℂ 2 (volume : Measure (MassShell.Space d)))) := by
  let Q := shellFeatureCLM d ħ m hħ.le hm
  let J := shellFeatureReal d ħ m hħ.le hm
  let K := (Submodule.span ℂ (Set.range J)).topologicalClosure
  have hQ (f : 𝓢(Spacetime d, ℂ)) : Q f ∈ K := by
    rw [FeatureDensity.schwartz_re_add_im f,map_add,map_smul]
    exact Submodule.le_topologicalClosure _ (Submodule.add_mem _
      (Submodule.subset_span ⟨FeatureDensity.reSchwartz f, rfl⟩)
      (Submodule.smul_mem _ _ (Submodule.subset_span ⟨FeatureDensity.imSchwartz f,rfl⟩)))
  let b := planeSpatialWeight (d := d) ħ m
  let hb := planeSpatialWeight_bound (d := d) hħ.le hm
  let M := realMultiplier b hb
  have hclosed : IsClosed (K : Set (Lp ℂ 2 (volume : Measure (MassShell.Space d)))) :=
    Submodule.isClosed_topologicalClosure _
  have hM (u : Lp ℂ 2 (volume : Measure (MassShell.Space d))) : M u ∈ K := by
    refine (Lp.dense_hasCompactSupport_contDiff (E := MassShell.Space d) (F := ℂ) (μ := volume)
      (by norm_num : (2 : ENNReal) ≠ ⊤)).induction ?_ (hclosed.preimage M.continuous) u
    rintro v ⟨g,hv,hg,hs⟩
    obtain ⟨f,hf⟩ := exists_shell_frequency_extension m g hg hs
    have heq : M v = Q f := by
      apply Lp.ext
      filter_upwards [realMultiplier_apply_ae b hb v,hv,
        WightmanField.shellRestrict_apply_ae d ħ m hħ.le hm
          (𝓕 (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (WightmanField.spacetimeToL2 d) f))] with k h₁ h₂ h₃
      change Q f k = (b k : ℂ) * _ at h₃
      exact h₁.trans ((congrArg (fun z : ℂ ↦ (b k : ℂ) * z) (h₂.trans (hf k).symm)).trans h₃.symm)
    exact heq ▸ hQ f
  have hMdense := denseRange_of_realMultiplier M b (realMultiplier_apply_ae b hb)
    (ae_of_all _ fun k ↦ (planeSpatialWeight_pos hħ hm k).ne')
  intro v
  exact closure_minimal (by rintro _ ⟨u,rfl⟩; exact hM u) hclosed (hMdense v)

/-- The geometric spacetime-smeared field already has the cyclic vacuum on the
original real Schwartz test space. -/
theorem wightmanField_spacetime_cyclic (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    (Submodule.span ℂ (Set.range fun l : List (𝓢(Spacetime d, ℝ)) ↦
      (l.foldl (fun ψ f ↦ wightmanField d ħ m hħ.le hm (FeatureDensity.ofRealSchwartz f) ψ)
        (fockVacuumFin (volume : Measure (MassShell.Space d)))).1)).topologicalClosure = ⊤ := by
  simp_rw [wightmanField_ofReal]
  exact contField_vacuum_cyclic volume (shellFeatureReal d ħ m hħ.le hm).toLinearMap
    (shellFeatureReal_spacetime_dense d hħ hm)

private theorem shellFeatureReal_scaled_dense (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    let J := (transverseScale d) • (shellFeatureReal d ħ m hħ.le hm)
    Dense (Submodule.span ℂ (Set.range J) : Set (Lp ℂ 2 (volume : Measure (MassShell.Space d)))) := by
  intro J
  have hn : transverseScale d ≠ 0 := (Real.rpow_pos_of_pos (by positivity) _).ne'
  apply (shellFeatureReal_spacetime_dense d hħ hm).mono
  apply Submodule.span_mono
  rintro _ ⟨a,rfl⟩
  refine ⟨(transverseScale d)⁻¹ • a, ?_⟩
  change transverseScale d • shellFeatureReal d ħ m hħ.le hm ((transverseScale d)⁻¹ • a) = _
  rw [map_smul,smul_smul,mul_inv_cancel₀ hn,one_smul]

/-- Real spacetime-smeared Wightman field polynomials applied to the vacuum are
total, in the transverse unitary Fourier normalization of the paper. -/
theorem unitaryWightmanField_spacetime_cyclic (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    (Submodule.span ℂ (Set.range fun l : List (𝓢(Spacetime d, ℝ)) ↦
      (l.foldl (fun ψ f ↦ unitaryWightmanField d ħ m hħ.le hm (FeatureDensity.ofRealSchwartz f) ψ)
        (fockVacuumFin (volume : Measure (MassShell.Space d)))).1)).topologicalClosure = ⊤ := by
  let J := transverseScale d • shellFeatureReal d ħ m hħ.le hm
  have hfield (f : 𝓢(Spacetime d, ℝ)) :
      unitaryWightmanField d ħ m hħ.le hm (FeatureDensity.ofRealSchwartz f) =
        contField volume (J f) (J f) := by
    apply LinearMap.ext
    intro ψ
    have hh := unitaryWightmanField_real_formula d ħ m hħ.le hm f ψ
    have hu : unitaryShellFeature d ħ m hħ.le hm (FeatureDensity.ofRealSchwartz f) = J f :=
      (shellFeatureCLM d ħ m hħ.le hm).map_smul (transverseScale d : ℂ) _
    exact hh.trans (congrArg (fun v ↦ contField volume v v ψ) hu)
  simp_rw [hfield]
  exact contField_vacuum_cyclic volume J.toLinearMap (shellFeatureReal_scaled_dense d hħ hm)

end DotProduct.Extension


/-! ### The spatial Fourier transform of the continued field -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped SchwartzMap InnerProductSpace

/-- The positive-energy continuation uses the same unitary transverse Fourier
    transform as the Euclidean feature, with oscillatory time integration over ℝ. -/
theorem unitaryShellFeature_spatialFourier {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(Spacetime d, ℝ)) :
    ⇑(unitaryShellFeature d ħ m hħ hm (FeatureDensity.ofRealSchwartz f)) =ᵐ[volume]
      fun k ↦ (Real.sqrt (ħ / (2 * modeDispersion m k)) : ℂ) *
        ∫ t : ℝ, Complex.exp (Complex.I * (t * modeDispersion m k : ℝ)) *
          physicsFourier (fun x ↦ f (t,x)) k := by
  filter_upwards [unitaryShellFeature_ae d ħ m hħ hm (FeatureDensity.ofRealSchwartz f)] with k hk
  refine hk.trans ?_
  congr 1
  let ω := modeDispersion m k
  let F (p : Spacetime d) : ℂ :=
    Complex.exp (Complex.I * ((p.1 * ω - inner ℝ p.2 k : ℝ) : ℂ)) * (f p : ℂ)
  have hi : Integrable F (volume.prod volume) := by
    let fE := SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
      ((MassShell.splitIsometry d).toContinuousLinearEquiv.trans
        (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ (MassShell.Space d))) f
    have hf : Integrable f (volume : Measure (Spacetime d)) :=
      ((MassShell.split_volume d).integrable_comp_emb (MassShell.split d).measurableEmbedding).mp fE.integrable
    refine hf.norm.mono' (by dsimp [F]; fun_prop) ?_
    exact ae_of_all _ fun p ↦ by
      change ‖Complex.exp (Complex.I * ((p.1 * ω - inner ℝ p.2 k : ℝ) : ℂ)) * (f p : ℂ)‖ ≤ ‖f p‖
      rw [norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul, Complex.norm_real]
  change (transverseScale d : ℂ) * (∫ p, F p ∂volume.prod volume) = _
  rw [integral_prod F hi, ← integral_const_mul]
  apply integral_congr_ae
  refine ae_of_all _ fun t ↦ ?_
  dsimp only
  rw [physicsFourier_integral]
  let E := Complex.exp (Complex.I * ((t*ω : ℝ) : ℂ))
  let G (x : MassShell.Space d) := (f (t,x) : ℂ) * Complex.exp (-Complex.I * (inner ℝ x k : ℂ))
  have hp (x : MassShell.Space d) : F (t,x) = E * G x := by
    unfold F E G
    dsimp only
    rw [Complex.ofReal_sub, mul_sub, sub_eq_add_neg, Complex.exp_add]
    have he : -(Complex.I * (inner ℝ x k : ℂ)) = -Complex.I * (inner ℝ x k : ℂ) := by ring
    rw [he]
    ring
  simp_rw [hp, integral_const_mul]
  change _ * (E * ∫ x, G x) = E * ((transverseScale d : ℂ) * ∫ x, G x)
  ring

end DotProduct.Extension


/-! ### Higher-degree obstruction on original spacetime Schwartz tests -/

namespace DotProduct.Extension

open MeasureTheory Set
open scoped SchwartzMap ComplexConjugate

private theorem normalized_reflected_product (c : ℝ) (a z : ℂ) :
    (conj ((c : ℂ) * conj a * z) * ((c : ℂ) * a * z)).re = c^2 * ‖z‖^2 * (a^2).re := by
  simp only [map_mul,Complex.conj_ofReal,Complex.conj_conj]
  have he : (c * a * conj z) * ((c : ℂ) * a * z) =
      ((c^2 * ‖z‖^2 : ℝ) : ℂ) * a^2 := by
    rw [Complex.ofReal_mul,Complex.ofReal_pow,Complex.sq_norm,← Complex.mul_conj]
    ring
  rw [he,Complex.re_ofReal_mul]

private theorem normalTransform_neg (h : ℝ → ℝ) (q : ℝ) :
    normalTransform h (-q) = conj (normalTransform h q) := by
  rw [normalTransform,normalTransform,← integral_conj]
  exact integral_congr_ae (ae_of_all _ fun s ↦ by simp [← Complex.exp_conj])

/-- The degree obstruction evaluated on an actual positive-time, real spacetime
Schwartz smear, with the released radial polynomial on the entire momentum space. -/
theorem original_spacetime_polynomial_nogo {d : ℕ} {ħ : ℝ} (hħ : 0 < ħ) (P : Polynomial ℝ)
    (hdeg : 2 ≤ P.natDegree) (hpos : ∀ u : ℝ, 0 ≤ u → 0 < P.eval u)
    (g : 𝓢(MassShell.Space d, ℝ)) (hg : g ≠ 0) :
    ∃ h : 𝓢(ℝ, ℝ), HasCompactSupport (h : ℝ → ℝ) ∧
      tsupport (separatedEuclideanSchwartz h g : MassShell.Space (d+1) → ℝ) ⊆ {x | 0 < x 0} ∧
      ħ * (∫ p : MassShell.Space (d+1),
        (conj (physicsFourier (reflectSchwartz d (separatedEuclideanSchwartz h g)) p) *
          physicsFourier (separatedEuclideanSchwartz h g) p).re / P.eval (‖p‖^2)) < 0 := by
  let G := physicsFourierSchwartz d g
  have hint : Integrable (fun k ↦ ‖physicsFourier g k‖^2) := by
    change Integrable (fun k ↦ ‖G k‖^2)
    exact (memLp_two_iff_integrable_sq_norm G.continuous.aestronglyMeasurable).mp (G.memLp 2 volume)
  have hn : ∃ x, g x ≠ 0 := by
    by_contra! hx
    exact hg (SchwartzMap.ext fun x ↦ hx x)
  obtain ⟨x,hx⟩ := hn
  have hi : 0 < ∫ k, ‖physicsFourier g k‖^2 := by
    rw [physicsFourier_plancherel]
    exact integral_pos_of_integrable_nonneg_nonzero (x := x) (g.continuous.norm.pow 2)
      ((memLp_two_iff_integrable_sq_norm g.continuous.aestronglyMeasurable).mp (g.memLp 2 volume))
      (fun _ ↦ sq_nonneg _) (pow_ne_zero 2 (norm_ne_zero_iff.mpr hx))
  obtain ⟨h,hs,hc,ht,hneg⟩ := smooth_normal_nogo_unconditional hħ P hdeg hpos (physicsFourier g) hint hi
  let H := hc.toSchwartzMap hs
  let F := separatedEuclideanSchwartz H g
  refine ⟨H,hc,?_,?_⟩
  · have c : Continuous (fun x : MassShell.Space (d+1) ↦ x 0) := (EuclideanSpace.proj 0).continuous
    apply subset_trans (b := (fun x : MassShell.Space (d+1) ↦ x 0) ⁻¹' tsupport h) _ (preimage_mono ht)
    apply closure_minimal _ ((isClosed_tsupport h).preimage c)
    intro x hx
    apply subset_tsupport
    intro hz
    apply hx
    change h (x 0) * _ = 0
    rw [hz,zero_mul]
  · let K (z : MassShell.Space d × ℝ) := ‖physicsFourier g z.1‖^2 *
        ((normalTransform h z.2 ^ 2).re / P.eval (z.2^2 + ‖z.1‖^2))
    let K' (z : ℝ × MassShell.Space d) := K z.swap
    have hp (p : MassShell.Space (d+1)) :
        (conj (physicsFourier (reflectSchwartz d F) p) * physicsFourier F p).re / P.eval (‖p‖^2) =
          (2 * Real.pi)⁻¹ * K' (MassShell.split d p) := by
      rw [physicsFourier_reflectSchwartz]
      dsimp only [F]
      rw [physicsFourier_separated,physicsFourier_separated]
      have hh := (MassShell.split d).apply_symm_apply (-p 0, MassShell.tail p)
      have hh1 := congrArg Prod.fst hh
      have hh2 := congrArg Prod.snd hh
      change (MassShell.split d).symm (-p 0,MassShell.tail p) 0 = -p 0 at hh1
      change MassShell.tail ((MassShell.split d).symm (-p 0,MassShell.tail p)) = MassShell.tail p at hh2
      rw [hh1,hh2,normalTransform_neg,normalized_reflected_product,normalFourierScale_sq,MassShell.norm_sq_split]
      change _ = (2 * Real.pi)⁻¹ * (‖physicsFourier g (MassShell.tail p)‖^2 *
        ((normalTransform H (p 0)^2).re / P.eval ((p 0)^2 + ‖MassShell.tail p‖^2)))
      ring
    change ħ * (∫ p, (conj (physicsFourier (reflectSchwartz d F) p) * physicsFourier F p).re / P.eval (‖p‖^2)) < 0
    simp_rw [hp]
    rw [integral_const_mul, (MassShell.split_volume d).integral_comp' K']
    have hswap : (∫ z, K' z) = ∫ z, K z := by
      simp only [Measure.volume_eq_prod]
      exact integral_prod_swap K
    rw [hswap,← mul_assoc]
    exact hneg

end DotProduct.Extension


/-! ### The time derivative of the plane label -/

namespace DotProduct.Extension

open MeasureTheory Filter Topology
open scoped SchwartzMap

/-- The time derivative used in the spatial commutator is the strong derivative of the
physically evolved equal-time reading, with the Heisenberg sign convention. -/
theorem plane_observation_time_derivative {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) :
    HasDerivAt (fun t : ℝ ↦ oneParticleUnitary volume (modeDispersion m)
      (modeDispersion_measurable m) (-t) (planePositionMomentumLabel hħ hm g))
      (planeDerivativeMomentumLabel hħ hm g) 0 := by
  let v := planePositionMomentumLabel hħ hm g
  let w := planeDerivativeMomentumLabel hħ hm g
  let ω := modeDispersion (d := d) m
  let φ (t : ℝ) := MomentumFock.unitaryWeight ω (-t)
  let U (t : ℝ) := oneParticleUnitary volume ω (modeDispersion_measurable m) (-t) v
  let D (t : ℝ) := t⁻¹ • (U t - v) - w
  let a (k : MassShell.Space d) := Complex.I * (ω k : ℂ)
  let F (t : ℝ) (k : MassShell.Space d) := ‖(t⁻¹ • (φ t k - 1) - a k) * v k‖ ^ 2
  have hU (t : ℝ) : ⇑(U t) =ᵐ[volume] fun k ↦ φ t k * v k :=
    FeatureDensity.complexMultiplier_apply_ae _ _ _
  have hw : ⇑w =ᵐ[volume] fun k ↦ a k * v k := planeDerivativeMomentumLabel_ae hħ hm g
  have hF (t : ℝ) : (fun k ↦ ‖D t k‖ ^ 2) =ᵐ[volume] F t := by
    filter_upwards [Lp.coeFn_sub (t⁻¹ • (U t - v)) w, Lp.coeFn_smul t⁻¹ (U t - v),
      Lp.coeFn_sub (U t) v, hU t, hw] with k hd hs hu hp hv
    change ‖(t⁻¹ • (U t - v) - w) k‖^2 = _
    rw [hd, Pi.sub_apply, hs, Pi.smul_apply, hu, Pi.sub_apply, hp, hv]
    dsimp only [F]
    congr 2
    simp only [Complex.real_smul]
    ring
  have hFmeas (t : ℝ) : AEStronglyMeasurable (F t) volume :=
    (((Lp.aestronglyMeasurable (D t)).norm).pow 2).congr (hF t)
  have ha (k : MassShell.Space d) : -(↑(-ω k) : ℂ) * Complex.I = a k := by
    simp [a, mul_comm]
  have hφ (t : ℝ) (k : MassShell.Space d) :
      Complex.exp (((-(t * (-ω k)) : ℝ) : ℂ) * Complex.I) = φ t k := by
    simp [φ, MomentumFock.unitaryWeight]
  have hbound (t : ℝ) : ∀ᵐ k ∂volume, ‖F t k‖ ≤ 4 * ‖w k‖^2 := by
    filter_upwards [hw] with k hk
    have h := MomentumFockDomH.phase_diff_bound (-ω k) t
    rw [hφ,ha,abs_neg] at h
    have h' := mul_le_mul_of_nonneg_right h (norm_nonneg (v k))
    calc
      ‖F t k‖ = (‖t⁻¹ • (φ t k - 1) - a k‖ * ‖v k‖)^2 := by
        dsimp only [F]
        rw [Real.norm_of_nonneg (sq_nonneg _), norm_mul]
      _ ≤ (2 * |ω k| * ‖v k‖)^2 := pow_le_pow_left₀ (by positivity) h' 2
      _ = 4 * ‖w k‖^2 := by rw [hk]; simp [a, Complex.norm_real]; ring
  have hlim : ∀ᵐ k ∂volume, Tendsto (fun t : ℝ ↦ F t k) (𝓝[≠] 0) (𝓝 0) := by
    refine ae_of_all _ fun k ↦ ?_
    have h : Tendsto (fun t : ℝ ↦ t⁻¹ • (φ t k - 1)) (𝓝[≠] 0) (𝓝 (a k)) := by
      have hh := (MomentumFockDomH.hasDerivAt_phase (-ω k)).tendsto_slope_zero
      simpa only [zero_add,zero_mul,neg_zero,Complex.ofReal_zero,Complex.exp_zero,hφ,ha] using hh
    simpa [F] using ((h.sub (tendsto_const_nhds (x := a k))).mul_const (v k)).norm.pow 2
  have hsq : Tendsto (fun t : ℝ ↦ ‖D t‖ ^ 2) (𝓝[≠] 0) (𝓝 0) := by
    have ht : Tendsto (fun t : ℝ ↦ ∫ k, F t k) (𝓝[≠] 0) (𝓝 0) := by
      simpa only [integral_zero] using tendsto_integral_filter_of_dominated_convergence
        (fun k ↦ 4 * ‖w k‖^2) (Eventually.of_forall hFmeas) (Eventually.of_forall hbound)
        (((memLp_two_iff_integrable_sq_norm (Lp.aestronglyMeasurable w)).mp (Lp.memLp w)).const_mul 4) hlim
    refine ht.congr fun t ↦ ?_
    rw [FeatureDensity.l2_norm_sq_eq_integral,integral_congr_ae (hF t)]
  have hzero : U 0 = v := by
    apply Lp.ext
    filter_upwards [hU 0] with k hk
    simpa [φ,MomentumFock.unitaryWeight] using hk
  change HasDerivAt U w 0
  rw [hasDerivAt_iff_tendsto_slope_zero,tendsto_iff_norm_sub_tendsto_zero]
  simpa [hzero,D] using ((Real.continuous_sqrt.continuousAt (x := 0)).tendsto.comp hsq).congr
    fun t ↦ Real.sqrt_sq (norm_nonneg (D t))
end DotProduct.Extension


/-! ### The radial heat kernel and massive Fourier resolvent -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped SchwartzMap InnerProductSpace Topology FourierTransform

/-- The position-space kernel of the resolvent with Lebesgue measure in physical coordinates. -/
noncomputable def euclideanResolventKernel {D : ℕ} (m : ℝ) (x : MassShell.Space D) : ℂ :=
  (((4 * Real.pi) ^ (-(D : ℝ) / 2) : ℝ) : ℂ) * heatKernel D m (‖x‖^2 : ℝ)

private noncomputable def heatSliceCoeff (D : ℕ) (t : ℝ) : ℝ :=
  ((4 * Real.pi * t) ^ ((D : ℝ) / 2))⁻¹

private noncomputable def heatPhaseSlice {D : ℕ} (m : ℝ) (p : MassShell.Space D) (t : ℝ)
    (x : MassShell.Space D) : ℂ :=
  (heatSliceCoeff D t * Real.exp (-m^2*t) : ℝ) *
    Complex.exp (-(((4*t)⁻¹ : ℝ) : ℂ) * (‖x‖ : ℂ)^2 + -Complex.I * (inner ℝ p x : ℂ))

private theorem heatSliceCoeff_split (D : ℕ) {t : ℝ} (ht : 0 < t) :
    heatSliceCoeff D t = (4*Real.pi)^(-(D:ℝ)/2) * t^(-(D:ℝ)/2) := by
  unfold heatSliceCoeff
  rw [show -(D:ℝ)/2 = -((D:ℝ)/2) by ring, Real.rpow_neg (by positivity), Real.rpow_neg ht.le,
    Real.mul_rpow (by positivity) ht.le, mul_inv]

private theorem heatPhaseSlice_integrable {D : ℕ} (m : ℝ) (p : MassShell.Space D) {t : ℝ} (ht : 0 < t) :
    Integrable (heatPhaseSlice m p t) :=
  (GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
    (show 0 < ((((4*t)⁻¹ : ℝ) : ℂ)).re from by simpa using (by positivity : 0 < (4*t)⁻¹))
    (-Complex.I) p).const_mul _

private theorem heatPhaseSlice_integral {D : ℕ} (m : ℝ) (p : MassShell.Space D) {t : ℝ} (ht : 0 < t) :
    ∫ x, heatPhaseSlice m p t x = (Real.exp (-(m^2+‖p‖^2)*t) : ℂ) := by
  have hb : 0 < (4*t)⁻¹ := by positivity
  unfold heatPhaseSlice
  rw [integral_const_mul, GaussianFourier.integral_cexp_neg_mul_sq_norm_add
    (show 0 < ((((4*t)⁻¹ : ℝ) : ℂ)).re from hb)]
  have hexp : (-Complex.I)^2 * (‖p‖ : ℂ)^2 / (4 * (((4*t)⁻¹ : ℝ) : ℂ)) =
      ((-‖p‖^2*t : ℝ) : ℂ) := by
    push_cast
    rw [neg_sq, Complex.I_sq]
    field_simp [Complex.ofReal_ne_zero.mpr ht.ne']
  have hp : (Real.pi : ℂ) / (((4*t)⁻¹ : ℝ) : ℂ) = ((4*Real.pi*t : ℝ) : ℂ) := by
    rw [← Complex.ofReal_div]
    congr 1
    rw [div_inv_eq_mul]; ring
  rw [hp, hexp, finrank_euclideanSpace_fin]
  have hr : ((D:ℂ)/2) = (((D:ℝ)/2:ℝ):ℂ) := by push_cast; rfl
  rw [hr, ← Complex.ofReal_cpow (by positivity : 0 ≤ 4*Real.pi*t), ← Complex.ofReal_exp]
  norm_cast
  unfold heatSliceCoeff
  have hpos : (4*Real.pi*t)^((D:ℝ)/2) ≠ 0 := (Real.rpow_pos_of_pos (by positivity) _).ne'
  rw [show -(m^2+‖p‖^2)*t = -m^2*t + -‖p‖^2*t by ring, Real.exp_add]
  field_simp

private theorem heatPhaseSlice_norm {D : ℕ} (m : ℝ) (p : MassShell.Space D) {t : ℝ} (ht : 0 < t)
    (x : MassShell.Space D) :
    ‖heatPhaseSlice m p t x‖ = heatSliceCoeff D t * Real.exp (-m^2*t) *
      Real.exp (-((4*t)⁻¹) * ‖x‖^2) := by
  unfold heatPhaseSlice
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by unfold heatSliceCoeff; positivity), Complex.norm_exp]
  congr 2
  rw [← Complex.ofReal_pow]
  simp [Complex.mul_re]
  exact Or.inl (by rw [← Complex.ofReal_pow, Complex.ofReal_re])

private theorem heatPhaseSlice_l1 {D : ℕ} (m : ℝ) (p : MassShell.Space D) {t : ℝ} (ht : 0 < t) :
    ∫ x, ‖heatPhaseSlice m p t x‖ = Real.exp (-m^2*t) := by
  simp_rw [heatPhaseSlice_norm m p ht]
  rw [integral_const_mul, GaussianFourier.integral_rexp_neg_mul_sq_norm (by positivity),
    finrank_euclideanSpace_fin, div_inv_eq_mul, show Real.pi * (4*t) = 4*Real.pi*t by ring]
  unfold heatSliceCoeff
  field_simp [ne_of_gt (Real.rpow_pos_of_pos (by positivity : 0 < 4*Real.pi*t) ((D:ℝ)/2))]

private theorem heatPhaseSlice_joint {D : ℕ} {m : ℝ} (hm : 0 < m) (p : MassShell.Space D) :
    Integrable (fun z : ℝ × MassShell.Space D ↦ heatPhaseSlice m p z.1 z.2)
      ((volume.restrict (Ioi (0:ℝ))).prod volume) := by
  have hM : Measurable (fun z : ℝ × MassShell.Space D ↦ heatPhaseSlice m p z.1 z.2) := by
    unfold heatPhaseSlice heatSliceCoeff
    fun_prop
  apply (integrable_prod_iff hM.aestronglyMeasurable).2
  refine ⟨(ae_restrict_mem measurableSet_Ioi).mono (fun t ht ↦ heatPhaseSlice_integrable m p ht), ?_⟩
  apply (integrableOn_exp_mul_Ioi (neg_lt_zero.mpr (sq_pos_of_pos hm)) 0).congr
  filter_upwards [ae_restrict_mem measurableSet_Ioi (μ := (volume : Measure ℝ))] with t ht
  exact (heatPhaseSlice_l1 m p ht).symm

private theorem euclideanResolventKernel_phase {D : ℕ} (m : ℝ) (p x : MassShell.Space D) :
    euclideanResolventKernel m x * Complex.exp (-Complex.I * (inner ℝ x p : ℂ)) =
      ∫ t in Ioi (0:ℝ), heatPhaseSlice m p t x := by
  unfold euclideanResolventKernel heatKernel
  rw [mul_assoc, ← integral_mul_const, ← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  dsimp only
  unfold heatPhaseSlice heatKernelIntegrand
  rw [heatSliceCoeff_split D ht, real_inner_comm p x, Complex.exp_add, Complex.exp_sub]
  push_cast
  have h : Complex.exp (-(↑m ^ 2 * (t:ℂ))) /
      Complex.exp ((‖x‖ : ℂ) ^ 2 / (4*(t:ℂ))) =
    Complex.exp (-(m:ℂ)^2*(t:ℂ)) * Complex.exp (-(4*(t:ℂ))⁻¹ * (‖x‖ : ℂ)^2) := by
    rw [div_eq_mul_inv, ← Complex.exp_neg, neg_mul]
    congr 2
    ring
  rw [h]
  ring

/-- Fubini applied to the Schwinger parameter gives the Euclidean massive Fourier
resolvent, including the full D-dimensional position-space normalization. -/
theorem euclideanResolventKernel_angularFourier {D : ℕ} {m : ℝ} (hm : 0 < m) (p : MassShell.Space D) :
    (∫ x, euclideanResolventKernel m x * Complex.exp (-Complex.I * (inner ℝ x p : ℂ))) =
      ((continuumDispersion m p)⁻¹ : ℝ) := by
  simp_rw [euclideanResolventKernel_phase]
  rw [integral_integral_swap (f := fun (x : MassShell.Space D) (t : ℝ) ↦ heatPhaseSlice m p t x) (heatPhaseSlice_joint hm p).swap]
  have hrewrite := setIntegral_congr_fun (μ := (volume : Measure ℝ)) measurableSet_Ioi
    (f := fun t ↦ ∫ x, heatPhaseSlice m p t x)
    (g := fun t ↦ (Real.exp (-(m^2+‖p‖^2)*t) : ℂ)) (fun _ ht ↦ heatPhaseSlice_integral m p ht)
  rw [hrewrite, integral_complex_ofReal, integral_exp_mul_Ioi (neg_lt_zero.mpr (by positivity : 0 < m^2+‖p‖^2)), mul_zero,
    Real.exp_zero, continuumDispersion]
  congr 1
  rw [div_neg, neg_div, neg_neg, one_div, add_comm]


/-- The normalized Schwinger kernel is integrable in every Euclidean dimension. -/
theorem euclideanResolventKernel_integrable {D : ℕ} {m : ℝ} (hm : 0 < m) :
    Integrable (@euclideanResolventKernel D m) := by
  apply ((heatPhaseSlice_joint hm (0 : MassShell.Space D)).integral_prod_right).congr
  exact ae_of_all _ fun x ↦ by simpa using (euclideanResolventKernel_phase m 0 x).symm

/-- The same multiplier in Mathlib's Fourier convention, whose phase contains `2π`. -/
theorem euclideanResolventKernel_fourier {D : ℕ} {m : ℝ} (hm : 0 < m) (ξ : MassShell.Space D) :
    𝓕 (euclideanResolventKernel m) ξ = (resolventMult m ξ : ℂ) := by
  have h := euclideanResolventKernel_angularFourier hm ((2 * Real.pi) • ξ)
  rw [Real.fourier_eq']
  calc
    _ = ∫ x, euclideanResolventKernel m x * Complex.exp (-Complex.I * (inner ℝ x ((2 * Real.pi) • ξ) : ℂ)) := by
      apply integral_congr_ae
      exact ae_of_all _ fun x ↦ by
        dsimp only
        rw [smul_eq_mul, mul_comm, real_inner_smul_right]
        congr 2
        push_cast
        ring
    _ = _ := by
      rw [h, continuumDispersion, resolventMult, norm_smul, Real.norm_of_nonneg (by positivity), mul_pow]

/-- On every complex Schwartz test, the massive inverse is convolution with the
position-space kernel obtained from the radial Schwinger integral. -/
theorem schwartzResolventC_heatKernel {D : ℕ} {m : ℝ} (hm : 0 < m)
    (g : 𝓢(MassShell.Space D, ℂ)) (x : MassShell.Space D) :
    schwartzResolventC m g x = ∫ y, euclideanResolventKernel m y * g (x - y) := by
  let K := @euclideanResolventKernel D m
  let C := MeasureTheory.convolution K g (ContinuousLinearMap.mul ℂ ℂ) volume
  let S := SchwartzMap.smulLeftCLM ℂ (fun ξ : MassShell.Space D ↦ (resolventMult m ξ : ℂ)) (𝓕 g)
  have hw : (fun ξ : MassShell.Space D ↦ (resolventMult m ξ : ℂ)).HasTemperateGrowth :=
    Complex.hasTemperateGrowth_ofReal.comp (hasTemperateGrowth_resolventMult hm)
  have hK : Integrable K := euclideanResolventKernel_integrable hm
  have hC : Integrable C := hK.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) g.integrable
  have hb : BddAbove (range fun z ↦ ‖g z‖) := by
    refine ⟨SchwartzMap.seminorm ℂ 0 0 g, ?_⟩
    rintro _ ⟨z, rfl⟩
    exact g.norm_le_seminorm ℂ z
  have hcont : Continuous C := hb.continuous_convolution_right_of_integrable (ContinuousLinearMap.mul ℂ ℂ) hK g.continuous
  have hF : 𝓕 C = (S : MassShell.Space D → ℂ) := by
    funext ξ
    rw [show 𝓕 C ξ = 𝓕 K ξ * 𝓕 (g : MassShell.Space D → ℂ) ξ from
      Real.fourier_mul_convolution_eq hK g.integrable ξ]
    rw [show 𝓕 K ξ = (resolventMult m ξ : ℂ) from euclideanResolventKernel_fourier hm ξ]
    exact (SchwartzMap.smulLeftCLM_apply_apply hw (𝓕 g) ξ).symm
  have hinv := hcont.fourierInv_fourier_eq hC (by rw [hF]; exact S.integrable)
  rw [hF, ← SchwartzMap.fourierInv_coe] at hinv
  exact congrFun hinv x

/-- Exact equality between the Gaussian spectral covariance and its double position-space
smearing against the normalized radial Schwinger kernel. -/
theorem continuumCov_heatKernel {D : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (f g : 𝓢(MassShell.Space D, ℝ)) :
    continuumCov ħ m (physicsFourier f) (physicsFourier g) =
      ((ħ * ∫ x, f x * (∫ y, euclideanResolventKernel m y * (g (x-y) : ℂ)).re : ℝ) : ℂ) := by
  rw [continuumCov_eq_resolvent_pairing ħ hm f g]
  congr 2
  apply integral_congr_ae
  exact ae_of_all _ fun x ↦ by
    change f x * (schwartzResolventC m (SchwartzMap.postcompCLM Complex.ofRealCLM g) x).re = _
    rw [schwartzResolventC_heatKernel hm]
    rfl

/-- The coordinate law's mixed second moment uses the same position-space kernel. -/
theorem massiveEuclideanLaw_heatKernel {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(MassShell.Space D, ℝ)) :
    ProbabilityTheory.covariance (fun x ↦ x f) (fun x ↦ x g) (massiveEuclideanLaw D ħ m hħ hm) =
      ħ * ∫ x, f x * (∫ y, euclideanResolventKernel m y * (g (x-y) : ℂ)).re := by
  rw [massiveEuclideanLaw_covariance hħ hm, continuumCov_heatKernel ħ hm, Complex.ofReal_re]

end DotProduct.Extension


/-! ### Complexification of the reflected Schwartz identity -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped SchwartzMap InnerProductSpace

private theorem complexBulkLabel_ae {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (a b : 𝓢(MassShell.Space D, ℝ)) :
    let L := massiveEuclideanLabel D ħ m hħ hm
    ⇑(L a + Complex.I • L b) =ᵐ[volume] fun p ↦ (Real.sqrt (ħ / continuumDispersion m p) : ℂ) *
      (physicsFourier a p + Complex.I * physicsFourier b p) := by
  intro L
  filter_upwards [Lp.coeFn_add (L a) (Complex.I • L b), Lp.coeFn_smul Complex.I (L b),
    massiveEuclideanLabel_apply_ae hħ hm a, massiveEuclideanLabel_apply_ae hħ hm b] with p ha hb hc hd
  change ((L a + Complex.I • L b) p) = L a p + (Complex.I • L b) p at ha
  change (Complex.I • L b) p = Complex.I * L b p at hb
  change L a p = _ at hc
  change L b p = _ at hd
  rw [ha,hb,hc,hd]
  ring

private theorem complexBulkLabel_inner {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (a b c e : 𝓢(MassShell.Space D, ℝ)) :
    let L := massiveEuclideanLabel D ħ m hħ hm
    inner ℂ (L a + Complex.I • L b) (L c + Complex.I • L e) =
      continuumCov ħ m (fun p ↦ physicsFourier a p + Complex.I * physicsFourier b p)
        (fun p ↦ physicsFourier c p + Complex.I * physicsFourier e p) := by
  intro L
  rw [L2.inner_def,continuumCov, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [complexBulkLabel_ae hħ hm a b, complexBulkLabel_ae hħ hm c e] with p hf hg
  change ((L a + Complex.I • L b) p) = _ at hf
  change ((L c + Complex.I • L e) p) = _ at hg
  rw [hf,hg,RCLike.inner_apply,map_mul,Complex.conj_ofReal]
  have hd : 0 ≤ continuumDispersion m p := add_nonneg (sq_nonneg _) (sq_nonneg _)
  have hs : (Real.sqrt (ħ / continuumDispersion m p) : ℂ)^2 =
      (ħ : ℂ) * (continuumDispersion m p : ℂ)⁻¹ := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt (div_nonneg hħ hd), Complex.ofReal_div, div_eq_mul_inv]
  simp only [RCLike.star_def, Complex.ofReal_inv]
  linear_combination (starRingEnd ℂ (physicsFourier a p + Complex.I * physicsFourier b p) *
    (physicsFourier c p + Complex.I * physicsFourier e p)) * hs

/-- Equation (7) for complex positive-time tests written as pairs of real Schwartz
smears. The first slot of the full Fourier covariance conjugates the reflected test. -/
theorem continuumCov_complex_reflected_feature {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f₀ f₁ g₀ g₁ : positiveSchwartz d) :
    continuumCov ħ m
      (fun p ↦ physicsFourier (reflectSchwartz d f₀.1) p +
        Complex.I * physicsFourier (reflectSchwartz d f₁.1) p)
      (fun p ↦ physicsFourier g₀.1 p + Complex.I * physicsFourier g₁.1 p) =
    inner ℂ (physicalFeatureL d hħ hm f₀ + Complex.I • physicalFeatureL d hħ hm f₁)
      (physicalFeatureL d hħ hm g₀ + Complex.I • physicalFeatureL d hħ hm g₁) := by
  rw [← complexBulkLabel_inner hħ hm]
  simp only [inner_add_left,inner_add_right,inner_smul_left,inner_smul_right,
    physical_reflected_inner hħ hm,physicalFeatureL_apply]

/-- Every vector is a limit of actual features of complex positive-time smears. -/
theorem complexPhysicalFeature_denseRange {d : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    DenseRange (fun f : positiveSchwartz d × positiveSchwartz d ↦
      physicalFeatureL d hħ.le hm f.1 + Complex.I • physicalFeatureL d hħ.le hm f.2) := by
  apply (physicalFeatureL_dense hħ hm).mono
  intro u hu
  obtain ⟨a,b,rfl⟩ := MomentumFock.complexSpan_real_decompose volume (physicalFeatureL d hħ.le hm) hu
  exact ⟨(a,b),rfl⟩

end DotProduct.Extension


/-! ### Field matrix elements between coherent vectors -/

namespace DotProduct.Extension

open MeasureTheory
open scoped InnerProductSpace

variable {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ]

private noncomputable def coherentCreation (h v : Lp ℂ 2 μ) : (n : ℕ) → momentumSector μ n
  | 0 => 0
  | n+1 => sectorCreate μ n h (sectorVec μ n v)

private theorem coherentCreation_mem (h v : Lp ℂ 2 μ) : Memℓp (coherentCreation μ h v) 2 := by
  rw [memℓp_gen_iff (by norm_num : 0 < (2 : ENNReal).toReal)]
  simp only [ENNReal.toReal_ofNat,Real.rpow_two]
  apply (summable_nat_add_iff 1).mp
  apply Summable.of_nonneg_of_le (fun n ↦ sq_nonneg _) (f := fun n : ℕ ↦
    ‖h‖^2 * ((2*‖v‖^2)^n / n.factorial))
  · intro n
    change ‖sectorCreate μ n h (sectorVec μ n v)‖^2 ≤ _
    have he : (n+1 : ℕ) ≤ 2^n := n.lt_two_pow_self
    have hR : (n+1 : ℝ) ≤ 2^n := by exact_mod_cast he
    calc
      _ ≤ (Real.sqrt ((n+1 : ℕ) : ℝ) * ‖h‖ * ‖sectorVec μ n v‖)^2 :=
        pow_le_pow_left₀ (norm_nonneg _) (sectorCreate_norm_le μ n h _) 2
      _ = ((n+1 : ℝ) * ‖h‖^2) * ((‖v‖^2)^n / n.factorial) := by
        rw [mul_pow,mul_pow,Real.sq_sqrt (by positivity),sectorVec_norm_sq,Nat.cast_add_one]
      _ ≤ ((2^n : ℝ) * ‖h‖^2) * ((‖v‖^2)^n / n.factorial) := by gcongr
      _ = _ := by rw [mul_pow]; ring
  · exact (Real.summable_pow_div_factorial (2*‖v‖^2)).mul_left _

private theorem field_coherent_split (h v : Lp ℂ 2 μ) :
    sectorFieldApply μ h (coherentVec μ v) =
      coherentCreation μ h v + inner ℂ h v • (fun n ↦ sectorVec μ n v) := by
  funext n
  cases n with
  | zero => exact (sectorAnnihil_sectorVec μ 0 h v).trans (zero_add _).symm
  | succ n =>
    exact congrArg (fun y ↦ sectorCreate μ n h (sectorVec μ n v) + y)
      (sectorAnnihil_sectorVec μ (n+1) h v)

/-- Every coherent vector lies in the maximal domain of the Hermitian Fock field. -/
theorem coherentVec_mem_fockFieldDom (h v : Lp ℂ 2 μ) :
    fockFieldDom μ h (coherentVec μ v) := by
  rw [fockFieldDom,field_coherent_split]
  exact (coherentCreation_mem μ h v).add ((sectorVec_memℓp μ v).const_smul (inner ℂ h v))

private theorem coherentCreation_inner (u h v : Lp ℂ 2 μ) :
    inner ℂ (coherentVec μ u) (⟨coherentCreation μ h v,coherentCreation_mem μ h v⟩ : momentumFock μ) =
      inner ℂ u h * Complex.exp (inner ℂ u v) := by
  let C : momentumFock μ := ⟨coherentCreation μ h v,coherentCreation_mem μ h v⟩
  have hs := (lp.hasSum_inner (𝕜 := ℂ) (coherentVec μ u) C).summable
  change inner ℂ (coherentVec μ u) C = _
  rw [lp.inner_eq_tsum,hs.tsum_eq_zero_add]
  change inner ℂ (sectorVec μ 0 u) 0 + (∑' n : ℕ,
    inner ℂ (sectorVec μ (n+1) u) (sectorCreate μ n h (sectorVec μ n v))) = _
  rw [inner_zero_right,zero_add]
  have hh (n : ℕ) : inner ℂ (sectorVec μ (n+1) u) (sectorCreate μ n h (sectorVec μ n v)) =
      inner ℂ u h * inner ℂ (sectorVec μ n u) (sectorVec μ n v) := by
    have hx := sectorCreate_adjoint_right μ n h (sectorVec μ n v) (sectorVec μ (n+1) u)
    change inner ℂ (sectorVec μ (n+1) u) (sectorCreate μ n h (sectorVec μ n v)) =
      inner ℂ (sectorAnnihil μ n h (sectorVec μ (n+1) u)) (sectorVec μ n v) at hx

    rw [hx,sectorAnnihil_sectorVec]
    change inner ℂ (inner ℂ h u • (sectorVec μ n u).1) (sectorVec μ n v).1 = _
    rw [inner_smul_left,inner_conj_symm]
    rfl
  simp_rw [hh]
  rw [tsum_mul_left, ← coherentVec_gram μ u v,lp.inner_eq_tsum]
  rfl

/-- Matrix elements of the actual unbounded Hermitian Fock field on coherent vectors. -/
theorem coherentVec_fockFieldOp_inner (u h v : Lp ℂ 2 μ) :
    inner ℂ (coherentVec μ u) (fockFieldOp μ h (coherentVec μ v) (coherentVec_mem_fockFieldDom μ h v)) =
      (inner ℂ u h + inner ℂ h v) * Complex.exp (inner ℂ u v) := by
  let C : momentumFock μ := ⟨coherentCreation μ h v,coherentCreation_mem μ h v⟩
  have he : fockFieldOp μ h (coherentVec μ v) (coherentVec_mem_fockFieldDom μ h v) =
      C + inner ℂ h v • coherentVec μ v := lp.ext (field_coherent_split μ h v)
  rw [he,inner_add_right,inner_smul_right,coherentVec_gram,add_mul,← coherentCreation_inner μ u h v]

end DotProduct.Extension


/-! ### Plane-coordinate multiplication on Wick characters -/

namespace DotProduct.Extension

open MeasureTheory Filter Topology Set
open scoped SchwartzMap InnerProductSpace

private theorem gaussian_weighted_phase {Ω H : Type*} [MeasurableSpace Ω] [NormedAddCommGroup H]
    [InnerProductSpace ℝ H] (P : Measure Ω) [IsFiniteMeasure P] (Φ : Ω → H →ₗ[ℝ] ℝ)
    (hm : ∀ v, Measurable (fun w ↦ Φ w v))
    (hc : ∀ v, (∫ w, Complex.exp ((Φ w v : ℂ) * Complex.I) ∂P) = (Real.exp (-‖v‖^2/2) : ℂ))
    (k h : H) (hi : Integrable (fun w ↦ Φ w h) P) :
    (∫ w, (Φ w h : ℂ) * Complex.exp ((Φ w k : ℂ) * Complex.I) ∂P) =
      Complex.I * (inner ℝ k h : ℂ) * (Real.exp (-‖k‖^2/2) : ℂ) := by
  let F (t : ℝ) (w : Ω) := Complex.exp ((Φ w (k + t • h) : ℂ) * Complex.I)
  let D (t : ℝ) (w : Ω) := F t w * ((Φ w h : ℂ) * Complex.I)
  have hF (t : ℝ) : Measurable (F t) :=
    Complex.continuous_exp.measurable.comp ((Complex.continuous_ofReal.measurable.comp
      (hm _)).mul measurable_const)
  have hn (t : ℝ) (w : Ω) : ‖F t w‖ = 1 := Complex.norm_exp_ofReal_mul_I _
  have hd (t : ℝ) (w : Ω) : HasDerivAt (fun s ↦ F s w) (D t w) t := by
    have hr : HasDerivAt (fun s : ℝ ↦ Φ w k + s * Φ w h) (Φ w h) t := by
      simpa using ((hasDerivAt_id t).mul_const (Φ w h)).const_add (Φ w k)
    simpa [F,D,map_add,map_smul,smul_eq_mul] using (hr.ofReal_comp.mul_const Complex.I).cexp
  have hI := (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (x₀ := (0 : ℝ)) (s := univ) (F := F) (F' := D) (bound := fun w ↦ ‖Φ w h‖)
    (μ := P) univ_mem (Eventually.of_forall fun t ↦ (hF t).aestronglyMeasurable)
    ((integrable_const (1 : ℝ)).mono' (hF 0).aestronglyMeasurable (ae_of_all _ fun w ↦ (hn 0 w).le))
    (((hF 0).mul ((Complex.continuous_ofReal.measurable.comp (hm h)).mul measurable_const)).aestronglyMeasurable)
    (ae_of_all _ fun w t _ ↦ by simp [D, hn, Complex.norm_real]) hi.norm
    (ae_of_all _ fun w t _ ↦ hd t w)).2
  have hpath : HasDerivAt (fun s : ℝ ↦ k + s • h) h 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const h).const_add k
  have he := (hpath.norm_sq.neg.div_const 2).exp.ofReal_comp
  have hh : (∫ w, D 0 w ∂P) =
      -((inner ℝ k h : ℝ) : ℂ) * (Real.exp (-‖k‖^2/2) : ℂ) := by
    simp_rw [show (fun t ↦ ∫ w, F t w ∂P) =
      (fun t ↦ (Real.exp (-‖k + t • h‖^2/2) : ℂ)) from funext fun t ↦ hc _] at hI
    have hh := hI.unique he
    simpa [div_eq_mul_inv, mul_assoc,mul_comm,mul_left_comm] using hh
  have hr : (∫ w, D 0 w ∂P) =
      (∫ w, (Φ w h : ℂ) * Complex.exp ((Φ w k : ℂ) * Complex.I) ∂P) * Complex.I := by
    rw [← integral_mul_const]
    apply integral_congr_ae
    exact ae_of_all _ fun w ↦ by simp [D,F,mul_comm,mul_assoc]
  rw [hr] at hh
  apply (mul_right_cancel₀ Complex.I_ne_zero)
  rw [hh]
  linear_combination (norm := ring) -(inner ℝ k h : ℂ) * (Real.exp (-‖k‖^2/2) : ℂ) * Complex.I_sq


section PlaneMultiplication

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
local notation "B" => massiveEuclideanBasis (d+1)
local notation "P" => standardGaussianProduct (massiveEuclideanBasisSet (d+1))
local notation "Φ" => pointwiseGaussian B
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d hħ hm)
local notation "Q" => massiveSpatialLaw d hħ hm
local notation "T" => 𝓢(MassShell.Space d, ℝ)
local notation "W" => wickCoordinate Q L

private theorem planeCoord_memLp (h : T) : MemLp (fun x : T → ℝ ↦ x h) 2 Q := by
  apply (memLp_map_measure_iff (measurable_pi_apply h).aestronglyMeasurable
    (measurable_readingCoordinates Φ (pointwiseGaussian_measurable B) L).aemeasurable).mpr
  exact (memLp_congr_ae (pointwiseGaussian_ae B (L h))).mpr (Lp.memLp (gaussianIsonormal B (L h)))

private theorem planeCoordWick_memLp (h b : T) : MemLp (fun x : T → ℝ ↦ (x h : ℂ) * W b x) 2 Q := by
  let c := Real.exp (‖L b‖^2 / 2)
  apply ((planeCoord_memLp d hħ hm h).norm.const_mul c).mono
    ((Complex.continuous_ofReal.measurable.comp (measurable_pi_apply h)).aestronglyMeasurable.mul
      (Lp.aestronglyMeasurable (W b)))
  filter_upwards [wickCoordinate_ae Q L b] with x hx
  change ‖(x h : ℂ) * W b x‖ ≤ ‖c * ‖x h‖‖
  rw [hx,norm_mul,Complex.norm_exp,Complex.add_re,Complex.ofReal_re,Complex.mul_I_re,
    Complex.ofReal_im, neg_zero,add_zero,Complex.norm_real,
    Real.norm_of_nonneg (mul_nonneg (Real.exp_pos _).le (norm_nonneg _))]
  exact le_of_eq (mul_comm _ _)

/-- Multiplication of an original plane Wick character by the observed spatial coordinate. -/
noncomputable def planeCoordinateTimesWick (h b : T) : Lp ℂ 2 Q :=
  (planeCoordWick_memLp d hħ hm h b).toLp _

theorem planeCoordinateTimesWick_ae (h b : T) :
    ⇑(planeCoordinateTimesWick d hħ hm h b) =ᵐ[Q] fun x ↦ (x h : ℂ) * W b x :=
  MemLp.coeFn_toLp _

/-- Matrix element of the original position reading on the total plane Wick characters. -/
theorem plane_coordinate_wick_matrix (h a b : T) :
    inner ℂ (W a) (planeCoordinateTimesWick d hħ hm h b) =
      Complex.I * (inner ℝ (L b - L a) (L h) : ℂ) * (Real.exp (inner ℝ (L a) (L b)) : ℂ) := by
  let A := L a
  let C := L b
  let r := (‖A‖^2 + ‖C‖^2) / 2
  let V (x : T → ℝ) := star (Complex.exp ((‖A‖^2 / 2 : ℝ) + (x a : ℂ) * Complex.I)) *
    Complex.exp ((‖C‖^2 / 2 : ℝ) + (x b : ℂ) * Complex.I)
  have hV : Measurable (fun x : T → ℝ ↦ (x h : ℂ) * V x) := by dsimp [V]; fun_prop
  have hpoint (w) : V (readingCoordinates Φ L w) =
      (Real.exp r : ℂ) * Complex.exp ((Φ w (C - A) : ℂ) * Complex.I) := by
    change star (Complex.exp ((‖A‖^2 / 2 : ℝ) + (Φ w A : ℂ) * Complex.I)) *
      Complex.exp ((‖C‖^2 / 2 : ℝ) + (Φ w C : ℂ) * Complex.I) = _
    rw [Complex.star_def, ← Complex.exp_conj, Complex.ofReal_exp, ← Complex.exp_add, ← Complex.exp_add]
    congr 1
    simp only [r,map_add,map_mul,Complex.conj_ofReal,Complex.conj_I,map_sub]
    push_cast
    ring
  have hi : Integrable (fun w ↦ Φ w (L h)) P :=
    ((Lp.memLp (gaussianIsonormal B (L h))).integrable (by norm_num)).congr (pointwiseGaussian_ae B _).symm
  have he : r + -‖C - A‖^2 / 2 = inner ℝ A C := by
    dsimp [r]
    linarith [norm_sub_sq_real C A,real_inner_comm C A]
  rw [L2.inner_def]
  calc
    _ = ∫ x, (x h : ℂ) * V x ∂Q := by
      apply integral_congr_ae
      filter_upwards [planeCoordinateTimesWick_ae d hħ hm h b, wickCoordinate_ae Q L a,
        wickCoordinate_ae Q L b] with x hx ha hb
      rw [RCLike.inner_apply,hx,ha,hb]
      dsimp only [V,A,C]
      rw [Complex.star_def]
      ring
    _ = ∫ w, (Real.exp r : ℂ) * ((Φ w (L h) : ℂ) * Complex.exp ((Φ w (C - A) : ℂ) * Complex.I)) ∂P := by
      rw [massiveSpatialLaw,integral_map (measurable_readingCoordinates Φ (pointwiseGaussian_measurable B) L).aemeasurable hV.aestronglyMeasurable]
      refine integral_congr_ae (ae_of_all _ fun w ↦ ?_)
      dsimp only [readingCoordinates]
      rw [hpoint w]
      ring
    _ = _ := by
      rw [integral_const_mul,gaussian_weighted_phase P Φ (pointwiseGaussian_measurable B)
        (pointwiseGaussian_char B) _ _ hi]
      change _ = Complex.I * (inner ℝ (C - A) (L h) : ℂ) * (Real.exp (inner ℝ A C) : ℂ)
      rw [← he,Real.exp_add,Complex.ofReal_mul]
      ring

end PlaneMultiplication

end DotProduct.Extension


/-! ### The unitary on original spatial Wick characters -/

namespace DotProduct.Extension

open MeasureTheory Set
open scoped SchwartzMap InnerProductSpace Topology

section SpatialWickUnitary

set_option maxHeartbeats 1500000

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)

local notation "P" => standardGaussianProduct (massiveEuclideanBasisSet (d+1))
local notation "Φ" => pointwiseGaussian (massiveEuclideanBasis (d+1))
local notation "hΦ" => pointwiseGaussian_measurable (massiveEuclideanBasis (d+1))
local notation "hc" => pointwiseGaussian_char (massiveEuclideanBasis (d+1))
local notation "J" => positiveBulkLabel d hħ.le hm
local notation "M" => physicalFeatureL d hħ.le hm
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d hħ.le hm)
local notation "μ" => massiveSpatialLaw d hħ.le hm
local notation "vol" => (volume : Measure (MassShell.Space d))

private theorem continuous_spatialCoherent : Continuous (coherentVec vol) := by
  apply continuous_iff_continuous_dist.mpr
  have hd (x y : Momentum d) : dist (coherentVec vol x) (coherentVec vol y) = Real.sqrt
      ((Complex.exp (inner ℂ x x)).re - 2 * (Complex.exp (inner ℂ x y)).re +
        (Complex.exp (inner ℂ y y)).re) := by
    rw [dist_eq_norm, ← Real.sqrt_sq (norm_nonneg (coherentVec vol x - coherentVec vol y)),
      norm_sub_sq (𝕜 := ℂ), norm_sq_eq_re_inner (𝕜 := ℂ), norm_sq_eq_re_inner (𝕜 := ℂ),
      coherentVec_gram, coherentVec_gram, coherentVec_gram]
    rfl
  simp_rw [hd]
  fun_prop

/-- The unitary identified by all positive preparations sends the Wick exponential of an
original spatial test directly to the coherent vector of its weighted Fourier transform. -/
theorem massive_spatial_fock_wick (U : Lp ℂ 2 μ ≃ₗᵢ[ℂ] momentumFock vol)
    (hU : ∀ f, U (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
      coherentVec vol (Complex.I • M f)) (g : 𝓢(MassShell.Space d, ℝ)) :
    U (wickCoordinate μ L g) = coherentVec vol (Complex.I • planePositionMomentumLabel hħ.le hm g) := by
  let I := planeMomentumIsometry d m hm
  let v := planePositionMomentumLabel hħ.le hm g
  let ho := measurable_readingCoordinates Φ hΦ L
  let C := conditionOn P (readingCoordinates Φ L) ho
  let W := wickReading P Φ hΦ
  have hW : Continuous W := continuous_phase W (wickReading_inner P Φ hΦ hc)
  have hC : Continuous C := (observationL2 P _ ho).symm.continuous.comp (condExpL2 ℂ ℂ ho.comap_le).continuous
  let E := {a | U (C (W a)) = coherentVec vol (Complex.I • I.toContinuousLinearMap.adjoint a)}
  have hE : IsClosed E := isClosed_eq (U.continuous.comp (hC.comp hW))
    ((continuous_spatialCoherent d).comp (I.toContinuousLinearMap.adjoint.continuous.const_smul Complex.I))
  have hsubset : range J ⊆ E := by
    rintro _ ⟨f, rfl⟩
    have h := hU f
    unfold conditionedMassivePreparation at h
    rw [show readingPullback P Φ hΦ J (massiveWickPreparation d hħ hm f) = W (J f) from
      observationL2_wick P Φ hΦ J f] at h
    exact h
  have hmem : L g ∈ physicalPlane d hħ.le hm := (L).range.le_topologicalClosure ⟨g,rfl⟩
  have h := closure_minimal hsubset hE (physicalPlane_le_positive hħ.le hm hmem)
  change U (C (W (L g))) = coherentVec vol (Complex.I • I.toContinuousLinearMap.adjoint (I v)) at h
  have hfixed : C (W (L g)) = wickCoordinate μ L g := by
    rw [show W (L g) = (observationL2 P _ ho (wickCoordinate μ L g)).1 from
      (observationL2_wick P Φ hΦ L g).symm]
    exact conditionOn_pullback P _ ho _
  have hI : I.toContinuousLinearMap.adjoint (I v) = v := congr($(I.adjoint_comp_self) v)
  rwa [hfixed, hI] at h

/-- One unitary simultaneously has the conditioned positive-side labels and the direct
original spatial labels, with the Fourier normalization fixed in both descriptions. -/
theorem massive_spatial_fock_unique_with_wick :
    ∃! U : Lp ℂ 2 μ ≃ₗᵢ[ℂ] momentumFock vol,
      (∀ f, U (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
        coherentVec vol (Complex.I • M f)) ∧
      (∀ g, U (wickCoordinate μ L g) = coherentVec vol (Complex.I • planePositionMomentumLabel hħ.le hm g)) := by
  obtain ⟨U, hU, hu⟩ := massive_spatial_fock_unique d hħ hm
  exact ⟨U, ⟨hU, massive_spatial_fock_wick d hħ hm U hU⟩, fun V hV ↦ hu V hV.1⟩

end SpatialWickUnitary

