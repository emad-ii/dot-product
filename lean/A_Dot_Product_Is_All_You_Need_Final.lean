open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal NNReal Topology InnerProductSpace SchwartzMap

private theorem product_holder_eLp {X ι : Type*} [MeasurableSpace X] {μ : Measure X}
    [IsProbabilityMeasure μ] (s : Finset ι) (f : ι → X → ℝ)
    (hm : ∀ i, Measurable (f i)) (p : ℝ≥0∞) :
    eLpNorm (∏ i ∈ s, f i) (∑ _i ∈ s, p⁻¹)⁻¹ μ ≤ ∏ i ∈ s, eLpNorm (f i) p μ := by
  classical
  induction s using Finset.cons_induction with
  | empty =>
    simp only [Finset.prod_empty, Finset.sum_empty, ENNReal.inv_zero]
    change eLpNorm (fun _ : X ↦ (1 : ℝ)) ⊤ μ ≤ 1
    rw [eLpNorm_const 1 (by simp) (by exact MeasureTheory.IsProbabilityMeasure.ne_zero _)]
    simp
  | cons i s hi ih =>
    let : ENNReal.HolderTriple p (∑ _j ∈ s, p⁻¹)⁻¹ (∑ _j ∈ Finset.cons i s hi, p⁻¹)⁻¹ :=
      ⟨by simp only [Finset.sum_cons, inv_inv]⟩
    rw [Finset.prod_cons, Finset.prod_cons]
    have hms : Measurable (∏ j ∈ s, f j) := by
      simpa only [Finset.prod_fn] using s.measurable_prod (fun j _ ↦ hm j)
    exact (eLpNorm_smul_le_mul_eLpNorm (μ := μ) (p := p) (q := (∑ _j ∈ s, p⁻¹)⁻¹)
      (r := (∑ _j ∈ Finset.cons i s hi, p⁻¹)⁻¹)
      (hm i).aestronglyMeasurable hms.aestronglyMeasurable).trans (mul_le_mul_right ih _)

/-- Absolute mixed moment bound for arbitrary dependent centred Gaussian readings.
Only their one-dimensional laws enter the estimate. -/
private theorem gaussian_mixed_moment_bound {X : Type*} [MeasurableSpace X] {μ : Measure X}
    [IsProbabilityMeasure μ] {n : ℕ} (f : Fin n → X → ℝ) (σ : Fin n → ℝ≥0)
    (hm : ∀ i, Measurable (f i)) (hLaw : ∀ i, μ.map (f i) = gaussianReal 0 (σ i ^ 2)) :
    Integrable (fun x ↦ ∏ i, f i x) μ ∧
    ‖∫ x, ∏ i, f i x ∂μ‖ ≤
      (eLpNorm id (n : ℝ≥0∞) (gaussianReal 0 1)).toReal ^ n * ∏ i, (σ i : ℝ) := by
  cases n with
  | zero => simp
  | succ n =>
    let p : ℝ≥0∞ := (n + 1 : ℕ)
    let g : Measure ℝ := gaussianReal 0 1
    have hg : MemLp id p g := memLp_id_gaussianReal' _ (by simp [p])
    have hmarg (i : Fin (n+1)) : g.map (fun t : ℝ ↦ (σ i : ℝ) * t) = μ.map (f i) := by
      rw [hLaw, gaussianReal_map_const_mul]
      congr 1
      · simp
      · ext
        simp
    have hnorm (i : Fin (n+1)) : eLpNorm (f i) p μ = (σ i : ℝ≥0∞) * eLpNorm id p g := by
      calc
        _ = eLpNorm id p (μ.map (f i)) :=
          (eLpNorm_map_measure (g := (id : ℝ → ℝ)) measurable_id.aestronglyMeasurable (hm i).aemeasurable).symm
        _ = eLpNorm ((σ i : ℝ) • (id : ℝ → ℝ)) p g := by
          rw [← hmarg, eLpNorm_map_measure measurable_id.aestronglyMeasurable (by fun_prop)]
          rfl
        _ = _ := by simp [eLpNorm_const_smul, Real.enorm_eq_ofReal (σ i).coe_nonneg]
    have hf (i : Fin (n+1)) : MemLp (f i) p μ := by
      rw [memLp_iff, hnorm]
      exact ENNReal.mul_lt_top (by simp) hg.eLpNorm_lt_top
    have hexp : (∑ _i : Fin (n+1), p⁻¹)⁻¹ = 1 := by
      simp [p, nsmul_eq_mul, ENNReal.mul_inv_cancel (by positivity : (n : ℝ≥0∞) + 1 ≠ 0) (by simp)]
    have hI := MemLp.fun_prod (s := (Finset.univ : Finset (Fin (n+1)))) (p := fun _ ↦ p) (fun i _ ↦ hf i)
    rw [hexp] at hI
    have hprod := product_holder_eLp Finset.univ f hm p (μ := μ)
    rw [hexp] at hprod
    have hq : (∏ i, eLpNorm (f i) p μ) ≠ ⊤ := ENNReal.prod_ne_top fun i _ ↦ (hf i).eLpNorm_lt_top.ne
    have hor := ENNReal.toReal_mono hq hprod
    refine ⟨hI.integrable (by simp), ?_⟩
    have hL := norm_integral_le_integral_norm (μ := μ) (fun x ↦ ∏ i, f i x)
    refine hL.trans ?_
    rw [← lpNorm_one_eq_integral_norm (Finset.univ.measurable_fun_prod (fun i _ ↦ hm i)).aestronglyMeasurable,
      ← toReal_eLpNorm]
    simp_rw [hnorm] at hor
    rwa [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      ENNReal.toReal_mul, ENNReal.toReal_prod, ENNReal.toReal_pow, mul_comm, Finset.prod_fn] at hor

section MeasuredSchwingerMoments

variable {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)

/-- The n-th Euclidean Schwinger moment on the actual Schwartz reading law. -/
noncomputable def massiveSchwingerMoment {n : ℕ} (f : Fin n → 𝓢(MassShell.Space D, ℝ)) : ℝ :=
  ∫ x, ∏ i, x (f i) ∂massiveEuclideanLaw D ħ m hħ hm

/-- The norm of the continuous linear covariance feature is a continuous Schwartz
seminorm. Its product bounds every mixed moment by a dimension-independent Gaussian factor. -/
theorem massiveSchwingerMoment_regular {n : ℕ} (f : Fin n → 𝓢(MassShell.Space D, ℝ)) :
    Integrable (fun x ↦ ∏ i, x (f i)) (massiveEuclideanLaw D ħ m hħ hm) ∧
    ‖massiveSchwingerMoment hħ hm f‖ ≤
      (eLpNorm id (n : ℝ≥0∞) (gaussianReal 0 1)).toReal ^ n *
        ∏ i, ‖massiveEuclideanLabel D ħ m hħ hm (f i)‖ := by
  let J := massiveEuclideanLabel D ħ m hħ hm
  apply gaussian_mixed_moment_bound (fun i (x : 𝓢(MassShell.Space D, ℝ) → ℝ) ↦ x (f i))
    (fun i ↦ ‖J (f i)‖₊) (fun i ↦ measurable_pi_apply _)
  intro i
  rw [massiveEuclideanLaw, Measure.map_map (measurable_pi_apply _) (massiveEuclideanReading_measurable hħ hm)]
  exact pointwiseGaussian_map (massiveEuclideanBasis D) (J (f i))

/-- Permutations preserve every Schwinger moment, including repeated smears. -/
theorem massiveSchwingerMoment_perm {n : ℕ} (f : Fin n → 𝓢(MassShell.Space D, ℝ)) (τ : Equiv.Perm (Fin n)) :
    massiveSchwingerMoment hħ hm (f ∘ τ) = massiveSchwingerMoment hħ hm f := by
  apply integral_congr_ae
  exact ae_of_all _ fun x ↦ Equiv.prod_comp τ (fun i ↦ x (f i))

end MeasuredSchwingerMoments

