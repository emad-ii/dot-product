private theorem translation_eq_fockUnitary {d : ℕ} (m : ℝ) (a : Spacetime d) :
    let w := fun k : MassShell.Space d ↦ inner ℝ a.2 k - a.1 * modeDispersion m k
    (fockTranslation d m a).toLinearIsometry.toContinuousLinearMap = fockUnitary volume w
      ((measurable_const.inner measurable_id).sub (measurable_const.mul (modeDispersion_measurable m))) 1 := by
  dsimp only
  apply ContinuousLinearMap.ext_on (Submodule.dense_iff_topologicalClosure_eq_top.mpr (coherentVec_dense volume))
  rintro _ ⟨u, rfl⟩
  change secondQuantize volume (translationUnitary d m a) (coherentVec volume u) = _
  rw [secondQuantize_coherent, fockUnitary_coherent]
  congr 1
  apply Lp.ext
  filter_upwards [translationUnitary_apply_ae d m a u,
    FeatureDensity.complexMultiplier_apply_ae (MomentumFock.unitaryWeight
      (fun k : MassShell.Space d ↦ inner ℝ a.2 k - a.1 * modeDispersion m k) 1)
      (MomentumFock.unitaryWeight_memLp volume _ ((measurable_const.inner measurable_id).sub
        (measurable_const.mul (modeDispersion_measurable m))) 1) u] with k hk hk'
  exact hk.trans (Eq.trans (by
    congr 2
    dsimp only
    push_cast
    ring) hk'.symm)

set_option synthInstance.maxHeartbeats 150000 in
set_option maxHeartbeats 3500000 in
/-- The joint measure represents the actual spacetime-translation matrix coefficient of
each Fock vector. Its forward-cone support is consequently a statement about the representation. -/
theorem fockTranslationMeasure_coefficient {d : ℕ} (m : ℝ) (a : Spacetime d)
    (ψ : momentumFock (volume : Measure (MassShell.Space d))) :
    inner ℂ ψ (fockTranslation d m a ψ) =
      ∫ p, Complex.exp (Complex.I * ((a.1*p.1 - inner ℝ a.2 p.2 : ℝ) : ℂ))
        ∂fockTranslationMeasure m ψ := by
  let b (p : Spacetime d) := Complex.exp (Complex.I * ((a.1*p.1 - inner ℝ a.2 p.2 : ℝ) : ℂ))
  have hb : Measurable b := by unfold b; fun_prop
  let w := fun k : MassShell.Space d ↦ inner ℝ a.2 k - a.1 * modeDispersion m k
  have hw : Measurable w := (measurable_const.inner measurable_id).sub
    (measurable_const.mul (modeDispersion_measurable m))
  have he : fockTranslation d m a ψ = fockUnitary volume w hw 1 ψ :=
    congrArg (fun T : _ →L[ℂ] _ ↦ T ψ) (translation_eq_fockUnitary m a)
  let ν := fockTranslationMeasure m ψ
  let : IsFiniteMeasure ν := ⟨by rw [show ν univ = _ from fockTranslationMeasure_mass m ψ]; exact ENNReal.ofReal_lt_top⟩
  have hbi : Integrable b ν := Integrable.of_bound hb.aestronglyMeasurable 1 (ae_of_all _ fun p ↦ by
    unfold b; rw [mul_comm Complex.I,Complex.norm_exp_ofReal_mul_I])
  change _ = ∫ p, b p ∂ν
  rw [he, lp.inner_eq_tsum]
  refine Eq.trans ?_ (integral_sum_measure (μ := fun n ↦ Measure.map (sectorFrequencyMomentum m n)
    ((MomentumFock.powerMeasure volume n).withDensity (fun k ↦ ENNReal.ofReal (‖(ψ n).1 k‖^2)))) hbi).symm
  apply tsum_congr
  intro n
  let u := (ψ n).1
  let ρ := fun k ↦ ENNReal.ofReal (‖u k‖ ^ 2)
  have hρ : Measurable ρ := ((Lp.stronglyMeasurable u).measurable.norm.pow_const 2).ennreal_ofReal
  change inner ℂ u (fockUnitary volume w hw 1 ψ n).1 =
    ∫ p, b p ∂Measure.map (sectorFrequencyMomentum m n) ((MomentumFock.powerMeasure volume n).withDensity ρ)
  rw [integral_map (sectorFrequencyMomentum_measurable m n).aemeasurable hb.aestronglyMeasurable,
    integral_withDensity_eq_integral_toReal_smul hρ (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top), L2.inner_def]
  apply integral_congr_ae
  filter_upwards [fockUnitary_apply_sector_ae volume w hw 1 ψ n] with k hk
  dsimp only [ρ, Function.comp_apply]
  rw [hk, ENNReal.toReal_ofReal (sq_nonneg _), Complex.real_smul, RCLike.inner_apply]
  have he' : -(1 * ∑ i, w (k i)) = a.1 * (sectorFrequencyMomentum m n k).1 -
      inner ℝ a.2 (sectorFrequencyMomentum m n k).2 := by
    simp [w, sectorFrequencyMomentum, Finset.sum_sub_distrib, Finset.mul_sum, inner_sum]
  rw [he',mul_comm _ Complex.I,Complex.sq_norm,← Complex.mul_conj]
  unfold b
  change _ = _ * Complex.exp _
  dsimp only [u]
  ring

end DotProduct.Extension


namespace DotProduct
section PositiveTraceOnePriors

open Submodule MeasureTheory
open scoped InnerProductSpace

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A positive trace-one operator admits a countable ensemble on a Hilbert space with an
ℕ-indexed Hilbert basis. Its unnormalized vectors are the columns of the positive square root. -/
theorem exists_normalMixture_of_positive_trace_one (e : HilbertBasis ℕ ℂ H) (A : H →L[ℂ] H)
    (hA : A.IsPositive) (htr : HasSum (fun i ↦ (inner ℂ (e i) (A (e i))).re) 1) :
    ∃ ρ : NormalMixture H, densityOp ρ = A := by
  classical
  let B : H →L[ℂ] H := CFC.sqrt A
  have hB : B.IsPositive := ContinuousLinearMap.nonneg_iff_isPositive.mp (CFC.sqrt_nonneg A)
  have hBB : B * B = A := CFC.sqrt_mul_sqrt_self _ (ContinuousLinearMap.nonneg_iff_isPositive.mpr hA)
  have hbb (x : H) : B (B x) = A x := DFunLike.congr_fun hBB x
  let v (n : ℕ) := B (e n)
  have hnorm (n : ℕ) : ‖v n‖ ^ 2 = (inner ℂ (e n) (A (e n))).re := by
    rw [← hbb, ← hB.inner_left_eq_inner_right]
    exact norm_sq_eq_re_inner (𝕜 := ℂ) (v n)
  let u (n : ℕ) := if v n = 0 then e 0 else ((‖v n‖⁻¹ : ℝ) : ℂ) • v n
  let ρ : NormalMixture H := {
    w := fun n ↦ ‖v n‖ ^ 2
    ψ := u
    hw := fun _ ↦ sq_nonneg _
    hsum := htr.congr_fun hnorm
    hnorm := fun n ↦ by
      by_cases hn : v n = 0
      · simpa [u, hn] using e.orthonormal.1 0
      · simp [u, hn, norm_smul, norm_ne_zero_iff.mpr hn] }
  refine ⟨ρ, ?_⟩
  ext x
  rw [densityOp_apply, ← hbb]
  apply HasSum.tsum_eq
  refine ((e.hasSum_repr (B x)).mapL B).congr_fun fun n ↦ ?_
  symm
  change B (e.repr (B x) n • e n) = ((‖v n‖ ^ 2 : ℝ) : ℂ) • (inner ℂ (u n) x • u n)
  rw [map_smul, e.repr_apply_apply, ← hB.inner_left_eq_inner_right]
  change inner ℂ (v n) x • v n = _
  by_cases hn : v n = 0
  · simp [hn]
  · simp only [u, hn, ↓reduceIte, inner_smul_left, Complex.conj_ofReal, smul_smul,
      Complex.ofReal_pow, Complex.ofReal_inv, map_inv₀]
    congr 1
    field_simp [show (‖v n‖ : ℂ) ≠ 0 by exact_mod_cast norm_ne_zero_iff.mpr hn]

/-- The Born event trace of a bounded prior, written directly in the given basis. -/
noncomputable def densityEventTrace (e : HilbertBasis ℕ ℂ H) (A : H →L[ℂ] H)
    (K : ClosedSubmodule ℂ H) : ℝ :=
  (∑' i, inner ℂ (e i) (A (K.toSubmodule.starProjection (e i)))).re

/-- Lüders conditioning for a positive trace-one operator supplied directly. The event
probabilities are operator traces. Certainty and the subevent ratios uniquely determine
the posterior operator among candidates satisfying the event rules. -/
theorem positive_trace_one_luders_update (e : HilbertBasis ℕ ℂ H) (A : H →L[ℂ] H)
    (hA : A.IsPositive) (htr : HasSum (fun i ↦ (inner ℂ (e i) (A (e i))).re) 1)
    (K : ClosedSubmodule ℂ H) (hp : 0 < densityEventTrace e A K) :
    ∃ ρ' : NormalMixture H,
      densityOp ρ' = (densityEventTrace e A K : ℂ)⁻¹ •
        (K.toSubmodule.starProjection.comp (A.comp K.toSubmodule.starProjection)) ∧
      mixTrace ρ' K = 1 ∧
      (∀ Q ≤ K, mixTrace ρ' Q = densityEventTrace e A Q / densityEventTrace e A K) ∧
      CountablyAdditive (mixTrace ρ') ∧
      ∀ (σ : H →L[ℂ] H) (post : ClosedSubmodule ℂ H → ℝ),
        (∀ S, post S ∈ Set.Icc 0 1) →
        (∀ C D : ClosedSubmodule ℂ H, D ≤ Cᗮ → post (C ⊔ D) = post C + post D) →
        post K = 1 →
        (∀ x : H, inner ℂ (σ x) x = ((‖x‖ ^ 2 * post (ray x) : ℝ) : ℂ)) →
        (∀ y ∈ K, post (ray y) * densityEventTrace e A K = densityEventTrace e A (ray y)) →
        σ = densityOp ρ' := by
  obtain ⟨ρ, rfl⟩ := exists_normalMixture_of_positive_trace_one e A hA htr
  have h (S : ClosedSubmodule ℂ H) : densityEventTrace e (densityOp ρ) S = mixTrace ρ S := by
    rw [densityEventTrace, densityOp_basis_trace_eq_mixTrace, Complex.ofReal_re]
  rw [h] at hp
  simp_rw [h]
  exact ⟨condMixture ρ K hp, normal_mixture_luders_update ρ K hp⟩

private theorem nat_hilbertBasis_of_separable [TopologicalSpace.SeparableSpace H]
    (hinf : ¬ Module.Finite ℂ H) : Nonempty (HilbertBasis ℕ ℂ H) := by
  obtain ⟨S, b, _⟩ := exists_hilbertBasis ℂ H
  have : Countable S := orthonormal_countable b b.orthonormal
  have : Infinite S := by
    by_contra! hf
    let := Fintype.ofFinite S
    exact hinf (Module.Finite.of_basis b.toOrthonormalBasis.toBasis)
  obtain ⟨τ⟩ := nonempty_equiv_of_countable (α := ℕ) (β := S)
  refine ⟨HilbertBasis.mk (b.orthonormal.comp τ τ.injective) ?_⟩
  rw [Set.range_comp, τ.surjective.range_eq, Set.image_univ, b.dense_span]

/-- The reconstructed Fock space in every physical dimension has a countably indexed
Hilbert basis for the preceding trace-one characterization. -/
theorem momentumFock_nat_hilbertBasis (n : ℕ) :
    Nonempty (HilbertBasis ℕ ℂ
      (momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))))) := by
  have := momentumFock_separable n
  exact nat_hilbertBasis_of_separable (momentumFock_infinite_dim n)

end PositiveTraceOnePriors

