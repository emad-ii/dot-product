namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap Topology ComplexConjugate

set_option maxHeartbeats 1200000

private noncomputable def shellPlanePhase {d : ℕ} (m : ℝ) (k : MassShell.Space d) (p : Spacetime d) : ℂ :=
  Complex.exp (Complex.I * ((p.1 * modeDispersion m k - inner ℝ p.2 k : ℝ) : ℂ))

private theorem shellPlanePhase_norm {d : ℕ} (m : ℝ) (k : MassShell.Space d) (p : Spacetime d) :
    ‖shellPlanePhase m k p‖ = 1 := Complex.norm_exp_I_mul_ofReal _

private theorem shellPlanePhase_pair {d : ℕ} {m : ℝ} (s : ℝ) (k : MassShell.Space d)
    (p q : Spacetime d) :
    ((Real.exp (-s * modeDispersion m k) / (2 * modeDispersion m k) : ℝ) : ℂ) *
      (conj (shellPlanePhase m k p) * shellPlanePhase m k q) =
    Complex.exp (-((s : ℂ) + ((p.1 - q.1 : ℝ) : ℂ) * Complex.I) * (modeDispersion m k : ℂ)) /
      (2 * (modeDispersion m k : ℂ)) * Complex.exp (Complex.I * (inner ℝ (p.2-q.2) k : ℂ)) := by
  simp only [shellPlanePhase,Complex.ofReal_div,Complex.ofReal_mul,Complex.ofReal_ofNat,
    Complex.ofReal_exp,← Complex.exp_conj,map_mul,Complex.conj_I,Complex.conj_ofReal,inner_sub_left]
  rw [div_mul_eq_mul_div,div_mul_eq_mul_div]
  congr 1
  simp only [← Complex.exp_add]
  congr 1
  push_cast
  ring

private theorem damped_shell_fubini {d : ℕ} {m : ℝ} (s : ℝ) (hm : 0 < m) (c : ℂ)
    (f g : 𝓢(Spacetime d, ℝ)) (hf : HasCompactSupport f) (hg : HasCompactSupport g)
    (hρ : Integrable (fun k : MassShell.Space d ↦ Real.exp (-s * modeDispersion m k) /
      (2 * modeDispersion m k))) :
    (∫ r : Spacetime d × Spacetime d, (f r.1 : ℂ) * (g r.2 : ℂ) *
      (c * ∫ k : MassShell.Space d, Complex.exp (-((s : ℂ) +
        ((r.1.1 - r.2.1 : ℝ) : ℂ) * Complex.I) * (modeDispersion m k : ℂ)) /
          (2 * (modeDispersion m k : ℂ)) * Complex.exp (Complex.I * (inner ℝ (r.1.2-r.2.2) k : ℂ)))) =
    c * ∫ k : MassShell.Space d, ((Real.exp (-s * modeDispersion m k) / (2 * modeDispersion m k) : ℝ) : ℂ) *
      (conj (∫ p, shellPlanePhase m k p * (f p : ℂ)) * ∫ q, shellPlanePhase m k q * (g q : ℂ)) := by
  let ρ (k : MassShell.Space d) := Real.exp (-s * modeDispersion m k) / (2 * modeDispersion m k)
  let D (r : Spacetime d × Spacetime d) (k : MassShell.Space d) :=
    (ρ k : ℂ) * (conj (shellPlanePhase m k r.1 * (f r.1 : ℂ)) * (shellPlanePhase m k r.2 * (g r.2 : ℂ)))
  have hD : Integrable (Function.uncurry D) (volume.prod volume) := by
    have hb := ((f.continuous.integrable_of_hasCompactSupport (μ := volume) hf).norm.mul_prod
      (g.continuous.integrable_of_hasCompactSupport (μ := volume) hg).norm).mul_prod hρ
    apply hb.mono'
    · apply Measurable.aestronglyMeasurable
      dsimp [D,ρ,shellPlanePhase,Function.uncurry,modeDispersion]
      fun_prop
    · refine ae_of_all _ fun z ↦ ?_
      change ‖(ρ z.2 : ℂ) * _‖ ≤ (‖f z.1.1‖ * ‖g z.1.2‖) * ρ z.2
      have hp : 0 ≤ ρ z.2 := div_nonneg (Real.exp_pos _).le (mul_pos two_pos (modeDispersion_pos hm _)).le
      simp only [norm_mul,Complex.norm_conj,shellPlanePhase_norm,one_mul,Complex.norm_real,
        Real.norm_of_nonneg hp]
      exact le_of_eq (mul_comm _ _)
  have hpair (r : Spacetime d × Spacetime d) :
      (∫ k, D r k) = (f r.1 : ℂ) * (g r.2 : ℂ) * ∫ k : MassShell.Space d,
        Complex.exp (-((s : ℂ) + ((r.1.1-r.2.1 : ℝ) : ℂ) * Complex.I) * (modeDispersion m k : ℂ)) /
          (2 * (modeDispersion m k : ℂ)) * Complex.exp (Complex.I * (inner ℝ (r.1.2-r.2.2) k : ℂ)) := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    exact ae_of_all _ fun k ↦ by
      dsimp only
      rw [← shellPlanePhase_pair (m := m) s k r.1 r.2]
      simp only [D,ρ,map_mul,Complex.conj_ofReal]
      ring
  have hmoment (k : MassShell.Space d) : (∫ r, D r k) = (ρ k : ℂ) *
      (conj (∫ p, shellPlanePhase m k p * (f p : ℂ)) * ∫ q, shellPlanePhase m k q * (g q : ℂ)) := by
    change (∫ r : Spacetime d × Spacetime d, (ρ k : ℂ) * _ ∂volume.prod volume) = _
    rw [integral_const_mul,integral_prod_mul
      (fun p : Spacetime d ↦ conj (shellPlanePhase m k p * (f p : ℂ)))
      (fun q : Spacetime d ↦ shellPlanePhase m k q * (g q : ℂ)),integral_conj]
  calc
    _ = c * ∫ r, ∫ k, D r k := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      exact ae_of_all _ fun r ↦ by dsimp only; rw [hpair r]; ring
    _ = c * ∫ k, ∫ r, D r k := congrArg (c * ·) (integral_integral_swap hD)
    _ = _ := congrArg (c * ·) (integral_congr_ae (ae_of_all _ hmoment))

end DotProduct.Extension
