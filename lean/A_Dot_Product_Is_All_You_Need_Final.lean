/-! ### Strong continuity in all spacetime symmetry parameters -/

namespace DotProduct.Extension
open MeasureTheory Filter Set
open scoped Topology InnerProductSpace

set_option maxHeartbeats 1200000

/-- The original finite-dimensional parameters, recording both linear actions to expose inversion. -/
noncomputable def poincareParameters {d : ℕ} (g : PoincareGroup d) :=
  (g.translation, g.lorentz.toContinuousLinearEquiv.toContinuousLinearMap,
    g.lorentz⁻¹.toContinuousLinearEquiv.toContinuousLinearMap)

noncomputable instance (d : ℕ) : TopologicalSpace (PoincareGroup d) :=
  TopologicalSpace.induced poincareParameters inferInstance

private theorem continuous_lorentz_parameter (n : ℕ) {m : ℝ} (hm : 0 < m) (v : Momentum (n+1)) :
    Continuous (fun g : PoincareGroup (n+1) ↦ lorentzUnitary n m hm g.lorentz v) := by
  let _ := massShellMeasure_locallyFinite (n+1) m hm
  have hc : Continuous (@poincareParameters (n+1)) := continuous_induced_dom
  let B : C(PoincareGroup (n+1) × MassShell.Space (n+1), MassShell.Space (n+1)) :=
    ⟨fun z ↦ lorentzMomentum m z.1.lorentz⁻¹ z.2, by
      change Continuous (fun z : PoincareGroup (n+1) × MassShell.Space (n+1) ↦
        ((poincareParameters z.1).2.2 (modeDispersion m z.2, z.2)).2)
      have hw : Continuous (modeDispersion (d := n+1) m) := by unfold modeDispersion; fun_prop
      exact ((hc.comp continuous_fst).snd.snd.clm_apply ((hw.comp continuous_snd).prodMk continuous_snd)).snd⟩
  let I := massShellToVolumeIso (n+1) m hm
  have hp g : MeasurePreserving (B.curry g) (massShellMeasure (n+1) m) (massShellMeasure (n+1) m) :=
    massShell_measurePreserving_lorentz n m hm g.lorentz⁻¹
  exact I.continuous.comp (continuous_const.compMeasurePreservingLp B.curry.continuous hp (by norm_num : (2 : ENNReal) ≠ ⊤))

private theorem continuous_translation_parameter (d : ℕ) (m : ℝ) (v : Momentum d) :
    Continuous (fun a ↦ translationUnitary d m a v) := by
  apply continuous_iff_continuousAt.mpr
  intro a
  let T := fun b ↦ translationUnitary d m b v
  let H := WightmanField.translationPhase d m
  let F := fun b k ↦ ‖H b k * v k - H a k * v k‖^2
  have heq b : (fun k ↦ ‖(T b - T a) k‖ ^ 2) =ᵐ[volume] F b := by
    filter_upwards [Lp.coeFn_sub (T b) (T a),translationUnitary_apply_ae d m b v,
      translationUnitary_apply_ae d m a v] with k hs hb ha
    rw [hs]; change ‖translationUnitary d m b v k - translationUnitary d m a v k‖^2 = _
    rw [hb,ha]; rfl
  have Hn := tendsto_integral_filter_of_dominated_convergence (l := 𝓝 a) (F := F) (f := fun _ ↦ (0:ℝ))
    (fun k ↦ 4 * ‖v k‖^2)
    (Eventually.of_forall fun b ↦ (((Lp.aestronglyMeasurable (T b-T a)).norm.pow 2).congr (heq b)))
    (Eventually.of_forall fun b ↦ ae_of_all _ fun k ↦ by
      dsimp [F]; rw [abs_of_nonneg (sq_nonneg _)]
      have h := norm_sub_le (H b k * v k) (H a k * v k)
      simp only [norm_mul, H, WightmanField.translationPhase_norm, one_mul] at h
      calc
        _ ≤ (‖v k‖+‖v k‖)^2 := pow_le_pow_left₀ (norm_nonneg _) h 2
        _ = _ := by ring)
    (((memLp_two_iff_integrable_sq_norm (Lp.aestronglyMeasurable v)).1 (Lp.memLp v)).const_mul 4)
    (ae_of_all _ fun k ↦ by
      have hc : Continuous (fun b ↦ H b k) := by unfold H WightmanField.translationPhase; fun_prop
      simpa [F] using ((((hc.continuousAt (x := a)).tendsto.mul_const (v k)).sub_const (H a k * v k)).norm.pow 2))
  have hn : Tendsto (fun b ↦ ‖T b-T a‖^2) (𝓝 a) (𝓝 0) := by
    apply (show Tendsto (fun b ↦ ∫ k, F b k) (𝓝 a) (𝓝 0) by simpa using Hn).congr
    intro b
    rw [← real_inner_self_eq_norm_sq, L2.inner_def]; simp_rw [real_inner_self_eq_norm_sq]
    exact integral_congr_ae (heq b).symm
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  simpa only [Real.sqrt_sq (norm_nonneg _), Real.sqrt_zero, Function.comp_def] using
    (Real.continuous_sqrt.continuousAt.tendsto.comp hn)

private theorem iso_param_apply {X H : Type*} [TopologicalSpace X] [NormedAddCommGroup H]
    [NormedSpace ℂ H] (T : X → (H ≃ₗᵢ[ℂ] H)) (hT : ∀ z, Continuous (fun g ↦ T g z))
    (V : X → H) (hV : Continuous V) : Continuous (fun g ↦ T g (V g)) := by
  apply continuous_iff_continuousAt.mpr
  intro g
  refine ((hT (V g)).continuousAt (x := g)).tendsto.congr_dist ?_
  simp only [LinearIsometryEquiv.dist_map]
  simpa using (((continuous_const (y := V g)).dist hV).continuousAt (x := g)).tendsto

/-- Full joint translation and Lorentz continuity of the one-particle representation. -/
theorem continuous_poincareUnitary (n : ℕ) {m : ℝ} (hm : 0 < m) (v : Momentum (n+1)) :
    Continuous (fun g ↦ poincareUnitary n m hm g v) := by
  have hc : Continuous (@poincareParameters (n+1)) := continuous_induced_dom
  exact iso_param_apply (fun g : PoincareGroup (n+1) ↦ translationUnitary (n+1) m g.translation)
    (fun z ↦ (continuous_translation_parameter (n+1) m z).comp hc.fst)
    (fun g ↦ lorentzUnitary n m hm g.lorentz v) (continuous_lorentz_parameter n hm v)

/-- The released full Fock Poincaré group is strongly continuous, simultaneously in all
translation and Lorentz parameters. -/
theorem continuous_fockPoincare (n : ℕ) {m : ℝ} (hm : 0 < m)
    (ψ : momentumFock (volume : Measure (MassShell.Space (n+1)))) :
    Continuous (fun g ↦ fockPoincare n m hm g ψ) := by
  let μ := (volume : Measure (MassShell.Space (n+1)))
  let U := fockPoincare n m hm
  have hcoh : Continuous (coherentVec μ) := by
    apply continuous_iff_continuous_dist.mpr
    have hd (x y : Momentum (n+1)) : dist (coherentVec μ x) (coherentVec μ y) = Real.sqrt
        ((Complex.exp (inner ℂ x x)).re - 2*(Complex.exp (inner ℂ x y)).re + (Complex.exp (inner ℂ y y)).re) := by
      rw [dist_eq_norm, ← Real.sqrt_sq (norm_nonneg (coherentVec μ x - coherentVec μ y)), norm_sub_sq (𝕜 := ℂ),
        norm_sq_eq_re_inner (𝕜 := ℂ), norm_sq_eq_re_inner (𝕜 := ℂ),coherentVec_gram,coherentVec_gram,coherentVec_gram]; rfl
    simp_rw [hd]; fun_prop
  have hd := Submodule.dense_iff_topologicalClosure_eq_top.mpr (coherentVec_dense μ)
  apply continuous_iff_continuousAt.mpr
  intro g
  have he : UniformEquicontinuous (fun (h : PoincareGroup (n+1)) (x : momentumFock μ) ↦ U h x) := by
    exact Metric.uniformEquicontinuous_iff.mpr (fun ε hε ↦ ⟨ε,hε,fun x y hxy i ↦ by simpa using hxy⟩)
  refine hd.induction (P :=  fun x ↦ Tendsto (fun i ↦ U i x) (𝓝 g) (𝓝 (U g x))) ?_
    (he.equicontinuous.isClosed_setOfPred_tendsto (U g).continuous) ψ
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨v,rfl⟩ := hx
    change Tendsto (fun i ↦ secondQuantize μ (poincareUnitary n m hm i) (coherentVec μ v)) (𝓝 g) (𝓝 (secondQuantize μ (poincareUnitary n m hm g) (coherentVec μ v)))
    simpa only [secondQuantize_coherent] using! (hcoh.comp (continuous_poincareUnitary n hm v)).continuousAt (x := g)
  | zero => simp
  | add x y _ _ hx hy => simpa using hx.add hy
  | smul c x _ hx => simpa using hx.const_smul c

end DotProduct.Extension


/-! ### The joint translation spectral measures -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped InnerProductSpace

private noncomputable def sectorFrequencyMomentum {d : ℕ} (m : ℝ) (n : ℕ)
    (k : Fin n → MassShell.Space d) : Spacetime d :=
  (∑ i, modeDispersion m (k i), ∑ i, k i)

private theorem sectorFrequencyMomentum_measurable {d : ℕ} (m : ℝ) (n : ℕ) :
    Measurable (sectorFrequencyMomentum (d := d) m n) :=
  (MomentumFockDomH.measurable_sectorFreq _ (modeDispersion_measurable m) n).prodMk
    (Finset.measurable_sum _ fun i _ ↦ measurable_pi_apply i)

/-- The scalar joint translation measure in a Fock vector. Coordinates are inverse-length
frequencies, so physical energy and momentum are obtained by multiplying both by ħ. -/
noncomputable def fockTranslationMeasure {d : ℕ} (m : ℝ)
    (ψ : momentumFock (volume : Measure (MassShell.Space d))) : Measure (Spacetime d) :=
  Measure.sum fun n ↦ Measure.map (sectorFrequencyMomentum m n)
    ((MomentumFock.powerMeasure volume n).withDensity (fun k ↦ ENNReal.ofReal (‖(ψ n).1 k‖^2)))

theorem fockTranslationMeasure_mass {d : ℕ} (m : ℝ)
    (ψ : momentumFock (volume : Measure (MassShell.Space d))) :
    fockTranslationMeasure m ψ univ = ENNReal.ofReal (‖ψ‖^2) := by
  have hs := lp.hasSum_norm (p := 2) (by norm_num) ψ
  norm_num at hs
  rw [fockTranslationMeasure, Measure.sum_apply _ MeasurableSet.univ, ← hs.tsum_eq,
    ENNReal.ofReal_tsum_of_nonneg (fun _ ↦ sq_nonneg _) hs.summable]
  apply tsum_congr
  intro n
  rw [Measure.map_apply (sectorFrequencyMomentum_measurable m n) MeasurableSet.univ,
    preimage_univ, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
    ← ofReal_integral_eq_lintegral_ofReal ((Lp.memLp (ψ n).1).integrable_norm_pow (by norm_num))
      (ae_of_all _ (fun _ ↦ sq_nonneg _)), ← FeatureDensity.l2_norm_sq_eq_integral]

/-- The scalar spectral measure is carried by the closed forward cone, and its energy
coordinate lies in the vacuum or above the mass gap. This includes arbitrary Fock vectors. -/
theorem fockTranslationMeasure_forward {d : ℕ} {m : ℝ} (hm : 0 < m)
    (ψ : momentumFock (volume : Measure (MassShell.Space d))) :
    ∀ᵐ p ∂fockTranslationMeasure m ψ, ‖p.2‖ ≤ p.1 ∧ (p.1 = 0 ∨ m ≤ p.1) := by
  apply Measure.ae_sum_iff.mpr
  intro n
  have h := sectorFrequencyMomentum_measurable (d := d) m n
  apply (ae_map_iff h.aemeasurable (by measurability)).mpr
  refine ae_of_all _ fun k ↦ ⟨sector_forward Finset.univ m k, ?_⟩
  cases n with
  | zero => exact Or.inl (by simp [sectorFrequencyMomentum])
  | succ n =>
    right
    have hp := sector_gap Finset.univ m k
    simp only [Finset.card_univ,Fintype.card_fin] at hp
    exact (le_mul_of_one_le_left hm.le (by exact_mod_cast Nat.le_add_left 1 n)).trans hp

/-- The topological support in joint frequency-momentum space obeys the spectral condition. -/
theorem fockTranslationMeasure_support {d : ℕ} {m : ℝ} (hm : 0 < m)
    (ψ : momentumFock (volume : Measure (MassShell.Space d))) :
    (fockTranslationMeasure m ψ).support ⊆
      {p | ‖p.2‖ ≤ p.1 ∧ (p.1 = 0 ∨ m ≤ p.1)} := by
  apply Measure.support_subset_of_isClosed _ (fockTranslationMeasure_forward hm ψ)
  exact (isClosed_le continuous_snd.norm continuous_fst).inter
    ((isClosed_eq continuous_fst continuous_const).union (isClosed_le continuous_const continuous_fst))

set_option synthInstance.maxHeartbeats 150000 in
