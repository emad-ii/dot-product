/-! ### Massive spatial and reflected spaces in Fock coordinates -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap InnerProductSpace ComplexConjugate

section PhysicalFock

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)

local notation "P" => standardGaussianProduct (massiveEuclideanBasisSet (d+1))
local notation "Φ" => pointwiseGaussian (massiveEuclideanBasis (d+1))
local notation "hΦ" => pointwiseGaussian_measurable (massiveEuclideanBasis (d+1))
local notation "hc" => pointwiseGaussian_char (massiveEuclideanBasis (d+1))
local notation "J" => positiveBulkLabel d hħ.le hm
local notation "M" => physicalFeatureL d hħ.le hm
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d hħ.le hm)
local notation "S" => physicalPlane d hħ.le hm
local notation "vol" => (volume : Measure (MassShell.Space d))

/-- On physical reflected preparations the plane projection Gram is the full
complex inner product of the transverse momentum features. -/
theorem physicalFeature_projection_gram (f g : positiveSchwartz d) :
    ((inner ℝ ((S).orthogonalProjectionOnto (J f)) ((S).orthogonalProjectionOnto (J g)) : ℝ) : ℂ) =
      inner ℂ (M f) (M g) := by
  let I := planeMomentumIsometry d m hm
  let u := boundaryLabel hħ.le hm f
  let v := boundaryLabel hħ.le hm g
  have hsym (a : positiveSchwartz d) : ∀ᵐ k ∂vol,
      boundaryLabel hħ.le hm a (-k) = conj (boundaryLabel hħ.le hm a k) := by
    have h := boundaryLabel_ae hħ.le hm a
    have hn := (Measure.measurePreserving_neg vol).quasiMeasurePreserving.ae h
    filter_upwards [h, hn] with k hk hk'
    exact hk'.trans ((boundaryFeature_conj_neg ħ m a.1 k).trans (congrArg (starRingEnd ℂ) hk.symm))
  have hproj (a : positiveSchwartz d) :
      ((S).orthogonalProjectionOnto (J a) : Lp ℂ 2 volume) = I (boundaryLabel hħ.le hm a) :=
    physicalPlane_projection hħ hm a
  change ((inner ℝ ((S).orthogonalProjectionOnto (J f)).1
    ((S).orthogonalProjectionOnto (J g)).1 : ℝ) : ℂ) = _
  rw [hproj, hproj, physicalL2_real_inner, I.inner_map_map, physicalFeatureL_apply, physicalFeatureL_apply]
  exact Complex.ext rfl (by simpa only [Complex.ofReal_im] using
    (hermitian_profile_inner_im u v (hsym f) (hsym g)).symm)

/-- Wick preparation on the actual positive-side test-coordinate law. -/
noncomputable def massiveWickPreparation (f : positiveSchwartz d) :
    Lp ℂ 2 (massivePreparationLaw d hħ.le hm) :=
  wickCoordinate (massivePreparationLaw d hħ.le hm) J f

/-- The actual spatial-test plane law determines the Fock unitary on every
positive Wick preparation through conditional expectation. -/
theorem massive_spatial_fock_unique :
    ∃! U : Lp ℂ 2 (massiveSpatialLaw d hħ.le hm) ≃ₗᵢ[ℂ] momentumFock vol,
      ∀ f, U (conditionedMassivePreparation d hħ.le hm (massiveWickPreparation d hħ hm f)) =
        coherentVec vol (Complex.I • M f) := by
  have hW (f : positiveSchwartz d) : conditionedMassivePreparation d hħ.le hm
      (massiveWickPreparation d hħ hm f) =
      conditionOn P _ (measurable_readingCoordinates Φ hΦ L) (wickReading P Φ hΦ (J f)) :=
    congrArg (conditionOn P _ (measurable_readingCoordinates Φ hΦ L))
      (observationL2_wick P Φ hΦ J f)
  simp_rw [hW]
  exact spatialConditionedWick_fock_unique P Φ hΦ hc J S (physicalPlane_le_positive hħ.le hm)
    L rfl M (physicalFeatureL_dense hħ hm) (physicalFeature_projection_gram d hħ hm)

/-- The full positive preparation quotient has a unique labelled Fock realization. -/
theorem massive_preparation_fock_unique :
    ∃! U : massivePreparationClass d hħ.le hm ≃ₗᵢ[ℂ] momentumFock vol,
      ∀ f, U (Submodule.Quotient.mk (massiveWickPreparation d hħ hm f)) =
        coherentVec vol (Complex.I • M f) :=
  preparationQuotient_fock_unique P Φ hΦ hc J S (physicalPlane_le_positive hħ.le hm)
    M (physicalFeatureL_dense hħ hm) (physicalFeature_projection_gram d hħ hm)

end PhysicalFock

