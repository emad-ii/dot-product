/-- The oriented rotation in the plane of the normal and the unit spatial direction
`u`. Its longitudinal coordinate rotates toward the normal and its transverse part is fixed. -/
noncomputable def normalPlaneRotation {d : ℕ} (u : MassShell.Space d) (θ : ℝ)
    (p : Spacetime d) : Spacetime d :=
  (Real.cos θ * p.1 + Real.sin θ * inner ℝ u p.2,
   p.2 + ((Real.cos θ - 1) * inner ℝ u p.2 - Real.sin θ * p.1) • u)

/-- The real rotation preserves the Euclidean quadratic form on spacetime. -/
theorem normalPlaneRotation_norm_sq {d : ℕ} (u : MassShell.Space d) (hu : ‖u‖ = 1)
    (θ : ℝ) (p : Spacetime d) :
    (normalPlaneRotation u θ p).1 ^ 2 + ‖(normalPlaneRotation u θ p).2‖ ^ 2 =
      p.1 ^ 2 + ‖p.2‖ ^ 2 := by
  unfold normalPlaneRotation
  dsimp only
  rw [norm_add_sq_real, real_inner_smul_right, real_inner_comm p.2 u, norm_smul, hu, mul_one,
    Real.norm_eq_abs, sq_abs]
  linear_combination (p.1 ^ 2 + (inner ℝ p.2 u) ^ 2) * Real.sin_sq_add_cos_sq θ

/-- Entire normal-plane rotation coefficients, retaining every spatial coordinate. -/
noncomputable def complexNormalRotation {d : ℕ} (u : MassShell.Space d) (θ z : ℂ)
    (x : MassShell.Space d) : ℂ × (Fin d → ℂ) :=
  (Complex.cos θ * z + Complex.sin θ * (inner ℝ u x : ℂ),
   fun j ↦ (x j : ℂ) + ((Complex.cos θ - 1) * (inner ℝ u x : ℂ) - Complex.sin θ * z) * (u j : ℂ))

theorem complexNormalRotation_entire {d : ℕ} (u : MassShell.Space d) (z : ℂ)
    (x : MassShell.Space d) : Differentiable ℂ (fun θ ↦ complexNormalRotation u θ z x) := by
  unfold complexNormalRotation
  fun_prop

theorem complexNormalRotation_real {d : ℕ} (u : MassShell.Space d) (θ : ℝ) (p : Spacetime d) :
    complexNormalRotation u θ p.1 p.2 =
      (((normalPlaneRotation u θ p).1 : ℂ), fun j ↦ ((normalPlaneRotation u θ p).2 j : ℂ)) := by
  refine Prod.ext ?_ (funext fun j ↦ ?_)
  · simp [complexNormalRotation, normalPlaneRotation]
  · change _ = ((p.2 j + ((Real.cos θ - 1) * inner ℝ u p.2 - Real.sin θ * p.1) * u j : ℝ) : ℂ)
    simp [complexNormalRotation]

/-- At imaginary normal coordinate and imaginary angle the entire rotation gives precisely
the orthochronous directional boost used by the Poincaré representation. -/
theorem complexNormalRotation_directionalBoost {n : ℕ} (u : MassShell.Space (n+1))
    (hu : ‖u‖ = 1) (η : ℝ) (p : Spacetime (n+1)) :
    complexNormalRotation u (η * Complex.I) (p.1 * Complex.I) p.2 =
      (((directionalBoostLorentz u hu η p).1 : ℂ) * Complex.I,
       fun j ↦ ((directionalBoostLorentz u hu η p).2 j : ℂ)) := by
  rw [directionalBoostLorentz_apply]
  refine Prod.ext ?_ (funext fun j ↦ ?_)
  · change Complex.cos _ * _ + Complex.sin _ * _ =
      ((Real.cosh η * p.1 + Real.sinh η * inner ℝ u p.2 : ℝ) : ℂ) * _
    rw [Complex.cos_mul_I, Complex.sin_mul_I]
    push_cast
    ring
  · change (p.2 j : ℂ) + ((Complex.cos _ - 1) * _ - Complex.sin _ * _) * _ =
      ((p.2 j + ((Real.cosh η - 1) * inner ℝ u p.2 + Real.sinh η * p.1) * u j : ℝ) : ℂ)
    rw [Complex.cos_mul_I, Complex.sin_mul_I]
    push_cast
    linear_combination -(Complex.sinh η * p.1 * u j) * Complex.I_sq

/-- The physical two-point kernel, including the covariance scale and the Euclidean
heat-kernel normalization in spacetime dimension `D`. -/
noncomputable def physicalHeatKernel (D : ℕ) (ħ m : ℝ) (w : ℂ) : ℂ :=
  ((ħ * (4 * Real.pi) ^ (-(D : ℝ) / 2) : ℝ) : ℂ) * heatKernel D m w

theorem physicalHeatKernel_euclidean {D : ℕ} (ħ m : ℝ) (x : MassShell.Space D) :
    physicalHeatKernel D ħ m (‖x‖ ^ 2 : ℝ) = (ħ : ℂ) * euclideanResolventKernel m x := by
  simp [physicalHeatKernel, euclideanResolventKernel, mul_assoc]

/-- Both signs of imaginary time converge uniformly, with the physical normalization
from the measured Euclidean covariance, on every compact spacelike set. -/
theorem physicalHeatKernel_spacelike_boundary {d : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    {K : Set (Spacetime d)} (hK : IsCompact K) (hsep : ∀ p ∈ K, |p.1| < ‖p.2‖) :
    let G := physicalHeatKernel (d+1) ħ m
    ∀ δ > 0, ∃ η > 0, ∀ ε ∈ Ioo (0 : ℝ) η, ∀ p ∈ K,
      ‖G (((ε : ℂ) + p.1 * Complex.I)^2 + (‖p.2‖^2 : ℝ)) - G (‖p.2‖^2 - p.1^2 : ℝ)‖ < δ ∧
      ‖G (((ε : ℂ) - p.1 * Complex.I)^2 + (‖p.2‖^2 : ℝ)) - G (‖p.2‖^2 - p.1^2 : ℝ)‖ < δ := by
  intro G δ hδ
  let c : ℂ := (ħ * (4 * Real.pi) ^ (-((d+1:ℕ) : ℝ) / 2) : ℝ)
  have hc : 0 < ‖c‖ + 1 := by positivity
  obtain ⟨η, hη, h⟩ := heatKernel_spacelike_uniform_tendsto (d+1) d hm hK hsep
    (δ / (‖c‖+1)) (div_pos hδ hc)
  refine ⟨η, hη, fun ε hε p hp ↦ ?_⟩
  have bound (a b : ℂ) (hab : ‖a-b‖ < δ / (‖c‖+1)) : ‖c*a-c*b‖ < δ := by
    rw [← mul_sub, norm_mul]
    have hlt := (lt_div_iff₀ hc).mp hab
    nlinarith [norm_nonneg (a-b)]
  exact ⟨bound _ _ (h ε hε p hp).1, bound _ _ (h ε hε p hp).2.1⟩

