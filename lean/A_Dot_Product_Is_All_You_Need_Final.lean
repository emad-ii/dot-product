/-- Spatial integration by parts for `halfSpaceFourierVec F` using `SchwartzMap.fourier_lineDerivOp_eq`. -/
lemma halfSpaceFourierVec_spatial_ibp {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (F : 𝓢(EuclidD n, E)) (j : Fin (n + 1)) (p : EuclidD n) :
    (Complex.I * (spatialProj p j : ℂ)) • halfSpaceFourierVec F p =
      halfSpaceFourierVec (LineDeriv.lineDerivOp (EuclideanSpace.single j.succ (1 : ℝ)) F) p := by
  let ej : SpatialE n := EuclideanSpace.single j (1 : ℝ)
  let ej' : EuclidD n := EuclideanSpace.single j.succ (1 : ℝ)
  rw [halfSpaceFourierVec_eq_prod, halfSpaceFourierVec_eq_prod, ← integral_smul]
  refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
  let Ft : 𝓢(SpatialE n, E) := restrictTimeCLM ℂ E t F
  have hcomm : LineDeriv.lineDerivOp ej Ft =
      restrictTimeCLM ℂ E t (LineDeriv.lineDerivOp ej' F) := by
    ext y
    change fderiv ℝ (fun z => F (euclidCons t z)) y ej = fderiv ℝ F (euclidCons t y) ej'
    have hcons : HasFDerivAt (fun z : SpatialE n => euclidCons t z)
        ((timeSpatialCLE n).symm.toContinuousLinearMap.comp
          (ContinuousLinearMap.inr ℝ ℝ (SpatialE n))) y := by
      have heq : (fun z : SpatialE n => euclidCons t z) =
          fun z => ((timeSpatialCLE n).symm.toContinuousLinearMap.comp
            (ContinuousLinearMap.inr ℝ ℝ (SpatialE n))) z + euclidCons t 0 := by
        funext z; ext i
        refine Fin.cases ?_ ?_ i
        · simp [euclidCons]
        · intro k; simp [euclidCons]
      rw [heq]
      convert (((timeSpatialCLE n).symm.toContinuousLinearMap.comp
        (ContinuousLinearMap.inr ℝ ℝ (SpatialE n))).hasFDerivAt).add (hasFDerivAt_const (euclidCons t 0) y) using 1
      rw [add_zero]
    have hF : HasFDerivAt (fun z : SpatialE n => F (euclidCons t z))
        ((fderiv ℝ F (euclidCons t y)).comp
          ((timeSpatialCLE n).symm.toContinuousLinearMap.comp
            (ContinuousLinearMap.inr ℝ ℝ (SpatialE n)))) y :=
      (F.hasFDerivAt (euclidCons t y)).comp y hcons
    rw [hF.fderiv]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply,
      ContinuousLinearEquiv.coe_coe, timeSpatialCLE_symm_apply]
    congr 1
    ext i
    refine Fin.cases ?_ ?_ i
    · simp [euclidCons, ej']
    · intro k; simp [euclidCons, ej, ej', Fin.succ_inj]
  have hfour := congrFun (congrArg DFunLike.coe (SchwartzMap.fourier_lineDerivOp_eq Ft ej))
    ((2 * Real.pi)⁻¹ • spatialProj p)
  have hinner : inner ℝ ((2 * Real.pi)⁻¹ • spatialProj p) ej =
      (2 * Real.pi)⁻¹ * spatialProj p j := by
    rw [inner_smul_left, EuclideanSpace.inner_single_right]; simp
  have hpi : (2 * Real.pi : ℂ) ≠ 0 := by exact_mod_cast (mul_pos two_pos Real.pi_pos).ne'
  have hsc : (2 * Real.pi * Complex.I) • (((2 * Real.pi)⁻¹ * spatialProj p j : ℝ) •
      (𝓕 Ft) ((2 * Real.pi)⁻¹ • spatialProj p)) =
      (Complex.I * (spatialProj p j : ℂ)) • (𝓕 Ft) ((2 * Real.pi)⁻¹ • spatialProj p) := by
    rw [← Complex.coe_smul ((2 * Real.pi)⁻¹ * spatialProj p j), smul_smul]
    congr 1
    push_cast
    field_simp [hpi]
  have hFT_eq (G : 𝓢(SpatialE n, E)) :
      (𝓕 G) ((2 * Real.pi)⁻¹ • spatialProj p) =
        ∫ y : SpatialE n, Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) • G y := by
    rw [SchwartzMap.fourier_coe, Real.fourier_eq]
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    dsimp only
    rw [Circle.smul_def, Real.fourierChar_apply]
    congr 1; congr 1
    rw [inner_smul_right, real_inner_comm]
    push_cast; field_simp [hpi]
  have hfour' : ∫ y : SpatialE n,
        Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) •
          (LineDeriv.lineDerivOp ej' F) (euclidCons t y) =
      (Complex.I * (spatialProj p j : ℂ)) •
        ∫ y : SpatialE n, Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) •
          F (euclidCons t y) := by
    have h1 : (𝓕 (LineDeriv.lineDerivOp ej Ft)) ((2 * Real.pi)⁻¹ • spatialProj p) =
        (2 * Real.pi * Complex.I) •
          ((SchwartzMap.smulLeftCLM E (inner ℝ · ej) (𝓕 Ft)) ((2 * Real.pi)⁻¹ • spatialProj p)) := hfour
    rw [SchwartzMap.smulLeftCLM_apply_apply (by fun_prop : (inner ℝ · ej).HasTemperateGrowth),
      hinner, hsc, hcomm, hFT_eq, hFT_eq] at h1
    exact h1
  have hsplit (G : 𝓢(EuclidD n, E)) :
      (∫ y : SpatialE n,
          Complex.exp (-Complex.I * (inner ℝ p (euclidCons t y) : ℂ)) • G (euclidCons t y)) =
        Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ)) •
          ∫ y : SpatialE n, Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) •
            G (euclidCons t y) := by
    rw [← integral_smul]
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    dsimp only
    rw [smul_smul, ← Complex.exp_add]
    congr 2
    have hin := euclid_inner_eq p (euclidCons t y)
    simp only [euclidCons_zero, spatialProj_euclidCons] at hin
    rw [hin]; push_cast; ring
  rw [hsplit F, hsplit (LineDeriv.lineDerivOp ej' F), smul_comm (Complex.I * (spatialProj p j : ℂ)),
    hfour']

/-- Spatial Helmholtz continuous linear operator `L_sp F = F - ∑_j ∂²_{y_j} F` on `𝓢(EuclidD n, E)`. -/
noncomputable def spatialHelmholtzCLM (n : ℕ) (E : Type*)
    [NormedAddCommGroup E] [NormedSpace ℂ E] :
    𝓢(EuclidD n, E) →L[ℝ] 𝓢(EuclidD n, E) :=
  let dOp (j : Fin (n + 1)) : 𝓢(EuclidD n, E) →L[ℝ] 𝓢(EuclidD n, E) :=
    (SchwartzMap.evalCLM ℝ (EuclidD n) E (EuclideanSpace.single j.succ (1 : ℝ))).comp
      (SchwartzMap.fderivCLM ℝ (EuclidD n) E)
  ContinuousLinearMap.id ℝ _ - ∑ j : Fin (n + 1), (dOp j).comp (dOp j)

lemma halfSpaceFourierVec_spatialHelmholtz {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (F : 𝓢(EuclidD n, E)) (p : EuclidD n) :
    ((1 + ‖spatialProj p‖ ^ 2 : ℝ) : ℂ) • halfSpaceFourierVec F p =
      halfSpaceFourierVec (spatialHelmholtzCLM n E F) p := by
  have hadd (G₁ G₂ : 𝓢(EuclidD n, E)) :
      halfSpaceFourierVec (G₁ + G₂) p = halfSpaceFourierVec G₁ p + halfSpaceFourierVec G₂ p := by
    unfold halfSpaceFourierVec
    have hint (G : 𝓢(EuclidD n, E)) : IntegrableOn
        (fun x : EuclidD n => Complex.exp (-Complex.I * (inner ℝ p x : ℂ)) • G x)
        (halfSpaceSet n) volume := by
      refine (G.integrable (μ := volume)).norm.integrableOn.mono' ?_ ?_
      · exact ((Complex.continuous_exp.comp (by fun_prop)).smul G.continuous).aestronglyMeasurable
      · filter_upwards with x
        rw [norm_smul,
          show -Complex.I * (inner ℝ p x : ℂ) = (-(inner ℝ p x) : ℝ) * Complex.I by
            push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul]
    simpa [smul_add] using integral_add (hint G₁) (hint G₂)
  have hneg (G : 𝓢(EuclidD n, E)) :
      halfSpaceFourierVec (-G) p = -halfSpaceFourierVec G p := by
    unfold halfSpaceFourierVec
    simpa [smul_neg] using integral_neg (fun x : EuclidD n =>
      Complex.exp (-Complex.I * (inner ℝ p x : ℂ)) • G x)
  have hsub (G₁ G₂ : 𝓢(EuclidD n, E)) :
      halfSpaceFourierVec (G₁ - G₂) p = halfSpaceFourierVec G₁ p - halfSpaceFourierVec G₂ p := by
    rw [sub_eq_add_neg, hadd, hneg, sub_eq_add_neg]
  have hsum (s : Finset (Fin (n + 1))) (G : Fin (n + 1) → 𝓢(EuclidD n, E)) :
      halfSpaceFourierVec (∑ j ∈ s, G j) p = ∑ j ∈ s, halfSpaceFourierVec (G j) p := by
    induction s using Finset.induction_on with
    | empty => simp [halfSpaceFourierVec]
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, hadd, ih]
  have hsq_j (j : Fin (n + 1)) :
      (((spatialProj p j) ^ 2 : ℝ) : ℂ) • halfSpaceFourierVec F p =
        -halfSpaceFourierVec
          (LineDeriv.lineDerivOp (EuclideanSpace.single j.succ (1 : ℝ))
            (LineDeriv.lineDerivOp (EuclideanSpace.single j.succ (1 : ℝ)) F)) p := by
    have h1 := halfSpaceFourierVec_spatial_ibp F j p
    have h2 := halfSpaceFourierVec_spatial_ibp
      (LineDeriv.lineDerivOp (EuclideanSpace.single j.succ (1 : ℝ)) F) j p
    rw [← h1, smul_smul] at h2
    have hmul : (Complex.I * (spatialProj p j : ℂ)) * (Complex.I * (spatialProj p j : ℂ)) =
        -(((spatialProj p j) ^ 2 : ℝ) : ℂ) := by
      push_cast
      linear_combination ((spatialProj p j : ℂ) ^ 2) * Complex.I_sq
    rw [hmul, neg_smul] at h2
    exact neg_eq_iff_eq_neg.mp h2
  have hnorm_sq : ((1 + ‖spatialProj p‖ ^ 2 : ℝ) : ℂ) =
      1 + ∑ j : Fin (n + 1), (((spatialProj p j) ^ 2 : ℝ) : ℂ) := by
    rw [EuclideanSpace.norm_sq_eq]
    have hsum_real : ∑ j : Fin (n + 1), ‖spatialProj p j‖ ^ 2 =
        ∑ j : Fin (n + 1), (spatialProj p j) ^ 2 := by
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Real.norm_eq_abs, sq_abs]
    rw [hsum_real]
    push_cast; rfl
  rw [hnorm_sq, add_smul, one_smul, Finset.sum_smul]
  simp_rw [hsq_j, Finset.sum_neg_distrib, ← sub_eq_add_neg]
  unfold spatialHelmholtzCLM
  simp only [sub_apply, ContinuousLinearMap.id_apply, sum_apply, ContinuousLinearMap.comp_apply]
  rw [hsub, hsum]
  rfl

/-- Iterated spatial Helmholtz identity:
`((1 + ‖spatialProj p‖²)^k) • H_+(F)(p) = H_+(L_sp^k F)(p)`. -/
lemma halfSpaceFourierVec_spatialHelmholtz_iter {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E] :
    ∀ (k : ℕ) (F : 𝓢(EuclidD n, E)) (p : EuclidD n),
      (((1 + ‖spatialProj p‖ ^ 2) ^ k : ℝ) : ℂ) • halfSpaceFourierVec F p =
        halfSpaceFourierVec ((spatialHelmholtzCLM n E)^[k] F) p := by
  intro k
  induction k with
  | zero => intro F p; simp
  | succ k ih =>
    intro F p
    rw [Function.iterate_succ_apply', ← halfSpaceFourierVec_spatialHelmholtz, ← ih, smul_smul]
    congr 1; push_cast; ring

/-- 0-th order uniform decay bound on `halfSpaceFourierVec F p` for ANY Banach space `E`. -/
lemma norm_halfSpaceFourierVec_le {n : ℕ} (E : Type*)
    [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E] :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (F : 𝓢(EuclidD n, E)) (p : EuclidD n),
        ‖halfSpaceFourierVec F p‖ ≤
          C * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) F := by
  -- First prove the `(1 + |p 0|)⁻¹` bound for any `G : 𝓢(EuclidD n, E)`
  have hbase : ∃ (s₀ : Finset (ℕ × ℕ)) (C₀ : ℝ), 0 < C₀ ∧
      ∀ (G : 𝓢(EuclidD n, E)) (p : EuclidD n),
        (1 + |p 0|) * ‖halfSpaceFourierVec G p‖ ≤
          C₀ * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by
    -- Helper: `∫ ‖G x‖ dx ≤ C_int * seminorm G` on `ℝ^d`
    have hint_bound : ∀ (d : ℕ), ∃ (si : Finset (ℕ × ℕ)) (Ci : ℝ), 0 < Ci ∧
        ∀ (G : 𝓢(EuclideanSpace ℝ (Fin d), E)),
          ∫ x : EuclideanSpace ℝ (Fin d), ‖G x‖ ≤
            Ci * (si.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by
      intro d
      let si : Finset (ℕ × ℕ) := Finset.Iic (d + 1, 0)
      have hI : Integrable (fun x : EuclideanSpace ℝ (Fin d) =>
          (1 + ‖x‖) ^ (-((d + 1 : ℕ) : ℝ))) volume :=
        integrable_one_add_norm (E := EuclideanSpace ℝ (Fin d)) (μ := volume)
          (r := ((d + 1 : ℕ) : ℝ)) (by simp)
      let Ival : ℝ := ∫ x : EuclideanSpace ℝ (Fin d), (1 + ‖x‖) ^ (-((d + 1 : ℕ) : ℝ))
      have hI_pos : 0 < Ival := by
        refine integral_pos_of_integrable_nonneg_nonzero (x := 0)
          ((continuous_const.add continuous_norm).rpow_const fun x =>
            Or.inl (by positivity : (1 + ‖x‖) ≠ 0))
          hI (fun x => by positivity) (by simp)
      refine ⟨si, 2 ^ (d + 1) * Ival, by positivity, fun G => ?_⟩
      have hpt : ∀ x : EuclideanSpace ℝ (Fin d), ‖G x‖ ≤
          (1 + ‖x‖) ^ (-((d + 1 : ℕ) : ℝ)) *
            (2 ^ (d + 1) * (si.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G) := by
        intro x
        rw [Real.rpow_neg (by positivity), Real.rpow_natCast, ← div_eq_inv_mul,
          le_div_iff₀' (by positivity)]
        simpa [si] using SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
          (m := (d + 1, 0)) (k := d + 1) (n := 0) le_rfl le_rfl G x
      calc ∫ x : EuclideanSpace ℝ (Fin d), ‖G x‖
          ≤ ∫ x : EuclideanSpace ℝ (Fin d), (1 + ‖x‖) ^ (-((d + 1 : ℕ) : ℝ)) *
              (2 ^ (d + 1) * (si.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G) :=
            integral_mono G.integrable.norm (hI.mul_const _) hpt
        _ = (2 ^ (d + 1) * Ival) * (si.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by
            rw [integral_mul_const]; dsimp [Ival]; ring
    obtain ⟨sD, CD, hCD, hD⟩ := hint_bound (n + 2)
    obtain ⟨sS, CS, hCS, hS⟩ := hint_bound (n + 1)
    let d0CLM : 𝓢(EuclidD n, E) →L[ℝ] 𝓢(EuclidD n, E) :=
      (SchwartzMap.evalCLM ℝ (EuclidD n) E (EuclideanSpace.single 0 (1 : ℝ))).comp
        (SchwartzMap.fderivCLM ℝ (EuclidD n) E)
    obtain ⟨s_d0, C_d0, hC_d0, hd0⟩ := schwartz_clm_seminorm_bound d0CLM sD
    obtain ⟨s_r0, C_r0, hC_r0, hr0⟩ := schwartz_clm_seminorm_bound
      ((restrictTimeCLM ℂ E 0).restrictScalars ℝ) sS
    let s₀ : Finset (ℕ × ℕ) := sD ∪ s_d0 ∪ s_r0
    let C₀ : ℝ := CD + CS * C_r0 + CD * C_d0
    refine ⟨s₀, C₀, by positivity, fun G p => ?_⟩
    have hnorm_H (H : 𝓢(EuclidD n, E)) : ‖halfSpaceFourierVec H p‖ ≤ ∫ x : EuclidD n, ‖H x‖ := by
      unfold halfSpaceFourierVec
      refine (norm_integral_le_integral_norm _).trans ?_
      rw [← MeasureTheory.integral_indicator (measurableSet_halfSpaceSet n)]
      refine integral_mono_of_nonneg (ae_of_all _ fun x => by
          by_cases hx : x ∈ halfSpaceSet n
          · simp [Set.indicator_of_mem hx]
          · simp [Set.indicator_of_notMem hx]) H.integrable.norm (ae_of_all _ fun x => ?_)
      by_cases hx : x ∈ halfSpaceSet n
      · rw [Set.indicator_of_mem hx, norm_smul,
          show -Complex.I * (inner ℝ p x : ℂ) = (-(inner ℝ p x) : ℝ) * Complex.I by
            push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul]
      · rw [Set.indicator_of_notMem hx]; exact norm_nonneg _
    have h1 : ‖halfSpaceFourierVec G p‖ ≤
        CD * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by
      refine (hnorm_H G).trans ((hD G).trans ?_)
      gcongr
      exact Seminorm.le_def.mp
        (Finset.sup_mono (f := fun q : ℕ × ℕ => SchwartzMap.seminorm ℝ q.1 q.2)
          (Finset.subset_union_left.trans Finset.subset_union_left)) G
    have h2 : |p 0| * ‖halfSpaceFourierVec G p‖ ≤
        (CS * C_r0 + CD * C_d0) * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by
      have hibp := halfSpaceFourierVec_time_ibp G p
      have hnorm_lhs : ‖(Complex.I * (p 0 : ℂ)) • halfSpaceFourierVec G p‖ =
          |p 0| * ‖halfSpaceFourierVec G p‖ := by
        rw [norm_smul, norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs]
      rw [← hnorm_lhs, hibp]
      refine (norm_add_le _ _).trans ?_
      have hbd1 : ‖∫ y : SpatialE n,
          Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) • G (euclidCons 0 y)‖ ≤
          CS * C_r0 * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by
        have hstep : ‖∫ y : SpatialE n,
            Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) • G (euclidCons 0 y)‖ ≤
            ∫ y : SpatialE n, ‖restrictTimeCLM ℂ E 0 G y‖ := by
          refine (norm_integral_le_integral_norm _).trans_eq ?_
          refine integral_congr_ae (ae_of_all _ fun y => ?_)
          dsimp only
          rw [norm_smul,
            show -Complex.I * (inner ℝ (spatialProj p) y : ℂ) = (-(inner ℝ (spatialProj p) y) : ℝ) * Complex.I by
              push_cast; ring,
            Complex.norm_exp_ofReal_mul_I, one_mul]; rfl
        calc ‖∫ y : SpatialE n,
                Complex.exp (-Complex.I * (inner ℝ (spatialProj p) y : ℂ)) • G (euclidCons 0 y)‖
            ≤ ∫ y : SpatialE n, ‖restrictTimeCLM ℂ E 0 G y‖ := hstep
          _ ≤ CS * (sS.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) (restrictTimeCLM ℂ E 0 G) :=
              hS (restrictTimeCLM ℂ E 0 G)
          _ ≤ CS * (C_r0 * (s_r0.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G) := by
              gcongr; exact hr0 G
          _ ≤ CS * (C_r0 * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G) := by
              gcongr
              exact Seminorm.le_def.mp
                (Finset.sup_mono (f := fun q : ℕ × ℕ => SchwartzMap.seminorm ℝ q.1 q.2)
                  Finset.subset_union_right) G
          _ = CS * C_r0 * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by ring
      have hbd2 : ‖halfSpaceFourierVec
            (LineDeriv.lineDerivOp (EuclideanSpace.single (0 : Fin (n + 2)) (1 : ℝ)) G) p‖ ≤
          CD * C_d0 * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by
        calc ‖halfSpaceFourierVec (d0CLM G) p‖
            ≤ ∫ x : EuclidD n, ‖d0CLM G x‖ := hnorm_H (d0CLM G)
          _ ≤ CD * (sD.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) (d0CLM G) := hD (d0CLM G)
          _ ≤ CD * (C_d0 * (s_d0.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G) := by
              gcongr; exact hd0 G
          _ ≤ CD * (C_d0 * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G) := by
              gcongr
              exact Seminorm.le_def.mp
                (Finset.sup_mono (f := fun q : ℕ × ℕ => SchwartzMap.seminorm ℝ q.1 q.2)
                  (Finset.subset_union_right.trans Finset.subset_union_left)) G
          _ = CD * C_d0 * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) G := by ring
      linarith
    rw [add_mul, one_mul]
    dsimp [C₀]; linarith
  obtain ⟨s₀, C₀, hC₀, h0⟩ := hbase
  let iterHelm : 𝓢(EuclidD n, E) →L[ℝ] 𝓢(EuclidD n, E) :=
    (spatialHelmholtzCLM n E) ^ (n + 1)
  have hiter_eq : ∀ (k : ℕ) (F : 𝓢(EuclidD n, E)),
      ((spatialHelmholtzCLM n E) ^ k) F = (spatialHelmholtzCLM n E)^[k] F := by
    intro k
    induction k with
    | zero => intro F; rfl
    | succ k ih =>
      intro F
      rw [pow_succ']
      change (spatialHelmholtzCLM n E) (((spatialHelmholtzCLM n E) ^ k) F) = _
      rw [ih, Function.iterate_succ_apply']
  obtain ⟨s, C₁, hC₁, hclm⟩ := schwartz_clm_seminorm_bound iterHelm s₀
  refine ⟨s, C₀ * C₁, mul_pos hC₀ hC₁, fun F p => ?_⟩
  have hpos1 : (0 : ℝ) < 1 + |p 0| := by positivity
  have hpos2 : (0 : ℝ) < (1 + ‖spatialProj p‖ ^ 2) ^ (n + 1) := by positivity
  have hnorm_iter : ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1) : ℝ) * ‖halfSpaceFourierVec F p‖ =
      ‖halfSpaceFourierVec (iterHelm F) p‖ := by
    rw [show iterHelm F = (spatialHelmholtzCLM n E)^[n + 1] F from hiter_eq (n + 1) F,
      ← halfSpaceFourierVec_spatialHelmholtz_iter (n + 1) F p, norm_smul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos2]
  have hbd := h0 (iterHelm F) p
  rw [← hnorm_iter] at hbd
  have hle : (1 + |p 0|) * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1) : ℝ) * ‖halfSpaceFourierVec F p‖ ≤
      C₀ * C₁ * (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) F := by
    calc (1 + |p 0|) * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1) : ℝ) * ‖halfSpaceFourierVec F p‖
        = (1 + |p 0|) * (((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1) : ℝ) * ‖halfSpaceFourierVec F p‖) := by ring
      _ ≤ C₀ * (s₀.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) (iterHelm F) := hbd
      _ ≤ C₀ * (C₁ * (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) F) := by
          gcongr; exact hclm F
      _ = C₀ * C₁ * (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) F := by ring
  rw [mul_assoc (C₀ * C₁), ← mul_inv, mul_comm (C₀ * C₁), mul_assoc, ← div_eq_inv_mul,
    le_div_iff₀' (mul_pos hpos1 hpos2)]
  exact hle

/-- Exact `iteratedFDeriv ℝ r` decay bound for `halfSpaceFourierVec F` at EVERY order `r : ℕ`. -/
lemma norm_iteratedFDeriv_halfSpaceFourierVec_le {n : ℕ} :
    ∀ (r : ℕ) (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E],
      ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
        ∀ (F : 𝓢(EuclidD n, E)) (p : EuclidD n),
          ‖iteratedFDeriv ℝ r (halfSpaceFourierVec F) p‖ ≤
            C * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
              (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) F := by
  intro r
  induction r with
  | zero =>
    intro E _ _ _
    obtain ⟨s, C, hC, hbd⟩ := norm_halfSpaceFourierVec_le (n := n) E
    refine ⟨s, C, hC, fun F p => ?_⟩
    rw [norm_iteratedFDeriv_zero]
    exact hbd F p
  | succ r ih =>
    intro E _ _ _
    obtain ⟨s', C', hC', hbd'⟩ := ih (EuclidD n →L[ℝ] E)
    let T : 𝓢(EuclidD n, E) →L[ℝ] 𝓢(EuclidD n, EuclidD n →L[ℝ] E) :=
      (((-Complex.I) • SchwartzMap.smulRightCLM ℂ E (innerSL ℝ)).restrictScalars ℝ)
    obtain ⟨s, CT, hCT, hclm⟩ := schwartz_clm_seminorm_bound T s'
    refine ⟨s, C' * CT, mul_pos hC' hCT, fun F p => ?_⟩
    have hfd : fderiv ℝ (halfSpaceFourierVec F) = halfSpaceFourierVec (T F) := by
      funext q; exact (hasFDerivAt_halfSpaceFourierVec F q).fderiv
    rw [← norm_iteratedFDeriv_fderiv, hfd]
    calc ‖iteratedFDeriv ℝ r (halfSpaceFourierVec (T F)) p‖
        ≤ C' * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s'.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) (T F) := hbd' (T F) p
      _ ≤ C' * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (CT * (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) F) := by
          gcongr; exact hclm F
      _ = (C' * CT) * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) F := by ring

/-- **Deliverable 3:** Upper half-space Dirichlet kernel `K₊ f p` matching Paper 1's exact normalization:
`dirichletPosKernel n ħ m f p = √(ħ / (π (m² + ‖p‖²))) * ∫_{t > 0} sin(p₀ t) * f̂_x(t, k) dt`. -/
noncomputable def dirichletPosKernel (n : ℕ) (ħ m : ℝ) (f : 𝓢(EuclidD n, ℝ)) (p : EuclidD n) : ℂ :=
  dirichletWeight ħ m p *
    ∫ t in Ioi (0 : ℝ), (Real.sin (p 0 * t) : ℂ) * spatialPhysicsFourier f t (spatialProj p)

/-- Exact identity expressing `dirichletPosKernel` via `halfSpaceFourierVec`:
`K₊ f p = w₊(p) * ((2π)^(-(n+1)/2) / (2i)) * (H_+(f)(Θ p) - H_+(f)(p))`. -/
lemma dirichletPosKernel_eq_halfSpaceFourier (n : ℕ) (ħ m : ℝ)
    (f : 𝓢(EuclidD n, ℝ)) (p : EuclidD n) :
    dirichletPosKernel n ħ m f p =
      dirichletWeight ħ m p *
        ((((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) / (2 * Complex.I)) *
          (halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) (euclidTimeReflect p) -
            halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) p)) := by
  unfold dirichletPosKernel
  congr 1
  let fC : 𝓢(EuclidD n, ℂ) := SchwartzMap.postcompCLM Complex.ofRealCLM f
  have hH (q : EuclidD n) :
      (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) : ℂ) * halfSpaceFourierVec fC q =
        ∫ t in Ioi (0 : ℝ), Complex.exp (-Complex.I * ((q 0 * t : ℝ) : ℂ)) *
          spatialPhysicsFourier f t (spatialProj q) := by
    rw [halfSpaceFourierVec_eq_prod, ← integral_const_mul]
    refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
    unfold spatialPhysicsFourier
    rw [physicsFourierExact_eq_integral, ← integral_const_mul, ← integral_const_mul, ← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    dsimp only
    rw [smul_eq_mul]
    have hin := euclid_inner_eq q (euclidCons t y)
    simp only [euclidCons_zero, spatialProj_euclidCons] at hin
    rw [hin, real_inner_comm]
    have hexp : -Complex.I * ((q 0 * t + inner ℝ y (spatialProj q) : ℝ) : ℂ) =
        -Complex.I * ((q 0 * t : ℝ) : ℂ) + -Complex.I * (inner ℝ y (spatialProj q) : ℂ) := by
      push_cast; ring
    rw [hexp, Complex.exp_add]
    change (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) : ℂ) *
        (Complex.exp (-Complex.I * ((q 0 * t : ℝ) : ℂ)) *
          Complex.exp (-Complex.I * (inner ℝ y (spatialProj q) : ℂ)) * (f (euclidCons t y) : ℂ)) = _
    ring
  have hint_exp (r : ℝ) : IntegrableOn
      (fun t : ℝ => Complex.exp (-Complex.I * ((r * t : ℝ) : ℂ)) *
        spatialPhysicsFourier f t (spatialProj p)) (Ioi 0) volume := by
    refine (integrable_norm_spatialPhysicsFourier f (spatialProj p)).integrableOn.mono' ?_ ?_
    · exact ((Complex.continuous_exp.comp (by fun_prop)).mul
        (continuous_spatialPhysicsFourier f (spatialProj p))).aestronglyMeasurable
    · filter_upwards with t
      rw [norm_mul,
        show -Complex.I * ((r * t : ℝ) : ℂ) = (-(r * t) : ℝ) * Complex.I by
          push_cast; ring,
        Complex.norm_exp_ofReal_mul_I, one_mul]
  have hdiff : (((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) : ℂ) *
      (halfSpaceFourierVec fC (euclidTimeReflect p) - halfSpaceFourierVec fC p) =
      ∫ t in Ioi (0 : ℝ),
        (Complex.exp (Complex.I * ((p 0 * t : ℝ) : ℂ)) -
          Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ))) *
        spatialPhysicsFourier f t (spatialProj p) := by
    rw [mul_sub, hH (euclidTimeReflect p), hH p]
    simp only [euclidTimeReflect_zero, spatialProj_euclidTimeReflect]
    rw [← integral_sub (hint_exp (-p 0)) (hint_exp (p 0))]
    refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
    have hexp : -Complex.I * ((-p 0 * t : ℝ) : ℂ) = Complex.I * ((p 0 * t : ℝ) : ℂ) := by
      push_cast; ring
    rw [hexp]; ring
  rw [div_mul_eq_mul_div, hdiff, div_eq_inv_mul, ← integral_const_mul]
  refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
  rw [← mul_assoc]
  congr 1
  rw [Complex.ofReal_sin, Complex.sin]
  have h1 : Complex.exp (((p 0 * t : ℝ) : ℂ) * Complex.I) =
      Complex.exp (Complex.I * ((p 0 * t : ℝ) : ℂ)) := by congr 1; ring
  have h2 : Complex.exp (-((p 0 * t : ℝ) : ℂ) * Complex.I) =
      Complex.exp (-Complex.I * ((p 0 * t : ℝ) : ℂ)) := by congr 1; ring
  rw [h1, h2]
  have h2I : (2 * Complex.I : ℂ) ≠ 0 := by simp
  rw [show -Complex.I * ((p 0 * t : ℝ) : ℂ) = -(Complex.I * ((p 0 * t : ℝ) : ℂ)) by ring]
  field_simp [h2I]
  linear_combination (Complex.exp (-(Complex.I * ((p 0 * t : ℝ) : ℂ))) -
    Complex.exp (Complex.I * ((p 0 * t : ℝ) : ℂ))) * Complex.I_sq

lemma dirichletPosKernel_add (n : ℕ) (ħ m : ℝ) (f g : 𝓢(EuclidD n, ℝ)) (p : EuclidD n) :
    dirichletPosKernel n ħ m (f + g) p =
      dirichletPosKernel n ħ m f p + dirichletPosKernel n ħ m g p := by
  rw [dirichletPosKernel_eq_halfSpaceFourier, dirichletPosKernel_eq_halfSpaceFourier,
    dirichletPosKernel_eq_halfSpaceFourier]
  have haddH (q : EuclidD n) :
      halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM (f + g)) q =
        halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) q +
        halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM g) q := by
    unfold halfSpaceFourierVec
    have hint (h : 𝓢(EuclidD n, ℝ)) : IntegrableOn
        (fun x : EuclidD n => Complex.exp (-Complex.I * (inner ℝ q x : ℂ)) •
          SchwartzMap.postcompCLM Complex.ofRealCLM h x) (halfSpaceSet n) volume := by
      refine (h.integrable (μ := volume)).norm.integrableOn.mono' ?_ ?_
      · exact ((Complex.continuous_exp.comp (by fun_prop)).smul
          (SchwartzMap.postcompCLM Complex.ofRealCLM h).continuous).aestronglyMeasurable
      · filter_upwards with x
        rw [norm_smul,
          show -Complex.I * (inner ℝ q x : ℂ) = (-(inner ℝ q x) : ℝ) * Complex.I by
            push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul, SchwartzMap.postcompCLM_apply,
          Complex.ofRealCLM_apply, Complex.norm_real]
    rw [← integral_add (hint f) (hint g)]
    refine setIntegral_congr_fun (measurableSet_halfSpaceSet n) fun x _ => ?_
    simp only [map_add, smul_eq_mul, add_apply, SchwartzMap.postcompCLM_apply,
      Complex.ofRealCLM_apply]
    ring
  rw [haddH (euclidTimeReflect p), haddH p]; ring

lemma dirichletPosKernel_smul (n : ℕ) (ħ m : ℝ) (c : ℝ) (f : 𝓢(EuclidD n, ℝ)) (p : EuclidD n) :
    dirichletPosKernel n ħ m (c • f) p = (c : ℂ) * dirichletPosKernel n ħ m f p := by
  rw [dirichletPosKernel_eq_halfSpaceFourier, dirichletPosKernel_eq_halfSpaceFourier]
  have hsmulH (q : EuclidD n) :
      halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM (c • f)) q =
        (c : ℂ) * halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) q := by
    unfold halfSpaceFourierVec
    rw [map_smul, ← integral_const_mul]
    refine setIntegral_congr_fun (measurableSet_halfSpaceSet n) fun x _ => ?_
    simp only [FunLike.coe_smul, Pi.smul_apply, smul_eq_mul, Complex.real_smul]
    ring
  rw [hsmulH (euclidTimeReflect p), hsmulH p]; ring

/-- **Half-space vanishing (`supp f ⊆ {t ≤ 0} ⟹ K₊ f = 0`):** -/
theorem dirichletPosKernel_eq_zero_of_support_nonpos (n : ℕ) (ħ m : ℝ)
    (f : 𝓢(EuclidD n, ℝ)) (hf : ∀ x : EuclidD n, 0 < x 0 → f x = 0) :
    dirichletPosKernel n ħ m f = 0 := by
  funext p
  rw [dirichletPosKernel_eq_halfSpaceFourier]
  have hzero (q : EuclidD n) :
      halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) q = 0 := by
    unfold halfSpaceFourierVec
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    have hfx : f x = 0 := hf x hx
    simp [SchwartzMap.postcompCLM_apply, hfx]
  simp [hzero]

/-- Smoothness (`ContDiff ℝ ⊤`) of `dirichletPosKernel n ħ m f`. -/
theorem dirichletPosKernel_contDiff (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) : ContDiff ℝ (⊤ : ℕ∞) (dirichletPosKernel n ħ m f) := by
  have heq : dirichletPosKernel n ħ m f = fun p =>
      dirichletWeight ħ m p *
        ((((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) / (2 * Complex.I)) *
          (halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) (euclidTimeReflect p) -
            halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) p)) :=
    funext (dirichletPosKernel_eq_halfSpaceFourier n ħ m f)
  rw [heq]
  have hH := contDiff_halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f)
  have hH_ref : ContDiff ℝ (⊤ : ℕ∞)
      (fun p => halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) (euclidTimeReflect p)) :=
    hH.comp (euclidTimeReflectLI n).toContinuousLinearEquiv.contDiff
  exact (dirichletWeight_contDiff ħ hm).mul (contDiff_const.mul (hH_ref.sub hH))

/-- **Deliverable 3 (Derivative Bound):** Exact uniform derivative bound for `dirichletPosKernel`
matching Track 1's Fourier frame (`k ≤ 2 * (n + 2)`). -/
theorem dirichletPosKernel_iteratedFDeriv_bound (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (z : Fin (n + 2) → ℤ) (k : ℕ), k ≤ 2 * (n + 2) →
        ∀ (u : EuclidD n), (∀ i, u i ∈ Set.Icc (-1 : ℝ) 1) →
          ∀ (f : 𝓢(EuclidD n, ℝ)),
            ‖iteratedFDeriv ℝ k (dirichletPosKernel n ħ m f)
                (WithLp.toLp 2 (fun i => (z i : ℝ)) + u)‖ ≤
              C * (∏ i : Fin (n + 2), (1 + (z i : ℝ) ^ 2)⁻¹) *
                (s.sup (fun p => SchwartzMap.seminorm ℝ p.1 p.2)) f := by
  let K : ℕ := 2 * (n + 2)
  -- Collect finite uniform bounds on `D^j (dirichletWeight ħ m)` for all `j ≤ K`
  have hw_all : ∃ Cw : ℝ, 0 < Cw ∧ ∀ j ≤ K, ∀ p : EuclidD n,
      ‖iteratedFDeriv ℝ j (dirichletWeight ħ m) p‖ ≤ Cw * (1 + |p 0|)⁻¹ := by
    choose Cj hCj_pos hCj using fun j : Fin (K + 1) =>
      norm_iteratedFDeriv_dirichletWeight (n := n) ħ hm j.1
    have hsum_nn : 0 ≤ ∑ i : Fin (K + 1), Cj i := Finset.sum_nonneg fun i _ => (hCj_pos i).le
    refine ⟨(∑ j : Fin (K + 1), Cj j) + 1, by linarith, fun j hj p => ?_⟩
    have hle : Cj ⟨j, Nat.lt_succ_of_le hj⟩ ≤ (∑ i : Fin (K + 1), Cj i) + 1 := by
      have h1 : Cj ⟨j, Nat.lt_succ_of_le hj⟩ ≤ ∑ i : Fin (K + 1), Cj i :=
        Finset.single_le_sum (fun i _ => (hCj_pos i).le) (Finset.mem_univ _)
      linarith
    exact (hCj ⟨j, Nat.lt_succ_of_le hj⟩ p).trans (mul_le_mul_of_nonneg_right hle (by positivity))
  -- Collect finite uniform bounds on `D^r (halfSpaceFourierVec (ofReal f))` for all `r ≤ K`
  have hH_all : ∃ (s : Finset (ℕ × ℕ)) (CH : ℝ), 0 < CH ∧
      ∀ r ≤ K, ∀ (f : 𝓢(EuclidD n, ℝ)) (p : EuclidD n),
        ‖iteratedFDeriv ℝ r (halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f)) p‖ ≤
          CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by
    choose sr Cr hCr_pos hCr using fun r : Fin (K + 1) =>
      norm_iteratedFDeriv_halfSpaceFourierVec_le (n := n) r.1 ℂ
    let sC : Finset (ℕ × ℕ) := Finset.univ.biUnion sr
    obtain ⟨s, C_ofR, hC_ofR, hofR⟩ := schwartz_clm_seminorm_bound
      (SchwartzMap.postcompCLM (E := EuclidD n) Complex.ofRealCLM) sC
    have hsum_nn : 0 ≤ ∑ i : Fin (K + 1), Cr i := Finset.sum_nonneg fun i _ => (hCr_pos i).le
    let CH : ℝ := ((∑ r : Fin (K + 1), Cr r) + 1) * C_ofR
    have hCH_pos : 0 < CH := mul_pos (by linarith) hC_ofR
    refine ⟨s, CH, hCH_pos, fun r hr f p => ?_⟩
    let rf : Fin (K + 1) := ⟨r, Nat.lt_succ_of_le hr⟩
    have hCr_le : Cr rf ≤ (∑ i : Fin (K + 1), Cr i) + 1 := by
      have h1 : Cr rf ≤ ∑ i : Fin (K + 1), Cr i :=
        Finset.single_le_sum (fun i _ => (hCr_pos i).le) (Finset.mem_univ _)
      linarith
    have hsr_sub : sr rf ⊆ sC := Finset.subset_biUnion_of_mem sr (Finset.mem_univ rf)
    have hsup_le : ((sr rf).sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2))
          (SchwartzMap.postcompCLM Complex.ofRealCLM f) ≤
        (sC.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2))
          (SchwartzMap.postcompCLM Complex.ofRealCLM f) :=
      Seminorm.le_def.mp
        (Finset.sup_mono (f := fun q : ℕ × ℕ => SchwartzMap.seminorm ℝ q.1 q.2) hsr_sub) _
    have hpref_nn : 0 ≤ ((∑ i : Fin (K + 1), Cr i) + 1) * (1 + |p 0|)⁻¹ *
        ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ := by
      have h1 : (0 : ℝ) < (∑ i : Fin (K + 1), Cr i) + 1 := by linarith
      positivity
    calc ‖iteratedFDeriv ℝ r (halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f)) p‖
        ≤ Cr rf * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            ((sr rf).sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2))
              (SchwartzMap.postcompCLM Complex.ofRealCLM f) :=
          hCr rf (SchwartzMap.postcompCLM Complex.ofRealCLM f) p
      _ ≤ ((∑ i : Fin (K + 1), Cr i) + 1) * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (sC.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2))
              (SchwartzMap.postcompCLM Complex.ofRealCLM f) := by
          gcongr
      _ ≤ ((∑ i : Fin (K + 1), Cr i) + 1) * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (C_ofR * (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f) :=
          mul_le_mul_of_nonneg_left (hofR f) hpref_nn
      _ = CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by dsimp [CH]; ring
  obtain ⟨Cw, hCw, hw⟩ := hw_all
  obtain ⟨s, CH, hCH, hH⟩ := hH_all
  let c0 : ℂ := ((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) / (2 * Complex.I)
  let Ctot : ℝ := 2 * 3 ^ (n + 1) * (2 ^ K : ℝ) * Cw * (‖c0‖ * 2 * CH)
  have hc0_pos : 0 < ‖c0‖ := by
    dsimp [c0]
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, norm_mul,
      show ‖(2 : ℂ)‖ = 2 by norm_num, Complex.norm_I, mul_one]
    have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
    rw [abs_of_pos (Real.rpow_pos_of_pos h2pi_pos _)]
    positivity
  refine ⟨s, Ctot, by positivity, fun z k hk u hu f => ?_⟩
  let p : EuclidD n := WithLp.toLp 2 (fun i => (z i : ℝ)) + u
  have hu_abs : ∀ i, |u i| ≤ 1 := fun i => abs_le.mpr (hu i)
  -- Express `dirichletPosKernel n ħ m f = dirichletWeight ħ m * S`
  let S : EuclidD n → ℂ := fun q =>
    c0 * (halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) (euclidTimeReflect q) -
      halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f) q)
  have hKeq : dirichletPosKernel n ħ m f = fun q => dirichletWeight ħ m q * S q :=
    funext (dirichletPosKernel_eq_halfSpaceFourier n ħ m f)
  have hS_smooth : ContDiff ℝ (⊤ : ℕ∞) S := by
    have hH_s := contDiff_halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f)
    exact contDiff_const.mul ((hH_s.comp (euclidTimeReflectLI n).toContinuousLinearEquiv.contDiff).sub hH_s)
  have hS_bd : ∀ r ≤ K,
      ‖iteratedFDeriv ℝ r S p‖ ≤
        (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by
    intro r hr
    let Hfun : EuclidD n → ℂ := halfSpaceFourierVec (SchwartzMap.postcompCLM Complex.ofRealCLM f)
    let Href : EuclidD n → ℂ := Hfun ∘ (euclidTimeReflectLI n).toContinuousLinearEquiv
    have hH_s : ContDiff ℝ (⊤ : ℕ∞) Hfun := contDiff_halfSpaceFourierVec _
    have hHref_s : ContDiff ℝ (⊤ : ℕ∞) Href :=
      hH_s.comp (euclidTimeReflectLI n).toContinuousLinearEquiv.contDiff
    have hS_eq : S = c0 • (fun q => Href q - Hfun q) := by
      funext q; simp [S, Hfun, Href, smul_eq_mul, euclidTimeReflectLI]
    rw [hS_eq, iteratedFDeriv_const_smul_apply
      ((hHref_s.sub hH_s).contDiffAt.of_le (mod_cast le_top)),
      norm_smul]
    change ‖c0‖ * ‖iteratedFDeriv ℝ r (Href - Hfun) p‖ ≤ _
    rw [iteratedFDeriv_sub_apply
      (hHref_s.contDiffAt.of_le (mod_cast le_top))
      (hH_s.contDiffAt.of_le (mod_cast le_top))]
    have href_norm : ‖iteratedFDeriv ℝ r Href p‖ ≤
        ‖iteratedFDeriv ℝ r Hfun (euclidTimeReflect p)‖ := by
      have hcomp := (euclidTimeReflectLI n).toContinuousLinearEquiv.toContinuousLinearMap.iteratedFDeriv_comp_right
        hH_s p (i := r) (mod_cast le_top)
      change ‖iteratedFDeriv ℝ r (Hfun ∘ (euclidTimeReflectLI n).toContinuousLinearEquiv.toContinuousLinearMap) p‖ ≤ _
      rw [hcomp]
      have h1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        (iteratedFDeriv ℝ r Hfun (euclidTimeReflect p))
        (fun _ : Fin r => (euclidTimeReflectLI n).toContinuousLinearEquiv.toContinuousLinearMap)
      have hop : ‖(euclidTimeReflectLI n).toContinuousLinearEquiv.toContinuousLinearMap‖ ≤ 1 := by
        refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun v => ?_
        rw [one_mul]; exact ((euclidTimeReflectLI n).norm_map v).le
      refine h1.trans ?_
      have hprod1 : (∏ _i : Fin r, ‖(euclidTimeReflectLI n).toContinuousLinearEquiv.toContinuousLinearMap‖) ≤ 1 := by
        calc ∏ _i : Fin r, ‖(euclidTimeReflectLI n).toContinuousLinearEquiv.toContinuousLinearMap‖
            ≤ ∏ _i : Fin r, (1 : ℝ) := by gcongr
          _ = 1 := by simp
      calc ‖iteratedFDeriv ℝ r Hfun (euclidTimeReflect p)‖ *
              ∏ _i : Fin r, ‖(euclidTimeReflectLI n).toContinuousLinearEquiv.toContinuousLinearMap‖
          ≤ ‖iteratedFDeriv ℝ r Hfun (euclidTimeReflect p)‖ * 1 :=
            mul_le_mul_of_nonneg_left hprod1 (norm_nonneg _)
        _ = ‖iteratedFDeriv ℝ r Hfun (euclidTimeReflect p)‖ := mul_one _
    have hbd_ref : ‖iteratedFDeriv ℝ r Hfun (euclidTimeReflect p)‖ ≤
        CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by
      simpa [euclidTimeReflect_zero, spatialProj_euclidTimeReflect, abs_neg] using
        hH r hr f (euclidTimeReflect p)
    have hbd_p : ‖iteratedFDeriv ℝ r Hfun p‖ ≤
        CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := hH r hr f p
    calc ‖c0‖ * ‖iteratedFDeriv ℝ r Href p - iteratedFDeriv ℝ r Hfun p‖
        ≤ ‖c0‖ * (‖iteratedFDeriv ℝ r Href p‖ + ‖iteratedFDeriv ℝ r Hfun p‖) :=
          mul_le_mul_of_nonneg_left (norm_sub_le _ _) (norm_nonneg _)
      _ ≤ ‖c0‖ * (CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f +
            CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f) := by
          gcongr
          exact href_norm.trans hbd_ref
      _ = (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by ring
  rw [hKeq]
  have hleib := norm_iteratedFDeriv_mul_le (dirichletWeight_contDiff ħ hm) hS_smooth p
    (n := k) (mod_cast le_top)
  have hsum_bd : (∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i (dirichletWeight ħ m) p‖ *
        ‖iteratedFDeriv ℝ (k - i) S p‖) ≤
      (2 ^ K : ℝ) * Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
        ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
        (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by
    have hterm : ∀ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i (dirichletWeight ħ m) p‖ *
          ‖iteratedFDeriv ℝ (k - i) S p‖ ≤
        (k.choose i : ℝ) * (Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
          ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f) := by
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have h1 := hw i (hik.trans hk) p
      have h2 := hS_bd (k - i) ((Nat.sub_le k i).trans hk)
      have hmul : ‖iteratedFDeriv ℝ i (dirichletWeight ħ m) p‖ * ‖iteratedFDeriv ℝ (k - i) S p‖ ≤
          Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
            ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by
        calc ‖iteratedFDeriv ℝ i (dirichletWeight ħ m) p‖ * ‖iteratedFDeriv ℝ (k - i) S p‖
            ≤ (Cw * (1 + |p 0|)⁻¹) *
                ((‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
                  (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f) :=
              mul_le_mul h1 h2 (norm_nonneg _) (by positivity)
          _ = Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
                ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
                (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by ring
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left hmul (Nat.cast_nonneg _)
    refine (Finset.sum_le_sum hterm).trans ?_
    rw [← Finset.sum_mul]
    have hbin : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = (2 : ℝ) ^ k := by
      exact_mod_cast Nat.sum_range_choose k
    rw [hbin]
    have h2le : (2 : ℝ) ^ k ≤ (2 : ℝ) ^ K :=
      pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk
    calc (2 : ℝ) ^ k * (Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
            ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f)
        ≤ (2 : ℝ) ^ K * (Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
            ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f) := by
          gcongr
      _ = (2 ^ K : ℝ) * Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
            ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by ring
  -- Convert `(1 + |p 0|)⁻¹ ^ 2 * ((1 + ‖spatialProj p‖^2)^(n+1))⁻¹` into `∏ i, (1 + (z i)^2)⁻¹`!
  have hz0 : (1 + |p 0|)⁻¹ ^ 2 ≤ 2 * (1 + (z 0 : ℝ) ^ 2)⁻¹ := by
    rw [inv_pow, ← one_div, ← div_eq_mul_inv,
      div_le_div_iff₀ (by positivity) (by positivity)]
    have h0 : (z 0 : ℝ) = p 0 - u 0 := by simp [p]
    have hu0 : (u 0) ^ 2 ≤ 1 := by nlinarith [sq_abs (u 0), abs_nonneg (u 0), hu_abs 0]
    have hle : 1 + (z 0 : ℝ) ^ 2 ≤ 2 * (1 + |p 0|) ^ 2 := by
      rw [h0]
      nlinarith [sq_abs (p 0), abs_nonneg (p 0), sq_nonneg (p 0 + u 0)]
    linarith
  have hz_sp : ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ ≤
      3 ^ (n + 1) * ∏ j : Fin (n + 1), (1 + (z j.succ : ℝ) ^ 2)⁻¹ := by
    rw [Finset.prod_inv_distrib, ← one_div, ← div_eq_mul_inv,
      div_le_div_iff₀ (by positivity) (Finset.prod_pos fun j _ => by positivity)]
    have hsp_eq : spatialProj p =
        WithLp.toLp 2 (fun j : Fin (n + 1) => (z j.succ : ℝ)) + spatialProj u := by
      ext j; simp [p]
    have hprod := prod_one_add_int_sq_le (fun j : Fin (n + 1) => z j.succ) (spatialProj u)
      (fun j => hu_abs j.succ)
    rw [← hsp_eq] at hprod
    linarith
  have hprod_split : (∏ i : Fin (n + 2), (1 + (z i : ℝ) ^ 2)⁻¹) =
      (1 + (z 0 : ℝ) ^ 2)⁻¹ * ∏ j : Fin (n + 1), (1 + (z j.succ : ℝ) ^ 2)⁻¹ :=
    Fin.prod_univ_succ (fun i : Fin (n + 2) => (1 + (z i : ℝ) ^ 2)⁻¹)
  refine hleib.trans (hsum_bd.trans ?_)
  calc (2 ^ K : ℝ) * Cw * (‖c0‖ * 2 * CH) * (1 + |p 0|)⁻¹ ^ 2 *
          ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f
      ≤ (2 ^ K : ℝ) * Cw * (‖c0‖ * 2 * CH) * (2 * (1 + (z 0 : ℝ) ^ 2)⁻¹) *
          (3 ^ (n + 1) * ∏ j : Fin (n + 1), (1 + (z j.succ : ℝ) ^ 2)⁻¹) *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by
        gcongr
    _ = Ctot * ((1 + (z 0 : ℝ) ^ 2)⁻¹ * ∏ j : Fin (n + 1), (1 + (z j.succ : ℝ) ^ 2)⁻¹) *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by dsimp [Ctot]; ring
    _ = Ctot * (∏ i : Fin (n + 2), (1 + (z i : ℝ) ^ 2)⁻¹) *
          (s.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) f := by rw [← hprod_split]

/-- Square-integrability of `dirichletPosKernel n ħ m f` on `EuclidD n`. -/
lemma dirichletPosKernel_integrable_norm_sq (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) :
    Integrable (fun p : EuclidD n => ‖dirichletPosKernel n ħ m f p‖ ^ 2) volume := by
  obtain ⟨Cw, hCw, hw⟩ := norm_iteratedFDeriv_dirichletWeight (n := n) ħ hm 0
  obtain ⟨sH, CH, hCH, hH⟩ := norm_halfSpaceFourierVec_le (n := n) ℂ
  let fC : 𝓢(EuclidD n, ℂ) := SchwartzMap.postcompCLM Complex.ofRealCLM f
  let c0 : ℂ := ((2 * Real.pi) ^ (-((n + 1 : ℕ) : ℝ) / 2) : ℝ) / (2 * Complex.I)
  let M : ℝ := Cw * ‖c0‖ * (2 * CH * (sH.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) fC)
  have hpt : ∀ p : EuclidD n, ‖dirichletPosKernel n ħ m f p‖ ≤
      M * (1 + |p 0|)⁻¹ ^ 2 * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ := by
    intro p
    rw [dirichletPosKernel_eq_halfSpaceFourier, norm_mul, norm_mul]
    have h1 : ‖dirichletWeight ħ m p‖ ≤ Cw * (1 + |p 0|)⁻¹ := by
      simpa [norm_iteratedFDeriv_zero] using hw p
    have h2 : ‖halfSpaceFourierVec fC (euclidTimeReflect p) - halfSpaceFourierVec fC p‖ ≤
        2 * CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
          (sH.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) fC := by
      have ha : ‖halfSpaceFourierVec fC (euclidTimeReflect p)‖ ≤
          CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
            (sH.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) fC := by
        simpa [euclidTimeReflect_zero, spatialProj_euclidTimeReflect, abs_neg] using
          hH fC (euclidTimeReflect p)
      have hb := hH fC p
      have := (norm_sub_le _ _).trans (add_le_add ha hb)
      linarith
    calc ‖dirichletWeight ħ m p‖ * (‖c0‖ * ‖halfSpaceFourierVec fC (euclidTimeReflect p) - halfSpaceFourierVec fC p‖)
        ≤ (Cw * (1 + |p 0|)⁻¹) *
            (‖c0‖ * (2 * CH * (1 + |p 0|)⁻¹ * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ *
              (sH.sup (fun q => SchwartzMap.seminorm ℝ q.1 q.2)) fC)) := by
          gcongr
      _ = M * (1 + |p 0|)⁻¹ ^ 2 * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹ := by dsimp [M]; ring
  -- Integrable dominating function on `ℝ × SpatialE n`
  have htime_int : Integrable (fun p₀ : ℝ => ((1 + |p₀|)⁻¹ ^ 2) ^ 2) volume := by
    refine integrable_inv_one_add_sq.mono' ?_ ?_
    · exact (((continuous_const.add continuous_abs).inv₀
        (fun t => (by positivity : (0 : ℝ) < 1 + |t|).ne')).pow 2 |>.pow 2).aestronglyMeasurable
    · filter_upwards with p₀
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      have h1 : (1 + |p₀|)⁻¹ ^ 2 ≤ (1 + p₀ ^ 2)⁻¹ := by
        rw [inv_pow]
        exact inv_anti₀ (by positivity) (by nlinarith [sq_abs p₀, abs_nonneg p₀])
      have h2 : (1 + |p₀|)⁻¹ ^ 2 ≤ 1 := by
        rw [inv_pow]; exact inv_le_one_of_one_le₀ (by nlinarith [abs_nonneg p₀])
      calc ((1 + |p₀|)⁻¹ ^ 2) ^ 2 = (1 + |p₀|)⁻¹ ^ 2 * (1 + |p₀|)⁻¹ ^ 2 := sq _
        _ ≤ 1 * (1 + p₀ ^ 2)⁻¹ := mul_le_mul h2 h1 (by positivity) zero_le_one
        _ = (1 + p₀ ^ 2)⁻¹ := one_mul _
  have hsp_int : Integrable (fun k : SpatialE n => (((1 + ‖k‖ ^ 2) ^ (n + 1))⁻¹) ^ 2) volume := by
    have hI := integrable_one_add_norm (E := SpatialE n) (μ := volume)
      (r := ((n + 2 : ℕ) : ℝ)) (by simp)
    refine (hI.const_mul (2 ^ (n + 1) : ℝ)).mono' ?_ ?_
    · exact ((((continuous_const.add (continuous_norm.pow 2)).pow (n + 1)).inv₀
        (fun k => (by positivity : (0 : ℝ) < (1 + ‖k‖ ^ 2) ^ (n + 1)).ne')).pow 2).aestronglyMeasurable
    · filter_upwards with k
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      have hle1 : ((1 + ‖k‖ ^ 2) ^ (n + 1))⁻¹ ≤ 1 :=
        inv_le_one_of_one_le₀ (one_le_pow₀ (by linarith [sq_nonneg ‖k‖]))
      have hle2 : ((1 + ‖k‖ ^ 2) ^ (n + 1))⁻¹ ≤ (2 ^ (n + 1) : ℝ) * (1 + ‖k‖) ^ (-((n + 2 : ℕ) : ℝ)) := by
        rw [Real.rpow_neg (by positivity), Real.rpow_natCast, ← div_eq_mul_inv,
          ← one_div, div_le_div_iff₀ (by positivity) (by positivity), one_mul]
        have h1 : (1 + ‖k‖) ^ 2 ≤ 2 * (1 + ‖k‖ ^ 2) := by nlinarith [sq_nonneg (1 - ‖k‖)]
        have h2 : (1 + ‖k‖) ^ (n + 2) ≤ (1 + ‖k‖) ^ (2 * (n + 1)) :=
          pow_le_pow_right₀ (by linarith [norm_nonneg k]) (by omega)
        calc (1 + ‖k‖) ^ (n + 2) ≤ (1 + ‖k‖) ^ (2 * (n + 1)) := h2
          _ = ((1 + ‖k‖) ^ 2) ^ (n + 1) := by rw [pow_mul]
          _ ≤ (2 * (1 + ‖k‖ ^ 2)) ^ (n + 1) := pow_le_pow_left₀ (by positivity) h1 (n + 1)
          _ = 2 ^ (n + 1) * (1 + ‖k‖ ^ 2) ^ (n + 1) := by rw [mul_pow]
      calc (((1 + ‖k‖ ^ 2) ^ (n + 1))⁻¹) ^ 2
          = ((1 + ‖k‖ ^ 2) ^ (n + 1))⁻¹ * ((1 + ‖k‖ ^ 2) ^ (n + 1))⁻¹ := sq _
        _ ≤ 1 * ((2 ^ (n + 1) : ℝ) * (1 + ‖k‖) ^ (-((n + 2 : ℕ) : ℝ))) :=
            mul_le_mul hle1 hle2 (by positivity) zero_le_one
        _ = (2 ^ (n + 1) : ℝ) * (1 + ‖k‖) ^ (-((n + 2 : ℕ) : ℝ)) := one_mul _
  have hprod_int : Integrable (fun q : ℝ × SpatialE n =>
      M ^ 2 * (((1 + |q.1|)⁻¹ ^ 2) ^ 2 * (((1 + ‖q.2‖ ^ 2) ^ (n + 1))⁻¹) ^ 2)) volume :=
    (htime_int.mul_prod hsp_int).const_mul (M ^ 2)
  have hdom : Integrable (fun p : EuclidD n =>
      M ^ 2 * (((1 + |p 0|)⁻¹ ^ 2) ^ 2 * (((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹) ^ 2)) volume :=
    (measurePreserving_timeSpatialCLE n).integrable_comp_of_integrable hprod_int
  refine hdom.mono' (((dirichletPosKernel_contDiff n ħ hm f).continuous.norm.pow 2).aestronglyMeasurable) ?_
  filter_upwards with p
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  have hsq := pow_le_pow_left₀ (norm_nonneg _) (hpt p) 2
  calc ‖dirichletPosKernel n ħ m f p‖ ^ 2
      ≤ (M * (1 + |p 0|)⁻¹ ^ 2 * ((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹) ^ 2 := hsq
    _ = M ^ 2 * (((1 + |p 0|)⁻¹ ^ 2) ^ 2 * (((1 + ‖spatialProj p‖ ^ 2) ^ (n + 1))⁻¹) ^ 2) := by ring

lemma dirichletPosKernel_memLp (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) : MemLp (dirichletPosKernel n ħ m f) 2 volume := by
  rw [memLp_two_iff_integrable_sq_norm (dirichletPosKernel_contDiff n ħ hm f).continuous.aestronglyMeasurable]
  exact dirichletPosKernel_integrable_norm_sq n ħ hm f

/-! ### Part 4: Exact Nelson–Markov Orthogonal Covariance Identity -/

/-- Exact 1D `p₀`-integral of `‖dirichletPosKernel f (p₀, k)‖²` for fixed spatial momentum `k`:
`∫ p₀, ‖K₊ f (p₀, k)‖² = ħ * Re ∫_{t>0} ∫_{s>0} (expKernel1D ω (t-s) - expKernel1D ω (t+s)) * f̂_x(t,k)* f̂_x(s,k)`. -/
lemma dirichlet_p0_integral_eq (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) (k : SpatialE n) :
    (∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m f (euclidCons p₀ k)‖ ^ 2) =
      ħ * (∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
        ((expKernel1D (euclidDispersion m k) (t - s) -
          expKernel1D (euclidDispersion m k) (t + s) : ℝ) : ℂ) *
        (star (spatialPhysicsFourier f t k) * spatialPhysicsFourier f s k)).re := by
  set ω : ℝ := euclidDispersion m k
  have hω : 0 < ω := euclidDispersion_pos hm k
  have hsf_int : Integrable (fun t : ℝ => ‖spatialPhysicsFourier f t k‖) volume :=
    integrable_norm_spatialPhysicsFourier f k
  have hlor_int : Integrable (fun p₀ : ℝ => (p₀ ^ 2 + ω ^ 2)⁻¹) volume := by
    have h1 : Integrable (fun u : ℝ => (1 + u ^ 2)⁻¹) volume := integrable_inv_one_add_sq
    have hsc : Integrable (fun p₀ : ℝ => (1 + (ω⁻¹ * p₀) ^ 2)⁻¹) volume :=
      h1.comp_mul_left' (inv_ne_zero hω.ne')
    have heq : (fun p₀ : ℝ => (p₀ ^ 2 + ω ^ 2)⁻¹) =
        fun p₀ : ℝ => (ω ^ 2)⁻¹ * (1 + (ω⁻¹ * p₀) ^ 2)⁻¹ := by
      funext p₀; field_simp [hω.ne']; ring
    rw [heq]; exact hsc.const_mul _
  -- Rewrite integrand pointwise as `(ħ / (π (p₀² + ω²))) * Re (∫_{t>0} ∫_{s>0} sin(p₀ t) sin(p₀ s) f̂*(t) f̂(s))`
  let F : ℝ × (ℝ × ℝ) → ℂ := fun q =>
    ((Real.pi⁻¹ * (Real.sin (q.1 * q.2.1) * Real.sin (q.1 * q.2.2) / (q.1 ^ 2 + ω ^ 2)) : ℝ) : ℂ) *
      (star (spatialPhysicsFourier f q.2.1 k) * spatialPhysicsFourier f q.2.2 k)
  have hF_cont : Continuous F := by
    refine (Complex.continuous_ofReal.comp ?_).mul ?_
    · refine continuous_const.mul
        (((Real.continuous_sin.comp (continuous_fst.mul (continuous_fst.comp continuous_snd))).mul
          (Real.continuous_sin.comp (continuous_fst.mul (continuous_snd.comp continuous_snd)))).div
          ((continuous_fst.pow 2).add continuous_const)
          fun q => (by positivity : (0 : ℝ) < q.1 ^ 2 + ω ^ 2).ne')
    · exact (continuous_star.comp ((continuous_spatialPhysicsFourier f k).comp (continuous_fst.comp continuous_snd))).mul
        ((continuous_spatialPhysicsFourier f k).comp (continuous_snd.comp continuous_snd))
  have hF_int : Integrable F (volume.prod ((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ))))) := by
    have hdom : Integrable (fun q : ℝ × (ℝ × ℝ) =>
        (Real.pi⁻¹ * (q.1 ^ 2 + ω ^ 2)⁻¹) *
          (‖spatialPhysicsFourier f q.2.1 k‖ * ‖spatialPhysicsFourier f q.2.2 k‖))
        (volume.prod ((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ))))) :=
      (hlor_int.const_mul Real.pi⁻¹).mul_prod (hsf_int.integrableOn.mul_prod hsf_int.integrableOn)
    refine hdom.mono' hF_cont.aestronglyMeasurable ?_
    filter_upwards with q
    have hpos : 0 < q.1 ^ 2 + ω ^ 2 := by positivity
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_mul, norm_star, abs_mul,
      abs_of_pos (inv_pos.mpr Real.pi_pos), abs_div, abs_mul, abs_of_pos hpos, div_eq_mul_inv]
    gcongr
    calc |Real.sin (q.1 * q.2.1)| * |Real.sin (q.1 * q.2.2)| * (q.1 ^ 2 + ω ^ 2)⁻¹
        ≤ 1 * 1 * (q.1 ^ 2 + ω ^ 2)⁻¹ := by
          gcongr
          · exact Real.abs_sin_le_one _
          · exact Real.abs_sin_le_one _
      _ = (q.1 ^ 2 + ω ^ 2)⁻¹ := by ring
  -- Pointwise norm-squared identity in `ℂ` for each `p₀`
  have hpt_C (p₀ : ℝ) :
      ((‖dirichletPosKernel n ħ m f (euclidCons p₀ k)‖ ^ 2 : ℝ) : ℂ) =
        (ħ : ℂ) * ∫ ts : ℝ × ℝ, F (p₀, ts)
          ∂((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ)))) := by
    unfold dirichletPosKernel dirichletWeight
    have hpos : 0 < m ^ 2 + ‖euclidCons p₀ k‖ ^ 2 := by positivity
    have hdisp : m ^ 2 + ‖euclidCons p₀ k‖ ^ 2 = p₀ ^ 2 + ω ^ 2 := by
      rw [euclidCons_norm_sq, euclidDispersion_sq]; ring
    rw [euclidCons_zero, spatialProj_euclidCons, norm_mul, mul_pow, Complex.norm_real,
      Real.norm_eq_abs, sq_abs, mul_pow, Real.sq_sqrt (div_nonneg hħ Real.pi_pos.le),
      ← Real.rpow_natCast ((m ^ 2 + ‖euclidCons p₀ k‖ ^ 2) ^ (-1 / 2 : ℝ)) 2,
      ← Real.rpow_mul hpos.le, show (-1 / 2 : ℝ) * (2 : ℕ) = -1 by norm_num,
      Real.rpow_neg_one, hdisp]
    have hsqC : ((‖∫ t in Ioi (0 : ℝ), (Real.sin (p₀ * t) : ℂ) * spatialPhysicsFourier f t k‖ ^ 2 : ℝ) : ℂ) =
        star (∫ t in Ioi (0 : ℝ), (Real.sin (p₀ * t) : ℂ) * spatialPhysicsFourier f t k) *
          (∫ s in Ioi (0 : ℝ), (Real.sin (p₀ * s) : ℂ) * spatialPhysicsFourier f s k) := by
      rw [RCLike.star_def, mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
    rw [Complex.ofReal_mul, hsqC]
    have hconj : star (∫ t in Ioi (0 : ℝ), (Real.sin (p₀ * t) : ℂ) * spatialPhysicsFourier f t k) =
        ∫ t in Ioi (0 : ℝ), (Real.sin (p₀ * t) : ℂ) * star (spatialPhysicsFourier f t k) := by
      rw [RCLike.star_def, ← integral_conj]
      refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
      rw [map_mul, Complex.conj_ofReal]
    rw [hconj]
    have hint_ts : Integrable (fun ts : ℝ × ℝ => F (p₀, ts))
        ((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ)))) := by
      have hdom : Integrable (fun ts : ℝ × ℝ =>
          (Real.pi⁻¹ * (p₀ ^ 2 + ω ^ 2)⁻¹) *
            (‖spatialPhysicsFourier f ts.1 k‖ * ‖spatialPhysicsFourier f ts.2 k‖))
          ((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ)))) :=
        (hsf_int.integrableOn.mul_prod hsf_int.integrableOn).const_mul _
      refine hdom.mono' (hF_cont.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable ?_
      filter_upwards with ts
      have hpos' : 0 < p₀ ^ 2 + ω ^ 2 := by positivity
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_mul, norm_star, abs_mul,
        abs_of_pos (inv_pos.mpr Real.pi_pos), abs_div, abs_mul, abs_of_pos hpos', div_eq_mul_inv]
      gcongr
      calc |Real.sin (p₀ * ts.1)| * |Real.sin (p₀ * ts.2)| * (p₀ ^ 2 + ω ^ 2)⁻¹
          ≤ 1 * 1 * (p₀ ^ 2 + ω ^ 2)⁻¹ := by
            gcongr <;> exact Real.abs_sin_le_one _
        _ = (p₀ ^ 2 + ω ^ 2)⁻¹ := by ring
    rw [MeasureTheory.integral_prod _ hint_ts]
    have hpull : (∫ t in Ioi (0 : ℝ),
          ((Real.sin (p₀ * t) : ℂ) * star (spatialPhysicsFourier f t k)) *
            ∫ s in Ioi (0 : ℝ), (Real.sin (p₀ * s) : ℂ) * spatialPhysicsFourier f s k) =
        ∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
          ((Real.sin (p₀ * t) : ℂ) * star (spatialPhysicsFourier f t k)) *
            ((Real.sin (p₀ * s) : ℂ) * spatialPhysicsFourier f s k) := by
      refine setIntegral_congr_fun measurableSet_Ioi fun t _ => (integral_const_mul _ _).symm
    rw [show (((ħ / Real.pi * (p₀ ^ 2 + ω ^ 2)⁻¹ : ℝ) : ℂ)) *
          ((∫ t in Ioi (0 : ℝ), (Real.sin (p₀ * t) : ℂ) * star (spatialPhysicsFourier f t k)) *
            ∫ s in Ioi (0 : ℝ), (Real.sin (p₀ * s) : ℂ) * spatialPhysicsFourier f s k) =
        (ħ : ℂ) * (((Real.pi⁻¹ * (p₀ ^ 2 + ω ^ 2)⁻¹ : ℝ) : ℂ) *
          ((∫ t in Ioi (0 : ℝ), (Real.sin (p₀ * t) : ℂ) * star (spatialPhysicsFourier f t k)) *
            ∫ s in Ioi (0 : ℝ), (Real.sin (p₀ * s) : ℂ) * spatialPhysicsFourier f s k)) by
      push_cast; ring]
    congr 1
    rw [← integral_mul_const, hpull, ← integral_const_mul]
    refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
    rw [← integral_const_mul]
    refine setIntegral_congr_fun measurableSet_Ioi fun s _ => ?_
    dsimp only [F]
    push_cast
    rw [div_eq_mul_inv]
    ring
  -- Integrate `hpt_C` over `p₀ : ℝ`, swap via Fubini, apply `lorentzian_sin_sin_integral`, take `.re`!
  have hC : ((∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m f (euclidCons p₀ k)‖ ^ 2 : ℝ) : ℂ) =
      (ħ : ℂ) * ∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
        ((expKernel1D ω (t - s) - expKernel1D ω (t + s) : ℝ) : ℂ) *
        (star (spatialPhysicsFourier f t k) * spatialPhysicsFourier f s k) := by
    rw [← integral_complex_ofReal]
    simp_rw [hpt_C]
    rw [integral_const_mul]
    congr 1
    rw [MeasureTheory.integral_integral_swap hF_int]
    have hprod_eval : (∫ ts : ℝ × ℝ, (∫ p₀ : ℝ, F (p₀, ts))
          ∂((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ))))) =
        ∫ ts : ℝ × ℝ,
          ((expKernel1D ω (ts.1 - ts.2) - expKernel1D ω (ts.1 + ts.2) : ℝ) : ℂ) *
          (star (spatialPhysicsFourier f ts.1 k) * spatialPhysicsFourier f ts.2 k)
          ∂((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ)))) := by
      refine integral_congr_ae (ae_of_all _ fun ts => ?_)
      dsimp only [F]
      rw [integral_mul_const]
      congr 1
      have hre_int : (∫ p₀ : ℝ,
          ((Real.pi⁻¹ * (Real.sin (p₀ * ts.1) * Real.sin (p₀ * ts.2) / (p₀ ^ 2 + ω ^ 2)) : ℝ) : ℂ)) =
          ((Real.pi⁻¹ * ∫ p₀ : ℝ, Real.sin (p₀ * ts.1) * Real.sin (p₀ * ts.2) / (p₀ ^ 2 + ω ^ 2) : ℝ) : ℂ) := by
        rw [integral_complex_ofReal, integral_const_mul]
      rw [hre_int, lorentzian_sin_sin_integral hω ts.1 ts.2]
    rw [hprod_eval]
    have hint_rhs : Integrable (fun ts : ℝ × ℝ =>
        ((expKernel1D ω (ts.1 - ts.2) - expKernel1D ω (ts.1 + ts.2) : ℝ) : ℂ) *
        (star (spatialPhysicsFourier f ts.1 k) * spatialPhysicsFourier f ts.2 k))
        ((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ)))) := by
      have hdom : Integrable (fun ts : ℝ × ℝ =>
          (1 / ω) * (‖spatialPhysicsFourier f ts.1 k‖ * ‖spatialPhysicsFourier f ts.2 k‖))
          ((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ)))) :=
        (hsf_int.integrableOn.mul_prod hsf_int.integrableOn).const_mul (1 / ω)
      refine hdom.mono' ?_ ?_
      · exact ((Complex.continuous_ofReal.comp
          (((expKernel1D_continuous ω).comp (continuous_fst.sub continuous_snd)).sub
            ((expKernel1D_continuous ω).comp (continuous_fst.add continuous_snd)))).mul
          ((continuous_star.comp ((continuous_spatialPhysicsFourier f k).comp continuous_fst)).mul
            ((continuous_spatialPhysicsFourier f k).comp continuous_snd))).aestronglyMeasurable
      · filter_upwards with ts
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_mul, norm_star]
        gcongr
        have hb (r : ℝ) : |expKernel1D ω r| ≤ (2 * ω)⁻¹ := by
          unfold expKernel1D
          rw [abs_div, abs_of_pos (Real.exp_pos _), abs_of_pos (by positivity : 0 < 2 * ω),
            div_eq_mul_inv]
          exact mul_le_of_le_one_left (by positivity)
            (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg r]))
        calc |expKernel1D ω (ts.1 - ts.2) - expKernel1D ω (ts.1 + ts.2)|
            ≤ |expKernel1D ω (ts.1 - ts.2)| + |expKernel1D ω (ts.1 + ts.2)| := abs_sub _ _
          _ ≤ (2 * ω)⁻¹ + (2 * ω)⁻¹ := add_le_add (hb _) (hb _)
          _ = 1 / ω := by field_simp [hω.ne']; ring
    exact MeasureTheory.integral_prod _ hint_rhs
  have hre := congrArg Complex.re hC
  simpa [Complex.mul_re] using hre

/-- Exact 1D `p₀`-integral of the full continuum covariance integrand for fixed spatial momentum `k`:
`∫ p₀, ‖f̂(p₀, k)‖² / (p₀² + ω²) = Re ∫_t ∫_s expKernel1D ω (t - s) * f̂_x(t, k)* f̂_x(s, k)`. -/
lemma continuum_p0_integral_eq (n : ℕ) {m : ℝ} (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) (k : SpatialE n) :
    (∫ p₀ : ℝ, ‖physicsFourierExact f (euclidCons p₀ k)‖ ^ 2 * (p₀ ^ 2 + euclidDispersion m k ^ 2)⁻¹) =
      (∫ t : ℝ, ∫ s : ℝ,
        (expKernel1D (euclidDispersion m k) (t - s) : ℂ) *
        (star (spatialPhysicsFourier f t k) * spatialPhysicsFourier f s k)).re := by
  set ω : ℝ := euclidDispersion m k
  have hω : 0 < ω := euclidDispersion_pos hm k
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
  have hsf_int : Integrable (fun t : ℝ => ‖spatialPhysicsFourier f t k‖) volume :=
    integrable_norm_spatialPhysicsFourier f k
  have hlor_int : Integrable (fun p₀ : ℝ => (p₀ ^ 2 + ω ^ 2)⁻¹) volume := by
    have h1 : Integrable (fun u : ℝ => (1 + u ^ 2)⁻¹) volume := integrable_inv_one_add_sq
    have hsc : Integrable (fun p₀ : ℝ => (1 + (ω⁻¹ * p₀) ^ 2)⁻¹) volume :=
      h1.comp_mul_left' (inv_ne_zero hω.ne')
    have heq : (fun p₀ : ℝ => (p₀ ^ 2 + ω ^ 2)⁻¹) =
        fun p₀ : ℝ => (ω ^ 2)⁻¹ * (1 + (ω⁻¹ * p₀) ^ 2)⁻¹ := by
      funext p₀; field_simp [hω.ne']; ring
    rw [heq]; exact hsc.const_mul _
  let F : ℝ × (ℝ × ℝ) → ℂ := fun q =>
    (((2 * Real.pi)⁻¹ : ℝ) : ℂ) *
      (Complex.exp (Complex.I * (q.1 : ℂ) * ((q.2.1 - q.2.2 : ℝ) : ℂ)) / ((q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2)) *
      (star (spatialPhysicsFourier f q.2.1 k) * spatialPhysicsFourier f q.2.2 k)
  have hF_cont : Continuous F := by
    have hexp_cont : Continuous (fun q : ℝ × (ℝ × ℝ) =>
        Complex.exp (Complex.I * (q.1 : ℂ) * ((q.2.1 - q.2.2 : ℝ) : ℂ))) :=
      Complex.continuous_exp.comp
        ((continuous_const.mul (Complex.continuous_ofReal.comp continuous_fst)).mul
          (Complex.continuous_ofReal.comp ((continuous_fst.comp continuous_snd).sub
            (continuous_snd.comp continuous_snd))))
    refine (continuous_const.mul (hexp_cont.div
      ((Complex.continuous_ofReal.comp continuous_fst).pow 2 |>.add continuous_const)
      fun q => by
        have hpos : (0 : ℝ) < q.1 ^ 2 + ω ^ 2 := by positivity
        have hcast : ((q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((q.1 ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
          push_cast; ring
        change (q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2 ≠ 0
        rw [hcast]; exact Complex.ofReal_ne_zero.mpr hpos.ne')).mul
      ((continuous_star.comp ((continuous_spatialPhysicsFourier f k).comp (continuous_fst.comp continuous_snd))).mul
        ((continuous_spatialPhysicsFourier f k).comp (continuous_snd.comp continuous_snd)))
  have hF_int : Integrable F (volume.prod (volume.prod volume)) := by
    have hdom : Integrable (fun q : ℝ × (ℝ × ℝ) =>
        ((2 * Real.pi)⁻¹ * (q.1 ^ 2 + ω ^ 2)⁻¹) *
          (‖spatialPhysicsFourier f q.2.1 k‖ * ‖spatialPhysicsFourier f q.2.2 k‖))
        (volume.prod (volume.prod volume)) :=
      (hlor_int.const_mul (2 * Real.pi)⁻¹).mul_prod (hsf_int.mul_prod hsf_int)
    refine hdom.mono' hF_cont.aestronglyMeasurable ?_
    filter_upwards with q
    have hpos : (0 : ℝ) < q.1 ^ 2 + ω ^ 2 := by positivity
    have hcast : ((q.1 : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((q.1 ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
      push_cast; ring
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr h2pi_pos), norm_div, hcast, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hpos,
      show Complex.I * (q.1 : ℂ) * ((q.2.1 - q.2.2 : ℝ) : ℂ) =
        ((q.1 * (q.2.1 - q.2.2) : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.norm_exp_ofReal_mul_I, one_div, norm_mul, norm_star]
  have hpt_C (p₀ : ℝ) :
      ((‖physicsFourierExact f (euclidCons p₀ k)‖ ^ 2 * (p₀ ^ 2 + ω ^ 2)⁻¹ : ℝ) : ℂ) =
        ∫ ts : ℝ × ℝ, F (p₀, ts) ∂(volume.prod volume) := by
    rw [physicsFourierExact_eq_timeIntegral]
    simp only [euclidCons_zero, spatialProj_euclidCons]
    rw [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (Real.rpow_pos_of_pos h2pi_pos _),
      ← Real.rpow_natCast ((2 * Real.pi) ^ (-(1 : ℝ) / 2)) 2,
      ← Real.rpow_mul h2pi_pos.le, show (-(1 : ℝ) / 2) * (2 : ℕ) = -1 by norm_num,
      Real.rpow_neg_one]
    have hsqC : ((‖∫ t : ℝ, Complex.exp (-Complex.I * (t * p₀ : ℝ)) * spatialPhysicsFourier f t k‖ ^ 2 : ℝ) : ℂ) =
        star (∫ t : ℝ, Complex.exp (-Complex.I * (t * p₀ : ℝ)) * spatialPhysicsFourier f t k) *
          (∫ s : ℝ, Complex.exp (-Complex.I * (s * p₀ : ℝ)) * spatialPhysicsFourier f s k) := by
      rw [RCLike.star_def, mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
    rw [Complex.ofReal_mul, Complex.ofReal_mul, hsqC]
    have hconj : star (∫ t : ℝ, Complex.exp (-Complex.I * (t * p₀ : ℝ)) * spatialPhysicsFourier f t k) =
        ∫ t : ℝ, Complex.exp (Complex.I * (t * p₀ : ℝ)) * star (spatialPhysicsFourier f t k) := by
      rw [RCLike.star_def, ← integral_conj]
      refine integral_congr_ae (ae_of_all _ fun t => ?_)
      dsimp only
      rw [map_mul, ← Complex.exp_conj]
      congr 2; simp
    rw [hconj]
    have hint_ts : Integrable (fun ts : ℝ × ℝ => F (p₀, ts)) (volume.prod volume) := by
      have hdom : Integrable (fun ts : ℝ × ℝ =>
          ((2 * Real.pi)⁻¹ * (p₀ ^ 2 + ω ^ 2)⁻¹) *
            (‖spatialPhysicsFourier f ts.1 k‖ * ‖spatialPhysicsFourier f ts.2 k‖))
          (volume.prod volume) :=
        (hsf_int.mul_prod hsf_int).const_mul _
      refine hdom.mono' (hF_cont.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable ?_
      filter_upwards with ts
      have hpos : (0 : ℝ) < p₀ ^ 2 + ω ^ 2 := by positivity
      have hcast : ((p₀ : ℂ) ^ 2 + (ω : ℂ) ^ 2) = ((p₀ ^ 2 + ω ^ 2 : ℝ) : ℂ) := by
        push_cast; ring
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr h2pi_pos), norm_div, hcast, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hpos,
        show Complex.I * (p₀ : ℂ) * ((ts.1 - ts.2 : ℝ) : ℂ) =
          ((p₀ * (ts.1 - ts.2) : ℝ) : ℂ) * Complex.I by push_cast; ring,
        Complex.norm_exp_ofReal_mul_I, one_div, norm_mul, norm_star]
    rw [MeasureTheory.integral_prod _ hint_ts]
    have hpull : (∫ t : ℝ,
          (Complex.exp (Complex.I * (t * p₀ : ℝ)) * star (spatialPhysicsFourier f t k)) *
            ∫ s : ℝ, Complex.exp (-Complex.I * (s * p₀ : ℝ)) * spatialPhysicsFourier f s k) =
        ∫ t : ℝ, ∫ s : ℝ,
          (Complex.exp (Complex.I * (t * p₀ : ℝ)) * star (spatialPhysicsFourier f t k)) *
            (Complex.exp (-Complex.I * (s * p₀ : ℝ)) * spatialPhysicsFourier f s k) := by
      refine integral_congr_ae (ae_of_all _ fun t => (integral_const_mul _ _).symm)
    rw [mul_right_comm, ← integral_mul_const, hpull, ← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun t => ?_)
    dsimp only
    rw [← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun s => ?_)
    dsimp only [F]
    have hexp : Complex.exp (Complex.I * (p₀ : ℂ) * ((t - s : ℝ) : ℂ)) =
        Complex.exp (Complex.I * (t * p₀ : ℝ)) * Complex.exp (-Complex.I * (s * p₀ : ℝ)) := by
      rw [← Complex.exp_add]; congr 1; push_cast; ring
    rw [hexp, div_eq_mul_inv]
    push_cast; ring
  have hC : ((∫ p₀ : ℝ, ‖physicsFourierExact f (euclidCons p₀ k)‖ ^ 2 * (p₀ ^ 2 + ω ^ 2)⁻¹ : ℝ) : ℂ) =
      ∫ t : ℝ, ∫ s : ℝ,
        (expKernel1D ω (t - s) : ℂ) *
        (star (spatialPhysicsFourier f t k) * spatialPhysicsFourier f s k) := by
    rw [← integral_complex_ofReal]
    simp_rw [hpt_C]
    rw [MeasureTheory.integral_integral_swap hF_int]
    have hprod_eval : (∫ ts : ℝ × ℝ, (∫ p₀ : ℝ, F (p₀, ts)) ∂(volume.prod volume)) =
        ∫ ts : ℝ × ℝ,
          (expKernel1D ω (ts.1 - ts.2) : ℂ) *
          (star (spatialPhysicsFourier f ts.1 k) * spatialPhysicsFourier f ts.2 k)
          ∂(volume.prod volume) := by
      refine integral_congr_ae (ae_of_all _ fun ts => ?_)
      dsimp only [F]
      rw [integral_mul_const, integral_const_mul, Complex.ofReal_inv]
      congr 1
      exact lorentzian_fourier_eq_expKernel1D hω (ts.1 - ts.2)
    rw [hprod_eval]
    have hint_rhs : Integrable (fun ts : ℝ × ℝ =>
        (expKernel1D ω (ts.1 - ts.2) : ℂ) *
        (star (spatialPhysicsFourier f ts.1 k) * spatialPhysicsFourier f ts.2 k))
        (volume.prod volume) := by
      have hdom : Integrable (fun ts : ℝ × ℝ =>
          (2 * ω)⁻¹ * (‖spatialPhysicsFourier f ts.1 k‖ * ‖spatialPhysicsFourier f ts.2 k‖))
          (volume.prod volume) :=
        (hsf_int.mul_prod hsf_int).const_mul (2 * ω)⁻¹
      refine hdom.mono' ?_ ?_
      · exact ((Complex.continuous_ofReal.comp
          ((expKernel1D_continuous ω).comp (continuous_fst.sub continuous_snd))).mul
          ((continuous_star.comp ((continuous_spatialPhysicsFourier f k).comp continuous_fst)).mul
            ((continuous_spatialPhysicsFourier f k).comp continuous_snd))).aestronglyMeasurable
      · filter_upwards with ts
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_mul, norm_star]
        gcongr
        unfold expKernel1D
        rw [abs_div, abs_of_pos (Real.exp_pos _), abs_of_pos (by positivity : 0 < 2 * ω),
          div_eq_mul_inv]
        exact mul_le_of_le_one_left (by positivity)
          (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg (ts.1 - ts.2)]))
    exact MeasureTheory.integral_prod _ hint_rhs
  have hre := congrArg Complex.re hC
  simpa using hre

/-- Exact 1D algebraic Nelson–Markov covariance identity at every fixed spatial momentum `k`. -/
lemma nelson_markov_fixed_k (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) (k : SpatialE n) :
    ‖planeKernel n ħ m (poissonProj n m hm f) k‖ ^ 2 +
      (∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m f (euclidCons p₀ k)‖ ^ 2) +
      (∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m (reflectSchwartz f) (euclidCons p₀ k)‖ ^ 2) =
      ħ * ∫ p₀ : ℝ, ‖physicsFourierExact f (euclidCons p₀ k)‖ ^ 2 *
        (p₀ ^ 2 + euclidDispersion m k ^ 2)⁻¹ := by
  set ω : ℝ := euclidDispersion m k
  have hω : 0 < ω := euclidDispersion_pos hm k
  have hsf_int : Integrable (fun t : ℝ => ‖spatialPhysicsFourier f t k‖) volume :=
    integrable_norm_spatialPhysicsFourier f k
  let Q : ℝ × ℝ → ℂ := fun ts =>
    star (spatialPhysicsFourier f ts.1 k) * spatialPhysicsFourier f ts.2 k
  have hQ_int : Integrable (fun ts : ℝ × ℝ => ‖Q ts‖) (volume.prod volume) := by
    have heq : (fun ts : ℝ × ℝ => ‖Q ts‖) =
        fun ts => ‖spatialPhysicsFourier f ts.1 k‖ * ‖spatialPhysicsFourier f ts.2 k‖ := by
      funext ts; simp [Q]
    rw [heq]; exact hsf_int.mul_prod hsf_int
  have hK_int (K : ℝ × ℝ → ℝ) (hK_meas : AEStronglyMeasurable K (volume.prod volume))
      (B : ℝ) (hK_bd : ∀ ts, |K ts| ≤ B) :
      Integrable (fun ts : ℝ × ℝ => (K ts : ℂ) * Q ts) (volume.prod volume) := by
    refine (hQ_int.const_mul (max B 0)).mono'
      ((Complex.continuous_ofReal.comp_aestronglyMeasurable hK_meas).mul
        ((continuous_star.comp ((continuous_spatialPhysicsFourier f k).comp continuous_fst)).mul
          ((continuous_spatialPhysicsFourier f k).comp continuous_snd)).aestronglyMeasurable) ?_
    filter_upwards with ts
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right ((hK_bd ts).trans (le_max_left _ _)) (norm_nonneg _)
  have hexp_bd (r : ℝ) : |expKernel1D ω r| ≤ (2 * ω)⁻¹ := by
    unfold expKernel1D
    rw [abs_div, abs_of_pos (Real.exp_pos _), abs_of_pos (by positivity : 0 < 2 * ω), div_eq_mul_inv]
    exact mul_le_of_le_one_left (by positivity)
      (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg r]))
  -- Term 1: Plane term
  have hT1 : ‖planeKernel n ħ m (poissonProj n m hm f) k‖ ^ 2 =
      ħ * (∫ ts : ℝ × ℝ, (expKernel1D ω (|ts.1| + |ts.2|) : ℂ) * Q ts ∂(volume.prod volume)).re := by
    rw [planeKernel_poissonProj n ħ hm f k, norm_mul, mul_pow, Complex.norm_real,
      Real.norm_eq_abs, sq_abs, div_pow, Real.sq_sqrt hħ,
      Real.sq_sqrt (by positivity : (0 : ℝ) ≤ 2 * ω)]
    have hC1 : (((2 * ω)⁻¹ * ‖∫ t : ℝ, (Real.exp (-|t| * ω) : ℂ) * spatialPhysicsFourier f t k‖ ^ 2 : ℝ) : ℂ) =
        ∫ ts : ℝ × ℝ, (expKernel1D ω (|ts.1| + |ts.2|) : ℂ) * Q ts ∂(volume.prod volume) := by
      have hsqC : ((‖∫ t : ℝ, (Real.exp (-|t| * ω) : ℂ) * spatialPhysicsFourier f t k‖ ^ 2 : ℝ) : ℂ) =
          star (∫ t : ℝ, (Real.exp (-|t| * ω) : ℂ) * spatialPhysicsFourier f t k) *
            (∫ s : ℝ, (Real.exp (-|s| * ω) : ℂ) * spatialPhysicsFourier f s k) := by
        rw [RCLike.star_def, mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
      rw [Complex.ofReal_mul, hsqC]
      have hconj : star (∫ t : ℝ, (Real.exp (-|t| * ω) : ℂ) * spatialPhysicsFourier f t k) =
          ∫ t : ℝ, (Real.exp (-|t| * ω) : ℂ) * star (spatialPhysicsFourier f t k) := by
        rw [RCLike.star_def, ← integral_conj]
        refine integral_congr_ae (ae_of_all _ fun t => ?_)
        dsimp only; rw [map_mul, Complex.conj_ofReal]
      rw [hconj]
      have hint1 : Integrable (fun ts : ℝ × ℝ => (expKernel1D ω (|ts.1| + |ts.2|) : ℂ) * Q ts)
          (volume.prod volume) :=
        hK_int _ ((expKernel1D_continuous ω).comp (continuous_abs.comp continuous_fst |>.add
          (continuous_abs.comp continuous_snd))).aestronglyMeasurable (2 * ω)⁻¹ (fun ts => hexp_bd _)
      rw [MeasureTheory.integral_prod _ hint1]
      rw [← integral_mul_const]
      have hpull : (∫ t : ℝ,
            ((Real.exp (-|t| * ω) : ℂ) * star (spatialPhysicsFourier f t k)) *
              ∫ s : ℝ, (Real.exp (-|s| * ω) : ℂ) * spatialPhysicsFourier f s k) =
          ∫ t : ℝ, ∫ s : ℝ,
            ((Real.exp (-|t| * ω) : ℂ) * star (spatialPhysicsFourier f t k)) *
              ((Real.exp (-|s| * ω) : ℂ) * spatialPhysicsFourier f s k) :=
        integral_congr_ae (ae_of_all _ fun t => (integral_const_mul _ _).symm)
      rw [hpull, ← integral_const_mul]
      refine integral_congr_ae (ae_of_all _ fun t => ?_)
      dsimp only
      rw [← integral_const_mul]
      refine integral_congr_ae (ae_of_all _ fun s => ?_)
      dsimp only [Q]
      unfold expKernel1D
      rw [abs_of_nonneg (add_nonneg (abs_nonneg t) (abs_nonneg s)),
        show -ω * (|t| + |s|) = -|t| * ω + -|s| * ω by ring, Real.exp_add]
      push_cast; ring
    have hre1 := congrArg Complex.re hC1
    simp only [Complex.ofReal_re] at hre1
    rw [div_eq_mul_inv, mul_assoc, hre1]
  -- Term 2: Positive Dirichlet term as an indicator integral on `ℝ × ℝ`
  let Spos : Set (ℝ × ℝ) := Ioi (0 : ℝ) ×ˢ Ioi (0 : ℝ)
  let Sneg : Set (ℝ × ℝ) := Iic (0 : ℝ) ×ˢ Iic (0 : ℝ)
  have hSpos_meas : MeasurableSet Spos := measurableSet_Ioi.prod measurableSet_Ioi
  have hSneg_meas : MeasurableSet Sneg := measurableSet_Iic.prod measurableSet_Iic
  let Dker : ℝ × ℝ → ℝ := fun ts => expKernel1D ω (ts.1 - ts.2) - expKernel1D ω (|ts.1| + |ts.2|)
  have hDker_cont : Continuous Dker :=
    ((expKernel1D_continuous ω).comp (continuous_fst.sub continuous_snd)).sub
      ((expKernel1D_continuous ω).comp ((continuous_abs.comp continuous_fst).add
        (continuous_abs.comp continuous_snd)))
  have hDker_bd : ∀ ts, |Dker ts| ≤ (2 * ω)⁻¹ + (2 * ω)⁻¹ := fun ts =>
    (abs_sub _ _).trans (add_le_add (hexp_bd _) (hexp_bd _))
  have hT2 : (∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m f (euclidCons p₀ k)‖ ^ 2) =
      ħ * (∫ ts : ℝ × ℝ, Spos.indicator (fun ts => (Dker ts : ℂ) * Q ts) ts ∂(volume.prod volume)).re := by
    rw [dirichlet_p0_integral_eq n hħ hm f k]
    congr 1; congr 1
    have hint_pos : Integrable (fun ts : ℝ × ℝ => Spos.indicator (fun ts => (Dker ts : ℂ) * Q ts) ts)
        (volume.prod volume) := by
      have h1 := hK_int Dker hDker_cont.aestronglyMeasurable _ hDker_bd
      exact h1.indicator hSpos_meas
    rw [MeasureTheory.integral_prod _ hint_pos, ← MeasureTheory.integral_indicator measurableSet_Ioi]
    refine integral_congr_ae (ae_of_all _ fun t => ?_)
    dsimp only
    by_cases ht : 0 < t
    · rw [Set.indicator_of_mem (show t ∈ Ioi (0 : ℝ) from ht),
        ← MeasureTheory.integral_indicator measurableSet_Ioi]
      refine integral_congr_ae (ae_of_all _ fun s => ?_)
      dsimp only
      by_cases hs : 0 < s
      · rw [Set.indicator_of_mem (show s ∈ Ioi (0 : ℝ) from hs),
          Set.indicator_of_mem (show (t, s) ∈ Spos from ⟨ht, hs⟩)]
        dsimp only [Dker, Q]
        rw [abs_of_pos ht, abs_of_pos hs]
      · rw [Set.indicator_of_notMem (show s ∉ Ioi (0 : ℝ) from hs),
          Set.indicator_of_notMem (show (t, s) ∉ Spos from fun h => hs h.2)]
    · rw [Set.indicator_of_notMem (show t ∉ Ioi (0 : ℝ) from ht)]
      symm
      refine integral_eq_zero_of_ae (ae_of_all _ fun s => ?_)
      exact Set.indicator_of_notMem (show (t, s) ∉ Spos from fun h => ht h.1) _
  -- Term 3: Reflected Dirichlet term as `Sneg` indicator integral on `ℝ × ℝ`
  have hT3 : (∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m (reflectSchwartz f) (euclidCons p₀ k)‖ ^ 2) =
      ħ * (∫ ts : ℝ × ℝ, Sneg.indicator (fun ts => (Dker ts : ℂ) * Q ts) ts ∂(volume.prod volume)).re := by
    rw [dirichlet_p0_integral_eq n hħ hm (reflectSchwartz f) k]
    congr 1; congr 1
    -- Substitute `t ↦ -t`, `s ↦ -s` using `integral_neg_eq_self`!
    have hint_neg : Integrable (fun ts : ℝ × ℝ => Sneg.indicator (fun ts => (Dker ts : ℂ) * Q ts) ts)
        (volume.prod volume) := by
      have h1 := hK_int Dker hDker_cont.aestronglyMeasurable _ hDker_bd
      exact h1.indicator hSneg_meas
    rw [MeasureTheory.integral_prod _ hint_neg]
    have hIio_eq_Iic : ∀ g : ℝ → ℂ, (∫ u in Iio (0 : ℝ), g u) = ∫ u in Iic (0 : ℝ), g u := fun g =>
      MeasureTheory.setIntegral_congr_set MeasureTheory.Iio_ae_eq_Iic
    have hneg_Ioi : ∀ g : ℝ → ℂ, (∫ u in Ioi (0 : ℝ), g (-u)) = ∫ u in Iic (0 : ℝ), g u := by
      intro g
      rw [← hIio_eq_Iic, ← MeasureTheory.integral_indicator measurableSet_Ioi,
        ← MeasureTheory.integral_indicator measurableSet_Iio]
      have h := MeasureTheory.integral_neg_eq_self (fun u : ℝ => (Iio (0 : ℝ)).indicator g u) volume
      rw [← h]
      refine integral_congr_ae (ae_of_all _ fun u => ?_)
      dsimp only
      by_cases hu : 0 < u
      · rw [Set.indicator_of_mem (show u ∈ Ioi (0 : ℝ) from hu),
          Set.indicator_of_mem (show -u ∈ Iio (0 : ℝ) from neg_lt_zero.mpr hu)]
      · rw [Set.indicator_of_notMem (show u ∉ Ioi (0 : ℝ) from hu),
          Set.indicator_of_notMem (show -u ∉ Iio (0 : ℝ) from by
            simp only [mem_Iio, neg_lt_zero]; exact hu)]
    have hstep1 : (∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
        ((expKernel1D ω (t - s) - expKernel1D ω (t + s) : ℝ) : ℂ) *
          (star (spatialPhysicsFourier (reflectSchwartz f) t k) *
            spatialPhysicsFourier (reflectSchwartz f) s k)) =
        ∫ t in Iic (0 : ℝ), ∫ s in Iic (0 : ℝ), (Dker (t, s) : ℂ) * Q (t, s) := by
      have h1 : (∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
            ((expKernel1D ω (t - s) - expKernel1D ω (t + s) : ℝ) : ℂ) *
              (star (spatialPhysicsFourier (reflectSchwartz f) t k) *
                spatialPhysicsFourier (reflectSchwartz f) s k)) =
          ∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ), (Dker (-t, -s) : ℂ) * Q (-t, -s) := by
        refine setIntegral_congr_fun measurableSet_Ioi fun t ht => ?_
        refine setIntegral_congr_fun measurableSet_Ioi fun s hs => ?_
        have ht0 : 0 < t := ht
        have hs0 : 0 < s := hs
        rw [spatialPhysicsFourier_reflect, spatialPhysicsFourier_reflect]
        dsimp only [Dker, Q]
        congr 1; congr 1
        have ha : expKernel1D ω (t - s) = expKernel1D ω (-t - -s) := by
          unfold expKernel1D
          rw [show -t - -s = -(t - s) by ring, abs_neg]
        have hb : expKernel1D ω (t + s) = expKernel1D ω (|-t| + |-s|) := by
          rw [abs_neg, abs_neg, abs_of_pos ht0, abs_of_pos hs0]
        rw [ha, hb]
      rw [h1]
      have h2 : (fun t : ℝ => ∫ s in Ioi (0 : ℝ), (Dker (-t, -s) : ℂ) * Q (-t, -s)) =
          fun t : ℝ => (fun t' : ℝ => ∫ s' in Iic (0 : ℝ), (Dker (t', s') : ℂ) * Q (t', s')) (-t) := by
        funext t
        exact hneg_Ioi (fun s' : ℝ => (Dker (-t, s') : ℂ) * Q (-t, s'))
      rw [h2]
      exact hneg_Ioi (fun t' : ℝ => ∫ s' in Iic (0 : ℝ), (Dker (t', s') : ℂ) * Q (t', s'))
    rw [hstep1, ← MeasureTheory.integral_indicator measurableSet_Iic]
    refine integral_congr_ae (ae_of_all _ fun t => ?_)
    dsimp only
    by_cases ht : t ≤ 0
    · rw [Set.indicator_of_mem (show t ∈ Iic (0 : ℝ) from ht),
        ← MeasureTheory.integral_indicator measurableSet_Iic]
      refine integral_congr_ae (ae_of_all _ fun s => ?_)
      dsimp only
      by_cases hs : s ≤ 0
      · rw [Set.indicator_of_mem (show s ∈ Iic (0 : ℝ) from hs),
          Set.indicator_of_mem (show (t, s) ∈ Sneg from ⟨ht, hs⟩)]
      · rw [Set.indicator_of_notMem (show s ∉ Iic (0 : ℝ) from hs),
          Set.indicator_of_notMem (show (t, s) ∉ Sneg from fun h => hs h.2)]
    · rw [Set.indicator_of_notMem (show t ∉ Iic (0 : ℝ) from ht)]
      symm
      refine integral_eq_zero_of_ae (ae_of_all _ fun s => ?_)
      exact Set.indicator_of_notMem (show (t, s) ∉ Sneg from fun h => ht h.1) _
  -- Combine all 3 terms using the exact pointwise quadrant identity on `ℝ × ℝ`!
  rw [hT1, hT2, hT3, continuum_p0_integral_eq n hm f k]
  have hint1 : Integrable (fun ts : ℝ × ℝ => (expKernel1D ω (|ts.1| + |ts.2|) : ℂ) * Q ts)
      (volume.prod volume) :=
    hK_int _ ((expKernel1D_continuous ω).comp ((continuous_abs.comp continuous_fst).add
      (continuous_abs.comp continuous_snd))).aestronglyMeasurable (2 * ω)⁻¹ (fun ts => hexp_bd _)
  have hint2 : Integrable (fun ts : ℝ × ℝ => Spos.indicator (fun ts => (Dker ts : ℂ) * Q ts) ts)
      (volume.prod volume) :=
    (hK_int Dker hDker_cont.aestronglyMeasurable _ hDker_bd).indicator hSpos_meas
  have hint3 : Integrable (fun ts : ℝ × ℝ => Sneg.indicator (fun ts => (Dker ts : ℂ) * Q ts) ts)
      (volume.prod volume) :=
    (hK_int Dker hDker_cont.aestronglyMeasurable _ hDker_bd).indicator hSneg_meas
  have hint_full : Integrable (fun ts : ℝ × ℝ => (expKernel1D ω (ts.1 - ts.2) : ℂ) * Q ts)
      (volume.prod volume) :=
    hK_int _ ((expKernel1D_continuous ω).comp (continuous_fst.sub continuous_snd)).aestronglyMeasurable
      (2 * ω)⁻¹ (fun ts => hexp_bd _)
  have hint12 : Integrable (fun a : ℝ × ℝ =>
      (expKernel1D ω (|a.1| + |a.2|) : ℂ) * Q a + Spos.indicator (fun ts => (Dker ts : ℂ) * Q ts) a)
      (volume.prod volume) := hint1.add hint2
  rw [← mul_add, ← mul_add]
  congr 1
  rw [← Complex.add_re, ← Complex.add_re, ← integral_add hint1 hint2,
    ← integral_add hint12 hint3, ← MeasureTheory.integral_prod _ hint_full]
  congr 1
  refine integral_congr_ae (ae_of_all _ fun ts => ?_)
  dsimp only [Dker]
  rcases lt_or_ge 0 ts.1 with ht | ht <;> rcases lt_or_ge 0 ts.2 with hs | hs
  · rw [Set.indicator_of_mem (show ts ∈ Spos from ⟨ht, hs⟩),
      Set.indicator_of_notMem (show ts ∉ Sneg from fun h => not_lt_of_ge h.1 ht)]
    push_cast; ring
  · rw [Set.indicator_of_notMem (show ts ∉ Spos from fun h => not_lt_of_ge hs h.2),
      Set.indicator_of_notMem (show ts ∉ Sneg from fun h => not_lt_of_ge h.1 ht),
      add_zero, add_zero]
    congr 1; congr 1
    unfold expKernel1D
    rw [abs_of_pos ht, abs_of_nonpos hs, abs_of_pos (by linarith : 0 < ts.1 - ts.2),
      abs_of_nonneg (by linarith : 0 ≤ ts.1 + -ts.2)]
    rfl
  · rw [Set.indicator_of_notMem (show ts ∉ Spos from fun h => not_lt_of_ge ht h.1),
      Set.indicator_of_notMem (show ts ∉ Sneg from fun h => not_lt_of_ge h.2 hs),
      add_zero, add_zero]
    congr 1; congr 1
    unfold expKernel1D
    rw [abs_of_nonpos ht, abs_of_pos hs, abs_of_neg (by linarith : ts.1 - ts.2 < 0),
      abs_of_nonneg (by linarith : 0 ≤ -ts.1 + ts.2)]
    congr 2; ring
  · rw [Set.indicator_of_notMem (show ts ∉ Spos from fun h => not_lt_of_ge ht h.1),
      Set.indicator_of_mem (show ts ∈ Sneg from ⟨ht, hs⟩), add_zero]
    push_cast; ring

/-- **Deliverable 4 (Exact Nelson–Markov Orthogonal Covariance Identity):**
For EVERY `f : 𝓢(EuclidD n, ℝ)`, `ħ ≥ 0`, `m > 0`:
`∫ ‖K₀ (P₀ f)‖² + ∫ ‖K₊ f‖² + ∫ ‖K₊ (Θ f)‖² = continuumCovReal n ħ m f`. -/
theorem nelson_markov_covariance_split (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) :
    (∫ k : SpatialE n, ‖planeKernel n ħ m (poissonProj n m hm f) k‖ ^ 2) +
      (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m f p‖ ^ 2) +
      (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m (reflectSchwartz f) p‖ ^ 2) =
    continuumCovReal n ħ m f := by
  have hint_pos : Integrable (fun q : ℝ × SpatialE n =>
      ‖dirichletPosKernel n ħ m f (euclidCons q.1 q.2)‖ ^ 2) volume :=
    (measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable
      (dirichletPosKernel_integrable_norm_sq n ħ hm f)
  have hint_neg : Integrable (fun q : ℝ × SpatialE n =>
      ‖dirichletPosKernel n ħ m (reflectSchwartz f) (euclidCons q.1 q.2)‖ ^ 2) volume :=
    (measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable
      (dirichletPosKernel_integrable_norm_sq n ħ hm (reflectSchwartz f))
  have hint_full_E : Integrable (fun p : EuclidD n =>
      ‖physicsFourierExact f p‖ ^ 2 * (‖p‖ ^ 2 + m ^ 2)⁻¹) volume := by
    have hL2 : Integrable (fun p : EuclidD n => ‖physicsFourierExact f p‖ ^ 2) volume := by
      have heq : (fun p : EuclidD n => ‖physicsFourierExact f p‖ ^ 2) =
          fun p => ‖physicsFourierCLM (n + 2) f p‖ ^ 2 := by
        funext p; simp
      rw [heq]; exact ((physicsFourierCLM (n + 2) f).memLp 2 volume).norm.integrable_sq
    refine (hL2.const_mul (m ^ 2)⁻¹).mono' ?_ ?_
    · have hcont : Continuous (fun p : EuclidD n =>
          ‖physicsFourierExact f p‖ ^ 2 * (‖p‖ ^ 2 + m ^ 2)⁻¹) := by
        have heq : physicsFourierExact f = ⇑(physicsFourierCLM (n + 2) f) := by
          funext p; simp
        rw [heq]
        exact ((physicsFourierCLM (n + 2) f).continuous.norm.pow 2).mul
          (((continuous_norm.pow 2).add continuous_const).inv₀
            fun p => (by positivity : (0 : ℝ) < ‖p‖ ^ 2 + m ^ 2).ne')
      exact hcont.aestronglyMeasurable
    · filter_upwards with p
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), mul_comm ((m ^ 2)⁻¹)]
      exact mul_le_mul_of_nonneg_left
        (inv_anti₀ (sq_pos_of_pos hm) (le_add_of_nonneg_left (sq_nonneg ‖p‖))) (sq_nonneg _)
  have hint_full : Integrable (fun q : ℝ × SpatialE n =>
      ‖physicsFourierExact f (euclidCons q.1 q.2)‖ ^ 2 *
        (‖euclidCons q.1 q.2‖ ^ 2 + m ^ 2)⁻¹) volume :=
    (measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable hint_full_E
  have hDpos : (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m f p‖ ^ 2) =
      ∫ k : SpatialE n, ∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m f (euclidCons p₀ k)‖ ^ 2 := by
    rw [integral_euclid_eq_prod]
    simpa [Measure.volume_eq_prod] using MeasureTheory.integral_prod_symm _ hint_pos
  have hDneg : (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m (reflectSchwartz f) p‖ ^ 2) =
      ∫ k : SpatialE n, ∫ p₀ : ℝ,
        ‖dirichletPosKernel n ħ m (reflectSchwartz f) (euclidCons p₀ k)‖ ^ 2 := by
    rw [integral_euclid_eq_prod]
    simpa [Measure.volume_eq_prod] using MeasureTheory.integral_prod_symm _ hint_neg
  have hFull : continuumCovReal n ħ m f =
      ∫ k : SpatialE n, ħ * ∫ p₀ : ℝ,
        ‖physicsFourierExact f (euclidCons p₀ k)‖ ^ 2 * (p₀ ^ 2 + euclidDispersion m k ^ 2)⁻¹ := by
    unfold continuumCovReal
    rw [integral_euclid_eq_prod]
    have hsymm : (∫ q : ℝ × SpatialE n,
        ‖physicsFourierExact f (euclidCons q.1 q.2)‖ ^ 2 *
          (‖euclidCons q.1 q.2‖ ^ 2 + m ^ 2)⁻¹) =
        ∫ k : SpatialE n, ∫ p₀ : ℝ,
          ‖physicsFourierExact f (euclidCons p₀ k)‖ ^ 2 *
            (‖euclidCons p₀ k‖ ^ 2 + m ^ 2)⁻¹ := by
      simpa [Measure.volume_eq_prod] using MeasureTheory.integral_prod_symm _ hint_full
    rw [hsymm, ← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun k => ?_)
    dsimp only; congr 1
    refine integral_congr_ae (ae_of_all _ fun p₀ => ?_)
    dsimp only
    rw [euclidCons_norm_sq, euclidDispersion_sq]; ring
  rw [hDpos, hDneg, hFull]
  have hint_k1 : Integrable (fun k : SpatialE n =>
      ‖planeKernel n ħ m (poissonProj n m hm f) k‖ ^ 2) volume :=
    planeKernel_integrable_norm_sq n ħ hm (poissonProj n m hm f)
  have hint_k2 : Integrable (fun k : SpatialE n =>
      ∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m f (euclidCons p₀ k)‖ ^ 2) volume := by
    simpa [Measure.volume_eq_prod] using hint_pos.integral_prod_right
  have hint_k3 : Integrable (fun k : SpatialE n =>
      ∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m (reflectSchwartz f) (euclidCons p₀ k)‖ ^ 2) volume := by
    simpa [Measure.volume_eq_prod] using hint_neg.integral_prod_right
  have hint_k12 : Integrable (fun a : SpatialE n =>
      ‖planeKernel n ħ m (poissonProj n m hm f) a‖ ^ 2 +
        ∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m f (euclidCons p₀ a)‖ ^ 2) volume :=
    hint_k1.add hint_k2
  rw [← integral_add hint_k1 hint_k2, ← integral_add hint_k12 hint_k3]
  refine integral_congr_ae (ae_of_all _ fun k => ?_)
  exact nelson_markov_fixed_k n hħ hm f k

/-- Complex-valued diagonal Nelson–Markov split matching Paper 1's `continuumCov` directly. -/
theorem nelson_markov_covariance_split_complex (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) :
    (((∫ k : SpatialE n, ‖planeKernel n ħ m (poissonProj n m hm f) k‖ ^ 2) +
      (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m f p‖ ^ 2) +
      (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m (reflectSchwartz f) p‖ ^ 2) : ℝ) : ℂ) =
    continuumCovExact n ħ m f f := by
  rw [nelson_markov_covariance_split n hħ hm f, continuumCovExact_diag_eq_ofReal]

/-- Polarized bilinear Nelson–Markov orthogonal covariance identity for ALL `f, g : 𝓢(EuclidD n, ℝ)`. -/
theorem nelson_markov_covariance_split_bilinear (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(EuclidD n, ℝ)) :
    (∫ k : SpatialE n, (star (planeKernel n ħ m (poissonProj n m hm f) k) *
        planeKernel n ħ m (poissonProj n m hm g) k).re) +
      (∫ p : EuclidD n, (star (dirichletPosKernel n ħ m f p) *
        dirichletPosKernel n ħ m g p).re) +
      (∫ p : EuclidD n, (star (dirichletPosKernel n ħ m (reflectSchwartz f) p) *
        dirichletPosKernel n ħ m (reflectSchwartz g) p).re) =
    (continuumCovExact n ħ m f g).re := by
  -- Real polarization: `4 Re⟨u, v⟩ = ‖u + v‖² - ‖u - v‖²` applied to all 4 quadratic forms!
  have hpol_C (u v : ℂ) : 4 * (star u * v).re = ‖u + v‖ ^ 2 - ‖u - v‖ ^ 2 := by
    rw [← Complex.normSq_eq_norm_sq, ← Complex.normSq_eq_norm_sq]
    simp [Complex.normSq_apply]; ring
  have hpol_int {α : Type} [MeasurableSpace α] {μ : Measure α}
      {u v : α → ℂ} (hu : MemLp u 2 μ) (hv : MemLp v 2 μ) :
      4 * ∫ x, (star (u x) * v x).re ∂μ =
        (∫ x, ‖u x + v x‖ ^ 2 ∂μ) - (∫ x, ‖u x - v x‖ ^ 2 ∂μ) := by
    have h1 : Integrable (fun x => ‖u x + v x‖ ^ 2) μ := (hu.add hv).norm.integrable_sq
    have h2 : Integrable (fun x => ‖u x - v x‖ ^ 2) μ := (hu.sub hv).norm.integrable_sq
    rw [← integral_sub h1 h2, ← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ fun x => hpol_C (u x) (v x))
  have h1 := hpol_int
    (planeKernel_memLp n ħ hm (poissonProj n m hm f))
    (planeKernel_memLp n ħ hm (poissonProj n m hm g))
  have h2 := hpol_int
    (dirichletPosKernel_memLp n ħ hm f)
    (dirichletPosKernel_memLp n ħ hm g)
  have h3 := hpol_int
    (dirichletPosKernel_memLp n ħ hm (reflectSchwartz f))
    (dirichletPosKernel_memLp n ħ hm (reflectSchwartz g))
  have hK0_add (k : SpatialE n) :
      planeKernel n ħ m (poissonProj n m hm f) k +
        planeKernel n ħ m (poissonProj n m hm g) k =
      planeKernel n ħ m (poissonProj n m hm (f + g)) k := by
    rw [map_add, planeKernel_add n ħ hm]
  have hK0_sub (k : SpatialE n) :
      planeKernel n ħ m (poissonProj n m hm f) k -
        planeKernel n ħ m (poissonProj n m hm g) k =
      planeKernel n ħ m (poissonProj n m hm (f - g)) k := by
    rw [show f - g = f + (-1 : ℝ) • g by rw [neg_one_smul, sub_eq_add_neg],
      map_add, map_smul, planeKernel_add n ħ hm, planeKernel_smul n ħ hm]
    push_cast; ring
  have hKp_add (p : EuclidD n) :
      dirichletPosKernel n ħ m f p + dirichletPosKernel n ħ m g p =
      dirichletPosKernel n ħ m (f + g) p :=
    (dirichletPosKernel_add n ħ m f g p).symm
  have hKp_sub (p : EuclidD n) :
      dirichletPosKernel n ħ m f p - dirichletPosKernel n ħ m g p =
      dirichletPosKernel n ħ m (f - g) p := by
    rw [show f - g = f + (-1 : ℝ) • g by rw [neg_one_smul, sub_eq_add_neg],
      dirichletPosKernel_add, dirichletPosKernel_smul]
    push_cast; ring
  have hKm_add (p : EuclidD n) :
      dirichletPosKernel n ħ m (reflectSchwartz f) p +
        dirichletPosKernel n ħ m (reflectSchwartz g) p =
      dirichletPosKernel n ħ m (reflectSchwartz (f + g)) p := by
    rw [map_add, dirichletPosKernel_add]
  have hKm_sub (p : EuclidD n) :
      dirichletPosKernel n ħ m (reflectSchwartz f) p -
        dirichletPosKernel n ħ m (reflectSchwartz g) p =
      dirichletPosKernel n ħ m (reflectSchwartz (f - g)) p := by
    rw [show f - g = f + (-1 : ℝ) • g by rw [neg_one_smul, sub_eq_add_neg],
      map_add, map_smul, dirichletPosKernel_add, dirichletPosKernel_smul]
    push_cast; ring
  simp_rw [hK0_add, hK0_sub] at h1
  simp_rw [hKp_add, hKp_sub] at h2
  simp_rw [hKm_add, hKm_sub] at h3
  have hcov_pol : 4 * (continuumCovExact n ħ m f g).re =
      continuumCovReal n ħ m (f + g) - continuumCovReal n ħ m (f - g) := by
    have hlin_add (p : EuclidD n) : physicsFourierExact (f + g) p =
        physicsFourierExact f p + physicsFourierExact g p := by
      have h := congrFun (congrArg DFunLike.coe (map_add (physicsFourierCLM (n + 2)) f g)) p
      simpa only [physicsFourierCLM_apply, add_apply] using h
    have hlin_sub (p : EuclidD n) : physicsFourierExact (f - g) p =
        physicsFourierExact f p - physicsFourierExact g p := by
      have h := congrFun (congrArg DFunLike.coe (map_sub (physicsFourierCLM (n + 2)) f g)) p
      simpa only [physicsFourierCLM_apply, sub_apply] using h
    have hint_f : Integrable (fun p : EuclidD n =>
        star (physicsFourierExact f p) * physicsFourierExact g p *
          ((‖p‖ ^ 2 + m ^ 2 : ℝ)⁻¹ : ℂ)) volume := by
      have hf2 : Integrable (fun p : EuclidD n => ‖physicsFourierExact f p‖ ^ 2) volume := by
        have heq : (fun p : EuclidD n => ‖physicsFourierExact f p‖ ^ 2) =
            fun p => ‖physicsFourierCLM (n + 2) f p‖ ^ 2 := by funext p; simp
        rw [heq]; exact ((physicsFourierCLM (n + 2) f).memLp 2 volume).norm.integrable_sq
      have hg2 : Integrable (fun p : EuclidD n => ‖physicsFourierExact g p‖ ^ 2) volume := by
        have heq : (fun p : EuclidD n => ‖physicsFourierExact g p‖ ^ 2) =
            fun p => ‖physicsFourierCLM (n + 2) g p‖ ^ 2 := by funext p; simp
        rw [heq]; exact ((physicsFourierCLM (n + 2) g).memLp 2 volume).norm.integrable_sq
      refine ((hf2.add hg2).const_mul ((m ^ 2)⁻¹)).mono' ?_ ?_
      · have hcf : Continuous (physicsFourierExact f) := by
          have heq : physicsFourierExact f = ⇑(physicsFourierCLM (n + 2) f) := by funext p; simp
          rw [heq]; exact (physicsFourierCLM (n + 2) f).continuous
        have hcg : Continuous (physicsFourierExact g) := by
          have heq : physicsFourierExact g = ⇑(physicsFourierCLM (n + 2) g) := by funext p; simp
          rw [heq]; exact (physicsFourierCLM (n + 2) g).continuous
        exact (((continuous_star.comp hcf).mul hcg).mul
          ((Complex.continuous_ofReal.comp ((continuous_norm.pow 2).add continuous_const)).inv₀
            fun p => Complex.ofReal_ne_zero.mpr (by positivity : (0 : ℝ) < ‖p‖ ^ 2 + m ^ 2).ne')).aestronglyMeasurable
      · filter_upwards with p
        rw [norm_mul, norm_mul, norm_star, norm_inv, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (by positivity : 0 < ‖p‖ ^ 2 + m ^ 2)]
        have hinv : (‖p‖ ^ 2 + m ^ 2)⁻¹ ≤ (m ^ 2)⁻¹ :=
          inv_anti₀ (sq_pos_of_pos hm) (le_add_of_nonneg_left (sq_nonneg _))
        have ham : ‖physicsFourierExact f p‖ * ‖physicsFourierExact g p‖ ≤
            ‖physicsFourierExact f p‖ ^ 2 + ‖physicsFourierExact g p‖ ^ 2 := by
          nlinarith [sq_nonneg (‖physicsFourierExact f p‖ - ‖physicsFourierExact g p‖)]
        calc ‖physicsFourierExact f p‖ * ‖physicsFourierExact g p‖ * (‖p‖ ^ 2 + m ^ 2)⁻¹
            ≤ (‖physicsFourierExact f p‖ ^ 2 + ‖physicsFourierExact g p‖ ^ 2) * (m ^ 2)⁻¹ :=
              mul_le_mul ham hinv (by positivity) (by positivity)
          _ = (m ^ 2)⁻¹ * (‖physicsFourierExact f p‖ ^ 2 + ‖physicsFourierExact g p‖ ^ 2) := mul_comm _ _
    have hint_diag (h : 𝓢(EuclidD n, ℝ)) :
        Integrable (fun p : EuclidD n => ‖physicsFourierExact h p‖ ^ 2 * (‖p‖ ^ 2 + m ^ 2)⁻¹) volume := by
      have hh2 : Integrable (fun p : EuclidD n => ‖physicsFourierExact h p‖ ^ 2) volume := by
        have heq : (fun p : EuclidD n => ‖physicsFourierExact h p‖ ^ 2) =
            fun p => ‖physicsFourierCLM (n + 2) h p‖ ^ 2 := by funext p; simp
        rw [heq]; exact ((physicsFourierCLM (n + 2) h).memLp 2 volume).norm.integrable_sq
      refine (hh2.const_mul (m ^ 2)⁻¹).mono' ?_ ?_
      · have hch : Continuous (physicsFourierExact h) := by
          have heq : physicsFourierExact h = ⇑(physicsFourierCLM (n + 2) h) := by funext p; simp
          rw [heq]; exact (physicsFourierCLM (n + 2) h).continuous
        exact ((hch.norm.pow 2).mul
          (((continuous_norm.pow 2).add continuous_const).inv₀
            fun p => (by positivity : (0 : ℝ) < ‖p‖ ^ 2 + m ^ 2).ne')).aestronglyMeasurable
      · filter_upwards with p
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), mul_comm ((m ^ 2)⁻¹)]
        exact mul_le_mul_of_nonneg_left
          (inv_anti₀ (sq_pos_of_pos hm) (le_add_of_nonneg_left (sq_nonneg _))) (sq_nonneg _)
    unfold continuumCovExact continuumCovReal
    rw [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
      show (∫ p : EuclidD n,
          star (physicsFourierExact f p) * physicsFourierExact g p *
            ((‖p‖ ^ 2 + m ^ 2 : ℝ)⁻¹ : ℂ)).re =
        ∫ p : EuclidD n,
          (star (physicsFourierExact f p) * physicsFourierExact g p *
            ((‖p‖ ^ 2 + m ^ 2 : ℝ)⁻¹ : ℂ)).re from (integral_re hint_f).symm,
      ← mul_sub, ← integral_sub (hint_diag (f + g)) (hint_diag (f - g)),
      mul_left_comm, ← integral_const_mul]
    congr 1
    refine integral_congr_ae (ae_of_all _ fun p => ?_)
    dsimp only
    rw [hlin_add p, hlin_sub p, ← Complex.ofReal_inv, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, mul_zero, sub_zero]
    have h4 := hpol_C (physicsFourierExact f p) (physicsFourierExact g p)
    linarith [mul_sub (‖physicsFourierExact f p + physicsFourierExact g p‖ ^ 2)
      (‖physicsFourierExact f p - physicsFourierExact g p‖ ^ 2) ((‖p‖ ^ 2 + m ^ 2)⁻¹),
      congrArg (· * (‖p‖ ^ 2 + m ^ 2)⁻¹) h4]
  have hsp_add := nelson_markov_covariance_split n hħ hm (f + g)
  have hsp_sub := nelson_markov_covariance_split n hħ hm (f - g)
  linarith

/-! ### Part 5: Thin-Slab Sharp-Time `L²` Approximation -/

/-- Canonical smooth bump centered at `1/2` supported inside `(0, 1)`. -/
noncomputable def unitPosBumpRaw : ContDiffBump (1 / 2 : ℝ) :=
  ⟨1 / 8, 1 / 4, by norm_num, by norm_num⟩

lemma unitPosBumpRaw_integral_pos : 0 < ∫ t : ℝ, (unitPosBumpRaw : ℝ → ℝ) t := by
  refine integral_pos_of_integrable_nonneg_nonzero (x := (1 / 2 : ℝ))
    unitPosBumpRaw.continuous
    (unitPosBumpRaw.continuous.integrable_of_hasCompactSupport unitPosBumpRaw.hasCompactSupport)
    (fun t => unitPosBumpRaw.nonneg) ?_
  have h1 : unitPosBumpRaw (1 / 2 : ℝ) = 1 :=
    unitPosBumpRaw.one_of_mem_closedBall (Metric.mem_closedBall_self (by dsimp [unitPosBumpRaw]; norm_num))
  linarith

/-- Normalized smooth probability bump supported strictly inside `(0, 1)`. -/
noncomputable def unitPosBump (t : ℝ) : ℝ :=
  (∫ s : ℝ, (unitPosBumpRaw : ℝ → ℝ) s)⁻¹ * unitPosBumpRaw t

lemma unitPosBump_contDiff : ContDiff ℝ (⊤ : ℕ∞) unitPosBump :=
  contDiff_const.mul (unitPosBumpRaw.contDiff (n := (⊤ : ℕ∞)))

lemma unitPosBump_nonneg (t : ℝ) : 0 ≤ unitPosBump t :=
  mul_nonneg (inv_nonneg.mpr unitPosBumpRaw_integral_pos.le) unitPosBumpRaw.nonneg

lemma unitPosBump_tsupport_subset : tsupport unitPosBump ⊆ Set.Ioo (0 : ℝ) 1 := by
  refine (tsupport_mul_subset_right (f := fun _ => (∫ s : ℝ, (unitPosBumpRaw : ℝ → ℝ) s)⁻¹)
    (g := (unitPosBumpRaw : ℝ → ℝ))).trans ?_
  rw [unitPosBumpRaw.tsupport_eq]
  intro t ht
  rw [Metric.mem_closedBall, Real.dist_eq, abs_le] at ht
  have hr : unitPosBumpRaw.rOut = 1 / 4 := rfl
  rw [hr] at ht
  constructor <;> linarith

lemma unitPosBump_hasCompactSupport : HasCompactSupport unitPosBump :=
  unitPosBumpRaw.hasCompactSupport.mul_left

lemma unitPosBump_integral : ∫ t : ℝ, unitPosBump t = 1 := by
  unfold unitPosBump
  rw [integral_const_mul, inv_mul_cancel₀ unitPosBumpRaw_integral_pos.ne']

/-- Rescaled thin-slab bump `ρ_ε(t) = ε⁻¹ * unitPosBump (t / ε)` supported strictly inside `(0, ε)`. -/
noncomputable def thinSlabBump (ε : ℝ) (t : ℝ) : ℝ :=
  ε⁻¹ * unitPosBump (t / ε)

lemma thinSlabBump_contDiff (ε : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (thinSlabBump ε) :=
  contDiff_const.mul (unitPosBump_contDiff.comp (contDiff_id.div_const ε))

lemma thinSlabBump_nonneg {ε : ℝ} (hε : 0 < ε) (t : ℝ) : 0 ≤ thinSlabBump ε t :=
  mul_nonneg (inv_nonneg.mpr hε.le) (unitPosBump_nonneg _)

lemma thinSlabBump_eq_zero_of_not_mem {ε : ℝ} (hε : 0 < ε) {t : ℝ}
    (ht : ¬ (0 < t ∧ t < ε)) : thinSlabBump ε t = 0 := by
  unfold thinSlabBump
  have hnot : t / ε ∉ Set.Ioo (0 : ℝ) 1 := by
    intro hmem
    apply ht
    exact ⟨(div_pos_iff_of_pos_right hε).mp hmem.1, (div_lt_one hε).mp hmem.2⟩
  have hzero : unitPosBump (t / ε) = 0 := by
    by_contra hne
    exact hnot (unitPosBump_tsupport_subset (subset_tsupport unitPosBump hne))
  rw [hzero, mul_zero]

lemma thinSlabBump_hasCompactSupport {ε : ℝ} (hε : 0 < ε) :
    HasCompactSupport (thinSlabBump ε) := by
  let hsc : Homeomorph ℝ ℝ :=
    { toFun := fun t => t / ε
      invFun := fun t => t * ε
      left_inv := fun t => div_mul_cancel₀ t hε.ne'
      right_inv := fun t => mul_div_cancel_right₀ t hε.ne'
      continuous_toFun := continuous_id.div_const ε
      continuous_invFun := continuous_id.mul continuous_const }
  exact (unitPosBump_hasCompactSupport.comp_homeomorph hsc).mul_left

lemma thinSlabBump_integral {ε : ℝ} (hε : 0 < ε) :
    ∫ t : ℝ, thinSlabBump ε t = 1 := by
  unfold thinSlabBump
  rw [integral_const_mul]
  have hsub := Measure.integral_comp_div unitPosBump ε
  rw [abs_of_pos hε] at hsub
  rw [hsub, smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hε.ne', one_mul, unitPosBump_integral]

/-- Tensor product of a 1D Schwartz function `ρ : 𝓢(ℝ, ℝ)` and a spatial Schwartz function
`h : 𝓢(SpatialE n, ℝ)` in `𝓢(EuclidD n, ℝ)`. -/
noncomputable def tensorSchwartz {n : ℕ} (ρ : 𝓢(ℝ, ℝ)) (h : 𝓢(SpatialE n, ℝ)) :
    𝓢(EuclidD n, ℝ) := by
  let p0L : EuclidD n →L[ℝ] ℝ :=
    (ContinuousLinearMap.fst ℝ ℝ (SpatialE n)).comp (timeSpatialCLE n).toContinuousLinearMap
  let spL : EuclidD n →L[ℝ] SpatialE n :=
    (ContinuousLinearMap.snd ℝ ℝ (SpatialE n)).comp (timeSpatialCLE n).toContinuousLinearMap
  have hp0_norm : ‖p0L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => ?_
    rw [one_mul]
    have h1 := PiLp.norm_apply_le x 0
    simpa [p0L, Real.norm_eq_abs] using h1
  have hsp_norm : ‖spL‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => ?_
    rw [one_mul]
    change ‖spatialProj x‖ ≤ ‖x‖
    have hsq := euclid_norm_sq_eq x
    nlinarith [norm_nonneg x, norm_nonneg (spatialProj x), sq_nonneg (x 0)]
  refine ⟨fun x => ρ (x 0) * h (spatialProj x), ?_, ?_⟩
  · exact ((ρ.smooth ⊤).comp p0L.contDiff).mul ((h.smooth ⊤).comp spL.contDiff)
  · intro k r
    let M : ℝ := 2 ^ k * ∑ i ∈ Finset.range (r + 1), (r.choose i : ℝ) *
      (SchwartzMap.seminorm ℝ k i ρ * SchwartzMap.seminorm ℝ 0 (r - i) h +
        SchwartzMap.seminorm ℝ 0 i ρ * SchwartzMap.seminorm ℝ k (r - i) h)
    refine ⟨M, fun x => ?_⟩
    have hleib := norm_iteratedFDeriv_mul_le
      ((ρ.smooth ⊤).comp p0L.contDiff) ((h.smooth ⊤).comp spL.contDiff) x (n := r) (mod_cast le_top)
    have hnorm_le : ‖x‖ ≤ |x 0| + ‖spatialProj x‖ := by
      have hsq := euclid_norm_sq_eq x
      nlinarith [norm_nonneg x, norm_nonneg (spatialProj x), abs_nonneg (x 0), sq_abs (x 0)]
    have hpow_le : ‖x‖ ^ k ≤ 2 ^ k * (|x 0| ^ k + ‖spatialProj x‖ ^ k) := by
      have h1 : (|x 0| + ‖spatialProj x‖) ^ k ≤ 2 ^ k * (|x 0| ^ k + ‖spatialProj x‖ ^ k) := by
        have hmax : |x 0| + ‖spatialProj x‖ ≤ 2 * max |x 0| ‖spatialProj x‖ := by
          linarith [le_max_left |x 0| ‖spatialProj x‖, le_max_right |x 0| ‖spatialProj x‖]
        calc (|x 0| + ‖spatialProj x‖) ^ k
            ≤ (2 * max |x 0| ‖spatialProj x‖) ^ k :=
              pow_le_pow_left₀ (by positivity) hmax k
          _ = 2 ^ k * (max |x 0| ‖spatialProj x‖) ^ k := by rw [mul_pow]
          _ ≤ 2 ^ k * (|x 0| ^ k + ‖spatialProj x‖ ^ k) := by
              gcongr
              rcases le_total |x 0| ‖spatialProj x‖ with hle | hle
              · rw [max_eq_right hle]; linarith [pow_nonneg (abs_nonneg (x 0)) k]
              · rw [max_eq_left hle]; linarith [pow_nonneg (norm_nonneg (spatialProj x)) k]
      exact (pow_le_pow_left₀ (norm_nonneg x) hnorm_le k).trans h1
    have hD_p0 (i : ℕ) : ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖ ≤
        ‖iteratedFDeriv ℝ i ρ (x 0)‖ := by
      change ‖iteratedFDeriv ℝ i (ρ ∘ p0L) x‖ ≤ _
      rw [p0L.iteratedFDeriv_comp_right (ρ.smooth ⊤) x (i := i) (mod_cast le_top)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      have hprod1 : (∏ _j : Fin i, ‖p0L‖) ≤ 1 := by
        calc ∏ _j : Fin i, ‖p0L‖ ≤ ∏ _j : Fin i, (1 : ℝ) := by gcongr
          _ = 1 := by simp
      have hmul := mul_le_mul_of_nonneg_left hprod1 (norm_nonneg (iteratedFDeriv ℝ i ρ (p0L x)))
      simpa [p0L] using hmul
    have hD_sp (j : ℕ) : ‖iteratedFDeriv ℝ j (fun y : EuclidD n => h (spatialProj y)) x‖ ≤
        ‖iteratedFDeriv ℝ j h (spatialProj x)‖ := by
      change ‖iteratedFDeriv ℝ j (h ∘ spL) x‖ ≤ _
      rw [spL.iteratedFDeriv_comp_right (h.smooth ⊤) x (i := j) (mod_cast le_top)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      have hprod1 : (∏ _l : Fin j, ‖spL‖) ≤ 1 := by
        calc ∏ _l : Fin j, ‖spL‖ ≤ ∏ _l : Fin j, (1 : ℝ) := by gcongr
          _ = 1 := by simp
      have hmul := mul_le_mul_of_nonneg_left hprod1 (norm_nonneg (iteratedFDeriv ℝ j h (spL x)))
      simpa [spL] using hmul
    calc ‖x‖ ^ k * ‖iteratedFDeriv ℝ r (fun y : EuclidD n => ρ (y 0) * h (spatialProj y)) x‖
        ≤ (2 ^ k * (|x 0| ^ k + ‖spatialProj x‖ ^ k)) *
            ∑ i ∈ Finset.range (r + 1), (r.choose i : ℝ) *
              ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖ *
              ‖iteratedFDeriv ℝ (r - i) (fun y : EuclidD n => h (spatialProj y)) x‖ :=
          mul_le_mul hpow_le hleib (norm_nonneg _) (by positivity)
      _ = 2 ^ k * ∑ i ∈ Finset.range (r + 1), (r.choose i : ℝ) *
            ((|x 0| ^ k * ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖) *
              ‖iteratedFDeriv ℝ (r - i) (fun y : EuclidD n => h (spatialProj y)) x‖ +
            ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖ *
              (‖spatialProj x‖ ^ k * ‖iteratedFDeriv ℝ (r - i) (fun y : EuclidD n => h (spatialProj y)) x‖)) := by
          rw [mul_assoc, Finset.mul_sum]
          congr 1; refine Finset.sum_congr rfl fun i _ => by ring
      _ ≤ M := by
          dsimp [M]
          refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun i _ =>
            mul_le_mul_of_nonneg_left (add_le_add ?_ ?_) (Nat.cast_nonneg _)) (by positivity)
          · have h1 : |x 0| ^ k * ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖ ≤
                SchwartzMap.seminorm ℝ k i ρ := by
              calc |x 0| ^ k * ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖
                  ≤ ‖x 0‖ ^ k * ‖iteratedFDeriv ℝ i ρ (x 0)‖ := by
                    rw [Real.norm_eq_abs]; exact mul_le_mul_of_nonneg_left (hD_p0 i) (by positivity)
                _ ≤ SchwartzMap.seminorm ℝ k i ρ := ρ.le_seminorm ℝ k i (x 0)
            have h2 : ‖iteratedFDeriv ℝ (r - i) (fun y : EuclidD n => h (spatialProj y)) x‖ ≤
                SchwartzMap.seminorm ℝ 0 (r - i) h := by
              calc ‖iteratedFDeriv ℝ (r - i) (fun y : EuclidD n => h (spatialProj y)) x‖
                  ≤ ‖iteratedFDeriv ℝ (r - i) h (spatialProj x)‖ := hD_sp (r - i)
                _ ≤ SchwartzMap.seminorm ℝ 0 (r - i) h := by
                    simpa using h.le_seminorm ℝ 0 (r - i) (spatialProj x)
            exact mul_le_mul h1 h2 (norm_nonneg _) (apply_nonneg _ _)
          · have h1 : ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖ ≤
                SchwartzMap.seminorm ℝ 0 i ρ := by
              calc ‖iteratedFDeriv ℝ i (fun y : EuclidD n => ρ (y 0)) x‖
                  ≤ ‖iteratedFDeriv ℝ i ρ (x 0)‖ := hD_p0 i
                _ ≤ SchwartzMap.seminorm ℝ 0 i ρ := by
                    simpa using ρ.le_seminorm ℝ 0 i (x 0)
            have h2 : ‖spatialProj x‖ ^ k * ‖iteratedFDeriv ℝ (r - i) (fun y : EuclidD n => h (spatialProj y)) x‖ ≤
                SchwartzMap.seminorm ℝ k (r - i) h := by
              calc ‖spatialProj x‖ ^ k * ‖iteratedFDeriv ℝ (r - i) (fun y : EuclidD n => h (spatialProj y)) x‖
                  ≤ ‖spatialProj x‖ ^ k * ‖iteratedFDeriv ℝ (r - i) h (spatialProj x)‖ :=
                    mul_le_mul_of_nonneg_left (hD_sp (r - i)) (by positivity)
                _ ≤ SchwartzMap.seminorm ℝ k (r - i) h := h.le_seminorm ℝ k (r - i) (spatialProj x)
            exact mul_le_mul h1 h2 (by positivity) (apply_nonneg _ _)

/-- **Deliverable 5 (Thin-Slab Positive-Time Mollifier):**
`thinSlabTest ε hε h x = thinSlabBump ε (x 0) * h (spatialProj x)`, supported strictly inside
`{x | 0 < x 0 ∧ x 0 < ε}`. -/
noncomputable def thinSlabTest {n : ℕ} (ε : ℝ) (hε : 0 < ε) (h : 𝓢(SpatialE n, ℝ)) :
    𝓢(EuclidD n, ℝ) :=
  tensorSchwartz ((thinSlabBump_hasCompactSupport hε).toSchwartzMap (thinSlabBump_contDiff ε)) h

@[simp] lemma thinSlabTest_apply {n : ℕ} {ε : ℝ} (hε : 0 < ε) (h : 𝓢(SpatialE n, ℝ))
    (x : EuclidD n) :
    thinSlabTest ε hε h x = thinSlabBump ε (x 0) * h (spatialProj x) := rfl

lemma thinSlabTest_eq_zero_of_not_mem {n : ℕ} {ε : ℝ} (hε : 0 < ε) (h : 𝓢(SpatialE n, ℝ))
    {x : EuclidD n} (hx : ¬ (0 < x 0 ∧ x 0 < ε)) :
    thinSlabTest ε hε h x = 0 := by
  simp [thinSlabTest_apply, thinSlabBump_eq_zero_of_not_mem hε hx]

lemma thinSlabTest_support_pos {n : ℕ} {ε : ℝ} (hε : 0 < ε) (h : 𝓢(SpatialE n, ℝ))
    {x : EuclidD n} (hx : x 0 ≤ 0) :
    thinSlabTest ε hε h x = 0 :=
  thinSlabTest_eq_zero_of_not_mem hε h (fun hpos => not_lt_of_ge hx hpos.1)

lemma spatialPhysicsFourier_thinSlabTest {n : ℕ} {ε : ℝ} (hε : 0 < ε) (h : 𝓢(SpatialE n, ℝ))
    (t : ℝ) (k : SpatialE n) :
    spatialPhysicsFourier (thinSlabTest ε hε h) t k =
      (thinSlabBump ε t : ℂ) * physicsFourierExact h k := by
  unfold spatialPhysicsFourier
  rw [physicsFourierExact_eq_integral, physicsFourierExact_eq_integral]
  simp only [thinSlabTest_apply, euclidCons_zero, spatialProj_euclidCons]
  rw [mul_left_comm]
  congr 1
  rw [← integral_const_mul]
  refine integral_congr_ae (ae_of_all _ fun y => ?_)
  dsimp only; push_cast; ring

/-- **Deliverable 5a (Thin-Slab Plane `L²` Convergence):**
As `j → ∞` with `ε = 1 / (j + 1)`:
`∫ k, ‖planeKernel n ħ m (poissonProj n m hm (thinSlabTest (1/(j+1)) _ h)) k - planeKernel n ħ m h k‖² → 0`. -/
theorem tendsto_thinSlab_plane (n : ℕ) {ħ m : ℝ} (hm : 0 < m) (h : 𝓢(SpatialE n, ℝ)) :
    Tendsto (fun j : ℕ =>
      ∫ k : SpatialE n,
        ‖planeKernel n ħ m (poissonProj n m hm (thinSlabTest (1 / ((j : ℝ) + 1)) (by positivity) h)) k -
          planeKernel n ħ m h k‖ ^ 2)
      atTop (𝓝 0) := by
  let ε : ℕ → ℝ := fun j => 1 / ((j : ℝ) + 1)
  have hε_pos : ∀ j : ℕ, 0 < ε j := fun j => by dsimp [ε]; positivity
  have hε_zero : Tendsto ε atTop (𝓝 0) := by
    simpa [ε] using (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  -- Exact factor `a_j(k) = ∫ t, exp(-|t| ω(k)) * thinSlabBump (ε j) t dt`
  let a : ℕ → SpatialE n → ℝ := fun j k =>
    ∫ t : ℝ, Real.exp (-|t| * euclidDispersion m k) * thinSlabBump (ε j) t
  have ha_bounds (j : ℕ) (k : SpatialE n) :
      Real.exp (-ε j * euclidDispersion m k) ≤ a j k ∧ a j k ≤ 1 := by
    have hω : 0 < euclidDispersion m k := euclidDispersion_pos hm k
    have hρ_int : Integrable (thinSlabBump (ε j)) volume :=
      (thinSlabBump_contDiff (ε j)).continuous.integrable_of_hasCompactSupport
        (thinSlabBump_hasCompactSupport (hε_pos j))
    have ha_int : Integrable (fun t : ℝ => Real.exp (-|t| * euclidDispersion m k) * thinSlabBump (ε j) t) volume := by
      refine hρ_int.mono' ?_ ?_
      · exact ((Real.continuous_exp.comp (by fun_prop)).mul
          (thinSlabBump_contDiff (ε j)).continuous).aestronglyMeasurable
      · filter_upwards with t
        rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _),
          abs_of_nonneg (thinSlabBump_nonneg (hε_pos j) t)]
        exact mul_le_of_le_one_left (thinSlabBump_nonneg (hε_pos j) t)
          (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg t]))
    constructor
    · have hlo : Real.exp (-ε j * euclidDispersion m k) =
          ∫ t : ℝ, Real.exp (-ε j * euclidDispersion m k) * thinSlabBump (ε j) t := by
        rw [integral_const_mul, thinSlabBump_integral (hε_pos j), mul_one]
      rw [hlo]
      refine integral_mono (hρ_int.const_mul _) ha_int fun t => ?_
      by_cases ht : 0 < t ∧ t < ε j
      · refine mul_le_mul_of_nonneg_right ?_ (thinSlabBump_nonneg (hε_pos j) t)
        rw [abs_of_pos ht.1]
        exact Real.exp_le_exp.mpr (by nlinarith [ht.2])
      · rw [thinSlabBump_eq_zero_of_not_mem (hε_pos j) ht, mul_zero, mul_zero]
    · have hhi : (1 : ℝ) = ∫ t : ℝ, thinSlabBump (ε j) t := (thinSlabBump_integral (hε_pos j)).symm
      rw [hhi]
      refine integral_mono ha_int hρ_int fun t => ?_
      exact mul_le_of_le_one_left (thinSlabBump_nonneg (hε_pos j) t)
        (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg t]))
  have hdiff_eq (j : ℕ) (k : SpatialE n) :
      ‖planeKernel n ħ m (poissonProj n m hm (thinSlabTest (ε j) (hε_pos j) h)) k -
        planeKernel n ħ m h k‖ ^ 2 =
        (1 - a j k) ^ 2 * ‖planeKernel n ħ m h k‖ ^ 2 := by
    rw [planeKernel_poissonProj n ħ hm (thinSlabTest (ε j) (hε_pos j) h) k]
    simp_rw [spatialPhysicsFourier_thinSlabTest]
    have hpull : (∫ t : ℝ, (Real.exp (-|t| * euclidDispersion m k) : ℂ) *
          ((thinSlabBump (ε j) t : ℂ) * physicsFourierExact h k)) =
        (a j k : ℂ) * physicsFourierExact h k := by
      have heq : (fun t : ℝ => (Real.exp (-|t| * euclidDispersion m k) : ℂ) *
            ((thinSlabBump (ε j) t : ℂ) * physicsFourierExact h k)) =
          fun t : ℝ => ((Real.exp (-|t| * euclidDispersion m k) * thinSlabBump (ε j) t : ℝ) : ℂ) *
            physicsFourierExact h k := by
        funext t; push_cast; ring
      rw [heq, integral_mul_const, integral_complex_ofReal]
    rw [hpull]
    have hfac : ((Real.sqrt ħ / Real.sqrt (2 * euclidDispersion m k) : ℝ) : ℂ) *
          ((a j k : ℂ) * physicsFourierExact h k) - planeKernel n ħ m h k =
        (((a j k - 1 : ℝ) : ℂ)) * planeKernel n ħ m h k := by
      unfold planeKernel planeMult
      push_cast; ring
    rw [hfac, norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    ring
  have hmain : Tendsto (fun j : ℕ =>
      ∫ k : SpatialE n,
        ‖planeKernel n ħ m (poissonProj n m hm (thinSlabTest (ε j) (hε_pos j) h)) k -
          planeKernel n ħ m h k‖ ^ 2)
      atTop (𝓝 (∫ _k : SpatialE n, (0 : ℝ))) := by
    refine MeasureTheory.tendsto_integral_of_dominated_convergence
      (bound := fun k : SpatialE n => ‖planeKernel n ħ m h k‖ ^ 2) ?_ ?_ ?_ ?_
    · intro j
      exact (((planeKernel_contDiff n ħ hm _).continuous.sub
        (planeKernel_contDiff n ħ hm h).continuous).norm.pow 2).aestronglyMeasurable
    · exact planeKernel_integrable_norm_sq n ħ hm h
    · intro j
      filter_upwards with k
      rw [hdiff_eq j k, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      have ⟨hlo, hhi⟩ := ha_bounds j k
      have h0 : 0 ≤ a j k := (Real.exp_pos _).le.trans hlo
      have hsq1 : (1 - a j k) ^ 2 ≤ 1 := by nlinarith
      exact mul_le_of_le_one_left (sq_nonneg _) hsq1
    · filter_upwards with k
      simp_rw [hdiff_eq]
      have ha_lim : Tendsto (fun j : ℕ => a j k) atTop (𝓝 1) := by
        refine tendsto_of_tendsto_of_tendsto_of_le_of_le ?_ tendsto_const_nhds
          (fun j => (ha_bounds j k).1) (fun j => (ha_bounds j k).2)
        have h1 : Tendsto (fun j : ℕ => -ε j * euclidDispersion m k) atTop (𝓝 0) := by
          simpa using (hε_zero.neg.mul_const (euclidDispersion m k))
        have h2 : Tendsto (fun j : ℕ => Real.exp (-ε j * euclidDispersion m k)) atTop (𝓝 (Real.exp 0)) :=
          (Real.continuous_exp.tendsto 0).comp h1
        simpa [Real.exp_zero] using h2
      have hsub : Tendsto (fun j : ℕ => (1 - a j k) ^ 2 * ‖planeKernel n ħ m h k‖ ^ 2) atTop
          (𝓝 ((1 - 1) ^ 2 * ‖planeKernel n ħ m h k‖ ^ 2)) :=
        ((tendsto_const_nhds.sub ha_lim).pow 2).mul_const (‖planeKernel n ħ m h k‖ ^ 2)
      simpa using hsub
  rwa [integral_zero] at hmain

/-- **Deliverable 5b (Thin-Slab Dirichlet `L²` Convergence):**
As `j → ∞` with `ε = 1 / (j + 1)`:
`∫ p, ‖dirichletPosKernel n ħ m (thinSlabTest (1/(j+1)) _ h) p‖² → 0`. -/
theorem tendsto_thinSlab_dirichlet (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (h : 𝓢(SpatialE n, ℝ)) :
    Tendsto (fun j : ℕ =>
      ∫ p : EuclidD n,
        ‖dirichletPosKernel n ħ m (thinSlabTest (1 / ((j : ℝ) + 1)) (by positivity) h) p‖ ^ 2)
      atTop (𝓝 0) := by
  let ε : ℕ → ℝ := fun j => 1 / ((j : ℝ) + 1)
  have hε_pos : ∀ j : ℕ, 0 < ε j := fun j => by dsimp [ε]; positivity
  have hε_zero : Tendsto ε atTop (𝓝 0) := by
    simpa [ε] using (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  -- Bound each `j` by `∫ k, (1 - exp (-2 * ε j * ω(k))) * ‖planeKernel h k‖²` using `dirichlet_p0_integral_eq`!
  have hbound_j (j : ℕ) :
      0 ≤ (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m (thinSlabTest (ε j) (hε_pos j) h) p‖ ^ 2) ∧
      (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m (thinSlabTest (ε j) (hε_pos j) h) p‖ ^ 2) ≤
        ∫ k : SpatialE n, (1 - Real.exp (-2 * ε j * euclidDispersion m k)) * ‖planeKernel n ħ m h k‖ ^ 2 := by
    constructor
    · exact integral_nonneg fun _ => sq_nonneg _
    · have hint_pos : Integrable (fun q : ℝ × SpatialE n =>
          ‖dirichletPosKernel n ħ m (thinSlabTest (ε j) (hε_pos j) h) (euclidCons q.1 q.2)‖ ^ 2) volume :=
        (measurePreserving_timeSpatialCLE_symm n).integrable_comp_of_integrable
          (dirichletPosKernel_integrable_norm_sq n ħ hm _)
      have hDpos : (∫ p : EuclidD n, ‖dirichletPosKernel n ħ m (thinSlabTest (ε j) (hε_pos j) h) p‖ ^ 2) =
          ∫ k : SpatialE n, ∫ p₀ : ℝ,
            ‖dirichletPosKernel n ħ m (thinSlabTest (ε j) (hε_pos j) h) (euclidCons p₀ k)‖ ^ 2 := by
        rw [integral_euclid_eq_prod]
        simpa [Measure.volume_eq_prod] using MeasureTheory.integral_prod_symm _ hint_pos
      rw [hDpos]
      have hint_lhs : Integrable (fun k : SpatialE n =>
          ∫ p₀ : ℝ, ‖dirichletPosKernel n ħ m (thinSlabTest (ε j) (hε_pos j) h) (euclidCons p₀ k)‖ ^ 2) volume := by
        simpa [Measure.volume_eq_prod] using hint_pos.integral_prod_right
      have hint_rhs : Integrable (fun k : SpatialE n =>
          (1 - Real.exp (-2 * ε j * euclidDispersion m k)) * ‖planeKernel n ħ m h k‖ ^ 2) volume := by
        refine (planeKernel_integrable_norm_sq n ħ hm h).mono' ?_ ?_
        · exact ((continuous_const.sub (Real.continuous_exp.comp
            (continuous_const.mul (Real.continuous_sqrt.comp (continuous_const.add (continuous_norm.pow 2)))))).mul
            ((planeKernel_contDiff n ħ hm h).continuous.norm.pow 2)).aestronglyMeasurable
        · filter_upwards with k
          have hω : 0 < euclidDispersion m k := euclidDispersion_pos hm k
          have hle1 : Real.exp (-2 * ε j * euclidDispersion m k) ≤ 1 :=
            Real.exp_le_one_iff.mpr (by nlinarith [hε_pos j])
          rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (by linarith) (sq_nonneg _))]
          exact mul_le_of_le_one_left (sq_nonneg _) (by linarith [Real.exp_pos (-2 * ε j * euclidDispersion m k)])
      refine integral_mono hint_lhs hint_rhs fun k => ?_
      rw [dirichlet_p0_integral_eq n hħ hm (thinSlabTest (ε j) (hε_pos j) h) k]
      set ω : ℝ := euclidDispersion m k
      have hω : 0 < ω := euclidDispersion_pos hm k
      have hfactor : (∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
            ((expKernel1D ω (t - s) - expKernel1D ω (t + s) : ℝ) : ℂ) *
            (star (spatialPhysicsFourier (thinSlabTest (ε j) (hε_pos j) h) t k) *
              spatialPhysicsFourier (thinSlabTest (ε j) (hε_pos j) h) s k)) =
          ((∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
            (expKernel1D ω (t - s) - expKernel1D ω (t + s)) *
              (thinSlabBump (ε j) t * thinSlabBump (ε j) s) : ℝ) : ℂ) *
          ((‖physicsFourierExact h k‖ ^ 2 : ℝ) : ℂ) := by
        rw [← integral_complex_ofReal, ← integral_mul_const]
        refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
        rw [← integral_complex_ofReal, ← integral_mul_const]
        refine setIntegral_congr_fun measurableSet_Ioi fun s _ => ?_
        rw [spatialPhysicsFourier_thinSlabTest, spatialPhysicsFourier_thinSlabTest,
          RCLike.star_def, map_mul, Complex.conj_ofReal]
        have hnorm : (starRingEnd ℂ) (physicsFourierExact h k) * physicsFourierExact h k =
            ((‖physicsFourierExact h k‖ ^ 2 : ℝ) : ℂ) := by
          rw [mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
        have hre : (starRingEnd ℂ) (physicsFourierExact h k) * ((thinSlabBump (ε j) s : ℂ) * physicsFourierExact h k) =
            (thinSlabBump (ε j) s : ℂ) * ((‖physicsFourierExact h k‖ ^ 2 : ℝ) : ℂ) := by
          rw [← mul_left_comm, hnorm]
        push_cast at hre ⊢
        linear_combination (((expKernel1D ω (t - s) : ℂ) - (expKernel1D ω (t + s) : ℂ)) * (thinSlabBump (ε j) t : ℂ)) * hre
      rw [hfactor, ← Complex.ofReal_mul, Complex.ofReal_re]
      -- Bound the double integral over `t, s > 0` by `(1 - exp (-2 ε ω)) / (2ω)`!
      have hρ_int : Integrable (thinSlabBump (ε j)) volume :=
        (thinSlabBump_contDiff (ε j)).continuous.integrable_of_hasCompactSupport
          (thinSlabBump_hasCompactSupport (hε_pos j))
      have hρ_Ioi : ∫ t in Ioi (0 : ℝ), thinSlabBump (ε j) t = 1 := by
        rw [← thinSlabBump_integral (hε_pos j), ← MeasureTheory.integral_indicator measurableSet_Ioi]
        refine integral_congr_ae (ae_of_all _ fun t => ?_)
        by_cases ht : 0 < t
        · rw [Set.indicator_of_mem (show t ∈ Ioi (0 : ℝ) from ht)]
        · rw [Set.indicator_of_notMem (show t ∉ Ioi (0 : ℝ) from ht),
            thinSlabBump_eq_zero_of_not_mem (hε_pos j) (fun h1 => ht h1.1)]
      have hdbl_le : (∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
            (expKernel1D ω (t - s) - expKernel1D ω (t + s)) *
              (thinSlabBump (ε j) t * thinSlabBump (ε j) s)) ≤
          (1 - Real.exp (-2 * ε j * ω)) / (2 * ω) := by
        have hstep1 : ∀ t ∈ Ioi (0 : ℝ),
            (∫ s in Ioi (0 : ℝ),
              (expKernel1D ω (t - s) - expKernel1D ω (t + s)) *
                (thinSlabBump (ε j) t * thinSlabBump (ε j) s)) ≤
            ((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) * thinSlabBump (ε j) t := by
          intro t _
          have hhi : ((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) * thinSlabBump (ε j) t =
              ∫ s in Ioi (0 : ℝ), ((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) *
                (thinSlabBump (ε j) t * thinSlabBump (ε j) s) := by
            rw [← mul_one (((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) * thinSlabBump (ε j) t),
              ← hρ_Ioi, ← integral_const_mul]
            refine setIntegral_congr_fun measurableSet_Ioi fun s _ => by ring
          rw [hhi]
          have hint_s : IntegrableOn (fun s : ℝ =>
              (expKernel1D ω (t - s) - expKernel1D ω (t + s)) *
                (thinSlabBump (ε j) t * thinSlabBump (ε j) s)) (Ioi 0) volume := by
            refine (hρ_int.integrableOn.const_mul (((2 * ω)⁻¹ + (2 * ω)⁻¹) * thinSlabBump (ε j) t)).mono' ?_ ?_
            · exact ((((expKernel1D_continuous ω).comp (continuous_const.sub continuous_id)).sub
                ((expKernel1D_continuous ω).comp (continuous_const.add continuous_id))).mul
                (continuous_const.mul (thinSlabBump_contDiff (ε j)).continuous)).aestronglyMeasurable
            · filter_upwards with s
              rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (mul_nonneg (thinSlabBump_nonneg (hε_pos j) t)
                (thinSlabBump_nonneg (hε_pos j) s))]
              have hb (r : ℝ) : |expKernel1D ω r| ≤ (2 * ω)⁻¹ := by
                unfold expKernel1D
                rw [abs_div, abs_of_pos (Real.exp_pos _), abs_of_pos (by positivity : 0 < 2 * ω),
                  div_eq_mul_inv]
                exact mul_le_of_le_one_left (by positivity)
                  (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg r]))
              calc |expKernel1D ω (t - s) - expKernel1D ω (t + s)| *
                    (thinSlabBump (ε j) t * thinSlabBump (ε j) s)
                  ≤ ((2 * ω)⁻¹ + (2 * ω)⁻¹) * (thinSlabBump (ε j) t * thinSlabBump (ε j) s) :=
                    mul_le_mul_of_nonneg_right ((abs_sub _ _).trans (add_le_add (hb _) (hb _)))
                      (mul_nonneg (thinSlabBump_nonneg (hε_pos j) t) (thinSlabBump_nonneg (hε_pos j) s))
                _ = ((2 * ω)⁻¹ + (2 * ω)⁻¹) * thinSlabBump (ε j) t * thinSlabBump (ε j) s := by ring
          have hint_s2 : IntegrableOn (fun s : ℝ =>
              ((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) *
                (thinSlabBump (ε j) t * thinSlabBump (ε j) s)) (Ioi 0) volume := by
            have heq : (fun s : ℝ => ((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) *
                (thinSlabBump (ε j) t * thinSlabBump (ε j) s)) =
                fun s => (((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) * thinSlabBump (ε j) t) *
                  thinSlabBump (ε j) s := by funext s; ring
            rw [heq]; exact hρ_int.integrableOn.const_mul _
          refine setIntegral_mono_on hint_s hint_s2 measurableSet_Ioi fun s _ => ?_
          by_cases hts : (0 < t ∧ t < ε j) ∧ (0 < s ∧ s < ε j)
          · refine mul_le_mul_of_nonneg_right ?_
              (mul_nonneg (thinSlabBump_nonneg (hε_pos j) t) (thinSlabBump_nonneg (hε_pos j) s))
            unfold expKernel1D
            rw [← sub_div]
            refine div_le_div_of_nonneg_right ?_ (by positivity)
            have h1 : Real.exp (-ω * |t - s|) ≤ 1 :=
              Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg (t - s)])
            have h2 : Real.exp (-2 * ε j * ω) ≤ Real.exp (-ω * |t + s|) := by
              rw [abs_of_pos (add_pos hts.1.1 hts.2.1)]
              exact Real.exp_le_exp.mpr (by nlinarith [hts.1.2, hts.2.2])
            linarith
          · have hzero : thinSlabBump (ε j) t * thinSlabBump (ε j) s = 0 := by
              rw [not_and_or] at hts
              rcases hts with ht0 | hs0
              · rw [thinSlabBump_eq_zero_of_not_mem (hε_pos j) ht0, zero_mul]
              · rw [thinSlabBump_eq_zero_of_not_mem (hε_pos j) hs0, mul_zero]
            rw [hzero, mul_zero, mul_zero]
        have hint_t : IntegrableOn (fun t : ℝ =>
            ∫ s in Ioi (0 : ℝ), (expKernel1D ω (t - s) - expKernel1D ω (t + s)) *
              (thinSlabBump (ε j) t * thinSlabBump (ε j) s)) (Ioi 0) volume := by
          have hint_ts : Integrable (fun ts : ℝ × ℝ =>
              (expKernel1D ω (ts.1 - ts.2) - expKernel1D ω (ts.1 + ts.2)) *
                (thinSlabBump (ε j) ts.1 * thinSlabBump (ε j) ts.2))
              ((volume.restrict (Ioi (0 : ℝ))).prod (volume.restrict (Ioi (0 : ℝ)))) := by
            refine ((hρ_int.integrableOn.mul_prod hρ_int.integrableOn).const_mul ((2 * ω)⁻¹ + (2 * ω)⁻¹)).mono' ?_ ?_
            · exact ((((expKernel1D_continuous ω).comp (continuous_fst.sub continuous_snd)).sub
                ((expKernel1D_continuous ω).comp (continuous_fst.add continuous_snd))).mul
                (((thinSlabBump_contDiff (ε j)).continuous.comp continuous_fst).mul
                  ((thinSlabBump_contDiff (ε j)).continuous.comp continuous_snd))).aestronglyMeasurable
            · filter_upwards with ts
              rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (mul_nonneg (thinSlabBump_nonneg (hε_pos j) ts.1)
                (thinSlabBump_nonneg (hε_pos j) ts.2))]
              have hb (r : ℝ) : |expKernel1D ω r| ≤ (2 * ω)⁻¹ := by
                unfold expKernel1D
                rw [abs_div, abs_of_pos (Real.exp_pos _), abs_of_pos (by positivity : 0 < 2 * ω),
                  div_eq_mul_inv]
                exact mul_le_of_le_one_left (by positivity)
                  (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg r]))
              exact mul_le_mul_of_nonneg_right ((abs_sub _ _).trans (add_le_add (hb _) (hb _)))
                (mul_nonneg (thinSlabBump_nonneg (hε_pos j) ts.1) (thinSlabBump_nonneg (hε_pos j) ts.2))
          exact hint_ts.integral_prod_left
        have hstep2 := setIntegral_mono_on hint_t (hρ_int.integrableOn.const_mul _) measurableSet_Ioi hstep1
        rwa [integral_const_mul, hρ_Ioi, mul_one] at hstep2
      have hK0_sq : ‖planeKernel n ħ m h k‖ ^ 2 =
          ħ * (‖physicsFourierExact h k‖ ^ 2 / (2 * ω)) := by
        unfold planeKernel planeMult
        rw [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs, div_pow,
          Real.sq_sqrt hħ, Real.sq_sqrt (by positivity : (0 : ℝ) ≤ 2 * ω)]
        ring
      rw [hK0_sq]
      calc ħ * ((∫ t in Ioi (0 : ℝ), ∫ s in Ioi (0 : ℝ),
              (expKernel1D ω (t - s) - expKernel1D ω (t + s)) *
                (thinSlabBump (ε j) t * thinSlabBump (ε j) s)) * ‖physicsFourierExact h k‖ ^ 2)
          ≤ ħ * (((1 - Real.exp (-2 * ε j * ω)) / (2 * ω)) * ‖physicsFourierExact h k‖ ^ 2) := by
            gcongr
        _ = (1 - Real.exp (-2 * ε j * ω)) * (ħ * (‖physicsFourierExact h k‖ ^ 2 / (2 * ω))) := by ring
  -- Now squeeze by Dominated Convergence on the upper bound!
  refine squeeze_zero (fun j => (hbound_j j).1) (fun j => (hbound_j j).2) ?_
  have hzero : (0 : ℝ) = ∫ _k : SpatialE n, (0 : ℝ) := by simp
  rw [hzero]
  refine MeasureTheory.tendsto_integral_of_dominated_convergence
    (bound := fun k : SpatialE n => ‖planeKernel n ħ m h k‖ ^ 2) ?_ ?_ ?_ ?_
  · intro j
    exact ((continuous_const.sub (Real.continuous_exp.comp
      (continuous_const.mul (Real.continuous_sqrt.comp (continuous_const.add (continuous_norm.pow 2)))))).mul
      ((planeKernel_contDiff n ħ hm h).continuous.norm.pow 2)).aestronglyMeasurable
  · exact planeKernel_integrable_norm_sq n ħ hm h
  · intro j
    filter_upwards with k
    have hω : 0 < euclidDispersion m k := euclidDispersion_pos hm k
    have hle1 : Real.exp (-2 * ε j * euclidDispersion m k) ≤ 1 :=
      Real.exp_le_one_iff.mpr (by nlinarith [hε_pos j])
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (by linarith) (sq_nonneg _))]
    exact mul_le_of_le_one_left (sq_nonneg _) (by linarith [Real.exp_pos (-2 * ε j * euclidDispersion m k)])
  · filter_upwards with k
    have h1 : Tendsto (fun j : ℕ => -2 * ε j * euclidDispersion m k) atTop (𝓝 0) := by
      have h := (hε_zero.const_mul (-2 : ℝ)).mul_const (euclidDispersion m k)
      simpa using h
    have h2 : Tendsto (fun j : ℕ => Real.exp (-2 * ε j * euclidDispersion m k)) atTop (𝓝 1) := by
      have h := (Real.continuous_exp.tendsto 0).comp h1
      simpa [Function.comp_def, Real.exp_zero] using h
    have h3 : Tendsto (fun j : ℕ => (1 - Real.exp (-2 * ε j * euclidDispersion m k)) * ‖planeKernel n ħ m h k‖ ^ 2)
        atTop (𝓝 ((1 - 1) * ‖planeKernel n ħ m h k‖ ^ 2)) :=
      (tendsto_const_nhds.sub h2).mul_const (‖planeKernel n ħ m h k‖ ^ 2)
    simpa using h3

end NelsonKernels

section PlaneL2FockEquivSection

namespace PlaneL2FockEquiv

open MeasureTheory Set Filter
open scoped InnerProductSpace BigOperators Topology ENNReal SchwartzMap

/-!
==============================================================================
  PART A: GENERAL NONLINEAR NELSON–MARKOV REFLECTION FACTORIZATION & `condExp`
==============================================================================
-/

section NelsonMarkov

variable {Ω₀ Ωp X X₀ : Type*}
  [MeasurableSpace Ω₀] [MeasurableSpace Ωp]
  {mPos : MeasurableSpace X} [mX : MeasurableSpace X] [mX₀ : MeasurableSpace X₀]

/-- The reflection swap on the triple product space `Ω₀ × Ωp × Ωp`. -/
def tripleSwap (ω : Ω₀ × Ωp × Ωp) : Ω₀ × Ωp × Ωp :=
  (ω.1, ω.2.2, ω.2.1)

theorem measurable_tripleSwap : Measurable (tripleSwap (Ω₀ := Ω₀) (Ωp := Ωp)) :=
  measurable_fst.prodMk ((measurable_snd.comp measurable_snd).prodMk
    (measurable_fst.comp measurable_snd))

theorem measurePreserving_tripleSwap (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp] :
    MeasurePreserving (tripleSwap (Ω₀ := Ω₀) (Ωp := Ωp))
      (P₀.prod (Pp.prod Pp)) (P₀.prod (Pp.prod Pp)) :=
  (MeasurePreserving.id P₀).prod (Measure.measurePreserving_swap (μ := Pp) (ν := Pp))

/-- Reflection preserves the pushforward measure `μ = (P₀ × Pp × Pp).map Φ`. -/
theorem reflection_measurePreserving
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (Θ : X → X) (hΘ : Measurable Θ)
    (hΘ_swap : ∀ ω₀ ωp ωm, Θ (Φ (ω₀, ωp, ωm)) = Φ (ω₀, ωm, ωp)) :
    MeasurePreserving Θ
      ((P₀.prod (Pp.prod Pp)).map Φ) ((P₀.prod (Pp.prod Pp)).map Φ) := by
  refine ⟨hΘ, ?_⟩
  rw [Measure.map_map hΘ hΦ]
  have hcomp : Θ ∘ Φ = Φ ∘ tripleSwap := by
    funext ⟨ω₀, ωp, ωm⟩
    exact hΘ_swap ω₀ ωp ωm
  rw [hcomp, ← Measure.map_map hΦ measurable_tripleSwap,
    (measurePreserving_tripleSwap P₀ Pp).map_eq]

/-- Projection of a positive-half-space functional `F : X → ℂ` onto the time-zero plane `X₀`,
obtained by integrating out the upper-half-space Dirichlet degrees of freedom `Ωp`. -/
noncomputable def planeProj (Pp : Measure Ωp) (liftPos : X₀ × Ωp → X)
    (F : X → ℂ) (x₀ : X₀) : ℂ :=
  ∫ ωp, F (liftPos (x₀, ωp)) ∂Pp

/-- Pushforward of `P₀.prod Pp` under `(ω₀, ωp) ↦ (Φ₀ ω₀, ωp)` equals `(P₀.map Φ₀).prod Pp`. -/
theorem map_prod_Phi0_id
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀) :
    (P₀.prod Pp).map (Prod.map Φ₀ id) = (P₀.map Φ₀).prod Pp := by
  rw [← Measure.map_prod_map P₀ Pp hΦ₀ measurable_id, Measure.map_id]

/-- Exact `L²`-norm preservation along `liftPos` for every `mPos`-measurable `F`. -/
theorem lintegral_sq_norm_comp_liftPos
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F : X → ℂ) (hFm : Measurable[mPos] F) :
    ∫⁻ p, ‖F (liftPos p)‖ₑ ^ (2 : ℝ) ∂((P₀.map Φ₀).prod Pp) =
      ∫⁻ x, ‖F x‖ₑ ^ (2 : ℝ) ∂((P₀.prod (Pp.prod Pp)).map Φ) := by
  have hFX : Measurable F := hFm.mono hmPos le_rfl
  have hg : Measurable (fun p : X₀ × Ωp ↦ ‖F (liftPos p)‖ₑ ^ (2 : ℝ)) :=
    ((hFX.comp hliftPos).enorm).pow_const 2
  have hf : Measurable (fun x : X ↦ ‖F x‖ₑ ^ (2 : ℝ)) :=
    hFX.enorm.pow_const 2
  rw [← map_prod_Phi0_id P₀ Pp Φ₀ hΦ₀,
    lintegral_map hg (hΦ₀.prodMap measurable_id),
    lintegral_map hf hΦ]
  have hg' : Measurable (fun a : Ω₀ × Ωp ↦ ‖F (liftPos (Prod.map Φ₀ id a))‖ₑ ^ (2 : ℝ)) :=
    hg.comp (hΦ₀.prodMap measurable_id)
  have hf' : Measurable (fun a : Ω₀ × Ωp × Ωp ↦ ‖F (Φ a)‖ₑ ^ (2 : ℝ)) := hf.comp hΦ
  rw [lintegral_prod _ hg'.aemeasurable, lintegral_prod _ hf'.aemeasurable]
  congr 1
  funext ω₀
  have hinner : Measurable (fun q : Ωp × Ωp ↦ ‖F (Φ (ω₀, q))‖ₑ ^ (2 : ℝ)) :=
    hf'.comp (measurable_const.prodMk measurable_id)
  rw [lintegral_prod _ hinner.aemeasurable]
  congr 1
  funext ωp
  have hconst : (fun ωm : Ωp ↦ ‖F (Φ (ω₀, ωp, ωm))‖ₑ ^ (2 : ℝ)) =
      fun _ ↦ ‖F (liftPos (Φ₀ ω₀, ωp))‖ₑ ^ (2 : ℝ) := by
    funext ωm
    rw [hPos_local F hFm ω₀ ωp ωm]
  rw [hconst, lintegral_const, measure_univ, mul_one]
  rfl

theorem memLp_comp_liftPos
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F : X → ℂ) (hFm : Measurable[mPos] F)
    (hFLp : MemLp F 2 ((P₀.prod (Pp.prod Pp)).map Φ)) :
    MemLp (fun p : X₀ × Ωp ↦ F (liftPos p)) 2 ((P₀.map Φ₀).prod Pp) := by
  have hFX : Measurable F := hFm.mono hmPos le_rfl
  have hcomp : Measurable (fun p : X₀ × Ωp ↦ F (liftPos p)) := hFX.comp hliftPos
  rw [memLp_two_iff_integrable_sq_norm hcomp.aestronglyMeasurable]
  have hFsq : Integrable (fun x ↦ ‖F x‖ ^ 2) ((P₀.prod (Pp.prod Pp)).map Φ) :=
    (memLp_two_iff_integrable_sq_norm hFLp.aestronglyMeasurable).mp hFLp
  refine ⟨(((hFX.comp hliftPos).norm).pow_const 2).aestronglyMeasurable, ?_⟩
  rw [HasFiniteIntegral]
  have hconv : ∀ z : ℂ, ‖‖z‖ ^ 2‖ₑ = ‖z‖ₑ ^ (2 : ℝ) := fun z ↦ by
    rw [Real.enorm_eq_ofReal (sq_nonneg _), ENNReal.ofReal_pow (norm_nonneg z), ofReal_norm]
    norm_cast
  simp_rw [hconv]
  rw [lintegral_sq_norm_comp_liftPos P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F hFm]
  simpa only [HasFiniteIntegral, hconv] using hFsq.hasFiniteIntegral

/-- Cauchy–Schwarz on a probability space: `‖∫ g‖^2 ≤ ∫ ‖g‖^2`. -/
private theorem norm_integral_sq_le_integral_norm_sq
    {α : Type*} [MeasurableSpace α] (P : Measure α) [IsProbabilityMeasure P]
    {g : α → ℂ} (hg : MemLp g 2 P) :
    ‖∫ a, g a ∂P‖ ^ 2 ≤ ∫ a, ‖g a‖ ^ 2 ∂P := by
  have hg1 : Integrable g P := hg.integrable one_le_two
  have hgn1 : Integrable (fun a ↦ ‖g a‖) P := hg1.norm
  have hgn2 : Integrable (fun a ↦ ‖g a‖ ^ 2) P :=
    (memLp_two_iff_integrable_sq_norm hg.aestronglyMeasurable).mp hg
  set c : ℝ := ∫ a, ‖g a‖ ∂P
  have h1 : ‖∫ a, g a ∂P‖ ≤ c := norm_integral_le_integral_norm g
  have h1_sq : ‖∫ a, g a ∂P‖ ^ 2 ≤ c ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) h1 2
  have hdiff_nn : 0 ≤ ∫ a, (‖g a‖ - c) ^ 2 ∂P :=
    integral_nonneg fun a ↦ sq_nonneg _
  have hsub_int : Integrable (fun a ↦ ‖g a‖ ^ 2 - 2 * c * ‖g a‖) P :=
    hgn2.sub (hgn1.const_mul (2 * c))
  have hdiff_eq : (∫ a, (‖g a‖ - c) ^ 2 ∂P) = (∫ a, ‖g a‖ ^ 2 ∂P) - c ^ 2 := by
    have hfun : (fun a ↦ (‖g a‖ - c) ^ 2) = fun a ↦ (‖g a‖ ^ 2 - 2 * c * ‖g a‖) + c ^ 2 := by
      funext a; ring
    have hPun : P.real Set.univ = 1 := by
      rw [measureReal_def, measure_univ, ENNReal.toReal_one]
    rw [hfun, integral_add hsub_int (integrable_const _),
      integral_sub hgn2 (hgn1.const_mul (2 * c)), integral_const_mul, integral_const,
      hPun, one_smul]
    change (∫ a, ‖g a‖ ^ 2 ∂P) - 2 * c * c + c ^ 2 = (∫ a, ‖g a‖ ^ 2 ∂P) - c ^ 2
    ring
  linarith

theorem planeProj_stronglyMeasurable
    (Pp : Measure Ωp) [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (F : X → ℂ) (hFm : Measurable[mPos] F) :
    StronglyMeasurable (planeProj Pp liftPos F) := by
  have hFX : Measurable F := hFm.mono hmPos le_rfl
  exact (hFX.comp hliftPos).stronglyMeasurable.integral_prod_right'

theorem planeProj_memLp_and_norm_sq_le
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F : X → ℂ) (hFm : Measurable[mPos] F)
    (hFLp : MemLp F 2 ((P₀.prod (Pp.prod Pp)).map Φ)) :
    MemLp (planeProj Pp liftPos F) 2 (P₀.map Φ₀) ∧
      ∫ x₀, ‖planeProj Pp liftPos F x₀‖ ^ 2 ∂(P₀.map Φ₀) ≤
        ∫ x, ‖F x‖ ^ 2 ∂((P₀.prod (Pp.prod Pp)).map Φ) := by
  have hFX : Measurable F := hFm.mono hmPos le_rfl
  have hcompLp := memLp_comp_liftPos P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F hFm hFLp
  have hsq_int : Integrable (fun p : X₀ × Ωp ↦ ‖F (liftPos p)‖ ^ 2) ((P₀.map Φ₀).prod Pp) :=
    (memLp_two_iff_integrable_sq_norm hcompLp.aestronglyMeasurable).mp hcompLp
  have hslice_int : ∀ᵐ x₀ ∂(P₀.map Φ₀), Integrable (fun ωp ↦ ‖F (liftPos (x₀, ωp))‖ ^ 2) Pp :=
    hsq_int.prod_right_ae
  have hproj_meas : StronglyMeasurable (planeProj Pp liftPos F) :=
    planeProj_stronglyMeasurable Pp hmPos liftPos hliftPos F hFm
  have hbound_ae : ∀ᵐ x₀ ∂(P₀.map Φ₀),
      ‖planeProj Pp liftPos F x₀‖ ^ 2 ≤ ∫ ωp, ‖F (liftPos (x₀, ωp))‖ ^ 2 ∂Pp := by
    filter_upwards [hslice_int] with x₀ hx₀
    have hsm : StronglyMeasurable (fun ωp ↦ F (liftPos (x₀, ωp))) :=
      ((hFX.comp hliftPos).comp (measurable_const.prodMk measurable_id)).stronglyMeasurable
    have hmem : MemLp (fun ωp ↦ F (liftPos (x₀, ωp))) 2 Pp :=
      (memLp_two_iff_integrable_sq_norm hsm.aestronglyMeasurable).mpr hx₀
    exact norm_integral_sq_le_integral_norm_sq Pp hmem
  have hproj_sq_int : Integrable (fun x₀ ↦ ‖planeProj Pp liftPos F x₀‖ ^ 2) (P₀.map Φ₀) := by
    refine Integrable.mono' hsq_int.integral_prod_left
      (hproj_meas.norm.pow 2).aestronglyMeasurable ?_
    filter_upwards [hbound_ae] with x₀ hx₀
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact hx₀
  have hproj_memLp : MemLp (planeProj Pp liftPos F) 2 (P₀.map Φ₀) :=
    (memLp_two_iff_integrable_sq_norm hproj_meas.aestronglyMeasurable).mpr hproj_sq_int
  have hle : ∫ x₀, ‖planeProj Pp liftPos F x₀‖ ^ 2 ∂(P₀.map Φ₀) ≤
      ∫ p, ‖F (liftPos p)‖ ^ 2 ∂((P₀.map Φ₀).prod Pp) := by
    rw [integral_prod _ hsq_int]
    exact integral_mono_ae hproj_sq_int hsq_int.integral_prod_left hbound_ae
  have heq : ∫ p, ‖F (liftPos p)‖ ^ 2 ∂((P₀.map Φ₀).prod Pp) =
      ∫ x, ‖F x‖ ^ 2 ∂((P₀.prod (Pp.prod Pp)).map Φ) := by
    have hFsq_int : Integrable (fun x ↦ ‖F x‖ ^ 2) ((P₀.prod (Pp.prod Pp)).map Φ) :=
      (memLp_two_iff_integrable_sq_norm hFLp.aestronglyMeasurable).mp hFLp
    rw [integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun _ ↦ sq_nonneg _)
        hsq_int.aestronglyMeasurable,
      integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun _ ↦ sq_nonneg _)
        hFsq_int.aestronglyMeasurable]
    congr 1
    have hconv : ∀ (z : ℂ), ENNReal.ofReal (‖z‖ ^ 2) = ‖z‖ₑ ^ (2 : ℝ) := fun z ↦ by
      rw [ENNReal.ofReal_pow (norm_nonneg z), ofReal_norm]
      norm_cast
    simp_rw [hconv]
    exact lintegral_sq_norm_comp_liftPos P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
      hPos_local F hFm
  exact ⟨hproj_memLp, hle.trans_eq heq⟩

/-- `planeProj` respects `μ`-a.e. equality of `mPos`-measurable functions. -/
theorem planeProj_congr_ae
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    {F G : X → ℂ} (hFm : Measurable[mPos] F) (hGm : Measurable[mPos] G)
    (hFG : F =ᵐ[(P₀.prod (Pp.prod Pp)).map Φ] G) :
    planeProj Pp liftPos F =ᵐ[P₀.map Φ₀] planeProj Pp liftPos G := by
  have hDiffm : Measurable[mPos] (fun x ↦ F x - G x) := hFm.sub hGm
  have hzero : ∫⁻ x, ‖F x - G x‖ₑ ^ (2 : ℝ) ∂((P₀.prod (Pp.prod Pp)).map Φ) = 0 := by
    refine (lintegral_eq_zero_iff (((hDiffm.mono hmPos le_rfl).enorm).pow_const 2)).mpr ?_
    filter_upwards [hFG] with x hx
    simp [hx]
  have hprod_zero : ∫⁻ p, ‖F (liftPos p) - G (liftPos p)‖ₑ ^ (2 : ℝ) ∂((P₀.map Φ₀).prod Pp) = 0 := by
    rw [lintegral_sq_norm_comp_liftPos P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
      hPos_local (fun x ↦ F x - G x) hDiffm, hzero]
  have hprod_ae : ∀ᵐ p ∂((P₀.map Φ₀).prod Pp), F (liftPos p) = G (liftPos p) := by
    have hmeas : Measurable (fun p : X₀ × Ωp ↦ ‖F (liftPos p) - G (liftPos p)‖ₑ ^ (2 : ℝ)) :=
      (((hDiffm.mono hmPos le_rfl).comp hliftPos).enorm).pow_const 2
    filter_upwards [(lintegral_eq_zero_iff hmeas).mp hprod_zero] with p hp
    have hnorm0 : ‖F (liftPos p) - G (liftPos p)‖ₑ = 0 := by
      have : (‖F (liftPos p) - G (liftPos p)‖ₑ ^ (2 : ℝ)) = 0 := hp
      simpa using (ENNReal.rpow_eq_zero_iff.mp this).resolve_right (by norm_num)
    exact sub_eq_zero.mp (enorm_eq_zero.mp hnorm0)
  filter_upwards [Measure.ae_ae_of_ae_prod hprod_ae] with x₀ hx₀
  exact integral_congr_ae hx₀

/-- **General Nonlinear Nelson–Markov Fubini Reflection Factorization**:
for EVERY `mPos`-measurable `F, G ∈ L²(μ)`, the Euclidean reflection inner product equals the
time-zero plane `L²(ν)` inner product of `planeProj F` and `planeProj G`. -/
theorem reflection_inner_eq_planeL2
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (Θ : X → X) (hΘ : Measurable Θ)
    (hΘ_swap : ∀ ω₀ ωp ωm, Θ (Φ (ω₀, ωp, ωm)) = Φ (ω₀, ωm, ωp))
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F G : X → ℂ) (hFm : Measurable[mPos] F) (hGm : Measurable[mPos] G)
    (hFLp : MemLp F 2 ((P₀.prod (Pp.prod Pp)).map Φ))
    (hGLp : MemLp G 2 ((P₀.prod (Pp.prod Pp)).map Φ)) :
    ∫ x, star (F (Θ x)) * G x ∂((P₀.prod (Pp.prod Pp)).map Φ) =
      ∫ x₀, star (planeProj Pp liftPos F x₀) * planeProj Pp liftPos G x₀ ∂(P₀.map Φ₀) := by
  let P := P₀.prod (Pp.prod Pp)
  have hFX : Measurable F := hFm.mono hmPos le_rfl
  have hGX : Measurable G := hGm.mono hmPos le_rfl
  have hΘmp : MeasurePreserving Θ (P.map Φ) (P.map Φ) :=
    reflection_measurePreserving P₀ Pp Φ hΦ Θ hΘ hΘ_swap
  have hFΘLp : MemLp (fun x ↦ F (Θ x)) 2 (P.map Φ) := hFLp.comp_measurePreserving hΘmp
  have hFΘ_star_Lp : MemLp (fun x ↦ star (F (Θ x))) 2 (P.map Φ) := hFΘLp.star
  have hint_X : Integrable (fun x ↦ star (F (Θ x)) * G x) (P.map Φ) :=
    (hGLp.integrable_mul hFΘ_star_Lp).congr (ae_of_all _ fun x ↦ mul_comm _ _)
  have hint_P : Integrable (fun ω ↦ star (F (Θ (Φ ω))) * G (Φ ω)) P :=
    (integrable_map_measure hint_X.aestronglyMeasurable hΦ.aemeasurable).mp hint_X
  have hmeas_X : Measurable (fun x ↦ star (F (Θ x)) * G x) :=
    (Complex.continuous_conj.measurable.comp (hFX.comp hΘ)).mul hGX
  rw [integral_map hΦ.aemeasurable hmeas_X.aestronglyMeasurable]
  have hpoint : (fun ω : Ω₀ × Ωp × Ωp ↦ star (F (Θ (Φ ω))) * G (Φ ω)) =
      fun ω ↦ G (liftPos (Φ₀ ω.1, ω.2.1)) * star (F (liftPos (Φ₀ ω.1, ω.2.2))) := by
    funext ⟨ω₀, ωp, ωm⟩
    rw [hΘ_swap ω₀ ωp ωm, hPos_local F hFm ω₀ ωm ωp, hPos_local G hGm ω₀ ωp ωm, mul_comm]
  have hint_P' : Integrable
      (fun ω : Ω₀ × Ωp × Ωp ↦ G (liftPos (Φ₀ ω.1, ω.2.1)) * star (F (liftPos (Φ₀ ω.1, ω.2.2)))) P := by
    simpa only [hpoint] using hint_P
  rw [hpoint, integral_prod _ hint_P']
  have hinner : ∀ ω₀ : Ω₀,
      ∫ q : Ωp × Ωp, G (liftPos (Φ₀ ω₀, q.1)) * star (F (liftPos (Φ₀ ω₀, q.2))) ∂(Pp.prod Pp) =
        star (planeProj Pp liftPos F (Φ₀ ω₀)) * planeProj Pp liftPos G (Φ₀ ω₀) := fun ω₀ ↦ by
    rw [integral_prod_mul (fun ωp ↦ G (liftPos (Φ₀ ω₀, ωp)))
      (fun ωm ↦ star (F (liftPos (Φ₀ ω₀, ωm)))), mul_comm]
    congr 1
    exact integral_conj
  simp_rw [hinner]
  have hmeas_X0 : Measurable (fun x₀ ↦ star (planeProj Pp liftPos F x₀) * planeProj Pp liftPos G x₀) :=
    (Complex.continuous_conj.measurable.comp
      (planeProj_stronglyMeasurable Pp hmPos liftPos hliftPos F hFm).measurable).mul
      (planeProj_stronglyMeasurable Pp hmPos liftPos hliftPos G hGm).measurable
  rw [integral_map hΦ₀.aemeasurable hmeas_X0.aestronglyMeasurable]

/-- **General Nonlinear Reflection Positivity**: for EVERY `mPos`-measurable `F ∈ L²(μ)`,
`∫ x, star (F (Θ x)) * F x ∂μ` is real and nonnegative. -/
theorem reflection_pos_nonlinear
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (Θ : X → X) (hΘ : Measurable Θ)
    (hΘ_swap : ∀ ω₀ ωp ωm, Θ (Φ (ω₀, ωp, ωm)) = Φ (ω₀, ωm, ωp))
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F : X → ℂ) (hFm : Measurable[mPos] F)
    (hFLp : MemLp F 2 ((P₀.prod (Pp.prod Pp)).map Φ)) :
    0 ≤ (∫ x, star (F (Θ x)) * F x ∂((P₀.prod (Pp.prod Pp)).map Φ)).re ∧
      (∫ x, star (F (Θ x)) * F x ∂((P₀.prod (Pp.prod Pp)).map Φ)).im = 0 := by
  rw [reflection_inner_eq_planeL2 P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ Θ hΘ
    hΘ_swap hPos_local F F hFm hFm hFLp hFLp]
  have hreal : (fun x₀ ↦ star (planeProj Pp liftPos F x₀) * planeProj Pp liftPos F x₀) =
      fun x₀ ↦ ((‖planeProj Pp liftPos F x₀‖ ^ 2 : ℝ) : ℂ) := by
    funext x₀
    rw [Complex.star_def, Complex.conj_mul', Complex.ofReal_pow]
  rw [hreal, integral_complex_ofReal]
  exact ⟨integral_nonneg fun _ ↦ sq_nonneg _, rfl⟩

/-- Time-zero sub-`σ`-algebra on `X` induced by a sharp-time trace map `trace₀ : X → X₀`. -/
abbrev mZero (trace₀ : X → X₀) : MeasurableSpace X :=
  MeasurableSpace.comap trace₀ mX₀

omit mX in
theorem mZero_le_mPos {trace₀ : X → X₀} (htrace₀ : Measurable[mPos, mX₀] trace₀) :
    mZero trace₀ ≤ mPos :=
  htrace₀.comap_le

theorem mZero_le_ambient (hmPos : mPos ≤ mX) {trace₀ : X → X₀}
    (htrace₀ : Measurable[mPos, mX₀] trace₀) :
    mZero trace₀ ≤ mX :=
  (mZero_le_mPos htrace₀).trans hmPos

/-- `trace₀` pushes `μ = P.map Φ` forward to `ν = P₀.map Φ₀`. -/
theorem trace₀_measurePreserving
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (trace₀ : X → X₀) (htrace₀ : Measurable[mPos, mX₀] trace₀)
    (htrace₀_ae : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1) :
    MeasurePreserving trace₀ ((P₀.prod (Pp.prod Pp)).map Φ) (P₀.map Φ₀) := by
  have htraceX : Measurable trace₀ := htrace₀.mono hmPos le_rfl
  refine ⟨htraceX, ?_⟩
  rw [Measure.map_map htraceX hΦ]
  change (P₀.prod (Pp.prod Pp)).map (fun ω ↦ trace₀ (Φ ω)) = P₀.map Φ₀
  rw [Measure.map_congr htrace₀_ae]
  change (P₀.prod (Pp.prod Pp)).map (Φ₀ ∘ Prod.fst) = P₀.map Φ₀
  rw [← Measure.map_map hΦ₀ measurable_fst, Measure.map_fst_prod]
  simp only [measure_univ, one_smul]

/-- **Exact Mathlib `condExp` Identification**: for EVERY `mPos`-measurable `F ∈ L²(μ)`,
`μ[F | mZero trace₀] =ᵐ[μ] (planeProj Pp liftPos F) ∘ trace₀`. -/
theorem condExp_eq_planeProj
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (trace₀ : X → X₀) (htrace₀ : Measurable[mPos, mX₀] trace₀)
    (htrace₀_ae : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1)
    (F : X → ℂ) (hFm : Measurable[mPos] F)
    (hFLp : MemLp F 2 ((P₀.prod (Pp.prod Pp)).map Φ)) :
    ((P₀.prod (Pp.prod Pp)).map Φ)[F | mZero trace₀] =ᵐ[(P₀.prod (Pp.prod Pp)).map Φ]
      (planeProj Pp liftPos F) ∘ trace₀ := by
  let P := P₀.prod (Pp.prod Pp)
  let μ := P.map Φ
  let ν := P₀.map Φ₀
  have hm0 : mZero trace₀ ≤ mX := mZero_le_ambient hmPos htrace₀
  have : IsFiniteMeasure (μ.trim hm0) := isFiniteMeasure_trim hm0
  have htr_mp : MeasurePreserving trace₀ μ ν :=
    trace₀_measurePreserving P₀ Pp hmPos Φ₀ hΦ₀ Φ hΦ trace₀ htrace₀ htrace₀_ae
  have hproj_Lp : MemLp (planeProj Pp liftPos F) 2 ν :=
    (planeProj_memLp_and_norm_sq_le P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
      hPos_local F hFm hFLp).1
  have hg_Lp : MemLp ((planeProj Pp liftPos F) ∘ trace₀) 2 μ :=
    hproj_Lp.comp_measurePreserving htr_mp
  have hg_int : Integrable ((planeProj Pp liftPos F) ∘ trace₀) μ := hg_Lp.integrable one_le_two
  have hF_int : Integrable F μ := hFLp.integrable one_le_two
  have hproj_sm : StronglyMeasurable (planeProj Pp liftPos F) :=
    planeProj_stronglyMeasurable Pp hmPos liftPos hliftPos F hFm
  have hg_sm : StronglyMeasurable[mZero trace₀] ((planeProj Pp liftPos F) ∘ trace₀) :=
    hproj_sm.comp_measurable (Measurable.of_comap_le le_rfl)
  symm
  refine ae_eq_condExp_of_forall_setIntegral_eq hm0 hF_int
    (fun s _ _ ↦ hg_int.integrableOn) (fun s hs _ ↦ ?_) hg_sm.aestronglyMeasurable
  rcases hs with ⟨s₀, hs₀, rfl⟩
  have htraceX : Measurable trace₀ := htrace₀.mono hmPos le_rfl
  have hFX : Measurable F := hFm.mono hmPos le_rfl
  have hLHS : ∫ x in trace₀ ⁻¹' s₀, ((planeProj Pp liftPos F) ∘ trace₀) x ∂μ =
      ∫ x₀ in s₀, planeProj Pp liftPos F x₀ ∂ν := by
    rw [← integral_indicator (htraceX hs₀), ← integral_indicator hs₀]
    have hind : (trace₀ ⁻¹' s₀).indicator ((planeProj Pp liftPos F) ∘ trace₀) =
        (s₀.indicator (planeProj Pp liftPos F)) ∘ trace₀ := by
      funext x
      by_cases hx : trace₀ x ∈ s₀ <;> simp [Set.indicator, hx]
    rw [hind, ← htr_mp.map_eq,
      integral_map htraceX.aemeasurable (hproj_sm.indicator hs₀).aestronglyMeasurable]
    rfl
  have hRHS : ∫ x in trace₀ ⁻¹' s₀, F x ∂μ =
      ∫ x₀ in s₀, planeProj Pp liftPos F x₀ ∂ν := by
    rw [← integral_indicator (htraceX hs₀),
      integral_map hΦ.aemeasurable (hFX.stronglyMeasurable.indicator (htraceX hs₀)).aestronglyMeasurable]
    have hFP_int : Integrable (fun ω ↦ F (Φ ω)) P :=
      (integrable_map_measure hF_int.aestronglyMeasurable hΦ.aemeasurable).mp hF_int
    have hae_ind : (fun ω : Ω₀ × Ωp × Ωp ↦ (trace₀ ⁻¹' s₀).indicator F (Φ ω)) =ᵐ[P]
        fun ω ↦ (Prod.fst ⁻¹' (Φ₀ ⁻¹' s₀)).indicator
          (fun ω' : Ω₀ × Ωp × Ωp ↦ F (liftPos (Φ₀ ω'.1, ω'.2.1))) ω := by
      filter_upwards [htrace₀_ae] with ⟨ω₀, ωp, ωm⟩ hω
      by_cases hmem : Φ₀ ω₀ ∈ s₀
      · have h1 : Φ (ω₀, ωp, ωm) ∈ trace₀ ⁻¹' s₀ := by
          change trace₀ (Φ (ω₀, ωp, ωm)) ∈ s₀
          rwa [hω]
        have h2 : (ω₀, ωp, ωm) ∈ Prod.fst ⁻¹' (Φ₀ ⁻¹' s₀) := hmem
        rw [Set.indicator_of_mem h1, Set.indicator_of_mem h2, hPos_local F hFm ω₀ ωp ωm]
      · have h1 : Φ (ω₀, ωp, ωm) ∉ trace₀ ⁻¹' s₀ := by
          change trace₀ (Φ (ω₀, ωp, ωm)) ∉ s₀
          rwa [hω]
        have h2 : (ω₀, ωp, ωm) ∉ Prod.fst ⁻¹' (Φ₀ ⁻¹' s₀) := hmem
        rw [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
    rw [integral_congr_ae hae_ind]
    have hint_rhs : Integrable (fun ω : Ω₀ × Ωp × Ωp ↦
        (Prod.fst ⁻¹' (Φ₀ ⁻¹' s₀)).indicator
          (fun ω' : Ω₀ × Ωp × Ωp ↦ F (liftPos (Φ₀ ω'.1, ω'.2.1))) ω) P := by
      refine (hFP_int.indicator (hΦ (htraceX hs₀))).congr ?_
      filter_upwards [hae_ind] with ω hω
      exact hω
    rw [integral_prod _ hint_rhs]
    have hinner : ∀ ω₀ : Ω₀,
        ∫ q : Ωp × Ωp,
          (Prod.fst ⁻¹' (Φ₀ ⁻¹' s₀)).indicator
            (fun ω' : Ω₀ × Ωp × Ωp ↦ F (liftPos (Φ₀ ω'.1, ω'.2.1))) (ω₀, q) ∂(Pp.prod Pp) =
          (Φ₀ ⁻¹' s₀).indicator (fun ω₀' ↦ planeProj Pp liftPos F (Φ₀ ω₀')) ω₀ := fun ω₀ ↦ by
      by_cases hω₀ : Φ₀ ω₀ ∈ s₀
      · have h1 : ∀ q : Ωp × Ωp, (ω₀, q) ∈ Prod.fst ⁻¹' (Φ₀ ⁻¹' s₀) := fun _ ↦ hω₀
        have h2 : ω₀ ∈ Φ₀ ⁻¹' s₀ := hω₀
        simp_rw [Set.indicator_of_mem (h1 _), Set.indicator_of_mem h2]
        rw [integral_fun_fst (fun ωp ↦ F (liftPos (Φ₀ ω₀, ωp)))]
        simp [planeProj]
      · have h1 : ∀ q : Ωp × Ωp, (ω₀, q) ∉ Prod.fst ⁻¹' (Φ₀ ⁻¹' s₀) := fun _ ↦ hω₀
        have h2 : ω₀ ∉ Φ₀ ⁻¹' s₀ := hω₀
        simp_rw [Set.indicator_of_notMem (h1 _), Set.indicator_of_notMem h2]
        simp
    simp_rw [hinner]
    have hind0 : (Φ₀ ⁻¹' s₀).indicator (fun ω₀ ↦ planeProj Pp liftPos F (Φ₀ ω₀)) =
        (s₀.indicator (planeProj Pp liftPos F)) ∘ Φ₀ := by
      funext ω₀
      by_cases hω₀ : Φ₀ ω₀ ∈ s₀ <;> simp [Set.indicator, hω₀]
    rw [hind0, ← integral_indicator hs₀,
      integral_map hΦ₀.aemeasurable (hproj_sm.indicator hs₀).aestronglyMeasurable]
    rfl
  rw [hLHS, hRHS]

/-- **Exact `condExp` Reflection Factorization**: for EVERY `mPos`-measurable `F, G ∈ L²(μ)`,
`∫ x, star (F (Θ x)) * G x ∂μ = ∫ x, star (μ[F | mZero trace₀] x) * (μ[G | mZero trace₀] x) ∂μ`. -/
theorem reflection_inner_eq_condExp
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (Θ : X → X) (hΘ : Measurable Θ)
    (hΘ_swap : ∀ ω₀ ωp ωm, Θ (Φ (ω₀, ωp, ωm)) = Φ (ω₀, ωm, ωp))
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (trace₀ : X → X₀) (htrace₀ : Measurable[mPos, mX₀] trace₀)
    (htrace₀_ae : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1)
    (F G : X → ℂ) (hFm : Measurable[mPos] F) (hGm : Measurable[mPos] G)
    (hFLp : MemLp F 2 ((P₀.prod (Pp.prod Pp)).map Φ))
    (hGLp : MemLp G 2 ((P₀.prod (Pp.prod Pp)).map Φ)) :
    ∫ x, star (F (Θ x)) * G x ∂((P₀.prod (Pp.prod Pp)).map Φ) =
      ∫ x, star (((P₀.prod (Pp.prod Pp)).map Φ)[F | mZero trace₀] x) *
        (((P₀.prod (Pp.prod Pp)).map Φ)[G | mZero trace₀] x)
        ∂((P₀.prod (Pp.prod Pp)).map Φ) := by
  let μ := (P₀.prod (Pp.prod Pp)).map Φ
  let ν := P₀.map Φ₀
  have htr_mp : MeasurePreserving trace₀ μ ν :=
    trace₀_measurePreserving P₀ Pp hmPos Φ₀ hΦ₀ Φ hΦ trace₀ htrace₀ htrace₀_ae
  have hFce := condExp_eq_planeProj P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local trace₀ htrace₀ htrace₀_ae F hFm hFLp
  have hGce := condExp_eq_planeProj P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local trace₀ htrace₀ htrace₀_ae G hGm hGLp
  rw [reflection_inner_eq_planeL2 P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ Θ hΘ
    hΘ_swap hPos_local F G hFm hGm hFLp hGLp]
  have hmeas_X0 : Measurable (fun x₀ ↦ star (planeProj Pp liftPos F x₀) * planeProj Pp liftPos G x₀) :=
    (Complex.continuous_conj.measurable.comp
      (planeProj_stronglyMeasurable Pp hmPos liftPos hliftPos F hFm).measurable).mul
      (planeProj_stronglyMeasurable Pp hmPos liftPos hliftPos G hGm).measurable
  have hpull : ∫ x₀, star (planeProj Pp liftPos F x₀) * planeProj Pp liftPos G x₀ ∂ν =
      ∫ x, star (planeProj Pp liftPos F (trace₀ x)) * planeProj Pp liftPos G (trace₀ x) ∂μ := by
    rw [← htr_mp.map_eq, integral_map (htrace₀.mono hmPos le_rfl).aemeasurable hmeas_X0.aestronglyMeasurable]
  rw [hpull]
  refine integral_congr_ae ?_
  filter_upwards [hFce, hGce] with x hxF hxG
  rw [hxF, hxG]
  rfl

/-- **Exact Right Inverse / Surjectivity on `L²(ν)`**: for EVERY measurable `H : X₀ → ℂ` with
`MemLp H 2 ν`, `F := H ∘ trace₀` is `mPos`-measurable, lies in `L²(μ)`, and satisfies
`planeProj Pp liftPos F =ᵐ[ν] H`. -/
theorem planeProj_comp_trace₀_ae
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (trace₀ : X → X₀) (htrace₀ : Measurable[mPos, mX₀] trace₀)
    (htrace₀_ae : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1)
    (H : X₀ → ℂ) (hHm : Measurable H) (hHLp : MemLp H 2 (P₀.map Φ₀)) :
    Measurable[mPos] (H ∘ trace₀) ∧
      MemLp (H ∘ trace₀) 2 ((P₀.prod (Pp.prod Pp)).map Φ) ∧
      planeProj Pp liftPos (H ∘ trace₀) =ᵐ[P₀.map Φ₀] H := by
  let P := P₀.prod (Pp.prod Pp)
  let μ := P.map Φ
  let ν := P₀.map Φ₀
  have hFm : Measurable[mPos] (H ∘ trace₀) := hHm.comp htrace₀
  have htr_mp : MeasurePreserving trace₀ μ ν :=
    trace₀_measurePreserving P₀ Pp hmPos Φ₀ hΦ₀ Φ hΦ trace₀ htrace₀ htrace₀_ae
  have hFLp : MemLp (H ∘ trace₀) 2 μ := hHLp.comp_measurePreserving htr_mp
  refine ⟨hFm, hFLp, ?_⟩
  have hP_eq : ∀ᵐ ω ∂P, H (trace₀ (liftPos (Φ₀ ω.1, ω.2.1))) = H (Φ₀ ω.1) := by
    filter_upwards [htrace₀_ae] with ⟨ω₀, ωp, ωm⟩ hω
    have hloc := hPos_local (H ∘ trace₀) hFm ω₀ ωp ωm
    simp only [Function.comp_apply] at hloc
    rw [← hloc, hω]
  have hP0P_eq : ∀ᵐ q ∂(P₀.prod Pp), H (trace₀ (liftPos (Φ₀ q.1, q.2))) = H (Φ₀ q.1) := by
    let proj01 : Ω₀ × Ωp × Ωp → Ω₀ × Ωp := fun ω ↦ (ω.1, ω.2.1)
    have hproj01 : Measurable proj01 :=
      measurable_fst.prodMk (measurable_fst.comp measurable_snd)
    have hmap : P.map proj01 = P₀.prod Pp := by
      have h1 : proj01 = Prod.map id Prod.fst := rfl
      rw [h1, ← Measure.map_prod_map P₀ (Pp.prod Pp) measurable_id measurable_fst,
        Measure.map_id, Measure.map_fst_prod]
      simp only [measure_univ, one_smul]
    have hset : MeasurableSet {q : Ω₀ × Ωp | H (trace₀ (liftPos (Φ₀ q.1, q.2))) = H (Φ₀ q.1)} :=
      measurableSet_eq_fun
        (hHm.comp ((htrace₀.mono hmPos le_rfl).comp
          (hliftPos.comp ((hΦ₀.comp measurable_fst).prodMk measurable_snd))))
        (hHm.comp (hΦ₀.comp measurable_fst))
    rw [← hmap, ae_map_iff hproj01.aemeasurable hset]
    exact hP_eq
  have hνP_eq : ∀ᵐ p ∂(ν.prod Pp), H (trace₀ (liftPos p)) = H p.1 := by
    have hset : MeasurableSet {p : X₀ × Ωp | H (trace₀ (liftPos p)) = H p.1} :=
      measurableSet_eq_fun
        (hHm.comp ((htrace₀.mono hmPos le_rfl).comp hliftPos))
        (hHm.comp measurable_fst)
    rw [← map_prod_Phi0_id P₀ Pp Φ₀ hΦ₀,
      ae_map_iff (hΦ₀.prodMap measurable_id).aemeasurable hset]
    exact hP0P_eq
  filter_upwards [Measure.ae_ae_of_ae_prod hνP_eq] with x₀ hx₀
  simp only [planeProj, Function.comp_apply]
  rw [integral_congr_ae hx₀, integral_const]
  simp

/-! ### `L²` Subspace `posSubspace` and Surjective OS Contraction `osPlaneMap` -/

/-- The subspace of `Lp ℂ 2 μ` consisting of elements that are `AEStronglyMeasurable` with
respect to the positive-half-space `σ`-algebra `mPos`. -/
def posSubspace (μ : Measure X) : Submodule ℂ (Lp ℂ 2 μ) where
  carrier := {F : Lp ℂ 2 μ | AEStronglyMeasurable[mPos] F μ}
  zero_mem' := by
    refine (stronglyMeasurable_const (b := (0 : ℂ))).aestronglyMeasurable.congr ?_
    exact (Lp.coeFn_zero ℂ 2 μ).symm
  add_mem' {F G} hF hG := (hF.add hG).congr (Lp.coeFn_add F G).symm
  smul_mem' c {F} hF := (hF.const_smul c).congr (Lp.coeFn_smul c F).symm

/-- Raw `osPlaneMap` function on `posSubspace (mPos := mPos) μ`, projecting each `mPos`-measurable
`L²(μ)` class onto `Lp ℂ 2 ν` via `planeProj`. -/
noncomputable def osPlaneMapFun
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F : posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ)) :
    Lp ℂ 2 (P₀.map Φ₀) :=
  let f := F.property.mk (F.1 : X → ℂ)
  have hfm : Measurable[mPos] f := F.property.stronglyMeasurable_mk.measurable
  have hfLp : MemLp f 2 ((P₀.prod (Pp.prod Pp)).map Φ) :=
    (Lp.memLp F.1).ae_eq F.property.ae_eq_mk
  (planeProj_memLp_and_norm_sq_le P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local f hfm hfLp).1.toLp (planeProj Pp liftPos f)

theorem osPlaneMapFun_coe_ae
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F : posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ))
    (f : X → ℂ) (hfm : Measurable[mPos] f)
    (hf : (F.1 : X → ℂ) =ᵐ[(P₀.prod (Pp.prod Pp)).map Φ] f) :
    (osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F : X₀ → ℂ)
      =ᵐ[P₀.map Φ₀] planeProj Pp liftPos f := by
  let f₀ := F.property.mk (F.1 : X → ℂ)
  have hf₀m : Measurable[mPos] f₀ := F.property.stronglyMeasurable_mk.measurable
  have hf₀Lp : MemLp f₀ 2 ((P₀.prod (Pp.prod Pp)).map Φ) :=
    (Lp.memLp F.1).ae_eq F.property.ae_eq_mk
  have htoLp := (planeProj_memLp_and_norm_sq_le P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local f₀ hf₀m hf₀Lp).1.coeFn_toLp
  refine htoLp.trans ?_
  exact planeProj_congr_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local hf₀m hfm
    (F.property.ae_eq_mk.symm.trans hf)

/-- The canonical OS contraction map `osPlaneMap : posSubspace (mPos := mPos) μ →L[ℂ] Lp ℂ 2 ν`
mapping `L²(X, mPos, μ)` into `L²(X₀, ν)` with operator norm `≤ 1`. -/
noncomputable def osPlaneMap
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp))) :
    posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ) →L[ℂ] Lp ℂ 2 (P₀.map Φ₀) :=
  let μ := (P₀.prod (Pp.prod Pp)).map Φ
  let ν := P₀.map Φ₀
  let L : posSubspace (mPos := mPos) μ →ₗ[ℂ] Lp ℂ 2 ν :=
    { toFun := osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local
      map_add' := fun F G ↦ by
        apply Lp.ext
        let f := F.property.mk (F.1 : X → ℂ)
        let g := G.property.mk (G.1 : X → ℂ)
        have hfm : Measurable[mPos] f := F.property.stronglyMeasurable_mk.measurable
        have hgm : Measurable[mPos] g := G.property.stronglyMeasurable_mk.measurable
        have hfLp : MemLp f 2 μ := (Lp.memLp F.1).ae_eq F.property.ae_eq_mk
        have hgLp : MemLp g 2 μ := (Lp.memLp G.1).ae_eq G.property.ae_eq_mk
        have hfg_ae : ((F + G).1 : X → ℂ) =ᵐ[μ] fun x ↦ f x + g x :=
          (Lp.coeFn_add F.1 G.1).trans (F.property.ae_eq_mk.add G.property.ae_eq_mk)
        have hLHS := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
          hPos_local (F + G) (fun x ↦ f x + g x) (hfm.add hgm) hfg_ae
        have hF := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
          hPos_local F f hfm F.property.ae_eq_mk
        have hG := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
          hPos_local G g hgm G.property.ae_eq_mk
        have hf_int : Integrable (fun p : X₀ × Ωp ↦ f (liftPos p)) (ν.prod Pp) :=
          (memLp_comp_liftPos P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local f hfm hfLp).integrable
            one_le_two
        have hg_int : Integrable (fun p : X₀ × Ωp ↦ g (liftPos p)) (ν.prod Pp) :=
          (memLp_comp_liftPos P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local g hgm hgLp).integrable
            one_le_two
        refine hLHS.trans ?_
        filter_upwards [hf_int.prod_right_ae, hg_int.prod_right_ae, hF, hG,
          Lp.coeFn_add (osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F)
            (osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local G)]
          with x₀ hfx₀ hgx₀ hFx₀ hGx₀ hadd
        rw [hadd, Pi.add_apply, hFx₀, hGx₀]
        exact integral_add hfx₀ hgx₀
      map_smul' := fun c F ↦ by
        apply Lp.ext
        let f := F.property.mk (F.1 : X → ℂ)
        have hfm : Measurable[mPos] f := F.property.stronglyMeasurable_mk.measurable
        have hcf_ae : ((c • F).1 : X → ℂ) =ᵐ[μ] fun x ↦ c • f x :=
          (Lp.coeFn_smul c F.1).trans (F.property.ae_eq_mk.fun_comp (c • ·))
        have hLHS := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
          hPos_local (c • F) (fun x ↦ c • f x) (hfm.const_smul c) hcf_ae
        have hF := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
          hPos_local F f hfm F.property.ae_eq_mk
        refine hLHS.trans ?_
        filter_upwards [hF,
          Lp.coeFn_smul c (osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F)]
          with x₀ hFx₀ hsmul
        rw [RingHom.id_apply, hsmul, Pi.smul_apply, hFx₀]
        exact integral_smul c (fun ωp ↦ f (liftPos (x₀, ωp))) }
  L.mkContinuous 1 fun F ↦ by
    rw [one_mul]
    let f := F.property.mk (F.1 : X → ℂ)
    have hfm : Measurable[mPos] f := F.property.stronglyMeasurable_mk.measurable
    have hfLp : MemLp f 2 μ := (Lp.memLp F.1).ae_eq F.property.ae_eq_mk
    have hle := (planeProj_memLp_and_norm_sq_le P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
      hPos_local f hfm hfLp).2
    have hLnorm : ‖L F‖ ^ 2 = ∫ x₀, ‖planeProj Pp liftPos f x₀‖ ^ 2 ∂ν := by
      have h1 : ‖L F‖ ^ 2 = (inner ℂ (L F) (L F)).re := by
        rw [inner_self_eq_norm_sq_to_K]; norm_cast
      rw [h1, L2.inner_def]
      have hcoe := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
        hPos_local F f hfm F.property.ae_eq_mk
      have hre : ∫ x₀, inner ℂ ((L F : Lp ℂ 2 ν) x₀) ((L F : Lp ℂ 2 ν) x₀) ∂ν =
          ∫ x₀, ((‖planeProj Pp liftPos f x₀‖ ^ 2 : ℝ) : ℂ) ∂ν := by
        refine integral_congr_ae ?_
        filter_upwards [hcoe] with x₀ hx₀
        change inner ℂ ((osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F : X₀ → ℂ) x₀)
            ((osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F : X₀ → ℂ) x₀) = _
        rw [hx₀, inner_self_eq_norm_sq_to_K]
        norm_cast
      rw [hre, integral_complex_ofReal, Complex.ofReal_re]
    have hFnorm : ‖F‖ ^ 2 = ∫ x, ‖f x‖ ^ 2 ∂μ := by
      have h1 : ‖F‖ ^ 2 = (inner ℂ F.1 F.1).re := by
        change ‖F.1‖ ^ 2 = _
        rw [inner_self_eq_norm_sq_to_K]; norm_cast
      rw [h1, L2.inner_def]
      have hre : ∫ x, inner ℂ ((F.1 : Lp ℂ 2 μ) x) ((F.1 : Lp ℂ 2 μ) x) ∂μ =
          ∫ x, ((‖f x‖ ^ 2 : ℝ) : ℂ) ∂μ := by
        refine integral_congr_ae ?_
        filter_upwards [F.property.ae_eq_mk] with x hx
        rw [hx, inner_self_eq_norm_sq_to_K]
        norm_cast
      rw [hre, integral_complex_ofReal, Complex.ofReal_re]
    have hsq : ‖L F‖ ^ 2 ≤ ‖F‖ ^ 2 := by rw [hLnorm, hFnorm]; exact hle
    nlinarith [norm_nonneg (L F), norm_nonneg F]

/-- `osPlaneMap` pulls back the Hilbert inner product of `Lp ℂ 2 ν` to the Euclidean
reflection inner product for ALL `F, G ∈ posSubspace (mPos := mPos) μ`. -/
theorem osPlaneMap_reflection_inner
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (Θ : X → X) (hΘ : Measurable Θ)
    (hΘ_swap : ∀ ω₀ ωp ωm, Θ (Φ (ω₀, ωp, ωm)) = Φ (ω₀, ωm, ωp))
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (F G : posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ)) :
    ∫ x, star ((F.1 : Lp ℂ 2 ((P₀.prod (Pp.prod Pp)).map Φ)) (Θ x)) *
        (G.1 : Lp ℂ 2 ((P₀.prod (Pp.prod Pp)).map Φ)) x
        ∂((P₀.prod (Pp.prod Pp)).map Φ) =
      inner ℂ
        (osPlaneMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F)
        (osPlaneMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local G) := by
  let μ := (P₀.prod (Pp.prod Pp)).map Φ
  let ν := P₀.map Φ₀
  let f := F.property.mk (F.1 : X → ℂ)
  let g := G.property.mk (G.1 : X → ℂ)
  have hfm : Measurable[mPos] f := F.property.stronglyMeasurable_mk.measurable
  have hgm : Measurable[mPos] g := G.property.stronglyMeasurable_mk.measurable
  have hfLp : MemLp f 2 μ := (Lp.memLp F.1).ae_eq F.property.ae_eq_mk
  have hgLp : MemLp g 2 μ := (Lp.memLp G.1).ae_eq G.property.ae_eq_mk
  have hΘmp : MeasurePreserving Θ μ μ :=
    reflection_measurePreserving P₀ Pp Φ hΦ Θ hΘ hΘ_swap
  have hFΘ_ae : (fun x ↦ (F.1 : X → ℂ) (Θ x)) =ᵐ[μ] fun x ↦ f (Θ x) :=
    hΘmp.quasiMeasurePreserving.ae_eq_comp F.property.ae_eq_mk
  have hLHS : ∫ x, star ((F.1 : X → ℂ) (Θ x)) * (G.1 : X → ℂ) x ∂μ =
      ∫ x, star (f (Θ x)) * g x ∂μ := by
    refine integral_congr_ae ?_
    filter_upwards [hFΘ_ae, G.property.ae_eq_mk] with x hxF hxG
    rw [hxF, hxG]
  rw [hLHS, reflection_inner_eq_planeL2 P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ Θ hΘ
    hΘ_swap hPos_local f g hfm hgm hfLp hgLp, L2.inner_def]
  have hFcoe := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local F f hfm F.property.ae_eq_mk
  have hGcoe := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local G g hgm G.property.ae_eq_mk
  refine integral_congr_ae ?_
  filter_upwards [hFcoe, hGcoe] with x₀ hxF hxG
  change star (planeProj Pp liftPos f x₀) * planeProj Pp liftPos g x₀ =
    inner ℂ ((osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F : X₀ → ℂ) x₀)
      ((osPlaneMapFun P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local G : X₀ → ℂ) x₀)
  rw [hxF, hxG, RCLike.inner_apply']
  rfl

/-- `osPlaneMap` agrees a.e. with Mathlib's `condExp` along `trace₀` on all of `posSubspace`. -/
theorem osPlaneMap_eq_condExp
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (trace₀ : X → X₀) (htrace₀ : Measurable[mPos, mX₀] trace₀)
    (htrace₀_ae : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1)
    (F : posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ)) :
    ((P₀.prod (Pp.prod Pp)).map Φ)[(F.1 : X → ℂ) | mZero trace₀]
      =ᵐ[(P₀.prod (Pp.prod Pp)).map Φ]
      (osPlaneMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local F : X₀ → ℂ) ∘ trace₀ := by
  let μ := (P₀.prod (Pp.prod Pp)).map Φ
  let ν := P₀.map Φ₀
  let f := F.property.mk (F.1 : X → ℂ)
  have hfm : Measurable[mPos] f := F.property.stronglyMeasurable_mk.measurable
  have hfLp : MemLp f 2 μ := (Lp.memLp F.1).ae_eq F.property.ae_eq_mk
  have htr_mp : MeasurePreserving trace₀ μ ν :=
    trace₀_measurePreserving P₀ Pp hmPos Φ₀ hΦ₀ Φ hΦ trace₀ htrace₀ htrace₀_ae
  have h1 : μ[(F.1 : X → ℂ) | mZero trace₀] =ᵐ[μ] μ[f | mZero trace₀] :=
    condExp_congr_ae F.property.ae_eq_mk
  have h2 := condExp_eq_planeProj P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local trace₀ htrace₀ htrace₀_ae f hfm hfLp
  have h3 := osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ
    hPos_local F f hfm F.property.ae_eq_mk
  exact h1.trans (h2.trans (htr_mp.quasiMeasurePreserving.ae_eq_comp h3.symm))

/-- **Surjectivity of `osPlaneMap`** onto the entire time-zero Hilbert space `Lp ℂ 2 ν`. -/
theorem osPlaneMap_surjective
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (trace₀ : X → X₀) (htrace₀ : Measurable[mPos, mX₀] trace₀)
    (htrace₀_ae : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1) :
    Function.Surjective
      (osPlaneMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local) := by
  intro h
  have hHm : Measurable (h : X₀ → ℂ) := (Lp.stronglyMeasurable h).measurable
  obtain ⟨hFm, hFLp, hproj⟩ := planeProj_comp_trace₀_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos
    Φ hΦ hPos_local trace₀ htrace₀ htrace₀_ae (h : X₀ → ℂ) hHm (Lp.memLp h)
  have hmem : hFLp.toLp ((h : X₀ → ℂ) ∘ trace₀) ∈
      posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ) :=
    hFm.stronglyMeasurable.aestronglyMeasurable.congr hFLp.coeFn_toLp.symm
  refine ⟨⟨hFLp.toLp ((h : X₀ → ℂ) ∘ trace₀), hmem⟩, ?_⟩
  apply Lp.ext
  exact (osPlaneMapFun_coe_ae P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local
    ⟨hFLp.toLp ((h : X₀ → ℂ) ∘ trace₀), hmem⟩ ((h : X₀ → ℂ) ∘ trace₀) hFm hFLp.coeFn_toLp).trans hproj

/-! ### Countable Thin-Slab `trace₀` Builder Lemmas -/

/-- A nonnegative real family is summable iff its `ENNReal.ofReal` `tsum` is finite. -/
private theorem summable_iff_tsum_ofReal_ne_top {ι : Type*} {f : ι → ℝ} (hf : ∀ i, 0 ≤ f i) :
    Summable f ↔ (∑' i, ENNReal.ofReal (f i)) ≠ ∞ := by
  constructor
  · intro h
    rw [← ENNReal.ofReal_tsum_of_nonneg hf h]
    exact ENNReal.ofReal_ne_top
  · intro htop
    refine summable_of_sum_le hf (c := (∑' i, ENNReal.ofReal (f i)).toReal) fun s ↦ ?_
    have hle : ENNReal.ofReal (∑ i ∈ s, f i) ≤ ∑' i, ENNReal.ofReal (f i) := by
      rw [ENNReal.ofReal_sum_of_nonneg (fun i _ ↦ hf i)]
      exact ENNReal.sum_le_tsum s
    exact (ENNReal.ofReal_le_iff_le_toReal htop).mp hle

/-- Borel–Cantelli subsequence extraction: if `g k → target` in `L²(P)`, then there is a
subsequence `φ : ℕ → ℕ` along which `g (φ m) ω → target ω` for `P`-a.e. `ω`. -/
theorem ae_tendsto_subseq_of_tendsto_L2
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (g : ℕ → Ω → ℝ) (target : Ω → ℝ)
    (hg : ∀ k, Measurable (g k)) (htarget : Measurable target)
    (hint : ∀ k, Integrable (fun ω ↦ (g k ω - target ω) ^ 2) P)
    (htend : Tendsto (fun k ↦ ∫ ω, (g k ω - target ω) ^ 2 ∂P) atTop (nhds 0)) :
    ∃ φ : ℕ → ℕ, ∀ᵐ ω ∂P, Tendsto (fun m ↦ g (φ m) ω) atTop (nhds (target ω)) := by
  have hex : ∀ m : ℕ, ∃ k : ℕ, ∫ ω, (g k ω - target ω) ^ 2 ∂P < (1 / 2 : ℝ) ^ m := fun m ↦ by
    have hpos : (0 : ℝ) < (1 / 2 : ℝ) ^ m := by positivity
    have hev := (Metric.tendsto_atTop.mp htend) ((1 / 2 : ℝ) ^ m) hpos
    obtain ⟨N, hN⟩ := hev
    refine ⟨N, ?_⟩
    have hdist := hN N le_rfl
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (integral_nonneg fun _ ↦ sq_nonneg _)] at hdist
    exact hdist
  choose φ hφ using hex
  refine ⟨φ, ?_⟩
  have hmeas_sq : ∀ m : ℕ, Measurable (fun ω ↦ ENNReal.ofReal ((g (φ m) ω - target ω) ^ 2)) :=
    fun m ↦ ENNReal.measurable_ofReal.comp (((hg (φ m)).sub htarget).pow_const 2)
  have hsum_lt : ∫⁻ ω, (∑' m, ENNReal.ofReal ((g (φ m) ω - target ω) ^ 2)) ∂P < ∞ := by
    rw [lintegral_tsum (fun m ↦ (hmeas_sq m).aemeasurable)]
    have hterm : ∀ m : ℕ, ∫⁻ ω, ENNReal.ofReal ((g (φ m) ω - target ω) ^ 2) ∂P ≤
        ENNReal.ofReal ((1 / 2 : ℝ) ^ m) := fun m ↦ by
      rw [← ofReal_integral_eq_lintegral_ofReal (hint (φ m)) (ae_of_all _ fun _ ↦ sq_nonneg _)]
      exact ENNReal.ofReal_le_ofReal (hφ m).le
    calc
      ∑' m, ∫⁻ ω, ENNReal.ofReal ((g (φ m) ω - target ω) ^ 2) ∂P
          ≤ ∑' m, ENNReal.ofReal ((1 / 2 : ℝ) ^ m) := ENNReal.tsum_le_tsum hterm
      _ = ENNReal.ofReal (∑' m : ℕ, (1 / 2 : ℝ) ^ m) := by
          rw [ENNReal.ofReal_tsum_of_nonneg (fun _ ↦ by positivity)
            (summable_geometric_of_lt_one (by norm_num) (by norm_num))]
      _ < ∞ := ENNReal.ofReal_lt_top
  filter_upwards [ae_lt_top (Measurable.tsum hmeas_sq) hsum_lt.ne] with ω hω
  have hsumm : Summable (fun m : ℕ ↦ (g (φ m) ω - target ω) ^ 2) :=
    (summable_iff_tsum_ofReal_ne_top (fun _ ↦ sq_nonneg _)).mpr hω.ne
  have hsq0 : Tendsto (fun m ↦ (g (φ m) ω - target ω) ^ 2) atTop (nhds 0) :=
    hsumm.tendsto_atTop_zero
  have habs0 : Tendsto (fun m ↦ ‖g (φ m) ω - target ω‖) atTop (nhds 0) := by
    have hsqrt := (Real.continuous_sqrt.tendsto 0).comp hsq0
    simpa only [Function.comp_def, Real.sqrt_sq_eq_abs, Real.sqrt_zero, ← Real.norm_eq_abs]
      using hsqrt
  have hsub0 : Tendsto (fun m ↦ g (φ m) ω - target ω) atTop (nhds 0) :=
    tendsto_zero_iff_norm_tendsto_zero.mpr habs0
  simpa using hsub0.add_const (target ω)

/-- Measurable real limit via `EReal.toReal ∘ Filter.limsup`: always `mPos`-measurable, and
equals `y` whenever `g k x → y`. -/
noncomputable def measurableLimReal (g : ℕ → X → ℝ) (x : X) : ℝ :=
  (Filter.limsup (fun k ↦ (g k x : EReal)) atTop).toReal

omit mX in
theorem measurable_measurableLimReal {g : ℕ → X → ℝ}
    (hg : ∀ k, Measurable[mPos] (g k)) :
    Measurable[mPos] (measurableLimReal g) := by
  let _ : MeasurableSpace X := mPos
  have hcoe : ∀ k, Measurable (fun x ↦ (g k x : EReal)) :=
    fun k ↦ measurable_coe_real_ereal.comp (hg k)
  exact measurable_ereal_toReal.comp (Measurable.limsup hcoe)

omit mX in
theorem measurableLimReal_eq_of_tendsto {g : ℕ → X → ℝ} {x : X} {y : ℝ}
    (h : Tendsto (fun k ↦ g k x) atTop (nhds y)) :
    measurableLimReal g x = y := by
  unfold measurableLimReal
  have hE : Tendsto (fun k ↦ (g k x : EReal)) atTop (nhds (y : EReal)) :=
    (continuous_coe_real_ereal.tendsto y).comp h
  rw [hE.limsup_eq, EReal.toReal_coe]

omit mX in
/-- Construct a real-valued `tsum` of a countable family as an `mPos`-measurable function via
positive and negative `ENNReal` parts. -/
private theorem measurable_tsum_of_countable {ι : Type*} [Countable ι]
    {f : ι → X → ℝ}
    (hf : ∀ i, Measurable[mPos] (f i))
    {S : Set X} [DecidablePred (· ∈ S)] (hS : MeasurableSet[mPos] S)
    (hsum : ∀ x ∈ S, Summable (fun i ↦ ‖f i x‖)) :
    Measurable[mPos] (fun x ↦ if x ∈ S then ∑' i, f i x else 0) := by
  let _ : MeasurableSpace X := mPos
  let posPart : X → ℝ := fun x ↦ (∑' i, ENNReal.ofReal (max (f i x) 0)).toReal
  let negPart : X → ℝ := fun x ↦ (∑' i, ENNReal.ofReal (max (-f i x) 0)).toReal
  have hpos_m : Measurable posPart :=
    ENNReal.measurable_toReal.comp
      (Measurable.tsum fun i ↦ ENNReal.measurable_ofReal.comp ((hf i).max measurable_const))
  have hneg_m : Measurable negPart :=
    ENNReal.measurable_toReal.comp
      (Measurable.tsum fun i ↦ ENNReal.measurable_ofReal.comp (((hf i).neg).max measurable_const))
  have heq : (fun x ↦ if x ∈ S then ∑' i, f i x else 0) =
      fun x ↦ if x ∈ S then posPart x - negPart x else 0 := by
    funext x
    by_cases hx : x ∈ S
    · simp only [hx, ↓reduceIte, posPart, negPart]
      have hsp : Summable (fun i ↦ max (f i x) 0) :=
        Summable.of_nonneg_of_le (fun _ ↦ le_max_right _ _)
          (fun i ↦ max_le (le_abs_self _) (abs_nonneg _)) (hsum x hx)
      have hsn : Summable (fun i ↦ max (-f i x) 0) :=
        Summable.of_nonneg_of_le (fun _ ↦ le_max_right _ _)
          (fun i ↦ max_le (neg_le_abs _) (abs_nonneg _)) (hsum x hx)
      rw [← ENNReal.ofReal_tsum_of_nonneg (fun _ ↦ le_max_right _ _) hsp,
        ← ENNReal.ofReal_tsum_of_nonneg (fun _ ↦ le_max_right _ _) hsn,
        ENNReal.toReal_ofReal (tsum_nonneg fun _ ↦ le_max_right _ _),
        ENNReal.toReal_ofReal (tsum_nonneg fun _ ↦ le_max_right _ _),
        ← hsp.tsum_sub hsn]
      congr 1
      funext i
      rcases le_total (f i x) 0 with hle | hge
      · rw [max_eq_right hle, max_eq_left (neg_nonneg.mpr hle)]; ring
      · rw [max_eq_left hge, max_eq_right (neg_nonpos.mpr hge)]; ring
    · simp [hx]
  rw [heq]
  exact Measurable.ite hS (hpos_m.sub hneg_m) measurable_const

/-- Continuity of a linear functional on `𝓢(E₀, ℝ)` bounded by a finite supremum of Schwartz
seminorms. -/
private theorem schwartz_clm_of_seminorm_bound
    {E₀ : Type*} [NormedAddCommGroup E₀] [NormedSpace ℝ E₀]
    (L : 𝓢(E₀, ℝ) →ₗ[ℝ] ℝ) (C : ℝ) (hC : 0 ≤ C) (s : Finset (ℕ × ℕ))
    (hbound : ∀ h : 𝓢(E₀, ℝ), |L h| ≤ C * (s.sup (fun p ↦ SchwartzMap.seminorm ℝ p.1 p.2)) h) :
    Continuous L := by
  have hws := schwartz_withSeminorms ℝ E₀ ℝ
  have hbn : Seminorm.IsBounded (schwartzSeminormFamily ℝ E₀ ℝ) (fun _ : Fin 1 ↦ normSeminorm ℝ ℝ) L := by
    intro _
    refine ⟨s, ⟨C, hC⟩, fun h ↦ ?_⟩
    change |L h| ≤ C * (s.sup (fun p ↦ SchwartzMap.seminorm ℝ p.1 p.2)) h
    exact hbound h
  exact WithSeminorms.continuous_of_isBounded hws (norm_withSeminorms ℝ ℝ) L hbn

omit mX in
/-- **Thin-Slab `trace₀` Builder (from a.s. convergent countable approximations)**:
Given a countable frame/basis family `c : ι → (𝓢(E₀, ℝ) →L[ℝ] ℝ)` dominated by a single finite
Schwartz seminorm family `w i * p(h)`, together with `mPos`-measurable approximations
`approx i k : X → ℝ` converging a.s. along `Φ` to `target i ω₀` which reconstruct `Φ₀ ω₀`,
constructs an explicit `mPos`-measurable map `trace₀ : X → (𝓢(E₀, ℝ) →L[ℝ] ℝ)` (into the
cylindrical `σ`-algebra) with `∀ᵐ ω ∂P, trace₀ (Φ ω) = Φ₀ ω.1`. -/
theorem buildTrace0FromCountableApprox
    {E₀ : Type*} [NormedAddCommGroup E₀] [NormedSpace ℝ E₀]
    {ι : Type*} [Countable ι]
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (Φ₀ : Ω₀ → (𝓢(E₀, ℝ) →L[ℝ] ℝ))
    (Φ : Ω₀ × Ωp × Ωp → X)
    (c : ι → (𝓢(E₀, ℝ) →L[ℝ] ℝ))
    (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i)
    (s : Finset (ℕ × ℕ))
    (hc : ∀ i (h : 𝓢(E₀, ℝ)), |c i h| ≤ w i * (s.sup (fun p ↦ SchwartzMap.seminorm ℝ p.1 p.2)) h)
    (approx : ι → ℕ → X → ℝ)
    (happrox_meas : ∀ i k, Measurable[mPos] (approx i k))
    (target : ι → Ω₀ → ℝ)
    (htendsto : ∀ i, ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)),
      Tendsto (fun k ↦ approx i k (Φ ω)) atTop (nhds (target i ω.1)))
    (htarget_sum : ∀ᵐ ω₀ ∂P₀, Summable (fun i ↦ |target i ω₀| * w i))
    (hrecon : ∀ᵐ ω₀ ∂P₀, ∀ h : 𝓢(E₀, ℝ), Φ₀ ω₀ h = ∑' i, target i ω₀ * c i h) :
    ∃ trace₀ : X → (𝓢(E₀, ℝ) →L[ℝ] ℝ),
      Measurable[mPos, ⨆ h : 𝓢(E₀, ℝ),
        MeasurableSpace.comap (fun φ : 𝓢(E₀, ℝ) →L[ℝ] ℝ ↦ φ h) inferInstance] trace₀ ∧
      ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1 := by
  classical
  let a : ι → X → ℝ := fun i ↦ measurableLimReal (approx i)
  have ha_meas : ∀ i, Measurable[mPos] (a i) := fun i ↦
    measurable_measurableLimReal (happrox_meas i)
  let goodSet : Set X := {x | Summable (fun i ↦ |a i x| * w i)}
  have hgood_meas : MeasurableSet[mPos] goodSet := by
    let _ : MeasurableSpace X := mPos
    have hmeas_sum : Measurable (fun x ↦ ∑' i, ENNReal.ofReal (|a i x| * w i)) :=
      Measurable.tsum fun i ↦ ENNReal.measurable_ofReal.comp ((ha_meas i).abs.mul measurable_const)
    have heq : goodSet = (fun x ↦ ∑' i, ENNReal.ofReal (|a i x| * w i)) ⁻¹' {∞}ᶜ := by
      ext x
      simp only [goodSet, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_compl_iff,
        Set.mem_singleton_iff]
      exact summable_iff_tsum_ofReal_ne_top (fun i ↦ mul_nonneg (abs_nonneg _) (hw0 i))
    rw [heq]
    exact hmeas_sum (measurableSet_singleton ∞).compl
  let p : Seminorm ℝ 𝓢(E₀, ℝ) := s.sup (fun q ↦ SchwartzMap.seminorm ℝ q.1 q.2)
  have hterm_le : ∀ (x : X) (h : 𝓢(E₀, ℝ)) (i : ι),
      ‖a i x * c i h‖ ≤ (|a i x| * w i) * p h := fun x h i ↦ by
    rw [Real.norm_eq_abs, abs_mul, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hc i h) (abs_nonneg _)
  have hsumm_norm : ∀ x ∈ goodSet, ∀ h : 𝓢(E₀, ℝ), Summable (fun i ↦ ‖a i x * c i h‖) :=
    fun x hx h ↦ Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) (hterm_le x h) (hx.mul_right (p h))
  let mkCLM : ∀ x : X, x ∈ goodSet → (𝓢(E₀, ℝ) →L[ℝ] ℝ) := fun x hx ↦
    let L : 𝓢(E₀, ℝ) →ₗ[ℝ] ℝ :=
      { toFun := fun h ↦ ∑' i, a i x * c i h
        map_add' := fun h₁ h₂ ↦ by
          have hs₁ := (hsumm_norm x hx h₁).of_norm
          have hs₂ := (hsumm_norm x hx h₂).of_norm
          simp_rw [map_add, mul_add]
          exact hs₁.tsum_add hs₂
        map_smul' := fun r h ↦ by
          simp_rw [map_smul, smul_eq_mul, RingHom.id_apply]
          have hmul : (fun i ↦ a i x * (r * c i h)) = fun i ↦ r * (a i x * c i h) := by
            funext i; ring
          rw [hmul, tsum_mul_left] }
    have hcont : Continuous L := by
      refine schwartz_clm_of_seminorm_bound L (∑' i, |a i x| * w i)
        (tsum_nonneg fun i ↦ mul_nonneg (abs_nonneg _) (hw0 i)) s fun h ↦ ?_
      change |∑' i, a i x * c i h| ≤ (∑' i, |a i x| * w i) * p h
      calc
        |∑' i, a i x * c i h| = ‖∑' i, a i x * c i h‖ := (Real.norm_eq_abs _).symm
        _ ≤ ∑' i, ‖a i x * c i h‖ := norm_tsum_le_tsum_norm (hsumm_norm x hx h)
        _ ≤ ∑' i, (|a i x| * w i) * p h :=
            (hsumm_norm x hx h).tsum_le_tsum (hterm_le x h) (hx.mul_right (p h))
        _ = (∑' i, |a i x| * w i) * p h := tsum_mul_right
    { toLinearMap := L, cont := hcont }
  let trace₀ : X → (𝓢(E₀, ℝ) →L[ℝ] ℝ) := fun x ↦ if hx : x ∈ goodSet then mkCLM x hx else 0
  refine ⟨trace₀, ?_, ?_⟩
  · rw [measurable_iff_comap_le, MeasurableSpace.comap_iSup, iSup_le_iff]
    intro h
    rw [← measurable_iff_comap_le, measurable_comap_iff]
    change Measurable[mPos] (fun x ↦ trace₀ x h)
    have heval : (fun x ↦ trace₀ x h) = fun x ↦ if x ∈ goodSet then ∑' i, a i x * c i h else 0 := by
      funext x
      by_cases hx : x ∈ goodSet <;> simp [trace₀, mkCLM, hx]
    rw [heval]
    exact measurable_tsum_of_countable (fun i ↦ (ha_meas i).mul measurable_const)
      hgood_meas (fun x hx ↦ hsumm_norm x hx h)
  · have hall : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), ∀ i, a i (Φ ω) = target i ω.1 := by
      filter_upwards [ae_all_iff.mpr htendsto] with ω hω i
      exact measurableLimReal_eq_of_tendsto (hω i)
    have hsum_P : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), Summable (fun i ↦ |target i ω.1| * w i) :=
      Measure.QuasiMeasurePreserving.ae Measure.quasiMeasurePreserving_fst htarget_sum
    have hrec_P : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)),
        ∀ h : 𝓢(E₀, ℝ), Φ₀ ω.1 h = ∑' i, target i ω.1 * c i h :=
      Measure.QuasiMeasurePreserving.ae Measure.quasiMeasurePreserving_fst hrecon
    filter_upwards [hall, hsum_P, hrec_P] with ω hωa hωs hωr
    have hgood : Φ ω ∈ goodSet := by
      change Summable (fun i ↦ |a i (Φ ω)| * w i)
      simpa [hωa] using hωs
    ext h
    simp only [trace₀, hgood, ↓reduceDIte, mkCLM, ContinuousLinearMap.coe_mk',
      LinearMap.coe_mk, AddHom.coe_mk, hωa]
    exact (hωr h).symm

/-- **Thin-Slab `trace₀` Builder (directly from `L²` convergence)**:
Combines `ae_tendsto_subseq_of_tendsto_L2` (per frame index `i`) with
`buildTrace0FromCountableApprox`. -/
theorem buildTrace0FromL2Approx
    {E₀ : Type*} [NormedAddCommGroup E₀] [NormedSpace ℝ E₀]
    {ι : Type*} [Countable ι]
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → (𝓢(E₀, ℝ) →L[ℝ] ℝ))
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (c : ι → (𝓢(E₀, ℝ) →L[ℝ] ℝ))
    (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i)
    (s : Finset (ℕ × ℕ))
    (hc : ∀ i (h : 𝓢(E₀, ℝ)), |c i h| ≤ w i * (s.sup (fun p ↦ SchwartzMap.seminorm ℝ p.1 p.2)) h)
    (approx : ι → ℕ → X → ℝ)
    (happrox_meas : ∀ i k, Measurable[mPos] (approx i k))
    (target : ι → Ω₀ → ℝ)
    (htarget_meas : ∀ i, Measurable (target i))
    (hint : ∀ i k, Integrable (fun ω : Ω₀ × Ωp × Ωp ↦ (approx i k (Φ ω) - target i ω.1) ^ 2)
      (P₀.prod (Pp.prod Pp)))
    (hL2 : ∀ i, Tendsto (fun k ↦ ∫ ω : Ω₀ × Ωp × Ωp, (approx i k (Φ ω) - target i ω.1) ^ 2
      ∂(P₀.prod (Pp.prod Pp))) atTop (nhds 0))
    (htarget_sum : ∀ᵐ ω₀ ∂P₀, Summable (fun i ↦ |target i ω₀| * w i))
    (hrecon : ∀ᵐ ω₀ ∂P₀, ∀ h : 𝓢(E₀, ℝ), Φ₀ ω₀ h = ∑' i, target i ω₀ * c i h) :
    ∃ trace₀ : X → (𝓢(E₀, ℝ) →L[ℝ] ℝ),
      Measurable[mPos, ⨆ h : 𝓢(E₀, ℝ),
        MeasurableSpace.comap (fun φ : 𝓢(E₀, ℝ) →L[ℝ] ℝ ↦ φ h) inferInstance] trace₀ ∧
      ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1 := by
  have hsub : ∀ i : ι, ∃ φ : ℕ → ℕ,
      ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)),
        Tendsto (fun m ↦ approx i (φ m) (Φ ω)) atTop (nhds (target i ω.1)) := fun i ↦
    ae_tendsto_subseq_of_tendsto_L2 (P₀.prod (Pp.prod Pp))
      (fun k ω ↦ approx i k (Φ ω)) (fun ω ↦ target i ω.1)
      (fun k ↦ ((happrox_meas i k).mono hmPos le_rfl).comp hΦ)
      ((htarget_meas i).comp measurable_fst)
      (hint i) (hL2 i)
  choose φ hφ using hsub
  exact buildTrace0FromCountableApprox P₀ Pp Φ₀ Φ c w hw0 s hc
    (fun i m ↦ approx i (φ i m)) (fun i m ↦ happrox_meas i (φ i m))
    target hφ htarget_sum hrecon

end NelsonMarkov

/-!
==============================================================================
  PART B: EXACT SURJECTIVE UNITARY EQUIVALENCE `L²(𝓢'(ℝ^{n+1}), ν) ≃ₗᵢ[ℂ] Fock`
==============================================================================
-/

section GramAndSpanHelpers

/-- Total labelled Gram uniqueness: two complete complex Hilbert spaces with dense labelled
families having identical Gram matrices admit a unique label-preserving unitary equivalence. -/
theorem gram_total_unique {ι E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
    (a : ι → E) (b : ι → F)
    (ha : Dense ((Submodule.span ℂ (Set.range a) : Submodule ℂ E) : Set E))
    (hb : Dense ((Submodule.span ℂ (Set.range b) : Submodule ℂ F) : Set F))
    (hg : ∀ i j, inner ℂ (a i) (a j) = inner ℂ (b i) (b j)) :
    ∃! U : E ≃ₗᵢ[ℂ] F, ∀ i, U (a i) = b i := by
  classical
  let A := Finsupp.linearCombination ℂ a
  let B := Finsupp.linearCombination ℂ b
  have da : DenseRange A := by
    change Dense (Set.range A)
    rw [← LinearMap.coe_range, Finsupp.range_linearCombination]
    exact ha
  have db : DenseRange B := by
    change Dense (Set.range B)
    rw [← LinearMap.coe_range, Finsupp.range_linearCombination]
    exact hb
  have hn (c : ι →₀ ℂ) : ‖B c‖ = ‖A c‖ := by
    rw [norm_eq_sqrt_re_inner (𝕜 := ℂ) (B c), norm_eq_sqrt_re_inner (𝕜 := ℂ) (A c)]
    congr 2
    simp only [A, B, Finsupp.linearCombination_apply, Finsupp.sum, sum_inner, inner_sum,
      inner_smul_left, inner_smul_right, hg]
  let U : E ≃ₗᵢ[ℂ] F := (LinearEquiv.refl ℂ (ι →₀ ℂ)).extendOfIsometry A B da db hn
  have hu := (LinearEquiv.refl ℂ (ι →₀ ℂ)).extendOfIsometry_eq A B da db hn
  refine ⟨U, fun i ↦ by simpa [A, B] using hu (Finsupp.single i 1),
    fun V hv ↦ DFunLike.ext _ _ fun x ↦ ?_⟩
  refine da.induction ?_ (isClosed_eq V.continuous U.continuous) x
  rintro _ ⟨c, rfl⟩
  rw [hu]
  simp [A, B, Finsupp.linearCombination_apply, Finsupp.sum, hv]

/-- Scaling every generator of a `ℂ`-span by a nonzero scalar preserves the `ℂ`-span. -/
theorem span_smul_eq_of_ne_zero {ι E : Type*} [AddCommGroup E] [Module ℂ E]
    (v : ι → E) (c : ι → ℂ) (hc : ∀ i, c i ≠ 0) :
    Submodule.span ℂ (Set.range (fun i ↦ c i • v i)) = Submodule.span ℂ (Set.range v) := by
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    exact Submodule.smul_mem _ (c i) (Submodule.subset_span ⟨i, rfl⟩)
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    have hmem : (c i)⁻¹ • (c i • v i) ∈ Submodule.span ℂ (Set.range (fun i ↦ c i • v i)) :=
      Submodule.smul_mem _ (c i)⁻¹ (Submodule.subset_span ⟨i, rfl⟩)
    simpa [smul_smul, inv_mul_cancel₀ (hc i)] using hmem

/-- Multiplying an `ℝ`-linear map `j : R →ₗ[ℝ] E` by `Complex.I` yields an `ℝ`-linear map with
the exact same complex span as `j`. -/
def smulILinearMap {R E : Type*} [AddCommGroup R] [Module ℝ R]
    [AddCommGroup E] [Module ℂ E] [Module ℝ E] [IsScalarTower ℝ ℂ E]
    (j : R →ₗ[ℝ] E) : R →ₗ[ℝ] E where
  toFun a := Complex.I • j a
  map_add' a b := by rw [map_add, smul_add]
  map_smul' r a := by
    rw [map_smul, RingHom.id_apply, ← algebraMap_smul ℂ r, ← algebraMap_smul ℂ r,
      smul_smul, smul_smul, mul_comm]

theorem span_smulILinearMap {R E : Type*} [AddCommGroup R] [Module ℝ R]
    [AddCommGroup E] [Module ℂ E] [Module ℝ E] [IsScalarTower ℝ ℂ E]
    (j : R →ₗ[ℝ] E) :
    Submodule.span ℂ (Set.range (smulILinearMap j)) = Submodule.span ℂ (Set.range j) :=
  span_smul_eq_of_ne_zero j (fun _ ↦ Complex.I) (fun _ ↦ Complex.I_ne_zero)

end GramAndSpanHelpers

/-! ### Weyl Exponential `L²` Vectors & Exact Unitary Equivalence `L²(X₀, ν) ≃ₗᵢ[ℂ] ℋ` -/

section WeylPlaneL2Equiv

variable {X₀ R E₁ : Type*}
  [MeasurableSpace X₀] [AddCommGroup R] [Module ℝ R]
  [MeasurableSpace E₁]

/-- Pointwise Weyl exponential observable `φ ↦ exp (I * eval φ h)`. -/
noncomputable def weylExpFun (eval : X₀ → R →ₗ[ℝ] ℝ) (h : R) (φ : X₀) : ℂ :=
  Complex.exp (Complex.I * (eval φ h : ℂ))

omit [MeasurableSpace X₀] in
theorem weylExpFun_norm (eval : X₀ → R →ₗ[ℝ] ℝ) (h : R) (φ : X₀) :
    ‖weylExpFun eval h φ‖ = 1 := by
  unfold weylExpFun
  rw [mul_comm]
  exact Complex.norm_exp_ofReal_mul_I (eval φ h)

theorem weylExp_memLp (ν : Measure X₀) [IsProbabilityMeasure ν]
    (eval : X₀ → R →ₗ[ℝ] ℝ) (heval : ∀ h : R, Measurable (fun φ : X₀ ↦ eval φ h)) (h : R) :
    MemLp (weylExpFun eval h) 2 ν := by
  have hmeas : Measurable (weylExpFun eval h) :=
    Complex.continuous_exp.measurable.comp
      (measurable_const.mul (Complex.continuous_ofReal.measurable.comp (heval h)))
  exact MemLp.of_bound hmeas.aestronglyMeasurable 1 (ae_of_all _ fun φ ↦ (weylExpFun_norm eval h φ).le)

/-- Weyl exponential element `φ ↦ exp (I * eval φ h)` inside `Lp ℂ 2 ν`. -/
noncomputable def weylExpLp (ν : Measure X₀) [IsProbabilityMeasure ν]
    (eval : X₀ → R →ₗ[ℝ] ℝ) (heval : ∀ h : R, Measurable (fun φ : X₀ ↦ eval φ h)) (h : R) :
    Lp ℂ 2 ν :=
  (weylExp_memLp ν eval heval h).toLp (weylExpFun eval h)

/-- Exact Gram matrix of Weyl exponentials in `Lp ℂ 2 ν` for a centered Gaussian measure with
one-particle map `j : R →ₗ[ℝ] Lp ℂ 2 μ₁` having real inner products. -/
theorem weylExpLp_inner (ν : Measure X₀) [IsProbabilityMeasure ν]
    (μ₁ : Measure E₁)
    (eval : X₀ → R →ₗ[ℝ] ℝ) (heval : ∀ h : R, Measurable (fun φ : X₀ ↦ eval φ h))
    (j : R →ₗ[ℝ] Lp ℂ 2 μ₁)
    (hchar : ∀ h : R, ∫ φ, Complex.exp (Complex.I * (eval φ h : ℂ)) ∂ν =
      Complex.exp (-(1 / 2 : ℂ) * ((‖j h‖ ^ 2 : ℝ) : ℂ)))
    (hreal : ∀ h₁ h₂ : R, (inner ℂ (j h₁) (j h₂)).im = 0)
    (h₁ h₂ : R) :
    inner ℂ (weylExpLp ν eval heval h₁) (weylExpLp ν eval heval h₂) =
      Complex.exp (-(1 / 2 : ℂ) * ((‖j h₁‖ ^ 2 : ℝ) : ℂ) -
        (1 / 2 : ℂ) * ((‖j h₂‖ ^ 2 : ℝ) : ℂ) + inner ℂ (j h₁) (j h₂)) := by
  rw [L2.inner_def]
  have hcongr : ∫ φ, inner ℂ (weylExpLp ν eval heval h₁ φ) (weylExpLp ν eval heval h₂ φ) ∂ν =
      ∫ φ, Complex.exp (Complex.I * (eval φ (h₂ - h₁) : ℂ)) ∂ν := by
    refine integral_congr_ae ?_
    filter_upwards [(weylExp_memLp ν eval heval h₁).coeFn_toLp,
      (weylExp_memLp ν eval heval h₂).coeFn_toLp] with φ hφ₁ hφ₂
    dsimp only [weylExpLp]
    rw [hφ₁, hφ₂, RCLike.inner_apply']
    simp only [weylExpFun, map_sub, Complex.ofReal_sub, ← Complex.exp_conj, ← Complex.exp_add]
    congr 1
    simp only [map_mul, Complex.conj_I, Complex.conj_ofReal]
    ring
  rw [hcongr, hchar (h₂ - h₁)]
  congr 1
  have hnorm_sub : ((‖j (h₂ - h₁)‖ ^ 2 : ℝ) : ℂ) =
      ((‖j h₁‖ ^ 2 : ℝ) : ℂ) + ((‖j h₂‖ ^ 2 : ℝ) : ℂ) - 2 * inner ℂ (j h₁) (j h₂) := by
    have h1 : ‖j h₂ - j h₁‖ ^ 2 =
        ‖j h₂‖ ^ 2 - 2 * (inner ℂ (j h₂) (j h₁)).re + ‖j h₁‖ ^ 2 := by
      simpa only [RCLike.re_to_complex] using norm_sub_sq (𝕜 := ℂ) (j h₂) (j h₁)
    have hre_symm : (inner ℂ (j h₂) (j h₁)).re = (inner ℂ (j h₁) (j h₂)).re := by
      rw [← inner_conj_symm, Complex.conj_re]
    have hin : ((inner ℂ (j h₁) (j h₂)).re : ℂ) = inner ℂ (j h₁) (j h₂) := by
      apply Complex.ext
      · simp
      · simp [hreal h₁ h₂]
    rw [map_sub, h1, hre_symm]
    push_cast
    rw [hin]
    ring
  rw [hnorm_sub]
  ring

/-- **Abstract Surjective Unitary Equivalence (`planeL2ToFock_unique`)**:
For ANY complete complex Hilbert space `ℋ` with a coherent map `coh : Lp ℂ 2 μ₁ → ℋ`
satisfying the exponential Gram identity and real-label totality (directly instantiated by
Paper 1's `momentumFock volume` and `coherentVec volume`), there exists a UNIQUE surjective
linear isometry `U : Lp ℂ 2 ν ≃ₗᵢ[ℂ] ℋ` sending each Weyl exponential `weylExpLp ν h` to
`exp (-(1/2) ‖j h‖²) • coh (I • j h)`. -/
theorem planeL2ToFock_unique
    {ℋ : Type*} [NormedAddCommGroup ℋ] [InnerProductSpace ℂ ℋ] [CompleteSpace ℋ]
    (ν : Measure X₀) [IsProbabilityMeasure ν]
    (μ₁ : Measure E₁)
    (eval : X₀ → R →ₗ[ℝ] ℝ) (heval : ∀ h : R, Measurable (fun φ : X₀ ↦ eval φ h))
    (j : R →ₗ[ℝ] Lp ℂ 2 μ₁)
    (coh : Lp ℂ 2 μ₁ → ℋ)
    (hgram : ∀ u v : Lp ℂ 2 μ₁, inner ℂ (coh u) (coh v) = Complex.exp (inner ℂ u v))
    (hchar : ∀ h : R, ∫ φ, Complex.exp (Complex.I * (eval φ h : ℂ)) ∂ν =
      Complex.exp (-(1 / 2 : ℂ) * ((‖j h‖ ^ 2 : ℝ) : ℂ)))
    (hreal : ∀ h₁ h₂ : R, (inner ℂ (j h₁) (j h₂)).im = 0)
    (hdense_weyl :
      (Submodule.span ℂ (Set.range (weylExpLp ν eval heval))).topologicalClosure = ⊤)
    (hdense_coh :
      (Submodule.span ℂ (Set.range (fun h : R ↦ coh (Complex.I • j h)))).topologicalClosure = ⊤) :
    ∃! U : Lp ℂ 2 ν ≃ₗᵢ[ℂ] ℋ,
      ∀ h : R, U (weylExpLp ν eval heval h) =
        Complex.exp (-(1 / 2 : ℂ) * ((‖j h‖ ^ 2 : ℝ) : ℂ)) • coh (Complex.I • j h) := by
  let a : R → Lp ℂ 2 ν := weylExpLp ν eval heval
  let c : R → ℂ := fun h ↦ Complex.exp (-(1 / 2 : ℂ) * ((‖j h‖ ^ 2 : ℝ) : ℂ))
  let b : R → ℋ := fun h ↦ c h • coh (Complex.I • j h)
  have ha : Dense (Submodule.span ℂ (Set.range a) : Set (Lp ℂ 2 ν)) :=
    Submodule.dense_iff_topologicalClosure_eq_top.mpr hdense_weyl
  have hb : Dense (Submodule.span ℂ (Set.range b) : Set ℋ) := by
    rw [span_smul_eq_of_ne_zero (fun h ↦ coh (Complex.I • j h)) c (fun h ↦ Complex.exp_ne_zero _)]
    exact Submodule.dense_iff_topologicalClosure_eq_top.mpr hdense_coh
  have hg : ∀ h₁ h₂ : R, inner ℂ (a h₁) (a h₂) = inner ℂ (b h₁) (b h₂) := fun h₁ h₂ ↦ by
    rw [weylExpLp_inner ν μ₁ eval heval j hchar hreal h₁ h₂]
    dsimp only [b, c]
    rw [inner_smul_left, inner_smul_right, hgram, inner_smul_left, inner_smul_right]
    have hconj_c : (starRingEnd ℂ) (Complex.exp (-(1 / 2 : ℂ) * ((‖j h₁‖ ^ 2 : ℝ) : ℂ))) =
        Complex.exp (-(1 / 2 : ℂ) * ((‖j h₁‖ ^ 2 : ℝ) : ℂ)) := by
      rw [← Complex.exp_conj]
      congr 1
      simp [map_ofNat]
    have hI : (starRingEnd ℂ) Complex.I * (Complex.I * inner ℂ (j h₁) (j h₂)) =
        inner ℂ (j h₁) (j h₂) := by
      rw [Complex.conj_I, ← mul_assoc]
      simp
    rw [hconj_c, hI, ← Complex.exp_add, ← Complex.exp_add]
    congr 1
    ring
  exact gram_total_unique a b ha hb hg

/-- The canonical surjective linear isometry `planeL2ToFock : Lp ℂ 2 ν ≃ₗᵢ[ℂ] ℋ`. -/
noncomputable def planeL2ToFock
    {ℋ : Type*} [NormedAddCommGroup ℋ] [InnerProductSpace ℂ ℋ] [CompleteSpace ℋ]
    (ν : Measure X₀) [IsProbabilityMeasure ν]
    (μ₁ : Measure E₁)
    (eval : X₀ → R →ₗ[ℝ] ℝ) (heval : ∀ h : R, Measurable (fun φ : X₀ ↦ eval φ h))
    (j : R →ₗ[ℝ] Lp ℂ 2 μ₁)
    (coh : Lp ℂ 2 μ₁ → ℋ)
    (hgram : ∀ u v : Lp ℂ 2 μ₁, inner ℂ (coh u) (coh v) = Complex.exp (inner ℂ u v))
    (hchar : ∀ h : R, ∫ φ, Complex.exp (Complex.I * (eval φ h : ℂ)) ∂ν =
      Complex.exp (-(1 / 2 : ℂ) * ((‖j h‖ ^ 2 : ℝ) : ℂ)))
    (hreal : ∀ h₁ h₂ : R, (inner ℂ (j h₁) (j h₂)).im = 0)
    (hdense_weyl :
      (Submodule.span ℂ (Set.range (weylExpLp ν eval heval))).topologicalClosure = ⊤)
    (hdense_coh :
      (Submodule.span ℂ (Set.range (fun h : R ↦ coh (Complex.I • j h)))).topologicalClosure = ⊤) :
    Lp ℂ 2 ν ≃ₗᵢ[ℂ] ℋ :=
  (planeL2ToFock_unique ν μ₁ eval heval j coh hgram hchar hreal hdense_weyl hdense_coh).exists.choose

theorem planeL2ToFock_weyl
    {ℋ : Type*} [NormedAddCommGroup ℋ] [InnerProductSpace ℂ ℋ] [CompleteSpace ℋ]
    (ν : Measure X₀) [IsProbabilityMeasure ν]
    (μ₁ : Measure E₁)
    (eval : X₀ → R →ₗ[ℝ] ℝ) (heval : ∀ h : R, Measurable (fun φ : X₀ ↦ eval φ h))
    (j : R →ₗ[ℝ] Lp ℂ 2 μ₁)
    (coh : Lp ℂ 2 μ₁ → ℋ)
    (hgram : ∀ u v : Lp ℂ 2 μ₁, inner ℂ (coh u) (coh v) = Complex.exp (inner ℂ u v))
    (hchar : ∀ h : R, ∫ φ, Complex.exp (Complex.I * (eval φ h : ℂ)) ∂ν =
      Complex.exp (-(1 / 2 : ℂ) * ((‖j h‖ ^ 2 : ℝ) : ℂ)))
    (hreal : ∀ h₁ h₂ : R, (inner ℂ (j h₁) (j h₂)).im = 0)
    (hdense_weyl :
      (Submodule.span ℂ (Set.range (weylExpLp ν eval heval))).topologicalClosure = ⊤)
    (hdense_coh :
      (Submodule.span ℂ (Set.range (fun h : R ↦ coh (Complex.I • j h)))).topologicalClosure = ⊤)
    (h : R) :
    planeL2ToFock ν μ₁ eval heval j coh hgram hchar hreal hdense_weyl hdense_coh
        (weylExpLp ν eval heval h) =
      Complex.exp (-(1 / 2 : ℂ) * ((‖j h‖ ^ 2 : ℝ) : ℂ)) • coh (Complex.I • j h) :=
  (planeL2ToFock_unique ν μ₁ eval heval j coh hgram hchar hreal hdense_weyl hdense_coh).exists.choose_spec h

end WeylPlaneL2Equiv

/-! ### Combined Surjective OS-to-Fock Bridge -/

section CombinedOSToFock

variable {Ω₀ Ωp X X₀ ℋ : Type*}
  [MeasurableSpace Ω₀] [MeasurableSpace Ωp]
  {mPos : MeasurableSpace X} [mX : MeasurableSpace X] [mX₀ : MeasurableSpace X₀]
  [NormedAddCommGroup ℋ] [InnerProductSpace ℂ ℋ]

/-- Composition of the surjective OS plane contraction `osPlaneMap` with any surjective unitary
equivalence `U : Lp ℂ 2 (P₀.map Φ₀) ≃ₗᵢ[ℂ] ℋ` (such as `planeL2ToFock` or
`schwartzPlaneL2ToFock`). -/
noncomputable def osToFockMap
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (U : Lp ℂ 2 (P₀.map Φ₀) ≃ₗᵢ[ℂ] ℋ) :
    posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ) →L[ℂ] ℋ :=
  U.toContinuousLinearEquiv.toContinuousLinearMap.comp
    (osPlaneMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local)

/-- `osToFockMap` pulls back the Fock inner product to the Euclidean reflection inner product
for ALL general nonlinear `F, G ∈ L²(X, mPos, μ)`. -/
theorem osToFockMap_reflection_inner
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (Θ : X → X) (hΘ : Measurable Θ)
    (hΘ_swap : ∀ ω₀ ωp ωm, Θ (Φ (ω₀, ωp, ωm)) = Φ (ω₀, ωm, ωp))
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (U : Lp ℂ 2 (P₀.map Φ₀) ≃ₗᵢ[ℂ] ℋ)
    (F G : posSubspace (mPos := mPos) ((P₀.prod (Pp.prod Pp)).map Φ)) :
    ∫ x, star ((F.1 : Lp ℂ 2 ((P₀.prod (Pp.prod Pp)).map Φ)) (Θ x)) *
        (G.1 : Lp ℂ 2 ((P₀.prod (Pp.prod Pp)).map Φ)) x
        ∂((P₀.prod (Pp.prod Pp)).map Φ) =
      inner ℂ
        (osToFockMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local U F)
        (osToFockMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local U G) := by
  rw [osPlaneMap_reflection_inner P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ Θ hΘ
    hΘ_swap hPos_local F G]
  exact (U.inner_map_map _ _).symm

/-- `osToFockMap` is surjective onto the entire Fock Hilbert space `ℋ`. -/
theorem osToFockMap_surjective
    (P₀ : Measure Ω₀) (Pp : Measure Ωp)
    [IsProbabilityMeasure P₀] [IsProbabilityMeasure Pp]
    (hmPos : mPos ≤ mX)
    (Φ₀ : Ω₀ → X₀) (hΦ₀ : Measurable Φ₀)
    (liftPos : X₀ × Ωp → X) (hliftPos : Measurable liftPos)
    (Φ : Ω₀ × Ωp × Ωp → X) (hΦ : Measurable Φ)
    (hPos_local : ∀ (F : X → ℂ), Measurable[mPos] F →
      ∀ ω₀ ωp ωm, F (Φ (ω₀, ωp, ωm)) = F (liftPos (Φ₀ ω₀, ωp)))
    (trace₀ : X → X₀) (htrace₀ : Measurable[mPos, mX₀] trace₀)
    (htrace₀_ae : ∀ᵐ ω ∂(P₀.prod (Pp.prod Pp)), trace₀ (Φ ω) = Φ₀ ω.1)
    (U : Lp ℂ 2 (P₀.map Φ₀) ≃ₗᵢ[ℂ] ℋ) :
    Function.Surjective
      (osToFockMap P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local U) :=
  U.surjective.comp
    (osPlaneMap_surjective P₀ Pp hmPos Φ₀ hΦ₀ liftPos hliftPos Φ hΦ hPos_local
      trace₀ htrace₀ htrace₀_ae)

