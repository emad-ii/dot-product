/-- Inverting the squared normal resolvent gives the profile used in the
two-pulse determinant (5), with its value at zero equal to `π/(2ω³)`
in the unnormalized angular-frequency integral. -/
theorem inverseSquaredNormalKernel {ω : ℝ} (hω : 0 < ω) (t : ℝ) :
    (∫ q : ℝ, Complex.exp ((q : ℂ) * Complex.I * t) *
      (((ω ^ 2 + q ^ 2 : ℝ)⁻¹ ^ 2 : ℝ) : ℂ)) =
      ((Real.pi * sqKernel ω |t| / (2 * ω^3) : ℝ) : ℂ) := by
  let e (q : ℝ) := Complex.exp ((q : ℂ) * Complex.I * t)
  have he (q : ℝ) : ‖e q‖ = 1 := by
    dsimp [e]
    rw [Complex.norm_exp]
    simp [Complex.mul_re, Complex.mul_im]
  let F (x q : ℝ) := e q * (((x^2 + q^2)⁻¹ : ℝ) : ℂ)
  let F' (x q : ℝ) := e q * ((-2*x*(x^2 + q^2)⁻¹^2 : ℝ) : ℂ)
  let c := 3*ω / (ω/2)^2
  have h₀ : 0 < ω / 2 := half_pos hω
  have hball {x : ℝ} (hx : x ∈ Metric.ball ω (ω/2)) : ω/2 < x ∧ x < 3*ω/2 := by
    rw [Metric.mem_ball, Real.dist_eq, abs_lt] at hx
    constructor <;> linarith
  have hdiff {x : ℝ} (hx : 0 < x) (q : ℝ) :
      HasDerivAt (fun w ↦ F w q) (F' x q) x := by
    have hn : x^2 + q^2 ≠ 0 := by positivity
    have h := (((hasDerivAt_id x).pow 2).add_const (q^2)).inv hn
    have h' : HasDerivAt (fun w : ℝ ↦ (w^2+q^2)⁻¹) (-2*x*(x^2+q^2)⁻¹^2) x := by
      convert h using 1
      · rfl
      · simp [div_eq_mul_inv, inv_pow]
    exact h'.ofReal_comp.const_mul (e q)
  have hbound (q x : ℝ) (hx : x ∈ Metric.ball ω (ω/2)) :
      ‖F' x q‖ ≤ c * ((ω/2)^2 + q^2)⁻¹ := by
    obtain ⟨hl,hu⟩ := hball hx
    have hx0 := h₀.trans hl
    have ha : 0 < (ω/2)^2 := by positivity
    have hb : 0 < (ω/2)^2 + q^2 := by positivity
    have hd : 0 < x^2 + q^2 := by positivity
    have hab : (ω/2)^2 ≤ x^2 + q^2 := by nlinarith [sq_nonneg q, sq_lt_sq' (by linarith : -(x) < ω/2) hl]
    have hbd : (ω/2)^2 + q^2 ≤ x^2 + q^2 := by nlinarith [sq_lt_sq' (by linarith : -(x) < ω/2) hl]
    dsimp [F']
    rw [norm_mul, he, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonpos (by have : 0 ≤ (x^2+q^2)⁻¹^2 := sq_nonneg _; nlinarith [mul_nonneg hx0.le this] : -2*x*(x^2+q^2)⁻¹^2 ≤ 0)]
    dsimp [c]
    rw [div_eq_mul_inv]
    calc -(-2*x*(x^2+q^2)⁻¹^2) = (2*x*(x^2+q^2)⁻¹)*(x^2+q^2)⁻¹ := by ring
      _ ≤ _ := by
        exact mul_le_mul (mul_le_mul (by linarith) (inv_anti₀ ha hab) (by positivity) (by positivity)) (inv_anti₀ hb hbd) (by positivity) (by positivity)
  have hFi : Integrable (F ω) := by
    apply (normalResolvent_integrable hω).mono' (by dsimp [F,e]; fun_prop)
    exact ae_of_all _ fun q ↦ by
      dsimp only [F]
      rw [norm_mul, he, one_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have hi := (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (Metric.ball_mem_nhds ω h₀)
    (F := F) (F' := F') (bound := fun q ↦ c * ((ω/2)^2 + q^2)⁻¹)
    (Eventually.of_forall fun x ↦ (by dsimp [F,e]; fun_prop : Measurable (F x)).aestronglyMeasurable)
    hFi (by apply Measurable.aestronglyMeasurable; dsimp [F',e]; fun_prop)
    (ae_of_all _ hbound) ((normalResolvent_integrable h₀).const_mul c)
    (ae_of_all _ fun q x hx ↦ hdiff (h₀.trans (hball hx).1) q)).2
  let K (x : ℝ) := Real.pi * Real.exp (-x * |t|) / x
  have hK : HasDerivAt K (-(Real.pi * sqKernel ω |t| / ω^2)) ω := by
    dsimp [K]
    have h := (((hasDerivAt_id ω).neg.mul_const |t|).exp.const_mul Real.pi).div (hasDerivAt_id ω) hω.ne'
    convert h using 1
    · rfl
    · unfold sqKernel
      simp
      ring
  have hEq : (fun x ↦ ∫ q, F x q) =ᶠ[𝓝 ω] fun x ↦ (K x : ℂ) := by
    filter_upwards [Ioi_mem_nhds hω] with x hx
    calc
      _ = ((2*Real.pi:ℝ):ℂ) * (expKernel x t : ℂ) := by simpa only [F,e,Complex.ofReal_inv] using inverseNormalKernel hx t
      _ = _ := by unfold expKernel K; push_cast; ring
  have h := (hi.congr_of_eventuallyEq hEq.symm).unique hK.ofReal_comp
  have hf (q : ℝ) : F' ω q = ((-2*ω : ℝ) : ℂ) * (e q * (((ω^2+q^2)⁻¹^2 : ℝ) : ℂ)) := by
    dsimp [F']
    push_cast
    ring
  simp_rw [hf] at h
  rw [integral_const_mul] at h
  change (∫ q : ℝ, e q * _) = _
  push_cast at h ⊢
  field_simp [Complex.ofReal_ne_zero.mpr hω.ne'] at h ⊢
  linear_combination -h

