/-! ### The conditioned Wick family and its Fock representation -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped InnerProductSpace

section ConditionalFock

set_option maxHeartbeats 800000

variable {Ω R V : Type*} [MeasurableSpace Ω] [NormedAddCommGroup R] [InnerProductSpace ℝ R]
  [AddCommGroup V] [Module ℝ V] (P : Measure Ω) [IsFiniteMeasure P]
  (Φ : Ω → R →ₗ[ℝ] ℝ) (hm : ∀ a, Measurable (fun w ↦ Φ w a))
  (hc : ∀ a : R, (∫ w, Complex.exp ((Φ w a : ℂ) * Complex.I) ∂P) =
    (Real.exp (-(‖a‖ ^ 2) / 2) : ℂ))
  (J : V →ₗ[ℝ] R) (S : Submodule ℝ R) [S.HasOrthogonalProjection]
  (happrox : (S : Set R) ⊆ closure (Set.range J))

local notation "law(" J ")" => P.map (readingCoordinates Φ J)
local notation "vol(" d ")" => (volume : Measure (MassShell.Space d))

theorem dense_conditioned_labels {X H : Type*}
    [NormedAddCommGroup X] [NormedSpace ℂ X] [NormedAddCommGroup H] [NormedSpace ℂ H]
    {ι : Type*} (a : ι → X) (ha : Dense (Submodule.span ℂ (range a) : Set X))
    (T : X →L[ℂ] H) (hT : Function.Surjective T) :
    Dense (Submodule.span ℂ (range (T ∘ a)) : Set H) := by
  let K := (Submodule.span ℂ (range (T ∘ a))).topologicalClosure
  have hs : Submodule.span ℂ (range a) ≤ K.comap T.toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨v, rfl⟩
    exact Submodule.le_topologicalClosure _ (Submodule.subset_span (mem_range_self v))
  intro y
  obtain ⟨x, rfl⟩ := hT y
  change T x ∈ K
  exact ha.induction (fun v hv ↦ hs hv) ((Submodule.isClosed_topologicalClosure _).preimage T.continuous) x

include hc happrox

/-- The whole Gaussian plane L² has a unique Fock realization taking conditioned
Wick preparations to the coherent vectors with labels iM. -/
theorem conditionedWick_fock_unique {d : ℕ} (M : V →ₗ[ℝ] Momentum d)
    (hM : Dense (Submodule.span ℂ (range M) : Set (Momentum d)))
    (hgram : ∀ f g, ((inner ℝ (S.orthogonalProjectionOnto (J f))
      (S.orthogonalProjectionOnto (J g)) : ℝ) : ℂ) = inner ℂ (M f) (M g)) :
    ∃! U : Lp ℂ 2 (law(S.subtype)) ≃ₗᵢ[ℂ] momentumFock (vol(d)),
      ∀ f, U (preparedCondition P Φ hm J S (wickCoordinate (law(J)) J f)) =
        coherentVec (vol(d)) (wickMomentum M f) := by
  let W := wickCoordinate (law(J)) J
  let C := preparedCondition P Φ hm J S
  have hsource := dense_conditioned_labels W (wickCoordinate_dense P Φ hm J) C
    (preparedCondition_onto P Φ hm hc J S happrox)
  have htarget := Submodule.dense_iff_topologicalClosure_eq_top.mpr
    (coherentVec_realLabels_dense (vol(d)) (wickMomentum M) (wickMomentum_dense M hM))
  refine gram_total_unique (C ∘ W) (fun f ↦ coherentVec (vol(d)) (wickMomentum M f))
    hsource htarget ?_
  intro f g
  let B := readingPullback P Φ hm S.subtype
  have hW (f : V) : B (C (W f)) = wickReading P Φ hm ((S.orthogonalProjectionOnto (J f)) : R) := by
    change B (conditionOn P _ (measurable_readingCoordinates Φ hm S.subtype)
      (readingPullback P Φ hm J (W f))) = _
    rw [show readingPullback P Φ hm J (W f) = wickReading P Φ hm (J f) from
      observationL2_wick P Φ hm J f, conditionOn_plane_wick P Φ hm hc S]
    exact observationL2_wick P Φ hm S.subtype _
  change inner ℂ (C (W f)) (C (W g)) = _
  calc
    _ = inner ℂ (B (C (W f))) (B (C (W g))) := (B.inner_map_map _ _).symm
    _ = (Real.exp (inner ℝ (S.orthogonalProjectionOnto (J f))
        (S.orthogonalProjectionOnto (J g))) : ℂ) :=
      (congrArg₂ (inner ℂ) (hW f) (hW g)).trans (wickReading_inner P Φ hm hc _ _)
    _ = Complex.exp (inner ℂ (M f) (M g)) :=
      (Complex.ofReal_exp _).trans (congrArg Complex.exp (hgram f g))
    _ = _ := (congrArg Complex.exp (wickMomentum_inner M f g).symm).trans
      (coherentVec_gram (vol(d)) _ _).symm

/-- The Fock identification acts on actual conditional expectations in the plane
law indexed by the original test smears, preserving every Wick label. -/
theorem spatialConditionedWick_fock_unique {U : Type*} [AddCommGroup U] [Module ℝ U]
    (L : U →ₗ[ℝ] R) (hS : S = L.range.topologicalClosure)
    {d : ℕ} (M : V →ₗ[ℝ] Momentum d)
    (hM : Dense (Submodule.span ℂ (range M) : Set (Momentum d)))
    (hgram : ∀ f g, ((inner ℝ (S.orthogonalProjectionOnto (J f))
      (S.orthogonalProjectionOnto (J g)) : ℝ) : ℂ) = inner ℂ (M f) (M g)) :
    ∃! F : Lp ℂ 2 (law(L)) ≃ₗᵢ[ℂ] momentumFock (vol(d)),
      ∀ f, F (conditionOn P _ (measurable_readingCoordinates Φ hm L)
        (wickReading P Φ hm (J f))) = coherentVec (vol(d)) (wickMomentum M f) := by
  obtain ⟨D, hD⟩ := observed_plane_tests_conditionOn P Φ hm hc S L hS
  obtain ⟨T, hT, huniq⟩ := conditionedWick_fock_unique P Φ hm hc J S happrox M hM hgram
  let C := preparedCondition P Φ hm J S
  let W := wickCoordinate (law(J)) J
  have hDW (f : V) : D (C (W f)) = conditionOn P _ (measurable_readingCoordinates Φ hm L)
      (wickReading P Φ hm (J f)) := by
    change D (conditionOn P _ _ (readingPullback P Φ hm J (W f))) = _
    rw [show readingPullback P Φ hm J (W f) = wickReading P Φ hm (J f) from
      observationL2_wick P Φ hm J f, hD]
  refine ⟨D.symm.trans T, fun f ↦ ?_, fun F hF ↦ ?_⟩
  · rw [← hDW, LinearIsometryEquiv.trans_apply, D.symm_apply_apply]
    exact hT f
  · have heq := huniq (D.trans F) (fun f ↦ (congrArg F (hDW f)).trans (hF f))
    apply DFunLike.ext
    intro u
    change F u = T (D.symm u)
    have hz := DFunLike.congr_fun heq (D.symm u)
    change F (D (D.symm u)) = T (D.symm u) at hz
    rwa [D.apply_symm_apply] at hz

/-- The quotient of arbitrary positive-side observables, labelled by the Wick
classes, carries the same uniquely determined Fock realization. -/
theorem preparationQuotient_fock_unique {d : ℕ} (M : V →ₗ[ℝ] Momentum d)
    (hM : Dense (Submodule.span ℂ (range M) : Set (Momentum d)))
    (hgram : ∀ f g, ((inner ℝ (S.orthogonalProjectionOnto (J f))
      (S.orthogonalProjectionOnto (J g)) : ℝ) : ℂ) = inner ℂ (M f) (M g)) :
    ∃! U : (Lp ℂ 2 (law(J)) ⧸ preparedNull P Φ hm J S) ≃ₗᵢ[ℂ] momentumFock (vol(d)),
      ∀ f, U (Submodule.Quotient.mk (wickCoordinate (law(J)) J f)) =
        coherentVec (vol(d)) (wickMomentum M f) := by
  let E := preparedQuotientEquiv P Φ hm hc J S happrox
  obtain ⟨T,hT,huniq⟩ := conditionedWick_fock_unique P Φ hm hc J S happrox M hM hgram
  refine ⟨E.trans T, hT, fun U hU ↦ ?_⟩
  have heq := huniq (E.symm.trans U) (fun f ↦ by
    change U (E.symm (E (Submodule.Quotient.mk (wickCoordinate (law(J)) J f)))) = _
    rw [E.symm_apply_apply]
    exact hU f)
  ext x : 1
  have h := congrArg (fun e : Lp ℂ 2 (law(S.subtype)) ≃ₗᵢ[ℂ] momentumFock (vol(d)) ↦ e (E x)) heq
  simpa using h

end ConditionalFock

