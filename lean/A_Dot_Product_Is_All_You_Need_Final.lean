              calc |ω₀ idx| * |planeFrameCLM n ħ m hm idx h|
                  ≤ |ω₀ idx| * (planeFrameWeight n ħ m hm idx * p) :=
                    mul_le_mul_of_nonneg_left (planeFrameCLM_bound n ħ m hm idx h) (abs_nonneg _)
                _ = (|ω₀ idx| * planeFrameWeight n ħ m hm idx) * p := by ring
                _ ≤ (((ω₀ idx) ^ 2 * planeFrameWeight n ħ m hm idx +
                      planeFrameWeight n ħ m hm idx) / 2) * p :=
                    mul_le_mul_of_nonneg_right (by linarith) hp
          _ = (∑' idx, ((ω₀ idx) ^ 2 * planeFrameWeight n ħ m hm idx +
                planeFrameWeight n ħ m hm idx) / 2) * p := tsum_mul_right
      have h2 : |∑' idx, target idx ω₀ * planeFrameCLM n ħ m hm idx h| ≤
          (∑' idx, |target idx ω₀| * planeFrameWeight n ħ m hm idx) * p := by
        have hs : Summable (fun idx => ‖target idx ω₀ * planeFrameCLM n ħ m hm idx h‖) :=
          Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun idx => by
            rw [Real.norm_eq_abs, abs_mul, mul_assoc]
            exact mul_le_mul_of_nonneg_left (planeFrameCLM_bound n ħ m hm idx h) (abs_nonneg _))
            (htsum.mul_right p)
        calc |∑' idx, target idx ω₀ * planeFrameCLM n ħ m hm idx h|
            ≤ ∑' idx, ‖target idx ω₀ * planeFrameCLM n ħ m hm idx h‖ := by
              rw [← Real.norm_eq_abs]; exact norm_tsum_le_tsum_norm hs
          _ ≤ ∑' idx, (|target idx ω₀| * planeFrameWeight n ħ m hm idx) * p :=
              hs.tsum_le_tsum (fun idx => by
                rw [Real.norm_eq_abs, abs_mul, mul_assoc]
                exact mul_le_mul_of_nonneg_left (planeFrameCLM_bound n ħ m hm idx h) (abs_nonneg _))
                (htsum.mul_right p)
          _ = (∑' idx, |target idx ω₀| * planeFrameWeight n ħ m hm idx) * p := tsum_mul_right
      calc |T h| ≤ |planeGaussianField n ħ m hħ hm ω₀ h| +
              |∑' idx, target idx ω₀ * planeFrameCLM n ħ m hm idx h| := abs_sub _ _
        _ ≤ B * p := by dsimp only [B]; linarith
    intro h
    exact sub_eq_zero.mp (hDsep T B hTB (fun d hd => sub_eq_zero.mpr (hD d hd)) h)
  exact PlaneL2FockEquiv.buildTrace0FromL2Approx P₀ Pp (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    (planeFrameCLM n ħ m hm) (planeFrameWeight n ħ m hm) (planeFrameWeight_nonneg n ħ m hm)
    (planeFrameSeminorms n ħ m hm) (planeFrameCLM_bound n ħ m hm)
    approx happrox_meas target htarget_meas
    (fun idx k => (hL2_exact idx k).1)
    (fun idx => by
      change Tendsto (fun k => ∫ ω : GFFNoise n,
        (approx idx k (gffField n ħ m hħ hm ω) - target idx ω.1) ^ 2 ∂(gffNoiseMeasure n))
        atTop (𝓝 0)
      have h1 := tendsto_thinSlab_plane n (ħ := ħ) hm (test idx)
      have h2 := tendsto_thinSlab_dirichlet n hħ.le hm (test idx)
      have hsum := h1.add h2
      rw [add_zero] at hsum
      exact hsum.congr fun k => ((hL2_exact idx k).2).symm)
    htarget_sum hrecon

/-- Explicit `gffPosSigma`-measurable sharp-time trace map
`gffTrace0 : RealTemperedDistribution (EuclidD n) → RealTemperedDistribution (SpatialE n)`. -/
noncomputable def gffTrace0 (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    RealTemperedDistribution (EuclidD n) → RealTemperedDistribution (SpatialE n) :=
  (exists_gffTrace0 n ħ m hħ hm).choose

theorem measurable_gffTrace0 (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    Measurable[gffPosSigma n, cylMeasurableSpace (SpatialE n)] (gffTrace0 n ħ m hħ hm) :=
  (exists_gffTrace0 n ħ m hħ hm).choose_spec.1

theorem gffTrace0_ae (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    ∀ᵐ ω ∂(gffNoiseMeasure n),
      gffTrace0 n ħ m hħ hm (gffField n ħ m hħ hm ω) = planeGaussianField n ħ m hħ hm ω.1 :=
  (exists_gffTrace0 n ħ m hħ hm).choose_spec.2

/-- The time-zero sub-σ-algebra `ℱ₀ := comap gffTrace0 (cylMeasurableSpace (SpatialE n))` on
`RealTemperedDistribution (EuclidD n)`. -/
@[instance_reducible]
noncomputable def gffZeroSigma (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    MeasurableSpace (RealTemperedDistribution (EuclidD n)) :=
  MeasurableSpace.comap (gffTrace0 n ħ m hħ hm) (cylMeasurableSpace (SpatialE n))

/-! ### Part 6: General Nonlinear `L²(ℱ₊)` Conditional Expectation, Reflection Factorization & Surjectivity -/

/-- Time-zero plane projection `E₀ F (φ₀) = ∫ F(harmonicLift φ₀ + Φ₊ ω₊) dP₊`. -/
noncomputable def gffPlaneProj (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (F : RealTemperedDistribution (EuclidD n) → ℂ) (φ₀ : RealTemperedDistribution (SpatialE n)) : ℂ :=
  PlaneL2FockEquiv.planeProj (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffLiftPos n ħ m hħ hm) F φ₀

/-- **General Nonlinear Continuum Reflection Factorization**:
for EVERY `gffPosSigma`-measurable `F, G ∈ L²(gffMeasure)`,
`∫ φ, star (F (reflectDist φ)) * G φ ∂(gffMeasure) = ∫ φ₀, star (E₀ F φ₀) * (E₀ G φ₀) ∂(planeGaussianMeasure)`. -/
theorem gff_reflection_inner_eq_planeL2 (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (F G : RealTemperedDistribution (EuclidD n) → ℂ)
    (hFm : Measurable[gffPosSigma n, inferInstance] F)
    (hGm : Measurable[gffPosSigma n, inferInstance] G)
    (hFLp : @MemLp _ _ (cylMeasurableSpace (EuclidD n)) _ _ F 2 (gffMeasure n ħ m hħ hm))
    (hGLp : @MemLp _ _ (cylMeasurableSpace (EuclidD n)) _ _ G 2 (gffMeasure n ħ m hħ hm)) :
    ∫ φ, star (F (reflectDist φ)) * G φ ∂(gffMeasure n ħ m hħ hm) =
      ∫ φ₀, star (gffPlaneProj n ħ m hħ hm F φ₀) * gffPlaneProj n ħ m hħ hm G φ₀
        ∂(planeGaussianMeasure n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.reflection_inner_eq_planeL2
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    reflectDist (measurable_reflectDist n) (reflectDist_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm) F G hFm hGm hFLp hGLp

/-- **Exact Mathlib `condExp` Identification**:
`(gffMeasure)[F | gffZeroSigma] =ᵐ (gffPlaneProj F) ∘ gffTrace0`. -/
theorem gff_condExp_eq_planeProj (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (F : RealTemperedDistribution (EuclidD n) → ℂ)
    (hFm : Measurable[gffPosSigma n, inferInstance] F)
    (hFLp : @MemLp _ _ (cylMeasurableSpace (EuclidD n)) _ _ F 2 (gffMeasure n ħ m hħ hm)) :
    @MeasureTheory.condExp _ _ (gffZeroSigma n ħ m hħ hm) (cylMeasurableSpace (EuclidD n)) _ _
        (gffMeasure n ħ m hħ hm) F
      =ᵐ[gffMeasure n ħ m hħ hm]
      (gffPlaneProj n ħ m hħ hm F) ∘ (gffTrace0 n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.condExp_eq_planeProj
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm)
    (gffTrace0 n ħ m hħ hm) (measurable_gffTrace0 n ħ m hħ hm) (gffTrace0_ae n ħ m hħ hm)
    F hFm hFLp

/-- **Exact `condExp` Reflection Factorization**:
`∫ φ, star (F (reflectDist φ)) * G φ ∂μ = ∫ φ, star (μ[F | ℱ₀] φ) * (μ[G | ℱ₀] φ) ∂μ`. -/
theorem gff_reflection_inner_eq_condExp (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (F G : RealTemperedDistribution (EuclidD n) → ℂ)
    (hFm : Measurable[gffPosSigma n, inferInstance] F)
    (hGm : Measurable[gffPosSigma n, inferInstance] G)
    (hFLp : @MemLp _ _ (cylMeasurableSpace (EuclidD n)) _ _ F 2 (gffMeasure n ħ m hħ hm))
    (hGLp : @MemLp _ _ (cylMeasurableSpace (EuclidD n)) _ _ G 2 (gffMeasure n ħ m hħ hm)) :
    ∫ φ, star (F (reflectDist φ)) * G φ ∂(gffMeasure n ħ m hħ hm) =
      ∫ φ, star (@MeasureTheory.condExp _ _ (gffZeroSigma n ħ m hħ hm)
          (cylMeasurableSpace (EuclidD n)) _ _ (gffMeasure n ħ m hħ hm) F φ) *
        (@MeasureTheory.condExp _ _ (gffZeroSigma n ħ m hħ hm)
          (cylMeasurableSpace (EuclidD n)) _ _ (gffMeasure n ħ m hħ hm) G φ)
        ∂(gffMeasure n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.reflection_inner_eq_condExp
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    reflectDist (measurable_reflectDist n) (reflectDist_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm)
    (gffTrace0 n ħ m hħ hm) (measurable_gffTrace0 n ħ m hħ hm) (gffTrace0_ae n ħ m hħ hm)
    F G hFm hGm hFLp hGLp

/-- **General Nonlinear Continuum Reflection Positivity**:
for EVERY `gffPosSigma`-measurable `F ∈ L²(gffMeasure)`,
`∫ φ, star (F (reflectDist φ)) * F φ ∂(gffMeasure)` is real and nonnegative. -/
theorem gff_reflection_pos_nonlinear (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (F : RealTemperedDistribution (EuclidD n) → ℂ)
    (hFm : Measurable[gffPosSigma n, inferInstance] F)
    (hFLp : @MemLp _ _ (cylMeasurableSpace (EuclidD n)) _ _ F 2 (gffMeasure n ħ m hħ hm)) :
    0 ≤ (∫ φ, star (F (reflectDist φ)) * F φ ∂(gffMeasure n ħ m hħ hm)).re ∧
      (∫ φ, star (F (reflectDist φ)) * F φ ∂(gffMeasure n ħ m hħ hm)).im = 0 := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.reflection_pos_nonlinear
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    reflectDist (measurable_reflectDist n) (reflectDist_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm) F hFm hFLp

/-- The positive-half-space `L²` subspace `L²(ℱ₊, μ_{ħ, m})`. -/
noncomputable abbrev gffPosSubspace (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :=
  letI := cylMeasurableSpace (EuclidD n)
  PlaneL2FockEquiv.posSubspace (mPos := gffPosSigma n) (gffMeasure n ħ m hħ hm)

/-- The canonical OS contraction map `L²(ℱ₊, μ_{ħ, m}) →L[ℂ] L²(𝓢'(ℝ^{n+1}, ℝ), ν_{ħ, m})`. -/
noncomputable def gff_osPlaneMap (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    letI := cylMeasurableSpace (EuclidD n)
    letI := cylMeasurableSpace (SpatialE n)
    gffPosSubspace n ħ m hħ hm →L[ℂ] Lp ℂ 2 (planeGaussianMeasure n ħ m hħ hm) := by
  letI := cylMeasurableSpace (EuclidD n)
  letI := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.osPlaneMap
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm)

/-- Surjectivity of `gff_osPlaneMap` onto ALL of `L²(𝓢'(ℝ^{n+1}, ℝ), ν_{ħ, m})`. -/
theorem gff_osPlaneMap_surjective (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    Function.Surjective (gff_osPlaneMap n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.osPlaneMap_surjective
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm)
    (gffTrace0 n ħ m hħ hm) (measurable_gffTrace0 n ħ m hħ hm) (gffTrace0_ae n ħ m hħ hm)

/-! ### Part 7: One-Particle `planeKernelLp` Density & Unitary Equivalence with `momentumFock volume` -/

/-- One-particle real-linear map `𝓢(SpatialE n, ℝ) →ₗ[ℝ] Lp ℂ 2 volume` given by `planeKernel`. -/
noncomputable def planeKernelLp (n : ℕ) (ħ m : ℝ) (hm : 0 < m) :
    𝓢(SpatialE n, ℝ) →ₗ[ℝ] Lp ℂ 2 (volume : Measure (SpatialE n)) where
  toFun h := (planeKernel_memLp n ħ hm h).toLp (planeKernel n ħ m h)
  map_add' h₁ h₂ := by
    apply Lp.ext
    filter_upwards [(planeKernel_memLp n ħ hm (h₁ + h₂)).coeFn_toLp,
      Lp.coeFn_add ((planeKernel_memLp n ħ hm h₁).toLp _) ((planeKernel_memLp n ħ hm h₂).toLp _),
      (planeKernel_memLp n ħ hm h₁).coeFn_toLp,
      (planeKernel_memLp n ħ hm h₂).coeFn_toLp] with k h12 hadd h1 h2
    rw [h12, hadd, Pi.add_apply, h1, h2, planeKernel_add n ħ hm h₁ h₂ k]
  map_smul' c h := by
    apply Lp.ext
    filter_upwards [(planeKernel_memLp n ħ hm (c • h)).coeFn_toLp,
      Lp.coeFn_smul c ((planeKernel_memLp n ħ hm h).toLp _),
      (planeKernel_memLp n ħ hm h).coeFn_toLp] with k hch hsm hh
    simp only [RingHom.id_apply]
    rw [hch, hsm, Pi.smul_apply, hh, planeKernel_smul n ħ hm c h k, Complex.real_smul]

lemma planeKernelLp_norm_sq (n : ℕ) (ħ m : ℝ) (hm : 0 < m) (h : 𝓢(SpatialE n, ℝ)) :
    ‖planeKernelLp n ħ m hm h‖ ^ 2 = ∫ k : SpatialE n, ‖planeKernel n ħ m h k‖ ^ 2 := by
  have h1 : inner ℂ (planeKernelLp n ħ m hm h) (planeKernelLp n ħ m hm h) =
      ((∫ k : SpatialE n, ‖planeKernel n ħ m h k‖ ^ 2 : ℝ) : ℂ) := by
    rw [L2.inner_def, ← integral_complex_ofReal]
    refine integral_congr_ae ?_
    filter_upwards [(planeKernel_memLp n ħ hm h).coeFn_toLp] with k hk
    change inner ℂ (((planeKernel_memLp n ħ hm h).toLp _) k)
      (((planeKernel_memLp n ħ hm h).toLp _) k) = _
    rw [hk, RCLike.inner_apply', Complex.conj_mul', Complex.ofReal_pow]
  have h2 := inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (planeKernelLp n ħ m hm h)
  rw [h2, RCLike.ofReal_eq_complex_ofReal, ← Complex.ofReal_pow] at h1
  exact Complex.ofReal_injective h1

lemma planeKernelLp_inner_im_zero (n : ℕ) (ħ m : ℝ) (hm : 0 < m)
    (h₁ h₂ : 𝓢(SpatialE n, ℝ)) :
    (inner ℂ (planeKernelLp n ħ m hm h₁) (planeKernelLp n ħ m hm h₂)).im = 0 := by
  rw [L2.inner_def]
  have heq : ∫ k : SpatialE n, inner ℂ (planeKernelLp n ħ m hm h₁ k) (planeKernelLp n ħ m hm h₂ k) =
      ∫ k : SpatialE n, star (planeKernel n ħ m h₁ k) * planeKernel n ħ m h₂ k := by
    refine integral_congr_ae ?_
    filter_upwards [(planeKernel_memLp n ħ hm h₁).coeFn_toLp,
      (planeKernel_memLp n ħ hm h₂).coeFn_toLp] with k hk₁ hk₂
    change inner ℂ (((planeKernel_memLp n ħ hm h₁).toLp _) k)
      (((planeKernel_memLp n ħ hm h₂).toLp _) k) = _
    rw [hk₁, hk₂, RCLike.inner_apply']
    rfl
  rw [heq]
  exact planeKernel_inner_im_zero n ħ m h₁ h₂

/-- The complex linear span of `planeKernelLp` on real spatial Schwartz tests is dense in
`Lp ℂ 2 (volume : Measure (SpatialE n))`. -/
theorem planeKernelLp_dense (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    Dense (Submodule.span ℂ (Set.range (planeKernelLp n ħ m hm)) :
      Set (Lp ℂ 2 (volume : Measure (SpatialE n)))) := by
  have hS_dense : DenseRange (SchwartzMap.toLpCLM ℝ ℂ 2 (volume : Measure (SpatialE n))) :=
    SchwartzMap.denseRange_toLpCLM (E := SpatialE n) (F := ℂ) (μ := volume) (p := 2) (by norm_num)
  refine hS_dense.mono ?_
  rintro _ ⟨g, rfl⟩
  let hC := planeKernelInvCLM n ħ m hħ hm g
  let hRe := hC.postcompCLM Complex.reCLM
  let hIm := hC.postcompCLM Complex.imCLM
  have heq : SchwartzMap.toLpCLM ℝ ℂ 2 (volume : Measure (SpatialE n)) g =
      planeKernelLp n ħ m hm hRe + Complex.I • planeKernelLp n ħ m hm hIm := by
    apply Lp.ext
    filter_upwards [(g.memLp 2 volume).coeFn_toLp,
      Lp.coeFn_add (planeKernelLp n ħ m hm hRe) (Complex.I • planeKernelLp n ħ m hm hIm),
      Lp.coeFn_smul Complex.I (planeKernelLp n ħ m hm hIm),
      (planeKernel_memLp n ħ hm hRe).coeFn_toLp,
      (planeKernel_memLp n ħ hm hIm).coeFn_toLp] with k hg hadd hsm hre him
    change ((g.memLp 2 volume).toLp g : SpatialE n → ℂ) k = _
    rw [hg, hadd, Pi.add_apply, hsm, Pi.smul_apply, smul_eq_mul]
    change g k = ((planeKernel_memLp n ħ hm hRe).toLp _ : SpatialE n → ℂ) k +
      Complex.I * ((planeKernel_memLp n ħ hm hIm).toLp _ : SpatialE n → ℂ) k
    rw [hre, him]
    exact (planeKernel_re_im_of_inv n hħ hm g k).symm
  rw [heq]
  exact Submodule.add_mem _ (Submodule.subset_span ⟨hRe, rfl⟩)
    (Submodule.smul_mem _ Complex.I (Submodule.subset_span ⟨hIm, rfl⟩))

/-- Density of Weyl exponentials in `Lp ℂ 2 (planeGaussianMeasure n ħ m hħ hm)` formatted for
`PlaneL2FockEquiv.weylExpLp`. -/
theorem planeGaussianMeasure_weylExpLp_dense (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    letI := cylMeasurableSpace (SpatialE n)
    (Submodule.span ℂ (Set.range
      (PlaneL2FockEquiv.weylExpLp (planeGaussianMeasure n ħ m hħ hm)
        (fun φ : RealTemperedDistribution (SpatialE n) => φ.toLinearMap)
        (fun h => measurable_eval_cyl h)))).topologicalClosure = ⊤ := by
  let _ := cylMeasurableSpace (SpatialE n)
  have heq : PlaneL2FockEquiv.weylExpLp (planeGaussianMeasure n ħ m hħ hm)
      (fun φ : RealTemperedDistribution (SpatialE n) => φ.toLinearMap)
      (fun h => measurable_eval_cyl h) =
      weylExpLp (planeGaussianMeasure n ħ m hħ hm) := by
    funext h
    apply Lp.ext
    filter_upwards
      [(PlaneL2FockEquiv.weylExp_memLp (planeGaussianMeasure n ħ m hħ hm)
        (fun φ : RealTemperedDistribution (SpatialE n) => φ.toLinearMap)
        (fun h => measurable_eval_cyl h) h).coeFn_toLp,
       (memLp_weylExp (planeGaussianMeasure n ħ m hħ hm) h).coeFn_toLp] with φ h1 h2
    exact h1.trans h2.symm
  rw [heq]
  exact weylExp_dense_L2 (planeGaussianMeasure n ħ m hħ hm)

/-- Polymorphic unitary equivalence `Lp ℂ 2 (planeGaussianMeasure n ħ m hħ hm) ≃ₗᵢ[ℂ] ℋ`
for any complete Fock Hilbert space `ℋ` with coherent states `coh` (instantiated directly on
Paper 1's `momentumFock volume` when spliced). -/
noncomputable def gff_planeL2_equiv_fock {ℋ : Type*} [NormedAddCommGroup ℋ]
    [InnerProductSpace ℂ ℋ] [CompleteSpace ℋ]
    (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (coh : Lp ℂ 2 (volume : Measure (SpatialE n)) → ℋ)
    (hgram : ∀ u v, inner ℂ (coh u) (coh v) = Complex.exp (inner ℂ u v))
    (hcoh_dense : (Submodule.span ℂ (Set.range (fun h : 𝓢(SpatialE n, ℝ) =>
      coh (Complex.I • planeKernelLp n ħ m hm h)))).topologicalClosure = ⊤) :
    letI := cylMeasurableSpace (SpatialE n)
    Lp ℂ 2 (planeGaussianMeasure n ħ m hħ hm) ≃ₗᵢ[ℂ] ℋ := by
  letI := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.planeL2ToFock (planeGaussianMeasure n ħ m hħ hm)
    (volume : Measure (SpatialE n))
    (fun φ : RealTemperedDistribution (SpatialE n) => φ.toLinearMap)
    (fun h => measurable_eval_cyl h)
    (planeKernelLp n ħ m hm) coh hgram
    (fun h => by rw [planeKernelLp_norm_sq]; exact charFun_planeGaussianMeasure n ħ m hħ hm h)
    (planeKernelLp_inner_im_zero n ħ m hm)
    (planeGaussianMeasure_weylExpLp_dense n ħ m hħ hm)
    hcoh_dense

/-- `gff_planeL2_equiv_fock` intertwines Weyl exponentials with normalized coherent states. -/
theorem gff_planeL2_equiv_fock_weyl {ℋ : Type*} [NormedAddCommGroup ℋ]
    [InnerProductSpace ℂ ℋ] [CompleteSpace ℋ]
    (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (coh : Lp ℂ 2 (volume : Measure (SpatialE n)) → ℋ)
    (hgram : ∀ u v, inner ℂ (coh u) (coh v) = Complex.exp (inner ℂ u v))
    (hcoh_dense : (Submodule.span ℂ (Set.range (fun h : 𝓢(SpatialE n, ℝ) =>
      coh (Complex.I • planeKernelLp n ħ m hm h)))).topologicalClosure = ⊤)
    (h : 𝓢(SpatialE n, ℝ)) :
    letI := cylMeasurableSpace (SpatialE n)
    gff_planeL2_equiv_fock n ħ m hħ hm coh hgram hcoh_dense
        (PlaneL2FockEquiv.weylExpLp (planeGaussianMeasure n ħ m hħ hm)
          (fun φ : RealTemperedDistribution (SpatialE n) => φ.toLinearMap)
          (fun g => measurable_eval_cyl g) h) =
      Complex.exp (-(1 / 2 : ℂ) * ((‖planeKernelLp n ħ m hm h‖ ^ 2 : ℝ) : ℂ)) •
        coh (Complex.I • planeKernelLp n ħ m hm h) := by
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.planeL2ToFock_weyl (planeGaussianMeasure n ħ m hħ hm)
    (volume : Measure (SpatialE n))
    (fun φ : RealTemperedDistribution (SpatialE n) => φ.toLinearMap)
    (fun g => measurable_eval_cyl g)
    (planeKernelLp n ħ m hm) coh hgram
    (fun g => by rw [planeKernelLp_norm_sq]; exact charFun_planeGaussianMeasure n ħ m hħ hm g)
    (planeKernelLp_inner_im_zero n ħ m hm)
    (planeGaussianMeasure_weylExpLp_dense n ħ m hħ hm)
    hcoh_dense h

/-! ### Part 8: Paper 1 Verbatim Bridges (`continuumCov`, §2.3 Free-Box Limit & `momentumFock volume`) -/

/-- Exact definitional match between `physicsFourierExact` and Paper 1's `physicsFourier`. -/
lemma physicsFourierExact_eq_physicsFourier {D : ℕ}
    (f : EuclideanSpace ℝ (Fin D) → ℝ) (p : EuclideanSpace ℝ (Fin D)) :
    physicsFourierExact f p = physicsFourier f p := rfl

/-- Exact equality between `continuumCovExact` and Paper 1's `continuumCov`. -/
lemma continuumCovExact_eq_continuumCov (n : ℕ) (ħ m : ℝ) (f g : 𝓢(EuclidD n, ℝ)) :
    continuumCovExact n ħ m f g = continuumCov ħ m (physicsFourier f) (physicsFourier g) := by
  unfold continuumCovExact continuumCov continuumDispersion
  simp only [physicsFourierExact_eq_physicsFourier, Complex.ofReal_inv]

/-- **Headline Bochner–Minlos Theorem (Characteristic Functional, Verbatim Paper 1 Form)**:
for every real Schwartz test `f : 𝓢(EuclidD n, ℝ)`, the characteristic functional of `gffMeasure`
equals `exp (-(1/2) * continuumCov ħ m (physicsFourier f) (physicsFourier f))`. -/
theorem bochnerMinlos_gff_charFun (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (f : 𝓢(EuclidD n, ℝ)) :
    ∫ φ, Complex.exp (Complex.I * (φ f : ℂ)) ∂(gffMeasure n ħ m hħ hm) =
      Complex.exp (-(1 / 2 : ℂ) * continuumCov ħ m (physicsFourier f) (physicsFourier f)) := by
  rw [← continuumCovExact_eq_continuumCov]
  exact bochnerMinlos_gff_charFun_exact n ħ m hħ hm f

/-- **Headline Bochner–Minlos Theorem (Joint Finite-List Characteristic Function)**:
for any finite list `f : Fin k → 𝓢(EuclidD n, ℝ)` and `t : Fin k → ℝ`, the joint characteristic
function of `(φ (f 0), …, φ (f (k-1)))` under `gffMeasure` equals the continuum Gaussian law. -/
theorem bochnerMinlos_gff_finite_charFun {k : ℕ} (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (f : Fin k → 𝓢(EuclidD n, ℝ)) (t : Fin k → ℝ) :
    ∫ φ, Complex.exp (Complex.I * ((∑ r : Fin k, t r * φ (f r) : ℝ) : ℂ))
        ∂(gffMeasure n ħ m hħ hm) =
      Complex.exp (-(1 / 2 : ℂ) * continuumCov ħ m
        (fun p => ∑ r : Fin k, (t r : ℂ) * physicsFourier (f r) p)
        (fun p => ∑ r : Fin k, (t r : ℂ) * physicsFourier (f r) p)) := by
  let g : 𝓢(EuclidD n, ℝ) := ∑ r : Fin k, t r • f r
  have hφg : ∀ φ : RealTemperedDistribution (EuclidD n),
      φ g = ∑ r : Fin k, t r * φ (f r) := fun φ => by
    simp only [g, map_sum, map_smul, smul_eq_mul]
  have hfour : physicsFourier (g : EuclidD n → ℝ) =
      fun p => ∑ r : Fin k, (t r : ℂ) * physicsFourier (f r) p := by
    funext p
    have h1 : physicsFourier (g : EuclidD n → ℝ) p = physicsFourierCLM (n + 2) g p :=
      (physicsFourierCLM_apply g p).symm
    rw [h1]
    dsimp only [g]
    rw [map_sum]
    simp only [sum_apply]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [map_smul]
    change t r • physicsFourierCLM (n + 2) (f r) p = _
    rw [physicsFourierCLM_apply, Complex.real_smul]
    rfl
  have hcf := bochnerMinlos_gff_charFun n ħ m hħ hm g
  simp_rw [hφg] at hcf
  rwa [hfour] at hcf

/-- **Headline Bochner–Minlos Theorem (Exact Two-Point Covariance, Verbatim Paper 1 Form)**:
for every pair of real Schwartz tests `f, g : 𝓢(EuclidD n, ℝ)`,
`∫ φ, (φ f : ℂ) * (φ g : ℂ) ∂(gffMeasure n ħ m hħ hm) = continuumCov ħ m (physicsFourier f) (physicsFourier g)`. -/
theorem bochnerMinlos_gff_covariance (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (f g : 𝓢(EuclidD n, ℝ)) :
    ∫ φ, (φ f : ℂ) * (φ g : ℂ) ∂(gffMeasure n ħ m hħ hm) =
      continuumCov ħ m (physicsFourier f) (physicsFourier g) := by
  rw [← continuumCovExact_eq_continuumCov]
  exact bochnerMinlos_gff_covariance_exact n ħ m hħ hm f g

/-- **Direct §2.3 Exhausting Free-Box Convergence to `gffMeasure`**:
for ANY finite family of compactly supported smooth tests `f : Fin k → 𝓢(EuclidD n, ℝ)` and
ANY exhausting sequence `(a_j, M_j)` of free boxes `{-M_j, …, M_j}^{n+2}`, the finite-box Gibbs
characteristic functions converge directly to the characteristic function of `gffMeasure`. -/
theorem tendsto_freeBox_charFun_eq_gffMeasure {k : ℕ} (n : ℕ) {ħ m : ℝ}
    (hħ : 0 < ħ) (hm : 0 < m) {a : ℕ → ℝ} {M : ℕ → ℕ}
    (ha_pos : ∀ j, 0 < a j)
    (ha_zero : Tendsto a atTop (𝓝 0))
    (hMa_top : Tendsto (fun j => (M j : ℝ) * a j) atTop atTop)
    (f : Fin k → 𝓢(EuclidD n, ℝ))
    (hf_supp : ∀ r, HasCompactSupport (f r : EuclidD n → ℝ))
    (t : Fin k → ℝ) :
    Tendsto
      (fun j => ∫ φ : FreeBoxSite (n + 2) (M j) → ℝ,
        Complex.exp (Complex.I *
          ((∑ r : Fin k, t r * (siteSample (n + 2) (M j) (a j) (f r) ⬝ᵥ φ) : ℝ) : ℂ))
        ∂volume.tilted (gaussianExponent (freeBoxPrecision (n + 2) (M j) (a j) ħ m)))
      atTop
      (𝓝 (∫ φ, Complex.exp (Complex.I * ((∑ r : Fin k, t r * φ (f r) : ℝ) : ℂ))
        ∂(gffMeasure n ħ m hħ hm))) := by
  have hlim := tendsto_freeBox_finite_gaussian_charFun (D := n + 2) hħ hm ha_pos ha_zero hMa_top
    (fun r => (f r : EuclidD n → ℝ)) (fun r => (f r).smooth ⊤) hf_supp t
  have hcf := bochnerMinlos_gff_finite_charFun n ħ m hħ hm f t
  rw [hcf]
  have heq : -(continuumCov ħ m
      (fun p => ∑ r : Fin k, (t r : ℂ) * physicsFourier (f r) p)
      (fun p => ∑ r : Fin k, (t r : ℂ) * physicsFourier (f r) p)) / 2 =
    -(1 / 2 : ℂ) * continuumCov ħ m
      (fun p => ∑ r : Fin k, (t r : ℂ) * physicsFourier (f r) p)
      (fun p => ∑ r : Fin k, (t r : ℂ) * physicsFourier (f r) p) := by ring
  rwa [heq] at hlim

private lemma momentumFock_planeKernel_coherent_dense
    (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    (Submodule.span ℂ (Set.range (fun h : 𝓢(SpatialE n, ℝ) =>
      coherentVec (volume : Measure (SpatialE n))
        (Complex.I • planeKernelLp n ħ m hm h)))).topologicalClosure = ⊤ := by
  have hjI : Dense (Submodule.span ℂ
      (Set.range (PlaneL2FockEquiv.smulILinearMap (planeKernelLp n ħ m hm))) :
      Set (Lp ℂ 2 (volume : Measure (SpatialE n)))) := by
    rw [PlaneL2FockEquiv.span_smulILinearMap]
    exact planeKernelLp_dense n hħ hm
  exact coherentVec_realLabels_dense (volume : Measure (SpatialE n))
    (PlaneL2FockEquiv.smulILinearMap (planeKernelLp n ħ m hm)) hjI

/-- **Exact Surjective Unitary Equivalence with Paper 1's `momentumFock volume`**:
`L²(𝓢'(ℝ^{n+1}, ℝ), ν_{ħ, m}) ≃ₗᵢ[ℂ] momentumFock (volume : Measure (SpatialE n))`. -/
noncomputable def gff_planeL2_equiv_momentumFock (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    letI := cylMeasurableSpace (SpatialE n)
    Lp ℂ 2 (planeGaussianMeasure n ħ m hħ hm) ≃ₗᵢ[ℂ]
      momentumFock (volume : Measure (SpatialE n)) := by
  letI := cylMeasurableSpace (SpatialE n)
  haveI : ∀ k : ℕ, CompleteSpace ↥(momentumSector (volume : Measure (SpatialE n)) k) :=
    fun _ => (Submodule.isClosed_topologicalClosure _).completeSpace_coe
  exact gff_planeL2_equiv_fock n ħ m hħ hm
    (coherentVec (volume : Measure (SpatialE n)))
    (coherentVec_gram (volume : Measure (SpatialE n)))
    (momentumFock_planeKernel_coherent_dense n ħ m hħ hm)

/-- `gff_planeL2_equiv_momentumFock` intertwines Weyl exponentials with normalized coherent states
in Paper 1's `momentumFock volume`. -/
theorem gff_planeL2_equiv_momentumFock_weyl (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (h : 𝓢(SpatialE n, ℝ)) :
    letI := cylMeasurableSpace (SpatialE n)
    gff_planeL2_equiv_momentumFock n ħ m hħ hm
        (PlaneL2FockEquiv.weylExpLp (planeGaussianMeasure n ħ m hħ hm)
          (fun φ : RealTemperedDistribution (SpatialE n) => φ.toLinearMap)
          (fun g => measurable_eval_cyl g) h) =
      Complex.exp (-(1 / 2 : ℂ) * ((‖planeKernelLp n ħ m hm h‖ ^ 2 : ℝ) : ℂ)) •
        coherentVec (volume : Measure (SpatialE n)) (Complex.I • planeKernelLp n ħ m hm h) := by
  let _ := cylMeasurableSpace (SpatialE n)
  have : ∀ k : ℕ, CompleteSpace ↥(momentumSector (volume : Measure (SpatialE n)) k) :=
    fun _ => (Submodule.isClosed_topologicalClosure _).completeSpace_coe
  exact gff_planeL2_equiv_fock_weyl n ħ m hħ hm
    (coherentVec (volume : Measure (SpatialE n)))
    (coherentVec_gram (volume : Measure (SpatialE n)))
    (momentumFock_planeKernel_coherent_dense n ħ m hħ hm) h

/-- **Surjective OS-to-Fock Contraction onto Paper 1's `momentumFock volume`**:
maps the entire positive-half-space Hilbert space `L²(ℱ₊, μ_{ħ, m})` onto
`momentumFock (volume : Measure (SpatialE n))`. -/
noncomputable def gff_osToFockMap (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    letI := cylMeasurableSpace (EuclidD n)
    gffPosSubspace n ħ m hħ hm →L[ℂ] momentumFock (volume : Measure (SpatialE n)) := by
  letI := cylMeasurableSpace (EuclidD n)
  letI := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.osToFockMap
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm)
    (gff_planeL2_equiv_momentumFock n ħ m hħ hm)

/-- `gff_osToFockMap` pulls back the Fock inner product of Paper 1's `momentumFock volume` to the
Euclidean reflection inner product for EVERY general nonlinear `F, G ∈ L²(ℱ₊, μ_{ħ, m})`. -/
theorem gff_osToFockMap_reflection_inner (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m)
    (F G : gffPosSubspace n ħ m hħ hm) :
    letI := cylMeasurableSpace (EuclidD n)
    ∫ φ, star ((F.1 : Lp ℂ 2 (gffMeasure n ħ m hħ hm)) (reflectDist φ)) *
        (G.1 : Lp ℂ 2 (gffMeasure n ħ m hħ hm)) φ ∂(gffMeasure n ħ m hħ hm) =
      inner ℂ (gff_osToFockMap n ħ m hħ hm F) (gff_osToFockMap n ħ m hħ hm G) := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.osToFockMap_reflection_inner
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    reflectDist (measurable_reflectDist n) (reflectDist_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm)
    (gff_planeL2_equiv_momentumFock n ħ m hħ hm) F G

/-- `gff_osToFockMap` is surjective onto ALL of Paper 1's `momentumFock volume`. -/
theorem gff_osToFockMap_surjective (n : ℕ) (ħ m : ℝ) (hħ : 0 < ħ) (hm : 0 < m) :
    Function.Surjective (gff_osToFockMap n ħ m hħ hm) := by
  let _ := cylMeasurableSpace (EuclidD n)
  let _ := cylMeasurableSpace (SpatialE n)
  exact PlaneL2FockEquiv.osToFockMap_surjective
    (iidGaussianMeasure (FrameIdx (n + 1))) (iidGaussianMeasure (FrameIdx (n + 2)))
    (gffPosSigma_le_cyl n)
    (planeGaussianField n ħ m hħ hm) (measurable_planeGaussianField n ħ m hħ hm)
    (gffLiftPos n ħ m hħ hm) (measurable_gffLiftPos n ħ m hħ hm)
    (gffField n ħ m hħ hm) (measurable_gffField n ħ m hħ hm)
    (gffPosSigma_local n ħ m hħ hm)
    (gffTrace0 n ħ m hħ hm) (measurable_gffTrace0 n ħ m hħ hm) (gffTrace0_ae n ħ m hħ hm)
    (gff_planeL2_equiv_momentumFock n ħ m hħ hm)

end ContinuumBochnerMinlos

section Table1Capstone

open MeasureTheory Set Filter Submodule
open scoped InnerProductSpace BigOperators Topology TensorProduct

private lemma modeDispersion_ge_m {d : ℕ} (m : ℝ)
    (k : EuclideanSpace ℝ (Fin d)) : m ≤ modeDispersion m k :=
  Real.le_sqrt_of_sq_le (by nlinarith [sq_nonneg ‖k‖])

private lemma separableSpace_of_dense_continuous_range {X H : Type*}
    [TopologicalSpace X] [TopologicalSpace.SeparableSpace X]
    [NormedAddCommGroup H] [NormedSpace ℂ H]
    {f : X → H} (hf : Continuous f)
    (hd : Dense (Submodule.span ℂ (Set.range f) : Set H)) :
    TopologicalSpace.SeparableSpace H :=
  hd.isSeparable_iff.mp (TopologicalSpace.isSeparable_range hf).span

/-- Separability of the concrete continuous-momentum Fock space `momentumFock volume` in every
spatial dimension `n + 1` (`D = (n + 1) + 1 ≥ 2`). -/
theorem momentumFock_separable (n : ℕ) :
    TopologicalSpace.SeparableSpace
      (momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))) := by
  let μ : Measure (EuclideanSpace ℝ (Fin (n + 1))) := volume
  have : Fact ((2 : ENNReal) ≠ ⊤) := ⟨by norm_num⟩
  have hcont : Continuous (coherentVec μ) := by
    apply continuous_iff_continuous_dist.mpr
    have hd (u v : Lp ℂ 2 μ) :
        dist (coherentVec μ u) (coherentVec μ v) =
          Real.sqrt (Real.exp (‖u‖ ^ 2) - 2 * (Complex.exp (inner ℂ u v)).re +
            Real.exp (‖v‖ ^ 2)) := by
      rw [dist_eq_norm, ← Real.sqrt_sq (norm_nonneg (coherentVec μ u - coherentVec μ v)),
        norm_sub_sq (𝕜 := ℂ), norm_sq_eq_re_inner (𝕜 := ℂ), norm_sq_eq_re_inner (𝕜 := ℂ),
        coherentVec_gram, coherentVec_gram, coherentVec_gram]
      simp only [RCLike.re_to_complex]
      have hu : (Complex.exp (inner ℂ u u)).re = Real.exp (‖u‖ ^ 2) := by
        rw [inner_self_eq_norm_sq_to_K, RCLike.ofReal_eq_complex_ofReal,
          ← Complex.ofReal_pow, ← Complex.ofReal_exp, Complex.ofReal_re]
      have hv : (Complex.exp (inner ℂ v v)).re = Real.exp (‖v‖ ^ 2) := by
        rw [inner_self_eq_norm_sq_to_K, RCLike.ofReal_eq_complex_ofReal,
          ← Complex.ofReal_pow, ← Complex.ofReal_exp, Complex.ofReal_re]
      rw [hu, hv]
    simp_rw [hd]
    fun_prop
  have hdense : Dense (Submodule.span ℂ (Set.range (coherentVec μ)) : Set (momentumFock μ)) := by
    rw [dense_iff_closure_eq]
    have hcl := congrArg (fun S : Submodule ℂ (momentumFock μ) ↦ (S : Set (momentumFock μ)))
      (coherentVec_dense μ)
    simpa [Submodule.topologicalClosure_coe] using hcl
  exact separableSpace_of_dense_continuous_range hcont hdense

/-- Infinite dimensionality of the concrete continuous-momentum Fock space `momentumFock volume`
in every spatial dimension `n + 1` (`D = (n + 1) + 1 ≥ 2`). -/
theorem momentumFock_infinite_dim (n : ℕ) :
    ¬ Module.Finite ℂ
      (momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))) := by
  let μ : Measure (EuclideanSpace ℝ (Fin (n + 1))) := volume
  let B : Set (EuclideanSpace ℝ (Fin (n + 1))) := Metric.ball 0 1
  have hB_meas : MeasurableSet B := Metric.isOpen_ball.measurableSet
  have hB_lt : μ B < ⊤ := measure_ball_lt_top
  have hB_pos : 0 < μ B := Metric.measure_ball_pos μ 0 zero_lt_one
  let v : Lp ℂ 2 μ := indicatorConstLp (2 : ENNReal) hB_meas hB_lt.ne (1 : ℂ)
  have hv_norm_pos : 0 < ‖v‖ := by
    rw [norm_indicatorConstLp (by norm_num : (2 : ENNReal) ≠ 0) (by norm_num : (2 : ENNReal) ≠ ⊤)]
    have htr : 0 < μ.real B := ENNReal.toReal_pos hB_pos.ne' hB_lt.ne
    simpa [norm_one] using Real.rpow_pos_of_pos htr (1 / (2 : ENNReal).toReal)
  let u₀ : Lp ℂ 2 μ := ((‖v‖⁻¹ : ℝ) : ℂ) • v
  have hu₀_norm : ‖u₀‖ = 1 := by
    dsimp only [u₀]
    rw [norm_smul, Complex.norm_real, Real.norm_of_nonneg (inv_nonneg.mpr hv_norm_pos.le),
      inv_mul_cancel₀ hv_norm_pos.ne']
  let a : ℝ → momentumFock μ := fun t ↦ coherentVec μ ((t : ℂ) • u₀)
  have hg : ∀ x y : ℝ, inner ℂ (a x) (a y) = (Real.exp (inner ℝ x y) : ℂ) := fun x y ↦ by
    dsimp only [a]
    rw [coherentVec_gram, inner_smul_left, inner_smul_right, inner_self_eq_norm_sq_to_K, hu₀_norm]
    simp [RCLike.inner_apply, Complex.ofReal_exp, mul_comm]
  exact gaussian_infinite_dimension a hg (1 : ℝ) one_ne_zero

/-- Table 1, Row 1 (Hilbert space): `momentumFock volume` is separable and infinite-dimensional,
has real positive-half-space Schwartz coherent totality, and is uniquely fixed up to unitary
equivalence by its coherent Gram table (`gram_total_unique`). -/
def Table1HilbertSpace (n : ℕ) (ħ m : ℝ) : Prop :=
  let H := momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
  TopologicalSpace.SeparableSpace H ∧ ¬ Module.Finite ℂ H ∧
    (∀ (h : ℝ → ℝ), Measurable h → (∀ t, 0 ≤ h t) → IntegrableOn h (Ioi (0 : ℝ)) →
      0 < ∫ t in Ioi (0 : ℝ), h t →
      let b := fun k : EuclideanSpace ℝ (Fin (n + 1)) ↦
        Real.sqrt (ħ / (2 * modeDispersion m k)) * laplaceBump h (modeDispersion m k)
      ∃ hb : MemLp (fun k ↦ (b k : ℂ)) (⊤ : ENNReal)
          (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))),
        (Submodule.span ℂ (Set.range (fun g : SchwartzMap (EuclideanSpace ℝ (Fin (n + 1))) ℝ ↦
          coherentVec (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
            (realFixedProfileMap b hb g)))).topologicalClosure = ⊤) ∧
    (∀ (F : Type) [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
      (b : Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))) → F),
      Dense (Submodule.span ℂ (Set.range b) : Set F) →
      (∀ u v, inner ℂ (b u) (b v) = Complex.exp (inner ℂ u v)) →
      ∃! W : H ≃ₗᵢ[ℂ] F,
        ∀ u, W (coherentVec (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))) u) = b u)

/-- Table 1, Row 2 (Unitary evolution): the group, isometry and generator identities for `fockUnitary`
on `momentumFock volume` with exact Schrödinger generator domain `Dom(H)` and symmetric nonnegative
mass-shell Hamiltonian `fockH`. -/
def Table1UnitaryEvolution (n : ℕ) (ħ m : ℝ) : Prop :=
  let μ : Measure (EuclideanSpace ℝ (Fin (n + 1))) := volume
  let U := fockUnitary μ (modeDispersion m) (modeDispersion_measurable m)
  U 0 = ContinuousLinearMap.id ℂ (momentumFock μ) ∧
    (∀ t₁ t₂, U (t₁ + t₂) = (U t₁).comp (U t₂)) ∧
    (∀ t ψ, ‖U t ψ‖ = ‖ψ‖) ∧
    (∀ ψ χ, HasDerivAt (fun t ↦ U t ψ) χ 0 ↔
      ∃ hψ : fockDomH μ ħ (modeDispersion m) ψ,
        χ = -(Complex.I / (ħ : ℂ)) •
          fockH μ ħ (modeDispersion m) (modeDispersion_measurable m) ψ hψ) ∧
    (∀ φ ψ (hφ : fockDomH μ ħ (modeDispersion m) φ) (hψ : fockDomH μ ħ (modeDispersion m) ψ),
      inner ℂ φ (fockH μ ħ (modeDispersion m) (modeDispersion_measurable m) ψ hψ) =
        inner ℂ (fockH μ ħ (modeDispersion m) (modeDispersion_measurable m) φ hφ) ψ) ∧
    (∀ ψ (hψ : fockDomH μ ħ (modeDispersion m) ψ),
      0 ≤ (inner ℂ ψ
        (fockH μ ħ (modeDispersion m) (modeDispersion_measurable m) ψ hψ)).re)

/-- Table 1, Row 3 (Tensor product): canonical unitary equivalence
`Completion (momentumFock μ ⊗[ℂ] momentumFock μ) ≃ₗᵢ[ℂ] momentumFock (sumMeasure μ μ)` sending
pure coherent tensors `E(u) ⊗ₜ E(v)` to `E(u ⊕ v)`. -/
def Table1TensorProduct {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ] : Prop :=
  ∃! W : UniformSpace.Completion (momentumFock μ ⊗[ℂ] momentumFock μ) ≃ₗᵢ[ℂ]
      momentumFock (sumMeasure μ μ),
    ∀ (u v : Lp ℂ 2 μ),
      W (ProductL2.tensorPure (coherentVec μ u) (coherentVec μ v)) =
        coherentVec (sumMeasure μ μ) (sumLp μ μ u v)

/-- Table 1, Row 4 (Born rule): existence and uniqueness of the event-weight law `‖P_K ψ‖²`
for every unit vector `ψ` in `H`. -/
def Table1BornRule (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] : Prop :=
  ∀ ψ : H, ‖ψ‖ = 1 →
    (∃! p : ClosedSubmodule ℂ H → ℝ, EventRules ψ p) ∧
    EventRules ψ (fun K ↦ ‖K.toSubmodule.starProjection ψ‖ ^ 2)

/-- Table 1, Row 5 (Self-adjoint observables): every Borel PVM `P` on `H` generates a densely
defined, genuinely self-adjoint observable `A = ∫ a dP(a)` on `pvmDom P` whose expectation equals
`∫ a dμ_ψ(a)`. -/
def Table1SelfAdjointObservables (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] : Prop :=
  ∀ P : PVM H,
    Dense (pvmDom P : Set H) ∧
    (∀ φ χ, (∀ ψ (hψ : ψ ∈ pvmDom P), inner ℂ φ (pvmOp P ψ hψ) = inner ℂ χ ψ) ↔
      ∃ hφ : φ ∈ pvmDom P, pvmOp P φ hφ = χ) ∧
    (∀ ψ (hψ : ψ ∈ pvmDom P),
      (inner ℂ ψ (pvmOp P ψ hψ)).re = ∫ a, a ∂(P.specMeasure ψ))

/-- Table 1, Row 6 (Projection update & operator trace): pure-state normalized projection ray
uniqueness up to unit phase, normal-mixture Lüders operator uniqueness `P_K ρ P_K / Tr(ρ P_K)`,
and basis-independent Hilbert-space operator trace `∑' i, ⟨b_i, ρ P_K b_i⟩ = mixTrace ρ K`. -/
def Table1ProjectionUpdate.{u} (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] : Prop :=
  (∀ (K : ClosedSubmodule ℂ H) (ψ : H), K.toSubmodule.starProjection ψ ≠ 0 →
      let ψ' := (‖K.toSubmodule.starProjection ψ‖⁻¹ : ℂ) • K.toSubmodule.starProjection ψ
      ‖ψ'‖ = 1 ∧ ‖K.toSubmodule.starProjection ψ'‖ ^ 2 = 1 ∧
      (∀ Q : ClosedSubmodule ℂ H, Q ≤ K →
        ‖Q.toSubmodule.starProjection ψ'‖ ^ 2 =
          ‖Q.toSubmodule.starProjection ψ‖ ^ 2 / ‖K.toSubmodule.starProjection ψ‖ ^ 2) ∧
      (∀ φ : H, ‖φ‖ = 1 →
        (∀ Q : ClosedSubmodule ℂ H, Q ≤ K →
          ‖Q.toSubmodule.starProjection φ‖ ^ 2 =
            ‖Q.toSubmodule.starProjection ψ‖ ^ 2 / ‖K.toSubmodule.starProjection ψ‖ ^ 2) →
        ∃ c : ℂ, ‖c‖ = 1 ∧ φ = c • ψ')) ∧
    (∀ (ρ : NormalMixture H) (K : ClosedSubmodule ℂ H) (hpos : 0 < mixTrace ρ K),
      (∃! σ : H →L[ℂ] H, ∃ post : ClosedSubmodule ℂ H → ℝ,
        (∀ A, post A ∈ Set.Icc 0 1) ∧
        (∀ A B : ClosedSubmodule ℂ H, B ≤ Aᗮ → post (A ⊔ B) = post A + post B) ∧
        post K = 1 ∧
        (∀ x : H, inner ℂ (σ x) x = ((‖x‖ ^ 2 * post (ray x) : ℝ) : ℂ)) ∧
        (∀ y ∈ K, post (ray y) * mixTrace ρ K = mixTrace ρ (ray y))) ∧
      densityOp (condMixture ρ K hpos) =
        (mixTrace ρ K : ℂ)⁻¹ •
          (K.toSubmodule.starProjection.comp
            ((densityOp ρ).comp K.toSubmodule.starProjection)) ∧
      (∀ (ι : Type u) (b : HilbertBasis ι ℂ H),
        ∑' i : ι, inner ℂ (b i) (densityOp ρ (K.toSubmodule.starProjection (b i))) =
          (mixTrace ρ K : ℂ)))

/-- Table 1, Row 7 (Full Poincaré covariance): a single unified unitary representation
`fockPoincare n m hm : PoincareGroup (n + 1) →* (momentumFock volume ≃ₗᵢ[ℂ] momentumFock volume)`
of the full orthochronous Poincaré group `ℝ^{1,n+1} ⋊ O⁺(1, n + 1)` fixes `Ω := fockVacuum volume`,
intertwines `Φ := wightmanField` under spacetime pullback `poincareSchwartz g f` on
`core := FiniteParticleFock volume`, and restricts on translations, `O(n + 1)` rotations, and
1-parameter directional boosts to `fockTranslation`, `fockRotation`, and `fockDirectionalBoost`
(subsuming all prior subgroup covariance fields). -/
def Table1PoincareCovariance (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) : Prop :=
  let μ : Measure (EuclideanSpace ℝ (Fin (n + 1))) := volume
  let Ω := fockVacuum μ
  let Φ := wightmanField (n + 1) ħ m hħ hm
  let core := FiniteParticleFock μ
  (∀ (g : PoincareGroup (n + 1))
      (f : SchwartzMap (ℝ × EuclideanSpace ℝ (Fin (n + 1))) ℂ) (ψ : core),
      fockPoincare n m hm g Ω = Ω ∧
      (secondQuantizeFin μ (poincareUnitary n m hm g) ψ).1 = fockPoincare n m hm g ψ.1 ∧
      secondQuantizeFin μ (poincareUnitary n m hm g) (Φ f ψ) =
        Φ (poincareSchwartz g f) (secondQuantizeFin μ (poincareUnitary n m hm g) ψ)) ∧
    (∀ (a : ℝ × EuclideanSpace ℝ (Fin (n + 1))),
      fockPoincare n m hm ⟨a, 1⟩ = fockTranslation (n + 1) m a) ∧
    (∀ (R : EuclideanSpace ℝ (Fin (n + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (n + 1))),
      fockPoincare n m hm ⟨0, rotationLorentz R⟩ = fockRotation (n + 1) R) ∧
    (∀ (u : EuclideanSpace ℝ (Fin (n + 1))) (hu : ‖u‖ = 1) (t : ℝ),
      fockPoincare n m hm ⟨0, directionalBoostLorentz u hu t⟩ =
        fockDirectionalBoost n m hm u t) ∧
    (∀ (a : ℝ × EuclideanSpace ℝ (Fin (n + 1)))
      (f : SchwartzMap (ℝ × EuclideanSpace ℝ (Fin (n + 1))) ℂ) (ψ : core),
      fockTranslation (n + 1) m a Ω = Ω ∧
      secondQuantizeFin μ (translationUnitary (n + 1) m a) (Φ f ψ) =
        Φ (translateSchwartz a f)
          (secondQuantizeFin μ (translationUnitary (n + 1) m a) ψ)) ∧
    (∀ (R : EuclideanSpace ℝ (Fin (n + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (n + 1)))
      (f : SchwartzMap (ℝ × EuclideanSpace ℝ (Fin (n + 1))) ℂ) (ψ : core),
      fockRotation (n + 1) R Ω = Ω ∧
      secondQuantizeFin μ (rotationUnitary (n + 1) R) (Φ f ψ) =
        Φ (rotateSchwartz R f)
          (secondQuantizeFin μ (rotationUnitary (n + 1) R) ψ)) ∧
    (∀ (u : EuclideanSpace ℝ (Fin (n + 1))) (hu : ‖u‖ = 1) (s t : ℝ)
      (f : SchwartzMap (ℝ × EuclideanSpace ℝ (Fin (n + 1))) ℂ) (ψ : core),
      fockDirectionalBoost n m hm u 0 = 1 ∧
      fockDirectionalBoost n m hm u (s + t) =
        fockDirectionalBoost n m hm u s * fockDirectionalBoost n m hm u t ∧
      fockDirectionalBoost n m hm u t Ω = Ω ∧
      secondQuantizeFin μ (directionalBoostUnitary n m hm u t) (Φ f ψ) =
        Φ (lorentzSchwartz (directionalBoostLorentz u hu t) f)
          (secondQuantizeFin μ (directionalBoostUnitary n m hm u t) ψ)) ∧
    (∀ (u : EuclideanSpace ℝ (Fin (n + 1))) (s t : ℝ)
      (v vbar : Lp ℂ 2 μ) (ψ : core),
      fockDirectionalBoost n m hm u 0 = 1 ∧
      fockDirectionalBoost n m hm u (s + t) =
        fockDirectionalBoost n m hm u s * fockDirectionalBoost n m hm u t ∧
      fockDirectionalBoost n m hm u t Ω = Ω ∧
      secondQuantizeFin μ (directionalBoostUnitary n m hm u t) (contField μ v vbar ψ) =
        contField μ (directionalBoostUnitary n m hm u t v)
          (directionalBoostUnitary n m hm u t vbar)
          (secondQuantizeFin μ (directionalBoostUnitary n m hm u t) ψ))

/-- Table 1, Row 8 (Forward-cone spectrum): multi-particle forward cone, energy mass gap
`{0} ∪ [ħm, ∞)`, and exponential contraction decay `‖(fockShift s ψ)_k‖ ≤ exp(-s k m) ‖ψ_k‖`. -/
def Table1ForwardConeSpectrum (n : ℕ) (ħ m : ℝ) (hm : 0 < m) : Prop :=
  (∀ {I : Type} (S : Finset I) (k : I → EuclideanSpace ℝ (Fin (n + 1))),
      ‖∑ i ∈ S, k i‖ ≤ ∑ i ∈ S, MassShell.rate m (k i)) ∧
    (∀ {I : Type} (S : Finset I) (k : I → EuclideanSpace ℝ (Fin (n + 1))),
      (∑ i ∈ S, ħ * MassShell.rate m (k i)) ∈ ({0} : Set ℝ) ∪ Set.Ici (ħ * m) ∧
        ((∑ i ∈ S, ħ * MassShell.rate m (k i)) = 0 ↔ S = ∅)) ∧
    (∀ (s : ℝ) (hs : 0 ≤ s)
      (ψ : momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))) (k : ℕ),
      ‖(fockShift (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
          (modeDispersion m) (modeDispersion_measurable m)
          (fun p ↦ hm.le.trans (modeDispersion_ge_m m p)) s hs ψ) k‖ ≤
        Real.exp (-s * (k : ℝ) * m) * ‖ψ k‖)

/-- Table 1, Row 9 (Unique vacuum): `fockH Ω = 0`, `fockShift s ψ = ψ ↔ ψ ∈ ℂ · Ω` for `s > 0`,
and zero total dispersion iff the particle sector is empty. -/
def Table1UniqueVacuum (n : ℕ) (ħ m : ℝ) (hm : 0 < m) : Prop :=
  let μ : Measure (EuclideanSpace ℝ (Fin (n + 1))) := volume
  let Ω := fockVacuum μ
  fockH μ ħ (modeDispersion m) (modeDispersion_measurable m) Ω
      (fockDomH_vacuum μ ħ (modeDispersion m)) = 0 ∧
    (∀ (s : ℝ) (hs : 0 < s) (ψ : momentumFock μ),
      fockShift μ (modeDispersion m) (modeDispersion_measurable m)
        (fun p ↦ hm.le.trans (modeDispersion_ge_m m p)) s hs.le ψ = ψ ↔
          ψ ∈ Submodule.span ℂ {Ω}) ∧
    (∀ {I : Type} (S : Finset I) (k : I → EuclideanSpace ℝ (Fin (n + 1))),
      (∑ i ∈ S, MassShell.rate m (k i)) = 0 ↔ S = ∅)

/-- Table 1, Row 10 (Field distributions): dense finite-particle core containing `Ω`,
tempered-distribution continuity of `f ↦ ⟨φ, Φ(f) ψ⟩`, and real-test Hermiticity. -/
def Table1FieldDistributions (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) : Prop :=
  let core := FiniteParticleFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
  let Φ := wightmanField (n + 1) ħ m hħ hm
  Dense (core : Set (momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))))) ∧
    fockVacuum (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))) ∈ core ∧
    (∀ (φ ψ : core),
      Continuous (fun f : SchwartzMap (ℝ × EuclideanSpace ℝ (Fin (n + 1))) ℂ ↦
        inner ℂ φ.1 (Φ f ψ).1)) ∧
    (∀ (f : SchwartzMap (ℝ × EuclideanSpace ℝ (Fin (n + 1))) ℝ) (φ ψ : core),
      inner ℂ (Φ (FeatureDensity.ofRealSchwartz f) φ).1 ψ.1 =
        inner ℂ φ.1 (Φ (FeatureDensity.ofRealSchwartz f) ψ).1)

/-- Table 1, Row 11 (Spacelike commutativity): `[Φ(f), Φ(f')] ψ = 0` on `FiniteParticleFock`
for all compactly supported real smooth tests with spacelike-separated supports in `D ≥ 2`. -/
def Table1SpacelikeCommutativity (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) : Prop :=
  let core := FiniteParticleFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
  let Φ := wightmanField (n + 1) ħ m hħ hm
  ∀ (f f' : SchwartzMap (ℝ × EuclideanSpace ℝ (Fin (n + 1))) ℝ),
    HasCompactSupport f → HasCompactSupport f' →
    (∀ p ∈ tsupport f, ∀ q ∈ tsupport f', |p.1 - q.1| < ‖p.2 - q.2‖) →
    ∀ ψ : core,
      Φ (FeatureDensity.ofRealSchwartz f) (Φ (FeatureDensity.ofRealSchwartz f') ψ) =
        Φ (FeatureDensity.ofRealSchwartz f') (Φ (FeatureDensity.ofRealSchwartz f) ψ)

/-- Table 1, Row 12 (Cyclic vacuum): real-Schwartz field polynomials applied to the vacuum
`fockVacuumFin volume` are dense in `momentumFock volume`. -/
def Table1CyclicVacuum (n : ℕ) (ħ m : ℝ) : Prop :=
  ∀ (h : ℝ → ℝ), Measurable h → (∀ t, 0 ≤ h t) → IntegrableOn h (Ioi (0 : ℝ)) →
    0 < ∫ t in Ioi (0 : ℝ), h t →
    let b := fun k : EuclideanSpace ℝ (Fin (n + 1)) ↦
      Real.sqrt (ħ / (2 * modeDispersion m k)) * laplaceBump h (modeDispersion m k)
    ∃ hb : MemLp (fun k ↦ (b k : ℂ)) (⊤ : ENNReal)
        (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))),
      (Submodule.span ℂ
        (Set.range fun L : List (SchwartzMap (EuclideanSpace ℝ (Fin (n + 1))) ℝ) ↦
          (L.foldl (fun ψ g ↦
            contField (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
              (realFixedProfileMap b hb g) (realFixedProfileMap b hb g) ψ)
            (fockVacuumFin (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))))).1)).topologicalClosure =
        ⊤

private lemma table1HilbertSpace_holds (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    Table1HilbertSpace n ħ m := by
  refine ⟨momentumFock_separable n, momentumFock_infinite_dim n, ?_, ?_⟩
  · intro h hM hn hi hh
    exact coherentVec_realSchwartz_dense (modeDispersion m) (modeDispersion_measurable m) m ħ
      hm hħ (modeDispersion_ge_m m) h hM hn hi hh
  · intro F _ _ _ b hb hgram
    let H := momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
    have hcoh_dense :
        Dense (Submodule.span ℂ
          (Set.range (coherentVec (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))))) :
          Set H) := by
      rw [dense_iff_closure_eq]
      have hcl := congrArg (fun S : Submodule ℂ H ↦ (S : Set H))
        (coherentVec_dense (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))))
      simpa [Submodule.topologicalClosure_coe] using hcl
    exact gram_total_unique (coherentVec (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))) b
      hcoh_dense hb fun u v ↦ by rw [coherentVec_gram, hgram]

private lemma table1UnitaryEvolution_holds (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    Table1UnitaryEvolution n ħ m :=
  ⟨fockUnitary_zero volume (modeDispersion m) (modeDispersion_measurable m),
   fockUnitary_add volume (modeDispersion m) (modeDispersion_measurable m),
   fockUnitary_norm volume (modeDispersion m) (modeDispersion_measurable m),
   fockUnitary_hasDerivAt_iff volume hħ.ne' (modeDispersion m) (modeDispersion_measurable m),
   fun _ _ hφ hψ ↦ fockH_symm volume ħ (modeDispersion m) (modeDispersion_measurable m) hφ hψ,
   fun _ hψ ↦ modeFockH_nonneg volume hħ hm hψ⟩

private lemma table1TensorProduct_holds {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [SigmaFinite μ] : Table1TensorProduct μ :=
  momentumFock_tensor_unique μ μ

private lemma table1BornRule_holds (H : Type*) [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] [SecondCountableTopology H]
    (hinf : ¬ Module.Finite ℂ H) : Table1BornRule H :=
  fun ψ hψ ↦ ⟨existsUnique_event_weights hinf ψ hψ, born_satisfies_event_rules ψ hψ⟩

private lemma table1SelfAdjointObservables_holds (H : Type*) [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] : Table1SelfAdjointObservables H :=
  fun P ↦ ⟨pvmDom_dense P, pvmOp_selfAdjoint P, fun _ hψ ↦ pvmOp_expectation P hψ⟩

private lemma table1ProjectionUpdate_holds.{u} (H : Type*) [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] : Table1ProjectionUpdate.{u} H := by
  refine ⟨fun K ψ hv ↦ pure_update_exists_unique K ψ hv, fun ρ K hpos ↦ ?_⟩
  obtain ⟨hcomp, hself, hsub, hca, huniq⟩ := normal_mixture_luders_update ρ K hpos
  refine ⟨?_, hcomp, fun ι b ↦ densityOp_basis_trace_eq_mixTrace b ρ K⟩
  refine ⟨densityOp (condMixture ρ K hpos),
    ⟨mixTrace (condMixture ρ K hpos),
      fun A ↦ ⟨mixTrace_nonneg _ A, mixTrace_le_one _ A⟩,
      fun A B hAB ↦ binary_of_countable hca A B hAB,
      hself,
      densityOp_inner_eq_mixTrace_ray (condMixture ρ K hpos),
      fun y hy ↦ by
        have hray : ray y ≤ K := (Submodule.span_singleton_le_iff_mem _ _).mpr hy
        rw [hsub (ray y) hray, div_mul_cancel₀ _ hpos.ne']⟩,
    fun σ ⟨post, hprob, hadd, hc, hσray, hratio⟩ ↦ huniq σ post hprob hadd hc hσray hratio⟩

private lemma table1PoincareCovariance_holds (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    Table1PoincareCovariance n hħ hm := by
  have hW := wightman_axioms_on_momentumFock n hħ hm
  refine ⟨fun g f ψ ↦
      ⟨fockPoincare_vacuum n m hm g, rfl,
       fockPoincare_intertwines_wightmanField n ħ m hħ hm g f ψ⟩,
    fockPoincare_translation n m hm,
    fockPoincare_rotation n m hm,
    fockPoincare_directionalBoost n m hm,
    hW.2.2.2.2.2.1,
    hW.2.2.2.2.2.2.1,
    fun u hu s t f ψ ↦
      ⟨fockDirectionalBoost_zero n m hm u,
       fockDirectionalBoost_add n m hm u s t,
       fockDirectionalBoost_vacuum n m hm u t,
       fockDirectionalBoost_intertwines_wightmanField n ħ m hħ hm u hu t f ψ⟩,
    fun u s t v vbar ψ ↦
      ⟨fockDirectionalBoost_zero n m hm u,
       fockDirectionalBoost_add n m hm u s t,
       (hW.2.2.2.2.2.2.2 u t v vbar ψ).1,
       (hW.2.2.2.2.2.2.2 u t v vbar ψ).2⟩⟩

private lemma table1ForwardConeSpectrum_holds (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    Table1ForwardConeSpectrum n ħ m hm :=
  ⟨fun S k ↦ sector_forward S m k,
   fun S k ↦ sector_energy_spectrum S ħ m hħ hm k,
   fun s hs ψ k ↦ fockShift_sector_norm_le volume (modeDispersion m) (modeDispersion_measurable m)
     hm.le (modeDispersion_ge_m m) s hs ψ k⟩

private lemma table1UniqueVacuum_holds (n : ℕ) (ħ : ℝ) {m : ℝ} (hm : 0 < m) :
    Table1UniqueVacuum n ħ m hm :=
  ⟨fockH_vacuum volume ħ (modeDispersion m) (modeDispersion_measurable m),
   fun _ hs ψ ↦ fockShift_fixed_iff_mem_vacuum volume (modeDispersion m)
     (modeDispersion_measurable m) hm (modeDispersion_ge_m m) hs ψ,
   fun S k ↦ sector_zero_iff S m hm k⟩

private lemma table1FieldDistributions_holds (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    Table1FieldDistributions n hħ hm := by
  have hW := wightman_axioms_on_momentumFock n hħ hm
  let H := momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
  have hcore_dense :
      Dense (FiniteParticleFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))) : Set H) := by
    rw [dense_iff_closure_eq]
    have hcl := congrArg (fun S : Submodule ℂ H ↦ (S : Set H))
      (finiteParticle_dense (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))))
    simpa [Submodule.topologicalClosure_coe] using hcl
  exact ⟨hcore_dense, hW.2.1, hW.2.2.1, hW.2.2.2.1⟩

private lemma table1SpacelikeCommutativity_holds (n : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    Table1SpacelikeCommutativity n hħ hm :=
  fun f f' hf hf' hsep ψ ↦ sub_eq_zero.mp (wightman_spacelike_locality hħ hm f f' hf hf' hsep ψ)

private lemma table1CyclicVacuum_holds (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    Table1CyclicVacuum n ħ m :=
  fun h hM hn hi hh ↦
    contField_vacuum_cyclic_realSchwartz (modeDispersion m) (modeDispersion_measurable m)
      m ħ hm hħ (modeDispersion_ge_m m) h hM hn hi hh

/-- **Master Capstone Theorem (Table 1, all 12 rows unified on one concrete Hilbert space).**

For every spatial dimension `n + 1` (`D = (n + 1) + 1 ≥ 2`) and every `ħ > 0`, `m > 0`, on the
single concrete Hilbert space
`H := momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))`, vacuum `Ω := fockVacuum`,
unitary time evolution `U := fockUnitary`, Hamiltonian `fockH`, and tempered field
`Φ := wightmanField` with dense finite-particle core `core := FiniteParticleFock`:

- **von Neumann axioms (Rows 1–6):**
  1. `Table1HilbertSpace`: separable, infinite-dimensional Hilbert space with real-Schwartz
     coherent totality and unique coherent Gram realization up to unitary equivalence.
  2. `Table1UnitaryEvolution`: strongly continuous unitary time evolution with exact Schrödinger
     generator domain `Dom(H)`, symmetric nonnegative mass-shell Hamiltonian `fockH`.
  3. `Table1TensorProduct`: canonical completed Hilbert tensor product
     `H ⊗̂ H ≃ₗᵢ[ℂ] momentumFock (sumMeasure volume volume)`.
  4. `Table1BornRule`: existence and uniqueness of Born-rule event weights `‖P_K ψ‖²` for every
     unit vector `ψ ∈ H`.
  5. `Table1SelfAdjointObservables`: self-adjoint unbounded observables `A = ∫ a dP(a)` on dense
     `pvmDom P` for every Borel PVM `P` on `H`.
  6. `Table1ProjectionUpdate`: pure-state normalized projection ray uniqueness, normal-mixture
     Lüders operator uniqueness, and basis-independent Hilbert-space operator trace
     `Tr(ρ P_K) = mixTrace ρ K`.
- **Wightman axioms (Rows 7–12):**
  7. `Table1PoincareCovariance`: single unified unitary representation `fockPoincare` of the full
     orthochronous Poincaré group `ℝ^{1,n+1} ⋊ O⁺(1, n + 1)` fixing `Ω`, intertwining `Φ` under
     spacetime pullback `poincareSchwartz`, and restricting to spacetime translations, `O(n + 1)`
     rotations, and 1-parameter directional Lorentz boosts (with spacetime boost pullback
     `fockDirectionalBoost_intertwines_wightmanField`).
  8. `Table1ForwardConeSpectrum`: forward-cone energy-momentum spectrum `{0} ∪ [ħm, ∞)` and
     exponential shift contraction decay.
  9. `Table1UniqueVacuum`: unique zero-energy vacuum (`fockH Ω = 0`,
     `fockShift s ψ = ψ ↔ ψ ∈ ℂ · Ω`, `sector_zero_iff`).
  10. `Table1FieldDistributions`: dense finite-particle core containing `Ω`, tempered-distribution
      continuity of matrix elements `f ↦ ⟨φ, Φ(f) ψ⟩`, and real-test Hermiticity.
  11. `Table1SpacelikeCommutativity`: unconditional spacelike commutativity `[Φ(f), Φ(f')] ψ = 0`
      for compactly supported real Schwartz tests with spacelike-separated supports.
  12. `Table1CyclicVacuum`: real-Schwartz vacuum cyclicity of the field polynomial algebra. -/
theorem theorem1_table1_axioms.{u} (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    let H := momentumFock (volume : Measure (EuclideanSpace ℝ (Fin (n + 1))))
    Table1HilbertSpace n ħ m ∧
    Table1UnitaryEvolution n ħ m ∧
    Table1TensorProduct (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))) ∧
    Table1BornRule H ∧
    Table1SelfAdjointObservables H ∧
    Table1ProjectionUpdate.{u} H ∧
    Table1PoincareCovariance n hħ.le hm ∧
    Table1ForwardConeSpectrum n ħ m hm ∧
    Table1UniqueVacuum n ħ m hm ∧
    Table1FieldDistributions n hħ.le hm ∧
    Table1SpacelikeCommutativity n hħ.le hm ∧
    Table1CyclicVacuum n ħ m := by
  intro H
  have : TopologicalSpace.SeparableSpace H := momentumFock_separable n
  have : SecondCountableTopology H := UniformSpace.secondCountable_of_separable H
  exact ⟨table1HilbertSpace_holds n hħ hm,
    table1UnitaryEvolution_holds n hħ hm,
    table1TensorProduct_holds (volume : Measure (EuclideanSpace ℝ (Fin (n + 1)))),
    table1BornRule_holds H (momentumFock_infinite_dim n),
    table1SelfAdjointObservables_holds H,
    table1ProjectionUpdate_holds.{u} H,
    table1PoincareCovariance_holds n hħ.le hm,
    table1ForwardConeSpectrum_holds n hħ hm,
    table1UniqueVacuum_holds n ħ hm,
    table1FieldDistributions_holds n hħ.le hm,
    table1SpacelikeCommutativity_holds n hħ.le hm,
    table1CyclicVacuum_holds n hħ hm⟩

end Table1Capstone

end DotProduct

/-! ### Fourier uniqueness on coordinate laws -/

/-!
# Fourier characters determine a dense family in complex L²

Lean 4.34.1, mathlib d13f23b723b8a846827a245b89c10fc7d3f11612.
Adapted from the prior checked V2CharacterDensity proof. The finite-measure argument applies
to real Hilbert-space laws and arbitrary cylinder laws, including uncountable index types.
-/

open MeasureTheory BoundedContinuousFunction
open scoped ENNReal RealInnerProductSpace ComplexConjugate

namespace DotChar

/-- Both concrete families below prove the measure-determination field from mathlib. -/
structure PhaseFamily (Ω T : Type*) [MeasurableSpace Ω] where
  phase : T → Ω → ℂ
  measurable_phase : ∀ t, Measurable (phase t)
  norm_phase_le : ∀ t x, ‖phase t x‖ ≤ 1
  opposite : T → T
  conj_opposite : ∀ t x, conj (phase (opposite t) x) = phase t x
  determines : ∀ {P Q : Measure Ω} [IsFiniteMeasure P] [IsFiniteMeasure Q],
    (∀ t, (∫ x, phase t x ∂P) = ∫ x, phase t x ∂Q) → P = Q

namespace PhaseFamily

variable {Ω T : Type*} [MeasurableSpace Ω] (C : PhaseFamily Ω T)
variable {μ : Measure Ω} [IsFiniteMeasure μ]

private theorem nonneg_weighted_ext {p q : Ω → ℝ}
    (hp : Integrable p μ) (hq : Integrable q μ)
    (hp₀ : ∀ x, 0 ≤ p x) (hq₀ : ∀ x, 0 ≤ q x)
    (h : ∀ t, (∫ x, (p x : ℂ) * C.phase t x ∂μ) =
        ∫ x, (q x : ℂ) * C.phase t x ∂μ) : p =ᵐ[μ] q := by
  have fin (w : Ω → ℝ) (hw : Integrable w μ) (hw₀ : ∀ x, 0 ≤ w x) :
      IsFiniteMeasure (μ.withDensity (fun x ↦ ENNReal.ofReal (w x))) := by
    apply isFiniteMeasure_withDensity
    rw [← ofReal_integral_eq_lintegral_ofReal hw (.of_forall hw₀)]
    exact ENNReal.ofReal_ne_top
  let := fin p hp hp₀
  let := fin q hq hq₀
  have tr (w : Ω → ℝ) (hw : Integrable w μ) (hw₀ : ∀ x, 0 ≤ w x) (t : T) :
      (∫ x, C.phase t x ∂μ.withDensity (fun x ↦ ENNReal.ofReal (w x))) =
        ∫ x, (w x : ℂ) * C.phase t x ∂μ := by
    rw [integral_withDensity_eq_integral_toReal_smul₀ hw.aemeasurable.ennreal_ofReal
      (.of_forall fun _ ↦ ENNReal.ofReal_lt_top) _]
    apply integral_congr_ae
    exact .of_forall fun x ↦ by
      change (ENNReal.ofReal (w x)).toReal • C.phase t x = (w x : ℂ) * C.phase t x
      rw [ENNReal.toReal_ofReal (hw₀ x), Complex.real_smul]
  have eqμ : μ.withDensity (fun x ↦ ENNReal.ofReal (p x)) =
      μ.withDensity (fun x ↦ ENNReal.ofReal (q x)) :=
    C.determines (fun t ↦ (tr p hp hp₀ t).trans ((h t).trans (tr q hq hq₀ t).symm))
  have hae := (withDensity_eq_iff_of_sigmaFinite hp.aemeasurable.ennreal_ofReal
    hq.aemeasurable.ennreal_ofReal).1 eqμ
  filter_upwards [hae] with x hx
  have hx' := congrArg ENNReal.toReal hx
  simpa [ENNReal.toReal_ofReal (hp₀ x), ENNReal.toReal_ofReal (hq₀ x)] using hx'

omit [IsFiniteMeasure μ] in
private theorem integrable_mul_phase {v : Ω → ℂ} (hv : Integrable v μ) (t : T) :
    Integrable (fun x ↦ v x * C.phase t x) μ :=
  hv.mul_bdd (C.measurable_phase t).aestronglyMeasurable (.of_forall (C.norm_phase_le t))

private theorem real_annihilator {f : Ω → ℝ} (hf : Integrable f μ)
    (h : ∀ t, ∫ x, (f x : ℂ) * C.phase t x ∂μ = 0) : f =ᵐ[μ] 0 := by
  have he : (fun x ↦ f x + |f x|) =ᵐ[μ] (fun x ↦ |f x|) := by
    apply C.nonneg_weighted_ext (hf.add hf.abs) hf.abs
      (fun x ↦ by dsimp; linarith [neg_le_abs (f x)]) (fun x ↦ abs_nonneg _)
    intro t
    change (∫ x, ((f x + |f x| : ℝ) : ℂ) * C.phase t x ∂μ) = ∫ x, ((|f x| : ℝ) : ℂ) * C.phase t x ∂μ
    simp only [Complex.ofReal_add, add_mul]
    calc
      _ = (∫ x, (f x : ℂ) * C.phase t x ∂μ) +
          (∫ x, ((|f x| : ℝ) : ℂ) * C.phase t x ∂μ) :=
        integral_add (C.integrable_mul_phase hf.ofReal t)
          (C.integrable_mul_phase hf.abs.ofReal t)
      _ = _ := by rw [h t, zero_add]
  filter_upwards [he] with x hx
  change f x + |f x| = |f x| at hx
  change f x = 0
  linarith

omit [IsFiniteMeasure μ] in
private theorem re_annihilates {f : Ω → ℂ} (hf : Integrable f μ)
    (h : ∀ t, ∫ x, f x * C.phase t x ∂μ = 0) (t : T) :
    ∫ x, ((f x).re : ℂ) * C.phase t x ∂μ = 0 := by
  have ha := C.integrable_mul_phase hf (C.opposite t)
  have hb : Integrable (fun x ↦ conj (f x * C.phase (C.opposite t) x)) μ := by
    apply ha.mono
    · exact Complex.continuous_conj.comp_aestronglyMeasurable ha.aestronglyMeasurable
    · exact .of_forall fun x ↦ by simp
  have hr (z : ℂ) : 2 * (z.re : ℂ) = z + conj z := by
    apply Complex.ext
    · simp [Complex.add_re, Complex.mul_re]
      ring
    · simp [Complex.add_im, Complex.mul_im]
  have hd : (2 : ℂ) * (∫ x, ((f x).re : ℂ) * C.phase t x ∂μ) = 0 := calc
    _ = ∫ x, f x * C.phase t x + conj (f x * C.phase (C.opposite t) x) ∂μ := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      exact .of_forall fun x ↦ by
        change (2:ℂ) * ((↑(f x).re : ℂ) * C.phase t x) = _
        simp only [map_mul, C.conj_opposite, ← add_mul, ← hr]
        ring
    _ = 0 := by rw [integral_add (C.integrable_mul_phase hf t) hb, integral_conj, h, h]; simp
  exact (mul_eq_zero.mp hd).resolve_left (by norm_num)

theorem complex_annihilator {f : Ω → ℂ} (hf : Integrable f μ)
    (h : ∀ t, ∫ x, f x * C.phase t x ∂μ = 0) : f =ᵐ[μ] 0 := by
  have hr := C.real_annihilator hf.re (C.re_annihilates hf h)
  have hi (t : T) : ∫ x, ((-Complex.I) * f x) * C.phase t x ∂μ = 0 := by
    simp only [mul_assoc, integral_const_mul, h, mul_zero]
  have him := C.real_annihilator (hf.const_mul (-Complex.I)).re
    (C.re_annihilates (hf.const_mul (-Complex.I)) hi)
  filter_upwards [hr, him] with x hx hy
  apply Complex.ext
  · exact hx
  · change ((-Complex.I) * f x).re = 0 at hy
    simpa [Complex.mul_re] using hy

variable (μ) in
noncomputable def phaseLp (t : T) : Lp ℂ 2 μ :=
  (MemLp.of_bound (p := 2) (μ := μ) (C.measurable_phase t).aestronglyMeasurable 1
    (.of_forall (C.norm_phase_le t))).toLp (C.phase t)

theorem phaseLp_ae (t : T) : (C.phaseLp μ t : Ω → ℂ) =ᵐ[μ] C.phase t :=
  MemLp.coeFn_toLp _

theorem total :
    (Submodule.span ℂ (Set.range (C.phaseLp μ))).topologicalClosure = ⊤ := by
  let S := Submodule.span ℂ (Set.range (C.phaseLp μ))
  let K := S.topologicalClosure
  let : CompleteSpace K := S.isClosed_topologicalClosure.completeSpace_coe
  have mem (t : T) : C.phaseLp μ t ∈ K :=
    S.le_topologicalClosure (Submodule.subset_span ⟨t, rfl⟩)
  have orth (v : Lp ℂ 2 μ) (hv : v ∈ Kᗮ) : v = 0 := by
    have ha : (v : Ω → ℂ) =ᵐ[μ] 0 := by
      apply C.complex_annihilator ((Lp.memLp v).integrable (by norm_num))
      intro t
      calc (∫ x, v x * C.phase t x ∂μ) = inner ℂ (C.phaseLp μ (C.opposite t)) v := by
             rw [L2.inner_def]
             apply integral_congr_ae
             filter_upwards [C.phaseLp_ae (μ := μ) (C.opposite t)] with x hx
             rw [RCLike.inner_apply, hx, C.conj_opposite]
           _ = 0 := (K.mem_orthogonal v).1 hv _ (mem (C.opposite t))
    exact Lp.eq_zero_iff_ae_eq_zero.mpr ha
  apply top_unique
  intro y _
  obtain ⟨w, hw, hr⟩ := Submodule.HasOrthogonalProjection.exists_orthogonal (K := K) y
  exact (sub_eq_zero.mp (orth _ hr)).symm ▸ hw

end PhaseFamily

section Hilbert

variable (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
  [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]

noncomputable def hilbertPhases : PhaseFamily E E where
  phase t x := innerProbChar t x
  measurable_phase t := (innerProbChar t).continuous.measurable
  norm_phase_le t x := by simp [innerProbChar_apply, Complex.norm_exp, Complex.mul_re]
  opposite t := -t
  conj_opposite t x := by simp [innerProbChar_apply, ← Complex.exp_conj]
  determines := by
    intro P Q _ _ h
    apply Measure.ext_of_charFun
    funext t
    simpa only [charFun_eq_integral_innerProbChar] using h t

/-- Specialize E to EuclideanSpace ℝ (Fin n) for the joint law of n readings. -/
theorem fourierChars_total (μ : Measure E) [IsFiniteMeasure μ] :
    (Submodule.span ℂ (Set.range ((hilbertPhases E).phaseLp μ))).topologicalClosure = ⊤ :=
  (hilbertPhases E).total (μ := μ)

end Hilbert

section Cylinders

variable {ι : Type*}

theorem cylindrical_char_ext {P Q : Measure (ι → ℝ)} [IsFiniteMeasure P] [IsFiniteMeasure Q]
    (h : ∀ (I : Finset ι) (L : StrongDual ℝ (I → ℝ)),
      (∫ x, probCharDual L (I.restrict x) ∂P) = ∫ x, probCharDual L (I.restrict x) ∂Q) :
    P = Q := by
  classical
  apply IsProjectiveLimit.unique (P := fun I : Finset ι ↦ P.map I.restrict) (fun _ ↦ rfl)
  intro I
  apply Measure.ext_of_charFunDual
  funext L
  have hm : Measurable (I.restrict : (ι → ℝ) → (I → ℝ)) :=
    Measurable.of_eval fun i ↦ measurable_pi_apply (i : ι)
  change (∫ x, probCharDual L x ∂Q.map I.restrict) = ∫ x, probCharDual L x ∂P.map I.restrict
  rw [integral_map hm.aemeasurable (probCharDual L).continuous.aestronglyMeasurable,
      integral_map hm.aemeasurable (probCharDual L).continuous.aestronglyMeasurable]
  exact (h I L).symm

/-- A label records the finite set of readings used and a linear form on that finite list. -/
abbrev CylinderLabel (ι : Type*) := (I : Finset ι) × StrongDual ℝ (I → ℝ)

noncomputable def cylinderPhases (ι : Type*) : PhaseFamily (ι → ℝ) (CylinderLabel ι) where
  phase t x := probCharDual t.2 (t.1.restrict x)
  measurable_phase t := (probCharDual t.2).continuous.measurable.comp
    (Measurable.of_eval fun i ↦ measurable_pi_apply (i : ι))
  norm_phase_le t x := by simp [probCharDual_apply, Complex.norm_exp, Complex.mul_re]
  opposite t := ⟨t.1, -t.2⟩
  conj_opposite t x := by simp [probCharDual_apply, ← Complex.exp_conj]
  determines := by
    intro P Q _ _ h
    exact cylindrical_char_ext (fun I L ↦ h ⟨I, L⟩)

/-- No countability requirement on the label space. The product σ-algebra is intentional. -/
theorem cylinderPhases_total (μ : Measure (ι → ℝ)) [IsFiniteMeasure μ] :
    (Submodule.span ℂ (Set.range ((cylinderPhases ι).phaseLp μ))).topologicalClosure = ⊤ :=
  (cylinderPhases ι).total (μ := μ)

end Cylinders

/-- The deterministic nonzero Wick normalization preserves the span of the character family. -/
theorem span_scaled_family {ι V : Type*} [AddCommGroup V] [Module ℂ V]
    (v : ι → V) (c : ι → ℂ) (hc : ∀ i, c i ≠ 0) :
    Submodule.span ℂ (Set.range (fun i ↦ c i • v i)) = Submodule.span ℂ (Set.range v) := by
  apply le_antisymm
  · apply Submodule.span_le.2
    rintro _ ⟨i, rfl⟩
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  · apply Submodule.span_le.2
    rintro _ ⟨i, rfl⟩
    have hm : c i • v i ∈ Submodule.span ℂ (Set.range (fun j ↦ c j • v j)) :=
      Submodule.subset_span ⟨i, rfl⟩
    simpa [smul_smul, hc i] using Submodule.smul_mem _ (c i)⁻¹ hm

end DotChar


/-! ### The Gaussian product probability space -/

namespace DotProduct.Extension

open MeasureTheory ProbabilityTheory
open scoped BigOperators

/-- The canonical product of standard real Gaussian coordinate laws. -/
noncomputable def standardGaussianProduct (ι : Type*) : Measure (ι → ℝ) :=
  Measure.infinitePi (fun _ : ι ↦ gaussianReal 0 1)

instance (ι : Type*) : IsProbabilityMeasure (standardGaussianProduct ι) := by
  unfold standardGaussianProduct
  infer_instance

/-- The variance of a finite coordinate combination is the sum of its squared
coefficients. This is the characteristic-function statement on the actual product law. -/
theorem gaussianProduct_char_finite {ι : Type*} (s : Finset ι) (c : ι → ℝ) :
    (∫ x, Complex.exp ((↑(∑ i : s, c i * x i) : ℂ) * Complex.I)
      ∂standardGaussianProduct ι) =
      Complex.exp (-(↑(∑ i : s, (c i) ^ 2) : ℂ) / 2) := by
  classical
  let F (x : s → ℝ) : ℂ :=
    Complex.exp ((↑(∑ i : s, c i * x i) : ℂ) * Complex.I)
  have hF : Measurable F := by
    dsimp [F]
    fun_prop
  have hR : Measurable (Finset.restrict (π := fun _ : ι ↦ ℝ) s) :=
    Finset.measurable_restrict s
  have hmap : (standardGaussianProduct ι).map (Finset.restrict s) =
      Measure.pi (fun _ : s ↦ gaussianReal 0 1) := by
    unfold standardGaussianProduct
    exact Measure.infinitePi_map_restrict _
  change (∫ x, F (Finset.restrict s x) ∂standardGaussianProduct ι) = _
  rw [← integral_map hR.aemeasurable hF.aestronglyMeasurable, hmap]
  unfold F
  simp_rw [Complex.ofReal_sum, Finset.sum_mul, Complex.exp_sum,
    integral_fintype_prod_eq_prod (f := fun i : s ↦ fun x : ℝ ↦
      Complex.exp ((↑(c i * x) : ℂ) * Complex.I)),
  ]
  have hcol (i : s) :
      (∫ x : ℝ, Complex.exp ((↑(c i * x) : ℂ) * Complex.I) ∂gaussianReal 0 1) =
        charFun (gaussianReal 0 1) (c i) := by
    rw [charFun_apply_real]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun x ↦ by simp only [Complex.ofReal_mul]
  simp_rw [hcol, charFun_gaussianReal]
  simp only [Complex.ofReal_zero, mul_zero, zero_mul, NNReal.coe_one, Complex.ofReal_one,
    one_mul, zero_sub]
  rw [← Complex.exp_sum, Finset.sum_neg_distrib]
  apply congrArg Complex.exp
  rw [← Finset.sum_div]
  simp only [Complex.ofReal_pow, neg_div]

end DotProduct.Extension


/-! ### Orthonormal Gaussian coordinates -/

namespace DotProduct.Extension

open MeasureTheory ProbabilityTheory
open scoped InnerProductSpace

private theorem gaussianProduct_map_eval {ι : Type*} (i : ι) :
    (standardGaussianProduct ι).map (fun x ↦ x i) = gaussianReal 0 1 :=
  Measure.infinitePi_map_eval _ i

theorem gaussianProduct_coordinate_memLp {ι : Type*} (i : ι) :
    MemLp (fun x ↦ x i) 2 (standardGaussianProduct ι) := by
  have h : MemLp id 2 ((standardGaussianProduct ι).map (fun x ↦ x i)) := by
    rw [gaussianProduct_map_eval]
    exact memLp_id_gaussianReal' 2 (by simp)
  exact h.comp_of_map (measurable_pi_apply i).aemeasurable

noncomputable def gaussianProductCoordinate {ι : Type*} (i : ι) :
    Lp ℝ 2 (standardGaussianProduct ι) :=
  (gaussianProduct_coordinate_memLp i).toLp _

theorem gaussianProductCoordinate_ae {ι : Type*} (i : ι) :
    gaussianProductCoordinate i =ᵐ[standardGaussianProduct ι] fun x ↦ x i :=
  MemLp.coeFn_toLp (gaussianProduct_coordinate_memLp i)

private theorem inner_gaussianProductCoordinate {ι : Type*} (i j : ι) :
    ⟪gaussianProductCoordinate i, gaussianProductCoordinate j⟫_ℝ =
      ∫ x, x i * x j ∂standardGaussianProduct ι := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [gaussianProductCoordinate_ae i, gaussianProductCoordinate_ae j] with x hi hj
  rw [hi, hj, RCLike.inner_apply]
  simp [mul_comm]

theorem gaussianProductCoordinate_orthonormal (ι : Type*) :
    Orthonormal ℝ (@gaussianProductCoordinate ι) := by
  classical
  rw [orthonormal_iff_ite]
  intro i j
  rw [inner_gaussianProductCoordinate]
  by_cases hij : i = j
  · subst j
    simp only [ite_true]
    have hv : Var[id; gaussianReal 0 1] = 1 := by simp [variance_id_gaussianReal]
    rw [variance_eq_integral (measurable_id.aemeasurable)] at hv
    change (∫ y : ℝ, (y - ∫ z : ℝ, z ∂gaussianReal 0 1) ^ 2 ∂gaussianReal 0 1) = 1 at hv
    rw [integral_id_gaussianReal] at hv
    have hEval : Measurable (fun x : ι → ℝ ↦ x i) := by fun_prop
    have hSq : Measurable (fun y : ℝ ↦ y ^ 2) := by fun_prop
    change (∫ x : ι → ℝ, x i * x i ∂standardGaussianProduct ι) = 1
    simp only [sub_zero] at hv
    simp_rw [← pow_two]
    rw [← integral_map hEval.aemeasurable hSq.aestronglyMeasurable, gaussianProduct_map_eval]
    exact hv
  · simp only [hij, ite_false]
    have hm : Measurable (fun x : ι → ℝ ↦ (x i, x j)) := by fun_prop
    have hMul : Measurable (fun x : ℝ × ℝ ↦ x.1 * x.2) := by fun_prop
    have hmap : (standardGaussianProduct ι).map (fun x ↦ (x i, x j)) =
        (gaussianReal 0 1).prod (gaussianReal 0 1) := by
      unfold standardGaussianProduct
      exact Measure.infinitePi_map_eval_prod hij
    rw [← integral_map hm.aemeasurable hMul.aestronglyMeasurable, hmap]
    rw [integral_prod_mul (fun x : ℝ ↦ x) (fun x : ℝ ↦ x), integral_id_gaussianReal]
    simp

end DotProduct.Extension


/-! ### Isonormal synthesis -/

namespace DotProduct.Extension

open MeasureTheory ProbabilityTheory
open scoped InnerProductSpace

variable {ι H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

noncomputable def gaussianProductSynthesis (ι : Type*) :
    lp (fun _ : ι ↦ ℝ) 2 →ₗᵢ[ℝ] Lp ℝ 2 (standardGaussianProduct ι) :=
  (gaussianProductCoordinate_orthonormal ι).orthogonalFamily.linearIsometry

/-- Isonormal Gaussian readings, initially as real L² classes. -/
noncomputable def gaussianIsonormal (b : HilbertBasis ι ℝ H) :
    H →ₗᵢ[ℝ] Lp ℝ 2 (standardGaussianProduct ι) :=
  (gaussianProductSynthesis ι).comp b.repr.toLinearIsometry

theorem gaussianIsonormal_hasSum (b : HilbertBasis ι ℝ H) (x : H) :
    HasSum (fun i ↦ b.repr x i • gaussianProductCoordinate i) (gaussianIsonormal b x) := by
  exact (gaussianProductCoordinate_orthonormal ι).orthogonalFamily.hasSum_linearIsometry
    (b.repr x)

private theorem complexPhase_lipschitz :
    LipschitzWith 1 (fun x : ℝ ↦ Complex.exp ((x : ℂ) * Complex.I)) := by
  have hd (x : ℝ) : HasDerivAt (fun x : ℝ ↦ Complex.exp ((x : ℂ) * Complex.I))
      (Complex.exp ((x : ℂ) * Complex.I) * Complex.I) x := by
    have h := (Complex.ofRealCLM.hasDerivAt (x := x)).mul_const Complex.I
    simpa using h.cexp
  apply lipschitzWith_of_nnnorm_deriv_le (fun x ↦ (hd x).differentiableAt)
  intro x
  rw [(hd x).deriv]
  exact_mod_cast (show ‖Complex.exp ((x : ℂ) * Complex.I) * Complex.I‖ ≤ (1 : ℝ) by
    simp [Complex.norm_exp_ofReal_mul_I])

private theorem continuous_phaseIntegral {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] :
    Continuous (fun f : Lp ℝ 2 μ ↦ ∫ a, Complex.exp ((f a : ℂ) * Complex.I) ∂μ) := by
  let phase : ℝ → ℂ := fun x ↦ Complex.exp ((x : ℂ) * Complex.I)
  let shifted : ℝ → ℂ := fun x ↦ phase x - 1
  have hshift : LipschitzWith 1 shifted := by
    apply LipschitzWith.of_dist_le_mul
    intro x y
    rw [show dist (shifted x) (shifted y) = dist (phase x) (phase y) by
      simp [shifted, dist_eq_norm, sub_sub_sub_cancel_right]]
    exact complexPhase_lipschitz.dist_le_mul x y
  have hz : shifted 0 = 0 := by simp [shifted, phase]
  have hm : MemLp (fun _ : Ω ↦ (1 : ℂ)) 2 μ := memLp_const _
  let one : Lp ℂ 2 μ := hm.toLp _
  have heq (f : Lp ℝ 2 μ) :
      (∫ a, phase (f a) ∂μ) = ⟪one, hshift.compLp hz f + one⟫_ℂ := by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [hm.coeFn_toLp, hshift.coeFn_compLp hz f,
      Lp.coeFn_add (hshift.compLp hz f) one] with a ha hb hc
    change one a = 1 at ha
    rw [hc]
    change phase (f a) = ⟪one a, (hshift.compLp hz f) a + one a⟫_ℂ
    rw [ha, show (hshift.compLp hz f) a = shifted (f a) from hb]
    simp [shifted, RCLike.inner_apply]
  change Continuous (fun f : Lp ℝ 2 μ ↦ ∫ a, phase (f a) ∂μ)
  simp_rw [heq]
  exact continuous_const.inner ((hshift.continuous_compLp hz).add continuous_const)

private theorem gaussianCoordinate_sum_ae (s : Finset ι) (c : ι → ℝ) :
    (⇑(∑ i ∈ s, c i • gaussianProductCoordinate i) :
      (ι → ℝ) → ℝ) =ᵐ[standardGaussianProduct ι] fun a ↦ ∑ i ∈ s, c i * a i := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    exact Lp.coeFn_zero ℝ 2 (standardGaussianProduct ι)
  | @insert i s hi ih =>
    simp only [Finset.sum_insert hi]
    filter_upwards [Lp.coeFn_add (c i • gaussianProductCoordinate i)
      (∑ j ∈ s, c j • gaussianProductCoordinate j),
      Lp.coeFn_smul (c i) (gaussianProductCoordinate i),
      gaussianProductCoordinate_ae i, ih] with a ha hb hc hd
    rw [ha]
    change (c i • gaussianProductCoordinate i) a +
      (∑ j ∈ s, c j • gaussianProductCoordinate j : Lp ℝ 2 (standardGaussianProduct ι)) a = _
    rw [hd, hb]
    change c i * gaussianProductCoordinate i a + _ = _
    rw [hc]

/-- Every Hilbert label has the Gaussian characteristic function prescribed by its norm. -/
theorem gaussianIsonormal_char (b : HilbertBasis ι ℝ H) (x : H) :
    (∫ a, Complex.exp ((gaussianIsonormal b x a : ℂ) * Complex.I)
      ∂standardGaussianProduct ι) = Complex.exp (-(↑(‖x‖ ^ 2) : ℂ) / 2) := by
  classical
  let μ := standardGaussianProduct ι
  let c : ι → ℝ := fun i ↦ b.repr x i
  let F : Lp ℝ 2 μ → ℂ := fun f ↦ ∫ a, Complex.exp ((f a : ℂ) * Complex.I) ∂μ
  have hF : Continuous F := continuous_phaseIntegral μ
  have hl := hF.continuousAt.tendsto.comp (gaussianIsonormal_hasSum b x)
  have hsq : HasSum (fun i ↦ (c i) ^ 2) (‖x‖ ^ 2) := by
    convert b.hasSum_inner_mul_inner x x using 1
    · ext i
      simp [c, HilbertBasis.repr_apply_apply, real_inner_comm x (b i), pow_two]
    · exact (real_inner_self_eq_norm_sq x).symm
  let G : ℝ → ℂ := fun r ↦ Complex.exp (-(r : ℂ) / 2)
  have hG : Continuous G := by unfold G; fun_prop
  have hr := hG.continuousAt.tendsto.comp hsq
  change F (gaussianIsonormal b x) = G (‖x‖ ^ 2)
  refine tendsto_nhds_unique hl ?_
  convert hr using 1
  ext s
  change F (∑ i ∈ s, c i • gaussianProductCoordinate i) = G (∑ i ∈ s, (c i) ^ 2)
  unfold F G
  calc
    _ = ∫ a, Complex.exp ((↑(∑ i ∈ s, c i * a i) : ℂ) * Complex.I) ∂μ := by
      apply integral_congr_ae
      filter_upwards [gaussianCoordinate_sum_ae s c] with a ha
      rw [ha]
    _ = _ := by
      have h := gaussianProduct_char_finite s c
      have hsum (g : ι → ℝ) : (∑ i : s, g i) = ∑ i ∈ s, g i := by
        change (∑ i ∈ s.attach, g i) = _
        exact Finset.sum_attach s g
      have heq :
          (fun x : ι → ℝ ↦ ∑ i : s, c i * x i) = (fun x ↦ ∑ i ∈ s, c i * x i) := by
        funext x
        exact hsum (fun i ↦ c i * x i)
      have hrhs := hsum (fun i ↦ (c i) ^ 2)
      calc
        _ = ∫ a, Complex.exp ((↑((fun x : ι → ℝ ↦ ∑ i : s, c i * x i) a) : ℂ) *
            Complex.I) ∂standardGaussianProduct ι := by rw [heq]
        _ = Complex.exp (-(↑(∑ i : s, (c i) ^ 2) : ℂ) / 2) := h
        _ = _ := by rw [hrhs]

end DotProduct.Extension


/-! ### Pointwise linear field readings -/

namespace DotProduct.Extension

open MeasureTheory
open scoped InnerProductSpace

section Representatives

variable {Ω H : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
  [AddCommGroup H] [Module ℝ H] (L : H →ₗ[ℝ] Lp ℝ 2 μ)
  {α : Type*} (a : Module.Basis α ℝ H)

private noncomputable def basisRepresentative (i : α) : Ω → ℝ :=
  (Lp.aestronglyMeasurable (L (a i))).mk (L (a i))

/-- A linear choice of measurable representatives, built on an algebraic basis.
Linearity holds at every sample; agreement with the L² class is per label almost everywhere. -/
noncomputable def linearRepresentatives (w : Ω) : H →ₗ[ℝ] ℝ :=
  a.constr ℝ (fun i ↦ basisRepresentative μ L a i w)

theorem linearRepresentatives_measurable (x : H) :
    Measurable (fun w ↦ linearRepresentatives μ L a w x) := by
  simp only [linearRepresentatives, Module.Basis.constr_apply, Finsupp.sum]
  refine Finset.measurable_sum _ fun i _ ↦ ?_
  have h : Measurable (basisRepresentative μ L a i) :=
    (Lp.aestronglyMeasurable (L (a i))).measurable_mk
  exact (measurable_const (a := a.repr x i)).smul h

theorem linearRepresentatives_ae (x : H) :
    (fun w ↦ linearRepresentatives μ L a w x) =ᵐ[μ] L x := by
  have h (x : H) : L x = ∑ i ∈ (a.repr x).support, a.repr x i • L (a i) := by
    conv_lhs => rw [← a.linearCombination_repr x]
    simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum, map_smul]
  rw [h x]
  simp only [linearRepresentatives, Module.Basis.constr_apply, Finsupp.sum]
  refine Filter.EventuallyEq.trans ?_ (Lp.coeFn_finsetSum _ _).symm
  change (fun w ↦ ∑ i ∈ (a.repr x).support, (a.repr x i) • basisRepresentative μ L a i w)
    =ᵐ[μ] (∑ i ∈ (a.repr x).support, ⇑(a.repr x i • L (a i)))
  have hsum : (fun w ↦ ∑ i ∈ (a.repr x).support, (a.repr x i) • basisRepresentative μ L a i w)
      = ∑ i ∈ (a.repr x).support, fun w ↦ (a.repr x i) • basisRepresentative μ L a i w := by
    funext w
    rw [Finset.sum_apply]
  rw [hsum]
  refine eventuallyEq_sum fun i _ ↦ ?_
  refine ((Lp.coeFn_smul (a.repr x i) (L (a i))).trans ?_).symm
  filter_upwards [(Lp.aestronglyMeasurable (L (a i))).ae_eq_mk] with w hw
  change a.repr x i • L (a i) w = a.repr x i • basisRepresentative μ L a i w
  exact congrArg (fun r : ℝ ↦ a.repr x i • r) hw

end Representatives

variable {ι H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Pointwise linear Gaussian readings satisfying the hypothesis of the plane-conditioning proof. -/
noncomputable def pointwiseGaussian (b : HilbertBasis ι ℝ H) :
    (ι → ℝ) → H →ₗ[ℝ] ℝ :=
  linearRepresentatives (standardGaussianProduct ι) (gaussianIsonormal b).toLinearMap
    (Module.Basis.ofVectorSpace ℝ H)

theorem pointwiseGaussian_measurable (b : HilbertBasis ι ℝ H) (x : H) :
    Measurable (fun w ↦ pointwiseGaussian b w x) :=
  linearRepresentatives_measurable _ _ _ x

theorem pointwiseGaussian_ae (b : HilbertBasis ι ℝ H) (x : H) :
    (fun w ↦ pointwiseGaussian b w x) =ᵐ[standardGaussianProduct ι] gaussianIsonormal b x :=
  linearRepresentatives_ae _ _ _ x

theorem pointwiseGaussian_char (b : HilbertBasis ι ℝ H) (x : H) :
    (∫ w, Complex.exp ((pointwiseGaussian b w x : ℂ) * Complex.I)
      ∂standardGaussianProduct ι) = (Real.exp (-(‖x‖ ^ 2) / 2) : ℂ) := by
  rw [Complex.ofReal_exp, Complex.ofReal_div, Complex.ofReal_neg]
  simp only [Complex.ofReal_ofNat]
  refine Eq.trans (integral_congr_ae ?_) (gaussianIsonormal_char b x)
  filter_upwards [pointwiseGaussian_ae b x] with w hw
  rw [hw]

end DotProduct.Extension


/-! ### Coordinate observables and total Wick characters -/

namespace DotProduct.Extension

open MeasureTheory Set Filter BoundedContinuousFunction
open scoped BigOperators

section Coordinates

variable {Ω R V : Type*} [MeasurableSpace Ω] [AddCommGroup V] [Module ℝ V]
  [NormedAddCommGroup R] [InnerProductSpace ℝ R]

/-- The coordinate realization of any family of linear readings. -/
def readingCoordinates (Φ : Ω → R →ₗ[ℝ] ℝ) (J : V →ₗ[ℝ] R) (ω : Ω) (f : V) : ℝ :=
  Φ ω (J f)

theorem measurable_readingCoordinates (Φ : Ω → R →ₗ[ℝ] ℝ)
    (hmeas : ∀ a, Measurable (fun ω ↦ Φ ω a)) (J : V →ₗ[ℝ] R) :
    Measurable (readingCoordinates Φ J) :=
  Measurable.of_eval fun f ↦ hmeas (J f)

private noncomputable def finiteReadingTest (t : DotChar.CylinderLabel V) : V := by
  classical
  exact ∑ i : t.1, t.2 (Pi.single i 1) • (i : V)

omit [MeasurableSpace Ω] in
private theorem finiteReadingTest_apply (Φ : Ω → R →ₗ[ℝ] ℝ) (J : V →ₗ[ℝ] R)
    (t : DotChar.CylinderLabel V) (ω : Ω) :
    t.2 (t.1.restrict (readingCoordinates Φ J ω)) = Φ ω (J (finiteReadingTest t)) := by
  classical
  let x := t.1.restrict (readingCoordinates Φ J ω)
  have hx : (∑ i : t.1, x i • Pi.single i (1 : ℝ)) = x := by
    funext j
    simp [Finset.sum_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, mul_ite]
  change t.2 x = _
  conv_lhs => rw [← hx]
  simp only [finiteReadingTest, map_sum, map_smul, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i _
  exact mul_comm _ _

omit [MeasurableSpace Ω] in
theorem cylinderPhase_on_readings (Φ : Ω → R →ₗ[ℝ] ℝ) (J : V →ₗ[ℝ] R)
    (t : DotChar.CylinderLabel V) (ω : Ω) :
    (DotChar.cylinderPhases V).phase t (readingCoordinates Φ J ω) =
      Complex.exp ((Φ ω (J (finiteReadingTest t)) : ℂ) * Complex.I) := by
  change probCharDual t.2 (t.1.restrict (readingCoordinates Φ J ω)) = _
  rw [probCharDual_apply, finiteReadingTest_apply, mul_comm]

/-- A Gaussian reading law is invariant under reflections acting isometrically in its
covariance inner product. This is an equality of the entire coordinate laws. -/
theorem gaussian_readingLaw_isometry (P : Measure Ω) [IsFiniteMeasure P]
    (Φ : Ω → R →ₗ[ℝ] ℝ) (hmeas : ∀ a, Measurable (fun ω ↦ Φ ω a))
    (hchar : ∀ a : R, (∫ w, Complex.exp ((Φ w a : ℂ) * Complex.I) ∂P) =
      (Real.exp (-(‖a‖ ^ 2) / 2) : ℂ))
    (θ : R ≃ₗᵢ[ℝ] R) (J : V →ₗ[ℝ] R) :
    P.map (readingCoordinates Φ (θ.toLinearEquiv.toLinearMap.comp J)) =
      P.map (readingCoordinates Φ J) := by
  apply DotChar.cylindrical_char_ext
  intro I L
  let t : DotChar.CylinderLabel V := ⟨I, L⟩
  let J' := θ.toLinearEquiv.toLinearMap.comp J
  let phase := (DotChar.cylinderPhases V).phase t
  change (∫ x, phase x ∂P.map (readingCoordinates Φ J')) =
    ∫ x, phase x ∂P.map (readingCoordinates Φ J)
  rw [integral_map (measurable_readingCoordinates Φ hmeas J').aemeasurable
    ((DotChar.cylinderPhases V).measurable_phase t).aestronglyMeasurable,
    integral_map (measurable_readingCoordinates Φ hmeas J).aemeasurable
    ((DotChar.cylinderPhases V).measurable_phase t).aestronglyMeasurable]
  simp only [cylinderPhase_on_readings, hchar, J', LinearMap.comp_apply,
    LinearEquiv.coe_coe, LinearIsometryEquiv.coe_toLinearEquiv, θ.norm_map]

variable (Q : Measure (V → ℝ)) [IsFiniteMeasure Q]

/-- Wick-normalized character on the preparation coordinate law. -/
noncomputable def wickCoordinate (J : V →ₗ[ℝ] R) (f : V) : Lp ℂ 2 Q :=
  let w : (V → ℝ) → ℂ := fun x ↦ Complex.exp ((‖J f‖ ^ 2 / 2 : ℝ) + (x f : ℂ) * Complex.I)
  have hm : Measurable w := Complex.continuous_exp.measurable.comp
    (measurable_const.add ((Complex.continuous_ofReal.measurable.comp
      (measurable_pi_apply f)).mul measurable_const))
  have hb (x : V → ℝ) : ‖w x‖ ≤ Real.exp (‖J f‖ ^ 2 / 2) := by
    rw [Complex.norm_exp]
    rw [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re, Complex.ofReal_im]
    simp
  (MemLp.of_bound hm.aestronglyMeasurable _ (Eventually.of_forall hb)).toLp w

theorem wickCoordinate_ae (J : V →ₗ[ℝ] R) (f : V) :
    ⇑(wickCoordinate Q J f) =ᵐ[Q]
      fun x ↦ Complex.exp ((‖J f‖ ^ 2 / 2 : ℝ) + (x f : ℂ) * Complex.I) := by
  unfold wickCoordinate
  apply MemLp.coeFn_toLp

/-- Wick exponential preparations span densely in the actual coordinate L² of a field
that is linear in its real tests. -/
theorem wickCoordinate_dense (P : Measure Ω) [IsFiniteMeasure P]
    (Φ : Ω → R →ₗ[ℝ] ℝ) (hmeas : ∀ a, Measurable (fun ω ↦ Φ ω a)) (J : V →ₗ[ℝ] R) :
    Dense (Submodule.span ℂ (range (wickCoordinate (P.map (readingCoordinates Φ J)) J)) :
      Set (Lp ℂ 2 (P.map (readingCoordinates Φ J)))) := by
  let P' := P.map (readingCoordinates Φ J)
  let C := DotChar.cylinderPhases V
  have hd : Dense (Submodule.span ℂ (range (C.phaseLp P')) : Set (Lp ℂ 2 P')) :=
    Submodule.dense_iff_topologicalClosure_eq_top.mpr (DotChar.cylinderPhases_total P')
  apply hd.mono
  apply Submodule.span_le.mpr
  rintro _ ⟨t, rfl⟩
  let f := finiteReadingTest t
  let z := Complex.exp (-(‖J f‖ ^ 2 / 2 : ℝ))
  have hphase : C.phase t =ᵐ[P'] fun x ↦ Complex.exp ((x f : ℂ) * Complex.I) := by
    apply (ae_map_iff (measurable_readingCoordinates Φ hmeas J).aemeasurable ?_).mpr
    · exact Eventually.of_forall (cylinderPhase_on_readings Φ J t)
    · have hq : Measurable (fun x : V → ℝ ↦ Complex.exp ((x f : ℂ) * Complex.I)) :=
        Complex.continuous_exp.measurable.comp
          ((Complex.continuous_ofReal.measurable.comp (measurable_pi_apply f)).mul measurable_const)
      exact (isClosed_eq (f := Prod.fst) (g := Prod.snd) continuous_fst continuous_snd).measurableSet.preimage
        ((C.measurable_phase t).prodMk hq)
  have hw : C.phaseLp P' t = z • wickCoordinate P' J f := by
    apply Lp.ext
    filter_upwards [hphase, C.phaseLp_ae (μ := P') t, wickCoordinate_ae P' J f,
      Lp.coeFn_smul z (wickCoordinate P' J f)] with x hx hy hw hs
    rw [hy, hx, hs, Pi.smul_apply, hw, smul_eq_mul, ← Complex.exp_add]
    congr 1
    ring
  rw [hw]
  exact Submodule.smul_mem _ _ (Submodule.subset_span (mem_range_self f))

end Coordinates

end DotProduct.Extension


/-! ### Conditional expectation in the observed law -/

namespace DotProduct.Extension

open MeasureTheory Filter

variable {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
  (P : Measure Ω) (obs : Ω → X) (hobs : Measurable obs)

/-- Pullback along an observation lands in the L² of its generated σ-algebra. -/
noncomputable def observationPullback :
    Lp ℂ 2 (P.map obs) →ₗᵢ[ℂ] lpMeas ℂ ℂ (MeasurableSpace.comap obs inferInstance) 2 P where
  toFun x := ⟨Lp.compMeasurePreserving obs ⟨hobs, rfl⟩ x, by
    apply mem_lpMeas_iff_aestronglyMeasurable.mpr
    exact ((Lp.stronglyMeasurable x).comp_measurable (comap_measurable obs)).aestronglyMeasurable.congr
      (Lp.coeFn_compMeasurePreserving x ⟨hobs, rfl⟩).symm⟩
  map_add' x y := Subtype.ext ((Lp.compMeasurePreservingₗᵢ ℂ obs ⟨hobs, rfl⟩).map_add x y)
  map_smul' c x := Subtype.ext ((Lp.compMeasurePreservingₗᵢ ℂ obs ⟨hobs, rfl⟩).map_smul c x)
  norm_map' x := (Lp.compMeasurePreservingₗᵢ ℂ obs ⟨hobs, rfl⟩).norm_map x

theorem observationPullback_surjective : Function.Surjective (observationPullback P obs hobs) := by
  intro u
  obtain ⟨g, hg, heq⟩ := lpMeas.aestronglyMeasurable u
  obtain ⟨v, hv, rfl⟩ := hg.exists_eq_measurable_comp
  have hu : MemLp (u.1 : Ω → ℂ) 2 P := Lp.memLp u.1
  have hmem : MemLp v 2 (P.map obs) :=
    (memLp_map_measure_iff hv.aestronglyMeasurable hobs.aemeasurable).mpr (hu.ae_eq heq)
  refine ⟨hmem.toLp v, Subtype.ext (Lp.ext ?_)⟩
  change ⇑(Lp.compMeasurePreserving obs ⟨hobs, rfl⟩ (hmem.toLp v)) =ᵐ[P] ⇑u.1
  let hpres : MeasurePreserving obs P (P.map obs) := ⟨hobs, rfl⟩
  have hcomp : (hmem.toLp v : X → ℂ) ∘ obs =ᵐ[P] v ∘ obs :=
    hpres.quasiMeasurePreserving.ae hmem.coeFn_toLp
  exact (Lp.coeFn_compMeasurePreserving (hmem.toLp v) hpres).trans (hcomp.trans heq.symm)

/-- L² of the coordinate law is precisely L² measurable with respect to the observation. -/
noncomputable def observationL2 :
    Lp ℂ 2 (P.map obs) ≃ₗᵢ[ℂ] lpMeas ℂ ℂ (MeasurableSpace.comap obs inferInstance) 2 P :=
  LinearIsometryEquiv.ofSurjective (observationPullback P obs hobs)
    (observationPullback_surjective P obs hobs)

theorem observationL2_ae (u : Lp ℂ 2 (P.map obs)) :
    ⇑((observationL2 P obs hobs u).1 : Lp ℂ 2 P) =ᵐ[P] u ∘ obs :=
  Lp.coeFn_compMeasurePreserving u ⟨hobs, rfl⟩

/-- Mathlib's L² conditional expectation, expressed as an element of the observed law's L². -/
noncomputable def conditionOn (u : Lp ℂ 2 P) : Lp ℂ 2 (P.map obs) :=
  (observationL2 P obs hobs).symm (condExpL2 ℂ ℂ hobs.comap_le u)

theorem conditionOn_pullback (u : Lp ℂ 2 (P.map obs)) :
    conditionOn P obs hobs (observationL2 P obs hobs u).1 = u := by
  let z := observationL2 P obs hobs u
  change (observationL2 P obs hobs).symm (condExpL2 ℂ ℂ hobs.comap_le z.1) = u
  have hz : condExpL2 ℂ ℂ hobs.comap_le z.1 = z := by
    let : Fact (MeasurableSpace.comap obs inferInstance ≤ (inferInstance : MeasurableSpace Ω)) :=
      ⟨hobs.comap_le⟩
    exact Submodule.orthogonalProjectionOnto_mem_subspace_eq_self z
  rw [hz, LinearIsometryEquiv.symm_apply_apply]

end DotProduct.Extension


/-! ### Wick readings conditioned on a closed real subspace -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped InnerProductSpace

variable {Ω R V : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup R] [InnerProductSpace ℝ R]
  (P : Measure Ω) [IsFiniteMeasure P]
  (Φ : Ω → R →ₗ[ℝ] ℝ) (hmeas : ∀ a, Measurable (fun ω ↦ Φ ω a))
  (hchar : ∀ a : R, (∫ w, Complex.exp ((Φ w a : ℂ) * Complex.I) ∂P) =
    (Real.exp (-(‖a‖ ^ 2) / 2) : ℂ))

private theorem observed_wick_ae [AddCommGroup V] [Module ℝ V] (J : V →ₗ[ℝ] R) (f : V) :
    ⇑((observationL2 P (readingCoordinates Φ J) (measurable_readingCoordinates Φ hmeas J)
      (wickCoordinate (P.map (readingCoordinates Φ J)) J f)).1 : Lp ℂ 2 P) =ᵐ[P]
        fun ω ↦ Complex.exp ((‖J f‖ ^ 2 / 2 : ℝ) + (Φ ω (J f) : ℂ) * Complex.I) := by
  let obs := readingCoordinates Φ J
  let ho := measurable_readingCoordinates Φ hmeas J
  let hp : MeasurePreserving obs P (P.map obs) := ⟨ho, rfl⟩
  exact (observationL2_ae P obs ho _).trans
    (hp.quasiMeasurePreserving.ae (wickCoordinate_ae (P.map obs) J f))

/-- A Wick reading as an actual vector of the ambient Gaussian law's L². -/
noncomputable def wickReading (a : R) : Lp ℂ 2 P :=
  let obs := readingCoordinates Φ (LinearMap.id : R →ₗ[ℝ] R)
  (observationL2 P obs (measurable_readingCoordinates Φ hmeas LinearMap.id)
    (wickCoordinate (P.map obs) LinearMap.id a)).1

theorem wickReading_ae (a : R) :
    ⇑(wickReading P Φ hmeas a) =ᵐ[P]
      fun ω ↦ Complex.exp ((‖a‖ ^ 2 / 2 : ℝ) + (Φ ω a : ℂ) * Complex.I) :=
  observed_wick_ae P Φ hmeas LinearMap.id a

theorem observationL2_wick [AddCommGroup V] [Module ℝ V] (J : V →ₗ[ℝ] R) (f : V) :
    (observationL2 P (readingCoordinates Φ J) (measurable_readingCoordinates Φ hmeas J)
      (wickCoordinate (P.map (readingCoordinates Φ J)) J f)).1 =
        wickReading P Φ hmeas (J f) :=
  Lp.ext ((observed_wick_ae P Φ hmeas J f).trans (wickReading_ae P Φ hmeas (J f)).symm)

include hchar in
theorem wickReading_inner (a b : R) :
    inner ℂ (wickReading P Φ hmeas a) (wickReading P Φ hmeas b) =
      (Real.exp (inner ℝ a b) : ℂ) := by
  rw [L2.inner_def]
  refine Eq.trans (integral_congr_ae ?_) (gaussian_phase_overlap P Φ hchar a b)
  filter_upwards [wickReading_ae P Φ hmeas a, wickReading_ae P Φ hmeas b] with ω h₁ h₂
  rw [RCLike.inner_apply, h₁, h₂, mul_comm]
  rfl

section Plane

variable (S : Submodule ℝ R) [S.HasOrthogonalProjection]

local notation "obs" => readingCoordinates Φ S.subtype
local notation "hobs" => measurable_readingCoordinates Φ hmeas S.subtype
local notation "Q" => P.map obs

include hchar in
/-- Orthogonal projection of the one-particle covariance label computes conditional
expectation of Gaussian Wick readings onto the actual plane-coordinate law. -/
theorem conditionOn_plane_wick (a : R) :
    conditionOn P obs hobs (wickReading P Φ hmeas a) =
      wickCoordinate Q S.subtype (S.orthogonalProjectionOnto a) := by
  have ho := hobs
  let I := observationL2 P obs ho
  let E := (lpMeas ℂ ℂ (MeasurableSpace.comap obs inferInstance) 2 P).subtypeₗᵢ.comp I.toLinearIsometry
  let W := wickReading P Φ hmeas
  let a₀ := S.orthogonalProjectionOnto a
  let w := wickCoordinate Q S.subtype a₀
  have hw : E w = W (a₀ : R) := observationL2_wick P Φ hmeas S.subtype a₀
  let L₁ := (innerSL ℂ (W a)).comp E.toContinuousLinearMap
  let L₂ := (innerSL ℂ (E w)).comp E.toContinuousLinearMap
  have hL : L₁ = L₂ := by
    apply ContinuousLinearMap.ext_on (wickCoordinate_dense P Φ hmeas S.subtype)
    rintro _ ⟨b, rfl⟩
    change inner ℂ (W a) (E (wickCoordinate Q S.subtype b)) =
      inner ℂ (E w) (E (wickCoordinate Q S.subtype b))
    rw [show E (wickCoordinate Q S.subtype b) = W (b : R) from
      observationL2_wick P Φ hmeas S.subtype b, hw,
      wickReading_inner P Φ hmeas hchar, wickReading_inner P Φ hmeas hchar]
    have h := S.starProjection_inner_eq_zero a (b : R) b.property
    rw [inner_sub_left, sub_eq_zero] at h
    exact congrArg (fun x : ℝ ↦ (Real.exp x : ℂ)) h
  apply ext_inner_right ℂ
  intro z
  calc
    _ = inner ℂ (E (conditionOn P obs hobs (W a))) (E z) := (E.inner_map_map _ _).symm
    _ = inner ℂ (W a) (E z) := by
      change inner ℂ ((I (I.symm (condExpL2 ℂ ℂ ho.comap_le (W a)))).1 : Lp ℂ 2 P)
        (E z) = _
      rw [I.apply_symm_apply]
      exact inner_condExpL2_eq_inner_fun ho.comap_le (W a) (E z) (lpMeas.aestronglyMeasurable (I z))
    _ = inner ℂ (E w) (E z) := congrArg (fun L : Lp ℂ 2 Q →L[ℂ] ℂ ↦ L z) hL
    _ = _ := E.inner_map_map w z

end Plane

end DotProduct.Extension


/-! ### Extension of the reflected pairing by density -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped InnerProductSpace

/-- Two bounded sesquilinear pairings agreeing on a total family agree everywhere. -/
theorem mixed_pair_eq_of_dense {V K H T : Type*}
    [NormedAddCommGroup K] [InnerProductSpace ℂ K]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [NormedAddCommGroup T] [InnerProductSpace ℂ T]
    (w : V → K) (A B : K →L[ℂ] H) (C : K →L[ℂ] T)
    (hd : Dense (Submodule.span ℂ (range w) : Set K))
    (h : ∀ i j, inner ℂ (A (w i)) (B (w j)) = inner ℂ (C (w i)) (C (w j)))
    (x y : K) : inner ℂ (A x) (B y) = inner ℂ (C x) (C y) := by
  have hleft (i : V) (z : K) :
      inner ℂ (A (w i)) (B z) = inner ℂ (C (w i)) (C z) := by
    have he : (innerSL ℂ (A (w i))).comp B = (innerSL ℂ (C (w i))).comp C := by
      apply ContinuousLinearMap.ext_on hd
      rintro _ ⟨j, rfl⟩
      exact h i j
    exact congrArg (fun L : K →L[ℂ] ℂ ↦ L z) he
  have he : (innerSL ℂ (B y)).comp A = (innerSL ℂ (C y)).comp C := by
    apply ContinuousLinearMap.ext_on hd
    rintro _ ⟨i, rfl⟩
    change inner ℂ (B y) (A (w i)) = inner ℂ (C y) (C (w i))
    simpa only [inner_conj_symm] using congrArg (starRingEnd ℂ) (hleft i y)
  have hf : inner ℂ (B y) (A x) = inner ℂ (C y) (C x) :=
    congrArg (fun L : K →L[ℂ] ℂ ↦ L x) he
  simpa only [inner_conj_symm] using congrArg (starRingEnd ℂ) hf


end DotProduct.Extension


/-! ### Positive-time shifts and Laplace features -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped FourierTransform

/-- Translate the positive-time Fourier test by `s`, extending it by zero below the boundary. -/
noncomputable def positiveTimeTranslate {d : ℕ} (s : ℝ)
    (fhat : ℝ → MassShell.Space d → ℂ) (r : ℝ) (k : MassShell.Space d) : ℂ :=
  if s < r then fhat (r - s) k else 0

/-- The Laplace feature of a shifted preparation is multiplied by the released shift weight. -/
theorem featureMap_positiveTimeTranslate {d : ℕ} (ħ m s : ℝ) (hs : 0 ≤ s)
    (fhat : ℝ → MassShell.Space d → ℂ) (k : MassShell.Space d) :
    featureMap ħ m (positiveTimeTranslate s fhat) k =
      (Real.exp (-s * modeDispersion m k) : ℂ) * featureMap ħ m fhat k := by
  let ω := modeDispersion m k
  let g (r : ℝ) := (Real.exp (-r * ω) : ℂ) * fhat r k
  have hsub : (∫ r : ℝ, (Ioi (0 : ℝ)).indicator g (r - s)) =
      ∫ r in Ioi (0 : ℝ), g r := by
    rw [integral_sub_right_eq_self, integral_indicator measurableSet_Ioi]
  unfold featureMap
  rw [mul_left_comm (Real.exp (-s * ω) : ℂ)]
  congr 1
  have hpoint (r : ℝ) :
      (Ioi (0 : ℝ)).indicator
          (fun r ↦ (Real.exp (-r * ω) : ℂ) * positiveTimeTranslate s fhat r k) r =
        (Real.exp (-s * ω) : ℂ) * (Ioi (0 : ℝ)).indicator g (r - s) := by
    by_cases hr : s < r
    · have h₀ : r ∈ Ioi (0 : ℝ) := hs.trans_lt hr
      have h₁ : r - s ∈ Ioi (0 : ℝ) := sub_pos.mpr hr
      rw [indicator_of_mem h₀, indicator_of_mem h₁, positiveTimeTranslate, ite_eq_left hr]
      dsimp only [g]
      rw [← mul_assoc, ← Complex.ofReal_mul, ← Real.exp_add]
      congr 3
      ring
    · have h₁ : r - s ∉ Ioi (0 : ℝ) := fun h ↦ hr (sub_pos.mp h)
      rw [indicator_of_notMem h₁, mul_zero]
      by_cases h₀ : r ∈ Ioi (0 : ℝ)
      · rw [indicator_of_mem h₀]
        simp [positiveTimeTranslate, hr]
      · exact indicator_of_notMem h₀ _
  rw [← integral_indicator measurableSet_Ioi]
  calc
    _ = ∫ r : ℝ, (Real.exp (-s * ω) : ℂ) * (Ioi (0 : ℝ)).indicator g (r - s) :=
      integral_congr_ae (Eventually.of_forall hpoint)
    _ = _ := by rw [integral_const_mul, hsub]

/-- Turn the released reflected kernel factorization into an equality in the
actual momentum Hilbert space whenever the two feature representatives are in L². -/
theorem reflectedCov_eq_Lp_inner {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (fhat ghat : ℝ → MassShell.Space d → ℂ)
    (u v : Lp ℂ 2 (volume : Measure (MassShell.Space d)))
    (hu : ⇑u =ᵐ[volume] featureMap ħ m fhat) (hv : ⇑v =ᵐ[volume] featureMap ħ m ghat) :
    reflectedCov ħ m fhat ghat = inner ℂ u v := by
  rw [reflectedCov_eq_feature_inner hħ hm, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [hu, hv] with k hk hk'
  rw [RCLike.inner_apply, hk, hk', mul_comm]
  rfl

theorem oneParticleShift_feature {d : ℕ} {ħ m : ℝ} {s : ℝ} (hs : 0 ≤ s)
    (fhat : ℝ → MassShell.Space d → ℂ)
    (u v : Lp ℂ 2 (volume : Measure (MassShell.Space d)))
    (hu : ⇑u =ᵐ[volume] featureMap ħ m fhat)
    (hv : ⇑v =ᵐ[volume] featureMap ħ m (positiveTimeTranslate s fhat)) :
    oneParticleShift volume (modeDispersion m) (modeDispersion_measurable m)
      (fun _k ↦ Real.sqrt_nonneg _) s hs u = v := by
  apply Lp.ext
  have hae := FeatureDensity.complexMultiplier_apply_ae (MomentumFock.shiftWeight (modeDispersion m) s)
    (MomentumFock.shiftWeight_memLp volume (modeDispersion m) (modeDispersion_measurable m)
      (fun _k : MassShell.Space d ↦ Real.sqrt_nonneg _) hs) u
  filter_upwards [hae, hu, hv] with k h₁ h₂ h₃
  change _ = v k
  rw [show (oneParticleShift volume (modeDispersion m) (modeDispersion_measurable m)
    (fun _k ↦ Real.sqrt_nonneg _) s hs u) k = _ from h₁, h₂, h₃, featureMap_positiveTimeTranslate ħ m s hs]
  rfl


end DotProduct.Extension


/-! ### The Wick phase on momentum labels -/

namespace DotProduct.Extension




open MeasureTheory ProbabilityTheory Set
open scoped FourierTransform InnerProductSpace

noncomputable abbrev Momentum (d : ℕ) := Lp ℂ 2 (volume : Measure (MassShell.Space d))

local notation "vol" d => (volume : Measure (MassShell.Space d))

/-- Multiplication of the real preparation label by `i` uses the Wick convention in §3.1. -/
noncomputable def wickMomentum {d : ℕ} {V : Type*} [AddCommGroup V] [Module ℝ V]
    (J : V →ₗ[ℝ] Momentum d) : V →ₗ[ℝ] Momentum d :=
  Complex.I • J

theorem wickMomentum_inner {d : ℕ} {V : Type*} [AddCommGroup V] [Module ℝ V]
    (J : V →ₗ[ℝ] Momentum d) (f g : V) :
    inner ℂ (wickMomentum J f) (wickMomentum J g) = inner ℂ (J f) (J g) := by
  change inner ℂ (Complex.I • J f) (Complex.I • J g) = _
  rw [inner_smul_left, inner_smul_right, ← mul_assoc]
  change (star Complex.I * Complex.I) * _ = _
  rw [Complex.star_def, Complex.conj_I]
  simp

theorem wickMomentum_dense {d : ℕ} {V : Type*} [AddCommGroup V] [Module ℝ V]
    (J : V →ₗ[ℝ] Momentum d)
    (hd : Dense (Submodule.span ℂ (range J) : Set (Momentum d))) :
    Dense (Submodule.span ℂ (range (wickMomentum J)) : Set (Momentum d)) := by
  apply hd.mono
  apply Submodule.span_le.mpr
  rintro _ ⟨f, rfl⟩
  have hmem := Submodule.smul_mem (Submodule.span ℂ (range (wickMomentum J))) (-Complex.I)
    (Submodule.subset_span (mem_range_self f))
  change (-Complex.I) • (Complex.I • J f) ∈ _ at hmem
  simpa [smul_smul] using hmem


end DotProduct.Extension


/-! ### The massive field on the original Euclidean Schwartz tests -/

namespace DotProduct.Extension

open MeasureTheory FourierTransform Filter BoundedContinuousFunction
open scoped SchwartzMap InnerProductSpace Topology

/-- Unitary physics Fourier transform of a real Schwartz test, as a continuous
real-linear map of Schwartz spaces. -/
noncomputable def physicsFourierSchwartz (D : ℕ) :
    𝓢(EuclideanSpace ℝ (Fin D), ℝ) →L[ℝ] 𝓢(EuclideanSpace ℝ (Fin D), ℂ) :=
  let E := EuclideanSpace ℝ (Fin D)
  let c : ℝˣ := Units.mk0 ((2 * Real.pi)⁻¹) (by positivity)
  let dil : E ≃L[ℝ] E := ContinuousLinearEquiv.smulLeft c
  ((2 * Real.pi) ^ (-(D : ℝ) / 2) : ℝ) •
    (((SchwartzMap.compCLMOfContinuousLinearEquiv ℂ dil).restrictScalars ℝ).comp
      (((SchwartzMap.fourierTransformCLM ℂ).restrictScalars ℝ).comp FeatureDensity.ofRealSchwartz))

theorem physicsFourierSchwartz_apply {D : ℕ} (f : 𝓢(EuclideanSpace ℝ (Fin D), ℝ))
    (p : EuclideanSpace ℝ (Fin D)) :
    physicsFourierSchwartz D f p = physicsFourier f p := by
  change ((2 * Real.pi) ^ (-(D : ℝ) / 2) : ℝ) • (𝓕 (fun x : EuclideanSpace ℝ (Fin D) ↦ (f x : ℂ))
    ((2 * Real.pi)⁻¹ • p) : ℂ) = _
  rw [Complex.real_smul]
  rfl

private theorem massiveWeight_bound (D : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    MemLp (fun p : EuclideanSpace ℝ (Fin D) ↦ (Real.sqrt (ħ / continuumDispersion m p) : ℂ))
      ⊤ volume := by
  have hm2 : 0 < m ^ 2 := sq_pos_of_pos hm
  have hmeas : Measurable (fun p : EuclideanSpace ℝ (Fin D) ↦
      (Real.sqrt (ħ / continuumDispersion m p) : ℂ)) := by
    unfold continuumDispersion
    fun_prop
  refine memLp_top_of_bound hmeas.aestronglyMeasurable
    (Real.sqrt (ħ / m ^ 2)) (ae_of_all _ fun p ↦ ?_)
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
  exact Real.sqrt_le_sqrt (div_le_div_of_nonneg_left hħ hm2 (le_add_of_nonneg_left (sq_nonneg _)))

/-- Spectral square root of the released massive Euclidean covariance, in the
paper's unitary physical momentum coordinates. -/
noncomputable def massiveEuclideanLabel (D : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m) :
    𝓢(EuclideanSpace ℝ (Fin D), ℝ) →L[ℝ] Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin D))) :=
  ((realMultiplier _ (massiveWeight_bound D hħ hm)).restrictScalars ℝ).comp
    ((SchwartzMap.toLpCLM ℝ ℂ 2 volume).comp (physicsFourierSchwartz D))

theorem massiveEuclideanLabel_apply_ae {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(EuclideanSpace ℝ (Fin D), ℝ)) :
    ⇑(massiveEuclideanLabel D ħ m hħ hm f) =ᵐ[volume] fun p ↦
      (Real.sqrt (ħ / continuumDispersion m p) : ℂ) * physicsFourier f p := by
  refine (realMultiplier_apply_ae _ (massiveWeight_bound D hħ hm)
    ((physicsFourierSchwartz D f).toLp 2 volume)).trans ?_
  filter_upwards [(physicsFourierSchwartz D f).coeFn_toLp 2 volume] with p hp
  rw [hp, physicsFourierSchwartz_apply]

/-- The complex Gram is exactly the continuum covariance of the original smears,
with no change of Fourier normalization. -/
theorem massiveEuclideanLabel_inner {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(EuclideanSpace ℝ (Fin D), ℝ)) :
    ⟪massiveEuclideanLabel D ħ m hħ hm f, massiveEuclideanLabel D ħ m hħ hm g⟫_ℂ =
      continuumCov ħ m (physicsFourier f) (physicsFourier g) := by
  rw [L2.inner_def, continuumCov, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [massiveEuclideanLabel_apply_ae hħ hm f,
    massiveEuclideanLabel_apply_ae hħ hm g] with p hf hg
  rw [hf, hg, RCLike.inner_apply, map_mul, Complex.conj_ofReal]
  have hd : 0 ≤ continuumDispersion m p := add_nonneg (sq_nonneg _) (sq_nonneg _)
  have hs : (Real.sqrt (ħ / continuumDispersion m p) : ℂ) ^ 2 =
      (ħ : ℂ) * (continuumDispersion m p : ℂ)⁻¹ := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt (div_nonneg hħ hd), Complex.ofReal_div, div_eq_mul_inv]
  simp only [RCLike.star_def, Complex.ofReal_inv]
  linear_combination (starRingEnd ℂ (physicsFourier f p) * physicsFourier g p) * hs

/-- A Hilbert basis for the real Hilbert space underlying full Euclidean momentum L².
Its choice affects the sample realization but drops out of every finite joint law. -/
noncomputable def massiveEuclideanBasisSet (D : ℕ) : Set
    (Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin D)))) :=
  (exists_hilbertBasis ℝ _).choose

noncomputable def massiveEuclideanBasis (D : ℕ) : HilbertBasis (massiveEuclideanBasisSet D) ℝ
    (Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin D)))) :=
  (exists_hilbertBasis ℝ _).choose_spec.choose

/-- At every sample the massive field is linear on real spacetime tests. -/
noncomputable def massiveEuclideanReading (D : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m)
    (w : massiveEuclideanBasisSet D → ℝ) : 𝓢(EuclideanSpace ℝ (Fin D), ℝ) →ₗ[ℝ] ℝ :=
  (pointwiseGaussian (massiveEuclideanBasis D) w).comp
    (massiveEuclideanLabel D ħ m hħ hm).toLinearMap

theorem massiveEuclideanReading_measurable {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    Measurable (fun w ↦ ⇑(massiveEuclideanReading D ħ m hħ hm w)) :=
  Measurable.of_eval fun f ↦ pointwiseGaussian_measurable (massiveEuclideanBasis D)
    (massiveEuclideanLabel D ħ m hħ hm f)

/-- The massive field law on the evaluation σ-algebra indexed by the original
real spacetime Schwartz smears. -/
noncomputable def massiveEuclideanLaw (D : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m) :
    Measure (𝓢(EuclideanSpace ℝ (Fin D), ℝ) → ℝ) :=
  (standardGaussianProduct (massiveEuclideanBasisSet D)).map
    (fun w ↦ ⇑(massiveEuclideanReading D ħ m hħ hm w))

instance (D : ℕ) (ħ m : ℝ) (hħ : 0 ≤ ħ) (hm : 0 < m) :
    IsProbabilityMeasure (massiveEuclideanLaw D ħ m hħ hm) :=
  by unfold massiveEuclideanLaw; infer_instance

/-- Finite joint characteristic function of the constructed probability law, in
the Fourier coordinates and both physical scales of the free-box continuum limit. -/
theorem massiveEuclideanLaw_jointChar {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    {ι : Type*} [Fintype ι] (f : ι → 𝓢(EuclideanSpace ℝ (Fin D), ℝ)) (ξ : ι → ℝ) :
    (∫ x, Complex.exp (Complex.I * (↑(∑ i, ξ i * x (f i)) : ℂ))
      ∂massiveEuclideanLaw D ħ m hħ hm) =
      Complex.exp (-(continuumCov ħ m (fun p ↦ ∑ i, (ξ i : ℂ) * physicsFourier (f i) p)
        (fun p ↦ ∑ i, (ξ i : ℂ) * physicsFourier (f i) p)) / 2) := by
  classical
  let F := ∑ i, ξ i • f i
  have hF (p) : physicsFourier F p = ∑ i, (ξ i : ℂ) * physicsFourier (f i) p := by
    simp only [← physicsFourierSchwartz_apply, F, map_sum, map_smul,
      _root_.sum_apply, _root_.smul_apply, Complex.real_smul]
  let J := massiveEuclideanLabel D ħ m hħ hm
  have hchar := pointwiseGaussian_char (massiveEuclideanBasis D) (J F)
  have hp (w) : ∑ i, ξ i * massiveEuclideanReading D ħ m hħ hm w (f i) =
      pointwiseGaussian (massiveEuclideanBasis D) w (J F) := by
    change _ = massiveEuclideanReading D ħ m hħ hm w F
    simp [F]
  have hmeas : Measurable (fun x : 𝓢(EuclideanSpace ℝ (Fin D), ℝ) → ℝ ↦
      Complex.exp (Complex.I * (↑(∑ i, ξ i * x (f i)) : ℂ))) := by fun_prop
  rw [massiveEuclideanLaw, integral_map (massiveEuclideanReading_measurable hħ hm).aemeasurable
    hmeas.aestronglyMeasurable]
  simp only [hp]
  simp_rw [mul_comm Complex.I]
  rw [hchar, Complex.ofReal_exp, Complex.ofReal_div, Complex.ofReal_neg, Complex.ofReal_pow]
  simp only [Complex.ofReal_ofNat]
  have hi : ⟪J F, J F⟫_ℂ = (‖J F‖ : ℂ) ^ 2 := inner_self_eq_norm_sq_to_K _
  rw [← hi, massiveEuclideanLabel_inner hħ hm F F]
  rw [funext hF]

/-- Each evaluation has its centred one-dimensional Gaussian law. -/
theorem pointwiseGaussian_map {ι H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (b : HilbertBasis ι ℝ H) (a : H) :
    (standardGaussianProduct ι).map (fun w ↦ pointwiseGaussian b w a) =
      ProbabilityTheory.gaussianReal 0 (‖a‖₊ ^ 2) := by
  apply Measure.ext_of_charFun
  funext t
  rw [ProbabilityTheory.charFun_gaussianReal, charFun_apply_real,
    integral_map (pointwiseGaussian_measurable b a).aemeasurable
      (show Measurable (fun x : ℝ ↦ Complex.exp ((t : ℂ) * (x : ℂ) * Complex.I)) by fun_prop).aestronglyMeasurable]
  have h := pointwiseGaussian_char b (t • a)
  simp only [map_smul, smul_eq_mul, Complex.ofReal_mul, norm_smul, Real.norm_eq_abs,
    mul_pow, sq_abs, Complex.ofReal_exp, Complex.ofReal_div, Complex.ofReal_neg,
    Complex.ofReal_pow, Complex.ofReal_ofNat] at h
  simp only [Complex.ofReal_zero, mul_zero, zero_mul, zero_sub,
    NNReal.coe_pow, coe_nnnorm, Complex.ofReal_pow]
  rw [h]
  congr 1
  ring

/-- The mean of every smeared reading is zero. -/
theorem massiveEuclideanLaw_centered {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(EuclideanSpace ℝ (Fin D), ℝ)) :
    (∫ x, x f ∂massiveEuclideanLaw D ħ m hħ hm) = 0 := by
  rw [massiveEuclideanLaw, integral_map (massiveEuclideanReading_measurable hħ hm).aemeasurable
    (measurable_pi_apply f).aestronglyMeasurable]
  let b := massiveEuclideanBasis D
  let a := massiveEuclideanLabel D ħ m hħ hm f
  change (∫ w, id (pointwiseGaussian b w a) ∂standardGaussianProduct _) = _
  rw [← integral_map (pointwiseGaussian_measurable b a).aemeasurable
    (measurable_id (α := ℝ)).aestronglyMeasurable, pointwiseGaussian_map]
  exact ProbabilityTheory.integral_id_gaussianReal

/-- The mixed second moments of the realized field agree with the released resolvent. -/
theorem massiveEuclideanLaw_covariance {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(EuclideanSpace ℝ (Fin D), ℝ)) :
    ProbabilityTheory.covariance (fun x ↦ x f) (fun x ↦ x g) (massiveEuclideanLaw D ħ m hħ hm) =
      (continuumCov ħ m (physicsFourier f) (physicsFourier g)).re := by
  rw [ProbabilityTheory.covariance, massiveEuclideanLaw_centered hħ hm f,
    massiveEuclideanLaw_centered hħ hm g]
  simp only [sub_zero]
  have hmeas : Measurable (fun x : 𝓢(EuclideanSpace ℝ (Fin D), ℝ) → ℝ ↦ x f * x g) := by fun_prop
  rw [massiveEuclideanLaw, integral_map (massiveEuclideanReading_measurable hħ hm).aemeasurable
    hmeas.aestronglyMeasurable]
  let b := massiveEuclideanBasis D
  let J := massiveEuclideanLabel D ħ m hħ hm
  change (∫ w, pointwiseGaussian b w (J f) * pointwiseGaussian b w (J g)
    ∂standardGaussianProduct _) = _
  have hpair : (∫ w, pointwiseGaussian b w (J f) * pointwiseGaussian b w (J g)
      ∂standardGaussianProduct _) = ⟪gaussianIsonormal b (J f), gaussianIsonormal b (J g)⟫_ℝ := by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [pointwiseGaussian_ae b (J f), pointwiseGaussian_ae b (J g)] with w hf hg
    rw [hf, hg, RCLike.inner_apply]
    exact mul_comm _ _
  rw [hpair, LinearIsometry.inner_map_map, ← massiveEuclideanLabel_inner hħ hm f g,
    L2.inner_def, L2.inner_def, ← Complex.reCLM_apply,
    ← Complex.reCLM.integral_comp_comm (L2.integrable_inner (𝕜 := ℂ) (J f) (J g))]
  apply integral_congr_ae
  exact ae_of_all _ fun _ ↦ rfl

/-- All finite linear characteristic functions determine the entire evaluation law. -/
theorem massiveEuclideanLaw_unique {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (Q : Measure (𝓢(EuclideanSpace ℝ (Fin D), ℝ) → ℝ)) [IsFiniteMeasure Q]
    (hQ : ∀ (s : Finset (𝓢(EuclideanSpace ℝ (Fin D), ℝ))) (c : s → ℝ),
      (∫ x, Complex.exp (Complex.I * (↑(∑ i : s, c i * x i) : ℂ)) ∂Q) =
        Complex.exp (-(continuumCov ħ m (fun p ↦ ∑ i : s, (c i : ℂ) * physicsFourier i.val p)
          (fun p ↦ ∑ i : s, (c i : ℂ) * physicsFourier i.val p)) / 2)) :
    Q = massiveEuclideanLaw D ħ m hħ hm := by
  classical
  apply DotChar.cylindrical_char_ext
  intro s L
  let c (i : s) := L (Pi.single i 1)
  have heq (x : 𝓢(EuclideanSpace ℝ (Fin D), ℝ) → ℝ) :
      probCharDual L (s.restrict x) = Complex.exp (Complex.I * (↑(∑ i : s, c i * x i) : ℂ)) := by
    have hx : (∑ i : s, x i • Pi.single i (1 : ℝ)) = s.restrict x := by
      funext j
      simp [Finset.sum_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, mul_ite]
    rw [probCharDual_apply, ← hx, map_sum]
    simp only [map_smul, smul_eq_mul, c]
    simp_rw [mul_comm (x _)]
    rw [mul_comm Complex.I]
  simp_rw [heq]
  exact (hQ s c).trans (massiveEuclideanLaw_jointChar hħ hm (fun i : s ↦ i.val) c).symm


/-- Reflection in the plane normal to coordinate zero. -/
noncomputable def timeReflection (d : ℕ) : MassShell.Space (d + 1) ≃ₗᵢ[ℝ] MassShell.Space (d + 1) :=
  (MassShell.splitIsometry d).trans
    ((LinearIsometryEquiv.withLpProdCongr 2 (LinearIsometryEquiv.neg ℝ (E := ℝ))
      (LinearIsometryEquiv.refl ℝ (MassShell.Space d))).trans (MassShell.splitIsometry d).symm)

theorem timeReflection_apply (d : ℕ) (x : MassShell.Space (d + 1)) :
    timeReflection d x = (MassShell.split d).symm (-x 0, MassShell.tail x) := rfl

theorem timeReflection_eq_euclideanReflect (d : ℕ) (x : MassShell.Space (d + 1)) :
    timeReflection d x = euclideanReflect (Nat.zero_lt_succ d) x := by
  ext i
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · change Fin.cons (α := fun _ : Fin (d + 1) ↦ ℝ) (-x 0) (fun j ↦ x j.succ) 0 = _
    rw [Fin.cons_zero]
    exact (euclideanReflect_apply_zero (Nat.zero_lt_succ d) x).symm
  · change Fin.cons (α := fun _ : Fin (d + 1) ↦ ℝ) (-x 0) (fun j ↦ x j.succ) j.succ = _
    rw [Fin.cons_succ, euclideanReflect_apply_ne _ _ (Fin.succ_ne_zero j)]

/-- Reflected real Schwartz test used to prepare the opposite half-space. -/
noncomputable def reflectSchwartz (d : ℕ) :
    𝓢(MassShell.Space (d + 1), ℝ) →L[ℝ] 𝓢(MassShell.Space (d + 1), ℝ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ (timeReflection d).toContinuousLinearEquiv

theorem reflectSchwartz_apply (d : ℕ) (f : 𝓢(MassShell.Space (d + 1), ℝ))
    (x : MassShell.Space (d + 1)) :
    reflectSchwartz d f x = f (euclideanReflect (Nat.zero_lt_succ d) x) :=
  congrArg f (timeReflection_eq_euclideanReflect d x)

theorem physicsFourier_reflectSchwartz {d : ℕ} (f : 𝓢(MassShell.Space (d + 1), ℝ))
    (p : MassShell.Space (d + 1)) :
    physicsFourier (reflectSchwartz d f) p =
      physicsFourier f ((MassShell.split d).symm (-p 0, MassShell.tail p)) := by
  unfold physicsFourier
  congr 1
  let fC := fun x : MassShell.Space (d + 1) ↦ (f x : ℂ)
  change 𝓕 (fC ∘ timeReflection d) ((2 * Real.pi)⁻¹ • p) = _
  rw [Real.fourier_comp_linearIsometry, map_smul]
  rfl

/-- The reflection acting on the actual covariance Hilbert space. -/
noncomputable def momentumReflection (d : ℕ) :
    Lp ℂ 2 (volume : Measure (MassShell.Space (d + 1))) ≃ₗᵢ[ℝ]
      Lp ℂ 2 (volume : Measure (MassShell.Space (d + 1))) :=
  let U := MassShell.pullback (timeReflection d).toMeasurableEquiv (timeReflection d).measurePreserving
  { __ := U.toLinearEquiv.restrictScalars ℝ, norm_map' := U.norm_map }

theorem momentumReflection_ae {d : ℕ} (u : Lp ℂ 2 (volume : Measure (MassShell.Space (d + 1)))) :
    ⇑(momentumReflection d u) =ᵐ[volume] fun p ↦ u (timeReflection d p) :=
  MassShell.pullback_ae (timeReflection d).toMeasurableEquiv (timeReflection d).measurePreserving u

theorem massiveEuclideanLabel_reflectSchwartz {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(MassShell.Space (d + 1), ℝ)) :
    massiveEuclideanLabel (d + 1) ħ m hħ hm (reflectSchwartz d f) =
      momentumReflection d (massiveEuclideanLabel (d + 1) ħ m hħ hm f) := by
  apply Lp.ext
  have hp := (timeReflection d).measurePreserving.quasiMeasurePreserving.ae
    (massiveEuclideanLabel_apply_ae hħ hm f)
  filter_upwards [massiveEuclideanLabel_apply_ae hħ hm (reflectSchwartz d f),
    momentumReflection_ae (massiveEuclideanLabel (d + 1) ħ m hħ hm f), hp] with p h₁ h₂ h₃
  rw [h₁, h₂, h₃, physicsFourier_reflectSchwartz]
  simp only [continuumDispersion, (timeReflection d).norm_map, ← timeReflection_apply]

theorem massiveEuclideanLabel_reflect_norm {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : 𝓢(MassShell.Space (d + 1), ℝ)) :
    ‖massiveEuclideanLabel (d + 1) ħ m hħ hm (reflectSchwartz d f)‖ =
      ‖massiveEuclideanLabel (d + 1) ħ m hħ hm f‖ := by
  rw [massiveEuclideanLabel_reflectSchwartz, (momentumReflection d).norm_map]

/-- Real Schwartz preparations vanishing at every nonpositive normal coordinate. -/
def positiveSchwartz (d : ℕ) : Submodule ℝ (𝓢(MassShell.Space (d + 1), ℝ)) where
  carrier := { f | ∀ x, x 0 ≤ 0 → f x = 0 }
  zero_mem' := by simp
  add_mem' := by
    intro f g hf hg x hx
    change f x + g x = 0
    rw [hf x hx, hg x hx, add_zero]
  smul_mem' := by
    intro r f hf x hx
    change r * f x = 0
    rw [hf x hx, mul_zero]

theorem mem_positiveSchwartz_iff {d : ℕ} {f : 𝓢(MassShell.Space (d + 1), ℝ)} :
    f ∈ positiveSchwartz d ↔ ∀ x, f x ≠ 0 → 0 < x 0 := by
  constructor
  · intro h x hx
    exact lt_of_not_ge fun hneg ↦ hx (h x hneg)
  · intro h x hneg
    exact by_contra fun hx ↦ (not_lt_of_ge hneg) (h x hx)


/-- A test supported strictly inside the normal half-space is a positive preparation. -/
theorem mem_positiveSchwartz_of_tsupport {d : ℕ} (f : 𝓢(MassShell.Space (d + 1), ℝ))
    (h : tsupport (f : MassShell.Space (d + 1) → ℝ) ⊆ {x | 0 < x 0}) :
    f ∈ positiveSchwartz d :=
  mem_positiveSchwartz_iff.mpr fun _ hx ↦ h (subset_tsupport _ hx)

/-- Convergence of spectral labels is mean-square convergence of the realized massive field,
including limits whose labels are singular plane supported smears. -/
theorem massiveEuclideanReadingL2_tendsto {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    {α : Type*} {l : Filter α} (f : α → 𝓢(MassShell.Space D, ℝ))
    {v : Lp ℂ 2 (volume : Measure (MassShell.Space D))}
    (h : Tendsto (fun i ↦ massiveEuclideanLabel D ħ m hħ hm (f i)) l (𝓝 v)) :
    Tendsto (fun i ↦ gaussianIsonormal (massiveEuclideanBasis D)
      (massiveEuclideanLabel D ħ m hħ hm (f i))) l
      (𝓝 (gaussianIsonormal (massiveEuclideanBasis D) v)) :=
  (gaussianIsonormal (massiveEuclideanBasis D)).continuous.continuousAt.tendsto.comp h

end DotProduct.Extension


/-! ### Weak convergence of the free-box joint reading laws -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped SchwartzMap Topology

/-- The joint law of the given finite list of real observations, in Euclidean coordinates. -/
noncomputable def jointObservationLaw {k : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (X : Fin k → Ω → ℝ) (hX : ∀ i, Measurable (X i)) :
    ProbabilityMeasure (MassShell.Space k) :=
  let J (x : Ω) : MassShell.Space k := WithLp.toLp 2 fun i ↦ X i x
  have hJ : Measurable J := (MeasurableEquiv.toLp 2 (Fin k → ℝ)).measurable.comp (Measurable.of_eval hX)
  ⟨P.map J, (Measure.isProbabilityMeasure_map_iff hJ.aemeasurable).mpr inferInstance⟩

theorem jointObservationLaw_char {k : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (X : Fin k → Ω → ℝ) (hX : ∀ i, Measurable (X i))
    (t : MassShell.Space k) :
    charFun (jointObservationLaw P X hX : Measure (MassShell.Space k)) t =
      ∫ x, Complex.exp (Complex.I * ((∑ i, t i * X i x : ℝ) : ℂ)) ∂P := by
  let J (x : Ω) : MassShell.Space k := WithLp.toLp 2 fun i ↦ X i x
  have hJ : Measurable J := (MeasurableEquiv.toLp 2 (Fin k → ℝ)).measurable.comp (Measurable.of_eval hX)
  change charFun (P.map J) t = _
  rw [charFun_apply, integral_map hJ.aemeasurable (by fun_prop)]
  apply integral_congr_ae
  refine ae_of_all _ fun x ↦ ?_
  dsimp only
  rw [EuclideanSpace.inner_eq_star_dotProduct, mul_comm]
  congr 1

/-- The finite list of site samples under the actual position-space tilted Gibbs measure. -/
noncomputable def freeBoxObservationLaw {D k : ℕ} (M : ℕ) (a : ℝ)
    {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) (f : Fin k → 𝓢(MassShell.Space D, ℝ)) :
    ProbabilityMeasure (MassShell.Space k) :=
  let Q := freeBoxPrecision D M a ħ m
  letI : IsProbabilityMeasure (volume.tilted (gaussianExponent Q)) :=
    isProbabilityMeasure_tilted (integrable_gaussian_unnorm (freeBoxPrecision_posDef D M a hħ hm))
  jointObservationLaw (volume.tilted (gaussianExponent Q))
    (fun i (φ : FreeBoxSite D M → ℝ) ↦ siteSample D M a (f i) ⬝ᵥ φ) (fun _ ↦ by
      unfold dotProduct
      fun_prop)

/-- The finite-dimensional marginal of the constructed continuum law, on the same tests. -/
noncomputable def continuumObservationLaw {D k : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : Fin k → 𝓢(MassShell.Space D, ℝ)) : ProbabilityMeasure (MassShell.Space k) :=
  jointObservationLaw (massiveEuclideanLaw D ħ m hħ hm) (fun i x ↦ x (f i))
    (fun i ↦ measurable_pi_apply (f i))

/-- Weak convergence of the actual finite-dimensional position-space Gibbs marginals to
the matching marginal of the constructed massive law along every exhausting free-box mesh. -/
theorem tendsto_freeBox_joint_law {D k : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    {a : ℕ → ℝ} {M : ℕ → ℕ} (ha : ∀ n, 0 < a n) (hzero : Tendsto a atTop (𝓝 0))
    (hexhaust : Tendsto (fun n ↦ (M n : ℝ) * a n) atTop atTop)
    (f : Fin k → 𝓢(MassShell.Space D, ℝ)) (hc : ∀ i, HasCompactSupport (f i : _ → ℝ)) :
    Tendsto (fun n ↦ freeBoxObservationLaw (M n) (a n) hħ hm f) atTop
      (𝓝 (continuumObservationLaw hħ.le hm f)) := by
  apply ProbabilityMeasure.tendsto_of_tendsto_charFun
  intro t
  unfold continuumObservationLaw freeBoxObservationLaw
  simp_rw [jointObservationLaw_char]
  rw [massiveEuclideanLaw_jointChar hħ.le hm f]
  exact tendsto_freeBox_finite_gaussian_charFun hħ hm ha hzero hexhaust (fun i ↦ ⇑(f i))
    (fun i ↦ (f i).smooth ⊤) hc (fun i ↦ t i)

end DotProduct.Extension


/-! ### Riemann sums for arbitrary Schwartz smears -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Matrix
open scoped SchwartzMap Topology

private theorem freeBox_cell_dist {D M : ℕ} {a : ℝ} (ha : 0 < a) {v : FreeBoxSite D M}
    {x : MassShell.Space D} (hx : x ∈ boxCell D M a v) :
    dist (boxCoord D M a v) x ≤ Real.sqrt D * a := by
  have hsq : ‖boxCoord D M a v - x‖^2 ≤ (D:ℝ) * a^2 := by
    rw [EuclideanSpace.norm_sq_eq]
    calc
      (∑ j : Fin D, ‖(boxCoord D M a v - x) j‖ ^ 2) ≤ (∑ _j : Fin D, a ^ 2) := by
        refine Finset.sum_le_sum fun j _ ↦ ?_
        have hj := hx j
        have habs : |boxCoord D M a v j - x j| ≤ a := by
          rw [abs_le]; constructor <;> linarith
        exact pow_le_pow_left₀ (abs_nonneg _) habs 2
      _ = _ := by simp
  simpa only [dist_eq_norm, Real.sqrt_sq (norm_nonneg _), Real.sqrt_mul (Nat.cast_nonneg D),
    Real.sqrt_sq ha.le] using Real.sqrt_le_sqrt hsq

/-- Riemann sums on shrinking, exhausting free boxes converge for every Schwartz function.
Rapid decay supplies one integrable majorant even when the boxes grow arbitrarily fast. -/
theorem tendsto_freeBox_riemannSum_schwartz {D : ℕ} {a : ℕ → ℝ} {M : ℕ → ℕ}
    (ha : ∀ n, 0 < a n) (hzero : Tendsto a atTop (𝓝 0))
    (hexhaust : Tendsto (fun n ↦ (M n : ℝ) * a n) atTop atTop) (g : 𝓢(MassShell.Space D, ℝ)) :
    Tendsto (fun n ↦ (a n)^D * ∑ v : FreeBoxSite D (M n), g (boxCoord D (M n) (a n) v))
      atTop (𝓝 (∫ x, g x)) := by
  classical
  let C (n : ℕ) := boxCell D (M n) (a n)
  let Y (n : ℕ) := boxCoord D (M n) (a n)
  let F (n : ℕ) (x : MassShell.Space D) :=
    ∑ v : FreeBoxSite D (M n), (C n v).indicator (fun _ ↦ g (Y n v)) x
  have hM (n : ℕ) (v : FreeBoxSite D (M n)) : MeasurableSet (C n v) := boxCell_measurable _ _ _ _
  have hI (n : ℕ) (v : FreeBoxSite D (M n)) :
      Integrable ((C n v).indicator (fun _ ↦ g (Y n v))) := by
    apply IntegrableOn.integrable_indicator _ (hM n v)
    exact integrableOn_const (by rw [boxCell_volume D (M n) (ha n) v]; exact ENNReal.ofReal_ne_top)
  have hFn (n : ℕ) : Integrable (F n) := integrable_finsetSum _ fun i _ ↦ hI n i
  have hIn (n : ℕ) : ∫ x, F n x = (a n)^D * ∑ v, g (Y n v) := by
    unfold F
    rw [integral_finsetSum _ fun i _ ↦ hI n i, Finset.mul_sum]
    refine Finset.sum_congr rfl fun v _ ↦ ?_
    rw [integral_indicator (hM n v), setIntegral_const, smul_eq_mul, Measure.real,
      boxCell_volume D (M n) (ha n) v, ENNReal.toReal_ofReal (pow_nonneg (ha n).le _)]
  have hcell (n : ℕ) (x : MassShell.Space D) (v : FreeBoxSite D (M n)) (hx : x ∈ C n v) :
      F n x = g (Y n v) := by
    unfold F
    rw [Finset.sum_eq_single v, Set.indicator_of_mem hx]
    · intro w _ hw
      apply Set.indicator_of_notMem
      exact fun h ↦ Set.disjoint_left.mp (boxCell_pairwiseDisjoint _ _ (ha n) (mem_univ w) (mem_univ v) hw) h hx
    · simp
  have hrad : Tendsto (fun n ↦ Real.sqrt D * a n) atTop (𝓝 0) := by
    simpa using hzero.const_mul (Real.sqrt D)
  have hFto (x : MassShell.Space D) : Tendsto (fun n ↦ F n x) atTop (𝓝 (g x)) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨δ,hδ,hδx⟩ := Metric.continuousAt_iff.mp g.continuous.continuousAt ε hε
    filter_upwards [hrad.eventually (gt_mem_nhds hδ),
      hexhaust.eventually (eventually_gt_atTop ‖x‖)] with n hn hbig
    have hx : x ∈ ⋃ v ∈ (Finset.univ : Finset (FreeBoxSite D (M n))), C n v := by
      rw [show (⋃ v ∈ (Finset.univ : Finset (FreeBoxSite D (M n))), C n v) = _ from
        boxCell_biUnion D (M n) (ha n)]
      intro j
      have hj : |x j| ≤ ‖x‖ := PiLp.norm_apply_le x j
      rcases abs_le.mp hj with ⟨hl,hu⟩
      constructor <;> nlinarith [ha n]
    obtain ⟨v, hv, hxv⟩ := Set.mem_iUnion₂.mp hx
    rw [hcell n x v hxv]
    exact hδx (lt_of_le_of_lt (freeBox_cell_dist (ha n) hxv) hn)
  let N := D+1
  let A := (2:ℝ)^N * (Finset.Iic (N,0)).sup (fun m ↦ SchwartzMap.seminorm ℝ m.1 m.2) g
  have hA : 0 ≤ A := by unfold A; positivity
  have hdec (x : MassShell.Space D) : (1+‖x‖)^N * ‖g x‖ ≤ A := by
    simpa [A, norm_iteratedFDeriv_zero] using
      (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (N,0)) le_rfl le_rfl g x)
  let b (x : MassShell.Space D) := ((2:ℝ)^N * A) * ((1+‖x‖)^N)⁻¹
  have hb : Integrable b := by
    have h : Integrable (fun x : MassShell.Space D ↦ (1+‖x‖)^(-(N:ℝ))) :=
      integrable_one_add_norm (by simp [N])
    have hpow (x : MassShell.Space D) : (1+‖x‖)^(-(N:ℝ)) = ((1+‖x‖)^N)⁻¹ := by
      rw [Real.rpow_neg (by positivity), Real.rpow_natCast]
    simpa only [b, hpow] using h.const_mul ((2:ℝ)^N * A)
  have hbnd : ∀ᶠ n in atTop, ∀ᵐ x ∂volume, ‖F n x‖ ≤ b x := by
    filter_upwards [hrad.eventually (gt_mem_nhds zero_lt_one)] with n hn
    refine ae_of_all _ fun x ↦ ?_
    by_cases hx : ∃ v, x ∈ C n v
    · obtain ⟨v,hv⟩ := hx
      rw [hcell n x v hv]
      have hd : dist (Y n v) x ≤ 1 := (freeBox_cell_dist (ha n) hv).trans hn.le
      have hxy : 1+‖x‖ ≤ 2*(1+‖Y n v‖) := by
        rw [dist_comm, dist_eq_norm] at hd
        linarith [norm_sub_norm_le x (Y n v), norm_nonneg (Y n v)]
      change _ ≤ _ * _⁻¹
      rw [← div_eq_mul_inv, le_div_iff₀ (by positivity)]
      calc ‖g (Y n v)‖ * (1+‖x‖)^N ≤ ‖g (Y n v)‖ * (2*(1+‖Y n v‖))^N := by gcongr
        _ = 2^N * ((1+‖Y n v‖)^N * ‖g (Y n v)‖) := by rw [mul_pow]; ring
        _ ≤ _ := by gcongr; exact hdec _
    · have h0 : F n x = 0 := Finset.sum_eq_zero fun v _ ↦ Set.indicator_of_notMem (fun hv ↦ hx ⟨v,hv⟩) _
      rw [h0, norm_zero]; dsimp only [b]; positivity
  have hlim := tendsto_integral_filter_of_dominated_convergence b
    (Eventually.of_forall fun n ↦ (hFn n).aestronglyMeasurable) hbnd hb (ae_of_all _ hFto)
  exact hlim.congr hIn

end DotProduct.Extension


/-! ### Exhausting free boxes on all Schwartz tests -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Matrix
open scoped SchwartzMap Topology

/-- The position-space covariance of exhausting free boxes tends to the exact massive
resolvent covariance for all real Schwartz functions in every dimension. -/
theorem tendsto_freeBox_schwartz_covariance {D : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    {a : ℕ → ℝ} {M : ℕ → ℕ} (ha : ∀ n, 0 < a n) (hz : Tendsto a atTop (𝓝 0))
    (hex : Tendsto (fun n ↦ (M n : ℝ)*a n) atTop atTop)
    (f g : 𝓢(MassShell.Space D, ℝ)) :
    Tendsto (fun n ↦ ((siteSample D (M n) (a n) f ⬝ᵥ
      (freeBoxCov D (M n) (a n) ħ m *ᵥ siteSample D (M n) (a n) g) : ℝ) : ℂ))
      atTop (𝓝 (continuumCov ħ m (physicsFourier f) (physicsFourier g))) := by
  let u := schwartzResolvent m g
  have hs (h : 𝓢(MassShell.Space D, ℝ)) :
      Tendsto (fun n ↦ (a n)^D * ∑ v, h (boxCoord D (M n) (a n) v) * h (boxCoord D (M n) (a n) v))
        atTop (𝓝 (∫ x, h x * h x)) := by
    simpa only [SchwartzMap.smulLeftCLM_apply_apply h.hasTemperateGrowth, smul_eq_mul] using
      tendsto_freeBox_riemannSum_schwartz ha hz hex (SchwartzMap.smulLeftCLM ℝ (h : _ → ℝ) h)
  have hreal := tendsto_freeBox_covariance_of_sampled_norms hħ hm ha hz hex
    f.continuous (f.memLp 2) g.continuous (g.memLp 2) (hs f) (hs g) (u.memLp 2)
    (fun ε hε ↦ by
      obtain ⟨v, hv4, hvc, hvu, hvop⟩ := schwartz_resolvent_graph_approx m u ε hε
      refine ⟨v,hv4,hvc,hvu,?_⟩
      simpa [u, contMassiveOp_schwartzResolvent hm g] using hvop)
  rw [continuumCov_eq_resolvent_pairing ħ hm f g]
  exact Complex.continuous_ofReal.continuousAt.tendsto.comp hreal

/-- Weak convergence on every finite list of the original real Schwartz smears. The measures
are pushforwards of the position-space Gibbs law and the constructed continuum Gaussian law. -/
theorem tendsto_freeBox_schwartz_joint_law {D k : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    {a : ℕ → ℝ} {M : ℕ → ℕ} (ha : ∀ n, 0 < a n) (hz : Tendsto a atTop (𝓝 0))
    (hex : Tendsto (fun n ↦ (M n : ℝ) * a n) atTop atTop) (f : Fin k → 𝓢(MassShell.Space D, ℝ)) :
    Tendsto (fun n ↦ freeBoxObservationLaw (M n) (a n) hħ hm f) atTop
      (𝓝 (continuumObservationLaw hħ.le hm f)) := by
  apply ProbabilityMeasure.tendsto_of_tendsto_charFun
  intro t
  unfold continuumObservationLaw freeBoxObservationLaw
  simp_rw [jointObservationLaw_char]
  rw [massiveEuclideanLaw_jointChar hħ.le hm f]
  let F : 𝓢(MassShell.Space D, ℝ) := ∑ i, t i • f i
  have hF (p) : physicsFourier F p = ∑ i, (t i : ℂ) * physicsFourier (f i) p := by
    simp only [← physicsFourierSchwartz_apply, F, map_sum, map_smul,
      _root_.sum_apply, _root_.smul_apply, Complex.real_smul]
  have hc := tendsto_freeBox_schwartz_covariance hħ hm ha hz hex F F
  rw [funext hF] at hc
  refine (Complex.continuous_exp.continuousAt.tendsto.comp (hc.neg.div_const 2)).congr fun n ↦ ?_
  let S := siteSample D (M n) (a n) F
  let Q := freeBoxPrecision D (M n) (a n) ħ m
  have hsum (φ : FreeBoxSite D (M n) → ℝ) :
      (∑ r, t r * (siteSample D (M n) (a n) (f r) ⬝ᵥ φ)) = ∑ v, S v * φ v := by
    simp only [dotProduct, Finset.mul_sum, siteSample, S, F, _root_.sum_apply,
      _root_.smul_apply, smul_eq_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun v _ ↦ ?_
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun i _ ↦ by ring
  dsimp only [Function.comp_apply, Pi.neg_apply]
  simp_rw [hsum]
  rw [tilted_gibbs_charFun (freeBoxPrecision_posDef D (M n) (a n) hħ hm) S, Complex.ofReal_exp]
  congr 1
  push_cast
  change -((S ⬝ᵥ (Q⁻¹ *ᵥ S) : ℝ) : ℂ) / 2 = _
  ring

end DotProduct.Extension


/-! ### Uniqueness from the actual finite marginal limits -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap Topology

/-- The continuum coordinate law is the only probability law compatible with the weak limits
    of the joint Gibbs readings along even one exhausting sequence of free boxes. -/
theorem massiveEuclideanLaw_unique_of_box_limits {D : ℕ} {ħ m : ℝ}
    (hħ : 0 < ħ) (hm : 0 < m) {a : ℕ → ℝ} {M : ℕ → ℕ} (ha : ∀ j, 0 < a j)
    (hz : Tendsto a atTop (𝓝 0)) (hex : Tendsto (fun j ↦ (M j : ℝ) * a j) atTop atTop)
    (Q : Measure (𝓢(MassShell.Space D, ℝ) → ℝ)) [IsProbabilityMeasure Q]
    (hQ : ∀ {k : ℕ} (f : Fin k → 𝓢(MassShell.Space D, ℝ)),
      Tendsto (fun j ↦ freeBoxObservationLaw (M j) (a j) hħ hm f) atTop
        (𝓝 (jointObservationLaw Q (fun i x ↦ x (f i)) (fun i ↦ measurable_pi_apply (f i))))) :
    Q = massiveEuclideanLaw D ħ m hħ.le hm := by
  classical
  apply massiveEuclideanLaw_unique hħ.le hm Q
  intro s c
  let e := (Fintype.equivFin s).symm
  let f (i : Fin (Fintype.card s)) := (e i).val
  let t : MassShell.Space (Fintype.card s) := WithLp.toLp 2 (fun i ↦ c (e i))
  let P := massiveEuclideanLaw D ħ m hħ.le hm
  let X := fun (i : Fin (Fintype.card s)) (x : 𝓢(MassShell.Space D, ℝ) → ℝ) ↦ x (f i)
  have hM (i) : Measurable (X i) := measurable_pi_apply _
  have heq : jointObservationLaw Q X hM = jointObservationLaw P X hM :=
    tendsto_nhds_unique (hQ f) (tendsto_freeBox_schwartz_joint_law hħ hm ha hz hex f)
  have hc := congrArg (fun ν : ProbabilityMeasure (MassShell.Space (Fintype.card s)) ↦
    charFun (ν : Measure _) t) heq
  change charFun (jointObservationLaw Q X hM : Measure _) t = charFun (jointObservationLaw P X hM : Measure _) t at hc
  rw [jointObservationLaw_char, jointObservationLaw_char] at hc
  have hre (x : 𝓢(MassShell.Space D, ℝ) → ℝ) :
      (∑ i : Fin (Fintype.card s), t i * X i x) = ∑ i : s, c i * x i :=
    e.sum_comp (fun i ↦ c i * x i)
  simp_rw [hre] at hc
  exact hc.trans (massiveEuclideanLaw_jointChar hħ.le hm (fun i : s ↦ i.val) c)

end DotProduct.Extension


/-! ### Angular-frequency inversion of the normal resolvent -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped FourierTransform

theorem normalResolvent_integrable {ω : ℝ} (hω : 0 < ω) :
    Integrable (fun q : ℝ ↦ (ω ^ 2 + q ^ 2)⁻¹) := by
  have h := (integrable_inv_one_add_sq.comp_mul_left' (inv_ne_zero hω.ne')).const_mul (ω ^ 2)⁻¹
  convert h using 1
  ext q
  field_simp [hω.ne']

/-- Inversion with the paper's angular frequency and Lebesgue measure. -/
theorem inverseNormalKernel {ω : ℝ} (hω : 0 < ω) (t : ℝ) :
    (∫ q : ℝ, Complex.exp ((q : ℂ) * Complex.I * t) * (((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹)) =
      ((2 * Real.pi : ℝ) : ℂ) * (expKernel ω t : ℂ) := by
  let K (s : ℝ) : ℂ := expKernel ω s
  let B := 2 * Real.pi
  have hB : 0 < B := by dsimp [B]; positivity
  let R (q : ℝ) : ℂ := ((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹
  have hR : Integrable R := by
    simpa [R] using ((normalResolvent_integrable hω).ofReal (𝕜 := ℂ))
  have hK : Integrable K := by
    have h : Integrable (fun s : ℝ ↦ Real.exp (-ω * |s|)) := by
      rw [← integrableOn_univ, ← union_compl_self (Ioi (0 : ℝ)), compl_Ioi]
      refine ((integrableOn_exp_mul_Ioi (neg_neg_of_pos hω) 0).congr_fun ?_ measurableSet_Ioi).union
        ((integrableOn_exp_mul_Iic hω 0).congr_fun ?_ measurableSet_Iic)
      · intro x hx
        simp [abs_of_pos (mem_Ioi.mp hx)]
      · intro x hx
        simp [abs_of_nonpos (mem_Iic.mp hx)]
    exact (h.div_const _).ofReal
  have hft (ξ : ℝ) : 𝓕 K ξ = R (B * ξ) := by
    rw [Real.fourier_eq']
    convert expKernel_fourier ω (-(B * ξ)) hω using 1
    · apply integral_congr_ae
      refine ae_of_all _ fun x ↦ ?_
      dsimp only
      rw [smul_eq_mul, mul_comm]
      congr 2
      simp [B]
      ring
    · simp [B, R]
  have hinv := hK.fourierInv_fourier_eq (by
    simp_rw [show 𝓕 K = fun ξ ↦ R (B * ξ) from funext hft]
    exact hR.comp_mul_left' hB.ne') (v := t) (by unfold K expKernel; fun_prop)
  let F (q : ℝ) := Complex.exp ((q : ℂ) * Complex.I * t) * R q
  have hscaled : (∫ ξ : ℝ, F (B * ξ)) = K t := by
    rw [← hinv, Real.fourierInv_eq']
    apply integral_congr_ae
    refine ae_of_all _ fun ξ ↦ ?_
    dsimp only
    rw [hft, smul_eq_mul]
    unfold F
    congr 2
    simp [B]
    ring
  rw [Measure.integral_comp_mul_left, abs_of_pos (inv_pos.mpr hB), Complex.real_smul] at hscaled
  change (∫ q, F q) = (B : ℂ) * K t
  rw [← hscaled, ← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hB.ne', Complex.ofReal_one,
    one_mul]

end DotProduct.Extension


/-! ### Ambient plane mollifiers and the normalized plane embedding -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap FourierTransform Topology

private theorem derivative_comp_contraction {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F]
    (L : E →L[ℝ] F) (hL : ‖L‖ ≤ 1) (f : 𝓢(F, ℝ)) (i : ℕ) (p : E) :
    ‖iteratedFDeriv ℝ i (f ∘ L) p‖ ≤ ‖iteratedFDeriv ℝ i f (L p)‖ := by
  rw [L.iteratedFDeriv_comp_right (f.smooth i) p (by simp)]
  refine ((iteratedFDeriv ℝ i f (L p)).norm_compContinuousLinearMap_le _).trans ?_
  simpa only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, mul_one] using
    mul_le_mul_of_nonneg_left (pow_le_one₀ (n := i) (norm_nonneg L) hL) (norm_nonneg _)

/-- The exterior product of real Schwartz functions, with the product norm on the domain. -/
noncomputable def separatedSchwartz {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (h : 𝓢(ℝ, ℝ)) (g : 𝓢(E, ℝ)) : 𝓢(ℝ × E, ℝ) where
  toFun p := h p.1 * g p.2
  smooth' := (h.smooth'.comp contDiff_fst).mul (g.smooth'.comp contDiff_snd)
  decay' := by
    intro k n
    let A := ContinuousLinearMap.fst ℝ ℝ E
    let B := ContinuousLinearMap.snd ℝ ℝ E
    have hA : ‖A‖ ≤ 1 := A.opNorm_le_bound zero_le_one fun x ↦ by simpa [A] using norm_fst_le x
    have hB : ‖B‖ ≤ 1 := B.opNorm_le_bound zero_le_one fun x ↦ by simpa [B] using norm_snd_le x
    let S (i : ℕ) := (SchwartzMap.seminorm ℝ k i h) * (SchwartzMap.seminorm ℝ 0 (n-i) g) +
      (SchwartzMap.seminorm ℝ 0 i h) * (SchwartzMap.seminorm ℝ k (n-i) g)
    refine ⟨∑ i ∈ Finset.range (n+1), (n.choose i : ℝ) * S i, ?_⟩
    intro p
    have hd := norm_iteratedFDeriv_mul_le ((h.smooth n).comp A.contDiff)
      ((g.smooth n).comp B.contDiff) p (n := n) (by simp)
    refine (mul_le_mul_of_nonneg_left hd (by positivity : 0 ≤ ‖p‖ ^ k)).trans ?_
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun i _ ↦ ?_
    calc ‖p‖ ^ k * ((n.choose i : ℝ) * ‖iteratedFDeriv ℝ i (h ∘ A) p‖ *
            ‖iteratedFDeriv ℝ (n-i) (g ∘ B) p‖) ≤
        (n.choose i : ℝ) * (‖p‖ ^ k * ‖iteratedFDeriv ℝ i h p.1‖ *
          ‖iteratedFDeriv ℝ (n-i) g p.2‖) := by
            rw [show (n.choose i : ℝ) * (‖p‖ ^ k * ‖iteratedFDeriv ℝ i h p.1‖ *
              ‖iteratedFDeriv ℝ (n-i) g p.2‖) = ‖p‖ ^ k * ((n.choose i : ℝ) *
              ‖iteratedFDeriv ℝ i h p.1‖ * ‖iteratedFDeriv ℝ (n-i) g p.2‖) by ring]
            gcongr
            · exact derivative_comp_contraction A hA h i p
            · exact derivative_comp_contraction B hB g (n-i) p
      _ ≤ _ := by
        gcongr
        rcases le_total ‖p.1‖ ‖p.2‖ with hp|hp
        · rw [Prod.norm_def, max_eq_right hp, mul_right_comm (‖p.2‖^k), mul_comm]
          exact (mul_le_mul (h.norm_iteratedFDeriv_le_seminorm ℝ _ _)
            (g.le_seminorm ℝ _ _ _) (by positivity) (by positivity)).trans
              (le_add_of_nonneg_left (by positivity))
        · rw [Prod.norm_def, max_eq_left hp]
          exact (mul_le_mul (h.le_seminorm ℝ _ _ _)
            (g.norm_iteratedFDeriv_le_seminorm ℝ _ _) (by positivity) (by positivity)).trans
              (le_add_of_nonneg_right (by positivity))


/-- The separated real test with time as the first Euclidean coordinate. -/
noncomputable def separatedEuclideanSchwartz {d : ℕ}
    (h : 𝓢(ℝ, ℝ)) (g : 𝓢(MassShell.Space d, ℝ)) : 𝓢(MassShell.Space (d+1), ℝ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
    ((MassShell.splitIsometry d).toContinuousLinearEquiv.trans
      (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ (MassShell.Space d))) (separatedSchwartz h g)

theorem physicsFourier_integral {D : ℕ} (f : MassShell.Space D → ℝ) (p : MassShell.Space D) :
    physicsFourier f p = ((2 * Real.pi) ^ (-(D : ℝ) / 2) : ℝ) *
      ∫ x, (f x : ℂ) * Complex.exp (-Complex.I * (inner ℝ x p : ℂ)) := by
  unfold physicsFourier
  rw [Real.fourier_eq]
  congr 1
  apply integral_congr_ae
  refine ae_of_all _ fun x ↦ ?_
  dsimp only
  rw [Circle.smul_def, smul_eq_mul, Real.fourierChar_apply, mul_comm]
  congr 2
  rw [real_inner_smul_right]
  push_cast
  field_simp [Real.pi_ne_zero]

/-- The single factor from the normal coordinate in the unitary Fourier convention. -/
noncomputable def normalFourierScale : ℝ := (2 * Real.pi) ^ (-(1 : ℝ) / 2)

theorem physicsFourier_separated {d : ℕ} (h : 𝓢(ℝ, ℝ)) (g : 𝓢(MassShell.Space d, ℝ))
    (p : MassShell.Space (d+1)) :
    physicsFourier (separatedEuclideanSchwartz h g) p =
      (normalFourierScale : ℂ) * normalTransform h (p 0) * physicsFourier g (MassShell.tail p) := by
  rw [physicsFourier_integral, physicsFourier_integral]
  have hi (x : MassShell.Space (d+1)) :
      inner ℝ x p = x 0 * p 0 + inner ℝ (MassShell.tail x) (MassShell.tail p) := by
    rw [← (MassShell.splitIsometry d).inner_map_map x p, WithLp.prod_inner_apply]
    change inner ℝ (x 0) (p 0) + _ = _
    simp [real_inner_comm, mul_comm]
    rfl
  let F (x : ℝ × MassShell.Space d) := ((h x.1 : ℂ) *
    Complex.exp (-Complex.I * (p 0 : ℂ) * x.1)) *
      ((g x.2 : ℂ) * Complex.exp (-Complex.I * (inner ℝ x.2 (MassShell.tail p) : ℂ)))
  have hrew (x : MassShell.Space (d+1)) :
      ((separatedEuclideanSchwartz h g x : ℝ) : ℂ) * Complex.exp (-Complex.I * (inner ℝ x p : ℂ)) =
        F ((MassShell.split d) x) := by
    rw [hi, Complex.ofReal_add, mul_add, Complex.exp_add]
    change ((h (x 0) * g (MassShell.tail x) : ℝ) : ℂ) * _ = _
    unfold F
    rw [MassShell.split_apply, Complex.ofReal_mul]
    dsimp
    rw [Complex.ofReal_mul]
    rw [show -Complex.I * (↑(x 0) * ↑(p 0)) = -Complex.I * ↑(p 0) * ↑(x 0) by ring]
    ring
  simp_rw [hrew]
  rw [(MassShell.split_volume d).integral_comp' F]
  change _ * (∫ z : ℝ × MassShell.Space d, _ ∂(volume.prod volume)) = _
  dsimp only [F]
  rw [integral_prod_mul (f := fun s : ℝ ↦ (h s : ℂ) * Complex.exp (-Complex.I * (p 0 : ℂ) * (s : ℂ)))
    (g := fun y : MassShell.Space d ↦ (g y : ℂ) * Complex.exp (-Complex.I * (inner ℝ y (MassShell.tail p) : ℂ)))]
  have hc : (2 * Real.pi) ^ (-((d + 1 : ℕ) : ℝ) / 2) =
      normalFourierScale * (2 * Real.pi) ^ (-(d : ℝ) / 2) := by
    rw [normalFourierScale, ← Real.rpow_add (by positivity)]
    congr 1
    push_cast
    ring
  rw [hc, Complex.ofReal_mul]
  unfold normalTransform
  ring


/-- The actual plane test in full Euclidean momentum space. -/
noncomputable def massivePlaneFun {d : ℕ} (ħ m : ℝ) (g : 𝓢(MassShell.Space d, ℝ))
    (p : MassShell.Space (d+1)) : ℂ :=
  (Real.sqrt (ħ / continuumDispersion m p) : ℂ) * (normalFourierScale : ℂ) *
    physicsFourier g (MassShell.tail p)

theorem massivePlaneFun_memLp {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) : MemLp (massivePlaneFun ħ m g) 2 volume := by
  let G := physicsFourierSchwartz d g
  have hg2 : Integrable (fun k : MassShell.Space d ↦ ‖G k‖ ^ 2) := by
    simpa using (G.memLp 2).integrable_norm_pow (p := 2) (by decide)
  have hdom := (MassShell.split_volume d).integrable_comp_of_integrable
    (((normalResolvent_integrable hm).mul_prod hg2).const_mul (ħ * normalFourierScale ^ 2))
  have htail : Measurable (@MassShell.tail d) := measurable_snd.comp (MassShell.split d).measurable
  have hC : Measurable (massivePlaneFun ħ m g) := by
    have hF : Measurable (physicsFourier g) := by
      exact (show (physicsFourier g) = G from funext fun p ↦
        (physicsFourierSchwartz_apply g p).symm) ▸ G.continuous.measurable
    have hW : Measurable (fun p : MassShell.Space (d+1) ↦
        (Real.sqrt (ħ / continuumDispersion m p) : ℂ)) := by
      unfold continuumDispersion
      fun_prop
    exact (hW.mul_const (normalFourierScale : ℂ)).mul (hF.comp htail)
  apply (memLp_two_iff_integrable_sq_norm hC.aestronglyMeasurable).2
  refine hdom.mono' (hC.norm.pow_const 2).aestronglyMeasurable (ae_of_all _ fun p ↦ ?_)
  change ‖‖massivePlaneFun ħ m g p‖ ^ 2‖ ≤ ħ * normalFourierScale ^ 2 *
    ((m ^ 2 + (p 0)^2)⁻¹ * ‖G (MassShell.tail p)‖ ^ 2)
  rw [Real.norm_of_nonneg (sq_nonneg _)]
  unfold massivePlaneFun
  rw [norm_mul, norm_mul, mul_pow, mul_pow, Complex.norm_real, Complex.norm_real,
    Real.norm_eq_abs, Real.norm_eq_abs, sq_abs, sq_abs, Real.sq_sqrt (div_nonneg hħ (by
      unfold continuumDispersion; positivity))]
  change ħ / continuumDispersion m p * normalFourierScale ^ 2 * ‖G (MassShell.tail p)‖ ^ 2 ≤ _
  have hle : (continuumDispersion m p)⁻¹ ≤ (m ^ 2 + (p 0)^2)⁻¹ := by
    apply inv_anti₀ (by positivity)
    rw [continuumDispersion, MassShell.norm_sq_split]
    linarith [sq_nonneg ‖MassShell.tail p‖]
  rw [div_eq_mul_inv]
  calc _ = ħ * normalFourierScale ^ 2 * ((continuumDispersion m p)⁻¹ * ‖G (MassShell.tail p)‖^2) := by ring
    _ ≤ _ := by gcongr

/-- Plane reading label in the very same covariance Hilbert space as the bulk tests. -/
noncomputable def massivePlaneLabel {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) : Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))) :=
  (massivePlaneFun_memLp hħ hm g).toLp _

theorem massivePlaneLabel_apply_ae {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) :
    ⇑(massivePlaneLabel hħ hm g) =ᵐ[volume] massivePlaneFun ħ m g :=
  (massivePlaneFun_memLp hħ hm g).coeFn_toLp

/-- Spatially unrestricted one-sided spacetime smears at radius r. -/
noncomputable def oneSidedNormalSchwartz (ρ : 𝓢(ℝ, ℝ)) (r : ℝ) : 𝓢(ℝ, ℝ) :=
  if hr : r = 0 then 0 else
    r⁻¹ • SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
      (ContinuousLinearEquiv.smulLeft (Units.mk0 r⁻¹ (inv_ne_zero hr))) ρ

theorem oneSidedNormalSchwartz_apply (ρ : 𝓢(ℝ, ℝ)) {r : ℝ} (hr : 0 < r) (t : ℝ) :
    oneSidedNormalSchwartz ρ r t = r⁻¹ * ρ (t / r) := by
  rw [oneSidedNormalSchwartz, dite_eq_right hr.ne']
  change r⁻¹ * ρ (r⁻¹ * t) = _
  rw [div_eq_inv_mul]

theorem normalTransform_oneSidedNormalSchwartz (ρ : 𝓢(ℝ, ℝ)) {r : ℝ} (hr : 0 < r) (q : ℝ) :
    normalTransform (oneSidedNormalSchwartz ρ r) q = normalTransform ρ (r*q) := by
  let F (t : ℝ) := (oneSidedNormalSchwartz ρ r t : ℂ) * Complex.exp (-Complex.I * (q : ℂ) * t)
  have h (t : ℝ) : (r : ℂ) * F (r*t) =
      (ρ t : ℂ) * Complex.exp (-Complex.I * ((r*q : ℝ) : ℂ) * t) := by
    simp only [F, oneSidedNormalSchwartz_apply ρ hr, mul_div_cancel_left₀ t hr.ne',
      Complex.ofReal_mul, Complex.ofReal_inv]
    rw [show -Complex.I * (q : ℂ) * ((r : ℂ) * t) = -Complex.I * ((r : ℂ) * q) * t by ring]
    field_simp [Complex.ofReal_ne_zero.mpr hr.ne']
  change (∫ t, F t) = _
  unfold normalTransform
  simp_rw [← h]
  rw [integral_const_mul, Measure.integral_comp_mul_left _ r, abs_of_pos (inv_pos.mpr hr),
    Complex.real_smul, Complex.ofReal_inv, ← mul_assoc,
    mul_inv_cancel₀ (Complex.ofReal_ne_zero.mpr hr.ne'), one_mul]


private theorem norm_sq_L2_integral {E : Type*} [MeasurableSpace E]
    (μ : Measure E) (v : Lp ℂ 2 μ) : ‖v‖ ^ 2 = ∫ k, ‖v k‖ ^ 2 ∂μ := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  simp_rw [real_inner_self_eq_norm_sq]

/-- Shrinking normalized positive-time Schwartz mollifications converge in the full
massive Euclidean covariance norm to the plane reading for each spatial Schwartz smear. -/
theorem massiveEuclideanLabel_tendsto_plane {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) (ρ : 𝓢(ℝ, ℝ)) (hn : ∀ t, 0 ≤ ρ t)
    (hs : tsupport (ρ : ℝ → ℝ) ⊆ Ioo 1 2) (h1 : ∫ t, ρ t = 1) :
    Tendsto (fun r ↦ massiveEuclideanLabel (d+1) ħ m hħ hm
      (separatedEuclideanSchwartz (oneSidedNormalSchwartz ρ r) g))
      (𝓝[>] 0) (𝓝 (massivePlaneLabel hħ hm g)) := by
  let B (r : ℝ) := massiveEuclideanLabel (d+1) ħ m hħ hm
    (separatedEuclideanSchwartz (oneSidedNormalSchwartz ρ r) g)
  let P := massivePlaneLabel hħ hm g
  let V := massivePlaneFun ħ m g
  let F (r : ℝ) (p : MassShell.Space (d+1)) := ‖(normalTransform ρ (r*p 0) - 1) * V p‖ ^ 2
  have hV := massivePlaneFun_memLp hħ hm g
  have heq {r : ℝ} (hr : 0 < r) :
      (fun p ↦ ‖(B r - P) p‖ ^ 2) =ᵐ[volume] F r := by
    filter_upwards [Lp.coeFn_sub (B r) P, massiveEuclideanLabel_apply_ae hħ hm
      (separatedEuclideanSchwartz (oneSidedNormalSchwartz ρ r) g),
      massivePlaneLabel_apply_ae hħ hm g] with p hp hb hP
    change (B r) p = _ at hb
    change P p = _ at hP
    rw [hp]
    dsimp only [Pi.sub_apply]
    rw [hb, hP, physicsFourier_separated, normalTransform_oneSidedNormalSchwartz ρ hr]
    unfold F V massivePlaneFun
    congr 2
    ring
  have hpos : ∀ᶠ r : ℝ in 𝓝[>] 0, 0 < r := self_mem_nhdsWithin
  have hconv : Tendsto (fun r ↦ ∫ p, F r p) (𝓝[>] 0) (𝓝 0) := by
    have H := tendsto_integral_filter_of_dominated_convergence
      (F := F) (f := fun _ ↦ (0 : ℝ)) (fun p ↦ 4 * ‖V p‖ ^ 2)
      (hpos.mono fun r hr ↦ (((Lp.aestronglyMeasurable (B r - P)).norm.pow 2).congr (heq hr)))
      (Eventually.of_forall fun r ↦ ae_of_all _ fun p ↦ by
        have hnorm : ‖normalTransform ρ (r * p 0) - 1‖ ≤ 2 :=
          (norm_sub_le _ _).trans (by rw [norm_one]; linarith [seam_norm_normalTransform_le_one hn h1 (r * p 0)])
        dsimp only [F]
        rw [Real.norm_of_nonneg (sq_nonneg _), norm_mul, mul_pow]
        gcongr
        nlinarith [sq_nonneg (2 - ‖normalTransform ρ (r*p 0) - 1‖),
          mul_nonneg (by linarith : 0 ≤ 2 - ‖normalTransform ρ (r*p 0) - 1‖)
            (by positivity : 0 ≤ 2 + ‖normalTransform ρ (r*p 0) - 1‖)])
      (((memLp_two_iff_integrable_sq_norm hV.aestronglyMeasurable).1 hV).const_mul 4)
      (ae_of_all _ fun p ↦ by
        have h := seam_tendsto_normalTransform_zero ρ.continuous hs h1 (p 0)
        simpa [F] using ((((h.sub_const 1).mul_const (V p)).norm).pow 2))
    simpa using H
  have hnorm : Tendsto (fun r ↦ ‖B r - P‖ ^ 2) (𝓝[>] 0) (𝓝 0) := by
    apply hconv.congr' (hpos.mono fun r hr ↦ ?_)
    rw [norm_sq_L2_integral]
    exact integral_congr_ae (heq hr).symm
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  simpa only [Real.sqrt_sq (norm_nonneg _), Real.sqrt_zero, Function.comp_def] using
    (Real.continuous_sqrt.continuousAt.tendsto.comp hnorm)

/-- Each mollifying preparation is supported strictly to the positive side. -/
theorem oneSidedSchwartz_support {d : ℕ} (g : 𝓢(MassShell.Space d, ℝ)) (ρ : 𝓢(ℝ, ℝ))
    (hs : tsupport (ρ : ℝ → ℝ) ⊆ Ioo 1 2) {r : ℝ} (hr : 0 < r) :
    tsupport (separatedEuclideanSchwartz (oneSidedNormalSchwartz ρ r) g :
      MassShell.Space (d+1) → ℝ) ⊆ {x | 0 < x 0} := by
  let f := separatedEuclideanSchwartz (oneSidedNormalSchwartz ρ r) g
  have c : Continuous (fun x : MassShell.Space (d+1) ↦ x 0) := (EuclideanSpace.proj 0).continuous
  have hc : IsClosed {x : MassShell.Space (d+1) | r ≤ x 0} := isClosed_le continuous_const c
  have hsub : Function.support (f : MassShell.Space (d+1) → ℝ) ⊆ {x | r ≤ x 0} := by
    intro x hx
    have hne : ρ (x 0/r) ≠ 0 := by
      intro he
      apply hx
      change oneSidedNormalSchwartz ρ r (x 0) * _ = 0
      rw [oneSidedNormalSchwartz_apply ρ hr, he, mul_zero, zero_mul]
    have hlt := (hs (subset_tsupport ρ hne)).1
    exact (by linarith [(lt_div_iff₀ hr).mp hlt] : r ≤ x 0)
  exact (closure_minimal hsub hc).trans fun x hx ↦ lt_of_lt_of_le hr hx


/-- Each spatial Schwartz plane reading is the ambient norm limit of actual positive-side
preparations, using a smooth probability bump supplied by the released construction. -/
theorem massivePlaneLabel_mem_closure_positive {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) :
    massivePlaneLabel hħ hm g ∈ closure
      ((massiveEuclideanLabel (d+1) ħ m hħ hm) ''
        {f : 𝓢(MassShell.Space (d+1), ℝ) | tsupport (f : _ → ℝ) ⊆ {x | 0 < x 0}}) := by
  obtain ⟨ρ, hρ, hn, hs, h1⟩ := exists_smooth_unit_bump_Ioo_one_two
  let b := (seam_hasCompactSupport_of_tsupport_Ioo hs).toSchwartzMap hρ
  apply mem_closure_of_tendsto (massiveEuclideanLabel_tendsto_plane hħ hm g b hn hs h1)
  filter_upwards [self_mem_nhdsWithin (α := ℝ) (a := 0) (s := Ioi 0)] with r hr
  exact ⟨_, oneSidedSchwartz_support g b hs hr, rfl⟩

theorem normalFourierScale_sq : normalFourierScale ^ 2 = (2 * Real.pi)⁻¹ := by
  unfold normalFourierScale
  rw [← Real.rpow_natCast _ 2, ← Real.rpow_mul (by positivity : 0 ≤ 2 * Real.pi)]
  push_cast
  rw [show -(1:ℝ) / 2 * 2 = -1 by ring, Real.rpow_neg_one]

/-- The normal mass of the Euclidean resolvent at fixed transverse momentum. -/
theorem normalResolvent_mass {ω : ℝ} (hω : 0 < ω) :
    ∫ q : ℝ, (ω^2 + q^2)⁻¹ = Real.pi / ω := by
  have h := inverseNormalKernel hω 0
  simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, one_mul, ← Complex.ofReal_inv,
    integral_complex_ofReal, expKernel, abs_zero, Real.exp_zero, ← Complex.ofReal_mul,
    Complex.ofReal_inj] at h
  rw [h]
  field_simp

private noncomputable def planeSplitFun {d : ℕ} (m : ℝ)
    (u : Lp ℂ 2 (volume : Measure (MassShell.Space d))) (z : ℝ × MassShell.Space d) : ℂ :=
  (normalFourierScale : ℂ) *
    (Real.sqrt (2 * modeDispersion m z.2 / ((modeDispersion m z.2)^2 + z.1^2)) : ℂ) * u z.2

private theorem planeSplitFun_L2 {d : ℕ} {m : ℝ} (hm : 0 < m)
    (u : Lp ℂ 2 (volume : Measure (MassShell.Space d))) :
    MemLp (planeSplitFun m u) 2 (volume.prod volume) ∧
      ∫ z, ‖planeSplitFun m u z‖^2 ∂(volume.prod volume) = ‖u‖^2 := by
  have hM : AEStronglyMeasurable (planeSplitFun m u) (volume.prod volume) := by
    have hW : Measurable (fun z : ℝ × MassShell.Space d ↦
        (normalFourierScale : ℂ) *
        (Real.sqrt (2 * modeDispersion m z.2 / (modeDispersion m z.2 ^ 2 + z.1 ^ 2)) : ℂ)) := by
      unfold modeDispersion
      fun_prop
    exact hW.aestronglyMeasurable.mul (Lp.aestronglyMeasurable u).comp_snd
  let W := @modeDispersion d m
  have hW (k : MassShell.Space d) : 0 < W k := modeDispersion_pos hm k
  have hnorm (q : ℝ) (k : MassShell.Space d) :
      ‖planeSplitFun m u (q,k)‖ ^ 2 =
        (normalFourierScale ^ 2 * (2 * W k) * ‖u k‖ ^ 2) * ((W k)^2 + q^2)⁻¹ := by
    unfold planeSplitFun
    rw [norm_mul, norm_mul, mul_pow, mul_pow, Complex.norm_real, Complex.norm_real,
      Real.norm_eq_abs, Real.norm_eq_abs, sq_abs, sq_abs, Real.sq_sqrt (by
        have := hW k
        change 0 ≤ 2 * W k / (W k ^ 2 + q ^ 2)
        positivity)]
    change normalFourierScale^2 * (2 * W k / (W k ^ 2 + q ^ 2)) * ‖u k‖ ^ 2 = _
    ring
  have hInt (k : MassShell.Space d) :
      Integrable (fun q : ℝ ↦ ‖planeSplitFun m u (q,k)‖ ^ 2) := by
    simp_rw [hnorm]
    exact (normalResolvent_integrable (hW k)).const_mul _
  have hmass (k : MassShell.Space d) : ∫ q, ‖planeSplitFun m u (q,k)‖ ^ 2 = ‖u k‖ ^ 2 := by
    simp_rw [hnorm]
    rw [integral_const_mul, normalResolvent_mass (hW k), normalFourierScale_sq]
    field_simp [(hW k).ne', Real.pi_ne_zero]
  have hint := ((memLp_two_iff_integrable_sq_norm (Lp.aestronglyMeasurable u)).1 (Lp.memLp u))
  have hI : Integrable (fun z ↦ ‖planeSplitFun m u z‖ ^ 2) (volume.prod volume) := by
    apply (integrable_prod_iff' (hM.norm.pow 2)).2
    refine ⟨ae_of_all _ hInt, ?_⟩
    change Integrable (fun k ↦ ∫ q, ‖‖planeSplitFun m u (q,k)‖ ^ 2‖)
    simpa only [Real.norm_of_nonneg (sq_nonneg _), hmass] using hint
  refine ⟨(memLp_two_iff_integrable_sq_norm hM).2 hI, ?_⟩
  rw [integral_prod_symm _ hI, norm_sq_L2_integral]
  simp_rw [hmass]

private noncomputable def planeEmbedFun {d : ℕ} {m : ℝ} (hm : 0 < m)
    (u : Lp ℂ 2 (volume : Measure (MassShell.Space d))) :
    Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))) :=
  ((planeSplitFun_L2 hm u).1.comp_measurePreserving (MassShell.split_volume d)).toLp _

private theorem planeEmbedFun_ae {d : ℕ} {m : ℝ} (hm : 0 < m)
    (u : Lp ℂ 2 (volume : Measure (MassShell.Space d))) :
    ⇑(planeEmbedFun hm u) =ᵐ[volume] (planeSplitFun m u ∘ MassShell.split d) :=
  ((planeSplitFun_L2 hm u).1.comp_measurePreserving (MassShell.split_volume d)).coeFn_toLp

theorem planeTail_ae {d : ℕ} {s : Set (MassShell.Space d)} (hs : ∀ᵐ k ∂volume, k ∈ s) :
    ∀ᵐ p : MassShell.Space (d+1) ∂volume, MassShell.tail p ∈ s := by
  have h := (Measure.quasiMeasurePreserving_snd (μ := (volume : Measure ℝ))
    (ν := (volume : Measure (MassShell.Space d)))).ae hs
  exact (MassShell.split_volume d).quasiMeasurePreserving.ae h

/-- The normalized plane embedding into the full Euclidean one-particle covariance space. -/
noncomputable def planeMomentumIsometry (d : ℕ) (m : ℝ) (hm : 0 < m) :
    Lp ℂ 2 (volume : Measure (MassShell.Space d)) →ₗᵢ[ℂ]
      Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))) where
  toFun := planeEmbedFun hm
  map_add' u v := by
    apply Lp.ext
    filter_upwards [planeEmbedFun_ae hm (u+v), planeEmbedFun_ae hm u, planeEmbedFun_ae hm v,
      Lp.coeFn_add (planeEmbedFun hm u) (planeEmbedFun hm v),
      planeTail_ae (s := {k | (u+v) k = u k + v k}) (Lp.coeFn_add u v)] with p huv hu hv hb ha
    rw [huv, hb]
    simp only [Pi.add_apply, hu, hv, Function.comp_apply, planeSplitFun, MassShell.split_apply]
    change (u+v) (MassShell.tail p) = _ at ha
    rw [ha, mul_add]
  map_smul' c u := by
    apply Lp.ext
    filter_upwards [planeEmbedFun_ae hm (c • u), planeEmbedFun_ae hm u,
      Lp.coeFn_smul c (planeEmbedFun hm u),
      planeTail_ae (s := {k | (c • u) k = c • u k}) (Lp.coeFn_smul c u)] with p hcu hu hb ha
    rw [RingHom.id_apply, hcu, hb]
    simp only [Pi.smul_apply, hu, Function.comp_apply, planeSplitFun, MassShell.split_apply,
      smul_eq_mul]
    change (c • u) (MassShell.tail p) = c * u (MassShell.tail p) at ha
    rw [ha]
    ring
  norm_map' u := by
    apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    rw [norm_sq_L2_integral]
    calc ∫ p, ‖planeEmbedFun hm u p‖^2 =
          ∫ p, ‖planeSplitFun m u (MassShell.split d p)‖^2 := by
          exact integral_congr_ae ((planeEmbedFun_ae hm u).fun_comp fun a ↦ ‖a‖ ^ 2)
      _ = ∫ z, ‖planeSplitFun m u z‖^2 ∂(volume.prod volume) :=
          (MassShell.split_volume d).integral_comp' (fun z ↦ ‖planeSplitFun m u z‖^2)
      _ = ‖u‖^2 := (planeSplitFun_L2 hm u).2

theorem planeMomentumIsometry_apply_ae {d : ℕ} {m : ℝ} (hm : 0 < m)
    (u : Lp ℂ 2 (volume : Measure (MassShell.Space d))) :
    ⇑(planeMomentumIsometry d m hm u) =ᵐ[volume] fun p ↦
      (normalFourierScale : ℂ) *
      (Real.sqrt (2 * modeDispersion m (MassShell.tail p) / continuumDispersion m p) : ℂ) *
      u (MassShell.tail p) := by
  filter_upwards [planeEmbedFun_ae hm u] with p hp
  refine hp.trans ?_
  unfold planeSplitFun
  simp only [Function.comp_apply, MassShell.split_apply]
  rw [continuumDispersion, MassShell.norm_sq_split, modeDispersion,
    Real.sq_sqrt (by positivity)]
  ring_nf


/-- The plane label of a spatial test is the isometric image of its physical weighted Fourier
transform, with the covariance and the transverse measure normalized on the same test. -/
theorem massivePlaneLabel_eq_planeMomentumIsometry {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) (u : Lp ℂ 2 (volume : Measure (MassShell.Space d)))
    (hu : ⇑u =ᵐ[volume] fun k ↦ (Real.sqrt (ħ / (2 * modeDispersion m k)) : ℂ) *
      physicsFourier g k) :
    massivePlaneLabel hħ hm g = planeMomentumIsometry d m hm u := by
  apply Lp.ext
  filter_upwards [massivePlaneLabel_apply_ae hħ hm g, planeMomentumIsometry_apply_ae hm u,
    planeTail_ae (s := {k | u k = (Real.sqrt (ħ / (2 * modeDispersion m k)) : ℂ) *
      physicsFourier g k}) hu] with p hp hi hu'
  change u (MassShell.tail p) = _ at hu'
  rw [hp, hi, hu']
  let ω := modeDispersion m (MassShell.tail p)
  let a := continuumDispersion m p
  have hω : 0 < ω := modeDispersion_pos hm _
  have ha : 0 < a := by unfold a continuumDispersion; positivity
  have hs : Real.sqrt (2*ω/a) * Real.sqrt (ħ/(2*ω)) = Real.sqrt (ħ/a) := by
    rw [← Real.sqrt_mul (by positivity : 0 ≤ 2*ω/a)]
    congr 1
    field_simp [hω.ne']
  change (Real.sqrt (ħ/a) : ℂ) * (normalFourierScale : ℂ) * _ = _
  rw [← hs, Complex.ofReal_mul]
  ring

end DotProduct.Extension


/-! ### Smearing the normal resolvent -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped FourierTransform

noncomputable def normalPhase (q t : ℝ) : ℂ := Complex.exp (((q * t : ℝ) : ℂ) * Complex.I)

theorem normalPhase_norm (q t : ℝ) : ‖normalPhase q t‖ = 1 := Complex.norm_exp_ofReal_mul_I _

theorem normalPhase_add (q s t : ℝ) :
    normalPhase q (s + t) = normalPhase q s * normalPhase q t := by
  unfold normalPhase
  rw [← Complex.exp_add]
  push_cast
  congr 1
  ring

/-- Fubini and normal Fourier inversion against an arbitrary integrable amplitude. -/
theorem normalResolvent_smear {X : Type*} [MeasurableSpace X] {μ : Measure X} [SFinite μ]
    {a : X → ℂ} (ha : Integrable a μ) {T : X → ℝ} (hT : Measurable T)
    {ω : ℝ} (hω : 0 < ω) :
    (∫ q : ℝ, (∫ x, a x * normalPhase q (T x) ∂μ) * (((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹)) =
      ∫ x, a x * (((2 * π : ℝ) : ℂ) * (expKernel ω (T x) : ℂ)) ∂μ := by
  let R (q : ℝ) : ℂ := ((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹
  have hR : Integrable R := by
    simpa [R] using ((normalResolvent_integrable hω).ofReal (𝕜 := ℂ))
  let F (z : X × ℝ) := a z.1 * normalPhase z.2 (T z.1) * R z.2
  have hP : Measurable (fun z : X × ℝ ↦ normalPhase z.2 (T z.1)) := by
    unfold normalPhase
    fun_prop
  have hi : Integrable F (μ.prod volume) := by
    refine (ha.norm.mul_prod hR.norm).mono'
      ((ha.aestronglyMeasurable.comp_fst.mul hP.aestronglyMeasurable).mul hR.aestronglyMeasurable.comp_snd) ?_
    exact ae_of_all _ fun z ↦ by simp [F, normalPhase_norm]
  calc
    _ = ∫ q : ℝ, ∫ x, F (x, q) ∂μ := by simp only [F, integral_mul_const, R]
    _ = ∫ x, (∫ q : ℝ, F (x, q)) ∂μ := (integral_integral_swap hi).symm
    _ = _ := by
      apply integral_congr_ae
      refine ae_of_all _ fun x ↦ ?_
      dsimp only [F]
      simp_rw [mul_assoc]
      rw [integral_const_mul]
      congr 1
      convert inverseNormalKernel hω (T x) using 1
      apply integral_congr_ae
      refine ae_of_all _ fun q ↦ ?_
      dsimp [normalPhase, R]
      rw [Complex.ofReal_mul]
      congr 2
      ring

/-- The cross-side resolvent reduces to a product of two Laplace integrals for
    arbitrary integrable preparations supported in positive normal time. -/
theorem normalResolvent_cross {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {μ : Measure X} {ν : Measure Y} [SFinite μ] [SFinite ν]
    {a : X → ℂ} {b : Y → ℂ} (ha : Integrable a μ) (hb : Integrable b ν)
    {s : X → ℝ} {t : Y → ℝ} (hs : Measurable s) (ht : Measurable t)
    (has : ∀ x, a x ≠ 0 → 0 ≤ s x) (hbt : ∀ y, b y ≠ 0 → 0 ≤ t y)
    {ω : ℝ} (hω : 0 < ω) :
    (∫ q : ℝ, (∫ x, a x * normalPhase q (s x) ∂μ) *
      (∫ y, b y * normalPhase q (t y) ∂ν) * (((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹)) =
      (((2 * π) / (2 * ω) : ℝ) : ℂ) *
      (∫ x, a x * (Real.exp (-ω * s x) : ℂ) ∂μ) *
      (∫ y, b y * (Real.exp (-ω * t y) : ℂ) ∂ν) := by
  let A (z : X × Y) := a z.1 * b z.2
  let T (z : X × Y) := s z.1 + t z.2
  have hp (q : ℝ) : (∫ x, a x * normalPhase q (s x) ∂μ) *
      (∫ y, b y * normalPhase q (t y) ∂ν) = ∫ z, A z * normalPhase q (T z) ∂μ.prod ν := by
    rw [← integral_prod_mul]
    apply integral_congr_ae
    exact ae_of_all _ fun z ↦ by dsimp [A, T]; rw [normalPhase_add]; ring
  simp_rw [hp]
  rw [normalResolvent_smear (a := A) (T := T) (ha.mul_prod hb) ((hs.comp measurable_fst).add (ht.comp measurable_snd)) hω]
  rw [mul_assoc, ← integral_prod_mul, ← integral_const_mul]
  apply integral_congr_ae
  refine ae_of_all _ fun z ↦ ?_
  dsimp [A, T, expKernel]
  by_cases hx : a z.1 = 0
  · simp [hx]
  by_cases hy : b z.2 = 0
  · simp [hy]
  rw [abs_of_nonneg (add_nonneg (has _ hx) (hbt _ hy)), mul_add, Real.exp_add]
  push_cast
  ring

end DotProduct.Extension


/-! ### Physical Fourier–Laplace amplitudes -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped SchwartzMap

private noncomputable abbrev unitaryScale (d : ℕ) := (2 * π) ^ (-(d : ℝ) / 2)

noncomputable def spatialAmplitude {d : ℕ} (f : MassShell.Space (d+1) → ℝ)
    (k : MassShell.Space d) (x : MassShell.Space (d+1)) : ℂ :=
  (f x : ℂ) * normalPhase (-1) (inner ℝ (MassShell.tail x) k)

/-- The transverse, unitary Fourier transform integrated against the normal Laplace weight. -/
noncomputable def planeAmplitude {d : ℕ} (ω : ℝ) (f : MassShell.Space (d+1) → ℝ)
    (k : MassShell.Space d) : ℂ :=
  (unitaryScale d : ℂ) * ∫ x, spatialAmplitude f k x * (Real.exp (-ω * x 0) : ℂ)

theorem spatialAmplitude_integrable {d : ℕ} (f : 𝓢(MassShell.Space (d+1), ℝ))
    (k : MassShell.Space d) : Integrable (spatialAmplitude f k) := by
  have htail : Continuous (MassShell.tail (n := d)) :=
    (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ (MassShell.Space d)).continuous.snd.comp
      (MassShell.splitIsometry d).continuous
  refine f.integrable.norm.mono' (by unfold spatialAmplitude normalPhase; fun_prop) ?_
  exact ae_of_all _ fun x ↦ by simp [spatialAmplitude, normalPhase_norm]

private theorem conj_normalPhase (q s : ℝ) :
    star (normalPhase q s) = normalPhase (-q) s := by
  simp only [normalPhase, RCLike.star_def, ← Complex.exp_conj, map_mul,
    Complex.conj_ofReal, Complex.conj_I, neg_mul, Complex.ofReal_neg, mul_neg]

theorem physicsFourier_at_split {d : ℕ} (f : MassShell.Space (d+1) → ℝ)
    (q : ℝ) (k : MassShell.Space d) :
    physicsFourier f ((MassShell.split d).symm (q,k)) =
      (unitaryScale (d+1) : ℂ) * ∫ x, spatialAmplitude f k x * normalPhase (-q) (x 0) := by
  let p := (MassShell.split d).symm (q,k)
  have h := (MassShell.split d).apply_symm_apply (q,k)
  have hq : p 0 = q := congrArg Prod.fst h
  have hk : MassShell.tail p = k := congrArg Prod.snd h
  rw [physicsFourier_integral]
  congr 1
  apply integral_congr_ae
  refine ae_of_all _ fun x ↦ ?_
  dsimp only
  have hi : inner ℝ x p = x 0 * q + inner ℝ (MassShell.tail x) k := by
    rw [← hq, ← hk, ← (MassShell.splitIsometry d).inner_map_map x p, WithLp.prod_inner_apply]
    change inner ℝ (x 0) (p 0) + _ = _
    simp [mul_comm]
    rfl
  change (f x : ℂ) * Complex.exp (-Complex.I * (inner ℝ x p : ℂ)) = _
  unfold spatialAmplitude
  rw [mul_assoc]
  congr 1
  unfold normalPhase
  rw [← Complex.exp_add, hi]
  congr 1
  push_cast
  ring

private lemma scale_split_sq (d : ℕ) :
    unitaryScale (d+1) ^ 2 * (2 * π) = unitaryScale d ^ 2 := by
  have hp : 0 < 2 * π := by positivity
  simp only [unitaryScale, Nat.cast_add, Nat.cast_one, sq, ← Real.rpow_add hp]
  conv_lhs => arg 2; rw [← Real.rpow_one (2 * π)]
  rw [← Real.rpow_add hp]
  congr 1
  ring

/-- The normal-momentum pairing of any two reflected real positive-time
    Schwartz smears, at each transverse momentum, with unitary Fourier factors. -/
theorem physicsFourier_cross_fiber {d : ℕ} (f g : 𝓢(MassShell.Space (d+1), ℝ))
    (hf : ∀ x, f x ≠ 0 → 0 ≤ x 0) (hg : ∀ x, g x ≠ 0 → 0 ≤ x 0)
    (k : MassShell.Space d) {ω : ℝ} (hω : 0 < ω) :
    (∫ q : ℝ, star (physicsFourier f ((MassShell.split d).symm (-q,k))) *
      physicsFourier g ((MassShell.split d).symm (q,k)) * (((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹)) =
      star (planeAmplitude ω f k) * planeAmplitude ω g k / (2 * (ω : ℂ)) := by
  let A := spatialAmplitude f k
  let B := spatialAmplitude g k
  let s := fun x : MassShell.Space (d+1) ↦ x 0
  have hs : Measurable s := (MassShell.split d).measurable.fst
  have ha : Integrable (fun x ↦ star (A x)) := (spatialAmplitude_integrable f k).norm.mono' (spatialAmplitude_integrable f k).aestronglyMeasurable.star (ae_of_all _ fun x ↦ by simp [A])
  have h := normalResolvent_cross (a := fun x ↦ star (A x)) (b := B) ha
    (spatialAmplitude_integrable g k) hs hs
    (fun x hx ↦ hf x (fun hz ↦ hx (by simp [A, spatialAmplitude, hz])))
    (fun x hx ↦ hg x (fun hz ↦ hx (by simp [B, spatialAmplitude, hz]))) hω
  rw [← integral_neg_eq_self (fun q : ℝ ↦ star (physicsFourier f ((MassShell.split d).symm (-q,k))) *
      physicsFourier g ((MassShell.split d).symm (q,k)) * (((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹))]
  simp only [neg_neg, neg_sq, physicsFourier_at_split, map_mul, RCLike.star_def,
    Complex.conj_ofReal]
  have hc (q : ℝ) :
      (starRingEnd ℂ) (∫ x, A x * normalPhase (-q) (s x)) =
      ∫ x, star (A x) * normalPhase q (s x) := by
    rw [← integral_conj]
    apply integral_congr_ae
    refine ae_of_all _ fun x ↦ ?_
    change star (A x * normalPhase (-q) (s x)) = _
    rw [star_mul', conj_normalPhase, neg_neg]
  let N := (unitaryScale (d+1) : ℂ)
  have hl : (∫ q : ℝ, (N * (starRingEnd ℂ) (∫ x, A x * normalPhase (-q) (s x))) *
      (N * ∫ x, B x * normalPhase q (s x)) * (((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹)) =
      N ^ 2 * (∫ q : ℝ, (∫ x, star (A x) * normalPhase q (s x)) *
        (∫ x, B x * normalPhase q (s x)) * (((ω ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹)) := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    exact ae_of_all _ fun q ↦ by dsimp only; rw [hc]; ring
  rw [hl, h]
  unfold planeAmplitude
  rw [map_mul, Complex.conj_ofReal]
  have hc2 : (∫ x, star (A x) * (Real.exp (-ω * s x) : ℂ)) =
      (starRingEnd ℂ) (∫ x, A x * (Real.exp (-ω * s x) : ℂ)) := by
    rw [← integral_conj]
    apply integral_congr_ae
    exact ae_of_all _ fun x ↦ by simp only [RCLike.star_def, map_mul, Complex.conj_ofReal]
  rw [hc2]
  dsimp only [A, B, s, N]
  have hscale : (unitaryScale (d+1) : ℂ)^2 * (2 * (π : ℂ)) = (unitaryScale d : ℂ)^2 := by
    exact_mod_cast scale_split_sq d
  simp only [Complex.ofReal_div, Complex.ofReal_mul, Complex.ofReal_ofNat]
  linear_combination (starRingEnd ℂ (∫ x, spatialAmplitude f k x * (Real.exp (-ω * x 0) : ℂ)) *
    (∫ x, spatialAmplitude g k x * (Real.exp (-ω * x 0) : ℂ)) / (2 * (ω : ℂ))) * hscale

/-- Averaging one positive smear in normal momentum yields its plane amplitude. -/
theorem physicsFourier_plane_fiber {d : ℕ} (f : 𝓢(MassShell.Space (d+1), ℝ))
    (hf : ∀ x, f x ≠ 0 → 0 ≤ x 0) (k : MassShell.Space d) {ω : ℝ} (hω : 0 < ω) :
    (normalFourierScale : ℂ) *
      (∫ q : ℝ, physicsFourier f ((MassShell.split d).symm (q,k)) * (((ω^2 + q^2 : ℝ) : ℂ)⁻¹)) =
      planeAmplitude ω f k / (2 * (ω : ℂ)) := by
  rw [show normalFourierScale = unitaryScale 1 from by simp [normalFourierScale, unitaryScale]]
  let s := fun x : MassShell.Space (d+1) ↦ x 0
  have hs : Measurable s := (MassShell.split d).measurable.fst
  rw [← integral_neg_eq_self (fun q : ℝ ↦ physicsFourier f ((MassShell.split d).symm (q,k)) *
    (((ω^2 + q^2 : ℝ) : ℂ)⁻¹))]
  simp only [physicsFourier_at_split, neg_neg, neg_sq, mul_assoc, integral_const_mul]
  rw [normalResolvent_smear (T := s) (spatialAmplitude_integrable f k) hs hω]
  have hpt (x : MassShell.Space (d+1)) :
      spatialAmplitude f k x * (((2 * π : ℝ) : ℂ) * (expKernel ω (s x) : ℂ)) =
      (((2 * π) / (2 * ω) : ℝ) : ℂ) * (spatialAmplitude f k x * (Real.exp (-ω * s x) : ℂ)) := by
    by_cases hx : f x = 0
    · simp [spatialAmplitude, hx]
    · unfold expKernel
      rw [abs_of_nonneg (hf x hx)]
      push_cast
      ring
  simp_rw [hpt]
  rw [integral_const_mul]
  have hscale : unitaryScale 1 * unitaryScale (d+1) * (2 * π) = unitaryScale d := by
    have hp : 0 < 2 * π := by positivity
    simp only [unitaryScale, Nat.cast_add, Nat.cast_one, ← Real.rpow_add hp]
    conv_lhs => arg 2; rw [← Real.rpow_one (2 * π)]
    rw [← Real.rpow_add hp]
    congr 1
    ring
  have hsc : (unitaryScale 1 : ℂ) * unitaryScale (d+1) * (2 * (π : ℂ)) = unitaryScale d := by
    exact_mod_cast hscale
  unfold planeAmplitude
  simp only [Complex.ofReal_div, Complex.ofReal_mul, Complex.ofReal_ofNat]
  dsimp only [s]
  linear_combination ((∫ x, spatialAmplitude f k x * (Real.exp (-ω * x 0) : ℂ)) /
    (2 * (ω : ℂ))) * hsc

theorem planeAmplitude_conj_neg {d : ℕ} (f : MassShell.Space (d+1) → ℝ)
    (ω : ℝ) (k : MassShell.Space d) :
    planeAmplitude ω f (-k) = star (planeAmplitude ω f k) := by
  unfold planeAmplitude
  rw [star_mul', RCLike.star_def, Complex.conj_ofReal]
  congr 1
  change _ = (starRingEnd ℂ) _
  rw [← integral_conj]
  apply integral_congr_ae
  refine ae_of_all _ fun x ↦ ?_
  change _ = star (_ * ((Real.exp (-ω * x 0) : ℝ) : ℂ))
  simp only [star_mul', RCLike.star_def, Complex.conj_ofReal]
  unfold spatialAmplitude
  rw [map_mul, Complex.conj_ofReal]
  congr 2
  rw [← RCLike.star_def, conj_normalPhase, inner_neg_right]
  simp [normalPhase]

theorem planeAmplitude_measurable {d : ℕ} (f : 𝓢(MassShell.Space (d+1), ℝ))
    {ω : MassShell.Space d → ℝ} (hω : Measurable ω) :
    Measurable fun k ↦ planeAmplitude (ω k) f k := by
  apply Measurable.const_mul
  apply StronglyMeasurable.measurable
  apply StronglyMeasurable.integral_prod_right' (f := fun z : MassShell.Space d × MassShell.Space (d+1) ↦ spatialAmplitude f z.1 z.2 * (Real.exp (-ω z.1 * z.2 0) : ℂ))
  apply Measurable.stronglyMeasurable
  have htail : Measurable (MassShell.tail (n := d)) := (MassShell.split d).measurable.snd
  have hzero : Measurable fun x : MassShell.Space (d+1) ↦ x 0 := (MassShell.split d).measurable.fst
  unfold spatialAmplitude normalPhase
  fun_prop

end DotProduct.Extension


/-! ### Reflected covariance of the original massive field -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped SchwartzMap InnerProductSpace

noncomputable def boundaryWeight {d : ℕ} (ħ m : ℝ) (k : MassShell.Space d) : ℝ :=
  Real.sqrt (ħ / (2 * modeDispersion m k))

noncomputable def boundaryFeature {d : ℕ} (ħ m : ℝ) (f : MassShell.Space (d+1) → ℝ)
    (k : MassShell.Space d) : ℂ :=
  (boundaryWeight ħ m k : ℂ) * planeAmplitude (modeDispersion m k) f k

theorem boundaryWeight_sq {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (k : MassShell.Space d) :
    (boundaryWeight ħ m k : ℂ)^2 = (ħ : ℂ) / (2 * (modeDispersion m k : ℂ)) := by
  rw [← Complex.ofReal_pow]
  unfold boundaryWeight
  rw [Real.sq_sqrt (div_nonneg hħ (by positivity [modeDispersion_pos hm k]))]
  push_cast
  rfl

theorem boundaryFeature_measurable {d : ℕ} (ħ m : ℝ) (f : 𝓢(MassShell.Space (d+1), ℝ)) :
    Measurable (boundaryFeature ħ m f) := by
  exact (Complex.measurable_ofReal.comp
    ((measurable_const.div (measurable_const.mul (modeDispersion_measurable m))).sqrt)).mul
      (planeAmplitude_measurable f (modeDispersion_measurable m))

theorem boundaryFeature_conj_neg {d : ℕ} (ħ m : ℝ) (f : MassShell.Space (d+1) → ℝ)
    (k : MassShell.Space d) : boundaryFeature ħ m f (-k) = star (boundaryFeature ħ m f k) := by
  have h : modeDispersion m (-k) = modeDispersion m k := by simp [modeDispersion]
  simp only [boundaryFeature, boundaryWeight, h, planeAmplitude_conj_neg, star_mul', RCLike.star_def,
    Complex.conj_ofReal]

/-- Fubini in the normal coordinate for a mixed product of two ambient L² vectors. -/
theorem bulkInner_split {d : ℕ} (u v : Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))))
    (F : ℝ × MassShell.Space d → ℂ)
    (hF : (fun p ↦ inner ℂ (u p) (v p)) =ᵐ[volume] fun p ↦ F (MassShell.split d p)) :
    Integrable (fun k ↦ ∫ q : ℝ, F (q,k)) ∧
    inner ℂ u v = ∫ k, ∫ q : ℝ, F (q,k) := by
  have hi : Integrable F (volume.prod volume) :=
    ((MassShell.split_volume d).integrable_comp_emb (MassShell.split d).measurableEmbedding).mp
      ((L2.integrable_inner (𝕜 := ℂ) u v).congr hF)
  refine ⟨hi.integral_prod_right, ?_⟩
  rw [L2.inner_def, integral_congr_ae hF, (MassShell.split_volume d).integral_comp' F]
  exact integral_prod_symm F hi

private theorem dispersion_split {d : ℕ} (m : ℝ) (p : MassShell.Space (d+1)) :
    continuumDispersion m p = modeDispersion m (MassShell.tail p)^2 + (p 0)^2 := by
  unfold continuumDispersion modeDispersion
  rw [MassShell.norm_sq_split, Real.sq_sqrt (by positivity)]
  ring

/-- Integrated cross covariance and absolute integrability of the transverse Gram.
    Both sides use the original massive law and its original positive Schwartz smears. -/
theorem physical_reflected_gram {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : positiveSchwartz d) :
    let B := fun h : positiveSchwartz d ↦ boundaryFeature ħ m h.1
    Integrable (fun k ↦ star (B f k) * B g k) ∧
    inner ℂ (massiveEuclideanLabel (d+1) ħ m hħ hm (reflectSchwartz d f.1))
      (massiveEuclideanLabel (d+1) ħ m hħ hm g.1) = ∫ k, star (B f k) * B g k := by
  intro B
  let A := massiveEuclideanLabel (d+1) ħ m hħ hm
  let ω := modeDispersion (d := d) m
  let F (z : ℝ × MassShell.Space d) := (ħ : ℂ) *
    (star (physicsFourier f.1 ((MassShell.split d).symm (-z.1,z.2))) *
      physicsFourier g.1 ((MassShell.split d).symm z) * (((ω z.2 ^ 2 + z.1 ^ 2 : ℝ) : ℂ)⁻¹))
  have hrepr : (fun p ↦ inner ℂ (A (reflectSchwartz d f.1) p) (A g.1 p)) =ᵐ[volume]
      fun p ↦ F (MassShell.split d p) := by
    filter_upwards [massiveEuclideanLabel_apply_ae hħ hm (reflectSchwartz d f.1),
      massiveEuclideanLabel_apply_ae hħ hm g.1] with p hp hq
    change inner ℂ (massiveEuclideanLabel (d+1) ħ m hħ hm (reflectSchwartz d f.1) p) (massiveEuclideanLabel (d+1) ħ m hħ hm g.1 p) = _
    rw [hp, hq, RCLike.inner_apply, map_mul, Complex.conj_ofReal, physicsFourier_reflectSchwartz]
    have hs : (Real.sqrt (ħ / continuumDispersion m p) : ℂ)^2 =
        (ħ : ℂ) * (((continuumDispersion m p : ℝ) : ℂ)⁻¹) := by
      rw [← Complex.ofReal_pow, Real.sq_sqrt (div_nonneg hħ (by unfold continuumDispersion; positivity)),
        Complex.ofReal_div, div_eq_mul_inv]
    simp only [F, MassShell.split_apply, ω]
    rw [show (MassShell.split d).symm (p 0, MassShell.tail p) = p from (MassShell.split d).symm_apply_apply p]
    rw [← dispersion_split]
    simp only [RCLike.star_def]
    linear_combination (starRingEnd ℂ (physicsFourier f.1 ((MassShell.split d).symm (-p 0, MassShell.tail p))) *
      physicsFourier g.1 p) * hs
  have hF (k : MassShell.Space d) : (∫ q : ℝ, F (q,k)) = star (B f k) * B g k := by
    dsimp only [F]
    rw [integral_const_mul, physicsFourier_cross_fiber f.1 g.1
      (fun x hx ↦ (mem_positiveSchwartz_iff.mp f.2 x hx).le)
      (fun x hx ↦ (mem_positiveSchwartz_iff.mp g.2 x hx).le) k (modeDispersion_pos hm k)]
    dsimp only [B, boundaryFeature, ω]
    rw [star_mul', RCLike.star_def, Complex.conj_ofReal]
    linear_combination -(starRingEnd ℂ (planeAmplitude (modeDispersion m k) f.1 k) *
      planeAmplitude (modeDispersion m k) g.1 k) * boundaryWeight_sq hħ hm k
  simpa only [hF] using bulkInner_split (A (reflectSchwartz d f.1)) (A g.1) F hrepr

theorem boundaryFeature_memLp {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : positiveSchwartz d) : MemLp (boundaryFeature ħ m f.1) 2 volume := by
  apply (memLp_two_iff_integrable_sq_norm (boundaryFeature_measurable ħ m f.1).aestronglyMeasurable).2
  have h := (physical_reflected_gram hħ hm f f).1.norm
  simpa only [norm_mul, norm_star, sq] using h

noncomputable def boundaryLabel {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : positiveSchwartz d) : Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  (boundaryFeature_memLp hħ hm f).toLp _

theorem boundaryLabel_ae {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : positiveSchwartz d) : ⇑(boundaryLabel hħ hm f) =ᵐ[volume] boundaryFeature ħ m f.1 :=
  (boundaryFeature_memLp hħ hm f).coeFn_toLp

theorem physical_reflected_inner {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : positiveSchwartz d) :
    inner ℂ (massiveEuclideanLabel (d+1) ħ m hħ hm (reflectSchwartz d f.1))
      (massiveEuclideanLabel (d+1) ħ m hħ hm g.1) =
    inner ℂ (boundaryLabel hħ hm f) (boundaryLabel hħ hm g) := by
  rw [(physical_reflected_gram hħ hm f g).2, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [boundaryLabel_ae hħ hm f, boundaryLabel_ae hħ hm g] with k hf hg
  change _ = inner ℂ (boundaryLabel hħ hm f k) (boundaryLabel hħ hm g k)
  rw [RCLike.inner_apply, hf, hg, mul_comm]
  rfl

end DotProduct.Extension


/-! ### Pairing with a plane vector -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped SchwartzMap InnerProductSpace

private lemma root_product {a ω ħ : ℝ} (ha : 0 < a) (hω : 0 < ω) (hħ : 0 ≤ ħ) :
    Real.sqrt (2 * ω / a) * Real.sqrt (ħ / a) =
      (2 * ω) * Real.sqrt (ħ / (2 * ω)) * a⁻¹ := by
  apply (sq_eq_sq₀ (by positivity) (by positivity)).mp
  rw [mul_pow, Real.sq_sqrt (by positivity), Real.sq_sqrt (by positivity), mul_pow, mul_pow,
    Real.sq_sqrt (by positivity)]
  field_simp

/-- The adjoint of the plane embedding sends every original positive-time smear
    to its normalized transverse Fourier–Laplace feature. -/
theorem planeMomentumIsometry_inner_bulk {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (u : Lp ℂ 2 (volume : Measure (MassShell.Space d))) (f : positiveSchwartz d) :
    inner ℂ (planeMomentumIsometry d m hm u) (massiveEuclideanLabel (d+1) ħ m hħ hm f.1) =
      inner ℂ u (boundaryLabel hħ hm f) := by
  let ω := modeDispersion (d := d) m
  let c := (normalFourierScale : ℂ)
  let b (k : MassShell.Space d) := (boundaryWeight ħ m k : ℂ)
  let I := planeMomentumIsometry d m hm
  let A := massiveEuclideanLabel (d+1) ħ m hħ hm
  let F (z : ℝ × MassShell.Space d) :=
    (star (u z.2) * (2 * (ω z.2 : ℂ)) * b z.2) * (c *
      (physicsFourier f.1 ((MassShell.split d).symm z) * (((ω z.2 ^ 2 + z.1 ^ 2 : ℝ) : ℂ)⁻¹)))
  have hrepr : (fun p ↦ inner ℂ (I u p) (A f.1 p)) =ᵐ[volume]
      fun p ↦ F (MassShell.split d p) := by
    filter_upwards [planeMomentumIsometry_apply_ae hm u, massiveEuclideanLabel_apply_ae hħ hm f.1]
      with p hp hf
    change inner ℂ (planeMomentumIsometry d m hm u p) (massiveEuclideanLabel (d+1) ħ m hħ hm f.1 p) = _
    rw [hp, hf, RCLike.inner_apply, map_mul, map_mul, Complex.conj_ofReal, Complex.conj_ofReal]
    let a := continuumDispersion m p
    let w := ω (MassShell.tail p)
    have ha : 0 < a := by unfold a continuumDispersion; positivity
    have hw : 0 < w := modeDispersion_pos hm _
    have hprod : (Real.sqrt (2*w/a) : ℂ) * (Real.sqrt (ħ/a) : ℂ) =
        (2 * (w : ℂ)) * (Real.sqrt (ħ/(2*w)) : ℂ) * (a : ℂ)⁻¹ := by
      exact_mod_cast root_product ha hw hħ
    simp only [F, MassShell.split_apply, b, c, ω, boundaryWeight, RCLike.star_def]
    rw [show (MassShell.split d).symm (p 0, MassShell.tail p) = p from (MassShell.split d).symm_apply_apply p,
      show modeDispersion m (MassShell.tail p)^2 + (p 0)^2 = continuumDispersion m p by
        unfold modeDispersion continuumDispersion
        rw [MassShell.norm_sq_split, Real.sq_sqrt (by positivity)]
        ring]
    dsimp only [w, a, ω] at hprod
    linear_combination (physicsFourier f.1 p * normalFourierScale * starRingEnd ℂ (u (MassShell.tail p))) * hprod
  rw [(bulkInner_split (I u) (A f.1) F hrepr).2, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [boundaryLabel_ae hħ hm f] with k hk
  dsimp only [F]
  rw [integral_const_mul, integral_const_mul]
  have hplane : c * (∫ q : ℝ, physicsFourier f.1 ((MassShell.split d).symm (q,k)) *
      (((ω k ^ 2 + q ^ 2 : ℝ) : ℂ)⁻¹)) =
      planeAmplitude (ω k) f.1 k / (2 * (ω k : ℂ)) :=
    physicsFourier_plane_fiber f.1 (fun x hx ↦ (mem_positiveSchwartz_iff.mp f.2 x hx).le)
      k (modeDispersion_pos hm k)
  rw [hplane, RCLike.inner_apply, hk]
  dsimp only [boundaryFeature, b, ω]
  rw [RCLike.star_def]
  field_simp [Complex.ofReal_ne_zero.mpr (modeDispersion_pos hm k).ne']

end DotProduct.Extension


/-! ### The quotient of nonlinear preparations and independent composition -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped InnerProductSpace TensorProduct

section MeasuredPlane

variable {Ω R V : Type*} [MeasurableSpace Ω] [NormedAddCommGroup R] [InnerProductSpace ℝ R]
  [AddCommGroup V] [Module ℝ V] (P : Measure Ω) [IsFiniteMeasure P]
  (Φ : Ω → R →ₗ[ℝ] ℝ) (hm : ∀ a, Measurable (fun w ↦ Φ w a))
  (hc : ∀ a : R, (∫ w, Complex.exp ((Φ w a : ℂ) * Complex.I) ∂P) =
    (Real.exp (-(‖a‖ ^ 2) / 2) : ℂ))
  (J : V →ₗ[ℝ] R) (S : Submodule ℝ R)

local notation "law(" J ")" => P.map (readingCoordinates Φ J)

/-- Embedding of the complex L² of coordinate observations in the ambient probability space. -/
noncomputable def readingPullback : Lp ℂ 2 (law(J)) →ₗᵢ[ℂ] Lp ℂ 2 P :=
  Lp.compMeasurePreservingₗᵢ ℂ (readingCoordinates Φ J)
    ⟨measurable_readingCoordinates Φ hm J, rfl⟩

/-- Conditional expectation of an arbitrary preparation, evaluated in plane-law L². -/
noncomputable def preparedCondition :
    Lp ℂ 2 (law(J)) →L[ℂ] Lp ℂ 2 (law(S.subtype)) :=
  let h := measurable_readingCoordinates Φ hm S.subtype
  (observationL2 P _ h).symm.toLinearIsometry.toContinuousLinearMap.comp
    ((condExpL2 ℂ ℂ h.comap_le).comp (readingPullback P Φ hm J).toContinuousLinearMap)

include hc in
theorem readingPullback_lifts {U : Type*} [AddCommGroup U] [Module ℝ U] (L : U →ₗ[ℝ] R)
    (happrox : Set.range L ⊆ closure (Set.range J)) (u : Lp ℂ 2 (law(L))) :
    ∃ X : Lp ℂ 2 (law(J)), readingPullback P Φ hm J X = readingPullback P Φ hm L u := by
  let B := readingPullback P Φ hm J
  let A := readingPullback P Φ hm L
  let K := LinearMap.range B.toLinearMap
  have hK : IsClosed (K : Set (Lp ℂ 2 P)) := B.isometry.isClosedEmbedding.isClosed_range
  let W := wickReading P Φ hm
  have hcont : Continuous W := continuous_phase W (wickReading_inner P Φ hm hc)
  have hW (a : U) : W (L a) ∈ K := by
    have hpre : Set.range J ⊆ W ⁻¹' (K : Set (Lp ℂ 2 P)) := by
      rintro _ ⟨f, rfl⟩
      exact ⟨wickCoordinate (law(J)) J f, observationL2_wick P Φ hm J f⟩
    exact (closure_minimal hpre (hK.preimage hcont)) (happrox (Set.mem_range_self a))
  have hspan : Submodule.span ℂ (Set.range (wickCoordinate (law(L)) L)) ≤
      K.comap A.toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    change A _ ∈ K
    rw [show A (wickCoordinate (law(L)) L a) = W (L a) from
      observationL2_wick P Φ hm L a]
    exact hW a
  exact (wickCoordinate_dense P Φ hm L).induction (fun z hz ↦ hspan hz)
    (hK.preimage A.continuous) u

include hc in
/-- Mean-square approximation of the plane labels from the open positive side makes the
whole plane L² observable on that side. Each plane observable has a lift of the same norm. -/
theorem plane_pullback_lifts
    (happrox : (S : Set R) ⊆ closure (Set.range J)) (u : Lp ℂ 2 (law(S.subtype))) :
    ∃ X : Lp ℂ 2 (law(J)), readingPullback P Φ hm J X = readingPullback P Φ hm S.subtype u := by
  apply readingPullback_lifts P Φ hm hc J S.subtype _ u
  rintro _ ⟨a, rfl⟩
  exact happrox a.property

include hc in
/-- Spatial smear coordinates and the mean-square closure of their linear span generate
the same completed observation space, with identical representatives on the field. -/
theorem observed_plane_tests_equiv {U : Type*} [AddCommGroup U] [Module ℝ U] (L : U →ₗ[ℝ] R)
    (hS : S = L.range.topologicalClosure) :
    ∃ D : Lp ℂ 2 (law(S.subtype)) ≃ₗᵢ[ℂ] Lp ℂ 2 (law(L)),
      ∀ z, readingPullback P Φ hm L (D z) = readingPullback P Φ hm S.subtype z := by
  let A := readingPullback P Φ hm S.subtype
  let B := readingPullback P Φ hm L
  have hs : Set.range S.subtype = (S : Set R) := by ext; simp
  have hAB : LinearMap.range A.toLinearMap = LinearMap.range B.toLinearMap := by
    apply le_antisymm
    · rintro _ ⟨x,rfl⟩
      apply readingPullback_lifts P Φ hm hc L S.subtype _ x
      rw [hs, hS, Submodule.topologicalClosure_coe, LinearMap.coe_range]
    · rintro _ ⟨x,rfl⟩
      apply readingPullback_lifts P Φ hm hc S.subtype L _ x
      rw [hs,hS,Submodule.topologicalClosure_coe, isClosed_closure.closure_eq,LinearMap.coe_range]
      exact subset_closure
  let E := LinearIsometryEquiv.ofEq _ _ hAB
  refine ⟨(A.equivRange.trans E).trans B.equivRange.symm, fun z ↦ ?_⟩
  have h := B.equivRange.apply_symm_apply (E (A.equivRange z))
  exact congrArg Subtype.val h

private theorem observation_inner_conditionOn {Ω X : Type*} [MeasurableSpace Ω] (P : Measure Ω) [MeasurableSpace X] (obs : Ω → X) (ho : Measurable obs) (Z : Lp ℂ 2 P)
      (z : Lp ℂ 2 (P.map obs)) :
      inner ℂ (conditionOn P obs ho Z) z =
        inner ℂ Z ((observationL2 P obs ho z).1 : Lp ℂ 2 P) := by
  rw [← (observationL2 P obs ho).inner_map_map, conditionOn, LinearIsometryEquiv.apply_symm_apply]
  exact inner_condExpL2_eq_inner_fun ho.comap_le Z _ (lpMeas.aestronglyMeasurable _)

include hc in
/-- Conditional expectation computed in the original test-coordinate plane law agrees
with the Gaussian Hilbert-space plane equivalent, for every ambient L² variable. -/
theorem observed_plane_tests_conditionOn {U : Type*} [AddCommGroup U] [Module ℝ U] (L : U →ₗ[ℝ] R)
    (hS : S = L.range.topologicalClosure) :
    ∃ D : Lp ℂ 2 (law(S.subtype)) ≃ₗᵢ[ℂ] Lp ℂ 2 (law(L)), ∀ Z : Lp ℂ 2 P,
      D (conditionOn P _ (measurable_readingCoordinates Φ hm S.subtype) Z) =
        conditionOn P _ (measurable_readingCoordinates Φ hm L) Z := by
  obtain ⟨D, hD⟩ := observed_plane_tests_equiv P Φ hm hc S L hS
  let hS' := measurable_readingCoordinates Φ hm S.subtype
  let hL := measurable_readingCoordinates Φ hm L
  refine ⟨D, fun Z ↦ ext_inner_right ℂ (fun z ↦ ?_)⟩
  obtain ⟨y, rfl⟩ := D.surjective z
  rw [D.inner_map_map, observation_inner_conditionOn P _ hS', observation_inner_conditionOn P _ hL]
  exact congrArg (inner ℂ Z) (hD y).symm

include hc in
theorem preparedCondition_onto
    (happrox : (S : Set R) ⊆ closure (Set.range J)) :
    Function.Surjective (preparedCondition P Φ hm J S) := by
  intro u
  obtain ⟨X, hX⟩ := plane_pullback_lifts P Φ hm hc J S happrox u
  refine ⟨X, ?_⟩
  change conditionOn P _ _ (readingPullback P Φ hm J X) = u
  rw [hX]
  exact conditionOn_pullback P _ _ u

include hc hm in
theorem gaussian_readingLaw_eq_of_norm (A : V →ₗ[ℝ] R) (h : ∀ f, ‖A f‖ = ‖J f‖) :
    law(A) = law(J) := by
  apply DotChar.cylindrical_char_ext
  intro I L
  let t : DotChar.CylinderLabel V := ⟨I, L⟩
  let phase := (DotChar.cylinderPhases V).phase t
  change (∫ x, phase x ∂law(A)) = ∫ x, phase x ∂law(J)
  rw [integral_map (measurable_readingCoordinates Φ hm A).aemeasurable
    ((DotChar.cylinderPhases V).measurable_phase t).aestronglyMeasurable,
    integral_map (measurable_readingCoordinates Φ hm J).aemeasurable
    ((DotChar.cylinderPhases V).measurable_phase t).aestronglyMeasurable]
  simp only [cylinderPhase_on_readings, hc, h]

/-- Read the same prepared observable on the opposite half of the field. -/
noncomputable def reflectedPullback (A : V →ₗ[ℝ] R) (h : ∀ f, ‖A f‖ = ‖J f‖) :
    Lp ℂ 2 (law(J)) →ₗᵢ[ℂ] Lp ℂ 2 P :=
  Lp.compMeasurePreservingₗᵢ ℂ (readingCoordinates Φ A)
    ⟨measurable_readingCoordinates Φ hm A, gaussian_readingLaw_eq_of_norm P Φ hm hc J A h⟩

theorem reflectedPullback_wick (A : V →ₗ[ℝ] R) (h : ∀ f, ‖A f‖ = ‖J f‖) (f : V) :
    reflectedPullback P Φ hm hc J A h (wickCoordinate (law(J)) J f) = wickReading P Φ hm (A f) := by
  let hp : MeasurePreserving (readingCoordinates Φ A) P (law(J)) :=
    ⟨measurable_readingCoordinates Φ hm A, gaussian_readingLaw_eq_of_norm P Φ hm hc J A h⟩
  apply Lp.ext
  refine (Lp.coeFn_compMeasurePreserving _ hp).trans ?_
  filter_upwards [hp.quasiMeasurePreserving.ae (wickCoordinate_ae (law(J)) J f),
    wickReading_ae P Φ hm (A f)] with w hw hv
  change wickCoordinate (law(J)) J f (readingCoordinates Φ A w) = _ at hw
  change wickCoordinate (law(J)) J f (readingCoordinates Φ A w) = _
  rw [hw, hv, h]
  rfl

variable [S.HasOrthogonalProjection]

/-- The actual reflected pairing of any two nonlinear preparations is their conditional
expectation pairing. The reflected labels need only agree in law on the preparation space. -/
theorem two_sided_conditioning (A : V →ₗ[ℝ] R) (h : ∀ f, ‖A f‖ = ‖J f‖)
    (hcross : ∀ f g, inner ℝ (A f) (J g) =
      inner ℝ (S.orthogonalProjectionOnto (J f)) (S.orthogonalProjectionOnto (J g)))
    (X Y : Lp ℂ 2 (law(J))) :
    inner ℂ (reflectedPullback P Φ hm hc J A h X) (readingPullback P Φ hm J Y) =
      inner ℂ (preparedCondition P Φ hm J S X) (preparedCondition P Φ hm J S Y) := by
  let W := wickCoordinate (law(J)) J
  let T := readingPullback P Φ hm S.subtype
  have hC (f : V) : preparedCondition P Φ hm J S (W f) =
      wickCoordinate (law(S.subtype)) S.subtype (S.orthogonalProjectionOnto (J f)) := by
    change conditionOn P _ _ (readingPullback P Φ hm J (W f)) = _
    rw [show readingPullback P Φ hm J (W f) = wickReading P Φ hm (J f) from
      observationL2_wick P Φ hm J f]
    exact conditionOn_plane_wick P Φ hm hc S _
  have hT (x : S) : T (wickCoordinate (law(S.subtype)) S.subtype x) =
      wickReading P Φ hm (x : R) := observationL2_wick P Φ hm S.subtype x
  refine mixed_pair_eq_of_dense W (reflectedPullback P Φ hm hc J A h).toContinuousLinearMap
    (readingPullback P Φ hm J).toContinuousLinearMap (preparedCondition P Φ hm J S)
    (wickCoordinate_dense P Φ hm J) ?_ X Y
  intro f g
  change inner ℂ (reflectedPullback P Φ hm hc J A h (W f)) (readingPullback P Φ hm J (W g)) = _
  rw [reflectedPullback_wick P Φ hm hc J A h f,
    show readingPullback P Φ hm J (W g) = wickReading P Φ hm (J g) from
      observationL2_wick P Φ hm J g, hC, hC, ← T.inner_map_map, hT, hT,
    wickReading_inner P Φ hm hc, wickReading_inner P Φ hm hc, hcross]
  rfl

/-- Null preparations for the conditioning seminorm. -/
noncomputable def preparedNull : Submodule ℂ (Lp ℂ 2 (law(J))) :=
  (preparedCondition P Φ hm J S).ker

instance preparedNull_isClosed : IsClosed (preparedNull P Φ hm J S : Set (Lp ℂ 2 (law(J)))) :=
  (preparedCondition P Φ hm J S).isClosed_ker

/-- The null relation is exactly the vanishing of the reflected squared length. -/
theorem mem_preparedNull_iff (A : V →ₗ[ℝ] R) (h : ∀ f, ‖A f‖ = ‖J f‖)
    (hcross : ∀ f g, inner ℝ (A f) (J g) =
      inner ℝ (S.orthogonalProjectionOnto (J f)) (S.orthogonalProjectionOnto (J g)))
    (X : Lp ℂ 2 (law(J))) :
    X ∈ preparedNull P Φ hm J S ↔
      inner ℂ (reflectedPullback P Φ hm hc J A h X) (readingPullback P Φ hm J X) = 0 := by
  rw [two_sided_conditioning P Φ hm hc J S A h hcross, inner_self_eq_zero]
  rfl

/-- The quotient of the full preparation L² by the null space is already complete.
Its unique representative as a vector in plane L² is actual conditional expectation. -/
noncomputable def preparedQuotientEquiv
    (happrox : (S : Set R) ⊆ closure (Set.range J)) :
    (Lp ℂ 2 (law(J)) ⧸ preparedNull P Φ hm J S) ≃ₗᵢ[ℂ] Lp ℂ 2 (law(S.subtype)) := by
  let C := preparedCondition P Φ hm J S
  let e := C.toLinearMap.quotKerEquivOfSurjective (preparedCondition_onto P Φ hm hc J S happrox)
  refine { toLinearEquiv := e, norm_map' := ?_ }
  intro q
  apply le_antisymm
  · apply le_of_forall_pos_le_add
    intro ε hε
    obtain ⟨X, hX, hεX⟩ := Submodule.Quotient.norm_mk_lt q hε
    let hB := readingPullback P Φ hm J
    let hO := measurable_readingCoordinates Φ hm S.subtype
    have hCX : ‖C X‖ ≤ ‖X‖ := calc
      _ = ‖condExpL2 ℂ ℂ hO.comap_le (hB X)‖ := (observationL2 P _ hO).symm.norm_map _
      _ ≤ ‖hB X‖ := norm_condExpL2_le hO.comap_le _
      _ = _ := hB.norm_map X
    have heq : e q = C X := by rw [← hX]; rfl
    exact (heq ▸ hCX).trans hεX.le
  · obtain ⟨Y, hY⟩ := plane_pullback_lifts P Φ hm hc J S happrox (e q)
    have hCY : C Y = e q := by
      change conditionOn P _ _ (readingPullback P Φ hm J Y) = _
      rw [hY]
      exact conditionOn_pullback P _ _ _
    have heq : Submodule.Quotient.mk Y = q := e.injective hCY
    have hnorm : ‖Y‖ = ‖e q‖ := by
      rw [← (readingPullback P Φ hm J).norm_map Y, hY, LinearIsometry.norm_map]
    calc
      ‖q‖ = ‖Submodule.Quotient.mk (p := preparedNull P Φ hm J S) Y‖ := congrArg norm heq.symm
      _ ≤ ‖Y‖ := Submodule.Quotient.norm_mk_le _ Y
      _ = _ := hnorm

omit [S.HasOrthogonalProjection] in
theorem preparedQuotientEquiv_mk (happrox : (S : Set R) ⊆ closure (Set.range J))
    (X : Lp ℂ 2 (law(J))) :
    preparedQuotientEquiv P Φ hm hc J S happrox (Submodule.Quotient.mk X) =
      preparedCondition P Φ hm J S X := rfl

omit [S.HasOrthogonalProjection] in
include hc in
/-- The isometry to the full plane law indexed by the original spatial tests is
uniquely determined by conditional expectation on every preparation. -/
theorem prepared_quotient_spatial_tests {U : Type*} [AddCommGroup U] [Module ℝ U]
    (L : U →ₗ[ℝ] R) (hS : S = L.range.topologicalClosure)
    (happrox : (S : Set R) ⊆ closure (Set.range J)) :
    ∃! T : (Lp ℂ 2 (law(J)) ⧸ preparedNull P Φ hm J S) ≃ₗᵢ[ℂ] Lp ℂ 2 (law(L)),
      ∀ X, T (Submodule.Quotient.mk X) = conditionOn P _ (measurable_readingCoordinates Φ hm L)
        (readingPullback P Φ hm J X) := by
  obtain ⟨D, hD⟩ := observed_plane_tests_conditionOn P Φ hm hc S L hS
  let U := (preparedQuotientEquiv P Φ hm hc J S happrox).trans D
  have hU (X) : U (Submodule.Quotient.mk X) = _ :=
    hD (readingPullback P Φ hm J X)
  refine ⟨U, hU, fun T hT ↦ ?_⟩
  apply LinearIsometryEquiv.ext
  intro z
  obtain ⟨X, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  exact (hT X).trans (hU X).symm

end MeasuredPlane

section IndependentPlanes

open UniformSpace

variable {Ω₁ Ω₂ R₁ R₂ V₁ V₂ : Type*} [MeasurableSpace Ω₁] [MeasurableSpace Ω₂]
  [NormedAddCommGroup R₁] [InnerProductSpace ℝ R₁] [NormedAddCommGroup R₂] [InnerProductSpace ℝ R₂]
  [AddCommGroup V₁] [Module ℝ V₁] [AddCommGroup V₂] [Module ℝ V₂]
  (P₁ : Measure Ω₁) [IsFiniteMeasure P₁] (P₂ : Measure Ω₂) [IsFiniteMeasure P₂]
  (Φ₁ : Ω₁ → R₁ →ₗ[ℝ] ℝ) (Φ₂ : Ω₂ → R₂ →ₗ[ℝ] ℝ)
  (hm₁ : ∀ a, Measurable (fun w ↦ Φ₁ w a)) (hm₂ : ∀ a, Measurable (fun w ↦ Φ₂ w a))
  (hc₁ : ∀ a : R₁, (∫ w, Complex.exp ((Φ₁ w a : ℂ) * Complex.I) ∂P₁) =
    (Real.exp (-(‖a‖ ^ 2) / 2) : ℂ))
  (hc₂ : ∀ a : R₂, (∫ w, Complex.exp ((Φ₂ w a : ℂ) * Complex.I) ∂P₂) =
    (Real.exp (-(‖a‖ ^ 2) / 2) : ℂ))
  (J₁ : V₁ →ₗ[ℝ] R₁) (J₂ : V₂ →ₗ[ℝ] R₂) (S₁ : Submodule ℝ R₁) (S₂ : Submodule ℝ R₂)
  (ha₁ : (S₁ : Set R₁) ⊆ closure (Set.range J₁)) (ha₂ : (S₂ : Set R₂) ⊆ closure (Set.range J₂))

local notation "O₁" => readingCoordinates Φ₁ S₁.subtype
local notation "O₂" => readingCoordinates Φ₂ S₂.subtype
local notation "M₁" => P₁.map O₁
local notation "M₂" => P₂.map O₂
local notation "K₁" => (Lp ℂ 2 (P₁.map (readingCoordinates Φ₁ J₁)) ⧸ preparedNull P₁ Φ₁ hm₁ J₁ S₁)
local notation "K₂" => (Lp ℂ 2 (P₂.map (readingCoordinates Φ₂ J₂)) ⧸ preparedNull P₂ Φ₂ hm₂ J₂ S₂)

include hm₁ hm₂ in
/-- Independent Gaussian systems give the product of their concrete plane laws. -/
theorem independent_plane_law :
    (P₁.prod P₂).map (Prod.map O₁ O₂) = Measure.prod M₁ M₂ :=
  (Measure.map_prod_map P₁ P₂ (measurable_readingCoordinates Φ₁ hm₁ S₁.subtype)
    (measurable_readingCoordinates Φ₂ hm₂ S₂.subtype)).symm

include hc₁ hc₂ ha₁ ha₂ in
/-- Composition on the actual null quotients: the tensor product of the two prepared
classes maps to the product of their conditional expectations in the product plane law. -/
theorem conditioned_quotient_tensor :
    ∃! U : Completion (K₁ ⊗[ℂ] K₂) ≃ₗᵢ[ℂ] Lp ℂ 2 (Measure.prod M₁ M₂),
      ∀ X Y, U (ProductL2.tensorPure (Submodule.Quotient.mk X) (Submodule.Quotient.mk Y)) =
        ProductL2.pure (preparedCondition P₁ Φ₁ hm₁ J₁ S₁ X) (preparedCondition P₂ Φ₂ hm₂ J₂ S₂ Y) := by
  let A := preparedQuotientEquiv P₁ Φ₁ hm₁ hc₁ J₁ S₁ ha₁
  let B := preparedQuotientEquiv P₂ Φ₂ hm₂ hc₂ J₂ S₂ ha₂
  let F (p : K₁ × K₂) := ProductL2.pure (A p.1) (B p.2)
  have hd : Dense (Submodule.span ℂ (Set.range F) : Set (Lp ℂ 2 (Measure.prod M₁ M₂))) := by
    have hr : Set.range F = Set.range (fun p : Lp ℂ 2 M₁ × Lp ℂ 2 M₂ ↦ ProductL2.pure p.1 p.2) := by
      ext z
      constructor
      · rintro ⟨⟨x, y⟩, rfl⟩
        exact ⟨(A x, B y), rfl⟩
      · rintro ⟨⟨x, y⟩, rfl⟩
        exact ⟨(A.symm x, B.symm y), by simp [F]⟩
    rw [hr, Submodule.dense_iff_topologicalClosure_eq_top]
    exact dense_pure
  obtain ⟨U, hU, hu⟩ := hilbertTensor_product_unique (id : K₁ → K₁) (id : K₂ → K₂) F
    (by simp) (by simp) hd (fun p q ↦ by
      simp [F, ProductL2.inner_pure])
  refine ⟨U, fun X Y ↦ hU (Submodule.Quotient.mk X, Submodule.Quotient.mk Y), ?_⟩
  intro T hT
  apply hu
  rintro ⟨x, y⟩
  obtain ⟨X, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  obtain ⟨Y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  exact hT X Y

end IndependentPlanes

section TransverseDensity

open FourierTransform
open scoped SchwartzMap ComplexConjugate

variable {d : ℕ}

private noncomputable def physicsFourierComplexSchwartz (d : ℕ) :
    𝓢(MassShell.Space d, ℂ) →L[ℂ] 𝓢(MassShell.Space d, ℂ) :=
  let c : ℝˣ := Units.mk0 ((2 * Real.pi)⁻¹) (by positivity)
  let L : MassShell.Space d ≃L[ℝ] MassShell.Space d := ContinuousLinearEquiv.smulLeft c
  ((((2 * Real.pi) ^ (-(d : ℝ) / 2) : ℝ) : ℂ)) •
    ((SchwartzMap.compCLMOfContinuousLinearEquiv ℂ L).comp (SchwartzMap.fourierTransformCLM ℂ))

private theorem physicsFourierComplexSchwartz_onto :
    Function.Surjective (physicsFourierComplexSchwartz d) := by
  let c : ℝˣ := Units.mk0 ((2 * Real.pi)⁻¹) (by positivity)
  let L : MassShell.Space d ≃L[ℝ] MassShell.Space d := ContinuousLinearEquiv.smulLeft c
  let v : ℂ := (((2 * Real.pi) ^ (-(d : ℝ) / 2) : ℝ) : ℂ)
  have hv : v ≠ 0 := by dsimp [v]; exact_mod_cast (Real.rpow_pos_of_pos (by positivity) _).ne'
  intro g
  let g' := SchwartzMap.compCLMOfContinuousLinearEquiv ℂ L.symm (v⁻¹ • g)
  obtain ⟨f, hf⟩ := (fourierEquiv ℂ (SchwartzMap (MassShell.Space d) ℂ)).surjective g'
  refine ⟨f, ?_⟩
  ext x
  change v * (𝓕 f (L x)) = g x
  change 𝓕 f = g' at hf
  rw [hf]
  change v * (v⁻¹ * g (L.symm (L x))) = g x
  simp [hv]

private theorem physicsFourierComplexSchwartz_real_symm
    (g : 𝓢(MassShell.Space d, ℝ)) (k : MassShell.Space d) :
    physicsFourierComplexSchwartz d (FeatureDensity.ofRealSchwartz g) (-k) =
      conj (physicsFourierComplexSchwartz d (FeatureDensity.ofRealSchwartz g) k) := by
  let c : ℝˣ := Units.mk0 ((2 * Real.pi)⁻¹) (by positivity)
  let L : MassShell.Space d ≃L[ℝ] MassShell.Space d := ContinuousLinearEquiv.smulLeft c
  let z : ℝ := (2 * Real.pi) ^ (-(d : ℝ) / 2)
  let f := FeatureDensity.ofRealSchwartz g
  change (z : ℂ) * (𝓕 f (L (-k))) = conj ((z : ℂ) * (𝓕 f (L k)))
  rw [map_mul, Complex.conj_ofReal, map_neg]
  congr 1
  rw [SchwartzMap.fourier_coe, Real.fourier_eq, Real.fourier_eq,
    ← integral_conj]
  apply integral_congr_ae
  refine ae_of_all _ fun y ↦ ?_
  simp only [Circle.smul_def, smul_eq_mul, map_mul, Real.fourierChar_apply, ← Complex.exp_conj,
    inner_neg_right, neg_neg]
  change _ * (g y : ℂ) = _ * conj (g y : ℂ)
  simp [map_ofNat]

variable (b : MassShell.Space d → ℝ)
  (hb : MemLp (fun k ↦ (b k : ℂ)) ⊤ volume)

private noncomputable def weightedPlaneFourierC :
    𝓢(MassShell.Space d, ℂ) →L[ℂ] Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  (realMultiplier b hb).comp ((SchwartzMap.toLpCLM ℂ ℂ 2 volume).comp
    (physicsFourierComplexSchwartz d))

/-- Weighted physical Fourier coordinates of the real spatial smears. -/
noncomputable def weightedPlaneFourier (g : 𝓢(MassShell.Space d, ℝ)) :
    Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  weightedPlaneFourierC b hb (FeatureDensity.ofRealSchwartz g)

theorem weightedPlaneFourier_ae (g : 𝓢(MassShell.Space d, ℝ)) :
    ⇑(weightedPlaneFourier b hb g) =ᵐ[volume] fun k ↦ (b k : ℂ) *
      ((((2 * Real.pi) ^ (-(d : ℝ) / 2) : ℝ) : ℂ) *
        𝓕 (fun x ↦ (g x : ℂ)) ((2 * Real.pi)⁻¹ • k)) := by
  let t := physicsFourierComplexSchwartz d (FeatureDensity.ofRealSchwartz g)
  refine (realMultiplier_apply_ae b hb (t.toLp 2 volume)).trans ?_
  filter_upwards [t.coeFn_toLp 2 volume] with k hk
  rw [hk]
  rfl

private theorem weightedPlaneFourier_symm (heven : ∀ k, b (-k) = b k)
    (g : 𝓢(MassShell.Space d, ℝ)) :
    ∀ᵐ k ∂volume, weightedPlaneFourier b hb g (-k) = conj (weightedPlaneFourier b hb g k) := by
  let t := physicsFourierComplexSchwartz d (FeatureDensity.ofRealSchwartz g)
  have he : ∀ᵐ k ∂volume, weightedPlaneFourier b hb g k = (b k : ℂ) * t k := by
    filter_upwards [realMultiplier_apply_ae b hb (t.toLp 2 volume),
      t.coeFn_toLp 2 volume] with k h₁ h₂
    exact h₁.trans (by rw [h₂])
  have hneg := (Measure.measurePreserving_neg (volume : Measure (MassShell.Space d))).quasiMeasurePreserving.ae he
  filter_upwards [he, hneg] with k h₁ h₂
  rw [show weightedPlaneFourier b hb g (-k) = _ from h₂, h₁, heven,
    physicsFourierComplexSchwartz_real_symm g, map_mul, Complex.conj_ofReal]

/-- Hermitian-symmetric transverse Fourier profiles have real mixed inner product. -/
theorem hermitian_profile_inner_im (u v : Lp ℂ 2 (volume : Measure (MassShell.Space d)))
    (hu : ∀ᵐ k ∂volume, u (-k) = conj (u k)) (hv : ∀ᵐ k ∂volume, v (-k) = conj (v k)) :
    (inner ℂ u v).im = 0 := by
  have he : conj (inner ℂ u v) = inner ℂ u v := by
    rw [L2.inner_def, ← integral_conj]
    conv_rhs => rw [← integral_neg_eq_self (fun k ↦ inner ℂ (u k) (v k)) volume]
    apply integral_congr_ae
    filter_upwards [hu,hv] with k hk hl
    simp [RCLike.inner_apply, hk, hl]
  have h := congrArg Complex.im he
  simp only [Complex.conj_im] at h
  linarith

/-- Complexification of the real spatial test family is total in transverse momentum L². -/
theorem weightedPhysics_complex_span_dense (hpos : ∀ᵐ k ∂volume, 0 < b k) :
    Dense (Submodule.span ℂ (Set.range (weightedPlaneFourier b hb)) :
      Set (Lp ℂ 2 (volume : Measure (MassShell.Space d)))) := by
  let T := weightedPlaneFourierC b hb
  have hd : DenseRange T :=
    (denseRange_realMultiplier_schwartz volume b hb hpos).comp
      physicsFourierComplexSchwartz_onto.denseRange
      ((realMultiplier b hb).continuous.comp (SchwartzMap.toLpCLM ℂ ℂ 2 volume).continuous)
  apply hd.mono
  rintro _ ⟨g, rfl⟩
  rw [FeatureDensity.schwartz_re_add_im g, map_add, map_smul]
  exact Submodule.add_mem _ (Submodule.subset_span ⟨FeatureDensity.reSchwartz g, rfl⟩)
    (Submodule.smul_mem _ _ (Submodule.subset_span ⟨FeatureDensity.imSchwartz g, rfl⟩))

/-- For any positive bounded even weight, the physical Fourier transforms of real
Schwartz functions approximate every Hermitian-symmetric vector in the weighted coordinates. -/
theorem weightedPhysics_real_dense (heven : ∀ k, b (-k) = b k)
    (hpos : ∀ᵐ k ∂volume, 0 < b k) (u : Lp ℂ 2 (volume : Measure (MassShell.Space d)))
    (hu : ∀ᵐ k ∂volume, u (-k) = conj (u k)) :
    u ∈ closure (Set.range (weightedPlaneFourier b hb)) := by
  let T := weightedPlaneFourierC b hb
  let A := weightedPlaneFourier b hb
  have hd : DenseRange T :=
    (denseRange_realMultiplier_schwartz volume b hb hpos).comp
      physicsFourierComplexSchwartz_onto.denseRange
      ((realMultiplier b hb).continuous.comp (SchwartzMap.toLpCLM ℂ ℂ 2 volume).continuous)
  apply Metric.mem_closure_iff.mpr
  intro ε hε
  obtain ⟨_, ⟨g, rfl⟩, hg⟩ := Metric.mem_closure_iff.mp (hd u) ε hε
  let a := A (FeatureDensity.reSchwartz g)
  let c := A (FeatureDensity.imSchwartz g)
  have hsplit : T g = a + Complex.I • c := by
    conv_lhs => rw [FeatureDensity.schwartz_re_add_im g, map_add, map_smul]
    rfl
  have ha := weightedPlaneFourier_symm b hb heven (FeatureDensity.reSchwartz g)
  have hc := weightedPlaneFourier_symm b hb heven (FeatureDensity.imSchwartz g)
  have huc : (inner ℂ u c).im = 0 := hermitian_profile_inner_im u c hu hc
  have hac : (inner ℂ a c).im = 0 := hermitian_profile_inner_im a c ha hc
  have hzero : (inner ℂ (u - a) (Complex.I • c)).re = 0 := by
    rw [inner_smul_right, inner_sub_left, Complex.mul_re, Complex.sub_im, huc, hac]
    simp
  have hnorm : ‖u - a‖ ≤ ‖u - T g‖ := by
    rw [hsplit, ← sub_sub]
    have hsq := norm_sub_sq (𝕜 := ℂ) (u-a) (Complex.I • c)
    change _ = _ - 2 * (inner ℂ (u-a) (Complex.I • c)).re + _ at hsq
    rw [hzero] at hsq
    nlinarith [sq_nonneg ‖Complex.I • c‖, norm_nonneg (u-a), norm_nonneg (u-a-Complex.I • c)]
  exact ⟨a, ⟨FeatureDensity.reSchwartz g, rfl⟩, by
    rw [dist_eq_norm] at hg ⊢; exact hnorm.trans_lt hg⟩

/-- Real linearity in the spatial test, in the transverse momentum normalization. -/
noncomputable def weightedPlaneFourierL :
    𝓢(MassShell.Space d, ℝ) →L[ℝ] Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  ((weightedPlaneFourierC b hb).restrictScalars ℝ).comp FeatureDensity.ofRealSchwartz

/-- Physical equal-time covariance amplitude of a spatial test before applying the normal isometry. -/
noncomputable def planeSpatialWeight {d : ℕ} (ħ m : ℝ) (k : MassShell.Space d) : ℝ :=
  Real.sqrt (ħ / (2 * modeDispersion m k))

theorem planeSpatialWeight_even (ħ m : ℝ) (k : MassShell.Space d) :
    planeSpatialWeight ħ m (-k) = planeSpatialWeight ħ m k := by
  simp [planeSpatialWeight, modeDispersion]

theorem planeSpatialWeight_pos {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) (k : MassShell.Space d) :
    0 < planeSpatialWeight ħ m k :=
  Real.sqrt_pos.mpr (div_pos hħ (mul_pos two_pos (modeDispersion_pos hm k)))

theorem planeSpatialWeight_bound {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    MemLp (fun k : MassShell.Space d ↦ (planeSpatialWeight ħ m k : ℂ)) ⊤ volume := by
  have hM : Measurable (fun k : MassShell.Space d ↦ (planeSpatialWeight ħ m k : ℂ)) := by
    unfold planeSpatialWeight modeDispersion
    fun_prop
  refine memLp_top_of_bound hM.aestronglyMeasurable (Real.sqrt (ħ / (2*m))) (ae_of_all _ fun k ↦ ?_)
  rw [Complex.norm_real, Real.norm_eq_abs, planeSpatialWeight, abs_of_nonneg (Real.sqrt_nonneg _)]
  apply Real.sqrt_le_sqrt
  apply div_le_div_of_nonneg_left hħ (by positivity)
  apply mul_le_mul_of_nonneg_left _ two_pos.le
  change m ≤ Real.sqrt _
  exact (Real.le_sqrt_of_sq_le (by linarith [sq_nonneg ‖k‖]))

end TransverseDensity

end DotProduct.Extension


/-! ### The plane generated by original spatial tests -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped SchwartzMap ComplexConjugate Topology

/-- The original spatial smear as a real-linear map into the full massive covariance space. -/
noncomputable def physicalSpatialLabel (d : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    𝓢(MassShell.Space d, ℝ) →L[ℝ] Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))) :=
  ((planeMomentumIsometry d m hm).toContinuousLinearMap.restrictScalars ℝ).comp
    (weightedPlaneFourierL (planeSpatialWeight ħ m) (planeSpatialWeight_bound hħ hm))

theorem physicalSpatialLabel_apply {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (g : 𝓢(MassShell.Space d, ℝ)) :
    physicalSpatialLabel d hħ hm g = massivePlaneLabel hħ hm g :=
  (massivePlaneLabel_eq_planeMomentumIsometry hħ hm g _
    (weightedPlaneFourier_ae (planeSpatialWeight ħ m) (planeSpatialWeight_bound hħ hm) g)).symm

/-- Real closed span of the original spatial plane smears. -/
noncomputable def physicalPlane (d : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    Submodule ℝ (Lp ℂ 2 (volume : Measure (MassShell.Space (d+1)))) :=
  (physicalSpatialLabel d hħ hm).toLinearMap.range.topologicalClosure

instance physicalPlane_complete (d : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    CompleteSpace (physicalPlane d hħ hm) :=
  (physicalSpatialLabel d hħ hm).toLinearMap.range.isClosed_topologicalClosure.completeSpace_coe

/-- Positive preparations are all real Schwartz smears on the open side. -/
noncomputable def positiveBulkLabel (d : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    positiveSchwartz d →ₗ[ℝ] Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))) :=
  (massiveEuclideanLabel (d+1) ħ m hħ hm).toLinearMap.comp (positiveSchwartz d).subtype

theorem physicalPlane_le_positive {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    (physicalPlane d hħ hm : Set (Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))))) ⊆ closure (Set.range (positiveBulkLabel d hħ hm)) := by
  change closure ((physicalSpatialLabel d hħ hm).toLinearMap.range : Set (Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))))) ⊆ _
  apply closure_minimal _ isClosed_closure
  rintro _ ⟨g,rfl⟩
  change physicalSpatialLabel d hħ hm g ∈ _
  rw [physicalSpatialLabel_apply]
  apply closure_mono _ (massivePlaneLabel_mem_closure_positive hħ hm g)
  rintro _ ⟨f,hf,rfl⟩
  exact ⟨⟨f, mem_positiveSchwartz_of_tsupport f hf⟩, rfl⟩

/-- Each Hermitian-symmetric transverse L² amplitude belongs to the physical real plane
after the normalized normal embedding. -/
theorem symmetric_planeMomentumIsometry_mem {d : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (u : Lp ℂ 2 (volume : Measure (MassShell.Space d)))
    (hu : ∀ᵐ k ∂volume, u (-k) = conj (u k)) :
    planeMomentumIsometry d m hm u ∈ physicalPlane d hħ.le hm := by
  have hd := weightedPhysics_real_dense (planeSpatialWeight ħ m) (planeSpatialWeight_bound hħ.le hm)
    (planeSpatialWeight_even ħ m) (ae_of_all _ (planeSpatialWeight_pos hħ hm)) u hu
  have hc : IsClosed (physicalPlane d hħ.le hm : Set (Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))))) :=
    (physicalSpatialLabel d hħ.le hm).toLinearMap.range.isClosed_topologicalClosure
  apply closure_minimal (t := (planeMomentumIsometry d m hm) ⁻¹' (physicalPlane d hħ.le hm : Set (Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))))))
    _ (hc.preimage (planeMomentumIsometry d m hm).continuous) hd
  rintro _ ⟨g,rfl⟩
  exact (physicalSpatialLabel d hħ.le hm).toLinearMap.range.le_topologicalClosure ⟨g,rfl⟩

/-- The positive preparation's attenuated boundary amplitude belongs to the closed real plane
generated by spatial Schwartz smears. -/
theorem boundaryLabel_mem_physicalPlane {d : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (f : positiveSchwartz d) :
    planeMomentumIsometry d m hm (boundaryLabel hħ.le hm f) ∈ physicalPlane d hħ.le hm := by
  apply symmetric_planeMomentumIsometry_mem hħ hm
  have h := boundaryLabel_ae hħ.le hm f
  have hn := (Measure.measurePreserving_neg (volume : Measure (MassShell.Space d))).quasiMeasurePreserving.ae h
  filter_upwards [h, hn] with k hk hneg
  exact hneg.trans ((boundaryFeature_conj_neg ħ m f.1 k).trans (congrArg (starRingEnd ℂ) hk.symm))

/-- A single normalized one-sided Schwartz mollifier works for every spatial test.
Its original stochastic readings converge in the actual Gaussian probability space's real L². -/
theorem exists_mollifier_massivePlaneReading {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    ∃ ρ : 𝓢(ℝ, ℝ), (∀ t, 0 ≤ ρ t) ∧ tsupport (ρ : ℝ → ℝ) ⊆ Ioo 1 2 ∧ (∫ t, ρ t) = 1 ∧
      ∀ g : 𝓢(MassShell.Space d, ℝ),
        (∀ r > 0, separatedEuclideanSchwartz (oneSidedNormalSchwartz ρ r) g ∈ positiveSchwartz d) ∧
        Tendsto (fun r ↦ gaussianIsonormal (massiveEuclideanBasis (d+1))
          (massiveEuclideanLabel (d+1) ħ m hħ hm (separatedEuclideanSchwartz (oneSidedNormalSchwartz ρ r) g)))
          (𝓝[>] 0) (𝓝 (gaussianIsonormal (massiveEuclideanBasis (d+1)) (massivePlaneLabel hħ hm g))) := by
  obtain ⟨ρ, hρ, hn, hs, h1⟩ := exists_smooth_unit_bump_Ioo_one_two
  have hcs : HasCompactSupport ρ := HasCompactSupport.of_support_subset_isCompact isCompact_Icc
    ((subset_tsupport ρ).trans (hs.trans Ioo_subset_Icc_self))
  let b := hcs.toSchwartzMap hρ
  refine ⟨b, hn, hs, h1, fun g ↦ ⟨fun r hr ↦
    mem_positiveSchwartz_of_tsupport _ (oneSidedSchwartz_support g b hs hr), ?_⟩⟩
  exact massiveEuclideanReadingL2_tendsto hħ hm _ (massiveEuclideanLabel_tendsto_plane hħ hm g b hn hs h1)

end DotProduct.Extension


/-! ### Physical orthogonal projection and totality -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped SchwartzMap InnerProductSpace

theorem physicalL2_real_inner {D : ℕ} (u v : Lp ℂ 2 (volume : Measure (MassShell.Space D))) :
    inner ℝ u v = (inner ℂ u v).re := by
  have h := norm_add_sq (𝕜 := ℂ) u v
  change ‖u+v‖^2 = ‖u‖^2 + 2 * (inner ℂ u v).re + ‖v‖^2 at h
  linarith [norm_add_sq_real u v]

theorem physicalPlane_projection {d : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)
    (f : positiveSchwartz d) :
    ((physicalPlane d hħ.le hm).orthogonalProjectionOnto
      (massiveEuclideanLabel (d+1) ħ m hħ.le hm f.1) : Lp ℂ 2 volume) =
      planeMomentumIsometry d m hm (boundaryLabel hħ.le hm f) := by
  let I := planeMomentumIsometry d m hm
  let A := massiveEuclideanLabel (d+1) ħ m hħ.le hm f.1
  let u := boundaryLabel hħ.le hm f
  apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero (boundaryLabel_mem_physicalPlane hħ hm f)
  intro w hw
  change w ∈ closure ((physicalSpatialLabel d hħ.le hm).toLinearMap.range : Set _) at hw
  let Z := {z : Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))) | inner ℝ (A - I u) z = 0}
  have hc : IsClosed Z := isClosed_eq (continuous_const.inner continuous_id) continuous_const
  apply closure_minimal (t := Z) _ hc hw
  rintro _ ⟨g, rfl⟩
  let v := weightedPlaneFourierL (planeSpatialWeight ħ m) (planeSpatialWeight_bound hħ.le hm) g
  change inner ℝ (A - I u) (I v) = 0
  rw [real_inner_comm, physicalL2_real_inner, inner_sub_right, I.inner_map_map]
  have hi : inner ℂ (I v) A = inner ℂ v u := planeMomentumIsometry_inner_bulk hħ.le hm v f
  rw [hi, sub_self]
  rfl

noncomputable def physicalFeatureL (d : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) :
    positiveSchwartz d →ₗ[ℝ] Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  (((planeMomentumIsometry d m hm).toContinuousLinearMap.adjoint).restrictScalars ℝ).toLinearMap.comp
    (positiveBulkLabel d hħ hm)

theorem physicalFeatureL_apply {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : positiveSchwartz d) : physicalFeatureL d hħ hm f = boundaryLabel hħ hm f := by
  apply ext_inner_left ℂ
  intro v
  exact ((planeMomentumIsometry d m hm).toContinuousLinearMap.adjoint_inner_right v _).trans
    (planeMomentumIsometry_inner_bulk hħ hm v f)

/-- The range for the paper's own preparations has dense complex span. -/
theorem physicalFeatureL_dense {d : ℕ} {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) :
    Dense (Submodule.span ℂ (Set.range (physicalFeatureL d hħ.le hm)) :
      Set (Lp ℂ 2 (volume : Measure (MassShell.Space d)))) := by
  let I := planeMomentumIsometry d m hm
  let J := positiveBulkLabel d hħ.le hm
  let M := physicalFeatureL d hħ.le hm
  let b := planeSpatialWeight (d := d) ħ m
  let hb := planeSpatialWeight_bound (d := d) hħ.le hm
  let B := weightedPlaneFourierL b hb
  let T := I.toContinuousLinearMap.adjoint
  let K := (Submodule.span ℂ (Set.range M)).topologicalClosure
  have hpre : Set.range J ⊆ T ⁻¹' (K : Set _) := by
    rintro _ ⟨f,rfl⟩
    exact Submodule.le_topologicalClosure _ (Submodule.subset_span (Set.mem_range_self (f := M) f))
  have hcl := closure_minimal hpre
    ((Submodule.isClosed_topologicalClosure _).preimage T.continuous)
  have hmem (g : 𝓢(MassShell.Space d, ℝ)) : B g ∈ K := by
    have hg : I (B g) ∈ physicalPlane d hħ.le hm :=
      (physicalSpatialLabel d hħ.le hm).toLinearMap.range.le_topologicalClosure ⟨g,rfl⟩
    have ht : T (I (B g)) ∈ K := hcl (physicalPlane_le_positive hħ.le hm hg)
    have hid : T (I (B g)) = B g :=
      ext_inner_left ℂ fun v ↦ (I.toContinuousLinearMap.adjoint_inner_right v _).trans
        (I.inner_map_map v (B g))
    exact hid ▸ ht
  have hd := weightedPhysics_complex_span_dense b hb
    (ae_of_all _ fun k ↦ planeSpatialWeight_pos hħ hm k)
  rw [Submodule.dense_iff_topologicalClosure_eq_top] at hd ⊢
  apply top_unique
  rw [← hd]
  refine (Submodule.topologicalClosure_mono (Submodule.span_le.mpr ?_ : Submodule.span ℂ _ ≤ K)).trans_eq
    ((Submodule.isClosed_topologicalClosure _).submodule_topologicalClosure_eq)
  rintro _ ⟨g,rfl⟩
  exact hmem g

end DotProduct.Extension


/-! ### Equation (7) on the original unitary transverse Fourier transforms -/

namespace DotProduct.Extension

open MeasureTheory Set Filter Real
open scoped SchwartzMap InnerProductSpace

/-- Unitary transverse Fourier transform of the spatial slice of the original test. -/
noncomputable def physicalTrace {d : ℕ} (f : MassShell.Space (d+1) → ℝ) (s : ℝ)
    (k : MassShell.Space d) : ℂ :=
  physicsFourier (fun y ↦ f ((MassShell.split d).symm (s,y))) k

theorem boundaryFeature_eq_featureMap {d : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (f : positiveSchwartz d) (k : MassShell.Space d) :
    boundaryFeature ħ m f.1 k = featureMap ħ m (physicalTrace f.1) k := by
  let ω := modeDispersion m k
  let G (x : MassShell.Space (d+1)) := spatialAmplitude f.1 k x * (Real.exp (-ω * x 0) : ℂ)
  let F (z : ℝ × MassShell.Space d) := G ((MassShell.split d).symm z)
  have ht : Measurable fun x : MassShell.Space (d+1) ↦ x 0 := (MassShell.split d).measurable.fst
  have hg : Integrable G := by
    refine (spatialAmplitude_integrable f.1 k).norm.mono'
      ((spatialAmplitude_integrable f.1 k).aestronglyMeasurable.mul (by fun_prop)) ?_
    refine ae_of_all _ fun x ↦ ?_
    dsimp only [G]
    by_cases hx : f.1 x = 0
    · simp [spatialAmplitude, hx]
    · rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.exp_nonneg _)]
      refine mul_le_of_le_one_right (norm_nonneg _) (Real.exp_le_one_iff.mpr ?_)
      exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (modeDispersion_pos hm k).le)
        (mem_positiveSchwartz_iff.mp f.2 x hx).le
  have hi : Integrable F (volume.prod volume) := ((MassShell.split_volume d).symm.integrable_comp_emb
      (MassShell.split d).symm.measurableEmbedding).mpr hg
  unfold boundaryFeature planeAmplitude featureMap
  congr 1
  change _ * (∫ x, G x) = _
  rw [← (MassShell.split_volume d).symm.integral_comp' G]
  change _ * (∫ z, F z ∂(volume.prod volume)) = _
  rw [integral_prod F hi, ← integral_const_mul]
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero]
  · apply integral_congr_ae
    refine ae_of_all _ fun s ↦ ?_
    dsimp only
    rw [physicalTrace, physicsFourier_integral]
    let H (y : MassShell.Space d) :=
      (f.1 ((MassShell.split d).symm (s,y)) : ℂ) * Complex.exp (-Complex.I * (inner ℝ y k : ℂ))
    have he (y : MassShell.Space d) : F (s,y) = (Real.exp (-s*ω) : ℂ) * H y := by
      dsimp only [F, G, spatialAmplitude, H]
      have hz := (MassShell.split d).apply_symm_apply (s,y)
      rw [show MassShell.tail ((MassShell.split d).symm (s,y)) = y from congrArg Prod.snd hz,
        show ((MassShell.split d).symm (s,y)) 0 = s from congrArg Prod.fst hz]
      unfold normalPhase
      push_cast
      ring_nf
    simp_rw [he, integral_const_mul]
    ring
  · intro s hs
    have hz (y : MassShell.Space d) : f.1 ((MassShell.split d).symm (s,y)) = 0 :=
      f.2 _ (show ((MassShell.split d).symm (s,y)) 0 ≤ 0 from
        (show ((MassShell.split d).symm (s,y)) 0 = s from congrArg Prod.fst
          ((MassShell.split d).apply_symm_apply (s,y))) ▸ le_of_not_gt hs)
    simp [physicalTrace, physicsFourier_integral, hz]

theorem physicalFeatureL_ae {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : positiveSchwartz d) :
    ⇑(physicalFeatureL d hħ hm f) =ᵐ[volume] featureMap ħ m (physicalTrace f.1) := by
  rw [physicalFeatureL_apply]
  exact (boundaryLabel_ae hħ hm f).trans (ae_of_all _ fun k ↦ boundaryFeature_eq_featureMap ħ hm f k)

theorem continuumCov_reflected_eq_released_feature {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : positiveSchwartz d) :
    continuumCov ħ m (physicsFourier (reflectSchwartz d f.1)) (physicsFourier g.1) =
      reflectedCov ħ m (physicalTrace f.1) (physicalTrace g.1) := by
  rw [← massiveEuclideanLabel_inner hħ hm, physical_reflected_inner hħ hm,
    ← physicalFeatureL_apply hħ hm f, ← physicalFeatureL_apply hħ hm g]
  exact (reflectedCov_eq_Lp_inner hħ hm _ _ _ _ (physicalFeatureL_ae hħ hm f)
    (physicalFeatureL_ae hħ hm g)).symm

end DotProduct.Extension


/-! ### Invariance of the full Euclidean law and covariance on the plane -/

namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap FourierTransform InnerProductSpace

/-- The concrete equal-time covariance of the spatial Schwartz readings, with the unitary
transverse Fourier convention and the physical factor ħ/(2ω). -/
theorem physicalPlane_spatial_covariance {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f g : 𝓢(MassShell.Space d, ℝ)) :
    inner ℂ (physicalSpatialLabel d hħ hm f) (physicalSpatialLabel d hħ hm g) =
      ∫ k, (ħ : ℂ) / (2 * (modeDispersion m k : ℂ)) * star (physicsFourier f k) * physicsFourier g k := by
  let b := @planeSpatialWeight d ħ m
  let hb := planeSpatialWeight_bound (d := d) hħ hm
  change inner ℂ (planeMomentumIsometry d m hm (weightedPlaneFourier b hb f))
    (planeMomentumIsometry d m hm (weightedPlaneFourier b hb g)) = _
  rw [LinearIsometry.inner_map_map, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [weightedPlaneFourier_ae b hb f, weightedPlaneFourier_ae b hb g] with k hf hg
  change weightedPlaneFourier b hb f k = (boundaryWeight ħ m k : ℂ) * physicsFourier f k at hf
  change weightedPlaneFourier b hb g k = (boundaryWeight ħ m k : ℂ) * physicsFourier g k at hg
  rw [hf, hg, RCLike.inner_apply, map_mul, Complex.conj_ofReal]
  simp only [RCLike.star_def]
  linear_combination (starRingEnd ℂ (physicsFourier f k) * physicsFourier g k) * boundaryWeight_sq hħ hm k

/-- Pullback of real Euclidean Schwartz tests by the isometry x ↦ R x − a. -/
noncomputable def euclideanAffineSchwartz {D : ℕ} (R : MassShell.Space D ≃ₗᵢ[ℝ] MassShell.Space D)
    (a : MassShell.Space D) : 𝓢(MassShell.Space D, ℝ) →L[ℝ] 𝓢(MassShell.Space D, ℝ) :=
  (SchwartzMap.compCLMOfContinuousLinearEquiv ℝ R.toContinuousLinearEquiv).comp
    (SchwartzMap.compSubConstCLM ℝ a)

theorem euclideanAffineSchwartz_apply {D : ℕ} (R : MassShell.Space D ≃ₗᵢ[ℝ] MassShell.Space D)
    (a : MassShell.Space D) (f : 𝓢(MassShell.Space D, ℝ)) (x : MassShell.Space D) :
    euclideanAffineSchwartz R a f x = f (R x - a) := rfl

theorem physicsFourier_affine {D : ℕ} (R : MassShell.Space D ≃ₗᵢ[ℝ] MassShell.Space D)
    (a : MassShell.Space D) (f : 𝓢(MassShell.Space D, ℝ)) (p : MassShell.Space D) :
    physicsFourier (euclideanAffineSchwartz R a f) p =
      Complex.exp (-Complex.I * (inner ℝ a (R p) : ℂ)) * physicsFourier f (R p) := by
  let f' := SchwartzMap.compSubConstCLM ℝ a f
  have hR : physicsFourier (euclideanAffineSchwartz R a f) p = physicsFourier f' (R p) := by
    unfold physicsFourier
    congr 1
    change 𝓕 ((fun x ↦ (f' x : ℂ)) ∘ R) ((2 * Real.pi)⁻¹ • p) = _
    rw [Real.fourier_comp_linearIsometry, map_smul]
  rw [hR, physicsFourier_integral, physicsFourier_integral]
  let F (x : MassShell.Space D) := (f' x : ℂ) * Complex.exp (-Complex.I * (inner ℝ x (R p) : ℂ))
  change _ * (∫ x, F x) = _
  rw [← MeasureTheory.integral_add_right_eq_self F a]
  have h (x : MassShell.Space D) : F (x+a) = Complex.exp (-Complex.I * (inner ℝ a (R p) : ℂ)) *
      ((f x : ℂ) * Complex.exp (-Complex.I * (inner ℝ x (R p) : ℂ))) := by
    simp only [F, f', SchwartzMap.compSubConstCLM_apply, add_sub_cancel_right, inner_add_left,
      Complex.ofReal_add, mul_add, Complex.exp_add]
    ring
  simp_rw [h]
  rw [integral_const_mul]
  ring

/-- Invariance of the entire massive coordinate probability law under arbitrary Euclidean
translations, rotations and reflections in every dimension. -/
theorem massiveEuclideanLaw_affine_invariant {D : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (R : MassShell.Space D ≃ₗᵢ[ℝ] MassShell.Space D) (a : MassShell.Space D) :
    (massiveEuclideanLaw D ħ m hħ hm).map
      (fun x f ↦ x (euclideanAffineSchwartz R a f)) = massiveEuclideanLaw D ħ m hħ hm := by
  classical
  let T := euclideanAffineSchwartz R a
  have hT : Measurable (fun (x : 𝓢(MassShell.Space D, ℝ) → ℝ) f ↦ x (T f)) :=
    Measurable.of_eval fun f ↦ measurable_pi_apply (T f)
  apply massiveEuclideanLaw_unique hħ hm
  intro s c
  have hM : Measurable (fun x : 𝓢(MassShell.Space D, ℝ) → ℝ ↦
      Complex.exp (Complex.I * ((∑ i : s, c i * x i.1 : ℝ) : ℂ))) := by fun_prop
  rw [integral_map hT.aemeasurable hM.aestronglyMeasurable]
  change (∫ x, Complex.exp (Complex.I * ((∑ i : s, c i * x (T i.1) : ℝ) : ℂ))
    ∂massiveEuclideanLaw D ħ m hħ hm) = _
  rw [massiveEuclideanLaw_jointChar hħ hm (fun i : s ↦ T i.1) c]
  let G (p : MassShell.Space D) := ∑ i : s, (c i : ℂ) * physicsFourier i.1 p
  let z (p : MassShell.Space D) := Complex.exp (-Complex.I * (inner ℝ a (R p) : ℂ))
  have hsum (p : MassShell.Space D) : (∑ i : s, (c i : ℂ) * physicsFourier (T i.1) p) = z p * G (R p) := by
    unfold G
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [show physicsFourier (T i.1) p = _ from physicsFourier_affine R a i.1 p]
    dsimp [z]; ring
  have hunit (p : MassShell.Space D) : star (z p) * z p = 1 := by
    change starRingEnd ℂ _ * _ = _
    simp only [z, ← Complex.exp_conj, map_mul, map_neg, Complex.conj_ofReal, Complex.conj_I,
      neg_neg, ← Complex.exp_add]
    simp
  have hcov : continuumCov ħ m (fun p ↦ z p * G (R p)) (fun p ↦ z p * G (R p)) =
      continuumCov ħ m G G := by
    unfold continuumCov
    congr 1
    simp only [Complex.ofReal_inv]
    rw [← R.measurePreserving.integral_comp R.toHomeomorph.measurableEmbedding
      (fun p ↦ star (G p) * G p * (continuumDispersion m p : ℂ)⁻¹)]
    apply integral_congr_ae
    refine ae_of_all _ fun p ↦ ?_
    have hdisp : continuumDispersion m (R p) = continuumDispersion m p := by simp [continuumDispersion]
    dsimp only
    rw [hdisp, star_mul]
    linear_combination (star (G (R p)) * G (R p) * (continuumDispersion m p : ℂ)⁻¹) * hunit p
  simp only [hsum, hcov]
  rfl

end DotProduct.Extension


/-! ### Conditional expectation on the massive spatial law -/

namespace DotProduct.Extension

open MeasureTheory Set UniformSpace
open scoped SchwartzMap InnerProductSpace TensorProduct

section PhysicalCondition

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)

local notation "P" => standardGaussianProduct (massiveEuclideanBasisSet (d+1))
local notation "Φ" => pointwiseGaussian (massiveEuclideanBasis (d+1))
local notation "hΦ" => pointwiseGaussian_measurable (massiveEuclideanBasis (d+1))
local notation "hchar" => pointwiseGaussian_char (massiveEuclideanBasis (d+1))
local notation "J" => positiveBulkLabel d hħ hm
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d hħ hm)
local notation "S" => physicalPlane d hħ hm

/-- Positive-side coordinate law of the massive Euclidean field. -/
noncomputable abbrev massivePreparationLaw : Measure (positiveSchwartz d → ℝ) :=
  Measure.map (readingCoordinates Φ J) P

/-- The positive law is the restriction of the released spacetime-smear law to positive tests. -/
theorem massivePreparationLaw_marginal :
    (massiveEuclideanLaw (d+1) ħ m hħ hm).map
      (fun x : 𝓢(MassShell.Space (d+1), ℝ) → ℝ ↦ fun f : positiveSchwartz d ↦ x f.1) =
      massivePreparationLaw d hħ hm := by
  rw [massiveEuclideanLaw, Measure.map_map
    (Measurable.of_eval (fun f : positiveSchwartz d ↦ measurable_pi_apply f.1))
    (massiveEuclideanReading_measurable hħ hm)]
  rfl

/-- The plane probability law evaluated on the original real spatial Schwartz tests. -/
noncomputable abbrev massiveSpatialLaw : Measure (𝓢(MassShell.Space d, ℝ) → ℝ) :=
  Measure.map (readingCoordinates Φ L) P

/-- Conditional expectation onto the field read by the original plane tests. -/
noncomputable def conditionedMassivePreparation (X : Lp ℂ 2 (massivePreparationLaw d hħ hm)) :
    Lp ℂ 2 (massiveSpatialLaw d hħ hm) :=
  conditionOn P _ (measurable_readingCoordinates Φ hΦ L) (readingPullback P Φ hΦ J X)

/-- The (complete) quotient of all square-integrable positive-side preparations. -/
noncomputable abbrev massivePreparationClass :=
  Lp ℂ 2 (massivePreparationLaw d hħ hm) ⧸ preparedNull P Φ hΦ J S

/-- The same positive test, evaluated after geometric reflection in the original spacetime plane. -/
noncomputable def reflectedBulkLabel :
    positiveSchwartz d →ₗ[ℝ] Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))) :=
  (massiveEuclideanLabel (d+1) ħ m hħ hm).toLinearMap.comp
    ((reflectSchwartz d).toLinearMap.comp (positiveSchwartz d).subtype)

theorem reflectedBulkLabel_norm (f : positiveSchwartz d) : ‖reflectedBulkLabel d hħ hm f‖ = ‖J f‖ :=
  massiveEuclideanLabel_reflect_norm hħ hm f.1

/-- The Osterwalder–Schrader overlap evaluates one observable on the reflected field and
the other on the positive side, using the same underlying massive Euclidean field. -/
noncomputable def massiveReflectionPair (X Y : Lp ℂ 2 (massivePreparationLaw d hħ hm)) : ℂ :=
  inner ℂ (reflectedPullback P Φ hΦ hchar J (reflectedBulkLabel d hħ hm)
    (reflectedBulkLabel_norm d hħ hm) X) (readingPullback P Φ hΦ J Y)

/-- Quotienting and completing all preparations with the conditional expectation seminorm
gives the whole original spatial-test plane law, preserving every preparation. -/
theorem massive_conditioning_unitary :
    ∃! U : massivePreparationClass d hħ hm ≃ₗᵢ[ℂ] Lp ℂ 2 (massiveSpatialLaw d hħ hm),
      ∀ X, U (Submodule.Quotient.mk X) = conditionedMassivePreparation d hħ hm X :=
  prepared_quotient_spatial_tests P Φ hΦ hchar J S L rfl (physicalPlane_le_positive hħ hm)

include hħ hm in
theorem massive_conditioning_surjective :
    Function.Surjective (conditionedMassivePreparation d hħ hm) := by
  obtain ⟨U, hU, _⟩ := massive_conditioning_unitary d hħ hm
  intro y
  obtain ⟨z, rfl⟩ := U.surjective y
  obtain ⟨X, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  exact ⟨X, (hU X).symm⟩

end PhysicalCondition

section ReflectionIdentification

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)

local notation "P" => standardGaussianProduct (massiveEuclideanBasisSet (d+1))
local notation "Φ" => pointwiseGaussian (massiveEuclideanBasis (d+1))
local notation "hΦ" => pointwiseGaussian_measurable (massiveEuclideanBasis (d+1))
local notation "hc" => pointwiseGaussian_char (massiveEuclideanBasis (d+1))
local notation "J" => positiveBulkLabel d (le_of_lt hħ) hm
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d (le_of_lt hħ) hm)
local notation "S" => physicalPlane d (le_of_lt hħ) hm

private theorem original_projection_real_gram (f g : positiveSchwartz d) :
    inner ℝ (reflectedBulkLabel d hħ.le hm f) (J g) =
      inner ℝ ((S).orthogonalProjectionOnto (J f)) ((S).orthogonalProjectionOnto (J g)) := by
  let I := planeMomentumIsometry d m hm
  let p := fun f : positiveSchwartz d ↦ ((S).orthogonalProjectionOnto (J f) : Lp ℂ 2 (volume : Measure (MassShell.Space (d+1))))
  let M := boundaryLabel (d := d) hħ.le hm
  have hp (a : positiveSchwartz d) : p a = I (M a) := physicalPlane_projection hħ hm a
  calc
    _ = (inner ℂ (reflectedBulkLabel d hħ.le hm f) (J g)).re := physicalL2_real_inner _ _
    _ = (inner ℂ (M f) (M g)).re := congrArg Complex.re (physical_reflected_inner hħ.le hm f g)
    _ = (inner ℂ (I (M f)) (I (M g))).re := congrArg Complex.re (I.inner_map_map _ _).symm
    _ = inner ℝ (I (M f)) (I (M g)) := (physicalL2_real_inner _ _).symm
    _ = inner ℝ (p f) (p g) := congrArg₂ (inner ℝ) (hp f).symm (hp g).symm
    _ = _ := rfl

/-- The continuum reflection identity on every pair of nonlinear positive-side L² preparations,
for the physical massive field and its spatial-test plane law. -/
theorem massive_reflection_eq_conditioning
    (X Y : Lp ℂ 2 (massivePreparationLaw d hħ.le hm)) :
    massiveReflectionPair d hħ.le hm X Y =
      inner ℂ (conditionedMassivePreparation d hħ.le hm X)
        (conditionedMassivePreparation d hħ.le hm Y) := by
  obtain ⟨D, hD⟩ := observed_plane_tests_conditionOn P Φ hΦ hc S L rfl
  have h (Z : Lp ℂ 2 (massivePreparationLaw d hħ.le hm)) :
      D (preparedCondition P Φ hΦ J S Z) = conditionedMassivePreparation d hħ.le hm Z :=
    hD (readingPullback P Φ hΦ J Z)
  let C := preparedCondition P Φ hΦ J S
  calc
    _ = inner ℂ (C X) (C Y) :=
      two_sided_conditioning P Φ hΦ hc J S (reflectedBulkLabel d hħ.le hm)
        (reflectedBulkLabel_norm d hħ.le hm) (original_projection_real_gram d hħ hm) X Y
    _ = inner ℂ (D (C X)) (D (C Y)) := (D.inner_map_map _ _).symm
    _ = _ := congrArg₂ (inner ℂ) (h X) (h Y)

/-- The quotient is exactly by zero reflected length for the full positive-side preparation L². -/
theorem massive_reflection_null_iff (X : Lp ℂ 2 (massivePreparationLaw d hħ.le hm)) :
    (Submodule.Quotient.mk X : massivePreparationClass d hħ.le hm) = 0 ↔
      massiveReflectionPair d hħ.le hm X X = 0 := by
  refine (Submodule.Quotient.mk_eq_zero _).trans ?_
  exact mem_preparedNull_iff P Φ hΦ hc J S (reflectedBulkLabel d hħ.le hm)
    (reflectedBulkLabel_norm d hħ.le hm) (original_projection_real_gram d hħ hm) X

private theorem unitary_labels_inner {X H K : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [NormedAddCommGroup K] [InnerProductSpace ℂ K]
    (i : X → H) (a : X → K) (h : ∃ U : H ≃ₗᵢ[ℂ] K, ∀ x, U (i x) = a x) (x y : X) :
    inner ℂ (i x) (i y) = inner ℂ (a x) (a y) := by
  obtain ⟨U,hU⟩ := h
  exact (U.inner_map_map _ _).symm.trans (congrArg₂ (inner ℂ) (hU x) (hU y))

/-- The quotient Hilbert inner product is precisely the reflected overlap of the
original preparations, including general nonlinear observables. -/
theorem massive_quotient_inner_eq_reflection (X Y : Lp ℂ 2 (massivePreparationLaw d hħ.le hm)) :
    inner ℂ (Submodule.Quotient.mk X : massivePreparationClass d hħ.le hm)
      (Submodule.Quotient.mk Y) = massiveReflectionPair d hħ.le hm X Y := by
  exact (unitary_labels_inner (H := massivePreparationClass d hħ.le hm) Submodule.Quotient.mk
    (conditionedMassivePreparation d hħ.le hm) (massive_conditioning_unitary d hħ.le hm).exists X Y).trans
      (massive_reflection_eq_conditioning d hħ hm X Y).symm

end ReflectionIdentification

section PhysicalComposition

variable (d e : ℕ) {ħ₁ ħ₂ m₁ m₂ : ℝ} (h₁ : 0 < ħ₁) (h₂ : 0 < ħ₂)
  (hm₁ : 0 < m₁) (hm₂ : 0 < m₂)

local notation "K₁" => massivePreparationClass d (le_of_lt h₁) hm₁
local notation "K₂" => massivePreparationClass e (le_of_lt h₂) hm₂
local notation "M₁" => massiveSpatialLaw d (le_of_lt h₁) hm₁
local notation "M₂" => massiveSpatialLaw e (le_of_lt h₂) hm₂

/-- Independence of the two massive Euclidean fields gives the product law of their
actual plane readings. -/
theorem massive_spatial_product_law :
    let P₁ := standardGaussianProduct (massiveEuclideanBasisSet (d+1))
    let P₂ := standardGaussianProduct (massiveEuclideanBasisSet (e+1))
    let O₁ := readingCoordinates (pointwiseGaussian (massiveEuclideanBasis (d+1)))
      (physicalSpatialLabel d h₁.le hm₁).toLinearMap
    let O₂ := readingCoordinates (pointwiseGaussian (massiveEuclideanBasis (e+1)))
      (physicalSpatialLabel e h₂.le hm₂).toLinearMap
    (P₁.prod P₂).map (Prod.map O₁ O₂) = Measure.prod M₁ M₂ :=
  (Measure.map_prod_map _ _
    (measurable_readingCoordinates _ (pointwiseGaussian_measurable _) _)
    (measurable_readingCoordinates _ (pointwiseGaussian_measurable _) _)).symm

private theorem tensor_of_quotient_labels {α β H K X Y : Type*}
    [MeasurableSpace α] [MeasurableSpace β] (μ : Measure α) (ν : Measure β)
    [SFinite μ] [SFinite ν] [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [NormedAddCommGroup K] [InnerProductSpace ℂ K]
    (i : X → H) (j : Y → K) (hi : Function.Surjective i) (hj : Function.Surjective j)
    (a : X → Lp ℂ 2 μ) (b : Y → Lp ℂ 2 ν)
    (ea : ∃ A : H ≃ₗᵢ[ℂ] Lp ℂ 2 μ, ∀ x, A (i x) = a x)
    (eb : ∃ B : K ≃ₗᵢ[ℂ] Lp ℂ 2 ν, ∀ y, B (j y) = b y) :
    ∃! T : Completion (H ⊗[ℂ] K) ≃ₗᵢ[ℂ] Lp ℂ 2 (μ.prod ν),
      ∀ x y, T (ProductL2.tensorPure (i x) (j y)) = ProductL2.pure (a x) (b y) := by
  obtain ⟨A,hA⟩ := ea
  obtain ⟨B,hB⟩ := eb
  let F (p : H × K) := ProductL2.pure (A p.1) (B p.2)
  have hd : Dense (Submodule.span ℂ (Set.range F) : Set (Lp ℂ 2 (μ.prod ν))) := by
    have hr : Set.range F = Set.range (fun p : Lp ℂ 2 μ × Lp ℂ 2 ν ↦ ProductL2.pure p.1 p.2) := by
      ext z
      constructor
      · rintro ⟨⟨x,y⟩, rfl⟩
        exact ⟨(A x, B y), rfl⟩
      · rintro ⟨⟨x,y⟩, rfl⟩
        exact ⟨(A.symm x, B.symm y), by simp [F]⟩
    rw [hr, Submodule.dense_iff_topologicalClosure_eq_top]
    exact dense_pure
  obtain ⟨T,hT,hu⟩ := hilbertTensor_product_unique (id : H → H) (id : K → K) F
    (by simp) (by simp) hd (fun p q ↦ by simp [F, ProductL2.inner_pure])
  refine ⟨T, fun x y ↦ ?_, fun T' hT' ↦ ?_⟩
  · exact (hT (i x, j y)).trans (congrArg₂ ProductL2.pure (hA x) (hB y))
  · apply hu
    rintro ⟨x,y⟩
    obtain ⟨x,rfl⟩ := hi x
    obtain ⟨y,rfl⟩ := hj y
    exact (hT' x y).trans (congrArg₂ ProductL2.pure (hA x).symm (hB y).symm)

/-- Composition of the physical reflection quotients for independent massive Euclidean fields,
on every pair of square-integrable preparations, in the original spatial-test plane laws. -/
theorem massive_conditioning_tensor :
    ∃! T : Completion (K₁ ⊗[ℂ] K₂) ≃ₗᵢ[ℂ] Lp ℂ 2 (Measure.prod M₁ M₂),
      ∀ X Y, T (ProductL2.tensorPure (Submodule.Quotient.mk X) (Submodule.Quotient.mk Y)) =
        ProductL2.pure (conditionedMassivePreparation d h₁.le hm₁ X)
          (conditionedMassivePreparation e h₂.le hm₂ Y) :=
  tensor_of_quotient_labels M₁ M₂ (H := K₁) (K := K₂) Submodule.Quotient.mk
    Submodule.Quotient.mk (Submodule.Quotient.mk_surjective _) (Submodule.Quotient.mk_surjective _)
    (conditionedMassivePreparation d h₁.le hm₁) (conditionedMassivePreparation e h₂.le hm₂)
    (massive_conditioning_unitary d h₁.le hm₁).exists (massive_conditioning_unitary e h₂.le hm₂).exists

end PhysicalComposition

end DotProduct.Extension


/-! ### Position-space smears, their canonical commutator and uncertainty -/

namespace DotProduct.Extension

open MeasureTheory FourierTransform
open scoped SchwartzMap InnerProductSpace ComplexConjugate

/-- Plancherel for the paper's unitary angular-frequency Fourier transform of a real
spatial Schwartz test. The coordinate dilation exactly cancels the normalization. -/
theorem physicsFourier_plancherel {d : ℕ} (g : 𝓢(MassShell.Space d, ℝ)) :
    (∫ k, ‖physicsFourier g k‖ ^ 2) = ∫ x, ‖g x‖ ^ 2 := by
  let A : ℝ := 2 * Real.pi
  let C := A ^ (-(d : ℝ) / 2)
  let F := FeatureDensity.ofRealSchwartz g
  have hA : 0 < A := by dsimp [A]; positivity
  have hC : 0 ≤ C := (Real.rpow_pos_of_pos hA _).le
  have hf (k : MassShell.Space d) :
      ‖physicsFourier g k‖ ^ 2 = C ^ 2 * ‖𝓕 F (A⁻¹ • k)‖ ^ 2 := by
    change ‖(C : ℂ) * _‖ ^ 2 = _
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hC, mul_pow]
    rfl
  simp_rw [hf]
  rw [integral_const_mul, Measure.integral_comp_inv_smul_of_nonneg volume
    (fun k ↦ ‖𝓕 F k‖ ^ 2) hA.le, smul_eq_mul, ← mul_assoc]
  have hdim : Module.finrank ℝ (MassShell.Space d) = d := by simp [MassShell.Space]
  have hcancel : C ^ 2 * A ^ d = 1 := by
    rw [show C ^ 2 = A ^ (-(d : ℝ)) by
      dsimp [C]
      rw [sq, ← Real.rpow_add hA]
      congr 1
      ring, ← Real.rpow_natCast, ← Real.rpow_add hA, neg_add_cancel, Real.rpow_zero]
  rw [hdim,hcancel,one_mul,SchwartzMap.integral_norm_sq_fourier]
  apply integral_congr_ae
  exact ae_of_all _ fun x ↦ congrArg (fun a : ℝ ↦ a^2) (Complex.norm_real (g x))

section PlaneCCR

variable {d : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m) (g : 𝓢(MassShell.Space d, ℝ))

/-- The exact transverse one-particle label of the physical plane observation. -/
noncomputable abbrev planePositionMomentumLabel : Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  weightedPlaneFourier (planeSpatialWeight ħ m) (planeSpatialWeight_bound hħ hm) g

local notation "v" => planePositionMomentumLabel hħ hm g

theorem planePositionMomentumLabel_ae :
    ⇑v =ᵐ[volume] fun k ↦ (planeSpatialWeight ħ m k : ℂ) * physicsFourier g k :=
  weightedPlaneFourier_ae _ _ g

/-- Multiplication by the unbounded frequency is admissible for every spatial Schwartz test. -/
theorem planeDerivative_memLp :
    MemLp (fun k ↦ Complex.I * (modeDispersion m k : ℂ) * v k) 2 volume := by
  let F := physicsFourierSchwartz d g
  let D (k : MassShell.Space d) := 1 + ‖k‖^2 + m^2
  let b := planeSpatialWeight (d := d) ħ m
  have hD : D.HasTemperateGrowth :=
    ((Function.HasTemperateGrowth.const 1).add (Function.hasTemperateGrowth_norm_sq _)).add
      (Function.HasTemperateGrowth.const (m^2))
  let H := SchwartzMap.smulLeftCLM ℂ D F
  let Z := realMultiplier b (planeSpatialWeight_bound hħ hm) (H.toLp 2 volume)
  have hM : Measurable (fun k : MassShell.Space d ↦ Complex.I * (modeDispersion m k : ℂ)) :=
    measurable_const.mul (Complex.continuous_ofReal.measurable.comp (modeDispersion_measurable m))
  apply (Lp.memLp Z).mono (hM.aestronglyMeasurable.mul (Lp.aestronglyMeasurable v))
  filter_upwards [realMultiplier_apply_ae b (planeSpatialWeight_bound hħ hm) (H.toLp 2 volume),
    H.coeFn_toLp 2 volume, planePositionMomentumLabel_ae hħ hm g] with k hz hH hv
  change ‖Complex.I * (modeDispersion m k : ℂ) * v k‖ ≤ ‖Z k‖
  change Z k = _ at hz
  rw [hz,hH,hv]
  have hP : H k = D k • F k := SchwartzMap.smulLeftCLM_apply_apply hD F k
  rw [hP, norm_mul, norm_mul, Complex.norm_I, one_mul, Complex.norm_real,
    Real.norm_of_nonneg (modeDispersion_pos hm k).le, norm_mul, norm_mul, norm_smul,
    physicsFourierSchwartz_apply]
  change modeDispersion m k * (‖(b k : ℂ)‖ * ‖physicsFourier g k‖) ≤
    ‖(b k : ℂ)‖ * (‖D k‖ * ‖physicsFourier g k‖)
  rw [mul_left_comm, Real.norm_of_nonneg (by dsimp [D]; positivity)]
  gcongr
  dsimp [D,modeDispersion]
  nlinarith [Real.sq_sqrt (by positivity : 0 ≤ ‖k‖ ^ 2 + m^2),
    sq_nonneg (Real.sqrt (‖k‖ ^ 2 + m^2) - 1)]

/-- One-particle label of the time derivative, in the positive-energy convention. -/
noncomputable def planeDerivativeMomentumLabel : Lp ℂ 2 (volume : Measure (MassShell.Space d)) :=
  (planeDerivative_memLp hħ hm g).toLp _

local notation "w" => planeDerivativeMomentumLabel hħ hm g

theorem planeDerivativeMomentumLabel_ae :
    ⇑w =ᵐ[volume] fun k ↦ Complex.I * (modeDispersion m k : ℂ) * v k :=
  (planeDerivative_memLp hħ hm g).coeFn_toLp

/-- The plane field and its normal time derivative have the canonical symplectic pairing
with the norm measured on the original position-space test. -/
theorem spatial_plane_symplectic :
    inner ℂ v w - inner ℂ w v = Complex.I * (ħ : ℂ) * ((∫ x, ‖g x‖^2 : ℝ) : ℂ) := by
  rw [L2.inner_def, L2.inner_def, ← integral_sub (L2.integrable_inner v w) (L2.integrable_inner w v)]
  have hp : (fun k ↦ inner ℂ (v k) (w k) - inner ℂ (w k) (v k)) =ᵐ[volume]
      fun k ↦ (Complex.I * (ħ : ℂ)) * ((‖physicsFourier g k‖ ^ 2 : ℝ) : ℂ) := by
    filter_upwards [planePositionMomentumLabel_ae hħ hm g,planeDerivativeMomentumLabel_ae hħ hm g]
      with k hv hw
    let b := planeSpatialWeight ħ m k
    let ω := modeDispersion m k
    let z := physicsFourier g k
    have hω : 0 < ω := modeDispersion_pos hm k
    have hb : 2 * ω * b^2 = ħ := by
      dsimp [b,planeSpatialWeight]
      rw [Real.sq_sqrt (div_nonneg hħ (by linarith))]
      field_simp [hω.ne',ω]
      exact mul_comm _ _
    have hc : (2 : ℂ) * (ω : ℂ) * (b : ℂ)^2 = (ħ : ℂ) := by exact_mod_cast hb
    rw [hw,hv,RCLike.inner_apply,RCLike.inner_apply]
    change (Complex.I * (ω : ℂ) * ((b : ℂ) * z)) * conj ((b : ℂ) * z) -
      ((b : ℂ) * z) * conj (Complex.I * (ω : ℂ) * ((b : ℂ) * z)) = _
    simp only [map_mul,Complex.conj_I,Complex.conj_ofReal]
    change _ = Complex.I * (ħ : ℂ) * ((‖z‖^2 : ℝ) : ℂ)
    rw [Complex.sq_norm, ← Complex.mul_conj, ← hc]
    ring
  rw [integral_congr_ae hp,integral_const_mul,integral_complex_ofReal,physicsFourier_plancherel]

private theorem position_normSq_one (hg : ‖g.toLp 2 volume‖ = 1) : ∫ x, ‖g x‖^2 = 1 := by
  have h := real_inner_self_eq_norm_sq (g.toLp 2 volume)
  rw [hg,one_pow,L2.inner_def] at h
  refine Eq.trans (integral_congr_ae ?_) h
  filter_upwards [g.coeFn_toLp 2 volume] with x hx
  rw [hx]
  simp [sq]

/-- Canonical commutation relation on finite-particle vectors for every normalized
original real spatial Schwartz test, with its complex Hermitian Fourier profile. -/
theorem spatial_plane_ccr (hg : ‖g.toLp 2 volume‖ = 1)
    (ψ : FiniteParticleFock (volume : Measure (MassShell.Space d))) :
    contField volume v v (contField volume w w ψ) - contField volume w w (contField volume v v ψ) =
      (Complex.I * (ħ : ℂ)) • ψ := by
  have h := spatial_plane_symplectic hħ hm g
  rw [position_normSq_one g hg, Complex.ofReal_one, mul_one] at h
  exact (contField_commutator volume v v w w ψ).trans (congrArg (fun z : ℂ ↦ z • ψ) h)

/-- The Heisenberg inequality for the plane reading and its time derivative on the
intersection of their domains, normalized in physical position space. -/
theorem spatial_plane_heisenberg (hg : ‖g.toLp 2 volume‖ = 1)
    (ψ : momentumFock (volume : Measure (MassShell.Space d))) (hψ : ‖ψ‖ = 1)
    (hQ : fockFieldDom volume v ψ) (hP : fockFieldDom volume w ψ) :
    ħ / 2 ≤ ‖fockFieldOp volume v ψ hQ - inner ℂ ψ (fockFieldOp volume v ψ hQ) • ψ‖ *
      ‖fockFieldOp volume w ψ hP - inner ℂ ψ (fockFieldOp volume w ψ hP) • ψ‖ := by
  have h := spatial_plane_symplectic hħ hm g
  rw [position_normSq_one g hg, Complex.ofReal_one, mul_one] at h
  simpa only [abs_of_nonneg hħ] using
    fockField_heisenberg_uncertainty_domain volume v w h ψ hψ hQ hP

end PlaneCCR

end DotProduct.Extension


/-! ### The conditional Markov identity on plane events -/

namespace DotProduct.Extension

open MeasureTheory Set Filter
open scoped InnerProductSpace SchwartzMap ProbabilityTheory

section PlaneEvents

variable {Ω X B : Type*} [MeasurableSpace Ω] [MeasurableSpace X] [MeasurableSpace B]

private noncomputable def cutL2 {μ : Measure Ω} {s : Set Ω} (hs : MeasurableSet s)
    (v : Lp ℂ 2 μ) : Lp ℂ 2 μ :=
  ((Lp.memLp v).indicator hs).toLp _

private theorem cutL2_ae {μ : Measure Ω} {s : Set Ω} (hs : MeasurableSet s) (v : Lp ℂ 2 μ) :
    ⇑(cutL2 hs v) =ᵐ[μ] s.indicator v :=
  MemLp.coeFn_toLp _

private theorem inner_cutL2 {μ : Measure Ω} {s : Set Ω} (hs : MeasurableSet s) (v w : Lp ℂ 2 μ) :
    inner ℂ v (cutL2 hs w) = ∫ x in s, inner ℂ (v x) (w x) ∂μ := by
  rw [L2.inner_def, ← integral_indicator hs]
  apply integral_congr_ae
  filter_upwards [cutL2_ae hs w] with x hx
  rw [hx]
  by_cases h : x ∈ s <;> simp [h]

private theorem cutL2_inner {μ : Measure Ω} {s : Set Ω} (hs : MeasurableSet s) (v w : Lp ℂ 2 μ) :
    inner ℂ (cutL2 hs v) w = ∫ x in s, inner ℂ (v x) (w x) ∂μ := by
  rw [L2.inner_def, ← integral_indicator hs]
  apply integral_congr_ae
  filter_upwards [cutL2_ae hs v] with x hx
  rw [hx]
  by_cases h : x ∈ s <;> simp [h]

private noncomputable def obsPull (P : Measure Ω) (p : Ω → X) (hp : Measurable p) :
    Lp ℂ 2 (P.map p) →ₗᵢ[ℂ] Lp ℂ 2 P :=
  Lp.compMeasurePreservingₗᵢ ℂ p ⟨hp,rfl⟩

private theorem obsPull_inner (P : Measure Ω) (p : Ω → X) (hp : Measurable p)
    (v : Lp ℂ 2 (P.map p)) (Z : Lp ℂ 2 P) :
    inner ℂ (obsPull P p hp v) Z = inner ℂ v (conditionOn P p hp Z) := by
  let e := observationL2 P p hp
  have h : inner ℂ (obsPull P p hp v) Z =
      inner ℂ (e v) (condExpL2 ℂ ℂ hp.comap_le Z) := by
    have he := inner_condExpL2_eq_inner_fun (𝕜 := ℂ) hp.comap_le Z (obsPull P p hp v)
      (lpMeas.aestronglyMeasurable (e v))
    change inner ℂ (obsPull P p hp v) Z =
      inner ℂ (obsPull P p hp v) (condExpL2 ℂ ℂ hp.comap_le Z : Lp ℂ 2 P)
    simpa only [inner_conj_symm] using (congrArg (starRingEnd ℂ) he).symm
  exact h.trans (by
    change inner ℂ (e v) _ = inner ℂ v (e.symm _)
    rw [← e.inner_map_map v (e.symm _), e.apply_symm_apply])

private theorem obsPull_ae (P : Measure Ω) (p : Ω → X) (hp : Measurable p)
    (v : Lp ℂ 2 (P.map p)) : ⇑(obsPull P p hp v) =ᵐ[P] v ∘ p :=
  Lp.coeFn_compMeasurePreserving v ⟨hp,rfl⟩

private theorem obsPull_cut (P : Measure Ω) (p : Ω → X) (hp : Measurable p)
    {s : Set X} (hs : MeasurableSet s) (v : Lp ℂ 2 (P.map p)) :
    obsPull P p hp (cutL2 hs v) = cutL2 (hp hs) (obsPull P p hp v) := by
  let hmp : MeasurePreserving p P (P.map p) := ⟨hp,rfl⟩
  apply Lp.ext
  filter_upwards [obsPull_ae P p hp (cutL2 hs v), hmp.quasiMeasurePreserving.ae (cutL2_ae hs v),
    cutL2_ae (hp hs) (obsPull P p hp v), obsPull_ae P p hp v] with x h₁ h₂ h₃ h₄
  rw [h₁, h₃]
  change cutL2 hs v (p x) = _
  rw [show cutL2 hs v (p x) = _ from h₂]
  by_cases h : p x ∈ s <;> simp [h, h₄]

/-- If all observations of the boundary admit lifts to the positive field,
every boundary event agrees almost surely with a positive-field event. -/
private theorem lift_plane_event (P : Measure Ω) [IsFiniteMeasure P]
    (p : Ω → X) (hp : Measurable p) (o : Ω → B) (ho : Measurable o)
    (hlift : ∀ z : Lp ℂ 2 (P.map o), ∃ y, obsPull P p hp y = obsPull P o ho z)
    {s : Set B} (hs : MeasurableSet s) :
    ∃ t : Set X, MeasurableSet t ∧ (p ⁻¹' t : Set Ω) =ᵐ[P] o ⁻¹' s := by
  let z := indicatorConstLp (μ := P.map o) 2 hs (measure_ne_top _ _) (1 : ℂ)
  obtain ⟨y, hy⟩ := hlift z
  let t := {x : X | y x = 1}
  refine ⟨t, (Lp.stronglyMeasurable y).measurable (measurableSet_singleton 1), ?_⟩
  let hmp : MeasurePreserving o P (P.map o) := ⟨ho,rfl⟩
  have hz : ⇑z =ᵐ[P.map o] s.indicator (fun _ ↦ (1 : ℂ)) := indicatorConstLp_coeFn
  have he : y ∘ p =ᵐ[P] z ∘ o := (obsPull_ae P p hp y).symm.trans (hy ▸ obsPull_ae P o ho z)
  filter_upwards [he,hmp.quasiMeasurePreserving.ae hz] with x hx h₁
  change (y (p x) = 1) = (o x ∈ s)
  change y (p x) = z (o x) at hx
  rw [hx, show z (o x) = _ from h₁]
  by_cases h : o x ∈ s <;> simp [h]

/-- A global reflected-pair identity localizes on every plane event. The
two factors in the plane integral are the actual conditional expectations. -/
private theorem local_plane_factorization (P : Measure Ω) [IsFiniteMeasure P]
    (p : Ω → X) (hp : Measurable p) (o : Ω → B) (ho : Measurable o)
    (hlift : ∀ z : Lp ℂ 2 (P.map o), ∃ y, obsPull P p hp y = obsPull P o ho z)
    (Z : Lp ℂ 2 P) (c : Lp ℂ 2 (P.map o))
    (h : ∀ y, inner ℂ Z (obsPull P p hp y) =
      inner ℂ c (conditionOn P o ho (obsPull P p hp y))) :
    conditionOn P o ho Z = c ∧ ∀ (s : Set B) (_hs : MeasurableSet s) (y : Lp ℂ 2 (P.map p)),
      (∫ w in o ⁻¹' s, inner ℂ (Z w) (obsPull P p hp y w) ∂P) =
      ∫ b in s, inner ℂ (conditionOn P o ho Z b) (conditionOn P o ho (obsPull P p hp y) b) ∂P.map o := by
  let A := obsPull P p hp
  let B₀ := obsPull P o ho
  have ha (y) : inner ℂ Z (A y) = inner ℂ (B₀ c) (A y) :=
    (h y).trans (obsPull_inner P o ho c _).symm
  have hc : conditionOn P o ho Z = c := by
    apply ext_inner_left ℂ
    intro z
    obtain ⟨y, hy⟩ := hlift z
    calc
      _ = inner ℂ (B₀ z) Z := (obsPull_inner P o ho z Z).symm
      _ = inner ℂ (B₀ z) (B₀ c) := by
        rw [← hy]
        exact (inner_conj_symm _ _).symm.trans
          ((congrArg (starRingEnd ℂ) (ha y)).trans (inner_conj_symm _ _))
      _ = _ := B₀.inner_map_map _ _
  refine ⟨hc, fun s hs y ↦ ?_⟩
  obtain ⟨t, ht, he⟩ := lift_plane_event P p hp o ho hlift hs
  let u := cutL2 ht y
  have hu : A u = cutL2 (ho hs) (A y) := by
    refine (obsPull_cut P p hp ht y).trans ?_
    apply Lp.ext
    refine (cutL2_ae (hp ht) (A y)).trans (EventuallyEq.trans ?_ (cutL2_ae (ho hs) (A y)).symm)
    filter_upwards [he] with w hw
    by_cases hz : w ∈ p ⁻¹' t
    · simp [hz, (eq_iff_iff.mp hw).mp hz]
    · have hw' : w ∉ o ⁻¹' s := fun h ↦ hz ((eq_iff_iff.mp hw).mpr h)
      rw [indicator_of_notMem hz, indicator_of_notMem hw']
  calc
    _ = inner ℂ Z (A u) := by rw [hu, inner_cutL2]
    _ = inner ℂ (B₀ c) (A u) := ha u
    _ = inner ℂ (B₀ (cutL2 hs c)) (A y) := by
      rw [hu, show B₀ (cutL2 hs c) = _ from obsPull_cut P o ho hs c,
        inner_cutL2, cutL2_inner]
    _ = inner ℂ (cutL2 hs c) (conditionOn P o ho (A y)) := obsPull_inner P o ho _ _
    _ = _ := by rw [cutL2_inner, hc]

private theorem conditionOn_event_ae (P : Measure Ω) [IsFiniteMeasure P] (o : Ω → B) (ho : Measurable o)
    {t : Set Ω} (ht : MeasurableSet t) :
    (fun w ↦ conditionOn P o ho (indicatorConstLp 2 ht (measure_ne_top P t) (1 : ℂ)) (o w)) =ᵐ[P]
      fun w ↦ (((P⟦t | MeasurableSpace.comap o inferInstance⟧) w : ℝ) : ℂ) := by
  let v := indicatorConstLp 2 ht (measure_ne_top P t) (1 : ℂ)
  let D := observationL2 P o ho
  have hD : D (conditionOn P o ho v) = condExpL2 ℂ ℂ ho.comap_le v := D.apply_symm_apply _
  have he := (observationL2_ae P o ho (conditionOn P o ho v)).symm
  have he' : (fun w ↦ conditionOn P o ho v (o w)) =ᵐ[P]
      (condExpL2 ℂ ℂ ho.comap_le v : Ω → ℂ) := by
    change _ =ᵐ[P] ⇑((D (conditionOn P o ho v)).1) at he
    rwa [hD] at he
  have hg := condExpL2_indicator_ae_eq_smul ℂ ho.comap_le ht (measure_ne_top P t) (1 : ℂ)
  have hr := (memLp_indicator_const (μ := P) 2 ht (1 : ℝ) (Or.inr (measure_ne_top P t))).condExpL2_ae_eq_condExp
    (𝕜 := ℝ) ho.comap_le
  filter_upwards [he',hg,hr] with w hw hg₁ hr₁
  rw [hw, hg₁]
  change (condExpL2 ℝ ℝ ho.comap_le (indicatorConstLp 2 ht (measure_ne_top P t) (1 : ℝ)) : Ω → ℝ) w = _ at hr₁
  rw [hr₁,Complex.real_smul,mul_one]

/-- Testing the localized mixed moment on indicators gives the ordinary conditional
probability multiplication formula, almost surely. -/
private theorem conditional_events_of_local (P : Measure Ω) [IsFiniteMeasure P]
    (o : Ω → B) (ho : Measurable o) {u v : Set Ω} (hu : MeasurableSet u) (hv : MeasurableSet v)
    (h : ∀ (s : Set B), MeasurableSet s →
      (∫ w in o ⁻¹' s, inner ℂ (indicatorConstLp 2 hu (measure_ne_top P u) (1 : ℂ) w)
        (indicatorConstLp 2 hv (measure_ne_top P v) (1 : ℂ) w) ∂P) =
      ∫ b in s, inner ℂ (conditionOn P o ho (indicatorConstLp 2 hu (measure_ne_top P u) (1 : ℂ)) b)
        (conditionOn P o ho (indicatorConstLp 2 hv (measure_ne_top P v) (1 : ℂ)) b) ∂P.map o) :
    P⟦u ∩ v | MeasurableSpace.comap o inferInstance⟧ =ᵐ[P] fun w ↦
      ((P⟦u | MeasurableSpace.comap o inferInstance⟧) w) * ((P⟦v | MeasurableSpace.comap o inferInstance⟧) w) := by
  let i (a : Set Ω) := a.indicator (fun _ ↦ (1 : ℝ))
  let prob (a : Set Ω) := P⟦a | MeasurableSpace.comap o inferInstance⟧
  let U := indicatorConstLp 2 hu (measure_ne_top P u) (1 : ℂ)
  let V := indicatorConstLp 2 hv (measure_ne_top P v) (1 : ℂ)
  let C := conditionOn P o ho
  have hLp (a : Set Ω) (ha : MeasurableSet a) : MemLp (prob a) 2 P :=
    (memLp_indicator_const 2 ha (1 : ℝ) (Or.inr (measure_ne_top P a))).condExp (by norm_num)
  have hI : Integrable (i (u ∩ v)) P := (integrable_const (1 : ℝ)).indicator (hu.inter hv)
  have hmul := (hLp u hu).integrable_mul (hLp v hv)
  apply EventuallyEq.symm
  refine ae_eq_condExp_of_forall_setIntegral_eq ho.comap_le hI
    (fun _ _ _ ↦ hmul.integrableOn) ?_
    (stronglyMeasurable_condExp.mul stronglyMeasurable_condExp).aestronglyMeasurable
  rintro _ ⟨s,hs,rfl⟩ _
  have hh := h s hs
  have hw : AEStronglyMeasurable (fun b ↦ inner ℂ ((C U) b) ((C V) b)) (P.map o) :=
    (Lp.aestronglyMeasurable _).inner (Lp.aestronglyMeasurable _)
  rw [setIntegral_map hs hw ho.aemeasurable] at hh
  have hl : (fun w ↦ inner ℂ (U w) (V w)) =ᵐ[P] fun w ↦ (i (u ∩ v) w : ℂ) := by
    have hU : ⇑U =ᵐ[P] u.indicator (fun _ ↦ (1 : ℂ)) := indicatorConstLp_coeFn
    have hV : ⇑V =ᵐ[P] v.indicator (fun _ ↦ (1 : ℂ)) := indicatorConstLp_coeFn
    filter_upwards [hU,hV] with w hw₁ hw₂
    rw [hw₁,hw₂]
    by_cases h₁ : w ∈ u <;> by_cases h₂ : w ∈ v <;> simp [i,h₁,h₂]
  have hr : (fun w ↦ inner ℂ ((C U) (o w)) ((C V) (o w))) =ᵐ[P] fun w ↦ ((prob u w * prob v w : ℝ) : ℂ) := by
    filter_upwards [conditionOn_event_ae P o ho hu, conditionOn_event_ae P o ho hv] with w hu₁ hv₁
    change C U (o w) = _ at hu₁
    change C V (o w) = _ at hv₁
    rw [hu₁,hv₁,RCLike.inner_apply,Complex.conj_ofReal,Complex.ofReal_mul,mul_comm]
  change (∫ w in o ⁻¹' s, inner ℂ (U w) (V w) ∂P) =
    ∫ w in o ⁻¹' s, inner ℂ ((C U) (o w)) ((C V) (o w)) ∂P at hh
  rw [integral_congr_ae (ae_restrict_of_ae hl),integral_congr_ae (ae_restrict_of_ae hr),
    integral_complex_ofReal,integral_complex_ofReal] at hh
  exact Complex.ofReal_injective hh.symm

end PlaneEvents


instance massiveBasis_countable (d : ℕ) : Countable (massiveEuclideanBasisSet d) := by
  let b := massiveEuclideanBasis d
  let : Fact ((2 : ENNReal) ≠ ⊤) := ⟨by norm_num⟩
  have h : Pairwise (fun i j : massiveEuclideanBasisSet d ↦
      Disjoint (Metric.ball (b i) (1 / 2)) (Metric.ball (b j) (1 / 2))) := by
    intro i j hij
    apply Metric.ball_disjoint_ball
    rw [dist_eq_norm]
    have hsq := norm_sub_sq_real (b i) (b j)
    rw [b.orthonormal.1 i,b.orthonormal.1 j,b.orthonormal.2 hij] at hsq
    nlinarith [norm_nonneg (b i - b j)]
  exact h.countable_of_isOpen_disjoint (fun _ ↦ Metric.isOpen_ball)
    (fun _ ↦ Metric.nonempty_ball.mpr (by norm_num))

section MassiveMarkov

variable (d : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m)

local notation "P" => standardGaussianProduct (massiveEuclideanBasisSet (d+1))
local notation "Φ" => pointwiseGaussian (massiveEuclideanBasis (d+1))
local notation "hΦ" => pointwiseGaussian_measurable (massiveEuclideanBasis (d+1))
local notation "hc" => pointwiseGaussian_char (massiveEuclideanBasis (d+1))
local notation "J" => positiveBulkLabel d (le_of_lt hħ) hm
local notation "A" => reflectedBulkLabel d (le_of_lt hħ) hm
local notation "L" => ContinuousLinearMap.toLinearMap (physicalSpatialLabel d (le_of_lt hħ) hm)
local notation "obs" => readingCoordinates Φ L
local notation "ho" => measurable_readingCoordinates Φ hΦ L
local notation "pos" => readingPullback P Φ hΦ J
local notation "neg" => reflectedPullback P Φ hΦ hc J A (reflectedBulkLabel_norm d (le_of_lt hħ) hm)

/-- Conditional independence across the Euclidean plane, tested on every plane event:
the conditional mixed moment of arbitrary opposite-side observations factors into the
two actual conditional expectations. This includes indicators of all measurable
half-space events in the original test-coordinate laws. -/
theorem massive_plane_event_factorization
    (X Y : Lp ℂ 2 (massivePreparationLaw d hħ.le hm))
    (s : Set (𝓢(MassShell.Space d, ℝ) → ℝ)) (hs : MeasurableSet s) :
    (∫ w in obs ⁻¹' s, inner ℂ (neg X w) (pos Y w) ∂P) =
      ∫ b in s, inner ℂ (conditionOn P obs ho (neg X) b) (conditionOn P obs ho (pos Y) b)
        ∂massiveSpatialLaw d hħ.le hm := by
  let C := conditionedMassivePreparation d hħ.le hm
  have hlift : ∀ z : Lp ℂ 2 ((P).map obs), ∃ y, pos y = readingPullback P Φ hΦ L z := by
    apply readingPullback_lifts P Φ hΦ hc J L
    rintro _ ⟨g,rfl⟩
    exact physicalPlane_le_positive hħ.le hm
      ((physicalSpatialLabel d hħ.le hm).toLinearMap.range.le_topologicalClosure ⟨g,rfl⟩)
  have hw (y) : inner ℂ (neg X) (pos y) = inner ℂ (C X) (conditionOn P obs ho (pos y)) :=
    massive_reflection_eq_conditioning d hħ hm X y
  exact (local_plane_factorization P _ (measurable_readingCoordinates Φ hΦ J) obs ho
    hlift (neg X) (C X) hw).2 s hs Y

set_option maxHeartbeats 2000000 in
/-- The conditional probability of any two opposite-side events is the product
of their conditional probabilities given the original spatial plane readings. -/
theorem massive_plane_conditional_events
    (u v : Set (positiveSchwartz d → ℝ)) (hu : MeasurableSet u) (hv : MeasurableSet v) :
    P⟦readingCoordinates Φ A ⁻¹' u ∩ readingCoordinates Φ J ⁻¹' v |
      MeasurableSpace.comap obs inferInstance⟧ =ᵐ[P] fun w ↦
        (P⟦readingCoordinates Φ A ⁻¹' u | MeasurableSpace.comap obs inferInstance⟧) w *
        (P⟦readingCoordinates Φ J ⁻¹' v | MeasurableSpace.comap obs inferInstance⟧) w := by
  let Q := massivePreparationLaw d hħ.le hm
  let X := indicatorConstLp (μ := Q) 2 hu (measure_ne_top Q u) (1 : ℂ)
  let Y := indicatorConstLp (μ := Q) 2 hv (measure_ne_top Q v) (1 : ℂ)
  let hn := measurable_readingCoordinates Φ hΦ A
  let hp := measurable_readingCoordinates Φ hΦ J
  have hX : neg X = indicatorConstLp 2 (hn hu) (measure_ne_top P _) (1 : ℂ) := by
    let hmp : MeasurePreserving (readingCoordinates Φ A) P Q :=
      ⟨hn,gaussian_readingLaw_eq_of_norm P Φ hΦ hc J A (reflectedBulkLabel_norm d hħ.le hm)⟩
    exact Lp.indicatorConstLp_compMeasurePreserving hu (measure_ne_top Q u) 1 hmp
  have hY : pos Y = indicatorConstLp 2 (hp hv) (measure_ne_top P _) (1 : ℂ) :=
    Lp.indicatorConstLp_compMeasurePreserving hv (measure_ne_top Q v) 1
      (show MeasurePreserving (readingCoordinates Φ J) P Q from ⟨hp,rfl⟩)
  refine conditional_events_of_local P obs ho (hn hu) (hp hv) (fun s hs ↦ ?_)
  rw [← hX, ← hY]
  exact massive_plane_event_factorization d hħ hm X Y s hs

/-- The two σ-algebras generated by all original opposite-half-space readings are
conditionally independent given the σ-algebra of the spatial plane readings. -/
theorem massive_plane_condIndep :
    ProbabilityTheory.CondIndep (MeasurableSpace.comap obs inferInstance)
      (MeasurableSpace.comap (readingCoordinates Φ A) inferInstance)
      (MeasurableSpace.comap (readingCoordinates Φ J) inferInstance) (ho).comap_le P := by
  apply (ProbabilityTheory.condIndep_iff _ _ _ (ho).comap_le
    (measurable_readingCoordinates Φ hΦ A).comap_le (measurable_readingCoordinates Φ hΦ J).comap_le P).2
  rintro _ _ ⟨u,hu,rfl⟩ ⟨v,hv,rfl⟩
  exact massive_plane_conditional_events d hħ hm u v hu hv

end MassiveMarkov

