namespace DotProduct.Extension
open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal NNReal Topology InnerProductSpace SchwartzMap

private theorem standardGaussian_moment_growth (n : ℕ) :
    (eLpNorm id (n : ℝ≥0∞) (gaussianReal 0 1)).toReal ^ n ≤ 2 * Real.exp (1/2) * n.factorial := by
  let g : Measure ℝ := gaussianReal 0 1
  have hI (t : ℝ) : Integrable (fun x : ℝ ↦ Real.exp (t * x)) g :=
    integrable_exp_mul_gaussianReal _
  have hM (t : ℝ) : (∫ x, Real.exp (t*x) ∂g) = Real.exp (t^2 / 2) := by
    simpa [g,mgf] using congrFun (mgf_id_gaussianReal (μ := 0) (v := 1)) t
  rcases eq_or_ne n 0 with rfl | hn
  · simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, mul_one]
    linarith [Real.add_one_le_exp (1/2)]
  have hg : MemLp id (n : ℝ≥0∞) g := memLp_id_gaussianReal' _ (by simp)
  have heq : (eLpNorm id (n : ℝ≥0∞) g).toReal ^ n = ∫ x, ‖x‖ ^ n ∂g := by
    rw [toReal_eLpNorm, lpNorm_eq_integral_norm_rpow_toReal (by exact_mod_cast hn) (by simp)
        measurable_id.aestronglyMeasurable]
    simp only [ENNReal.toReal_natCast, Real.rpow_natCast, id_eq]
    exact Real.rpow_inv_natCast_pow (integral_nonneg (fun _ ↦ by positivity)) hn
  change (eLpNorm id (n : ℝ≥0∞) g).toReal ^ n ≤ _
  rw [heq]
  have hsum := (hI 1).add (hI (-1))
  calc
    (∫ x, ‖x‖ ^ n ∂g) ≤ ∫ x, (Real.exp (1*x) + Real.exp (-1*x)) * n.factorial ∂g := by
      apply integral_mono (hg.integrable_norm_pow hn) (hsum.mul_const _)
      intro x
      have hpow := (div_le_iff₀ (by positivity : (0 : ℝ) < n.factorial)).mp
        (Real.pow_div_factorial_le_exp ‖x‖ (norm_nonneg x) n)
      have hle : Real.exp ‖x‖ ≤ Real.exp (1*x) + Real.exp (-1*x) := by
        cases le_total 0 x with
        | inl hx => simp only [Real.norm_eq_abs, abs_of_nonneg hx, one_mul]; exact le_add_of_nonneg_right (Real.exp_pos _).le
        | inr hx => simp only [Real.norm_eq_abs, abs_of_nonpos hx, neg_one_mul]; exact le_add_of_nonneg_left (Real.exp_pos _).le
      exact hpow.trans (mul_le_mul_of_nonneg_right hle (by positivity))
    _ = _ := by
      rw [integral_mul_const, integral_add (hI 1) (hI (-1)), hM, hM]
      congr 1
      norm_num
      ring

/-- A single factorial growth estimate for all orders, using the same continuous
Schwartz seminorm in every argument. -/
theorem massiveSchwingerMoment_factorial {D n : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (f : Fin n → 𝓢(MassShell.Space D, ℝ)) :
    ‖massiveSchwingerMoment hħ hm f‖ ≤
      2 * Real.exp (1/2) * n.factorial * ∏ i, ‖massiveEuclideanLabel D ħ m hħ hm (f i)‖ :=
  (massiveSchwingerMoment_regular hħ hm f).2.trans (mul_le_mul_of_nonneg_right
    (standardGaussian_moment_growth n) (Finset.prod_nonneg fun _ _ ↦ norm_nonneg _))

end DotProduct.Extension
