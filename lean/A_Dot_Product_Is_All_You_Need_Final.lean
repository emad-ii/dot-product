/-- Measured reconstruction on the same Euclidean law, positive-side quotient, plane law and momentum Fock
    space. Spatial dimension is d = n+1 and spacetime dimension is D = d+1. -/
structure PaperOneDetermination.{u} (n : ℕ) {ħ m : ℝ} (hħ : 0 < ħ) (hm : 0 < m) : Prop where
  readingLaw : ∀ P : Measure (𝓢(MassShell.Space ((n+1)+1), ℝ) → ℝ),
    MassiveReadingLaw ħ m P ↔ P = massiveEuclideanLaw ((n+1)+1) ħ m hħ.le hm
  temperedRealization :
    letI := cylMeasurableSpace (EuclidD n)
    (gffMeasure n ħ m hħ hm).map
      (fun φ : RealTemperedDistribution (EuclidD n) ↦ fun f : 𝓢(EuclidD n, ℝ) ↦ φ f) =
        massiveEuclideanLaw ((n+1)+1) ħ m hħ.le hm
  freeBoxLimit : ∀ {k : ℕ} {a : ℕ → ℝ} {M : ℕ → ℕ}, (∀ j, 0 < a j) →
    Tendsto a atTop (𝓝 0) → Tendsto (fun j ↦ (M j : ℝ) * a j) atTop atTop →
    ∀ f : Fin k → 𝓢(MassShell.Space ((n+1)+1), ℝ),
      Tendsto (fun j ↦ freeBoxObservationLaw (M j) (a j) hħ hm f) atTop
        (𝓝 (continuumObservationLaw hħ.le hm f))
  boxLimitUnique : ∀ {a : ℕ → ℝ} {M : ℕ → ℕ}, (∀ j, 0 < a j) →
    Tendsto a atTop (𝓝 0) → Tendsto (fun j ↦ (M j : ℝ) * a j) atTop atTop →
    ∀ (Q : Measure (𝓢(MassShell.Space ((n+1)+1), ℝ) → ℝ)) [IsProbabilityMeasure Q],
    (∀ {k : ℕ} (f : Fin k → 𝓢(MassShell.Space ((n+1)+1), ℝ)),
      Tendsto (fun j ↦ freeBoxObservationLaw (M j) (a j) hħ hm f) atTop
        (𝓝 (jointObservationLaw Q (fun i x ↦ x (f i)) (fun i ↦ measurable_pi_apply (f i))))) →
    Q = massiveEuclideanLaw ((n+1)+1) ħ m hħ.le hm
  finiteDisintegration : ∀ (M : ℕ) {a : ℝ}, 0 < a →
    let hD : 0 < ((n+1)+1) := Nat.zero_lt_succ _
    freeBoxSplitGibbsLaw (M := M) hD a ħ m = (freeBoxPlaneLaw hD a ħ m).compProd
      ((freeBoxHalfKernel hD a ħ m).prod (freeBoxHalfKernel hD a ħ m))
  markov :
    let Φ := pointwiseGaussian (massiveEuclideanBasis ((n+1)+1))
    let L := (physicalSpatialLabel (n+1) hħ.le hm).toLinearMap
    let J := positiveBulkLabel (n+1) hħ.le hm
    let A := reflectedBulkLabel (n+1) hħ.le hm
    ProbabilityTheory.CondIndep (MeasurableSpace.comap (readingCoordinates Φ L) inferInstance)
      (MeasurableSpace.comap (readingCoordinates Φ A) inferInstance)
      (MeasurableSpace.comap (readingCoordinates Φ J) inferInstance)
      (measurable_readingCoordinates Φ (pointwiseGaussian_measurable _) L).comap_le
      (standardGaussianProduct (massiveEuclideanBasisSet ((n+1)+1)))
  feature : ∀ f : positiveSchwartz (n+1),
    ⇑(physicalFeatureL (n+1) hħ.le hm f) =ᵐ[volume] featureMap ħ m (physicalTrace f.1)
  reflection : ∀ X Y : Lp ℂ 2 (massivePreparationLaw (n+1) hħ.le hm),
    massiveReflectionPair (n+1) hħ.le hm X Y = inner ℂ
      (conditionedMassivePreparation (n+1) hħ.le hm X) (conditionedMassivePreparation (n+1) hħ.le hm Y)
  conditioning : ∃! U : massivePreparationClass (n+1) hħ.le hm ≃ₗᵢ[ℂ]
      Lp ℂ 2 (massiveSpatialLaw (n+1) hħ.le hm),
    ∀ X, U (Submodule.Quotient.mk X) = conditionedMassivePreparation (n+1) hħ.le hm X
  fock : ∃! U : Lp ℂ 2 (massiveSpatialLaw (n+1) hħ.le hm) ≃ₗᵢ[ℂ]
      momentumFock (volume : Measure (MassShell.Space (n+1))),
    ∀ f, U (conditionedMassivePreparation (n+1) hħ.le hm (massiveWickPreparation (n+1) hħ hm f)) =
      coherentVec volume (Complex.I • physicalFeatureL (n+1) hħ.le hm f)
  evolution :
    let T := massiveSpatialComplexTime (n+1) hħ hm
    IsMeasuredShiftContinuation (n+1) hħ hm T ∧
    (∀ t : ℝ, T (Complex.I*t) = (massiveSpatialUnitary (n+1) hħ hm t).toLinearIsometry.toContinuousLinearMap) ∧
    ∀ S, IsMeasuredShiftContinuation (n+1) hħ hm S → EqOn S T {z | 0 ≤ z.re}
  unitaryBoundary : ∀ (t : ℝ) (ψ : Lp ℂ 2 (massiveSpatialLaw (n+1) hħ.le hm)),
    Tendsto (fun z ↦ massiveSpatialComplexTime (n+1) hħ hm z ψ)
      (𝓝[{z : ℂ | 0 ≤ z.re}] (Complex.I*t)) (𝓝 (massiveSpatialUnitary (n+1) hħ hm t ψ))
  planeDerivative : ∀ (h : 𝓢(MassShell.Space (n+1), ℝ))
    (ψ : FiniteParticleFock (volume : Measure (MassShell.Space (n+1)))),
    let J := massiveSpatialFockUnitary (n+1) hħ hm
    let U := fockUnitary (volume : Measure (MassShell.Space (n+1))) (modeDispersion m) (modeDispersion_measurable m)
    let w := planeDerivativeMomentumLabel hħ.le hm h
    HasDerivAt (fun t : ℝ ↦ J.symm (U (-t)
      (J (planeCoordinateOnFinite (n+1) hħ hm h (planeTimeUnitaryFin m t ψ)))))
      (J.symm (contField volume w w ψ).1) 0
  composition : ∀ (e : ℕ) {ħ' m' : ℝ} (hħ' : 0 < ħ') (hm' : 0 < m'),
    PaperOneComposition (n+1) (e+1) hħ hm hħ' hm'
  euclideanInvariance : ∀ (R : MassShell.Space ((n+1)+1) ≃ₗᵢ[ℝ] MassShell.Space ((n+1)+1))
    (a : MassShell.Space ((n+1)+1)), let P := massiveEuclideanLaw ((n+1)+1) ħ m hħ.le hm
    P.map (fun x f ↦ x (euclideanAffineSchwartz R a f)) = P
  schwingerBounds : ∀ {k : ℕ} (f : Fin k → 𝓢(MassShell.Space ((n+1)+1), ℝ)),
    let D := ((n+1)+1)
    Integrable (fun x ↦ ∏ i, x (f i)) (massiveEuclideanLaw D ħ m hħ.le hm) ∧
    ‖massiveSchwingerMoment hħ.le hm f‖ ≤
      (eLpNorm id (k : ENNReal) (ProbabilityTheory.gaussianReal 0 1)).toReal ^ k *
        ∏ i, ‖massiveEuclideanLabel D ħ m hħ.le hm (f i)‖
  clustering :
    let E := MassShell.Space ((n+1)+1)
    let Q := massiveEuclideanLaw ((n+1)+1) ħ m hħ.le hm
    let T := euclideanAffineSchwartz (LinearIsometryEquiv.refl ℝ E)
    ∀ X Y : Lp ℂ 2 Q, Tendsto (fun a : E ↦ ∫ w, star (X w) * Y (fun f ↦ w (T a f)) ∂Q)
      (cocompact E) (𝓝 (star (∫ w, X w ∂Q) * ∫ w, Y w ∂Q))
  rotationToBoost : ∀ (u : MassShell.Space (n+1)) (hu : ‖u‖ = 1) (η : ℝ) (p : Spacetime (n+1)),
    complexNormalRotation u (η*Complex.I) (p.1*Complex.I) p.2 =
      (((directionalBoostLorentz u hu η p).1 : ℂ)*Complex.I,
       fun j ↦ ((directionalBoostLorentz u hu η p).2 j : ℂ))
  fieldCovariance : ∀ (g : PoincareGroup (n+1)) (f : 𝓢(Spacetime (n+1), ℂ))
    (ψ : FiniteParticleFock (volume : Measure (MassShell.Space (n+1)))),
    secondQuantizeFin volume (poincareUnitary n m hm g) (unitaryWightmanField (n+1) ħ m hħ.le hm f ψ) =
    unitaryWightmanField (n+1) ħ m hħ.le hm (poincareSchwartz g f)
      (secondQuantizeFin volume (poincareUnitary n m hm g) ψ)
  strongContinuity : ∀ ψ : momentumFock (volume : Measure (MassShell.Space (n+1))),
    Continuous (fun g : PoincareGroup (n+1) ↦ fockPoincare n m hm g ψ)
  spectrum : ∀ ψ : momentumFock (volume : Measure (MassShell.Space (n+1))),
    let ν := fockTranslationMeasure m ψ
    ν univ = ENNReal.ofReal (‖ψ‖^2) ∧ ν.support ⊆ {p | ‖p.2‖ ≤ p.1 ∧ (p.1 = 0 ∨ m ≤ p.1)} ∧
    ∀ a : Spacetime (n+1), inner ℂ ψ (fockTranslation (n+1) m a ψ) =
      ∫ p, Complex.exp (Complex.I * ((a.1*p.1 - inner ℝ a.2 p.2 : ℝ) : ℂ)) ∂ν
  spacelikeTwoPoint : ∀ (f g : 𝓢(Spacetime (n+1), ℝ)), HasCompactSupport f → HasCompactSupport g →
    (∀ p ∈ tsupport f, ∀ q ∈ tsupport g, |p.1-q.1| < ‖p.2-q.2‖) →
    let W := fun h ↦ unitaryWightmanField (n+1) ħ m hħ.le hm (FeatureDensity.ofRealSchwartz h)
    inner ℂ (fockVacuum volume) (W f (W g (fockVacuumFin volume))).1 =
      ∫ r : Spacetime (n+1) × Spacetime (n+1), (f r.1 : ℂ) * (g r.2 : ℂ) *
        physicalHeatKernel ((n+1)+1) ħ m (‖r.1.2-r.2.2‖^2 - (r.1.1-r.2.1)^2 : ℝ)
  cyclicity : (Submodule.span ℂ (Set.range fun l : List (𝓢(Spacetime (n+1), ℝ)) ↦
    (l.foldl (fun ψ f ↦ unitaryWightmanField (n+1) ħ m hħ.le hm (FeatureDensity.ofRealSchwartz f) ψ)
      (fockVacuumFin (volume : Measure (MassShell.Space (n+1))))).1)).topologicalClosure = ⊤
  table : PaperOneTable.{u} n hħ hm

set_option synthInstance.maxHeartbeats 150000 in
