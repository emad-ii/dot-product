open MeasureTheory ProbabilityTheory Set
open scoped SchwartzMap ENNReal NNReal

/-- Every Schwinger moment of the measured field is jointly continuous and
multilinear in its original Schwartz arguments. -/
theorem massiveSchwingerMoment_continuousMultilinear {D : ℕ} {ħ m : ℝ}
    (hħ : 0 ≤ ħ) (hm : 0 < m) (n : ℕ) :
    ∃ S : ContinuousMultilinearMap ℝ (fun _ : Fin n ↦ 𝓢(MassShell.Space D, ℝ)) ℝ,
      ∀ f, S f = massiveSchwingerMoment hħ hm f := by
  classical
  let E := Lp ℂ 2 (volume : Measure (MassShell.Space D))
  let b := massiveEuclideanBasis D
  let P := standardGaussianProduct (massiveEuclideanBasisSet D)
  let J := massiveEuclideanLabel D ħ m hħ hm
  let X (w : massiveEuclideanBasisSet D → ℝ) : MultilinearMap ℝ (fun _ : Fin n ↦ E) ℝ :=
    (MultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compLinearMap (fun _ ↦ pointwiseGaussian b w)
  have hb (a : Fin n → E) : Integrable (fun w ↦ X w a) P ∧
      ‖∫ w, X w a ∂P‖ ≤ (eLpNorm id (n : ℝ≥0∞) (gaussianReal 0 1)).toReal ^ n * ∏ i, ‖a i‖ :=
    gaussian_mixed_moment_bound (fun i w ↦ pointwiseGaussian b w (a i)) (fun i ↦ ‖a i‖₊)
      (fun i ↦ pointwiseGaussian_measurable b (a i)) (fun i ↦ pointwiseGaussian_map b (a i))
  let A : MultilinearMap ℝ (fun _ : Fin n ↦ E) ℝ :=
    { toFun a := ∫ w, X w a ∂P
      map_update_add' a i x y := by
        simp only [MultilinearMap.map_update_add]
        exact integral_add (hb _).1 (hb _).1
      map_update_smul' a i c x := by
        simp only [MultilinearMap.map_update_smul, integral_smul] }
  let B := A.mkContinuous _ (fun a ↦ (hb a).2)
  refine ⟨B.compContinuousLinearMap (fun _ ↦ J),fun f ↦ ?_⟩
  rw [massiveSchwingerMoment, massiveEuclideanLaw, integral_map
    (massiveEuclideanReading_measurable hħ hm).aemeasurable
    (Finset.univ.measurable_prod (fun i _ ↦ measurable_pi_apply (f i))).aestronglyMeasurable]
  rfl

/-- Simultaneous pullback by any Euclidean translation, rotation or reflection
preserves the measured Schwinger functions. -/
theorem massiveSchwingerMoment_affine_invariant {D n : ℕ} {ħ m : ℝ} (hħ : 0 ≤ ħ) (hm : 0 < m)
    (R : MassShell.Space D ≃ₗᵢ[ℝ] MassShell.Space D) (a : MassShell.Space D)
    (f : Fin n → 𝓢(MassShell.Space D, ℝ)) :
    massiveSchwingerMoment hħ hm (fun i ↦ euclideanAffineSchwartz R a (f i)) =
      massiveSchwingerMoment hħ hm f := by
  let T (x : 𝓢(MassShell.Space D, ℝ) → ℝ) (g : 𝓢(MassShell.Space D, ℝ)) := x (euclideanAffineSchwartz R a g)
  have hT : Measurable T := Measurable.of_eval fun g ↦ measurable_pi_apply _
  have hP := massiveEuclideanLaw_affine_invariant hħ hm R a
  unfold massiveSchwingerMoment
  conv_rhs => rw [← hP]
  have hF : Measurable (fun x : 𝓢(MassShell.Space D, ℝ) → ℝ ↦ ∏ i, x (f i)) :=
    Finset.univ.measurable_prod (fun i _ ↦ measurable_pi_apply (f i))
  exact (integral_map hT.aemeasurable hF.aestronglyMeasurable).symm

end DotProduct.Extension


namespace DotProduct.Extension
open MeasureTheory Filter Set
open scoped InnerProductSpace Topology SchwartzMap

/-- The transverse mass-shell weight is a mixture of one-dimensional Gaussian heat
kernels. This identity includes the angular Fourier factor in the normal variable. -/
theorem normalHeatSubordination {ω : ℝ} (hω : 0 < ω) (s : ℝ) :
    ((2 * Real.pi * expKernel ω s : ℝ) : ℂ) =
      ∫ r in Ioi (0:ℝ), (((Real.pi/r) ^ (1/2 : ℝ) *
        Real.exp (-(ω^2)*r - s^2/(4*r)) : ℝ) : ℂ) := by
  let F (q r : ℝ) := Complex.exp ((q : ℂ)*Complex.I*s) * (Real.exp (-(ω^2+q^2)*r) : ℂ)
  have hnorm (q r : ℝ) : ‖F q r‖ = Real.exp (-(ω^2+q^2)*r) := by
    dsimp [F]
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.exp_pos _).le, Complex.norm_exp]
    simp [Complex.mul_re, Complex.mul_im]
  have hi (q : ℝ) : IntegrableOn (F q) (Ioi (0:ℝ)) :=
    (((integrableOn_exp_mul_Ioi (neg_lt_zero.mpr (by positivity : 0 < ω^2 + q^2)) 0).ofReal (𝕜 := ℂ)).const_mul _)
  have hval (q : ℝ) : (∫ r in Ioi (0:ℝ), Real.exp (-(ω^2+q^2)*r)) = (ω^2+q^2)⁻¹ := by
    rw [integral_exp_mul_Ioi (neg_lt_zero.mpr (by positivity : 0 < ω^2 + q^2))]
    rw [mul_zero, Real.exp_zero, div_neg, neg_div, neg_neg, one_div]
  have hj : Integrable (fun p : ℝ × ℝ ↦ F p.1 p.2) (volume.prod (volume.restrict (Ioi 0))) := by
    apply (integrable_prod_iff (by apply Measurable.aestronglyMeasurable; dsimp [F]; fun_prop)).2
    refine ⟨ae_of_all _ hi, ?_⟩
    simpa only [hnorm, hval] using normalResolvent_integrable hω
  have hqr (q : ℝ) : (∫ r in Ioi (0:ℝ), F q r) =
      Complex.exp ((q:ℂ)*Complex.I*s) * (((ω^2+q^2:ℝ):ℂ)⁻¹) := by
    simp only [F, integral_const_mul, integral_complex_ofReal, hval, Complex.ofReal_inv]
  rw [Complex.ofReal_mul, ← inverseNormalKernel hω, ← integral_congr_ae (ae_of_all _ hqr),
    integral_integral_swap hj]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro r hr
  have hp : 0 < (r : ℂ).re := hr
  have hf (q : ℝ) : F q r = (Real.exp (-(ω^2)*r) : ℂ) *
      (Complex.exp (Complex.I * s * q) * Complex.exp (-(r:ℂ) * (q:ℂ)^2)) := by
    dsimp only [F]; rw [Complex.ofReal_exp, Complex.ofReal_exp, ← Complex.exp_add,
      ← Complex.exp_add, ← Complex.exp_add]; congr 1; push_cast; ring
  simp_rw [hf]
  rw [integral_const_mul, fourierIntegral_gaussian hp, ← Complex.ofReal_div,
    show (1/2 : ℂ) = ((1/2 : ℝ) : ℂ) by push_cast; rfl,
    ← Complex.ofReal_cpow (by positivity : 0 ≤ Real.pi/r)]
  push_cast
  rw [Complex.exp_sub, neg_div, Complex.exp_neg]
  simp only [div_eq_mul_inv]
  ring

private theorem heatPowers (d : ℕ) {r : ℝ} (hr : 0 < r) :
    (Real.pi/r)^(1/2:ℝ) * (Real.pi/r)^((d:ℝ)/2) =
      Real.pi^(((d+1:ℕ):ℝ)/2) * r^(-((d+1:ℕ):ℝ)/2) := by
  rw [← Real.rpow_add (div_pos Real.pi_pos hr), Real.div_rpow Real.pi_pos.le hr.le]
  rw [show (1/2:ℝ) + d/2 = ((d+1:ℕ):ℝ)/2 by push_cast; ring,
    show -((d+1:ℕ):ℝ)/2 = -(((d+1:ℕ):ℝ)/2) by ring, Real.rpow_neg hr.le, div_eq_mul_inv]

/-- Joint heat integrand in proper time and transverse momentum. -/
private noncomputable def mixedHeat {d : ℕ} (m s : ℝ) (x : MassShell.Space d)
    (r : ℝ) (k : MassShell.Space d) : ℂ :=
  (((Real.pi/r)^(1/2:ℝ) * Real.exp (-(m^2)*r - s^2/(4*r)) : ℝ) : ℂ) *
    Complex.exp (-(r:ℂ)*(‖k‖:ℂ)^2 + Complex.I * (inner ℝ x k : ℂ))

private theorem mixedHeat_norm {d : ℕ} (m s : ℝ) (x : MassShell.Space d)
    {r : ℝ} (hr : 0 < r) (k : MassShell.Space d) :
    ‖mixedHeat m s x r k‖ =
      (Real.pi/r)^(1/2:ℝ) * Real.exp (-(m^2)*r - s^2/(4*r)) * Real.exp (-r*‖k‖^2) := by
  unfold mixedHeat
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity), Complex.norm_exp]
  congr 2
  rw [← Complex.ofReal_pow, ← Complex.ofReal_neg, ← Complex.ofReal_mul]
  simp only [Complex.add_re, Complex.ofReal_re, Complex.I_mul_re, Complex.ofReal_im, neg_zero, add_zero]

private theorem mixedHeat_transverse {d : ℕ} (m s : ℝ) (x : MassShell.Space d)
    {r : ℝ} (hr : 0 < r) : (∫ k, mixedHeat m s x r k) =
      (Real.pi^(((d+1:ℕ):ℝ)/2) : ℝ) * heatKernelIntegrand (d+1) m (s^2+‖x‖^2 : ℝ) r := by
  unfold mixedHeat heatKernelIntegrand
  rw [integral_const_mul, GaussianFourier.integral_cexp_neg_mul_sq_norm_add
    (by simpa using hr : 0 < (r : ℂ).re), finrank_euclideanSpace_fin,
    show ((d:ℂ)/2) = ((d/2:ℝ):ℂ) by push_cast; rfl,
    ← Complex.ofReal_div, ← Complex.ofReal_cpow (by positivity : 0 ≤ Real.pi/r), Complex.I_sq]
  simp only [Complex.ofReal_mul, Complex.ofReal_exp]
  rw [mul_mul_mul_comm, ← Complex.exp_add, ← mul_assoc, ← Complex.ofReal_mul, ← Complex.ofReal_mul, heatPowers d hr]
  congr 2
  push_cast
  ring

private theorem mixedHeat_joint {d : ℕ} {m s : ℝ} (hm : 0 < m) (hs : 0 < s)
    (x : MassShell.Space d) :
    Integrable (fun p : ℝ × MassShell.Space d ↦ mixedHeat m s x p.1 p.2)
      ((volume.restrict (Ioi 0)).prod volume) := by
  have hM : Measurable (fun p : ℝ × MassShell.Space d ↦ mixedHeat m s x p.1 p.2) := by
    unfold mixedHeat; fun_prop
  apply (integrable_prod_iff hM.aestronglyMeasurable).2
  refine ⟨?_, ?_⟩
  · filter_upwards [ae_restrict_mem (μ := (volume : Measure ℝ)) measurableSet_Ioi] with r hr
    exact (GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
      (by simpa using hr : 0 < (r:ℂ).re) Complex.I x).const_mul _
  · apply ((heatKernel_integrableOn (d+1) hm (w := ((s^2:ℝ):ℂ))
      (by simp only [Complex.ofReal_re]; positivity)).norm.const_mul (Real.pi^(((d+1:ℕ):ℝ)/2))).congr
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with r hr
    simp_rw [mixedHeat_norm m s x hr]
    rw [integral_const_mul, GaussianFourier.integral_rexp_neg_mul_sq_norm hr,
      finrank_euclideanSpace_fin, mul_right_comm _ (Real.exp _), heatPowers d hr]
    unfold heatKernelIntegrand
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.rpow_nonneg hr.le _), Complex.norm_exp]
    have hv : -((m ^ 2 * r : ℝ) : ℂ) - ((s ^ 2 : ℝ) : ℂ) / (4 * (r:ℂ)) = ((-(m^2)*r - s^2/(4*r):ℝ):ℂ) := by push_cast; ring
    rw [hv, Complex.ofReal_re, mul_assoc]

private theorem mixedHeat_normal {d : ℕ} {m : ℝ} (hm : 0 < m) (s : ℝ)
    (x k : MassShell.Space d) : (∫ r in Ioi (0:ℝ), mixedHeat m s x r k) =
    ((2 * Real.pi * expKernel (modeDispersion m k) s : ℝ) : ℂ) *
      Complex.exp (Complex.I * (inner ℝ x k : ℂ)) := by
  rw [normalHeatSubordination (modeDispersion_pos hm k), ← integral_mul_const]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro r _
  dsimp only [mixedHeat]
  rw [modeDispersion, Real.sq_sqrt (by positivity)]
  simp only [Complex.ofReal_mul, Complex.ofReal_exp]
  rw [mul_assoc, mul_assoc, ← Complex.exp_add, ← Complex.exp_add]
  congr 2
  push_cast
  ring

/-- At positive real time the inverse transverse transform of the decaying shell
weight equals the radial Schwinger kernel in position space. -/
theorem shellKernel_positive_time {d : ℕ} {m s : ℝ} (hm : 0 < m) (hs : 0 < s)
    (x : MassShell.Space d) :
    (∫ k : MassShell.Space d, ((2 * Real.pi * expKernel (modeDispersion m k) s : ℝ) : ℂ) *
      Complex.exp (Complex.I * (inner ℝ x k : ℂ))) =
      (Real.pi^(((d+1:ℕ):ℝ)/2) : ℝ) * heatKernel (d+1) m (s^2+‖x‖^2:ℝ) := by
  simp_rw [← mixedHeat_normal hm s x]
  rw [integral_integral_swap (f := fun k r ↦ mixedHeat m s x r k) (mixedHeat_joint hm hs x).swap, heatKernel, ← integral_const_mul]
  exact setIntegral_congr_fun measurableSet_Ioi fun r hr ↦ mixedHeat_transverse m s x hr

theorem physicalShellWeight_integrable {d : ℕ} {m s : ℝ} (hm : 0 < m) (hs : 0 < s) :
    Integrable (fun k : MassShell.Space d ↦ Real.exp (-s * modeDispersion m k) /
      (2 * modeDispersion m k)) := by
  have h := ((mixedHeat_joint hm hs (0 : MassShell.Space d)).integral_prod_right).re
  have h' := h.const_mul (2 * Real.pi)⁻¹
  apply h'.congr
  filter_upwards with k
  rw [mixedHeat_normal hm, inner_zero_left, Complex.ofReal_zero, mul_zero, Complex.exp_zero,
    mul_one]
  change (2*Real.pi)⁻¹ * (2*Real.pi*expKernel _ _) = _
  rw [expKernel, abs_of_pos hs]
  rw [show -modeDispersion m k * s = -s * modeDispersion m k by ring]
  field_simp [Real.pi_ne_zero]

/-- The complex-time positive-energy kernel with Lebesgue transverse momentum and
the unitary transverse Fourier convention of the reconstructed field. -/
noncomputable def physicalShellKernel (d : ℕ) (ħ m : ℝ) (z : ℂ) (x : MassShell.Space d) : ℂ :=
  ((ħ * (transverseScale d)^2 : ℝ) : ℂ) * ∫ k : MassShell.Space d,
    Complex.exp (-z * (modeDispersion m k : ℂ)) / (2 * (modeDispersion m k : ℂ)) *
      Complex.exp (Complex.I * (inner ℝ x k : ℂ))

private theorem heatNormalization (d : ℕ) :
    (transverseScale d)^2 * Real.pi ^ (((d+1:ℕ):ℝ)/2) / (2*Real.pi) =
      (4*Real.pi)^(-((d+1:ℕ):ℝ)/2) := by
  have hp := Real.pi_pos
  have h1 : 0 < 2 * Real.pi := by positivity
  have h2 : (0:ℝ) < 2 := by norm_num
  unfold transverseScale
  rw [← Real.rpow_mul_natCast h1.le, mul_div_right_comm, ← Real.rpow_sub_one h1.ne',
    Real.mul_rpow h2.le hp.le, mul_assoc, ← Real.rpow_add hp,
    Real.mul_rpow (by norm_num : (0:ℝ) ≤ 4) hp.le,
    show (4:ℝ) = 2^(2:ℕ) by norm_num, ← Real.rpow_natCast_mul h2.le]
  congr 2 <;> push_cast <;> ring

theorem physicalShellKernel_real {d : ℕ} (ħ : ℝ) {m s : ℝ} (hm : 0 < m) (hs : 0 < s)
    (x : MassShell.Space d) : physicalShellKernel d ħ m s x =
      physicalHeatKernel (d+1) ħ m (s^2+‖x‖^2 : ℝ) := by
  have h := shellKernel_positive_time hm hs x
  have he (k : MassShell.Space d) :
      ((2 * Real.pi * expKernel (modeDispersion m k) s : ℝ) : ℂ) * Complex.exp (Complex.I * (inner ℝ x k : ℂ)) =
      ((2*Real.pi:ℝ):ℂ) * (Complex.exp (-(s:ℂ) * (modeDispersion m k : ℂ)) /
        (2 * (modeDispersion m k : ℂ)) * Complex.exp (Complex.I * (inner ℝ x k : ℂ))) := by
    unfold expKernel
    rw [abs_of_pos hs, show -modeDispersion m k * s = -s * modeDispersion m k by ring]
    push_cast; ring
  simp_rw [he, integral_const_mul] at h
  have hc : ((2*Real.pi:ℝ):ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (by positivity)
  unfold physicalShellKernel physicalHeatKernel
  rw [← heatNormalization d]
  let v := ∫ k : MassShell.Space d, Complex.exp (-(s:ℂ) * (modeDispersion m k : ℂ)) /
      (2 * (modeDispersion m k : ℂ)) * Complex.exp (Complex.I * (inner ℝ x k : ℂ))
  change _ * v = _
  have hv : v = ((Real.pi^(((d+1:ℕ):ℝ)/2):ℝ):ℂ) * heatKernel (d+1) m (s^2+‖x‖^2:ℝ) / ((2*Real.pi:ℝ):ℂ) :=
    (eq_div_iff hc).mpr ((mul_comm _ _).trans h)
  rw [hv]
  push_cast
  ring

end DotProduct.Extension


namespace DotProduct.Extension
open MeasureTheory Filter Set
open scoped InnerProductSpace Topology

private theorem physicalShellKernel_holomorphic {d : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (x : MassShell.Space d) : DifferentiableOn ℂ (fun z ↦ physicalShellKernel d ħ m z x) {z | 0 < z.re} := by
  intro z hz
  change 0 < z.re at hz
  let a := z.re/2
  have ha : 0 < a := half_pos hz
  let ω : MassShell.Space d → ℝ := modeDispersion m
  let b (k : MassShell.Space d) := Complex.exp (-(a:ℂ)*(ω k:ℂ)) / (2*(ω k:ℂ)) *
    Complex.exp (Complex.I * (inner ℝ x k : ℂ))
  have hb : Integrable b := by
    apply (physicalShellWeight_integrable (d := d) hm ha).mono' (by dsimp [b,ω,modeDispersion]; fun_prop)
    filter_upwards with k
    unfold b
    rw [norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one, norm_div, Complex.norm_exp, norm_mul,
      Complex.norm_ofNat, Complex.norm_real, Real.norm_of_nonneg (modeDispersion_pos hm k).le]
    simp [ω]
  let L (v : ℂ) := ∫ k, Complex.exp (-v * (ω k:ℂ)) * b k
  have hL := (laplace_integral_regular ω (modeDispersion_measurable m)
    (fun k ↦ (modeDispersion_pos hm k).le) b hb).1
  have hza : 0 < (z - (a:ℂ)).re := by change 0 < z.re - z.re/2; linarith
  have hd : DifferentiableAt ℂ L (z - a) :=
    (hL _ hza).differentiableAt ((isOpen_lt continuous_const Complex.continuous_re).mem_nhds hza)
  have he (v : ℂ) : physicalShellKernel d ħ m v x =
      ((ħ * (transverseScale d)^2 : ℝ) : ℂ) * L (v-a) := by
    unfold physicalShellKernel L
    congr 1
    apply integral_congr_ae
    filter_upwards with k
    dsimp only [b]
    have h (w : ℂ) : Complex.exp (-(v-(a:ℂ))*w) * Complex.exp (-(a:ℂ)*w) = Complex.exp (-v*w) := by
      rw [← Complex.exp_add]; congr 1; ring
    rw [← h]
    dsimp only [ω]
    ring
  simp_rw [he]
  exact ((hd.comp z (differentiableAt_id.sub_const _)).const_mul _).differentiableWithinAt

/-- In the spacelike strip the holomorphic transverse mass-shell integral is the
physical Schwinger kernel. Agreement for positive real time determines both signs. -/
theorem physicalShellKernel_eq_heat {d : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (x : MassShell.Space d) {z : ℂ} (hz : 0 < z.re) (hsep : |z.im| < ‖x‖) :
    physicalShellKernel d ħ m z x = physicalHeatKernel (d+1) ħ m (z^2 + (‖x‖^2:ℝ)) := by
  let S := {v : ℂ | 0 < v.re} ∩ ({v : ℂ | -‖x‖ < v.im} ∩ {v : ℂ | v.im < ‖x‖})
  have ho : IsOpen S := (isOpen_lt continuous_const Complex.continuous_re).inter
    ((isOpen_lt continuous_const Complex.continuous_im).inter (isOpen_lt Complex.continuous_im continuous_const))
  have hc : IsPreconnected S := ((convex_halfSpace_re_gt (0:ℝ)).inter
    ((convex_halfSpace_im_gt (-‖x‖)).inter (convex_halfSpace_im_lt ‖x‖))).isPreconnected
  let w (v : ℂ) := v^2 + ((‖x‖^2 : ℝ) : ℂ)
  have hw : MapsTo w S {v : ℂ | 0 < v.re} := by
    intro v hv
    have hl := hv.2.1
    have hr := hv.2.2
    change -‖x‖ < v.im at hl
    change v.im < ‖x‖ at hr
    change 0 < (v^2 + ((‖x‖^2:ℝ):ℂ)).re
    simp only [sq, Complex.add_re, Complex.mul_re, Complex.ofReal_re]
    nlinarith [mul_pos (sub_pos.mpr hr) (by linarith : 0 < ‖x‖ + v.im), sq_nonneg v.re]
  let F (v : ℂ) := physicalShellKernel d ħ m v x
  let G (v : ℂ) := physicalHeatKernel (d+1) ħ m (w v)
  have hf : DifferentiableOn ℂ F S := (physicalShellKernel_holomorphic ħ hm x).mono inter_subset_left
  have hg : DifferentiableOn ℂ G S := ((heatKernel_differentiableOn (d+1) hm).comp
    (by dsimp [w]; fun_prop : DifferentiableOn ℂ w S) hw).const_mul _
  have hx := (abs_nonneg z.im).trans_lt hsep
  have h1 : (1:ℂ) ∈ S := by simp [S,hx]
  have hr (s : ℝ) (hs : 0 < s) : F (s:ℂ) = G (s:ℂ) := by
    simpa only [F,G,w,Complex.ofReal_add,Complex.ofReal_pow] using physicalShellKernel_real ħ hm hs x
  have hfreq : ∃ᶠ v in nhdsWithin (1:ℂ) {(1:ℂ)}ᶜ, F v = G v := by
    rw [Filter.frequently_iff]; intro A hA
    obtain ⟨r,hr',hball⟩ := Metric.mem_nhdsWithin_iff.mp hA
    refine ⟨((1 + r/2 : ℝ) : ℂ), hball ⟨?_, fun h ↦ by have := congrArg Complex.re h; simp at this; linarith⟩,
      hr _ (by linarith)⟩
    rw [Metric.mem_ball, Complex.dist_eq, show ((1+r/2:ℝ):ℂ)-1 = ((r/2:ℝ):ℂ) by push_cast; ring,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith)]; linarith
  exact (hf.analyticOnNhd ho).eqOn_of_preconnected_of_frequently_eq (hg.analyticOnNhd ho) hc h1 hfreq
    ⟨hz, abs_lt.mp hsep⟩

end DotProduct.Extension


namespace DotProduct.Extension
open MeasureTheory Filter Set
open scoped Topology InnerProductSpace SchwartzMap

/-- Smearing the continued kernel on two spacelike-separated compact supports has
the same limit as smearing its real radial boundary value. -/
theorem spacelike_shell_smearing_boundary {d : ℕ} (ħ : ℝ) {m : ℝ} (hm : 0 < m)
    (f g : 𝓢(Spacetime d, ℝ)) (hf : HasCompactSupport f) (hg : HasCompactSupport g)
    (hsep : ∀ p ∈ tsupport f, ∀ q ∈ tsupport g, |p.1-q.1| < ‖p.2-q.2‖) :
    Tendsto (fun s : ℝ ↦ ∫ r : Spacetime d × Spacetime d, (f r.1 : ℂ) * (g r.2 : ℂ) *
      physicalShellKernel d ħ m ((s:ℂ) + ((r.1.1-r.2.1:ℝ):ℂ)*Complex.I) (r.1.2-r.2.2))
      (𝓝[>] 0) (𝓝 (∫ r : Spacetime d × Spacetime d, (f r.1 : ℂ) * (g r.2 : ℂ) *
        physicalHeatKernel (d+1) ħ m (‖r.1.2-r.2.2‖^2 - (r.1.1-r.2.1)^2 : ℝ))) := by
  let K := (fun r : Spacetime d × Spacetime d ↦ r.1-r.2) '' (tsupport f ×ˢ tsupport g)
  have hK : IsCompact K := (hf.prod hg).image (continuous_fst.sub continuous_snd)
  have hk : ∀ p ∈ K, |p.1| < ‖p.2‖ := by
    rintro p ⟨⟨a,b⟩,⟨ha,hb⟩,rfl⟩
    exact hsep a ha b hb
  let G := physicalHeatKernel (d+1) ħ m
  let b (p : Spacetime d) : ℂ := ((‖p.2‖^2 - p.1^2 : ℝ) : ℂ)
  let z (s : ℝ) (p : Spacetime d) := (s:ℂ)+(p.1:ℂ)*Complex.I
  let F (s : ℝ) (p : Spacetime d) := physicalShellKernel d ħ m (z s p) p.2
  let a (r : Spacetime d × Spacetime d) := (f r.1 : ℂ)*(g r.2 : ℂ)
  have hpos {p : Spacetime d} (hp : p ∈ K) : 0 < (b p).re := by
    change 0 < ‖p.2‖^2-p.1^2
    nlinarith [sq_abs p.1, hk p hp, abs_nonneg p.1, norm_nonneg p.2]
  have hGc : ContinuousOn G {w : ℂ | 0 < w.re} :=
    continuousOn_const.mul (heatKernel_differentiableOn (d+1) hm).continuousOn
  obtain ⟨C,hC⟩ := hK.bddAbove_image (hGc.comp (by dsimp [b]; fun_prop) (fun _ hp ↦ hpos hp)).norm
  have he (s : ℝ) (hs : 0 < s) (p : Spacetime d) (hp : p ∈ K) :
      F s p = G ((z s p)^2+(‖p.2‖^2:ℝ)) := by
    apply physicalShellKernel_eq_heat ħ hm p.2
    · simpa [z] using hs
    · simpa [z] using hk p hp
  obtain ⟨η,hη,huniform⟩ := physicalHeatKernel_spacelike_boundary ħ hm hK hk 1 one_pos
  have ha : Integrable (fun r ↦ ‖a r‖) (volume : Measure (Spacetime d × Spacetime d)) :=
    ((f.continuous.integrable_of_hasCompactSupport hf).ofReal (𝕜 := ℂ) |>.mul_prod
      ((g.continuous.integrable_of_hasCompactSupport hg).ofReal (𝕜 := ℂ))).norm
  let bound (r : Spacetime d × Spacetime d) := ‖a r‖ * (|C|+1)
  have hmem (r : Spacetime d × Spacetime d) (hr : a r ≠ 0) : r.1-r.2 ∈ K := by
    refine ⟨r,⟨subset_tsupport _ ?_,subset_tsupport _ ?_⟩,rfl⟩
    · intro h; exact hr (by simp [a,h])
    · intro h; exact hr (by simp [a,h])
  apply tendsto_integral_filter_of_dominated_convergence (F := fun s r ↦ a r * F s (r.1-r.2)) bound
  · refine Eventually.of_forall fun s ↦ ?_
    have hmeas : Measurable (fun r : Spacetime d × Spacetime d ↦ F s (r.1-r.2)) := by
      unfold F physicalShellKernel
      apply Measurable.const_mul
      apply StronglyMeasurable.measurable
      apply StronglyMeasurable.integral_prod_right' (f := fun y : (Spacetime d × Spacetime d) × MassShell.Space d ↦
        Complex.exp (-z s (y.1.1-y.1.2) * (modeDispersion m y.2:ℂ)) / (2*(modeDispersion m y.2:ℂ)) *
          Complex.exp (Complex.I * (inner ℝ (y.1.1-y.1.2).2 y.2 : ℂ)))
      apply Measurable.stronglyMeasurable
      dsimp [z,modeDispersion]; fun_prop
    exact ((by dsimp [a]; fun_prop : Measurable a).mul hmeas).aestronglyMeasurable
  · filter_upwards [Ioo_mem_nhdsGT hη] with s hs
    apply ae_of_all
    intro r
    by_cases h : a r = 0
    · simp [bound,h]
    let p := r.1-r.2
    have hp := hmem r h
    have hdist := (huniform s hs p hp).1
    have hc := hC (mem_image_of_mem (fun p ↦ ‖G (b p)‖) hp)
    have H : ‖F s p - G (b p)‖ < 1 := by rw [he s hs.1 p hp]; exact hdist
    change ‖a r * F s p‖ ≤ ‖a r‖ * (|C|+1)
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (by linarith [norm_le_norm_sub_add (F s p) (G (b p)), le_abs_self C]) (norm_nonneg _)
  · exact ha.mul_const _
  · apply ae_of_all
    intro r
    change Tendsto (fun s ↦ a r * F s (r.1-r.2)) _ (𝓝 (a r * G (b (r.1-r.2))))
    by_cases h : a r = 0
    · simp [h]
    let p := r.1-r.2
    have hp := hmem r h
    apply Filter.Tendsto.const_mul
    apply Metric.tendsto_nhds.mpr
    intro δ hδ
    obtain ⟨u,hu,H⟩ := physicalHeatKernel_spacelike_boundary ħ hm hK hk δ hδ
    filter_upwards [Ioo_mem_nhdsGT hu] with s hs
    rw [dist_eq_norm, he s hs.1 p hp]
    exact (H s hs p hp).1

end DotProduct.Extension


namespace DotProduct.Extension

open MeasureTheory Filter Set
open scoped SchwartzMap Topology ComplexConjugate

set_option maxHeartbeats 1500000

section

variable {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ]

theorem vacuum_field_pair (u v : Lp ℂ 2 μ) :
    inner ℂ (fockVacuum μ) (contField μ u u (contField μ v v (fockVacuumFin μ))).1 =
      inner ℂ u v := by
  let Ω := fockVacuumFin μ
  have hact (w : Lp ℂ 2 μ) : contField μ w w Ω = contCreate μ w Ω := by
    change contCreate μ w Ω + contAnnihil μ w (fockVacuumFin μ) = _
    rw [contAnnihil_vacuum,add_zero]
  have hcc := cont_ccr μ u v Ω
  change _ - contCreate μ v (contAnnihil μ u (fockVacuumFin μ)) = _ at hcc
  rw [contAnnihil_vacuum μ u, (contCreate μ v).map_zero,sub_zero] at hcc
  change inner ℂ Ω.1 (contField μ u u (contField μ v v Ω)).1 = _
  rw [← contField_symm μ u Ω (contField μ v v Ω),hact,hact,contCreate_adjoint,hcc]
  change inner ℂ (fockVacuum μ) (inner ℂ u v • fockVacuum μ) = _
  rw [inner_smul_right,fockVacuum,coherentVec_gram,inner_zero_left,Complex.exp_zero,mul_one]

omit [SigmaFinite μ] in
private theorem damped_inner_tendsto (ω : X → ℝ) (hm : Measurable ω) (hpos : ∀ k, 0 ≤ ω k)
    (u v : Lp ℂ 2 μ) :
    Tendsto (fun s : ℝ ↦ ∫ k, (Real.exp (-s * ω k) : ℂ) * inner ℂ (u k) (v k) ∂μ)
      (𝓝[>] 0) (𝓝 (inner ℂ u v)) := by
  rw [L2.inner_def]
  refine tendsto_integral_filter_of_dominated_convergence (fun k ↦ ‖inner ℂ (u k) (v k)‖)
    (.of_forall fun s ↦ ?_) ?_ (L2.integrable_inner u v).norm ?_
  · exact ((Complex.continuous_ofReal.measurable.comp (Real.continuous_exp.measurable.comp
      (measurable_const.mul hm))).aestronglyMeasurable).mul (L2.integrable_inner u v).aestronglyMeasurable
  · filter_upwards [self_mem_nhdsWithin] with s hs
    refine ae_of_all _ fun k ↦ ?_
    rw [norm_mul,Complex.norm_real,Real.norm_of_nonneg (Real.exp_pos _).le]
    exact mul_le_of_le_one_left (norm_nonneg _) (Real.exp_le_one_iff.mpr
      (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hs.le) (hpos k)))
  · exact ae_of_all _ fun k ↦ by
      have hc : Continuous (fun s : ℝ ↦ (Real.exp (-s * ω k) : ℂ) * inner ℂ (u k) (v k)) := by fun_prop
      simpa using (hc.continuousWithinAt (s := Ioi 0) (x := 0)).tendsto

end

