  readingLaw := massiveReadingLaw_iff hħ.le hm
  temperedRealization := gffMeasure_originalReadingLaw n hħ hm
  freeBoxLimit := fun ha hz hex f ↦ tendsto_freeBox_schwartz_joint_law hħ hm ha hz hex f
  boxLimitUnique := fun ha hz hex Q _ hQ ↦ massiveEuclideanLaw_unique_of_box_limits hħ hm ha hz hex Q hQ
  finiteDisintegration := by
    intro M a ha
